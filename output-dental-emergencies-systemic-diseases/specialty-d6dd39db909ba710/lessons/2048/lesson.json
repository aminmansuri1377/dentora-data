  "steps": [
    {
      "id": "theory:ddf9bb91f7875dd87a945a0e8e69d0a90f8e9fb645a145260ad9d01fbc0eb192",
      "position": 1,
      "kind": "theory",
      "sourceQuestionId": null,
      "sourceStepId": null,
      "sourceProgress": "width: 0%;",
      "questionType": "unknown",
      "title": "درس ۱: HIV و ایدز",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "HIV: راه انتقال و مراحل بیماری"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۳۴ ساله‌ای برای جرم‌گیری آمده و در فرم سلامت نوشته که HIV دارد و داروی ضدرتروویروسی می‌خورد. دستیار آهسته می‌پرسد: «نوبتش را آخر روز بگذاریم و وسایل جدا بچینیم؟» جواب تو چیست؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جواب کوتاه: نه. این بیمار را هم مثل هر بیمار دیگری با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اقدامات استاندارد کنترل عفونت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درمان می‌کنی. رد کردن بیمار فقط به‌خاطر HIV پذیرفتنی نیست."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ویروس:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " HIV یک رتروویروس است که با پروتئین gp120 به لنفوسیت T کمکی (CD4) می‌چسبد و این سلول‌ها را کم‌کم از بین می‌برد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "راه انتقال:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تماس جنسی، خون و فراورده‌های خونی، و از مادر به نوزاد در بارداری، زایمان یا شیردهی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انتقال از راه "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بزاق"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یا تماس روزمره گزارش نشده است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه مرحله"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عفونت حاد:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " حدود ۷۰٪ افراد ۱ تا ۳ هفته پس از عفونت تب، گلودرد، بثورات پوستی و بزرگی غدد لنفاوی می‌گیرند که در ۱ تا ۲ هفته خوب می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دوره‌ی نهفته:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بی‌علامت، ولی CD4 آرام‌آرام کم می‌شود. بدون درمان، به‌طور میانه ۸ تا ۱۰ سال طول می‌کشد تا علائم بالینی بیاید."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ایدز:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " CD4 زیر ۲۰۰ در میلی‌متر مکعب، یا یک بیماری تعریف‌کننده‌ی ایدز مثل سارکوم کاپوزی یا پنومونی پنوموسیستیس."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:61a08b31dfe250dfd58e285a513128ec0072a40ee0819dd92f3b2745d583a6b5",
      "position": 2,
      "kind": "theory",
