                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شدید:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " زیر ۱٪؛ خون‌ریزی خودبه‌خود در مفصل و عضله."
                    }
                  ]
                }
              ]
            }
          ]
        }
