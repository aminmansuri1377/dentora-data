                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بی‌حسی‌های آمیدی در کبد متابولیزه می‌شوند و نارسایی قلب خون‌رسانی کبد را کم می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیماری کلیه:"
