                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": پس از بار اول، سرنگ را حدود ۴۵ درجه بچرخان و دوباره آسپیره کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در ناحیه‌های پررگ سوزن ۲۵ یا ۲۷ گیج؛ آسپیراسیون با سوزن ۳۰ گیج قابل‌اعتماد نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر کارپول ۱٫۸ میلی‌لیتری در دست‌کم "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۶۰ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
