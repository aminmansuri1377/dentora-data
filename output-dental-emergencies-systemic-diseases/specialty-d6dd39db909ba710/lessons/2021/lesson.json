                          "text": "ترمیم و عفونت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ترمیم کند زخم و عفونت‌های ادنتوژنیک بیشتر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
