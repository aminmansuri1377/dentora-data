                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳۰ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بماند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اگر بیمار با پنی‌سیلین سابقه‌ی آنافیلاکسی، آنژیوادم یا کهیر دارد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سفالوسپورین نده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". برای پروفیلاکسی اندوکاردیت، آزیترومایسین، کلاریترومایسین یا داکسی‌سایکلین جایگزین است؛ کلیندامایسین دیگر توصیه نمی‌شود."
                }
              ]
            }
          ]
        }
