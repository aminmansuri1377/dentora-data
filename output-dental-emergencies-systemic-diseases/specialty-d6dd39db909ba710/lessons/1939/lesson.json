                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بالای ۳۰۰ mg/dL: بیمار را به پزشک یا بیمارستان بفرست"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قند بالا همراه علائم DKA یا HHS: "
