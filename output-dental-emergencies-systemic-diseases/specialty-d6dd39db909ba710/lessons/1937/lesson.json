                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در جراحی بیمار نارسایی آدرنال، فشار را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر ۵ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بسنج. فشار سیستولیک زیر ۱۰۰ یا دیاستولیک ۶۰ و کمتر یعنی افت فشار، و باید اقدام کنی."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اقدام"
                }
              ]
            },
