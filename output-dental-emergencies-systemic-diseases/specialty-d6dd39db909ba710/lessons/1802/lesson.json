                    {
                      "tag": "text",
                      "text": "نالوکسان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لازم شود. بیماری که به خاطر دارو افت فشار وضعیتی شدید دارد، برای تنظیم دارو به پزشکش ارجاع شود."
                }
              ]
            }
          ]
