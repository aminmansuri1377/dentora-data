                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از هر درمان دندانپزشکی بعدی، مشاوره‌ی پزشکی بگیر."
                    }
                  ]
                }
              ]
            },
            {
