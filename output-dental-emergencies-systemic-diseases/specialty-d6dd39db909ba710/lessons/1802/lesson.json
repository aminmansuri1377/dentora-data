                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را supine بخوابان و پاها را بالاتر از سطح سر بیاور."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم حیاتی را بسنج."
                    }
