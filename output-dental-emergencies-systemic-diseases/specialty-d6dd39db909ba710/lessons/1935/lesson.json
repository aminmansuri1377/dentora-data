          "children": [
            {
              "tag": "text",
              "text": "نقش‌ها، تمرین و وارسی کیف"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برنامه‌ی مکتوب با نقش مشخص"
                }
