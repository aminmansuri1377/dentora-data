            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تمرین اورژانس (drill) منظم در خود مطب، با همان کیف و همان یونیت"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تمرین مهارت BLS برای همه‌ی کارکنان "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سالی یک بار"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شماره‌های اضطراری کنار هر تلفن و در گوشی‌ها؛ درستی‌شان را هرازگاهی با تماس امتحان کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وارسی کیف"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ماهی یک بار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کامل بودن محتوا، تاریخ انقضا و ظاهر داروها"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیتروگلیسرین پس از باز شدن فقط حدود ۳۰ روز مؤثر می‌ماند؛ تاریخ باز کردن را رویش بنویس."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پر بودن کپسول اکسیژن، و باتری و پدهای AED"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کیفی که در کمد اتاق آخر قفل است. کیف و کپسول باید جای ثابتی داشته باشند که همه‌ی کارکنان بدانند."
                }
              ]
            }
          ]
        }
