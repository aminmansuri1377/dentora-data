                  "tag": "text",
                  "text": "بی‌اشتهایی عصبی (anorexia nervosa)"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وزن "
