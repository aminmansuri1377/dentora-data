                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خفیف:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گرسنگی، ضعف، تاکی‌کاردی، رنگ‌پریدگی، تعریق، گزگز"
