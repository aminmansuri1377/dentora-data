      "title": "درس ۴: بیمار بی‌هوش",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیدا کردن علت بی‌هوشی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آنچه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از بی‌هوشی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رخ داد، بهترین سرنخ است:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سنکوپ وازوواگال:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ترس، رنگ‌پریدگی و نبض کند؛ با خواباندن زود به هوش می‌آید."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هیپوگلیسمی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دیابتی ناشتا، تعریق، لرزش، گیجی یا پرخاشگری."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پس از تشنج:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " حرکات تونیک‌ـ‌کلونیک، بی‌اختیاری ادرار، زخم زبان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مسمومیت با بی‌حسی موضعی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پرحرفی و بی‌قراری پس از تزریق."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سکته‌ی مغزی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " افتادگی صورت، ضعف یک‌طرفه، اختلال گفتار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ایست قلبی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نبض و تنفس ندارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر علت معلوم نیست"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار supine بماند و با ۱۱۵ تماس بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راه هوایی باز، اکسیژن، و سنجش فشار و پالس‌اکسیمتری."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "داروی حدسی نده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ برای CPR و AED آماده باش."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار بی‌هوش رفلکس گگ ضعیفی دارد؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چیزی از راه دهان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به او نده. اگر استفراغ کرد، سر را پایین بیاور، به پهلو بچرخانش و ساکشن کن. بیماری که نفس می‌کشد و نبض دارد، به‌ویژه پس از تشنج، در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وضعیت ریکاوری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (به پهلو) نگه داشته شود. در بیمار دیابتی، گلوکومتر سرنخ خوبی می‌دهد."
                }
              ]
            }
          ]
        }
      ],
