            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترمیم‌های پیچیده، جراحی پریودنتال، روت‌پلنینگ، کشیدن دندان و جراحی دهان. از تزریق عضلانی بی‌فاکتور هم پرهیز کن. هر جا ممکن است، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان ریشه را به کشیدن ترجیح بده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
