                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک‌طرفه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "‌اند. برای به خاطر سپردن، FAST را به کار ببر:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "F (صورت):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " افتادگی یک طرف صورت؛ از بیمار بخواه لبخند بزند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "A (بازو):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ضعف یا بی‌حسی یک دست؛ بگو هر دو دست را جلو نگه دارد و ببین یکی پایین می‌افتد یا نه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "S (گفتار):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گفتار کش‌دار، یا ناتوانی در گفتن و فهمیدن کلمه‌ها."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "T (زمان):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ساعت شروع علائم را یادداشت کن و فوراً با ۱۱۵ تماس بگیر."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علائم همراه: سرگیجه و از دست دادن تعادل، تاری یا از دست رفتن دید (به‌ویژه در یک چشم)، دوبینی، تهوع و استفراغ، اشکال در بلع، تشنج، و در موارد شدید کاهش هوشیاری تا کما."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سردرد در سکته‌ی ایسکمیک اغلب خفیف است یا اصلاً نیست. اما سردرد "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناگهانی و بسیار شدید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، همان که بیمار «بدترین سردرد عمرم» می‌نامد، به خون‌ریزی مغزی اشاره دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فشار خون و نبض در سکته‌ی مغزی معمولاً طبیعی‌اند، پس طبیعی بودنشان سکته را رد نمی‌کند. اگر فشار و دمای بدن بالا رفت و نبض و تنفس کند شد، به افزایش فشار داخل جمجمه فکر کن."
                }
              ]
            }
          ]
        }
      ],
