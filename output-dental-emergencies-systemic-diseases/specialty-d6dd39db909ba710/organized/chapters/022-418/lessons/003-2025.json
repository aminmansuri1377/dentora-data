  "steps": [
    {
      "id": "theory:111419aa427307df4eafa46a601d9f7d5ae843592f89aad6a489788cb04d359b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "308f5522722dc9b2ffccc5f47cce959a2fece91cc903bc01f20d03145802565b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پرکاری تیروئید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۳۲ ساله‌ای برای درمان ریشه آمده. مدام روی صندلی جابه‌جا می‌شود، دستش می‌لرزد، با وجود کولر عرق کرده و نبضش ۱۱۸ است. می‌گوید چند ماه است بی‌دلیل لاغر شده و چشم‌هایش برجسته‌تر به نظر می‌رسد. پیش از بی‌حسی به چه فکر می‌کنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/med-fig-1-7.webp",
                  "alt": "عقب رفتن پلک در پرکاری تیروئید؛ چشم‌ها برجسته‌تر به نظر می‌رسند",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/7d811fca4062f5a0ad56071c9772bd4475f4ff78b9cdd5b911570a8281c65952.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عقب رفتن پلک در پرکاری تیروئید؛ چشم‌ها برجسته‌تر به نظر می‌رسند "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 1.7)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تیروئید T4 و T3 می‌سازد که سرعت متابولیسم بدن را تعیین می‌کنند. در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرکاری تیروئید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (تیروتوکسیکوز) این هورمون‌ها زیادند و بدن تند کار می‌کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علت‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیماری گریوز:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شایع‌ترین علت؛ خودایمنی و بسیار شایع‌تر در زنان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گواتر ندولر سمی و آدنوم سمی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مصرف بیش از اندازه‌ی لووتیروکسین در بیمار کم‌کاری"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علائم"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عصبی بودن، بی‌قراری، لرزش دست و خستگی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تپش قلب و تاکی‌کاردی؛ فیبریلاسیون دهلیزی زیر ۵۰ سالگی نادر است، ولی در حدود ۲۰٪ بیماران مسن دیده می‌شود"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدم تحمل گرما، پوست گرم و مرطوب و کاهش وزن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگزوفتالمی (چشم برجسته) در حدود نیمی از بیماران گریوز"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در آزمایش، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "TSH پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و T4 و T3 بالاست. در کودک مبتلا، افتادن زودرس دندان‌های شیری و رویش زودرس دندان‌های دائمی شایع است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:76b34d6bf118f6ece99a1549ea587b756e14fe3bd5b2da87941a99453d9386e5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "13cf17ba7bd570fb7afc9599773ca026bfeedf1534db9176e4b2db534de7453b",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "درمان دندانپزشکی در پرکاری تیروئید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار پرکاری که درمان شده و یوتیروئید است (کارکرد تیروئیدش طبیعی است)، بی‌هیچ تغییری درمان می‌شود. خطر در بیمار درمان‌نشده یا بد کنترل‌شده است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پرکاری کنترل‌نشده"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فقط درمان اورژانسی، با هماهنگی نزدیک با پزشک بیمار"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از اپی‌نفرین در بی‌حسی و دیگر تنگ‌کننده‌های عروق پرهیز کن؛ خطر آریتمی جدی دارد"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار و نبض را بسنج؛ فشار ممکن است بالا و ریتم نامنظم باشد"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت دندانی حاد را زود و جدی درمان کن؛ عفونت و جراحی طوفان تیروئیدی را شعله‌ور می‌کنند"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درمان‌های بیمار و پیامدشان"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "متی‌مازول و پروپیل‌تیواوراسیل (PTU):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " به‌ندرت آگرانولوسیتوز می‌دهند؛ تب، گلودرد یا زخم دهان را در این بیمار جدی بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "PTU همراه وارفارین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " خطر خون‌ریزی بیشتر"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پروپرانولول:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای لرزش و تاکی‌کاردی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ید رادیواکتیو یا برداشتن بخشی از تیروئید:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ممکن است بعدها کم‌کاری تیروئید بدهد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یادآوری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طوفان تیروئیدی نادر است، ولی جان بیمار را تهدید می‌کند. تب بالا، تعریق و تاکی‌کاردی شدید در بیمار کنترل‌نشده یعنی قطع درمان و تماس با ۱۱۵."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
