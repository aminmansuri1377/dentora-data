  "steps": [
    {
      "id": "theory:286881d41a554be08f1d9edb9b5ebdb8da4b4b85b5f16715b6649d69fd6ae2be",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "0bfdda52e4730f47c5c4d16aff585a32b7a1e8c0f01184d2ffde827be9566258",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کم‌کاری تیروئید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۶۰ ساله‌ای با صورت پف‌کرده، صدای خشن و پوست خشک برای کشیدن دندان آمده. می‌گوید همیشه سردش است، خواب‌آلود است و وزن اضافه کرده، ولی هیچ‌وقت آزمایش تیروئید نداده. قرار بود با آرام‌بخش خوراکی کار کنی. چرا باید دست نگه داری؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در کم‌کاری تیروئید T4 و T3 کم است و بدن کند کار می‌کند. شایع‌ترین علتش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هاشیموتو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، بیماری خودایمنی تیروئید. برداشتن تیروئید و ید رادیواکتیو هم کم‌کاری می‌دهند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خستگی، خواب‌آلودگی و کندی ذهن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افزایش وزن و عدم تحمل سرما"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوست خشک و ضخیم، موی خشک و شکننده، پف صورت و صدای خشن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبض کند"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در آزمایش، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "TSH بالا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و T4 پایین است. درمان، لووتیروکسین خوراکی است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در مطب"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کنترل‌شده:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " درمان معمول، بدون تغییر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کنترل‌نشده:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پاسخ به آرام‌بخش، مخدر و باربیتورات تشدید می‌شود؛ از آن‌ها پرهیز کن یا با احتیاط زیاد بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت را زود درمان کن و پیش از جراحی با پزشک مشورت کن؛ آرام‌بخش، عفونت و جراحی کمای میکزدم را شعله‌ور می‌کنند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در دهان:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بزرگسال ممکن است زبان بزرگ و بزاق کم داشته باشد. کم‌کاری مادرزادی لب ضخیم، زبان بزرگ، رویش دیرهنگام دندان‌ها و مال‌اکلوژن می‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:c52747c5fcc7f526181f8919a09a3a62370332806d28cb9333b7103b65a963f4",
