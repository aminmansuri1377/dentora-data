                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مصرف طولانی بدن را به دارو مقاوم می‌کند؛ پس واکنش تازه یعنی داروی این بار تقلبی یا تاریخ‌گذشته بوده"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
