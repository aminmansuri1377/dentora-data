  "steps": [
    {
      "id": "theory:4f8eb8b9ac1666d69dc3bfbc01ad9c736f7b633ae70cf145285caa363e75d806",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "1acec523d7a3e42d73beee8afa12b5282421722182ea5cab1f570de62e718bb2",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "واکنش آلرژیک نوع I و زمان شروع"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۳۴ ساله‌ای دو ساعت پس از ترمیم دندانش تماس می‌گیرد. روی ساعد و گردنش کهیر زده و خارش دارد، ولی نفسش راحت است و صدایش عادی. این وضعیت چقدر جدی است؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیشتر واکنش‌های آلرژیک مطب از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوع I"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هستند. در نخستین تماس با دارو، بدن فقط حساس می‌شود و آنتی‌بادی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "IgE"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌سازد که روی ماست‌سل‌ها می‌نشیند. در تماس بعدی، ماست‌سل‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیستامین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آزاد می‌کنند؛ رگ‌ها گشاد و نشت‌پذیر می‌شوند و روی پوست خارش، قرمزی و کهیر می‌بینی."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گاهی واکنش پس از بارها مصرف بی‌مشکل همان دارو ظاهر می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آلرژی به دوز وابسته نیست؛ مقدار بسیار کم هم در فرد حساس واکنش می‌دهد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "زمان شروع، مهم‌ترین سرنخ"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هرچه علائم زودتر پس از تماس شروع شوند، واکنش شدیدتر است. واکنشی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶۰ دقیقه یا دیرتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس از تماس شروع شده، معمولاً پیشرفت نمی‌کند و تهدیدکننده‌ی حیات نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "واکنش تأخیری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوع IV"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ماجرای دیگری است: کار لنفوسیت T است، نه آنتی‌بادی، و ۴۸ تا ۷۲ ساعت پس از تماس ظاهر می‌شود؛ مثل استوماتیت تماسی به آمالگام، نیکل یا خمیردندان."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5237f6a91928a46dd3716dfde02c6e4d365f4148e688f348cb2cddc321d251f3",
      "sourceId": null,
      "identityOrigin": "local-step",
