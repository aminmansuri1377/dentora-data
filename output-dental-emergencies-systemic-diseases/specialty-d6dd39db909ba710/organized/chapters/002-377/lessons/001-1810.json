                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 19.2)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "واکنش پوستی دیررس (۶۰ دقیقه یا بیشتر)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیفن‌هیدرامین "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵۰ میلی‌گرم خوراکی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، سپس هر ۶ ساعت برای ۳ تا ۴ روز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر بیمار هنوز در مطب است، یک ساعت زیر نظر بماند تا مطمئن شوی واکنش پیش نمی‌رود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "واکنش پوستی زودرس (کمتر از ۶۰ دقیقه)"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کار دندانپزشکی و تجویز هر دارویی را قطع کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیفن‌هیدرامین "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵۰ میلی‌گرم عضلانی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بزن (کودک تا ۳۰ کیلوگرم: ۲۵ میلی‌گرم)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار خون، نبض و تنفس را هر ۵ دقیقه ثبت کن و بیمار را دست‌کم ۶۰ دقیقه نگه دار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چون داروی تزریقی گرفته و ممکن است خواب‌آلود باشد، فقط با همراه بزرگسال مرخص شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنتی‌هیستامین خوراکی را برای ۳ روز تجویز کن و پیش از درمان بعدی، علت واکنش را کامل بررسی کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "کهیر به‌تنهایی خطرناک نیست، ولی ممکن است "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نخستین نشانه‌ی آنافیلاکسی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد. اگر خس‌خس، گرفتگی صدا، تورم زبان یا گلو، یا افت فشار اضافه شد، دیگر با واکنش خفیف روبه‌رو نیستی."
                }
              ]
            }
          ]
        }
      ],
