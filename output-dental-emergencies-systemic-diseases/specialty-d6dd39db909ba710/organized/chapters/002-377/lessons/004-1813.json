      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آلرژی به لاتکس و پنی‌سیلین"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لاتکس"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶٪ مردم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و تا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۸٪ کادر درمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به لاتکس حساس‌اند. در کادر درمان بیشتر موارد درماتیت تماسی تأخیری (نوع IV) است، ولی واکنش نوع I و حتی آنافیلاکسی هم رخ می‌دهد. در مطب، دستکش، رابردم و کاف فشارسنج ممکن است لاتکس داشته باشند. برای فرد حساس، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستکش نیتریل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و رابردم بدون لاتکس به کار ببر."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پنی‌سیلین"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از شایع‌ترین علت‌های آلرژی دارویی و مرگ ناشی از آنافیلاکسی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حدود ۷۰٪ کسانی که با آن آنافیلاکسی می‌گیرند، پیش‌تر پنی‌سیلین را بی‌مشکل مصرف کرده بودند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راه خوراکی کمتر از راه تزریقی بیمار را حساس می‌کند و واکنش‌هایش خفیف‌تر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنتی‌بادی ضد پنی‌سیلین با آموکسی‌سیلین و آمپی‌سیلین هم واکنش می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از نخستین دوز پنی‌سیلین در مطب، بیمار "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳۰ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بماند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اگر بیمار با پنی‌سیلین سابقه‌ی آنافیلاکسی، آنژیوادم یا کهیر دارد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سفالوسپورین نده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". برای پروفیلاکسی اندوکاردیت، آزیترومایسین، کلاریترومایسین یا داکسی‌سایکلین جایگزین است؛ کلیندامایسین دیگر توصیه نمی‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
