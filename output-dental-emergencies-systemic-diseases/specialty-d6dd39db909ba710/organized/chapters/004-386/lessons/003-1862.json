      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "درمان استاتوس اپی‌لپتیکوس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۱۵"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تماس بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "همچنان بیمار را از برخورد با اشیا حفظ کن و اکسیژن بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بنزودیازپین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بده (پایین را ببین)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از قطع تشنج: بیمار را به پهلو بچرخان، ساکشن کن، علائم حیاتی را پایش کن، در صورت نیاز BLS بده و بیمار را به بیمارستان منتقل کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کدام بنزودیازپین و از چه راهی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "میدازولام اسپری بینی ۵ میلی‌گرم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در یک سوراخ بینی؛ اگر ۱۰ دقیقه بعد تشنج ادامه داشت، دوز دوم در سوراخ دیگر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "میدازولام عضلانی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " محلول در آب است و از راه عضلانی سریع جذب می‌شود؛ در بیماری که رگ ندارد گزینه‌ی بهتری است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دیازپام ۵ تا ۱۰ میلی‌گرم وریدی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " محلول در آب نیست و فقط وریدی اثر قابل‌پیش‌بینی دارد. رگ گرفتن در بیمارِ در حال تشنج دشوار است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در کودک و سالمند، دوز کمتری لازم است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عارضه‌ی مهم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دوز زیاد و سریع بنزودیازپین می‌تواند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنفس را متوقف کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". کسی که دارو می‌دهد باید برای BLS و تهویه با آمبوبگ آماده باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
