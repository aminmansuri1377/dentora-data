    {
      "id": "theory:8a6cbe6d3298223002fd93d207a11a747ef92b963c1b09380ea218c94bd940a7",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "b43b57be17dccb2a23ccbaa81a784bd0b47ce627f8f57e4222365c61e08a31bf",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "استاتوس اپی‌لپتیکوس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۳۰ ساله‌ای که یک هفته پیش داروی ضدتشنجش را خودسرانه قطع کرده، روی یونیت تشنج می‌کند. دستیار با ساعت زمان می‌گیرد: شش دقیقه گذشته و پرش‌ها هنوز ادامه دارد. آیا هنوز باید صبر کرد؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نه. این "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استاتوس اپی‌لپتیکوس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: تشنجی که بیش از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طول بکشد، یا تشنج‌های پشت‌سرهم که بیمار بینشان به هوش نمی‌آید."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا خطرناک است"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار دچار هیپوکسی و اسیدوز شدید می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آسیب دائمی مغز و مرگ ممکن است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در میان اختلال‌های تشنجی، بیشترین مرگ را همین می‌سازد؛ یک فوریت پزشکی است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علت‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شایع‌ترین علت: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "قطع ناگهانی داروی ضدتشنج"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یا قطع ماده‌ای که بیمار سوءمصرف می‌کرده (مثل الکل)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت، تومور و ضربه به سر"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تشنج معمولی خودش تمام می‌شود و جز محافظت از بیمار کاری نمی‌خواهد. برای همین زمان را از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لحظه‌ی شروع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بگیر؛ در آن لحظه‌ی پرتنش حس زمان قابل‌اعتماد نیست، و بدون ساعت ممکن است بی‌جا دارو بدهی یا دیر اقدام کنی."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:79862c6aa980904eb21ae2576b62693b96d7aee1a753d4c29ae0f665b884727b",
      "sourceId": null,
