      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مراحل و درمان هیپوگلیسمی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه مرحله"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خفیف:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گرسنگی، ضعف، تاکی‌کاردی، رنگ‌پریدگی، تعریق، گزگز"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "متوسط:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " حرف‌های نامربوط، همکاری نکردن، پرخاشگری، قضاوت ضعیف، گیجی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شدید:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بی‌هوشی، حرکات تونیک یا کلونیک، افت فشار، کاهش دمای بدن، نبض تند و ضعیف"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار هوشیار است"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان دندانپزشکی را قطع کن و بیمار را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نشسته"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نگه دار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قند خوراکی بده: یک لیوان آبمیوه، چند بسته قند، نوشابه‌ی غیررژیمی یا ژل گلوکز روی مخاط گونه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم حیاتی را بسنج. اگر زود بهتر نشد، سراغ درمان تزریقی برو."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار بی‌هوش است"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را supine بخوابان، راه هوایی را باز نگه دار و با ۱۱۵ تماس بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکسیژن ۵ تا ۶ لیتر در دقیقه بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گلوکاگون ۱ میلی‌گرم عضلانی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (یا زیرجلدی) تزریق کن؛ اگر راه وریدی داری، ۵۰ میلی‌لیتر دکستروز ۵۰٪ وریدی در ۲ تا ۳ دقیقه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ریختن آبمیوه در دهان بیمار بی‌هوش. رفلکس گگ او کم شده و مایع به ریه می‌رود. پس از به هوش آمدن، بیمار دست‌کم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک ساعت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در مطب بماند، با همراه برود و پیش از جلسه‌ی بعد با پزشکش مشورت کن. او معمولاً ماجرا را کم به یاد می‌آورد؛ برایش توضیح بده."
                }
              ]
            }
          ]
        }
      ],
