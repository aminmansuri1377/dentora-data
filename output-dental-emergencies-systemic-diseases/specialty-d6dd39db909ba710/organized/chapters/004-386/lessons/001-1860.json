  "steps": [
    {
      "id": "theory:536aa1721dd119945e9ee02fedddf8021f4e22ac2eb061df5cc4c27a18c35640",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "78a4b7a92ebf2b18f799062880fff3f4c7a6774093522c5dceb1a2a84ad4b743",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هیپوگلیسمی در مطب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۴۵ ساله‌ای با دیابت نوع ۱ صبح انسولینش را زده، ولی از درد دندان صبحانه نخورده است. نیم ساعت از درمان ریشه گذشته که عرق سرد کرده، دستش می‌لرزد و با عصبانیت می‌گوید «زودتر تمامش کن». این رفتار از ترس است یا از چیز دیگری؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این تصویر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیپوگلیسمی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (افت قند خون) است. مغز برای کار کردن به گلوکز نیاز دارد و وقتی قند کافی به آن نرسد، اول رفتار و بعد هوشیاری به هم می‌ریزد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چه کسی در خطر است"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "همه‌ی دیابتی‌ها، ولی بیشتر از همه کسی که "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "انسولین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌زند (معمولاً نوع ۱)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کسی که انسولین یا قرص قند را زده یا خورده ولی غذا نخورده است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مصرف بیش از حد انسولین یا قرص‌های "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سولفونیل‌اوره"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مصرف قند بیشتر از معمول: ورزش، عفونت و اضطراب شدید."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قرص‌های خوراکی نوسان قند را معمولاً کمتر از انسولین تند می‌کنند. آگونیست‌های GLP-1 به‌تنهایی هیپوگلیسمی نمی‌دهند، مگر همراه داروهایی مثل سولفونیل‌اوره."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیشگیری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نوبت صبح؛ بیمار انسولین همیشگی را بزند و صبحانه‌اش را بخورد. پیش از شروع بپرس خورده است یا نه. اگر گلوکومتر قند زیر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۷۰ mg/dL"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشان داد، درمان انتخابی را عقب بینداز یا اول به بیمار کربوهیدرات بده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a641778dd0d3f5f5694a699f1d0098ba1a81e19b403e2dd0c4937b4ad41a9a88",
