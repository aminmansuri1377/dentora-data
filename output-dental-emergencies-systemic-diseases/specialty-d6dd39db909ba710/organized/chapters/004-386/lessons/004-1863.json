  "steps": [
    {
      "id": "theory:26bbefd467aeed42271ac6f1c34681f83ae06d62c2eb7af51be4d1cadd0d199c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "e7b7c9ebd4a196c8357c39b76ef0d9ec7c1febabac6a6c7daa77d03be6f3d457",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رویکرد گام‌به‌گام به بیمار بی‌هوش"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پس از دو دقیقه که برای آوردن رادیوگرافی بیرون رفته بودی، برمی‌گردی و می‌بینی خانم ۶۰ ساله‌ای روی یونیت به صدا زدنت جواب نمی‌دهد. کسی ندیده چه شده است. از کجا شروع می‌کنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی علت را نمی‌دانی، ترتیب ثابت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "P-A-B-C-D"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جلوی سردرگمی را می‌گیرد:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "P (وضعیت):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیمار را supine بخوابان، به شانه‌اش بزن و بلند صدایش کن. کمک بخواه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "A (راه هوایی):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سر را به عقب ببر و چانه را بالا بکش (head tilt–chin lift)؛ در صورت نیاز فک پایین را از زاویه‌ها جلو بکش (jaw thrust)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "B (تنفس):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ببین نفس می‌کشد یا نه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "C (گردش خون):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نبض کاروتید را حداکثر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۰ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بسنج."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "D (درمان قطعی):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تشخیص، دارو و تجهیزات."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر بیمار نفس نمی‌کشد و نبض ندارد، این ایست قلبی است: با ۱۱۵ تماس بگیر، AED را بیاور و CPR را با ترتیب C-A-B شروع کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پس از D دو گام دیگر هم هست: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "E"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی ثبت علائم حیاتی، داروها و ساعت هر اقدام، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "F"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی سپردن بیمار به مرحله‌ی بعد درمان، مثل انتقال به بیمارستان."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5ae3d5904e806dc2454cbe29b864dc828d6ab4a777f8afbc1f2ef9e612a5e052",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "9eaa7c402a3a410b4ea09d19c34927ae7c839fc220380e3e7c670cd447871170",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیدا کردن علت بی‌هوشی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آنچه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از بی‌هوشی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رخ داد، بهترین سرنخ است:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سنکوپ وازوواگال:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ترس، رنگ‌پریدگی و نبض کند؛ با خواباندن زود به هوش می‌آید."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هیپوگلیسمی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دیابتی ناشتا، تعریق، لرزش، گیجی یا پرخاشگری."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پس از تشنج:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " حرکات تونیک‌ـ‌کلونیک، بی‌اختیاری ادرار، زخم زبان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مسمومیت با بی‌حسی موضعی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پرحرفی و بی‌قراری پس از تزریق."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سکته‌ی مغزی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " افتادگی صورت، ضعف یک‌طرفه، اختلال گفتار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ایست قلبی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نبض و تنفس ندارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر علت معلوم نیست"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار supine بماند و با ۱۱۵ تماس بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راه هوایی باز، اکسیژن، و سنجش فشار و پالس‌اکسیمتری."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "داروی حدسی نده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ برای CPR و AED آماده باش."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار بی‌هوش رفلکس گگ ضعیفی دارد؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چیزی از راه دهان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به او نده. اگر استفراغ کرد، سر را پایین بیاور، به پهلو بچرخانش و ساکشن کن. بیماری که نفس می‌کشد و نبض دارد، به‌ویژه پس از تشنج، در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وضعیت ریکاوری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (به پهلو) نگه داشته شود. در بیمار دیابتی، گلوکومتر سرنخ خوبی می‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
