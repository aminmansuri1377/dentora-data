  "steps": [
    {
      "id": "theory:03114b7439656af2bbe6a33701bec1907ff06568a5b774966fe6965acac05b97",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "e4ac47fb743b7e23010a498f7424eed25dbc42cb1af511716faecb61580276dc",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "شش طبقه‌ی ASA"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۴۸ ساله‌ای دیابت نوع ۲ دارد که با قرص خوب کنترل شده، و روزی یک پاکت سیگار می‌کشد. کار روزانه‌اش هیچ محدودیتی ندارد. در کدام طبقه‌ی ASA است؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "طبقه‌بندی ASA اول برای سنجش خطر بیهوشی عمومی ساخته شد؛ امروز برای هر درمان سرپایی، با هر نوع بی‌حسی، به کار می‌رود. هرچه طبقه بالاتر، خطر بیشتر."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ASA I:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سالم، غیرسیگاری، بدون مصرف الکل یا با مصرف بسیار کم."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ASA II:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیماری سیستمیک خفیف بدون محدودیت در کار روزانه؛ مثل سیگاری، بارداری، BMI بین ۳۰ و ۴۰، دیابت یا فشار خون "
                    },
                    {
                      "tag": "em",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خوب کنترل‌شده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، بیماری ریوی خفیف."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ASA III:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیماری متوسط تا شدید با محدودیت واقعی؛ مثل دیابت یا فشار خون "
                    },
                    {
                      "tag": "em",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بد کنترل‌شده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، COPD، BMI چهل و بیشتر، هپاتیت فعال، پیس‌میکر، دیالیز منظم، یا سابقه‌ی MI، سکته‌ی مغزی، TIA یا استنت کرونر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیش از ۳ ماه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ASA IV:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیماری شدید که "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مدام حیات را تهدید می‌کند"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ مثل MI، سکته‌ی مغزی، TIA یا استنت "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کمتر از ۳ ماه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش، ایسکمی قلبی جاری، سپسیس، یا نارسایی کلیه‌ی پیشرفته بدون دیالیز منظم."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ASA V:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیمار رو به مرگ که بدون جراحی زنده نمی‌ماند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ASA VI:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مرگ مغزی که اعضایش برای اهدا برداشته می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برچسب ASA IV پس از MI تا ۳ ماه می‌ماند. در این بازه فقط درمان ضروری را انجام بده؛ درمان انتخابی را با مشاوره‌ی پزشک و معمولاً پس از دست‌کم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۰ روز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بی‌علامتی برنامه‌ریزی کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:dc5de0e052380de69729a470a995d3a6561a73f78e8f32e7cf3af9b325fdc263",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "695c887beeb67d590b6f06258e6208bfb4c7bdfadf5ee02952db2720dced38c0",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ASA در عمل: محک پله"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای جدا کردن طبقه‌ها، از بیمار بپرس: می‌توانی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک طبقه پله"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بالا بروی یا دو خیابان صاف را پیاده بروی، بی‌آنکه خستگی غیرعادی، تنگی نفس یا درد قفسه‌ی سینه بگیری؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ASA II:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بدون هیچ ناراحتی از عهده برمی‌آید."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ASA III:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در استراحت علامتی ندارد، ولی با فشار جسمی یا روانی علامت می‌گیرد؛ مثل بیمار آنژینی که در اتاق انتظار خوب است و روی یونیت درد سینه می‌گیرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ASA IV:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در حال استراحت هم علامت دارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بالا رفتن از یک طبقه پله حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ MET"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انرژی می‌خواهد. بیماری که از پس ۴ MET برنمی‌آید، خطر عارضه‌ی قلبی جدی در حین درمان بیشتری دارد. توان بیش از ۱۰ MET، مثل شنا، یعنی آمادگی جسمی عالی."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چراغ راهنمای ASA"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ASA I: چراغ سبز؛ معمولاً اصلاح درمان لازم نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ASA II و III: چراغ زرد؛ درمان انتخابی مجاز است، با احتیاط و اصلاح درمان که در ASA III جدی‌تر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ASA IV و V: چراغ قرمز؛ فقط درمان ضروری، و درمان انتخابی با مشاوره‌ی پزشک به تعویق."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ASA قاعده‌ی خشک و مکانیکی نیست. بیماری که چند بیماری دارد را با قضاوت بالینی طبقه‌بندی کن؛ اگر مطمئن نیستی با پزشکش مشورت کن. تصمیم نهایی و مسئولیت درمان با خود دندانپزشک است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
