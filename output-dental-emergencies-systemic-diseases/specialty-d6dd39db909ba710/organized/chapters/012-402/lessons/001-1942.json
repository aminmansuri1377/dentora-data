    {
      "id": "theory:0042172f5a823b66bfd36de4393f416d645bfde056bf2b31d4b9b4102df324cb",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "fca2aebfb4862d09545932a72e38cdae32c49dd9b1a39806fc5fbc464702bcd9",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اندازه‌گیری درست فشار خون"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۵۲ ساله‌ای برای جلسه‌ی اول، دوان‌دوان از پله‌ها بالا آمده و هنوز نفس‌نفس می‌زند. فشارسنج مچی‌اش ۱۵۸/۹۶ نشان می‌دهد. این عدد را در پرونده می‌نویسی یا دوباره اندازه می‌گیری؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علائم حیاتی دو کار می‌کنند: یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدد پایه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌دهند که در اورژانس با آن مقایسه کنی، و بیماری کشف‌نشده را غربال می‌کنند. کار تو "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کشف ناهنجاری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه تشخیص؛ تشخیص با پزشک است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گام‌های اندازه‌گیری"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار نشسته باشد، کف پاها روی زمین، و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آرام استراحت کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در ۳۰ دقیقه‌ی قبل سیگار نکشیده و چیزی نخورده باشد و مثانه‌اش خالی باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاف را روی بازوی برهنه، کمی بالای آرنج و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هم‌سطح قلب"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ببند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاف هم‌اندازه‌ی بازو باشد: کیسه‌ی هوای آن حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۸۰٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دور بازو را بپوشاند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دو بار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " با فاصله‌ی ۱ تا ۲ دقیقه بسنج و میانگین را ثبت کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کاف را روی بازویی که فیستول دیالیز دارد نبند. فشارسنج مچی و انگشتی دقیق نیستند و توصیه نمی‌شوند. اگر برای بازوی خیلی چاق کاف بزرگ نداری، کاف معمولی را روی ساعد، زیر آرنج، ببند و با لمس نبض رادیال فقط فشار سیستولی تقریبی را بگیر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاف کوچک روی بازوی چاق عدد را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به‌دروغ بالا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشان می‌دهد و کاف بزرگ روی بازوی لاغر، به‌دروغ پایین."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:d0ff42f68ff39a2e906e06fc23e41b3d078938a90941baac95fb9ad80d3fcf8c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "b8326a89f52867f8c18c2fbe2c776a6c54993afdd25496a8adb84e29e6d9fe70",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "روش سمعی و شمارش نبض"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "با فشارسنج دستی، اول نبض رادیال را لمس کن و کاف را تا حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۰ mmHg"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بالاتر از جایی که نبض محو می‌شود باد کن. بعد گوشی را روی شریان براکیال بگذار و هوا را آهسته، ۲ تا ۳ mmHg در ثانیه، خالی کن."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-1-2.webp",
                  "alt": "اندازه‌گیری فشار با روش سمعی و شمارش نبض رادیال با دو انگشت",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/af07ad40a5087610cd8f2b271c2b3399258c7bde218ea0399b0b43451623cc97.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اندازه‌گیری فشار با روش سمعی و شمارش نبض رادیال با دو انگشت "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary Oral and Maxillofacial Surgery, 7th ed. — Fig. 1.2)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نخستین صدای ضربه (صدای کورتکوف) = فشار "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سیستولی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قطع کامل صدا = فشار "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دیاستولی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار طبیعی بزرگسال: سیستولی ۹۰ تا ۱۲۰ و دیاستولی ۶۰ تا ۸۰ mmHg"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گاهی صدا بین سیستولی و دیاستولی مدتی قطع می‌شود (auscultatory gap). اگر تخمین لمسی نگرفته باشی، ممکن است کاف را کم باد کنی و فشار سیستولی را خیلی پایین‌تر از واقع بخوانی."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نبض"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبض "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رادیال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (سمت شست مچ) یا کاروتید (کنار نای) را با انگشت اشاره و میانی بگیر؛ نه با شست، چون خودش نبض دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "طبیعی: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۶۰ تا ۱۰۰"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بار در دقیقه؛ بالای ۱۰۰ تاکی‌کاردی و زیر ۶۰ برادی‌کاردی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای کشف بی‌نظمی، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "یک دقیقه‌ی کامل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بشمار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضربان جاافتاده‌ی گاه‌به‌گاه (PVC) شایع است؛ ولی ۵ بار یا بیشتر در دقیقه مشاوره‌ی پزشکی می‌خواهد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در اورژانس نبض "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاروتید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را بگیر؛ شریان بزرگ و مرکزی است و وقتی نبض اندام‌ها لمس نمی‌شود، هنوز حس می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
