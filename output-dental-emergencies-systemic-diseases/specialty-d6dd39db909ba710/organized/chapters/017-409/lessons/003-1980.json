  "steps": [
    {
      "id": "theory:94eeb44c388169814d344946a42ff978696cb2f527e70b9b4bef1aef971c7b07",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "e4c479a60bc2fa0073c9aaede9c68c35182ea6bcd6489bbd06d8ed061b5e6dd5",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دابیگاتران و مهارکننده‌های فاکتور Xa"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۶۱ ساله‌ای با فیبریلاسیون دهلیزی آپیکسابان می‌خورد و برای کشیدن یک پرمولر لق آمده. دستیارت می‌پرسد: «برایش INR بگیریم؟»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "DOACها دو گروه‌اند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دابیگاتران:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مهارکننده‌ی مستقیم ترومبین (فاکتور IIa)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ریواروکسابان، آپیکسابان و ادوکسابان:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مهارکننده‌ی مستقیم فاکتور Xa؛ نام همه‌شان به «ـکسابان» ختم می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این داروها در بسیاری از بیماران جای وارفارین را گرفته‌اند، چون:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پایش INR نمی‌خواهند و غذا روی اثرشان تأثیری ندارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیمه‌عمرشان کوتاه و قابل‌پیش‌بینی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطر خون‌ریزی پس از کار دندانپزشکی با آن‌ها از وارفارین کمتر است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گرفتن PT یا INR برای بیمار DOAC. INR برای وارفارین ساخته شده و میزان اثر DOAC را نشان نمی‌دهد. آزمایش اختصاصی، مثل سنجش anti-Xa، در دسترس روزمره نیست و جوابش ۳ تا ۵ روز طول می‌کشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:827bd191e1f56864b2e6b1a7c7ae02cb6ac04505efcfcff82debfce391c34a9c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "222b5db84b08ee9fd31cd5d7d0429ffc0442b723b8e516423058d7dd708f6cda",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بیمار DOAC و هپارین در مطب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کار کم‌خطر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (بی‌حسی، ترمیم، اندو، کشیدن ساده‌ی تا ۳ دندان، جرم‌گیری عمقی): DOAC ادامه می‌یابد و هموستاز موضعی کافی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جراحی پرخطر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (کشیدن بیش از ۳ دندان، جراحی با فلپ، جراحی ارتوگناتیک): تصمیم با پزشک است. اگر قطع لازم شد، معمولاً "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۲ تا ۴۸ ساعت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش از جراحی قطع و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "روز بعد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از سر گرفته می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "DOAC به bridging با هپارین نیاز ندارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماکرولیدها (مثل کلاریترومایسین) و ضدقارچ‌های آزولی سطح DOAC را بالا می‌برند؛ NSAIDها خطر خون‌ریزی را بیشتر می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پادزهر اختصاصی: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ایداروسیزوماب"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای دابیگاتران و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آندگزانت آلفا"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای مهارکننده‌های Xa."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هپارین"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هپارین استاندارد وریدی و بیمارستانی است، با aPTT پایش می‌شود و نیمه‌عمرش ۱ تا ۲ ساعت است؛ برای همین بیمار همودیالیزی را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روز بعد از دیالیز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درمان کن. هپارین با وزن مولکولی کم (LMWH) مثل انوکساپارین زیرجلدی است و پایش آزمایشگاهی نمی‌خواهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اگر پزشک قطع وارفارین را برای بیمار پرخطر (دریچه‌ی مکانیکی، ترومبوز وریدی کمتر از ۳ ماه) لازم بداند، با انوکساپارین bridging می‌کند. بیمار کم‌خطر bridging نمی‌خواهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
