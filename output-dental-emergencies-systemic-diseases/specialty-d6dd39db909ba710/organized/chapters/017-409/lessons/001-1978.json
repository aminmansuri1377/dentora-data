  "steps": [
    {
      "id": "theory:0bc68b45d7836693054bf2dbcfccee291ea32e75f010c51f92ba6778c5f04670",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "b221a9ab6af9127090546c67c4afd8f3c384c671ac2aa65f97d9dba51d227409",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مراحل هموستاز و الگوی خون‌ریزی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۵۵ ساله‌ای را صبح دیدی و یک مولر پایینش را بی‌دردسر کشیدی؛ لخته هم سر جایش بود. ساعت ۱۰ شب زنگ می‌زند که هنوز از جای دندان خون می‌آید. چرا خون‌ریزی ساعت‌ها بعد شروع شده است؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/med-fig-1-1.webp",
                  "alt": "پتشی و اکیموز پوست؛ الگوی خون‌ریزی نقص پلاکتی یا عروقی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/f455a558a290944cc2be24134476767f4c8dfacfd46cba71e1777c6218ef3290.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پتشی و اکیموز پوست؛ الگوی خون‌ریزی نقص پلاکتی یا عروقی "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 1.1)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای جواب باید بدانی بدن خون‌ریزی را در چه مراحلی بند می‌آورد:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مرحله‌ی عروقی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بلافاصله پس از آسیب، رگ منقبض می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مرحله‌ی پلاکتی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " چند ثانیه بعد پلاکت‌ها می‌چسبند و توپی پلاکتی می‌سازند؛ این هموستاز اولیه است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مرحله‌ی انعقادی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از بقیه کندتر است. ترومبین فیبرینوژن را به فیبرین تبدیل می‌کند و لخته محکم می‌شود؛ این هموستاز ثانویه است. از آسیب تا لخته‌ی پایدار حدود ۹ تا ۱۸ دقیقه طول می‌کشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فیبرینولیز:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پلاسمین لخته را پس از انجام کارش حل می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقص پلاکتی یا عروقی: خون‌ریزی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فوری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، حتی از بریدگی کوچک؛ همراه پتشی، پورپورا و اکیموز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقص انعقادی: خون‌ریزی ممکن است "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساعت‌ها بعد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شروع شود و در موارد شدید روزها ادامه یابد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فاکتورهای II، VII، IX و X برای ساخته شدن به ویتامین K نیاز دارند. این ویتامین از سبزی‌های برگ‌سبز و باکتری‌های روده می‌آید، و وارفارین دقیقاً همین چهار فاکتور را هدف می‌گیرد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:48aa02cca2d92ef0fb852f0ae00dd4b98d17d23eb64d659a35e279fb703faf3b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ef4c0d094474207e057c283a80f9787216863dcf6fa606484a2ed7c82ecbec01",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آزمایش‌های غربالگری انعقاد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر بیمار سابقه‌ی خون‌ریزی دارد یا در معاینه نشانه‌ای دیدی، این چهار آزمایش غربالگری را درخواست کن:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "PT (۱۱ تا ۱۵ ثانیه):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مسیر خارجی (فاکتور VII) و مسیر مشترک را می‌سنجد. برای پایش وارفارین، شکل استانداردشده‌ی آن یعنی INR را می‌خواهی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "aPTT (۲۵ تا ۳۵ ثانیه):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مسیر داخلی (فاکتورهای VIII، IX، XI و XII) و مسیر مشترک را می‌سنجد و بهترین آزمایش تکی برای غربالگری اختلال انعقادی است. هپارین استاندارد آن را طولانی می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "TT (۹ تا ۱۳ ثانیه):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فقط تبدیل فیبرینوژن به فیبرین را می‌سنجد؛ با هپارین و دابیگاتران طولانی می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شمارش پلاکت (۱۵۰٬۰۰۰ تا ۴۵۰٬۰۰۰):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " زیر ۵۰٬۰۰۰ با آسیب جزئی خون‌ریزی زیاد می‌دهد؛ زیر ۲۰٬۰۰۰ خون‌ریزی خودبه‌خود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "شمارش پلاکت فقط "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعداد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را نشان می‌دهد، نه عملکرد را؛ پس اثر آسپرین را نمی‌بیند. زمان سیلان (bleeding time) هم دیگر آزمایش معتبری نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آزمایش روتین پیش از هر کار جراحی. بیماری که سابقه‌ی خون‌ریزی ندارد و معاینه‌اش طبیعی است، برای کار کم‌خطر آزمایش نمی‌خواهد؛ بیمار با سابقه‌ی مثبت را به پزشک یا هماتولوژیست ارجاع بده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
