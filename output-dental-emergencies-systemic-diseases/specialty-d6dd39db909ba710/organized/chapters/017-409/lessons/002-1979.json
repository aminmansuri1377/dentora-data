  "steps": [
    {
      "id": "theory:6d299218565299182e88f2098da0dcd105da21b70539bec5ce567eee3432b896",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "40ad6ecbe5d191bf7a3060fe627d19ec0bfc00b261dc534b87b87a0cb34dce62",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "وارفارین و محدوده‌ی هدف INR"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۶۸ ساله‌ای با دریچه‌ی مکانیکی میترال برای کشیدن یک پرمولر آمده و وارفارین می‌خورد. می‌پرسد: «دکتر، سه روز قرصم را قطع کنم؟» پیش از جواب، باید بدانی وارفارین چه می‌کند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وارفارین "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آنتاگونیست ویتامین K"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است و ساخت فاکتورهای II، VII، IX و X را مهار می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اثر درمانی‌اش "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۴ تا ۵ روز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پس از شروع کامل می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای پایش آن، PT را به شکل "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "INR"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گزارش می‌کنند تا جواب آزمایشگاه‌های مختلف با هم قابل مقایسه باشد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محدوده‌ی هدف INR"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲ تا ۳ (هدف ۲٫۵):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فیبریلاسیون دهلیزی، ترومبوز وریدی عمقی (DVT)، آمبولی ریه، و دریچه‌ی بافتی در ۳ ماه اول."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲٫۵ تا ۳٫۵ (هدف ۳):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دریچه‌ی مکانیکی قلب، پیشگیری از تکرار MI، و ترومبوز در سندرم آنتی‌فسفولیپید."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گفتن «قرصت را چند روز قطع کن». قطع وارفارین خطر لخته و آمبولی را بالا می‌برد و برای کارهای جزئی دندانپزشکی لازم نیست. هر تغییری در دوز فقط با پزشک بیمار است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:7abd3c719594b9b6f63c168b745f32abb961bbd4204757051bde2bb50867e5d3",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "86d13dbef38ff589f3070f722662ac99520103ecaaaf6d04de1fd49fe049c158",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تصمیم درمانی در بیمار وارفارینی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "INR را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ترجیحاً ظرف ۷۲ ساعت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش از کار خون‌ریزی‌دار بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "INR تا ۳٫۵:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کارهای جزئی مثل کشیدن ساده‌ی تا ۳ دندان، جرم‌گیری عمقی، جراحی پریو یا ایمپلنت، با هموستاز موضعی انجام می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "INR بالاتر از ۳٫۵:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " خون‌ریزی قابل‌توجه محتمل است؛ کار را عقب بینداز و با پزشک هماهنگ کن. پس از تغییر دوز، معمولاً ۳ تا ۵ روز طول می‌کشد تا INR جابه‌جا شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تداخل‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غذای سرشار از ویتامین K (سبزی‌های برگ‌سبز) اثر وارفارین را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آموکسی‌سیلین، کلیندامایسین، مترونیدازول، ماکرولیدها و ضدقارچ‌های آزولی مثل فلوکونازول اثرش را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زیاد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آسپرین و NSAIDها خطر خون‌ریزی را بالا می‌برند؛ برای درد استامینوفن با یا بدون کدئین بده."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "در اورژانس، اثر وارفارین را با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ویتامین K"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، کنسانتره‌ی کمپلکس پروترومبین (PCC) یا پلاسمای تازه‌ی منجمد (FFP) برمی‌گردانند؛ این کار بیمارستانی است، نه مطب."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
