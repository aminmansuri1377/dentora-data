  "steps": [
    {
      "id": "theory:fd6c82dcb94f3d29e62d4d186cb5e6a00bea57a8719147fe944e4da7b2c145f4",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6ce011c1fbe457a2ce4e7e5f0def99bd3b7dbc7385ab2cfaa3aa69eda4d621b3",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ماکرولیدها، آزول‌ها و CYP3A4"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۶۶ ساله‌ای با آبسه‌ی دندانی آمده. سیمواستاتین، آملودیپین و وارفارین می‌خورد و به پنی‌سیلین آلرژی دارد. همکارت می‌خواهد کلاریترومایسین بنویسد. نگرانی‌ات چیست؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیشتر تداخل‌های مهم از آنزیم‌های کبدی سیتوکروم P450 می‌آیند، به‌ویژه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "CYP3A4"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مهارکننده‌ها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اریترومایسین و کلاریترومایسین، ضدقارچ‌های آزولی (کتوکونازول، فلوکونازول، ایتراکونازول)، دیلتیازم، وراپامیل، ریتوناویر و آب گریپ‌فروت. داروی دیگر دیرتر تجزیه می‌شود و سطحش بالا می‌رود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "القاکننده‌ها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کاربامازپین، فنی‌توئین، فنوباربیتال و ریفامپین. داروی دیگر تندتر تجزیه می‌شود و اثرش کم می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ماکرولید یا آزول کنار این داروها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استاتین‌ها: درد عضلانی، رابدومیولیز و نارسایی حاد کلیه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسدودکننده‌ی کانال کلسیم: افت فشار شدید"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بنزودیازپین‌ها، به‌ویژه تریازولام و میدازولام خوراکی: آرام‌بخشی بیش از حد"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاربامازپین، تئوفیلین و دیگوکسین: رسیدن به سطح سمی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وارفارین: بالا رفتن INR"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارویی را که با همان آنزیم CYP تجزیه می‌شود کنار داروی دیگرِ همان آنزیم ننویس. در بیمار این کیس، آزیترومایسین تداخل افت فشار با آملودیپین را ندارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:c224ea1196c7e62e0ab2d2b30884323908c86fb20980da3847723b2c16bd2c48",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ec86a94e34586b24fb915bd4d2f34867c78b321d45ba5134ecf0748c83addf7e",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مسکن‌ها، آنتی‌بیوتیک‌های دیگر و داروهای گیاهی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مسکن‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "NSAID با لیتیوم: مسمومیت با لیتیوم (تهوع، استفراغ، لکنت زبان، گیجی)؛ NSAID ننویس."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "NSAID با وارفارین یا ضدپلاکت: خون‌ریزی؛ با SSRI یا الکل: زخم و خون‌ریزی گوارشی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "NSAID با داروی فشار: اثر ضدفشار کم می‌شود؛ مصرف چندروزه مشکلی ندارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استامینوفن با الکل: آسیب کبد، به‌ویژه با ناشتایی یا ۴ گرم در روز و بیشتر. در بیمار وارفارینی، بیش از ۲ گرم در روز برای بیش از یک هفته INR را بالا می‌برد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مترونیدازول و تتراسایکلین"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مترونیدازول با الکل: واکنش شبه‌دی‌سولفیرام؛ تهوع، استفراغ و گرگرفتگی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مترونیدازول و تتراسایکلین سطح لیتیوم را بالا می‌برند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تتراسایکلین با آنتی‌اسید، لبنیات یا آهن کمتر جذب می‌شود؛ داکسی‌سایکلین کمتر از بقیه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "داروهای گیاهی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جینکو، سیر، جینسنگ و گلوکزامین اثر ضدانعقاد و ضدپلاکت را زیاد می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گل راعی (St. John’s wort) آنزیم CYP3A4 را القا می‌کند و اثر سیکلوسپورین و داروهای HIV را کم می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افدرا: فشار خون بالا، آریتمی و سکته، کاوا: هپاتیت، سنبل‌الطیب: اثر آرام‌بخش‌ها را زیاد می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «گیاهی است، پس بی‌خطر است». به بیماری که مکمل گیاهی می‌خورد NSAID را با احتیاط بده؛ خطر خون‌ریزی بیشتر می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
