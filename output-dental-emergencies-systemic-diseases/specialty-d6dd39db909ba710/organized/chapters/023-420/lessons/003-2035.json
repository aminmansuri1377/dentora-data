  "steps": [
    {
      "id": "theory:02e9e6e3646b68fa48782a8717a6c059de46139f7cc45478a39e7587f2ccd6f3",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "0e3ccd400a5736460981dbe4aebfc9bd7a5daf6589a4a89a0aae1e4602868735",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "GFR و داروهای نفروتوکسیک"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۵۸ ساله با بیماری مزمن کلیه و GFR برابر ۳۵ mL/min پس از کشیدن دندان درد دارد. دستیار می‌خواهد برایش ایبوپروفن و تتراسایکلین بنویسد. چه می‌گویی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلیه راه دفع بسیاری از داروهاست. وقتی GFR به حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵۰ mL/min"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌رسد، داروهایی که از کلیه دفع می‌شوند با نصف کارایی دفع می‌شوند و ممکن است به سطح سمی برسند. پس زیر ۵۰:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دوز را کم کن یا فاصله‌ی دوزها را بیشتر کن؛ با جدول دوز کلیوی و پزشک بیمار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داروی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نفروتوکسیک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ننویس."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "داروهای نفروتوکسیک"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "NSAIDها و آسپرین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ساخت پروستاگلاندین را مهار می‌کنند، پس رگ‌های کلیه تنگ و خون‌رسانی کلیه کم می‌شود. احتباس سدیم و ادم را هم بدتر می‌کنند و نقص پلاکتی اورمی را تشدید."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تتراسایکلین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، به‌جز داکسی‌سایکلین"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آسیکلوویر و آمینوگلیکوزیدها"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استامینوفن در دوز بالا"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "چند عامل دیگر هم اثر دارو را تغییر می‌دهند: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آلبومین پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جای اتصال دارو را کم می‌کند و بخش آزاد و اثر دارو را بالا می‌برد. ادم شدید ممکن است دوز اولیه‌ی بیشتری بخواهد و کم‌آبی دوز کمتری."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:777d4cd21d820c28b6b97edeabf0387065d5f0ee9a7ed9d3821badfd23cfa967",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "48002654d3132a7035a8a04eedf8ca6ee8bbc450a61cd347cbe0db56734a450a",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مسکن، آنتی‌بیوتیک و آرام‌بخشی در بیمار کلیوی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بی‌حسی موضعی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " لیدوکائین، آرتیکائین، مپیواکائین و پریلوکائین کاهش دوز نمی‌خواهند، ولی سقف معمول هر دارو را رعایت کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مسکن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " استامینوفن برای مدت کوتاه از آسپرین و NSAID امن‌تر است، چون در کبد متابولیزه می‌شود. مخدرها تنظیم دوز می‌خواهند و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مپریدین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ممنوع است: متابولیتش جمع می‌شود و تشنج می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آنتی‌بیوتیک:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کلیندامایسین، مترونیدازول، داکسی‌سایکلین و پنی‌سیلین V تنظیم دوز نمی‌خواهند. آموکسی‌سیلین و سفالکسین در GFR پایین با فاصله‌ی بیشتر داده می‌شوند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ضدقارچ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دوز فلوکونازول در GFR پایین کم می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آرام‌بخشی و بی‌هوشی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکسید نیتروژن و دیازپام تغییر چندانی نمی‌خواهند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باربیتورات‌ها و مخدرها در اورمی آرام‌بخشی بیش از حد می‌دهند، چون سد خونی‌ـ‌مغزی سالم نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از آرام‌بخشی وریدی هموگلوبین یا هماتوکریت را ببین و SpO2 را پیش و حین آن بسنج. با هموگلوبین زیر ۱۰ g/dL بی‌هوشی عمومی توصیه نمی‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار همودیالیزی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیالیز بعضی داروها را از خون برمی‌دارد؛ داروهایی که کم به پروتئین پلاسما متصل می‌شوند بیشتر، و داروهای درشت‌مولکول (بالای ۵۰۰ دالتون) کمتر. دارو را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از دیالیز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
