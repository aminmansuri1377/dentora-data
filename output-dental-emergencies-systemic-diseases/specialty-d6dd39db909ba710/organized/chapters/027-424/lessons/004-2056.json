  "steps": [
    {
      "id": "theory:713cbc8a15490beb910c2b01d87ee8a98e0d7dfad8c0a876adb9d60352996725",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "9667f16afec9d0f79969b0f91969825e1e4d1d0f432236bb83f8f672aedbf3c4",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آپنه‌ی انسدادی خواب (OSA)"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۵۲ ساله‌ای با BMI ۳۶ برای سایش شدید دندان‌ها آمده. همسرش می‌گوید خروپفش از پشت در بسته هم شنیده می‌شود و گاهی نفسش چند ثانیه قطع می‌شود و با خرخر برمی‌گردد. صبح‌ها سردرد دارد و سر کار چرت می‌زند. به چه شک می‌کنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آپنه‌ی انسدادی خواب (OSA)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". در خواب، راه هوایی فوقانی بارها نیمه‌بسته یا کاملاً بسته می‌شود، در حالی که بیمار هنوز برای نفس کشیدن تلاش می‌کند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آپنه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " قطع کامل یا تقریباً کامل جریان هوا، دست‌کم ۱۰ ثانیه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هیپوپنه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کاهش نسبی جریان هوا همراه با افت اکسیژن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر رویداد با بیدار شدن نیمه‌کاره تمام می‌شود؛ خواب تکه‌تکه و سبک می‌ماند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در آپنه‌ی مرکزی مشکل از فرمان تنفسی مغز است نه انسداد، و بیشتر همراه بیماری‌هایی مثل نارسایی قلب دیده می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عوامل خطر"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چاقی: حدود ۷۰٪ بیماران چاق‌اند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دور گردن بیش از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۴۳ سانتی‌متر در مرد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و ۴۱ در زن؛ از BMI به شدت بیماری نزدیک‌تر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرد بودن، رتروگناتی، زبان بزرگ، و لوزه و آدنوئید بزرگ (در کودکان ۲ تا ۵ ساله)."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیامدها: خواب‌آلودگی روز و خطر تصادف، فشار خون بالا، سکته‌ی مغزی، آریتمی، نارسایی قلب و سندرم متابولیک."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تقریباً همه‌ی بیماران OSA خروپف می‌کنند، اما بیشتر کسانی که خروپف می‌کنند OSA ندارند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:d4140226d03fe2fa9c999be418502aeca14935a2aab8b1dea3736f01102788b6",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "e2635d8e50d0e09e522536baaf251abddf5fdd816a9845350c6baa2763cf7503",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "غربالگری، تشخیص و درمان OSA"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کار تو پیدا کردن بیمار مشکوک و ارجاع اوست؛ تشخیص با پزشک خواب است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/med-fig-9-9.webp",
                  "alt": "چند نمونه اپلاینس پیش‌آورنده‌ی مندیبل برای درمان آپنه‌ی انسدادی خواب",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/3baaf199b10d62261788edc8d5505e629b4c957f311f43ea5163657243b6d5f5.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چند نمونه اپلاینس پیش‌آورنده‌ی مندیبل برای درمان آپنه‌ی انسدادی خواب "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 9.9)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "STOP-BANG:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هشت پرسش بله/خیر: خروپف بلند، خستگی روز، قطع نفس دیده‌شده، فشار خون بالا، BMI بیش از ۳۵، سن بالای ۵۰، دور گردن بیش از ۴۰ سانتی‌متر، مرد بودن. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سه «بله» یا بیشتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یعنی خطر بالا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مقیاس اپورث:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نمره‌ی بیش از ۱۰ یعنی خواب‌آلودگی قابل‌توجه، ولی ویژه‌ی OSA نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلاس بالاتر مالامپاتی، خطر بیشتر. نشانه‌های همراه: سایش دندان و براکسیسم خواب، هیپرتروفی ماستر، کناره‌ی دندانه‌دار زبان، سردرد صبحگاهی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تشخیص و شدت"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تشخیص با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پلی‌سومنوگرافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (PSG) یا تست خواب در منزل است. AHI شمار آپنه و هیپوپنه در هر ساعت خواب است: بیش از ۵ همراه علامت یعنی OSA؛ ۵ تا ۱۵ خفیف، ۱۵ تا ۳۰ متوسط، بیش از ۳۰ شدید."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درمان"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاهش وزن، ورزش، خوابیدن به پهلو، پرهیز از الکل و آرام‌بخش پیش از خواب."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "CPAP:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " استاندارد طلایی؛ اما فقط حدود نیمی از بیماران تحملش می‌کنند. ممکن است خشکی دهان بدهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اپلاینس پیش‌آورنده‌ی مندیبل (MAD):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای خروپف ساده، OSA خفیف تا متوسط، یا OSA شدید پس از شکست CPAP. سفارشی و قابل تنظیم، ساخت دندانپزشک آموزش‌دیده؛ پزشک خواب اثرش را با تست دوباره می‌سنجد. نوع بازاری «بجوش و گاز بگیر» توصیه نمی‌شود. عوارض: درد TMJ و عضلات، درد دندان، بزاق زیاد و تغییر اکلوژن."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
