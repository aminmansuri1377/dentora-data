  "steps": [
    {
      "id": "theory:00281da7b1b9bcdffb08cdb3cf603e25c626017ab1d0a47348bff54cc7757dea",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "222a0ca51f7d743de685d306e1b3827d4fd77f5d2cff1285f131078bc30808cb",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بیماری انسدادی مزمن ریه (COPD)"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۶۴ ساله‌ای که چهل سال سیگار کشیده، برای کشیدن یک مولر آمده. از پله‌های مطب نفس‌نفس‌زنان بالا آمده، هر صبح سرفه‌ی خلط‌دار دارد و پالس‌اکسیمتر SpO2 را ۹۳٪ نشان می‌دهد. پیش از بی‌حسی به چه فکر می‌کنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "او به احتمال زیاد "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "COPD"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد: محدودیت مزمن جریان هوا که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاملاً برگشت‌پذیر نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". همین نکته آن را از آسم جدا می‌کند که حمله‌هایش برگشت‌پذیرند. شروعش آرام است و بسیاری از بیماران از آن خبر ندارند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "برونشیت مزمن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سرفه‌ی خلط‌دار دست‌کم ۳ ماه در سال، در دو سال پشت سر هم."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آمفیزم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بزرگ شدن دائمی فضاهای هوایی با تخریب دیواره‌ی آلوئول‌ها."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مهم‌ترین علت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیگار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و ۸۵ تا ۹۰٪ مرگ‌های COPD به آن برمی‌گردد؛ با این حال فقط حدود یک نفر از هر پنج سیگاری قدیمی COPD می‌گیرد. آلاینده‌های شغلی و محیطی و کمبود آلفا-۱ آنتی‌تریپسین هم نقش دارند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو چهره‌ی کلاسیک"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "برونشیت مزمن (blue bloater):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اضافه‌وزن، سیانوز، ادم، سرفه با خلط فراوان و عفونت‌های تنفسی مکرر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آمفیزم (pink puffer):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " لاغر، قفسه‌ی سینه‌ی بشکه‌ای، تنگی نفس شدید با سرفه‌ی کم، بازدم با لب‌های غنچه‌شده، بدون سیانوز."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیشتر بیماران ترکیبی از هر دو چهره‌اند. در برونشیت مزمن ممکن است کار به نارسایی قلب راست (cor pulmonale) بکشد؛ آمفیزم خطر پنوموتوراکس دارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a86a772afa5fb6d7d2e8fc5111250ccf2539a85e4a5450854199fdec7dc2d5a8",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "4d87845db14402588f470ed6317196908843e6108264c9bab1b4b34184b34c97",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "درمان دندانپزشکی بیمار COPD"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از درمان: پایدار است یا نه؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناپایدار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است اگر یکی از این‌ها را داشته باشد؛ درمان انتخابی را عقب بینداز و به پزشک ارجاع بده:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنگی نفس در حال استراحت"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرفه‌ی خلط‌دار یا عفونت تنفسی فوقانی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "SpO2 زیر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۹۱٪"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درمان سرپایی در مرحله‌ی I تا III ممکن است؛ در مرحله‌ی IV (خیلی شدید) درمان انتخابی در مطب نکن. بگو اسپری نجاتش را همراه بیاورد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روی یونیت"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "وضعیت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نیمه‌نشسته؛ خوابیده به پشت تنگی نفس را بدتر می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اکسیژن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اگر SpO2 افت کرد، جریان کم (۲ تا ۳ لیتر در دقیقه، مرطوب) با هدف "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۸۸ تا ۹۲٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، نه ۱۰۰٪. اکسیژن زیاد ممکن است تنفس را کند کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در بیماری شدید "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رابردم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نزن. بلاک دوطرفه‌ی مندیبل یا پالاتال هم ممکن است حس تنگی راه هوایی بدهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیماری قلبی همراه COPD شایع است؛ فشار خون را بگیر. اگر در خانه اکسیژن می‌گیرد، بگو کپسولش را همراه بیاورد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "داروها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اکسید نیتروژن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در مرحله‌ی III و IV منع دارد، چون گاز در فضاهای هوایی آسیب‌دیده جمع می‌شود؛ در بیماری خفیف تا متوسط فقط با احتیاط."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آرام‌بخش: دیازپام خوراکی کم‌دوز. مخدرها و باربیتورات‌ها تنفس را سرکوب می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنتی‌هیستامین‌های خوراکی ترشحات را خشک و خلط را غلیظ می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تئوفیلین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اریترومایسین، آزیترومایسین و سیپروفلوکساسین سطحش را بالا می‌برند و مسمومیت می‌دهند."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
