  "steps": [
    {
      "id": "theory:49dd75b8ebea045a8d095c22101ad84bf76e2c2e4a5c5d234452f1501c11a667",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6e1479f27c8c4dc389117dcfe289ba8ce0b5586addcae9b3b1b5a664bf333a06",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "نیکوتین، قلیان و عوارض دهانی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۳۰ ساله‌ای در فرم شرح حال نوشته «سیگاری نیستم»، اما لثه‌اش رنگ‌دانه‌ی قهوه‌ای دارد. وقتی می‌پرسی، می‌گوید آخر هفته‌ها قلیان می‌کشد و گاهی ویپ. آیا مصرف‌کننده‌ی دخانیات است؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/med-fig-8-7.webp",
                  "alt": "استوماتیت نیکوتینی شدید کام و ملانوز سیگاری در فرد پیپ‌کش",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/1f3bf04fe8f5500d67fc93e47c5e64603a945aa63f50f31e17700ea30a89d41f.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استوماتیت نیکوتینی شدید کام و ملانوز سیگاری در فرد پیپ‌کش "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 8.7)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بله. به‌جای «سیگار می‌کشی؟» بپرس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر نوع دخانیاتی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مصرف می‌کند یا نه: سیگار، قلیان، پیپ، ناس یا سیگار الکترونیکی."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیکوتین به‌شدت اعتیادآور است و از راه مسیرهای دوپامینی مغز اثر می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با هر پک، نیکوتین در حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۰ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " به مغز می‌رسد؛ این تقویت مکرر اعتیاد را می‌سازد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیمه‌عمرش حدود ۲ ساعت است. با افت سطح آن علائم ترک می‌آید: بی‌قراری، اضطراب، بی‌خوابی، گرسنگی و ولع."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قلیان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جایگزین بی‌خطر سیگار نیست؛ دودش هم نیکوتین، مونوکسید کربن و مواد سرطان‌زا دارد و آب کوزه پاکش نمی‌کند. بیشتر سیگارهای الکترونیکی هم نیکوتین دارند و بعضی پادها به اندازه‌ی یک پاکت سیگار. آئروسل آن‌ها ذرات بسیار ریز و فلزاتی مثل نیکل و سرب دارد. مغز نوجوان به نیکوتین حساس‌تر است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عوارض دهانی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لکوپلاکیا و کارسینوم سلول سنگفرشی؛ خطر عود و سرطان دوم هم بالاتر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیماری پریودنتال، ترمیم کند زخم، خشکی حفره (dry socket) و شکست ایمپلنت."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استوماتیت نیکوتینی (کام سفید و ضخیم با نقطه‌های قرمز، در پیپ‌کش‌ها)، ملانوز سیگاری (رنگ‌دانه‌ی قهوه‌ای لثه)، زبان مودار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنباکوی بدون دود مثل ناس: کراتوز محل نگه داشتن تنباکو، تحلیل لثه و کارسینوم وروکوس."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:9dc0bebfe5deb1cc3ac57110e7702183411a188c8ba7fe3687a7d178798063d7",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "76c04a90814271e6124a1fdbbd3f916125f13cb36b9ced5a9cb0302ed2b6f4d2",
      "position": 2,
