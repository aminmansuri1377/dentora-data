                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حمله‌ی هایپرونتیلاسیون؛ چون ریه‌اش پس از ترک ناگهان اکسیژن زیادی می‌گیرد"
                    }
                  ]
                }
              ]
            },
