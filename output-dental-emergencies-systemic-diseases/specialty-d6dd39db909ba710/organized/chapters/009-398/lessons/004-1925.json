  "steps": [
    {
      "id": "theory:2b7fbe31b8970c6ea09ea397088a85a095bb6d67c1f3929e783090240372a6ce",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "031818ff78e1d326a38b4245c5aa27b7eb94e647f5b20b680374113328ad66c6",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "حمله‌ی ایسکمیک گذرا (TIA)"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۶۸ ساله‌ای حین قالب‌گیری می‌گوید دست راستش بی‌حس شده و حرف زدنش کمی نامفهوم است. ده دقیقه بعد همه‌چیز طبیعی می‌شود و خودش اصرار دارد کار ادامه پیدا کند. ادامه می‌دهی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حمله‌ی ایسکمیک گذرا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (TIA) یعنی اختلال عصبی موضعی، ناگهانی و کوتاه که معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمتر از یک ساعت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طول می‌کشد و در تصویربرداری مغز نشانه‌ای از انفارکت ندارد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائمش همان علائم سکته است، ولی برطرف می‌شود: بی‌حسی یا ضعف یک طرف بدن، اختلال گفتار، یا تاری و تاریکی گذرای دید در یک چشم."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هوشیاری معمولاً سالم می‌ماند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا جدی است؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲۰٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سکته‌های مغزی با یک TIA خبر داده می‌شوند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطر سکته تا ۹۰ روز پس از TIA حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۰٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است و بیشترینش در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲۴ ساعت اول"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حدود ۸۰٪ سکته‌هایی که پس از TIA رخ می‌دهند قابل پیشگیری‌اند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " TIA هشدار است، نه ماجرایی تمام‌شده. برطرف شدن علائم یعنی فرصت پیشگیری، نه اجازه‌ی ادامه‌ی کار."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:3e5aec5615d96b362bb53e3dc6e7e273619cc51435e11957852a1c77bb0dc37b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "3bb54dedfa0986bb4406c572040886c4b61d5ec7f35f85eb24730a3b710aaea1",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اقدام در TIA و جلسه‌های بعد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تا وقتی علائم هست، نمی‌دانی TIA است یا سکته‌ی واقعی؛ پس مثل سکته رفتار کن: کار را قطع کن، ساعت شروع را یادداشت کن و با ۱۱۵ تماس بگیر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر علائم پیش از رسیدن کمک برطرف شد:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان را در آن جلسه ادامه نده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم حیاتی را بسنج و ثبت کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار باید "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "همان روز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " به ارزیابی پزشکی برسد؛ خطر سکته در ساعت‌های اول از همه بیشتر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را تنها و پشت فرمان به خانه نفرست."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار با سابقه‌ی TIA یا سکته"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار پایدار و بی‌علامت می‌تواند درمان روزمره بگیرد. قاعده‌ی قدیمی «۶ ماه صبر پس از سکته» پشتوانه‌ی علمی ندارد، ولی خطر سکته‌ی دوباره در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۹۰ روز اول"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیشتر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار با علائم فعال یا ناپایدار: درمان انتخابی را عقب بینداز و با پزشکش مشورت کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوبت کوتاه و کم‌استرس در میانه‌ی صبح؛ فشار خون و SpO2 را حین کار پایش کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی با اپی‌نفرین ۱:۱۰۰٬۰۰۰ به مقدار سنجیده (حداکثر حدود دو کارپول)؛ نخ رترکشن اپی‌نفرین‌دار نه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بسیاری از این بیماران آسپرین، کلوپیدوگرل یا ضدانعقاد می‌خورند؛ دارو را خودسرانه قطع نکن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای درد پس از کار استامینوفن بنویس؛ آسپرین و دیگر NSAIDها خطر خون‌ریزی را در این بیماران بیشتر می‌کنند."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
