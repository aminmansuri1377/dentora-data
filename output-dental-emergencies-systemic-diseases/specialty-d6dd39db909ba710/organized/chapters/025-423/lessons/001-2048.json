  "steps": [
    {
      "id": "theory:ddf9bb91f7875dd87a945a0e8e69d0a90f8e9fb645a145260ad9d01fbc0eb192",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "ea19ca9ec9aa171fa5e949935e43ebc28c0b4bc450f3d527bac5c8f6eda42e97",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "HIV: راه انتقال و مراحل بیماری"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۳۴ ساله‌ای برای جرم‌گیری آمده و در فرم سلامت نوشته که HIV دارد و داروی ضدرتروویروسی می‌خورد. دستیار آهسته می‌پرسد: «نوبتش را آخر روز بگذاریم و وسایل جدا بچینیم؟» جواب تو چیست؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جواب کوتاه: نه. این بیمار را هم مثل هر بیمار دیگری با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اقدامات استاندارد کنترل عفونت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درمان می‌کنی. رد کردن بیمار فقط به‌خاطر HIV پذیرفتنی نیست."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ویروس:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " HIV یک رتروویروس است که با پروتئین gp120 به لنفوسیت T کمکی (CD4) می‌چسبد و این سلول‌ها را کم‌کم از بین می‌برد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "راه انتقال:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تماس جنسی، خون و فراورده‌های خونی، و از مادر به نوزاد در بارداری، زایمان یا شیردهی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انتقال از راه "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بزاق"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یا تماس روزمره گزارش نشده است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه مرحله"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عفونت حاد:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " حدود ۷۰٪ افراد ۱ تا ۳ هفته پس از عفونت تب، گلودرد، بثورات پوستی و بزرگی غدد لنفاوی می‌گیرند که در ۱ تا ۲ هفته خوب می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دوره‌ی نهفته:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بی‌علامت، ولی CD4 آرام‌آرام کم می‌شود. بدون درمان، به‌طور میانه ۸ تا ۱۰ سال طول می‌کشد تا علائم بالینی بیاید."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ایدز:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " CD4 زیر ۲۰۰ در میلی‌متر مکعب، یا یک بیماری تعریف‌کننده‌ی ایدز مثل سارکوم کاپوزی یا پنومونی پنوموسیستیس."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:61a08b31dfe250dfd58e285a513128ec0072a40ee0819dd92f3b2745d583a6b5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "c2b6fa9e78a243e6c184add53c0277770539fb9e11b6a47e5127a5afcf5a4eaf",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ART، آزمایش‌ها و تصمیم درمانی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درمان ضدرتروویروسی (ART) ترکیب چند دارو است و بهتر است همان زمان تشخیص شروع شود. هدفش بار ویروسی زیر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲۰۰ کپی در میلی‌لیتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در ۳ تا ۶ ماه است. امید به زندگی بیماری که با ART کنترل شده، به جمعیت عمومی نزدیک است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از درمان دندانپزشکی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بار ویروسی، شمارش CD4 و CBC اخیر را بپرس."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بار ویروسی پایدارِ غیرقابل‌تشخیص:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هر درمان لازم، از ترمیم و درمان ریشه تا جراحی و ایمپلنت، بدون تغییر ویژه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "CD4 زیر ۲۰۰:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سرکوب شدید ایمنی و خطر عفونت فرصت‌طلب."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شمارش مطلق نوتروفیل (ANC) زیر ۱۰۰۰:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پروفیلاکسی آنتی‌بیوتیک پیش از کار تهاجمی، با مشاوره‌ی پزشک. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زیر ۵۰۰:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " درمان انتخابی را عقب بینداز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پلاکت زیر ۵۰٬۰۰۰:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش از جراحی، حتی جرم‌گیری و کورتاژ، شاید تزریق پلاکت لازم باشد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیماری که ART نمی‌گیرد، یا CD4 او رو به کاهش و بار ویروسی‌اش رو به افزایش است، پیش از کار تهاجمی CBC و مشاوره‌ی پزشکی می‌خواهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این بیماران بیشتر در خطر پوسیدگی (خشکی دهان از چنددارویی یا مصرف مواد) و بیماری پریودنتال‌اند؛ برنامه‌ی پیشگیری شخصی و فراخوان منظم بچین."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرورفتن سوزن در دست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خطر انتقال HIV حدود ۰٫۳٪ است؛ هپاتیت C حدود ۳٪ و هپاتیت B حدود ۳۰٪. سوزن توخالی، زخم عمیق، خون روی وسیله و بار ویروسی بالای بیمار خطر را بیشتر می‌کنند. این یک اورژانس است: پروفیلاکسی پس از تماس (PEP) باید هرچه زودتر، بهتر است ظرف "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ ساعت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و نه دیرتر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۷۲ ساعت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، شروع شود و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ هفته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ادامه یابد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
