                    {
                      "tag": "text",
                      "text": "درمان دندانپزشکی را تا پایان عمر به موارد اورژانس محدود کن، چون بیمار وارد ایدز شده"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
