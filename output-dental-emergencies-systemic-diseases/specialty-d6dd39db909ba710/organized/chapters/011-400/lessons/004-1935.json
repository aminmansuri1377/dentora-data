  "steps": [
    {
      "id": "theory:13783ded916ebb838ff332ed67d4959e8c2be398bd0651b68173949c219a1b46",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "0d6dafc8986f6fbfc4b6acc690e6eb8228905f2bb83c67d2e5908528f20f6b54",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آمادگی تیم مطب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار روی یونیت بی‌پاسخ شده است. تو CPR را شروع کرده‌ای؛ دستیار دنبال کیف می‌گردد، منشی نمی‌داند زنگ بزند یا نه، و هیچ‌کس ساعت را ندیده است. کجای کار ایراد داشت؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ایراد در همان لحظه نبود؛ پیش از آن بود. آمادگی، پس از پیشگیری، مهم‌ترین عامل در مدیریت اورژانس‌های مطب است و چهار پایه دارد:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آموزش خود دندانپزشک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و به‌روز نگه داشتن آن، از جمله BLS و کار با AED."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آموزش همه‌ی کارکنان:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دستیار، منشی و هر کسی که در مطب کار می‌کند باید BLS را بلد باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "راه دسترسی سریع به کمک:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ۱۱۵، پزشکان نزدیک و نزدیک‌ترین مرکز درمانی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تجهیز مطب"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " با دارو و وسایل لازم."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "از پیش با پزشکانی قرار کمک بگذار که در اورژانس ورزیده‌اند، مثل متخصص بیهوشی یا جراح فک و صورت؛ هر پزشکی در احیا ورزیده نیست. دندانپزشکی که آرام‌بخشی تزریقی (غیر از اکسید نیتروژن) انجام می‌دهد، بهتر است دوره‌ی ACLS هم ببیند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مغز پس از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ تا ۶ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بی‌اکسیژنی آسیب برگشت‌ناپذیر می‌بیند. تیمی که نقش‌هایش را از قبل می‌داند، همین دقیقه‌ها را نجات می‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:efd4a5f7df3aada67ab478d13a56c57af884de49631baa13a1021f65cae730f5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ffad5b5f884a0b704908eb3eef5b42df280a650a7d63df21542e65fc7d42e351",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "نقش‌ها، تمرین و وارسی کیف"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برنامه‌ی مکتوب با نقش مشخص"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک نفر با ۱۱۵ تماس می‌گیرد و اورژانس را تا مطب راهنمایی می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک نفر کیف اورژانس، کپسول اکسیژن و AED را می‌آورد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک نفر CPR را شروع می‌کند یا به دندانپزشک کمک می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک نفر داروها را آماده می‌کند و هر اتفاق را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "با ساعتش"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ثبت می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تمرین"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تمرین اورژانس (drill) منظم در خود مطب، با همان کیف و همان یونیت"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تمرین مهارت BLS برای همه‌ی کارکنان "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سالی یک بار"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شماره‌های اضطراری کنار هر تلفن و در گوشی‌ها؛ درستی‌شان را هرازگاهی با تماس امتحان کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وارسی کیف"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ماهی یک بار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کامل بودن محتوا، تاریخ انقضا و ظاهر داروها"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیتروگلیسرین پس از باز شدن فقط حدود ۳۰ روز مؤثر می‌ماند؛ تاریخ باز کردن را رویش بنویس."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پر بودن کپسول اکسیژن، و باتری و پدهای AED"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کیفی که در کمد اتاق آخر قفل است. کیف و کپسول باید جای ثابتی داشته باشند که همه‌ی کارکنان بدانند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
