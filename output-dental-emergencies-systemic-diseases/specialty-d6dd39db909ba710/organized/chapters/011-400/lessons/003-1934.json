    {
      "id": "theory:e3437426fb0f9bbc0679547b86cee86db203f5abcded163991bb28a3a189d70f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "fc460437f2fb0c9ba1ed3e5823c6500fe05611c9466fbe0a892c7aa450b5d278",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "داروهای کمکی کیف اورژانس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار دیابتی ۴۵ ساله‌ای روی یونیت بی‌هوش شده است. رگ‌گیری را تمرین نکرده‌ای و آبمیوه هم دیگر به کار نمی‌آید. در کیف چه داری که بدون رگ به او کمک کند؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "داروهای ضروری شایع‌ترین اورژانس‌ها را پوشش می‌دهند. داروهای کمکی برای موقعیت‌های کمتر شایع‌اند، یا برای وقتی که رسیدن کمک پزشکی زمان می‌برد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گلوکاگون ۱ میلی‌گرم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " عضلانی: هیپوگلیسمی در بیمار بی‌هوش. اگر رگ داری، دکستروز ۵۰٪ وریدی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "میدازولام:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تشنج طولانی؛ اسپری بینی ۵ میلی‌گرم یا تزریق عضلانی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نالوکسان ۰٫۴ میلی‌گرم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برگرداندن اثر مخدر، مثلاً افت تنفس پس از آرام‌بخشی با مخدر؛ وریدی، عضلانی یا زیرجلدی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هیدروکورتیزون ۱۰۰ میلی‌گرم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بحران آدرنال (وریدی یا عضلانی)، و پس از بهبود آنافیلاکسی برای پیشگیری از عود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آتروپین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برادی‌کاردی علامت‌دار؛ وریدی و در دست فرد دوره‌دیده‌ی ACLS."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فلومازنیل:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برگرداندن اثر بنزودیازپین؛ فقط وریدی و در دست فرد دوره‌دیده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آمونیاک معطر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در سنکوپ اختیاری است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خیال راحت پس از بیدار شدن بیمار با نالوکسان. اثر نالوکسان ممکن است "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زودتر از اثر مخدر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تمام شود و تنفس دوباره کند شود؛ بیمار را تا رسیدن اورژانس پایش کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:3c2c87d6dd6716e3f64e239fb96ea3de313e842661399fd5a710e35787c1ed88",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "36c78f4640d7232d0f418f6049a71533afc2960c66f8fcd03845a287ac5c0737",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "راه تجویز در اورژانس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در اورژانس بهترین راه آن است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سریع اثر کند و از دست تو برآید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". بیشتر دندانپزشکان رگ‌گیری را در موقعیت بحران تمرین نکرده‌اند؛ پس کیف مطب بر راه‌های بی‌نیاز از رگ تکیه می‌کند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عضلانی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اپی‌نفرین در قدام‌ـ‌خارج ران، گلوکاگون، میدازولام و دیفن‌هیدرامین."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زیرزبانی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نیتروگلیسرین؛ قرص زیر زبان حل می‌شود و بلعیده نمی‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جویدنی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آسپرین؛ جویدن اثر ضدپلاکتی را زودتر می‌رساند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "استنشاقی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سالبوتامول و اکسیژن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "داخل بینی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " میدازولام با اسپری یا اتومایزر بینی؛ در بیمارِ در حال تشنج رگ لازم نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خوراکی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " قند و قرص دیفن‌هیدرامین؛ فقط برای بیمار هوشیاری که می‌تواند ببلعد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "وریدی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دکستروز ۵۰٪، دیازپام، آتروپین و فلومازنیل؛ فقط برای کسی که دوره‌ی ACLS یا آموزش پیشرفته دیده است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دیازپام در آب حل نمی‌شود و از راه عضلانی جذب قابل‌پیش‌بینی ندارد؛ برای همین در بیماری که رگ ندارد، میدازولام انتخاب بهتری است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به بیمار بی‌هوش هیچ چیز از راه دهان نده؛ رفلکس بلعش ضعیف است و دارو یا مایع به ریه می‌رود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
