    {
      "id": "theory:f38c3e3c618fff63b6df921742a6d27241548946fb592d99588b38c6fa2105a1",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "07739c8d98eea210bd01b5244e0e2dddda271720b3e32a810acc052d79e67d18",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اکسیژن در مطب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۶۰ ساله‌ای در سالن انتظار غش می‌کند. اکسیژن مطب از سیستم مرکزی می‌آید و شیر آن فقط کنار یونیت‌هاست. حالا اکسیژن را چطور به او می‌رسانی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اکسیژن تنها قلمی است که هیچ مطبی نباید بدون آن باشد. بیشتر مطب‌ها از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کپسول پرتابل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " استفاده می‌کنند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر اکسیژن مطب مرکزی است، باز هم یک کپسول پرتابل لازم است؛ برای سالن انتظار و برای همراهی بیمار تا انتقال."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک روال ثابت بگذار که پر بودن کپسول را منظم وارسی کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جریان معمول در اورژانس‌های مطب "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵ تا ۶ لیتر در دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندانپزشک باید بتواند اکسیژن را با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فشار مثبت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هم برساند؛ یعنی با آمبوبگ، برای بیماری که خودش نفس نمی‌کشد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کی اکسیژن بدهی؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سنکوپ، آنافیلاکسی، حمله‌ی آسم و تشنج: اکسیژن کمکی مجاز و مفید است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنژین و سکته‌ی قلبی: فقط اگر SpO2 زیر ۹۰٪ است یا بیمار دیسترس تنفسی دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سکته‌ی مغزی: فقط اگر SpO2 زیر ۹۴٪ است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هایپرونتیلاسیون: اکسیژن جایی ندارد؛ مشکل از دست رفتن CO2 است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "احتیاط در COPD:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در این بیماران اکسیژن زیاد ممکن است تنفس را کند کند. اکسیژن را کم‌جریان بده و SpO2 را به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۸۸ تا ۹۲٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برسان، نه ۱۰۰٪. اگر تعداد تنفس افت کرد، اکسیژن را کم یا قطع کن و تنفس را زیر نظر بگیر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:0ae0805523e927be451092fee73fa9f2c78b074b741acbc0b99f79c0fe5795dd",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "df312c269f7137b47d8d1b0f49710a8eaa85ab468b0bbb215f83f288ee61b125",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تجهیزات کیف اورژانس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دارو بدون ابزار به کار نمی‌آید. تجهیزات را در سه گروه به خاطر بسپار:"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "راه هوایی و تنفس"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آمبوبگ با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ماسک شفاف"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تا استفراغ یا ترشح زیر ماسک دیده شود؛ و ماسک جیبی CPR"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایروی دهانی و بینی در چند اندازه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سر ساکشن پرحجم با قطر زیاد و رابطی که آن را به ساکشن مطب وصل کند؛ ساکشن معمولی بزاق از پس استفراغ برنمی‌آید."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پایش"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشارسنج و گوشی پزشکی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پالس‌اکسیمتر"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "AED"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ هر مطب دندانپزشکی باید یکی داشته باشد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تزریق"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ‌های ۱، ۵ و ۱۰ میلی‌لیتری و سوزن تزریق عضلانی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تورنیکه؛ و برای کسی که آموزش دیده، وسایل رگ‌گیری و سرم"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یونیت هم جزو تجهیزات است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باید بتوانی بیمار را سریع خوابیده به پشت با پاهای بالا قرار دهی و صندلی را نزدیک زمین بیاوری. اگر جای خواباندن بیمار روی زمین نیست، تخته‌ی مخصوص CPR را زیر قفسه‌ی سینه‌اش بگذار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لارنگوسکوپ، لوله‌ی تراشه و کانولای کریکوتیروتومی فقط به کار کسی می‌آیند که کار با آن‌ها را آموزش دیده است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
