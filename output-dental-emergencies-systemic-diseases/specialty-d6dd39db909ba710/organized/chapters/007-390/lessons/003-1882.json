  "steps": [
    {
      "id": "theory:7513acd02cf5ef0ff59eccc4197d275eebc51fe9eb2a82d399fcdb449dc1ad63",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "45699a0b3eb1d900773e8f2ae237c6966c0e6dd730f88767873e45cb0d280061",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "شناختن بیمار مضطرب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۳۰ ساله‌ای می‌گوید «مشکلی ندارم، شروع کنید». اما مدام با دکمه‌ی آستینش ور می‌رود، تند و بریده‌بریده حرف می‌زند و دهانش خشک است. آیا واقعاً مشکلی ندارد؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اضطراب از درمان دندانپزشکی شایع است. ریشه‌اش معمولاً تجربه‌ی بد قبلی یا تصوری است که بیمار از جلسه دارد. بیشترین ترس بیماران از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تزریق"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ صدا و لرزش توربین و نشستن روی صندلی هم از محرک‌های شایع‌اند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هوشیاری بیش از حد و بی‌قراری"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبض تند، تعریق، گشادی مردمک و تنش عضلانی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ور رفتن با لباس، و حرف زدن تند و بریده‌بریده"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خشکی دهان؛ ترس از علت‌های شایع خشکی دهان در مطب است"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بسیاری از بزرگسالان، به‌ویژه مردان جوان، ترسشان را به زبان نمی‌آورند. به رفتار بیمار نگاه کن، نه فقط به حرفش. بیمار سالمی که ترس بسیار شدید دارد، در طبقه‌بندی ASA معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ASA II"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چند واژه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در ترس، بیمار می‌داند از چه می‌ترسد؛ در اضطراب، منشأ برایش روشن نیست. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فوبیا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترس غیرمنطقی است که رفتار عادی را مختل می‌کند. فوبیای دندانپزشکی بیشتر از یک تجربه‌ی ترسناک قبلی می‌آید. حمله‌ی پانیک ترس ناگهانی و شدیدی است که با علائم بدنی همراه است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:42a3bb9e6c82a7f4ce8bae2f1d149628e714068a7d00dc556d3cf49237b7c787",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "e62ff7007a3dee293ff030f52b3b7586d33b2563c88f46cc9242e78cee4780bb",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پروتکل کاهش استرس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اضطراب فقط ناخوشایند نیست؛ خودش اورژانس می‌سازد. آنژین، سکته‌ی قلبی، حمله‌ی آسم، هیپوگلیسمی در بیمار انسولینی، تشنج صرعی، بحران آدرنال، طوفان تیروئیدی، فشار خون شدید و هایپرونتیلاسیون همه با اضطراب شعله‌ور می‌شوند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از جلسه"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داروی خواب شب قبل و آرام‌بخش صبح روز درمان (اختیاری)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوبت "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "صبح"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، جلسه‌ی کوتاه و انتظار کم در اتاق انتظار"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حین جلسه"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گفت‌وگوی باز: «امروز کمی نگران به نظر می‌رسی؛ دوست داری درباره‌اش حرف بزنیم؟»"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌غافلگیری: پیش از هر کار ناخوشایند خبر بده و فرصت پرسش بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ابزار و سرنگ دور از دید، بی‌سروصدای اضافه، موسیقی آرام"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ژل بی‌حسی سطحی، تزریق آهسته پس از آسپیراسیون، و بی‌حسی عمیق"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس از جلسه"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستور کوتاه و روشن، و گفتن عوارض قابل انتظار مثل تورم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسکن مؤثر و شماره‌ای برای تماس در صورت مشکل"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تماس تلفنی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در عصر همان روز برای پرسیدن حال بیمار"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
