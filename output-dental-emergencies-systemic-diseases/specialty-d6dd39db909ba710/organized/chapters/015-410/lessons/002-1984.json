  "steps": [
    {
      "id": "theory:78ff155093fc4cbbd8e9090caadef2c15716757e323d17442a1d27ead2ec5e2a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "4555af8c5d49e5e71297e6714d00a1408440ffdc7502d118276cdbcdd74987e6",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیس‌میکر و ICD"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۷۴ ساله‌ای برای کشیدن دندان آمده است. زیر ترقوه‌ی چپش برجستگی کوچکی دیده می‌شود و می‌گوید «هشت سال است باتری قلب دارم». می‌پرسد پیش از کشیدن دندان آنتی‌بیوتیک لازم دارد یا نه. چه جوابی می‌دهی؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیس‌میکر دائمی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ژنراتور باتری‌دار زیر پوست، معمولاً "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زیر ترقوه‌ی چپ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ لید از ورید ساب‌کلاوین به دهلیز یا بطن راست می‌رود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاربرد اصلی: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "برادی‌کاردی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بلوک AV"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیشترشان از نوع demand‌اند: ضربان طبیعی بیمار را حس می‌کنند و فقط وقتی لازم است ضربان می‌سازند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ICD (دفیبریلاتور کاشتنی)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مثل پیس‌میکر کار گذاشته می‌شود و پیس هم می‌کند؛ ولی ریتم را پیوسته پایش می‌کند و در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "VT یا VF"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شوک یا پیس ضدتاکی‌کاردی (ATP) می‌دهد. ATP ریتم را گاهی بدون شوک برمی‌گرداند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از پیس‌میکر بزرگ‌تر است و باتری‌اش کمتر دوام می‌آورد: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵ تا ۱۰ سال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنتی‌بیوتیک پروفیلاکسی لازم نیست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طبق گایدلاین AHA، بیمار با پیس‌میکر یا ICD برای کار دندانپزشکی پروفیلاکسی اندوکاردیت نمی‌گیرد. خود آریتمی هم خطر اندوکاردیت ندارد. جواب خانم بالا همین است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:940e2f736e94effe0c9593e22b64af0cd94f28de17c6f504d2b26a308b7bca03",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "782c67bec17bcc671999dc8f195fa6a53d1a877dd24c32721a72a6dae6f8cafc",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تداخل الکترومغناطیسی (EMI)"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "میدان الکتریکی یا مغناطیسی بیرونی ممکن است موقتاً کار پیس‌میکر یا ICD را به هم بزند. دستگاه سیگنال بیرونی را ضربان قلب می‌پندارد و تعداد ضربان، حس کردن یا برنامه‌اش عوض می‌شود."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "الکتروسرجری (کوتر برقی):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " روی این بیماران یا نزدیکشان به کار نبر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بی‌خطر با دستگاه‌های امروزی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " جرم‌گیر اولتراسونیک، اپکس‌لوکیتور، تست الکتریکی پالپ (EPT)، لایت‌کیور باتری‌دار، توربین و آنگل، رادیوگرافی و حمام اولتراسونیک."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عوامل مهم بیرون از مطب: MRI، دیاترمی، TENS و جوشکاری برق."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اثر میدان با فاصله به‌سرعت کم می‌شود (با مجذور فاصله)."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دستگاه‌های جدید محافظ بهتری دارند و تداخلشان با وسایل روزمره‌ی مطب ناچیز است. الکتروسرجری را همچنان کنار بگذار، چون در محیط پزشکی تداخل نشان داده و روی بیماران دندانپزشکی بررسی نشده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در شرح حال بپرس دستگاه پیس‌میکر است یا ICD و در پرونده ثبت کن؛ بیمار را به پیگیری منظم با متخصص قلب تشویق کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
