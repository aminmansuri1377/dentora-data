                  "children": [
                    {
                      "tag": "text",
                      "text": "احتمالاً اثر بتابلاکر است؛ در پرونده ثبت کن و درباره‌ی علائم بپرس"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
