  "steps": [
    {
      "id": "theory:b45d5ebc0dfb3fa2d12c5c74896f334f5e641309d4df7dc7327d44c7cb1c5810",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "a880686ebb22a2e1c8decc4830e5cbe9ac5da47c1ba80af047784aa90808d35b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ریتم طبیعی و آریتمی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۶۲ ساله‌ای برای جرم‌گیری آمده است. هنگام گرفتن علائم حیاتی، نبضش ۱۱۲ بار در دقیقه و نامنظم است. می‌گوید گاهی حس می‌کند «قلبم می‌پرد»، ولی هیچ‌وقت پیگیری نکرده است. کار را شروع می‌کنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آریتمی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی هر تغییری در ریتم، تعداد یا الگوی هدایت ضربان قلب. با بالا رفتن سن شایع‌تر می‌شود؛ حدود ۳۵٪ افراد بالای ۶۵ سال یک نوع آریتمی دارند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضربان طبیعی از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گره سینوسی (SA)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شروع می‌شود، از گره دهلیزی‌بطنی (AV) می‌گذرد و به بطن‌ها می‌رسد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ریتم سینوسی طبیعی بزرگسال: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۶۰ تا ۱۰۰"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بار در دقیقه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تاکی‌کاردی سینوسی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (بالای ۱۰۰): بیشتر پاسخ بدن به اضطراب، درد، تب یا اپی‌نفرین است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "برادی‌کاردی سینوسی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (زیر ۶۰): در ورزشکار و جوان سالم شایع است؛ بتابلاکر و بلوک‌کننده‌ی کانال کلسیم هم آن را می‌سازند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کافئین، نیکوتین، الکل و بی‌خوابی ضربان‌های زودرس را تحریک می‌کنند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نبض نامنظم، یا تپش قلب، سرگیجه، درد قفسه‌ی سینه، تنگی نفس و سنکوپ، حتی بی‌تشخیص قبلی، یعنی ارجاع به پزشک پیش از درمان انتخابی. بیمار بالا همین وضع را دارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:9022be2d296e713cd29d5e84f0e51d9bff61f1b564f92441c83d136203f9518c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "19a1bff8831a10da04a286c74eea772b4c71aa04ee46a78035218392a3021618",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آریتمی‌های فوق‌بطنی و بطنی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آریتمی‌ها را بر پایه‌ی محل شروعشان دو دسته می‌کنیم. در بیمار مستعد، استرس شدید، برخی داروها مثل اپی‌نفرین و خود درمان دندانپزشکی می‌توانند آریتمی کشنده راه بیندازند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فوق‌بطنی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فیبریلاسیون دهلیزی (AF):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شایع‌ترین آریتمی پایدار؛ نبض کاملاً نامنظم."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فلاتر دهلیزی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ریتم دهلیزی تند ولی منظم، ۲۵۰ تا ۳۵۰ بار در دقیقه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سندرم WPW:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مسیر هدایتی اضافه میان دهلیز و بطن که تاکی‌کاردی ناگهانی می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بلوک AV:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در درجه‌ی یک هدایت فقط کند می‌شود و همه‌ی ضربان‌ها به بطن می‌رسند؛ در درجه‌ی سه (بلوک کامل) هیچ ضربانی نمی‌رسد. درجه‌ی یک و موبیتز I معمولاً بی‌علامت‌اند؛ موبیتز II و درجه‌ی سه پیس‌میکر دائمی می‌خواهند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بطنی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "PVC:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ضربان زودرس بطنی؛ بسیار شایع و در قلب سالم بی‌خطر. پس از MI یا در نارسایی قلب، PVC مکرر خطر مرگ را بالا می‌برد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تاکی‌کاردی بطنی (VT):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سه PVC یا بیشتر پشت‌سرهم با تعداد ۱۰۰ یا بیشتر؛ ممکن است به VF برسد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فیبریلاسیون بطنی (VF):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فعالیت الکتریکی آشفته بی‌برون‌ده قلبی؛ اگر در ۳ تا ۵ دقیقه درمان نشود، مرگ می‌آورد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شدت علامت را معیار خطر گرفتن. بیمار PVC ممکن است علامت زیادی داشته باشد و در خطر نباشد؛ بیمار AF بی‌علامت باشد و در خطر سکته. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سندرم QT طولانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم سنکوپ، تشنج بی‌دلیل یا مرگ ناگهانی می‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
