  "steps": [
    {
      "id": "theory:a0248f2f1792ed0695f537d597e3fdd00ba6370cfeceafbf0d54bccde3720bf7",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "e466b872e971aab75b84fadc72d4295217fab25c77b840a0a333a63728840f07",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فیبریلاسیون دهلیزی و خطر سکته"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۷۶ ساله با فشار خون بالا برای کشیدن دو دندان آمده است. نبضش ۹۸ و کاملاً نامنظم است؛ هیچ دو ضربانی فاصله‌ی یکسان ندارند. در فهرست داروهایش آپیکسابان هست. چرا این دارو را می‌خورد؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "AF"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شایع‌ترین آریتمی پایدار بزرگسالان است و با سن و فشار خون بالا ارتباط محکمی دارد. دهلیزها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۵۰ تا ۶۰۰"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بار در دقیقه آشفته و بی‌اثر می‌لرزند و پاسخ بطن‌ها کاملاً نامنظم می‌شود."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دهلیزی که درست منقبض نمی‌شود، جای "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تشکیل لخته"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لخته ممکن است کنده شود و به مغز برود: از هر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۷"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سکته‌ی مغزی، یکی کار AF است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عوامل همراه: سن بالا، فشار خون، بیماری دریچه، دیابت، نارسایی قلب و مصرف زیاد الکل."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم متغیرند: تپش قلب، خستگی، سرگیجه یا تنگی نفس؛ بعضی بیماران هیچ علامتی ندارند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نبض را با دقت بشمار؛ AF کشف‌نشده ممکن است اولین بار روی یونیت تو پیدا شود. بیمار با نبض نامنظم و بی‌تشخیص را پیش از درمان انتخابی برای ارزیابی به پزشک بفرست."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:fea0522cfbb975c979a8adf35334543de8374205371da6bf1418f8a4cc8a434f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "7a0f72f5f72b2422b4af8043fbfc2f34add6a8d009feeb813f8706cc9b0f11a3",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ضدانعقاد در بیمار AF"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پزشک با امتیاز CHA2DS2-VASc (سن، جنس، فشار خون، دیابت، نارسایی قلب، سابقه‌ی سکته و بیماری عروقی) تصمیم می‌گیرد بیمار ضدانعقاد خوراکی بخورد یا نه."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وارفارین"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "INR هدف در AF: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲ تا ۳"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ". جواب INR را از ۲۴ تا ۷۲ ساعت پیش از جراحی ببین."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر INR ۳٫۵ یا کمتر است، کشیدن ساده بدون قطع یا تغییر وارفارین انجام می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مترونیدازول و پنی‌سیلین‌های وسیع‌الطیف INR را بالا می‌برند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "DOAC (دابیگاتران، ریواروکسابان، آپیکسابان، ادوکسابان)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آزمایش انعقادی روتین لازم ندارند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کشیدن ساده‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تا ۳ دندان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و جراحی جزئی بدون قطع دارو انجام می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای کشیدن "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیش از ۳ دندان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یا جراحی با فلپ، پزشک ممکن است قطع دارو از شب قبل تا فردای جراحی را تأیید کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نارسایی کلیه خطر خون‌ریزی را بیشتر می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قطع خودسرانه‌ی ضدانعقاد. خون‌ریزی را با هموستاز موضعی کنترل کن: اسفنج ژلاتینی، سلولز اکسیدشده، بخیه، گاز فشاری و دهان‌شویه‌ی ترانگزامیک اسید."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
