  "steps": [
    {
      "id": "theory:b3bd7a41c0e5fe7491a561246cb51daebf14b5e0cbc23ba5647d8b5b1cae1dba",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "acafc46a3ae760448881c35578387af8ab02cdef58537b509c5318149ce13cdb",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اندوکاردیت عفونی چیست"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۵۸ ساله‌ای که دو سال پیش دریچه‌ی آئورتش را با دریچه‌ی مصنوعی عوض کرده، برای درد دندان آمده. می‌گوید سه هفته است تب خفیف و خستگی دارد و «سرماخوردگی‌اش خوب نمی‌شود». روی کامش چند پتشی ریز می‌بینی. به چه فکر می‌کنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/med-fig-2-8.webp",
                  "alt": "وژتاسیون روی دریچه‌ی میترال در اندوکاردیت با استرپتوکوک ویریدانس، از فلور دهان",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/34123114d10e848b2b9f6f22117dc02cd5b11465b709ff5fd11a9eb4e8c9551d.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وژتاسیون روی دریچه‌ی میترال در اندوکاردیت با استرپتوکوک ویریدانس، از فلور دهان "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 2.8)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اندوکاردیت عفونی (IE)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عفونت سطح داخلی قلب است، بیشتر روی دریچه‌ها. معمولاً کنار یک نقص مادرزادی یا اکتسابی قلب، یا روی دریچه‌ی مصنوعی شروع می‌شود. بیشترش کار باکتری است، ولی قارچ هم می‌تواند عامل باشد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وژتاسیون چطور ساخته می‌شود"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جریان پرسرعت خون از یک دریچه‌ی تنگ یا نشتی، اندوتلیوم دریچه را زخمی می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فیبرین و پلاکت روی این سطح زبر می‌نشینند و توده‌ای بی‌میکروب می‌سازند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در یک باکتریمی گذرا، باکتری به این توده می‌چسبد و زیر لایه‌ی تازه‌ی فیبرین و پلاکت پنهان می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باکتری در این پناهگاه تکثیر می‌کند و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "وژتاسیون"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بزرگ می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "داخل وژتاسیون، باکتری از دسترس گلبول سفید و آنتی‌بیوتیک دور است؛ برای همین درمان سخت است. تکه‌هایی از وژتاسیون کنده می‌شوند و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آمبولی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌سازند: سکته‌ی مغزی، سکته‌ی قلبی یا آبسه در کلیه و طحال."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "شایع‌ترین عارضه‌ی IE، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نارسایی شدید دریچه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است که به نارسایی قلب می‌رسد. بی‌درمان کشنده است و حتی با درمان، مرگ‌ومیر حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۰ تا ۳۰٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:6829e8193ab6d9b8c551ef4b81c77f1fcf4702e49a656f48bd307d478b42f2f1",
      "sourceId": null,
