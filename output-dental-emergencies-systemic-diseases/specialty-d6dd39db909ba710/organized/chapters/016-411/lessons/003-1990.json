  "steps": [
    {
      "id": "theory:d1418d89453a0b249b76268f1449ab54444bc710857428da28c7452f9df907dc",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "acfda29d86edc6df286f260efd1e6720f0d65facc15a8ed78eeeaaf6318361a2",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کدام کارها پروفیلاکسی می‌خواهند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۶۲ ساله با دریچه‌ی مکانیکی میترال برای کشیدن مولر پایین آمده. حساسیت دارویی ندارد و قرص را راحت می‌خورد. پیش از بی‌حسی می‌پرسد: «قرصم را کی و چقدر بخورم؟»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بیمارِ فهرست پرخطر، هر کاری که یکی از این سه را دارد پروفیلاکسی می‌خواهد، حتی اگر خون‌ریزی دیده نشود:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستکاری "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بافت لثه"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستکاری ناحیه‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پری‌اپیکال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دندان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سوراخ شدن مخاط"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دهان"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کشیدن دندان، جرم‌گیری و روت پلنینگ، جراحی پریودنتال، درمان ریشه و حتی گذاشتن نوار ماتریکس و وج زیر لبه‌ی لثه نمونه‌اند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این‌ها پروفیلاکسی نمی‌خواهند"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تزریق روتین بی‌حسی از بافت "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "غیرعفونی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گرفتن رادیوگرافی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گذاشتن پروتز متحرک یا دستگاه ارتودنسی، و تنظیم دستگاه ارتودنسی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افتادن دندان شیری"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خون‌ریزی از ضربه به لب یا مخاط دهان"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هدف پروفیلاکسی فقط پیشگیری از IE ناشی از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "VGS"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه میکروب‌های دیگر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:7b2bdca9d0151b5bac6a899a5ed40ff3d65d4b7315d7f4a03240f4f38ddc1eb9",
      "sourceId": null,
      "identityOrigin": "local-step",
