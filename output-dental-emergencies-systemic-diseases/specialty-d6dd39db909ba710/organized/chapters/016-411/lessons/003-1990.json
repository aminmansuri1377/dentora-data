      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رژیم‌های AHA 2021"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پروفیلاکسی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک دوز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۰ تا ۶۰ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از کار. اگر ناخواسته فراموش شد، تا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ ساعت پس از"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کار هم می‌شود داد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیمار قرص می‌خورد:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آموکسی‌سیلین ۲ گرم خوراکی (کودک ۵۰ mg/kg)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نمی‌تواند دارو بخورد:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آمپی‌سیلین ۲ گرم عضلانی یا وریدی، یا سفازولین یا سفتریاکسون ۱ گرم عضلانی یا وریدی (کودک ۵۰ mg/kg)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حساس به پنی‌سیلین، خوراکی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سفالکسین ۲ گرم (کودک ۵۰ mg/kg)؛ یا آزیترومایسین یا کلاریترومایسین ۵۰۰ mg (کودک ۱۵ mg/kg)؛ یا داکسی‌سایکلین ۱۰۰ mg."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حساس به پنی‌سیلین و ناتوان از خوردن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سفازولین یا سفتریاکسون ۱ گرم عضلانی یا وریدی (کودک ۵۰ mg/kg)."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو قاعده‌ی مهم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر بیمار با پنی‌سیلین یا آمپی‌سیلین "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنافیلاکسی، آنژیوادم یا کهیر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " داشته، سفالوسپورین نده. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلیندامایسین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به‌خاطر عوارضش از رژیم‌ها حذف شده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دهان‌شویه‌ی کلرهگزیدین یا پوویدون آیوداین پیش از کار، جای پروفیلاکسی را نمی‌گیرد و توصیه نمی‌شود. آنتی‌بیوتیک هم بی‌خطر نیست: آلرژی، عوارض جانبی و مقاومت میکروبی را در نظر داشته باش."
                }
              ]
            }
          ]
        }
      ],
