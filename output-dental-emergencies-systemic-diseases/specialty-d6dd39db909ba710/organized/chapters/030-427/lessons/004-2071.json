  "steps": [
    {
      "id": "theory:a928f4524679694e988a00fa9674fb96ad26bc654348ec0977f74b7fed844fb0",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "4e4b717b2f8f25007bc425954329e634e54bd03f05fa2a7e301e15577ea65e36",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مت‌آمفتامین (شیشه) و کوکائین"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "جوان ۲۴ ساله‌ای برای ترمیم آمده است. بی‌قرار است، مردمک‌هایش گشاد است، نبضش ۱۱۸ و فشارش ۱۵۸/۹۸. پوسیدگی گسترده‌ی گردن دندان‌ها و سایش شدید دارد و می‌گوید دیشب «شیشه» کشیده است. امروز بی‌حسی با اپی‌نفرین می‌زنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مت‌آمفتامین (شیشه) و کوکائین محرک‌اند: تاکی‌کاردی، فشار بالا، آریتمی، سکته‌ی قلبی و سکته‌ی مغزی. اپی‌نفرین این اثرها را تشدید می‌کند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کوکائین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": اوج سطح خون ظرف ۳۰ دقیقه و اثر معمولاً تا ۲ ساعت. دست‌کم ۶ ساعت پس از آخرین مصرف اپی‌نفرین نزن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مت‌آمفتامین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": اثر تا ۸ ساعت، و نیمه‌عمر بعضی ترکیب‌ها تا ۳۶ ساعت. دست‌کم ۸ ساعت درمان نکن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی کاربردی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر کوکائین یا شیشه در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲۴ ساعت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گذشته مصرف شده، درمان انتخابی را عقب بینداز. بی‌حسی حاوی اپی‌نفرین یا لوونوردفرین و نخ رترکشن اپی‌نفرین‌دار نه. در جلسه‌ی درمان فشار و نبض را بسنج."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در دهان"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دهان مت‌آمفتامینی (meth mouth)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": پوسیدگی گسترده از نوشابه‌ی شیرین، خشکی دهان و بی‌توجهی به بهداشت؛ همراه با دندان‌قروچه و فشردن فک."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کوکائین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": مالیدن پودر روی لثه تحلیل لثه و فرسایش سطح فاسیال دندان‌های بالا را می‌دهد؛ مصرف بینی ممکن است کام را سوراخ کند."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:3274fb089c3055a1ea6e262cec03cb195615359fca0a92fc3d20e7573fc68e6f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ccb78c6ac9ecbf118110cb8f92e202a1cd70e30e7be6d50ecde32254757c6244",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اپیوئیدها و الکل"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تریاک، شیره، هروئین و ترامادول همه اپیوئیدند. درمان نگه‌دارنده با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متادون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (آگونیست) یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بوپرنورفین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (آگونیست نسبی) انجام می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مسکن پس از درمان دندان"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "NSAID همراه استامینوفن، مثلاً ایبوپروفن ۴۰۰ میلی‌گرم با استامینوفن ۱۰۰۰ میلی‌گرم، از اپیوئید مؤثرتر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نسخه‌ی اپیوئید دندانپزشک ممکن است نخستین مواجهه‌ی بیمار باشد؛ در نوجوان، نسخه‌ی بیش از ۳ روز خطر اعتیاد را دست‌کم سه برابر می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر اپیوئید لازم شد: کوتاه‌اثر، کمترین دوز، حداکثر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳ روز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و بدون تکرار نسخه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ادعای آلرژی به کدئین یا ناسازگاری با NSAID برای گرفتن داروی قوی‌تر، از نشانه‌های جست‌وجوی دارو است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بیمار متادون یا بوپرنورفین، داروی نگه‌دارنده را قطع نکن و برای مسکن با پزشک برنامه‌ی درمان هماهنگ شو. مصرف مزمن اپیوئید گاهی بی‌حسی موضعی را کم‌اثر و درد را شدیدتر می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اوردوز اپیوئید:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تنفس کند و سطحی، برادی‌کاردی و بی‌پاسخی. پس از حمایت تنفس، نالوکسان (اسپری بینی یا تزریق) آن را برمی‌گرداند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "الکل"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بوی الکل در دهان هنگام مراجعه یک زنگ خطر است؛ درباره‌ی مصرف، خصوصی و بی‌قضاوت بپرس. در بیماری الکلی کبد، خون‌ریزی زیاد و متابولیسم نامطمئن داروها را انتظار داشته باش؛ استامینوفن را حداکثر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ گرم در روز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بده. الکل و دخانیات خطر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "SCC دهان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را بالا می‌برند؛ کنار زبان و کف دهان را دقیق ببین."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
