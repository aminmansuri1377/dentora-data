  "steps": [
    {
      "id": "theory:3ac023678fac638ee289e7d8ad4c5aa31c9df59819171c3e8c1f116b75a628ac",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "c180deb662d2bfb2182b7fac1ab7972ec6af650351337587df9662b87fe3c2e2",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اسکیزوفرنی و برخورد با بیمار"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۳۰ ساله‌ای با برادرش آمده است. چهره‌اش بی‌حالت است، کم حرف می‌زند و ناگهان می‌گوید صدایی به او گفته دندان‌هایش را بکشد. پیش از هر درمانی چه باید بکنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اسکیزوفرنی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در حدود ۱٪ مردم دیده می‌شود و معمولاً در نوجوانی یا جوانی شروع می‌شود. برای تشخیص، دو علامت یا بیشتر باید دست‌کم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ادامه یابد و کارکرد فرد افت کرده باشد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "علائم مثبت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": هذیان (بیشتر از نوع گزند و آزار)، توهم (بیشتر شنوایی)، گفتار آشفته."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "علائم منفی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": عاطفه‌ی سطحی، کم‌حرفی و بی‌انگیزگی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درمان اصلی آنتی‌سایکوتیک‌هاست. نسل اول، مثل هالوپریدول، گیرنده‌ی دوپامین را مسدود می‌کند؛ نسل دوم، مثل ریسپریدون و کلوزاپین، بر سروتونین و دوپامین اثر می‌گذارد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در مطب"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از درمان با پزشک بیمار مشورت کن: وضعیت فعلی، داروها و توان دادن رضایت آگاهانه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان روتین را فقط وقتی شروع کن که بیمار زیر نظر پزشک است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک همراه یا یکی از خانواده کنار بیمار باشد؛ نوبت صبح بهتر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از برخورد تحکم‌آمیز و بحث با بیمار بپرهیز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر همکاری ممکن نشد، آرام‌بخشی را با هماهنگی پزشک بیمار انجام بده."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اگر بیمار توان تصمیم‌گیری منطقی ندارد، رضایت آگاهانه را از قیم قانونی‌اش بگیر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:d15e16102984e846d71c4fd804d0f7f376f84c040cfb069b0df72a14e5ca47d8",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "8ce632772b6aed56f6ae0b835d23ba8a3107270df9923fcb49c1bd5760dfc207",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "عوارض آنتی‌سایکوتیک‌ها"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در دهان"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خشکی دهان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و پوسیدگی؛ بدون پیشگیری فعال، پوسیدگی و بیماری پریودنتال پیش می‌روند. اگر خشکی شدید است، از پزشک بیمار بخواه در صورت امکان دارو را عوض کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دیسکینزی تاردیو"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": حرکات تکراری و غیرارادی عضلات جونده و صورت که دیر پس از شروع دارو ظاهر می‌شود. زخم تروماتیک مخاط می‌دهد و کار دندانپزشکی را دشوار می‌کند. دیستونی، یعنی انقباض غیرارادی و پیچشی عضلات، کمتر دیده می‌شود. با دیدن نخستین نشانه‌ها بیمار را به پزشکش ارجاع بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عوارض خونی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": آگرانولوسیتوز، لکوپنی و ترومبوسیتوپنی؛ گاهی با زخم دهان، عفونت یا خون‌ریزی خود را نشان می‌دهند. کلوزاپین در حدود ۱٪ آگرانولوسیتوز می‌دهد و در ۶ ماه اول شمارش هفتگی گلبول سفید لازم دارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اپی‌نفرین و آرام‌بخش‌ها"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آنتی‌سایکوتیک گیرنده‌ی آلفا را مهار می‌کند و اپی‌نفرین از راه گیرنده‌ی بتا ۲ رگ را گشاد می‌کند؛ حاصل، خطر نظری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افت شدید فشار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. حداکثر دو کارپول ۱:۱۰۰٬۰۰۰ با آسپیره و تزریق آهسته، و بدون نخ رترکشن اپی‌نفرین‌دار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آرام‌بخش، خواب‌آور، آنتی‌هیستامین و اپیوئید را با دوز کمتر بده، چون دپرسیون تنفسی تشدید می‌شود. در سالمند، آلبومین کمتر یعنی داروی آزاد بیشتر و خطر مسمومیت بالاتر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مقایسه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ضدافسردگی سه‌حلقه‌ای با اپی‌نفرین خطر واکنش پرفشاری دارد؛ آنتی‌سایکوتیک با اپی‌نفرین خطر افت فشار."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
