  "steps": [
    {
      "id": "theory:cf6119a843161345062250a9a0cc2eeae75ee7df93e8761e3c60b9bc76f73598",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "0c1e128ba85b6177bf2f9da77223ed0f9477b274bda75968acb0a235a05820e7",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تشخیص ایست قلبی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۶۷ ساله‌ای در اتاق انتظار ناگهان روی صندلی می‌افتد. صدایش می‌زنی و جواب نمی‌دهد. قفسه‌ی سینه‌اش تکان نمی‌خورد و فقط هر چند ثانیه یک نفس بریده‌بریده می‌کشد. آیا این «نفس کشیدن» است؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/med-fig-1-14.webp",
                  "alt": "لمس نبض کاروتید کنار نای؛ در بیمار بی‌پاسخ بیش از ۱۰ ثانیه وقت نگذار",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/aacc5d3feb424ca41ded382ff907cf34abfa16578b48d4394bbb71f265f8c798.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لمس نبض کاروتید کنار نای؛ در بیمار بی‌پاسخ بیش از ۱۰ ثانیه وقت نگذار "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 1.14)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نه. نفس بریده‌بریده و نامنظم (gasping) تنفس طبیعی نیست و در ایست قلبی شایع است. در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایست قلبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قلب خون را پمپ نمی‌کند: نبض و فشار نیست، تنفس قطع می‌شود، سیانوز پیدا می‌شود و مردمک‌ها گشاد می‌شوند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شایع‌ترین علت در بزرگسال ایسکمی قلب است؛ لخته در کرونر می‌تواند "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فیبریلاسیون بطنی (VF)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " راه بیندازد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۴ تا ۶ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بی‌اکسیژنی، آسیب مغزی برگشت‌ناپذیر می‌دهد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه کار نخست"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با تکان دادن شانه و صدا زدن بلند، پاسخ‌دهی را بسنج."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمک بخواه: یک نفر با ۱۱۵ تماس بگیرد و AED را بیاورد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبض کاروتید و تنفس را هم‌زمان و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حداکثر ۱۰ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بررسی کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وقت گذاشتن برای پیدا کردن نبض. اگر در ۱۰ ثانیه نبض را قطعاً حس نکردی، فشردن قفسه‌ی سینه را شروع کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:bf016b2a75de936b6c1cdca3ae214b64099ec3f2a8f1943d66ce7731f36b9141",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "d160eb1f7e1f09e55ffbe57277c350fc2dc1b87f9388bd820497f96fdd774be3",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "CPR با کیفیت بالا"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترتیب احیا در ایست قلبی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "C-A-B"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: اول فشردن قفسه‌ی سینه، بعد راه هوایی و تنفس."
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را به پشت روی سطح سفت بخوابان؛ صندلی دندانپزشکی را کاملاً صاف کن یا بیمار را روی زمین بیاور."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پاشنه‌ی یک دست را روی نیمه‌ی پایینی جناغ بگذار و دست دیگر را رویش قفل کن؛ آرنج‌ها صاف."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمق "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵ تا ۶ سانتی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، سرعت "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۰۰ تا ۱۲۰ بار در دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بعد از هر فشار بگذار قفسه‌ی سینه کامل بالا بیاید تا قلب دوباره از خون پر شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در بزرگسال پس از هر ۳۰ فشار، ۲ تنفس بده: سر به عقب و چانه بالا، با ماسک جیبی یا آمبوبگ؛ هر تنفس حدود یک ثانیه، تا قفسه‌ی سینه بالا بیاید."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقفه‌ها را زیر ۱۰ ثانیه نگه دار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشارنده را هر ۲ دقیقه عوض کنید، بهتر است هنگام تحلیل ریتم AED؛ خستگی عمق فشار را کم می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در کودک، اگر دو امدادگر هستید نسبت ۱۵:۲ است؛ یک امدادگر ۳۰:۲."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "از کسی که آموزش احیا ندیده، فشردن قفسه‌ی سینه بدون تنفس بهتر از هیچ کاری است؛ ولی تیم مطب دندانپزشکی باید CPR کامل با تنفس را بلد باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
