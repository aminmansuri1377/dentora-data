  "steps": [
    {
      "id": "theory:69121c4ddcac7d9f8d0ac961ea090312185b3421a9d2bf95cdcebefecdf22020",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "1f8011337e7b5e7e9af8565aa93cc106090b56a0c3268fca53f0a8beb8482060",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آنژین صدری در مطب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۵۸ ساله‌ای با سابقه‌ی آنژین برای کشیدن مولر پایین آمده است. وسط کار دستش را روی جناغ می‌گذارد و می‌گوید «سینه‌ام سنگین شده و تا فک پایینم می‌کشد». هوشیار است و رنگش طبیعی. این درد چیست و چقدر باید نگرانش باشی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این تصویر آشنای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنژین صدری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: درد ایسکمیک قلب که وقتی نیاز عضله‌ی قلب به اکسیژن از خون‌رسانی کرونرها بیشتر شود، سر می‌رسد. علتش معمولاً تنگی آترواسکلروتیک کرونرها و گاهی اسپاسم کرونر است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ویژگی‌های درد"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار، سنگینی، فشردگی یا سفتی پشت جناغ؛ معمولاً تیز و خنجری نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انتشار به شانه، بازوی چپ یا راست، گردن و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فک پایین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کوتاه است: ۵ تا ۱۵ دقیقه، و با استراحت یا نیتروگلیسرین زودتر آرام می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محرک‌ها: فعالیت بدنی، غذای سنگین، استرس و اضطراب؛ یعنی همان چیزی که روی یونیت فراوان است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد فعالیتی در فک یا دندان‌ها با معاینه‌ی دندانی طبیعی را جدی بگیر و بیمار را به پزشک بفرست."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در حمله‌ی آنژین ساده علائم حیاتی معمولاً طبیعی‌اند. افت فشار، عرق سرد و تهوع جزو تصویر آنژین نیستند و باید تو را به سکته‌ی قلبی مشکوک کنند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:f422a3557a8d7ea8b97f65e1c8d5de7ff33663d8f33774773a547cce13a30938",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "a5f5499a52a83e55ebe87e847d4c4aa576bd8da5a75ceaa27185fdfc013652da",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "انواع آنژین و اقدام در حمله"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنژین پایدار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " الگوی ثابت دارد: با محرک همیشگی می‌آید و با استراحت یا نیتروگلیسرین می‌رود. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنژین ناپایدار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی درد تازه‌شروع، دردی که دفعات یا شدتش بیشتر شده، با فعالیت کمتر می‌آید یا در حال استراحت رخ می‌دهد، و به نیتروگلیسرین هم به‌آسانی جواب نمی‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "خطر سکته‌ی قلبی در آنژین ناپایدار بالاست؛ درمان انتخابی را عقب بینداز و بیمار را به پزشک بفرست."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اقدام در حمله‌ی آنژین روی یونیت"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان را همان لحظه قطع کن و بیمار را نشسته یا نیمه‌نشسته، هرطور راحت‌تر است، قرار بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار را بسنج. اگر فشار سیستولیک دست‌کم ۹۰ mmHg است، نیتروگلیسرین "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۴ میلی‌گرم زیرزبانی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بده (قرص، یا یک تا دو پاف اسپری)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پالس‌اکسیمتر وصل کن و نبض و فشار را ثبت کن. اکسیژن فقط اگر SpO2 "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زیر ۹۰٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است یا بیمار دیسترس تنفسی دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر درد ماند، نیتروگلیسرین را هر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تکرار کن؛ حداکثر ۳ دوز در ۱۵ دقیقه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کی ۱۱۵؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر درد ۵ دقیقه پس از دوز اول بهتر نشد یا بدتر شد، همان موقع با ۱۱۵ تماس بگیر و منتظر دوز سوم نمان. اگر پس از ۳ دوز هنوز درد هست، سکته‌ی قلبی را فرض کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
