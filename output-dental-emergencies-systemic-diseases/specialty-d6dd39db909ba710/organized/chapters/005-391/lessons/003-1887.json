    {
      "id": "theory:b49fdedf6d810bfe664c13296e42558bfc00d9b739a73f478282dee44f92ae44",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "4af20dbc59488f9ff517dbc9d64a0abd5e4c90f25c43d07d03c59e4bbe88870b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "انسداد کامل و مانور هایملیخ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۶۰ ساله‌ای هنگام تحویل پروتز پارسیل موقت، ناگهان هر دو دستش را دور گلویش می‌گیرد. دهانش باز است ولی صدایی درنمی‌آید، سرفه نمی‌کند و لب‌هایش کم‌کم کبود می‌شود. چه می‌کنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انسداد کامل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: جسم راه را طوری بسته که ریه پر نمی‌شود، پس سرفه هم ممکن نیست. نشانه‌ها:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناتوانی در حرف زدن، سرفه و نفس کشیدن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علامت جهانی خفگی: گرفتن گلو با دو دست"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تقلای شدید تنفسی، اضطراب شدید، سپس کبودی و از دست رفتن هوشیاری"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بپرس: «داری خفه می‌شوی؟» اگر با سر تأیید کرد و نمی‌تواند حرف بزند، بی‌درنگ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مانور هایملیخ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (فشار شکمی) را شروع کن:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پشت بیمارِ ایستاده یا نشسته بایست و دست‌ها را دور کمرش حلقه کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک دست را مشت کن و آن را کمی بالای ناف و پایین‌تر از زائده‌ی خنجری بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست دیگر را روی مشت بگذار و با فشارهای سریع رو به داخل و بالا بکش."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تکرار کن تا جسم بیرون بیاید یا بیمار هوشیاری‌اش را از دست بدهد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "فشار ناگهانی، هوای باقی‌مانده در ریه را بیرون می‌راند و جسم را جابه‌جا می‌کند. در زن باردار با شکم بزرگ یا فرد بسیار چاق، فشار را روی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیمه‌ی پایین جناغ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:92de431a2a38307f90221254492c303a89510ac785ee240f8f31ec9c32a2728a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "7a68deef2756cefa46db599d65d97c224256800efa57a2819d2de56580a44c0f",
      "position": 2,
