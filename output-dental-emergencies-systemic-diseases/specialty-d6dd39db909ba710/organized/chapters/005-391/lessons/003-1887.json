      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "وقتی بیمار از هوش می‌رود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر بیمار با انسداد کامل هوشیاری‌اش را از دست داد:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "او را آرام به پشت روی سطح سخت بخوابان: کف زمین یا یونیت کاملاً خوابیده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کسی با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۱۵"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تماس بگیرد و AED بیاورد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "CPR را با ترتیب "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "C-A-B"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و نسبت "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳۰:۲"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شروع کن. فشردن قفسه‌ی سینه خودش فشاری می‌سازد که به جابه‌جا شدن جسم کمک می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر بار که برای تنفس راه هوایی را باز می‌کنی، داخل دهان را نگاه کن و اگر جسم را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دیدی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، بیرونش بیاور."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ادامه بده تا اورژانس برسد یا بیمار خودش نفس بکشد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جارو کردن کور حلق با انگشت. ممکن است جسم را پایین‌تر هل بدهد. برای جست‌وجوی جسم هم فشردن قفسه‌ی سینه را بیش از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۰ ثانیه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قطع نکن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی تنفس برگشت، اکسیژن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵ تا ۶ لیتر در دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بده، بیمار را خوابیده نگه دار، علائم حیاتی را پایش و ثبت کن و او را به بیمارستان منتقل کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دندانپزشکی که آموزش دیده، ممکن است با لارنگوسکوپ و فورسپس Magill جسم را بردارد یا در آخرین مرحله کریکوتیروتومی کند؛ اما این تلاش‌ها نباید کمبود اکسیژن را طولانی کنند."
                }
              ]
            }
          ]
        }
      ],
