  "steps": [
    {
      "id": "theory:1544ab18ad7681418aaa9754cff0655b09054605cbd42e72aec61e30f2a0d581",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "e02f7243c6a94ebc2d3c439b3aa20042ba3e8984f92297201691c1a0045b2e0c",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پارتیشن گاز، رابردم و ساکشن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "قرار است برای خانم ۲۸ ساله‌ای با آرام‌بخشی خوراکی، مولر سوم پایین را بکشی. بیمار خواب‌آلود است و روی یونیت نیمه‌خوابیده. اگر دندان از فورسپس لیز بخورد، چه چیزی جلوی رفتنش به حلق را می‌گیرد؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بهترین درمان آسپیراسیون پیشگیری از آن است. بیمار خوابیده یا آرام‌بخشی‌شده در خطر بیشتری است، چون هم جاذبه و هم کند شدن رفلکس گگ به نفع رفتن جسم به حلق است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پارتیشن گاز"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک گاز "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۴ در ۴ اینچ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را نیمه‌باز و شل در عقب دهان بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر دندان از فورسپس لیز خورد یا زیر فشار خرد شد، در گاز می‌افتد نه در حلق."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گاز را آن‌قدر عقب نبر که رفلکس گگ را تحریک کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از گذاشتن، هدفش را به بیمار بگو تا همکاری کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ابزارهای دیگر"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رابردم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در درمان ریشه و ترمیم، راه افتادن فایل و قطعات کوچک به حلق را می‌بندد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلمپ رابردم و ابزارهای کوچک مثل درایور ایمپلنت را با نخ دندان ببند تا اگر رها شدند، بیرون کشیدنشان آسان باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساکشن پرحجم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دم دست باشد تا خرده‌ها و مایعات را فوراً برداری."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:6e42639fad4ec359dcfc3c5822cb7937232e7450e42991c97dfc27607b8c8a0d",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "a5cfcbeb4c1fe1ed29f496dabb6270dcc808f7fa3c4001237226b0dbcdc03714",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آسپیراسیون محتویات معده"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آسپیراسیون همیشه جسم جامد نیست. اگر بیمار استفراغ کند و محتویات معده به ریه برود، ذرات غذا راه‌های هوایی را می‌بندند؛ اما آسیب اصلی از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اسیدیته‌ی بالای"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شیره‌ی معده است که بافت ریه را به‌سرعت تخریب می‌کند و سندرم دیسترس تنفسی در پی دارد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار با رفلکس گگ سالم، هنگام استفراغ به‌ندرت آسپیره می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیشترین خطر در بیمار آرام‌بخشی‌شده، بی‌هوش یا با بی‌حسی سطحی در اوروفارنکس است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پیشگیری:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش از آرام‌بخشی متوسط یا عمیق، بیمار ناشتا باشد: غذای سبک را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۶ ساعت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و غذای سنگین یا چرب را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۸ ساعت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش قطع کند؛ مایعات شفاف مثل آب تا "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲ ساعت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش مجاز است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نشانه‌های نزدیک بودن استفراغ: تهوع، احساس گرما، قورت دادن مکرر، اضطراب، تعریق و عق زدن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر بیمار آرام‌بخشی‌شده استفراغ کرد"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کار را متوقف کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را به پهلو بچرخان، با سر کمی پایین‌تر، تا استفراغ از دهان بیرون بریزد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با ساکشن پرحجم دهان و حلق را تمیز کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر نشانه‌ای از آسپیراسیون نبود، علائم حیاتی را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳۰ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پایش کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "تنفس تند، خس‌خس، تاکی‌کاردی، افت فشار یا کبودی یعنی احتمال آسپیراسیون: با ۱۱۵ تماس بگیر، اکسیژن بده، علائم حیاتی را پایش کن و بیمار را فوراً منتقل کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
