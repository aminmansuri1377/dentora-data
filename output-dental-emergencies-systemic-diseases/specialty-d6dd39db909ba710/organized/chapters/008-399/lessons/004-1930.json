  "steps": [
    {
      "id": "theory:c86df482174e186737a71081d1a83350f5958aceac0a7f4bd42f4f22c42a3ae7",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "a4d9bf925dd0dd190523f183bb95fbda6626dcfaa402fe53ef8e049de9b97864",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "واکنش به اپی‌نفرین"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۵۲ ساله‌ای برای قالب‌گیری روکش نخ رترکشن آغشته به اپی‌نفرین گرفته است. چند دقیقه بعد می‌گوید قلبش تند می‌زند و سرش می‌کوبد؛ دست‌هایش می‌لرزد و فشارش ۱۹۰ روی ۱۰۰ است. چه باید بکنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "واکنش به اپی‌نفرین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (overdose اپی‌نفرین) است، نه آلرژی. معمولاً کوتاه است و درمان خاصی نمی‌خواهد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نشانه‌ها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بالا رفتن تند فشار (بیشتر سیستولیک)، تاکی‌کاردی و گاهی آریتمی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "احساس بیمار:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ترس و اضطراب، لرزش، سردرد ضربان‌دار، تعریق، تپش قلب و گاهی تنگی نفس"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زمینه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تزریق داخل رگ بی‌حسی دارای اپی‌نفرین، یا نخ رترکشن آغشته که از لثه‌ی خراشیده به‌سرعت جذب می‌شود. این نخ توصیه نمی‌شود و در بیمار قلبی‌عروقی منع مصرف دارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اقدام"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان را قطع کن و نخ رترکشن را بیرون بیاور."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار هوشیار را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نیمه‌نشسته یا نشسته"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بگذار؛ خواباندن، فشار را بیشتر بالا می‌برد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آرامش کن: علائم گذراست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار و نبض را هر ۵ دقیقه بسنج؛ در صورت نیاز اکسیژن بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر واکنش شدید بود با ۱۱۵ تماس بگیر؛ اگر درباره‌ی حال بیمار شک داری، تنها مرخصش نکن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "هر کارپول با اپی‌نفرین ۱:۱۰۰۰۰۰، ۰٫۰۱۸ میلی‌گرم اپی‌نفرین دارد. در بیمار قلبی سقف "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰٫۰۳۶ میلی‌گرم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، یعنی ۲ کارپول. با بتابلاکر غیرانتخابی مثل پروپرانولول، اپی‌نفرین می‌تواند فشار را بالا ببرد و نبض را کند کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:625c01586d72e62abc9e5bda6776cdbbf30ae86feb808e6af4dc3012db0a8989",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "178e0fcf693afa07f578054fac6437c41c87285379422f3c27458adc219077c7",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "متهموگلوبینمی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "سه ساعت پس از یک جراحی طولانی با چند کارپول پریلوکائین، همراه بیمار تلفن می‌زند: لب‌ها و ناخن‌هایش کبود شده، پوستش خاکستری است، بی‌حال است و نفسش تنگ است. به چه فکر می‌کنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متهموگلوبینمی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آهن هموگلوبین از حالت فرو (Fe2+) به فریک (Fe3+) اکسید می‌شود. این هموگلوبین اکسیژن را محکم نگه می‌دارد و به بافت نمی‌دهد؛ نتیجه، کبودی شبیه سیانوز بدون بیماری قلبی یا ریوی است. در حالت عادی کمتر از ۱٪ هموگلوبین به این شکل است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پریلوکائین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در دوز زیاد: متابولیتش (ارتو-تولوئیدین) آهن را اکسید می‌کند. وابسته به دوز است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بنزوکائین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سطحی، فقط در مقدار خیلی زیاد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اوج ۳ تا ۴ ساعت پس از تزریق و ماندگاری ۱۲ تا ۱۴ ساعت؛ بیشتر بیماران وقتی علامت‌دار می‌شوند که مطب را ترک کرده‌اند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تشخیص و درمان"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کبودی که با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اکسیژن ۱۰۰٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بهتر نمی‌شود، و خون قهوه‌ای شکلاتی که در برابر اکسیژن قرمز نمی‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را به اورژانس بفرست. درمان قطعی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "متیلن بلو ۱٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آهسته وریدی است، ۱٫۵ میلی‌گرم به ازای هر کیلوگرم، و اگر کبودی ماند یا برگشت هر ۴ ساعت تکرار می‌شود. متیلن بلوی بیش از حد خودش متهموگلوبینمی می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ویتامین C (اسید اسکوربیک) جایگزین کندتری است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "متهموگلوبینمی مادرزادی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "منع نسبی پریلوکائین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ بی‌حسی دیگری انتخاب کن. در بیمار سالم، ماندن زیر ۸ mg/kg پریلوکائین جلوی آن را می‌گیرد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
