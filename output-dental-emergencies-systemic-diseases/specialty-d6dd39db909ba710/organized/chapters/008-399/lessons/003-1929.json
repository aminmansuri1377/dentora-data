  "steps": [
    {
      "id": "theory:878ecda124d170ffdd55f1e9575776175a8b6ff11f1eca40cd56c557866305c4",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "e7ba777f63c848d9861f2f48b7b26c2678750b0c733b8e8c2c162c3fd2f01304",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "حداکثر دوز مجاز بی‌حسی موضعی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "دختر ۶ ساله‌ای ۲۰ کیلوگرم وزن دارد و قرار است برایش لیدوکائین ۲٪ با اپی‌نفرین ۱:۱۰۰۰۰۰ بزنی. پیش از اولین تزریق باید بدانی حداکثر چند کارپول مجاز است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حداکثر دوز بر پایه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وزن بیمار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (میلی‌گرم به ازای هر کیلوگرم) حساب می‌شود و بعضی داروها یک سقف مطلق هم دارند. هر کارپول ۱٫۸ میلی‌لیتر است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لیدوکائین ۲٪:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ۳۶ میلی‌گرم در هر کارپول؛ ۷ mg/kg؛ سقف ۵۰۰ میلی‌گرم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آرتیکائین ۴٪:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ۷۲ میلی‌گرم در هر کارپول؛ ۷ mg/kg"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مپیواکائین ۳٪:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ۵۴ میلی‌گرم در هر کارپول؛ ۶٫۶ mg/kg؛ سقف ۴۰۰ میلی‌گرم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پریلوکائین ۴٪:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ۷۲ میلی‌گرم در هر کارپول؛ ۸ mg/kg؛ سقف ۶۰۰ میلی‌گرم"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محاسبه در سه گام"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وزن × دوز به ازای هر کیلوگرم = حداکثر میلی‌گرم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر سقف مطلق کمتر است، سقف را بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حداکثر میلی‌گرم ÷ میلی‌گرمِ هر کارپول = تعداد کارپول"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای این کودک: ۲۰ × ۷ = ۱۴۰ میلی‌گرم، و ۱۴۰ ÷ ۳۶ یعنی حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳٫۹ کارپول"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". همین کودک با مپیواکائین ۳٪: ۲۰ × ۶٫۶ = ۱۳۲ میلی‌گرم، یعنی حدود ۲٫۴ کارپول."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "درصد محلول را به میلی‌گرم تبدیل کن: هر ۱٪ یعنی ۱۰ میلی‌گرم در هر میلی‌لیتر. پس کارپول محلول ۴٪، ۷۲ میلی‌گرم دارو دارد؛ دو برابر کارپول ۲٪."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:80c91cb3eb0948489ba34a88fe9c09737053f809f53f9f9f2d697665eb240365",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "70d787f77672f89d055702caacd8af27a9644f513252aca0d104f6b7b10829ac",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کاهش دوز و بی‌حسی در کودک"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کی کمتر از حداکثر بزنی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودک زیر ۶ سال و سالمند بالای ۶۵ سال"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار ASA III و IV"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیماری کبد، کلیه یا نارسایی قلب"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حداکثر دوز عدد مطلق نیست: گذشتن از آن الزاماً مسمومیت نمی‌دهد و ماندن زیر آن هم ایمنی را تضمین نمی‌کند. قاعده، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمترین دوز و کمترین غلظت مؤثر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کودک: بیشترین مسمومیت‌های جدی"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیشتر مسمومیت‌های جدی در کودک ۲ تا ۶ ساله، کم‌وزن (زیر ۳۰ کیلوگرم) و همکار رخ داده که در یک جلسه برای هر چهار کوادرانت بی‌حسی گرفته است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودک را روی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ترازو"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " وزن کن؛ والدین معمولاً وزن را کمتر می‌گویند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در هر جلسه یک یا دو کوادرانت؛ کوادرانت به کوادرانت بی‌حس و درمان کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی ساده (مپیواکائین ۳٪ یا پریلوکائین ۴٪) فقط برای درمان کوتاه یک کوادرانت؛ برای دو کوادرانت یا بیشتر، محلول با تنگ‌کننده‌ی عروق."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در کودک زیر ۳۰ کیلوگرم به‌ندرت به کارپول کامل در یک تزریق نیاز است؛ حدود ۲ کارپول برای بی‌حسی همه‌ی دندان‌های شیری کافی است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بی‌حسی سطحی هم جذب می‌شود؛ لیدوکائین سطحی به‌خوبی و بنزوکائین کم. آن را حداکثر روی یک کوادرانت بزن و اسپری را فقط با دوز مشخص (metered) به کار ببر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
