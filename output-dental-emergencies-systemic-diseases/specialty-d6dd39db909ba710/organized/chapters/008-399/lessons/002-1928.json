  "steps": [
    {
      "id": "theory:067451be0662c2e3a24175e253de049cbc3dff9ea7f5d3e5a73a272ae51b2306",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "162bda8bca8adac097643d4bf1a0f1f6399a8151cee63147cc233c357f998334",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "علائم مسمومیت با بی‌حسی موضعی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن بلاک آلوئولار تحتانی هنوز در دهان خانم ۴۵ ساله‌ای است که ناگهان نگاهش خیره می‌شود، هوشیاری‌اش را از دست می‌دهد و دست و پایش به پرش می‌افتد. چه چیزی در چند ثانیه چنین واکنشی ساخته است؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علائمی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حین تزریق یا چند ثانیه پس از آن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌آیند، بیشتر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تزریق داخل رگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ شدیدترین شکل مسمومیت، ولی کوتاه (معمولاً ۱ تا ۲ دقیقه). دوز زیاد یا جذب سریع معمولاً ۵ تا ۱۰ دقیقه پس از تزریق خود را نشان می‌دهد و آرام‌آرام شدیدتر می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مرحله‌ی تحریک"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرحرفی، اضطراب، بی‌قراری و هیجان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بریده‌بریده حرف زدن، پرش عضلات صورت و لرزش اندام‌ها"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سبکی سر، طعم فلزی، وزوز گوش و تاری دید"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بالا رفتن فشار خون، نبض و تعداد تنفس"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مرحله‌ی سرکوب"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تشنج تونیک‌ـ‌کلونیک"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از تشنج: خواب‌آلودگی یا بی‌هوشی، افت فشار، کندی نبض و تنفس، و در موارد شدید ایست تنفس و قلب"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "شدت سرکوب معمولاً هم‌اندازه‌ی شدت تحریکِ پیش از آن است. مغز بسیار حساس‌تر از قلب است؛ علائم قلبی معمولاً خیلی دیرتر از علائم مغزی ظاهر می‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مرحله‌ی تحریک ممکن است خیلی کوتاه باشد یا اصلاً دیده نشود. به‌ویژه با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لیدوکائین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، اولین نشانه گاهی فقط خواب‌آلودگی است که به بی‌هوشی می‌رسد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:458e4e7f7a40e60fe56eee1849ad41c1671a7eab92763a46ca053b5eb84672e5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "7d3755e353bc4c5462d93b161b5e30cd102f9561ee31a5fe3514cee4317268f4",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "درمان مسمومیت با بی‌حسی موضعی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مسمومیت خفیف (بیمار هوشیار)"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان را قطع کن و تزریق دیگری نکن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را در وضعیت راحت بگذار و آرامش کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گردش خون، راه هوایی و تنفس را بسنج (C-A-B)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکسیژن بده و بخواه "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عمیق و کمی تندتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نفس بکشد؛ پایین آمدن CO2 خون آستانه‌ی تشنج را بالا می‌برد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم حیاتی را هر ۵ دقیقه ثبت کن و بیمار را تا بهبود کامل در مطب نگه دار؛ اگر به حالش شک داری، فقط با همراه مرخصش کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در واکنش خفیف معمولاً داروی ضدتشنج لازم نیست و حتی سرکوبِ پس از آن را عمیق‌تر می‌کند. دارو با پخش شدن در بدن، ظرف چند دقیقه از آستانه پایین می‌آید."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تشنج یا بی‌هوشی"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ را از دهان بیرون بیاور، بیمار را supine با پاهای کمی بالا بخوابان و با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۱۵"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تماس بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از آسیب محافظت کن؛ چیزی لای دندان‌ها نگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راه هوایی را باز نگه دار و اکسیژن یا تهویه‌ی کمکی بده؛ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مهم‌ترین درمان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " همین است و بیشتر این تشنج‌ها با آن و با پخش شدن دارو خودبه‌خود تمام می‌شوند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر تشنج ادامه یافت، بنزودیازپین (میدازولام یا دیازپام) طبق پروتکل تشنج بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از تشنج، C-A-B و BLS؛ اگر نبض نبود، CPR."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیماری که داروی ضدتشنج گرفته، پیش از ترخیص باید پزشک ارزیابی‌اش کند و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌همراه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نرود. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " زدن برچسب «آلرژی به بی‌حسی» پس از مسمومیت، که درمان‌های بعدی را بی‌جهت دشوار می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
