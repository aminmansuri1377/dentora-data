  "steps": [
    {
      "id": "theory:c713b829b297d75ffd099e2565a9e2823439b5b4ec8270804eed8d8b2d19eb45",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "b6fc02b7cb1f3b1c4f9255dfb4f1a6dcf32f372c331537d2f5db66196e9e5380",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اقدام در پیش‌درآمد سنکوپ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۳۵ ساله‌ای وسط کشیدن مولر پایین می‌گوید سرش گیج می‌رود. رنگ‌پریده است و عرق کرده، اما هنوز هوشیار است و جواب می‌دهد. اولین کارت چیست؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار هنوز غش نکرده است. اگر همین حالا درست عمل کنی، معمولاً اصلاً کارش به غش نمی‌کشد."
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان دندانپزشکی را همان لحظه متوقف کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را خوابیده به پشت (supine) قرار بده و پاها را بالاتر از سطح سر بیاور."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با آرامش با او حرف بزن و آرامش کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حوله‌ی خنک و مرطوب روی پیشانی‌اش بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم حیاتی را بسنج و ثبت کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هدف همه‌ی این کارها یکی است: برگرداندن خون به مغز. خواباندن بیمار مؤثرترین کار است، چون جاذبه را از سر راه جریان خون مغز برمی‌دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشاندن بیمار یا بلند کردنش تا «کنار پنجره هوا بخورد». هر وضعیتی که سر را بالاتر از قلب نگه دارد، خون‌رسانی مغز را بدتر می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5284ded698b8465225a2ec0ab32d1b2e32ff50e10d3f5955296b86751b77ee2f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "a7df434055285a22bb829970c7897cf84f84fc37a4a155bda2cb50094497b314",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اقدام در سنکوپ و پس از آن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر بیمار هوشیاری‌اش را از دست داد، ترتیب کار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "P-A-B-C"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "P (وضعیت):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " درمان را قطع کن، بیمار را supine بخوابان، سر را کمی پایین و پاها را بالا بیاور. زن باردار را به پهلوی چپ بچرخان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "A (راه هوایی):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " راه هوایی را باز نگه دار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "B (تنفس):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تنفس را بررسی کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "C (گردش خون):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نبض کاروتید را لمس کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تنفس هست:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اکسیژن ۵ تا ۶ لیتر در دقیقه و حوله‌ی خنک روی پیشانی بده و علائم حیاتی را پایش کن. شکستن آمپول آمونیاک معطر زیر بینی اختیاری است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تنفس نیست:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " احیای پایه (BLS) را شروع کن و کسی با ۱۱۵ تماس بگیرد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "با وضعیت درست، هوشیاری معمولاً به‌سرعت برمی‌گردد. اگر بیش از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طول کشید، به علت دیگری فکر کن: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیپوگلیسمی، سکته‌ی مغزی یا آریتمی قلبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ و کمک پزشکی (۱۱۵) بخواه."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس از به هوش آمدن، رنگ‌پریدگی، تهوع و ضعف تا چند دقیقه می‌ماند. بیمار در مطب استراحت کند و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با همراه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به خانه برود. برای جلسه‌های بعدش از پیش برنامه‌ی کنترل اضطراب بچین."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
