      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پروتکل کاهش اضطراب و وضعیت بیمار"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از جلسه"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوبت "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "صبح"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و کوتاه بودن زمان انتظار در اتاق انتظار"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در صورت نیاز، داروی خواب‌آور شب قبل یا آرام‌بخش صبح روز درمان"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حین جلسه"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اطمینان‌دادن کلامی مکرر و گفت‌وگو برای پرت کردن حواس"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌غافلگیری: پیش از هر کار اضطراب‌آور به بیمار بگو"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ابزار جراحی دور از دید بیمار؛ بدون سروصدای اضافه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ژل بی‌حسی سطحی دست‌کم یک دقیقه پیش از تزریق؛ بی‌حسی موضعی کافی و در صورت نیاز اکسید نیتروژن"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس از جلسه"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستورهای کوتاه و روشن، مسکن مؤثر، و شماره‌ای که بیمار در صورت مشکل با آن تماس بگیرد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وضعیت بیمار هنگام تزریق"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تزریق به بیمارِ نشسته‌ی عمودی بیشترین احتمال سنکوپ را دارد. هنگام تزریق، بیمار را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "supine"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بخوابان: سر و قلب موازی زمین و پاها کمی بالا. همه‌ی بلاک‌های دندانی در این وضعیت شدنی‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "در پایان جلسه، به‌ویژه برای بیمار مستعد افت فشار وضعیتی، صندلی را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرحله‌به‌مرحله"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بالا بیاور و بگذار بیمار پیش از ایستادن چند لحظه لبه‌ی صندلی بنشیند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
