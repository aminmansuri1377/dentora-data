      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "داروهای زمینه‌ساز و اقدام"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چه کسانی مستعدند"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داروهایی که حجم داخل عروق را کم می‌کنند: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دیورتیک‌ها"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داروهایی که عروق محیطی را گشاد می‌کنند: بیشتر داروهای ضد فشار خون غیردیورتیک، مخدرها و بسیاری از داروهای روان‌پزشکی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داروهایی که جلوی بالا رفتن جبرانی ضربان قلب را می‌گیرند: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بتابلاکرها"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مثل پروپرانولول"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داروهای ضدآریتمی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اقدام"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان را متوقف کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را supine بخوابان و پاها را بالاتر از سطح سر بیاور."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم حیاتی را بسنج."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی فشار بهتر شد، بیمار را آرام به حالت نشسته برگردان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی علائم حیاتی طبیعی و پایدار شد، مرخصش کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از هر درمان دندانپزشکی بعدی، مشاوره‌ی پزشکی بگیر."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مخدر هم عروق را گشاد می‌کند و هم تنفس را کند. اگر بیمار با مخدر طولانی‌اثر آرام‌بخشی شده، ممکن است آنتاگونیستی مثل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نالوکسان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لازم شود. بیماری که به خاطر دارو افت فشار وضعیتی شدید دارد، برای تنظیم دارو به پزشکش ارجاع شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
