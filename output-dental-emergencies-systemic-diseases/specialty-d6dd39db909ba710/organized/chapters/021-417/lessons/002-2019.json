  "steps": [
    {
      "id": "theory:af63869d63e484fb5c3b5e1e739c5d676adfe1b1c29f461a90c6554a24486b3c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "cf461f37a36ecf36ff1fa60c6805d526b601c3fa025b95e6267b91ae6675396a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "HbA1c و هدف کنترل قند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۵۶ ساله‌ای با دیابت نوع ۲ می‌گوید: «قند امروز صبحم ۱۱۰ بود؛ دیابتم کاملاً کنترل است.» در آزمایش ماه پیش HbA1c او ۹٪ بوده. حرفش را قبول می‌کنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گلوکز خون آرام‌آرام به هموگلوبین گلبول قرمز می‌چسبد و HbA1c می‌سازد. گلبول قرمز حدود سه ماه عمر می‌کند؛ پس HbA1c تصویر قند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حدود ۳ ماه گذشته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه قند امروز."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "طبیعی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " زیر ۵٫۷٪"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هدف رایج در بیمار دیابتی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " زیر ۷٪"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هدف فردی است: برای جوان مبتلا به نوع ۱ ممکن است ۶٫۵٪، و برای سالمند یا بیمار با بیماری‌های همراه ۸ تا ۸٫۵٪ باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قند پیش از غذا ۸۰ تا ۱۳۰ mg/dL و اوج قند پس از غذا زیر ۱۸۰ mg/dL"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار پایدار دست‌کم سالی دو بار HbA1c می‌دهد؛ اگر درمانش عوض شده یا به هدف نرسیده، هر سه ماه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا کنترل مهم است"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عروق بزرگ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " خطر MI و سکته‌ی مغزی ۲ تا ۴ برابر؛ MI شایع‌ترین علت مرگ در دیابت نوع ۲ است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عروق کوچک:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نفروپاتی، رتینوپاتی و نوروپاتی. نارسایی کلیه شایع‌ترین علت مرگ در دیابت نوع ۱ است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "HbA1c بالا اصلی‌ترین پیش‌بینی‌کننده‌ی عوارض دیابت است. کنترل سخت‌گیرانه عوارض را کم می‌کند، ولی هرچه هدف پایین‌تر باشد، خطر هیپوگلیسمی بیشتر است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:67e8eb4011f38d0c79cb06a3cfef93d3e969b8131efeb6652db609a32e9bc87f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "b15f6986bc1cdb8a4a12ea66eb064a47d9c7fd0316059d19d53becc8ced09ff1",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "داروهای دیابت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "انسولین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در نوع ۱ برای زنده ماندن لازم است. سریع‌الاثرها (لیسپرو، آسپارت) پیش از غذا زده می‌شوند و طولانی‌اثرها (گلارژین، دگلودک) بی‌اوج‌اند و نیاز پایه را می‌پوشانند. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پمپ انسولین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " زیر پوست شکم مدام انسولین سریع‌الاثر می‌دهد؛ قطع شدنش می‌تواند به DKA برسد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "متفورمین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " خط اول درمان نوع ۲؛ تولید گلوکز کبد را کم می‌کند. اسهال، دل‌درد و طعم فلزی شایع‌اند؛ کمبود B12 و اسیدوز لاکتیک هم رخ می‌دهد. در eGFR زیر ۳۰ منع مصرف دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سولفونیل‌اوره"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (گلی‌بنکلامید، گلی‌مپیراید): ترشح انسولین را زیاد می‌کند و به‌ویژه در سالمند هیپوگلیسمی می‌دهد. در آلرژی به سولفا منع مصرف دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مهارکننده‌های SGLT2"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (امپاگلیفلوزین، داپاگلیفلوزین): قند را از ادرار دفع می‌کنند؛ عفونت قارچی تناسلی، افت فشار و خطر DKA دارند، ولی برای قلب و کلیه سودمندند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آگونیست‌های GLP-1"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (لیراگلوتاید، سماگلوتاید): تزریقی‌اند و به‌تنهایی هیپوگلیسمی نمی‌دهند. تهوع شایع است و با کند کردن تخلیه‌ی معده ممکن است سطح خونی آنتی‌بیوتیک خوراکی را پایین بیاورند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " همه‌ی داروهای دیابت را هم‌خطر دانستن. در مطب، بیشترین خطر افت قند مال بیمارانی است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انسولین یا سولفونیل‌اوره"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مصرف می‌کنند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
