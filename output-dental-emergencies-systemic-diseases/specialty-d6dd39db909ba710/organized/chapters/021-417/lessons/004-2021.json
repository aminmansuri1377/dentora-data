                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاندیدیازیس دهانی در بیمار دیابتی؛ پلاک‌های سفید که با گاز پاک می‌شوند "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 14.12)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درمان پشت‌سرهم کاندیدیازیس عودکننده بدون پرسیدن از قند. عود مکرر عفونت قارچی خودش سرنخ کنترل بد دیابت است."
                }
              ]
            }
          ]
        }
