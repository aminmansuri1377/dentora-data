  "steps": [
    {
      "id": "theory:9429b487b55091c18e8a5a681b3e8df01ce648fa177b26ff4bc8d61253495b75",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "8f4edf98675bc34ea2312082abaccfe11ee85d6b578faad0922f1f7394ca611a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آسپرین، NSAIDها و داروهای آرام‌بخش"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۴۰ ساله‌ای که آسم و پولیپ بینی دارد، پس از کشیدن مولر می‌پرسد: «ایبوپروفن بخورم؟» چه جوابی می‌دهی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آسپرین در حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۰٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیماران آسمی برونکواسپاسم می‌دهد. در بیمار آسمی که سینوزیت گسترده و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پولیپ بینی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم دارد، حساسیت به آسپرین به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۰ تا ۴۰٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌رسد. به این سه‌گانه (آسم، پولیپ بینی و حساسیت به آسپرین) تریاد سامتر می‌گویند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سازوکار آلرژیک نیست: آسپرین مسیر سیکلواکسیژناز را می‌بندد، اسید آراشیدونیک به مسیر لیپواکسیژناز می‌رود و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لکوترین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " زیاد می‌شود که برونش را منقبض می‌کند. همین بیمار ممکن است با NSAIDهای دیگر، مثل ایبوپروفن، هم همین واکنش را بدهد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به بیمار آسمی آسپرین یا NSAID نده؛ به‌ویژه اگر پولیپ بینی دارد یا با این داروها واکنش داده است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای درد، استامینوفن معمولاً انتخاب امن‌تری است. ترکیب‌های مسکنی را که آسپرین دارند هم بشناس."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مخدرها و باربیتورات‌ها"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را نده: اپیوئیدها، به‌ویژه پتیدین (مپریدین)، هیستامین آزاد می‌کنند و باربیتورات‌ها تنفس را سرکوب می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بتابلاکرها و داروهای کولینرژیک هم می‌توانند حمله را راه بیندازند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیهوشی عمومی سرپایی در بیمار آسمی معمولاً منع دارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:0d1cee2487398c87563d11f8b2ccdcda0ec63cdfb19263a9e9266e9290880861",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "85599a3aad094774da9aa211c612805bd5f48e2b6ef1ce65f8b26e24056b058b",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بی‌حسی موضعی، آنتی‌بیوتیک و داروهای خود بیمار"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سولفیت در کارپول بی‌حسی"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همه‌ی کارپول‌های بی‌حسی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنگ‌کننده‌ی عروق"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارند، سدیم بی‌سولفیت یا متابی‌سولفیت دارند تا اپی‌نفرین اکسید نشود. در بیماری که آنزیم سولفیت اکسیداز کم دارد، از سولفیت گاز دی‌اکسید گوگرد ساخته می‌شود و برونکواسپاسم می‌دهد. بیشتر این بیماران آسمی‌های وابسته به کورتیکواستروئیدند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در حساسیت ثابت‌شده به سولفیت، بی‌حسی ساده (بدون تنگ‌کننده) بزن: مپیواکائین ۳٪ یا پریلوکائین ۴٪."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حساسیت به سولفیت با حساسیت به آنتی‌بیوتیک‌های سولفونامید ربطی ندارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تئوفیلین و آنتی‌بیوتیک"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به بیماری که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تئوفیلین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌خورد، اریترومایسین و دیگر ماکرولیدها یا سیپروفلوکساسین نده؛ این داروها سطح خونی تئوفیلین را بالا می‌برند و خطر مسمومیت با آن را زیاد می‌کنند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "داروهای خود بیمار"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "داروی نجات:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اسپری سالبوتامول، برای خود حمله."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "داروهای کنترل:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کورتیکواستروئید استنشاقی، بتا۲ آگونیست طولانی‌اثر، مونته‌لوکاست و کرومولین. اثر کورتیکواستروئید استنشاقی تازه پس از حدود ۲ ساعت شروع می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیماری که مدت طولانی کورتیکواستروئید سیستمیک گرفته، ممکن است سرکوب آدرنال داشته باشد؛ پیش از جراحی بزرگ با پزشکش مشورت کن."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
