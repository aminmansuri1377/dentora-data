  "steps": [
    {
      "id": "theory:b5bd1bc20a42fcfc05ab93bddb3c3b3c7e9925b13ad6637a707795dfed876160",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "e50756de02ce07127f5ce578a6a1c06a187d219b4f444b173c011a6bbf09e4e1",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ارزیابی بیمار آسمی پیش از درمان"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۳۰ ساله‌ای در فرم شرح حال «آسم» را علامت زده است. می‌گوید این هفته سه بار اسپری‌اش را زده و ماه پیش یک بار کارش به اورژانس بیمارستان کشیده است. برای عصب‌کشی امروز آماده است؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هدف اصلی درمان بیمار آسمی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیشگیری از حمله"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، و پیشگیری با شرح حال شروع می‌شود. بپرس:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آسم واقعی است یا مثلاً رینیت آلرژیک که اهمیت کمتری دارد؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چه چیزهایی حمله‌اش را راه می‌اندازد: آلرژن، عفونت تنفسی، ورزش، هوای سرد، بوها، دارو یا استرس؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حمله‌ها هر چند وقت یک بار و چقدر شدیدند و معمولاً با چه برطرف می‌شوند؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چه داروهایی مصرف می‌کند و آیا منظم مصرف می‌کند؟ سابقه‌ی اورژانس یا بستری دارد؟"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نشانه‌های آسم کنترل‌نشده"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم یا مصرف اسپری سالبوتامول بیش از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲ روز در هفته"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مراجعه به اورژانس در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳ ماه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گذشته"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مصرف بیش از یک قوطی اسپری در ماه (حدود ۲۰۰ پاف) یا دو برابر شدن مصرف ماهانه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خس‌خس، سرفه یا عفونت تنفسی در روز مراجعه"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آسم کنترل‌نشده یا ناپایدار یعنی درمان انتخابی را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به تعویق بینداز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و با پزشک بیمار مشورت کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:c423580a309937060b58229652c134cccad4fe59f35cc50c5248d510e97e6f12",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "3dcb994e7496e23d5f115721b5ccdfe4f2b68aeb9057476ebbba101395065a25",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تنظیم نوبت و محیط درمان"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار آسمیِ کنترل‌شده را با چند تغییر ساده می‌توانی با خیال راحت درمان کنی:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اسپری همراه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از بیمار بخواه در هر جلسه اسپری سالبوتامولش را بیاورد و آن را در دسترس بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پاف پیشگیرانه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در آسم متوسط تا شدید، یک نوبت اسپری در آغاز جلسه احتمال حمله را کم می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زمان نوبت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اگر حمله‌هایش شبانه است، نوبت را اواخر صبح بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بوها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش از آمدن بیمار بوهای تند مطب، مثل متیل متاکریلات آکریل، را کم کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "وضعیت صندلی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیشتر بیماران وضعیت نشسته یا نیمه‌نشسته را بهتر از خوابیده تحمل می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پایش:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در کارهای طولانی یا تهاجمی از پالس‌اکسیمتر کمک بگیر. SpO2 فرد سالم بین ۹۷ و ۱۰۰٪ است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اسپیرومتر خانگی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اگر بیمار ثبت روزانه‌ی تنفسش را دارد، پیش از کار از او بخواه در دستگاه بدمد؛ افت به زیر ۸۰٪ بهترین عدد خودش یا بیش از ۱۰٪ نسبت به ثبت‌های قبلی یعنی پاف پیشگیرانه یا ارجاع به پزشک."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اضطراب خودش محرک حمله است. رابطه‌ی گرم، توضیح کار و پروتکل کاهش استرس را جدی بگیر. اگر آرام‌بخشی لازم است، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکسید نیتروژن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بهترین انتخاب است: تنفس را سرکوب نمی‌کند، راه هوایی را تحریک نمی‌کند و کمی هم برونش را گشاد می‌کند. دوز کم یک بنزودیازپین خوراکی مثل دیازپام هم گزینه‌ی مناسبی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "از بیمار بخواه با نخستین نشانه‌ی حمله دستش را بالا بیاورد تا زود کار را متوقف کنی."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
