    {
      "id": "theory:ce4b097cfe808bb4eb3946813e5bb834dd9aa68ee6ab6f7ddefa7ab304db4ac6",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "dd4fbbdb848d2b2eedd2ebfe2355c477e33b5993ff4aee66d1f29e37acd23884",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کتواسیدوز دیابتی (DKA)"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "دختر ۱۹ ساله‌ای با دیابت نوع ۱ و آبسه‌ی دندانی آمده. می‌گوید دو روز است از درد چیزی نخورده و برای همین انسولینش را هم نزده. تشنه است، استفراغ کرده، تند و عمیق نفس می‌کشد و نفسش بوی میوه می‌دهد. چه خبر است؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بدون انسولین، قند وارد سلول‌ها نمی‌شود و در خون بالا می‌رود. سلول‌های گرسنه چربی می‌سوزانند و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کتون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌سازند؛ کتون خون را اسیدی می‌کند. قند اضافه از ادرار دفع می‌شود و آب زیادی با خودش می‌برد، پس بیمار دهیدراته می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محرک‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت و بیماری"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نزدن یا کم زدن انسولین"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قطع شدن پمپ انسولین"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علائم"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرادراری، تشنگی و دهیدراتاسیون"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تهوع، استفراغ و درد شکم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنفس تند و عمیق؛ بدن با آن اسید خون را جبران می‌کند"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بوی میوه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (استون) در نفس"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خواب‌آلودگی که به کما می‌رسد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "DKA معمولاً طی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساعت‌ها تا روزها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شکل می‌گیرد، نه چند دقیقه، و بیشتر در دیابت نوع ۱ دیده می‌شود. هیپوگلیسمی برعکس در چند دقیقه رخ می‌دهد. پس بیمار DKA معمولاً از قبل ناخوش وارد مطب می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:6fc291f938ac182b50b11b20b3161351b0dc5da9b57ae0858d39d8bb7564ff67",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "6c243c35429a5d1f0eb9e1132f92f69bd322fe3bf4e2878affe1a697add5f431",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هیپرگلیسمی شدید و اقدام در مطب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در دیابت نوع ۲ کتوز کمتر است و قند بسیار بالا بیشتر به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سندرم هیپراسمولار (HHS)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌رسد: دهیدراتاسیون شدید و کاهش سطح هوشیاری، معمولاً در بیمار مسن‌تر."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گلوکومتر پیش از درمان"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زیر ۷۰ mg/dL: اول کربوهیدرات، بعد درمان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۸۰ تا ۲۰۰ mg/dL: مناسب برای درمان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بالای ۲۰۰ mg/dL: درمان انتخابی را عقب بینداز یا با پزشک هماهنگ کن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بالای ۳۰۰ mg/dL: بیمار را به پزشک یا بیمارستان بفرست"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قند بالا همراه علائم DKA یا HHS: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ارجاع فوری"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر علائم DKA یا HHS دیدی"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان را قطع کن و قند را با گلوکومتر بسنج."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با ۱۱۵ تماس بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راه هوایی، تنفس و گردش خون را بسنج و اکسیژن بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار بدحال را خوابیده نگه دار؛ اگر استفراغ کرد، به پهلو بچرخانش."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم حیاتی را تا رسیدن آمبولانس ثبت کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " زدن انسولین در مطب. درمان DKA و HHS مایع وریدی فراوان، انسولین با پایش و اصلاح الکترولیت‌هاست و جایش بیمارستان است. کار تو شناختن، حمایت پایه و ارجاع سریع است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
