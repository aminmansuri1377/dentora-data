        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اقدام مشترک و درمان اختصاصی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیشتر گام‌ها در همه‌ی این اورژانس‌ها یکی است. تفاوت در یکی دو اقدام اختصاصی است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گام‌های مشترک"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان را قطع کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وضعیت درست: بیمار دیابتی هوشیار نشسته؛ بیمار با افت فشار یا بی‌هوش خوابیده به پشت با پاهای بالا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمک بخواه و با ۱۱۵ تماس بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راه هوایی، تنفس و گردش خون را بسنج و اکسیژن بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم حیاتی را بسنج و قند را با گلوکومتر بگیر."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اقدام اختصاصی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هیپوگلیسمی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " قند خوراکی در بیمار هوشیار؛ گلوکاگون ۱ میلی‌گرم عضلانی در بیمار بی‌هوش"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بحران آدرنال:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هیدروکورتیزون ۱۰۰ میلی‌گرم وریدی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "طوفان تیروئیدی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " خنک کردن و پرهیز از اپی‌نفرین"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کمای میکزدم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گرم نگه داشتن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "DKA و HHS:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " حمایت پایه و انتقال؛ مایع و انسولین در بیمارستان"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر بیمار دیابتی هوشیار است، نمی‌دانی قندش بالاست یا پایین و گلوکومتر در دسترس نیست، قند خوراکی بده. کمی قند اضافه در کوتاه‌مدت به بیمار هیپرگلیسمیک آسیب جدی نمی‌زند، ولی هیپوگلیسمی را درمان می‌کند."
                }
              ]
            }
          ]
        }
      ],
