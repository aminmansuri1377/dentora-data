      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "علائم و درمان بحران آدرنال"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علائم"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آغاز:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گیجی، تهوع، خستگی شدید و ضعف عضلانی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بدتر شدن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گیجی بیشتر، درد کمر، شکم و پاها، استفراغ و افت فشار"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مرحله‌ی آخر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هوشیاری می‌رود و برمی‌گردد؛ کما یعنی مرحله‌ی پیش از مرگ"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "همراه: تعریق فراوان، تب، نبض ضعیف، تنگی نفس و سردرد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در جراحی بیمار نارسایی آدرنال، فشار را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر ۵ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بسنج. فشار سیستولیک زیر ۱۰۰ یا دیاستولیک ۶۰ و کمتر یعنی افت فشار، و باید اقدام کنی."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اقدام"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان را قطع کن و علائم حیاتی را بسنج."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر فشار افتاده، بیمار را خوابیده به پشت با پاهای بالا بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمک بخواه و با ۱۱۵ تماس بگیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکسیژن ۵ تا ۶ لیتر در دقیقه بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هیدروکورتیزون ۱۰۰ میلی‌گرم وریدی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تزریق کن، یا دگزامتازون ۴ میلی‌گرم وریدی. اگر رگ نداری، هیدروکورتیزون را عضلانی بزن؛ جذبش کندتر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر رگ داری، سرم وریدی را سریع بده تا فشار بالا بیاید. علائم حیاتی را پیاپی ثبت کن و اگر لازم شد BLS را شروع کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گمان این‌که بیمار فقط سنکوپ کرده است. در سنکوپ وازوواگال بیمار با خواباندن زود بهتر می‌شود؛ افت فشار بحران آدرنال با خواباندن برطرف نمی‌شود و کورتیکواستروئید و مایع لازم دارد."
                }
              ]
            }
          ]
        }
      ],
