  "steps": [
    {
      "id": "theory:30cd237005fa0f22a16f0e8104c05d5a543cd8b5ee27eb8bc7b5a177d17e087a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6c3682a35fcf3901e657b3ee4b098dafaab85ee8356441ec653b3532200f00ce",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بیماری فون ویلبراند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۲۴ ساله‌ای برای جرم‌گیری آمده است. می‌گوید لثه‌اش زیاد خون می‌آید، زیاد خون‌دماغ می‌شود، قاعدگی‌اش سنگین است و پس از کشیدن دندان عقل یک روز خون‌ریزی داشت. مادرش هم همین‌طور است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این الگوی خون‌ریزی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوستی‌ـ‌مخاطی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در زن و مرد، به بیماری فون ویلبراند اشاره دارد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فاکتور فون ویلبراند (vWF) دو کار دارد"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پلاکت را به دیواره‌ی آسیب‌دیده‌ی رگ می‌چسباند (چسبندگی پلاکت)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فاکتور VIII را در خون حمل و از تخریب حفظ می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس در نوع‌های شدید، هم چسبندگی پلاکت مختل است و هم فاکتور VIII کم می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همه‌گیری و نوع‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شایع‌ترین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اختلال خون‌ریزی ارثی: حدود ۱٪ جمعیت."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوع ۱ و ۲ اتوزومال غالب‌اند؛ پس مرد و زن هر دو مبتلا می‌شوند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نوع ۱"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (۷۰ تا ۸۰٪ موارد): کمبود نسبی vWF، خون‌ریزی خفیف تا متوسط."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نوع ۳"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": نادر، اتوزومال مغلوب، کمبود شدید vWF و فاکتور VIII."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علائم"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "خون‌دماغ، خون‌ریزی لثه، منوراژی و خون‌ریزی پس از کشیدن دندان شایع‌اند؛ پتشی نادر است. همارتروز فقط در نوع‌های شدید دیده می‌شود. نوع خفیف ممکن است سابقه‌ی خون‌ریزی منفی داشته باشد و فقط پس از جراحی یا ضربه خودش را نشان دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:2975813f80bb7739868687b0b887eb5b5b26ddc6914eafe92835cae0ccb929d1",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "33ee08c78a9243f7dd6d1dce0a491a9aed6f8955b9d4f5ef9bb277c0d3dcf9e9",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تشخیص و درمان فون ویلبراند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آزمایش‌ها"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "غربالگری ممکن است aPTT طولانی، PT طبیعی و پلاکت طبیعی یا کمی کم نشان دهد. تشخیص قطعی و تعیین نوع با آزمایش‌های اختصاصی است (آنتی‌ژن vWF، فعالیت کوفاکتور ریستوستین، سنجش فاکتور VIII)."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دسموپرسین (DDAVP)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "vWF و فاکتور VIII ذخیره‌ی بدن را موقتاً آزاد می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بهترین پاسخ در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نوع ۱"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ در نوع ۳ و بیشتر نوع‌های ۲ اثر ندارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از استفاده، پاسخ بیمار به دارو باید آزموده شده باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تزریقی (۰٫۳ میکروگرم به ازای هر کیلوگرم) یا اسپری بینی، حدود یک ساعت پیش از جراحی؛ دوز دوم در صورت نیاز ۸ تا ۲۴ ساعت بعد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در سالمند بیمار قلبی احتیاط کن: خطر ترومبوز."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نوع ۳ و بیشتر نوع‌های ۲ کنسانتره‌ی فاکتور VIII حاوی vWF می‌گیرند. ترانگزامیک اسید کنار این‌ها کمک می‌کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو اختلال ارثی پلاکت"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ترومباستنی گلانزمن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نقص گیرنده‌ی GP IIb/IIIa؛ پلاکت می‌چسبد ولی تجمع نمی‌یابد. در جمعیت‌های با ازدواج فامیلی، از جمله ایران، شایع‌تر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سندرم برنارد‌ـ‌سولیه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نقص GP Ib؛ پلاکت‌های درشت به vWF نمی‌چسبند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "در هر دو، خون‌ریزی لثه، خون‌دماغ و منوراژی شایع است و درمان اصلی تزریق پلاکت و فاکتور VII فعال نوترکیب است. داروی ضدپلاکت، از جمله آسپرین و NSAID، ممنوع است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
