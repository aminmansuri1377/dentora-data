      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "علائم و آزمایش‌های هموفیلی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تصویر بالینی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مشخص‌ترین علامت: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "همارتروز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (خون‌ریزی داخل مفصل، به‌ویژه زانو)، اغلب بی‌ضربه‌ی مهم."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکیموز، هماتوم بافت نرم و عضله، خون‌ریزی گوارشی و ادراری."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از بریدگی کوچک (مثل تیغ اصلاح) معمولاً خون‌ریزی غیرعادی ندارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از آسیب بزرگ‌تر، خون‌ریزی نامتناسب با آسیب است و گاهی روزها و هفته‌ها نشت آرام ادامه می‌یابد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «سر جلسه خونش بند آمد، پس مشکلی ندارد.» در هموفیلی، هموستاز هنگام جراحی اغلب طبیعی به نظر می‌رسد و خون‌ریزی جدی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چند ساعت تا چند روز بعد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شروع می‌شود."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/med-fig-25-1.webp",
                  "alt": "اکیموز وسیع زیرپوستی پس از ضربه در بیمار هموفیلی؛ خون‌ریزی نامتناسب با آسیب",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/97518a2141eb3ba8bbb73e7a2e504cc671f87214d60a77750afa6c6100b67df1.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکیموز وسیع زیرپوستی پس از ضربه در بیمار هموفیلی؛ خون‌ریزی نامتناسب با آسیب "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 25.1)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آزمایش‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "aPTT طولانی، PT طبیعی، شمارش پلاکت طبیعی: مشکل در مسیر داخلی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تست اختلاط (mixing test):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اگر aPTT با پلاسمای طبیعی اصلاح شود، سنجش اختصاصی فاکتور VIII یا IX نوع بیماری را روشن می‌کند؛ اگر اصلاح نشود، به مهارکننده فکر کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هموفیلی A و B از نظر بالینی و آزمایش غربالگری یکسان‌اند؛ فقط سنجش اختصاصی فاکتور آن‌ها را جدا می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مهارکننده (inhibitor)"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مهارکننده آنتی‌بادی IgG علیه فاکتور VIII است که پس از دریافت مکرر فاکتور ساخته می‌شود؛ در ۲۰ تا ۳۰٪ هموفیلی A شدید. در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "low responder"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سطح آنتی‌بادی با فاکتور تازه بالا نمی‌رود؛ در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "high responder"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بالا می‌رود و درمان دشوارتر است."
                }
              ]
            }
          ]
        }
      ],
