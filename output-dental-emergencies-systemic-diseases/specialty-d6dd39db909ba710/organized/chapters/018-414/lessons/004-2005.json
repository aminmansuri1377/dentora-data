  "steps": [
    {
      "id": "theory:66abe26cd03c35d5c873f73db5e75be83b0e392c990ad8713b3f0f7785e46782",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "8a94d119593121568898aa3b69d096fcca9408d9e808fa4cd2ed2b7785b0de30",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ترومبوفیلی ارثی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۳۲ ساله‌ای در شرح حال نوشته است: «۲۸ سالگی لخته در ساق پا (DVT)، جهش فاکتور V لیدن». برادرش هم پیش از ۴۰ سالگی آمبولی ریه داشته است. برای کشیدن پرمولر آمده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این بیمار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مستعد لخته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه خون‌ریزی. در اختلالات افزایش انعقاد (ترومبوفیلی ارثی)، تعادل هموستاز به سمت لخته به هم خورده است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو راه به ترومبوفیلی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کمبود یک عامل ضدلخته:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آنتی‌ترومبین III، پروتئین C، پروتئین S"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "افزایش یک عامل پیش‌لخته:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فاکتور V لیدن، جهش پروترومبین G20210A، هیپرهموسیستئینمی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تصویر بالینی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عارضه‌ی اصلی: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ترومبوآمبولی وریدی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (DVT و آمبولی ریه)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نخستین لخته معمولاً در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اوایل بزرگسالی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، هرچند از کودکی تا پیری ممکن است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترومبوز شریانی در ترومبوفیلی ارثی غیرمعمول است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در بیش از ۶۰٪ بیمارانی که بی‌علت روشن دچار ترومبوآمبولی وریدی می‌شوند، یک زمینه‌ی ارثی پیدا می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس در شرح حال، لخته‌ی وریدی در جوانی یا سابقه‌ی خانوادگی لخته را جدی بگیر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:b5c3ceddd3d501b614ff4e76ff1b55c75f83cb8798cc0ad1232737071ec3ddb1",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "c5ba81d6f0e24d30084dff66cf0e3af4d41405d226e73cd651af30f93fbdc290",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "انواع ترومبوفیلی و ملاحظات دندانپزشکی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هر نقص چه می‌کند؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آنتی‌ترومبین III:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مهارکننده‌ی اصلی ترومبین و فاکتورهای فعال؛ کمبودش یعنی تمایل مادام‌العمر به لخته."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پروتئین C:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فاکتورهای Va و VIIIa را غیرفعال می‌کند. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پروتئین S"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کوفاکتور اصلی آن است؛ کمبود هر کدام همان نتیجه را دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فاکتور V لیدن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فاکتور V در برابر پروتئین C فعال مقاوم می‌شود (APC resistance)؛ در جمعیت‌های سفیدپوست شایع‌ترین ترومبوفیلی ارثی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جهش پروترومبین G20210A:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سطح پروترومبین پلاسما را بالا می‌برد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تشخیص"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هیچ آزمایش غربالگری کلی وجود ندارد؛ هر اختلال جداگانه سنجیده می‌شود. PT و aPTT برای کشف ترومبوفیلی ساخته نشده‌اند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در مطب دندانپزشکی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خود ترومبوفیلی خون‌ریزی را زیاد نمی‌کند؛ خطر خون‌ریزی از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "داروی ضدانعقاد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیمار می‌آید و برنامه‌ی دندانپزشکی بر پایه‌ی همان دارو چیده می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داروی ضدانعقاد را خودسرانه قطع نکن؛ در این بیمار قطع دارو یعنی خطر لخته‌ی تازه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داروهای هموستاتیک سیستمیک (ترانگزامیک اسید خوراکی یا وریدی، دسموپرسین) خطر ترومبوز دارند؛ هموستاز موضعی را مقدم بدار و داروی سیستمیک را با پزشک هماهنگ کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «واژه‌ی اختلال انعقادی در پرونده» را همیشه به معنای خون‌ریزی گرفتن. بپرس بیمار مستعد خون‌ریزی است یا لخته."
                }
              ]
            }
          ]
        }
      ],
