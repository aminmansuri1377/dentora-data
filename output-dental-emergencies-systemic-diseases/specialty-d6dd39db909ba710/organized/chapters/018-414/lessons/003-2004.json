      "sourceProgress": "width: 0%;",
      "contentKey": "f71164023020a5dc3254610f925037698d2f52e045b6d2d269a1ecaf1ac896dd",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "برنامه‌ریزی با هماتولوژیست"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۳۰ ساله‌ای با هموفیلی A متوسط (فاکتور VIII حدود ۳٪) برای کشیدن مولر اول پایین آمده است. مهارکننده ندارد. فردا صبح وقت داری. از کجا شروع می‌کنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از هر کار تهاجمی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مشاوره با هماتولوژیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لازم است. هماتولوژیست این‌ها را روشن می‌کند:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شدت بیماری و سطح فاکتور"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وجود مهارکننده و low یا high responder بودن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوع و دوز جایگزینی فاکتور یا کافی بودن دسموپرسین و داروی ضدفیبرینولیتیک"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان در مطب یا بستری در بیمارستان"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چه کسی چه می‌خواهد؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خفیف بی‌مهارکننده:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " جرم‌گیری، جراحی بافت نرم و کشیدن دندان معمولاً در مطب، با دسموپرسین و ترانگزامیک اسید یا آمینوکاپروئیک اسید در صورت نیاز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "متوسط:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای جراحی بزرگ دهان حتماً فاکتور VIII؛ گاهی برای کار تهاجمی کوچک هم."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شدید:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای هر درمان تهاجمی، فاکتور VIII."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "low responder:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فاکتور VIII، با دوز بیشتر، برای هر کار تهاجمی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "high responder:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فاکتور VII فعال نوترکیب برای هر کار تهاجمی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای جراحی بزرگ دهان، سطح فاکتور VIII دست‌کم ۵۰٪ هدف است؛ خون‌ریزی تهدیدکننده‌ی حیات ۸۰ تا ۱۰۰٪ می‌خواهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بهترین درمان، کاری است که لازم نشود. فلوراید، فیشورسیلانت، رژیم کم‌قند و معاینه‌ی منظم از کودکی، نیاز به جایگزینی فاکتور را کم می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:c922ea22c754e9af6e00af697e3f71a9d09f87f4b6d6e69a33b98f5875869a41",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "2aa2e4aa0bb0c149f3883e509d599fbd4aaed4f7eff27863f1d95997db77fc8d",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بی‌حسی و کارهای دندانپزشکی در هموفیلی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بی‌حسی موضعی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در هموفیلی متوسط و شدید، بدون جایگزینی فاکتور از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بلاک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (مثل بلاک آلوئولار تحتانی)، انفیلتراسیون لینگوال و تزریق کف دهان پرهیز کن؛ هماتوم در این فضاها می‌تواند راه هوایی را ببندد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انفیلتراسیون و تزریق داخل لیگامانی (PDL) معمولاً بی‌فاکتور شدنی است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "معمولاً بی‌فاکتور"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترمیم ساده، و درمان ریشه‌ی دندان غیرزنده (بی‌اینسترومنت یا پرکردن فراتر از اپکس؛ تزریق بی‌حسی حاوی اپی‌نفرین داخل کانال خون‌ریزی را کم می‌کند)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پالیش و برداشتن جرم بالای لثه، بی‌آسیب به لثه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارتودنسی، به شرط نداشتن لبه‌ی تیز روی دستگاه"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "معمولاً با فاکتور (متوسط و شدید)"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترمیم‌های پیچیده، جراحی پریودنتال، روت‌پلنینگ، کشیدن دندان و جراحی دهان. از تزریق عضلانی بی‌فاکتور هم پرهیز کن. هر جا ممکن است، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان ریشه را به کشیدن ترجیح بده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هنگام و پس از جراحی"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در فک پایین فلپ را از سمت باکال بزن، نه لینگوال."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساکت را با کلاژن پر کن و با بخیه ببند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دهان‌شویه‌ی ترانگزامیک اسید ۵٪: ۵ میلی‌لیتر، ۲ دقیقه در دهان، پیش از کار و تا چهار بار در روز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسکن: استامینوفن با یا بدون کدئین؛ آسپرین و NSAID نه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کنترل ۲۴ تا ۴۸ ساعت بعد: خون‌ریزی، ترمیم زخم و واکنش آلرژیک به فاکتور."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
