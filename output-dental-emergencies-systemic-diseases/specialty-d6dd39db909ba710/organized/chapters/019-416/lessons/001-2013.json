  "steps": [
    {
      "id": "theory:474daf96d021252afca28155a3b8b2d0952f23ba1a647e062a8c778ee5a1c709",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "a30d24c8a9062b4abd5b6a3b729199bfc42d79a066d34d0c86d514706a594271",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کم‌خونی در مطب دندانپزشکی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۴۰ ساله‌ای برای جرم‌گیری آمده و می‌گوید با مسواک لثه‌اش خون می‌آید. از خستگی و تنگی نفس با کمترین فعالیت می‌نالد و قاعدگی سنگینی دارد. پوست صورتش رنگ‌پریده است. به چه فکر می‌کنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/med-fig-22-9.webp",
                  "alt": "رنگ‌پریدگی دست بیمار کم‌خون در کنار دست فرد سالم",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/75d24a2bef1409f5be32d6d964ae55fc62114763f27184b96d0b7b18db20df05.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رنگ‌پریدگی دست بیمار کم‌خون در کنار دست فرد سالم "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 22.9)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کم‌خونی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی کم شدن ظرفیت حمل اکسیژن خون؛ معمولاً چون گلبول قرمز یا هموگلوبین (Hb) کم است. کم‌خونی خودش بیماری نیست؛ نشانه‌ی یک مشکل زمینه‌ای است. سه راه اصلی دارد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تولید کم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کمبود آهن، کمبود فولات یا ویتامین B12، کم‌خونی آپلاستیک"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "از دست رفتن خون:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " حاد یا مزمن، مثل قاعدگی سنگین یا خون‌ریزی گوارشی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تخریب زیاد (همولیز):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کم‌خونی داسی‌شکل، تالاسمی، کمبود G6PD"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مرز کم‌خونی: Hb کمتر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۲ g/dL در زن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و کمتر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۳٫۵ g/dL در مرد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". شایع‌ترین نوع، کم‌خونی فقر آهن است. کم‌خونی در مرد معمولاً یعنی یک مشکل زمینه‌ای، مثل خون‌ریزی گوارشی یا بدخیمی."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم عمومی: رنگ‌پریدگی، خستگی، تپش قلب و تنگی نفس"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کم‌خونی‌ای که سریع ایجاد شود علائم شدیدتری دارد؛ نوع آهسته تا مدت‌ها بی‌صدا می‌ماند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقش تو:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیمار مشکوک را برای CBC با دیفرانسیل به پزشک بفرست. کم‌خونی ممکن است نخستین نشانه‌ی زخم پپتیک یا سرطان باشد و تشخیص زودش جان بیمار را نجات دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:94e857862879036eb28c0da8d1a199ffb369c6dfd69b6ee46eb3029a3e15e7dc",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5f329925327d2afa05f96bf479bc4188bdca46bb161a96635d75c9fef1761c27",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "انواع کم‌خونی، نشانه‌های دهانی و تصمیم درمانی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اندازه‌ی گلبول (MCV)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "میکروسیتیک (کمتر از ۸۰ fL):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فقر آهن، تالاسمی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نرموسیتیک (۸۰ تا ۱۰۰ fL):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کم‌خونی همولیتیک، آپلاستیک، نارسایی کلیه، بیماری مزمن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ماکروسیتیک (بیشتر از ۱۰۰ fL):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کمبود فولات و کم‌خونی پرنیشیوز؛ در اسمیر، نوتروفیل با هسته‌ی پرلوب"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کم‌خونی پرنیشیوز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " معده «عامل داخلی» (intrinsic factor) نمی‌سازد و B12 جذب نمی‌شود. علتش خودایمنی است و درمانش تزریق B12."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در دهان چه می‌بینی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مخاط رنگ‌پریده؛ زبان صاف و قرمز با از بین رفتن پاپی‌ها و سوزش زبان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کیلیت گوشه‌ی لب و آفت"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سندرم پلامر-وینسون"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در فقر آهن: زخم دهان، دیسفاژی و خطر بیشتر سرطان دهان و حلق؛ این بیمار را از نزدیک پیگیری کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تصمیم درمانی"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای درمان روتین، Hb بالای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۱ g/dL"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد و بیمار علامتی نداشته باشد. بیماری که تنگی نفس، Hb زیر ۱۱، ضربان غیرطبیعی یا SpO2 زیر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۹۱٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد ناپایدار است؛ درمان انتخابی را تا بهتر شدن حالش عقب بینداز."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "در کار تهاجمی روی هر بیمار کم‌خون، پالس‌اکسیمتر وصل کن. در کم‌خونی آپلاستیک همه‌ی رده‌های خون کم‌اند: پتشی، اکیموز، خون‌ریزی لثه و عفونت را جدی بگیر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
