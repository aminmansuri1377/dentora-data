  "steps": [
    {
      "id": "theory:7727f055dacec3754bddd5e5c5abab374d2a8f3d94d608174e16406fabc07d22",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "503af484250ba477499b1975c3dce10eedbd62896a12f7c779e75fc05297427d",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "لوسمی حاد و مزمن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پسر ۱۷ ساله‌ای از خون‌ریزی لثه شکایت دارد. لثه‌ی همه‌ی دندان‌ها متورم، اسفنجی و پرخون است، روی کام چند پتشی می‌بینی و مادرش می‌گوید یک ماه است تب و خستگی دارد. جرم زیادی هم ندارد. چه باید بکنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/med-fig-23-13.webp",
                  "alt": "بزرگی لثه از نفوذ سلول‌های لوسمی در لوسمی حاد میلوئید",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/46d983af0a6d84dde03add89efa7a7f5a083e43f96873fde32bd32e1ee6f6223.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بزرگی لثه از نفوذ سلول‌های لوسمی در لوسمی حاد میلوئید "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 23.13)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لوسمی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سرطان گلبول سفید در مغز استخوان و خون است. سلول سرطانی مغز استخوان را پر می‌کند و جای رده‌های سالم را می‌گیرد؛ پس بیمار هم‌زمان کم‌خونی، کمبود پلاکت و کمبود گلبول سفید کارآمد دارد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خون‌ریزی، عفونت و ترمیم کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لوسمی حاد:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شروع ناگهانی و سلول‌های نابالغ و ناکارآمد؛ بی‌درمان در کمتر از ۶ ماه کشنده است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لوسمی مزمن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شروع آهسته و سلول‌های بالغ‌تر؛ سیر بی‌درمان ۲ تا ۶ سال."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چهار نوع اصلی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "AML:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شایع‌ترین لوسمی حاد بزرگسالان؛ با بالا رفتن سن بیشتر می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ALL:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " لوسمی کودکان؛ حدود ۷۵٪ لوسمی‌های کودکی، با اوج ۱ تا ۴ سالگی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "CML:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کروموزوم فیلادلفیا (BCR-ABL)؛ اغلب با WBC بالا در آزمایش روتین کشف می‌شود و با ایماتینیب درمان می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "CLL:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شایع‌ترین لوسمی بزرگسالان، بیشتر در سالمندان؛ با لنفادنوپاتی و طحال بزرگ."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بزرگی لثه در لوسمی از ارتشاح سلول‌های لوسمیک است، نه فقط پلاک. تا ۴۰٪ لوسمی‌های حاد و حدود ۱۰٪ مزمن‌ها آن را دارند؛ بیشتر در AML و با بهداشت دهان ضعیف."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:34316bdf9ae65036a9c6ae617153011317c6e83cdf8a668c1dd97233691f7742",
      "sourceId": null,
      "identityOrigin": "local-step",
