  "steps": [
    {
      "id": "theory:793be15de7014fe217a053b47fa180d8315465dcca2312464d16ca7fe1bc2fa2",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "5d153804ce5309236462f7a58d2ec1cc2bb0e55658cf3efeed175578c3df4ac0",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "NSAID، کورتیکواستروئید و DMARD"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقای ۵۵ ساله‌ای با آرتریت روماتوئید برای کشیدن دو مولر آمده است. هفته‌ای یک بار متوترکسات، روزانه ناپروکسن و صبح‌ها پردنیزولون می‌خورد. پیش از جراحی به چه چیزهایی فکر می‌کنی؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "NSAIDها و آسپرین"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد، تورم و خشکی را کم می‌کنند ولی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سیر بیماری را تغییر نمی‌دهند"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عملکرد پلاکت را مختل می‌کنند. اثر آسپرین "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "برگشت‌ناپذیر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است و در تمام عمر پلاکت (۱۰ تا ۱۲ روز) می‌ماند؛ اثر NSAIDهای دیگر تا وقتی دارو در خون هست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این خون‌ریزی معمولاً اهمیت بالینی ندارد و با هموستاز موضعی کنترل می‌شود؛ ولی آسپرین همراه کورتیکواستروئید خطر خون‌ریزی را بیشتر می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شایع‌ترین نشانه‌ی مسمومیت با آسپرین "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "وزوز گوش"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کورتیکواستروئیدها"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پردنیزولون و مشابه‌هایش التهاب را سریع مهار می‌کنند و تا اثر کردن داروهای کندتر پل می‌زنند. با کمترین دوز و کوتاه‌ترین مدت تجویز می‌شوند. در دندانپزشکی دو عارضه مهم است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرکوب آدرنال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیر ترمیم شدن زخم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". بیمار دوز همیشگی صبحش را روز جراحی بخورد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "DMARDها"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "داروهای تعدیل‌کننده‌ی بیماری آهسته اثر می‌کنند و جلوی تخریب مفصل را می‌گیرند؛ برای همین زود شروع می‌شوند. پرمصرف‌ترینشان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متوترکسات"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ هیدروکسی‌کلروکین، سولفاسالازین، لفلونوماید و آزاتیوپرین هم در این گروه‌اند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:70e5dd4a2b46250aefaabb07e1b94b0bfc4969fd2945c3b73f14368316e1952e",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "e45b92f7d846e6763c86e82712e9cc30ad364f28cb1bb0bbdb0b18cf819a9a9b",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "عوارض خونی و دهانی؛ داروهای بیولوژیک"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سرکوب مغز استخوان"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترکیبات طلا، پنی‌سیلامین، سولفاسالازین و داروهای سرکوب‌گر ایمنی (مثل متوترکسات و آزاتیوپرین) ممکن است کم‌خونی، آگرانولوسیتوز و ترومبوسیتوپنی بدهند. پیامدش: عفونت بیشتر، ترمیم کندتر و خون‌ریزی طولانی‌تر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر بیمار آزمایش تازه ندارد، پیش از جراحی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "CBC با شمارش افتراقی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بخواه و نتیجه‌ی غیرطبیعی را با پزشکش در میان بگذار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استوماتیت شدید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس از طلا، پنی‌سیلامین یا داروی سرکوب‌گر ایمنی می‌تواند نشانه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسمومیت دارویی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد؛ به پزشک خبر بده. درمان علامتی: دهان‌شویه‌ی تسکینی یا شربت دیفن‌هیدرامین."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "داروهای بیولوژیک"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هرکدام یک میانجی التهاب را هدف می‌گیرند: مهارکننده‌های TNF-α (اتانرسپت، اینفلیکسیمب، آدالیمومب)، مهار IL-6، مهار لنفوسیت B (ریتوکسیمب) و مهار لنفوسیت T (آباتاسپت)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تزریقی یا انفوزیون وریدی‌اند؛ شایع‌ترین عارضه درد و راش محل تزریق است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عفونت جدی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را بالا می‌برند؛ تب پایدار یعنی ارجاع فوری. واکسن زنده نباید بگیرند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مهارکننده‌ی JAK"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (توفاسیتینیب) برخلاف بیولوژیک‌ها خوراکی است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تداخل با مسکن"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "NSAID می‌تواند سطح متوترکسات را به حد سمی برساند. در متوترکسات با دوز بالا (شیمی‌درمانی سرطان) NSAID نده و استامینوفن بده؛ متوترکسات با دوز کم برای آرتریت از این نظر نگرانی ندارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
