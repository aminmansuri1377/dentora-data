      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "استنت، بای‌پس و داروی ضدپلاکت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بسیاری از بیماران قلبی آنژیوپلاستی با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استنت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا جراحی بای‌پس کرونر (CABG) داشته‌اند. استنت دو نوع است: فلزی ساده (bare metal) و دارویی (drug-eluting). استنت دارویی تا حدود یک سال خطر لخته شدن دارد؛ برای همین بیمار مدتی طولانی دو داروی ضدپلاکت می‌خورد، مثلاً آسپرین و کلوپیدوگرل."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/med-fig-4-7.webp",
                  "alt": "استنت فلزی باز‌شونده که پس از خالی شدن بالون در کرونر می‌ماند",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/54eb20accbe7ae736c68db010ae69e791a53e7e49f961ee7bd51cdcb025ec21a.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استنت فلزی باز‌شونده که پس از خالی شدن بالون در کرونر می‌ماند "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Little and Falace. Dental Management of the Medically Compromised Patient, 10th ed. — Fig. 4.7)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داروی ضدپلاکت را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "قطع نکن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ". خون‌ریزی کمی بیشتر است ولی با روش‌های موضعی کنترل می‌شود؛ قطع دارو خطر ترومبوز، MI و مرگ دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قطع دارو در این گروه‌ها از همه خطرناک‌تر است: استنت فلزی، آنژیوپلاستی یا CABG کمتر از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳ ماه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش؛ MI کمتر از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۶ ماه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ استنت دارویی کمتر از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۲ ماه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ". پیش از جراحی در این بیماران با پزشک مشورت کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای استنت کرونر، CABG یا بیماری ایسکمیک قلب "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پروفیلاکسی آنتی‌بیوتیک لازم نیست"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیماری که وارفارین می‌خورد، اگر INR او ۳٫۵ یا کمتر باشد، جراحی دهان را تحمل می‌کند؛ INR را ۲۴ تا ۷۲ ساعت پیش از کار بگیر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیگیری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ۲۴ تا ۴۸ ساعت پس از هر کار تهاجمی با بیمار تماس بگیر و بپرس دوره‌ی پس از عمل بی‌مشکل گذشته یا نه."
                }
              ]
            }
          ]
        }
      ],
