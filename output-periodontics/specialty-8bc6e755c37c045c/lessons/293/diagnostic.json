{
  "url": "https://app.dentigoapp.com/fa/lesson/293",
  "title": "درس ۳: فلپ جابه‌جاشده به اپیکال و حفظ پاپیلا",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "1"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "h2",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "⬇️ فلپ جابه‌جاشده به اپیکال؛ حذف پاکت بدون از دست دادن بافت"
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "🔑 "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ایده محوری:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " ژنژیوکتومی پاکت را حذف می‌کند اما لثه کراتینیزه را هم "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "می‌برد"
                }
              ]
            },
            {
              "tag": "text",
              "text": ". فلپ اپیکالی همان پاکت را حذف می‌کند اما لثه کراتینیزه را "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جابه‌جا"
                }
              ]
            },
            {
              "tag": "text",
              "text": " می‌کند — یعنی حفظش می‌کند."
            }
          ]
        },
        {
          "tag": "h3",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "✅ اندیکاسیون‌ها"
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حذف پاکت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در بیمار با لثه کراتینیزه "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "محدود"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " که ژنژیوکتومی در او ممنوع است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "افزایش طول تاج"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای ترمیم یا پروتز."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دسترسی همراه با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جراحی رزکتیو استخوان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افزایش پهنای لثه کراتینیزه در ناحیه."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "tag": "h3",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "🔧 تکنیک"
            }
          ]
        },
        {
          "tag": "ol",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "برش داخل شیاری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — از خود شیار یا بسیار نزدیک به مارجین، چون می‌خواهی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حداکثر بافت را حفظ کنی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تا بتوانی جابه‌جایش کنی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "برش‌های آزادکننده عمودی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در دو انتها — "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ضروری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است، چون بدون آن‌ها فلپ نمی‌تواند جابه‌جا شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برش‌ها باید تا "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فراتر از خط اتصال موکوژنژیوال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " امتداد یابند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بلند کردن فلپ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تمام‌ضخامت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (یا ترکیبی) و انجام دبریدمان و در صورت نیاز جراحی استخوان."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جابه‌جایی فلپ به اپیکال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تا سطح ستیغ استخوان."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تثبیت با بخیه معلق"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — که ارتفاع هر فلپ را مستقل تنظیم می‌کند."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "⚠️ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در سطح پالاتال، فلپ اپیکالی امکان‌پذیر نیست"
                }
              ]
            },
            {
              "tag": "text",
              "text": " — چون مخاط کام "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ثابت و غیرمتحرک"
                }
              ]
            },
            {
              "tag": "text",
              "text": " است و کشش ندارد. در کام، به‌جای جابه‌جایی، از "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فلپ با ضخامت‌دهی مجدد"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (thinned palatal flap) با برش داخل شیاری از فاصله بیشتر استفاده می‌شود."
            }
          ]
        }
      ]
    }
  ],
