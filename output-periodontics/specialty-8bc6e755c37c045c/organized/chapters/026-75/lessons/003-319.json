              "tag": "text",
              "text": "1"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h2",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "🧲 اصل بنیادی پریو-ارتو"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک یافته تجربی، کل این حوزه را شکل می‌دهد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حرکت ارتودنسی در پریودنشیوم سالم، حتی با استخوان کاهش‌یافته، بی‌خطر است؛ اما همان حرکت در حضور التهاب فعال، تخریب را تسریع می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کار تجربی کلاسیک روی همین پرسش نشان داد نیروی ارتودنسی به‌تنهایی سبب از دست رفتن اتصال نمی‌شود، اما در حضور پلاک و التهاب، از دست رفتن اتصال به‌شدت شتاب می‌گیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس قاعده مطلق این است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از آغاز ارتودنسی، بیماری پریودنتال باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاملاً کنترل و پایدار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شده باشد. این یک ترجیح نیست؛ نقض آن خطر از دست رفتن سریع اتصال را به‌شدت بالا می‌برد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در طول درمان ارتودنسی نیز:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " براکت‌ها و سیم‌ها، بهداشت را دشوار می‌کنند و تجمع پلاک را افزایش می‌دهند. بیمار پریودنتال تحت ارتودنسی به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برنامه پایش فشرده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — معمولاً هر سه ماه یا کوتاه‌تر — نیاز دارد."
                }
              ]
            }
          ]
        }
      ],
