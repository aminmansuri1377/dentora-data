      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بایومیمتیک نزنی، مال‌پرکتیس است؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای دندانی اینله، آنله یا اورلی در نظر گرفته‌ای."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر پروتکل‌های پیچیده و حساس به تکنیک بایومیمتیک را اجرا نکنی و یک رویکرد ادهزیو استاندارد و باکیفیت به کار ببری، کوتاهی کرده‌ای؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فکت‌های علمی"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در یک مرور سیستماتیک و متاآنالیز، بقای رستوریشن‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پارسیل‌کاوریج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (اینله، آنله و اورلی) در یک بازه‌ی ده‌ساله ۹۱ درصد ارزیابی شده است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این آمار متعلق به رستوریشن‌هایی است که در فاصله‌ی دهه‌ی ۱۹۸۰ تا اواخر دهه‌ی ۲۰۰۰ میلادی کار شده‌اند؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یعنی دورانی که از مواد، سرامیک‌ها و سمان‌های نسل‌های گذشته استفاده می‌شد؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مفاهیم و پروتکل‌های پیچیده‌ی بایومیمتیک هنوز به‌شکل امروزی رایج نبودند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علت اصلی شکست‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شکستگی و چیپینگ: حدود ۴ درصد؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عوارض اندودنتیک: حدود ۳ درصد."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
