                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از دست رفتن اولیه‌ی بافت سطحی: کاهش براقیت، سطح کدر یا ظاهر شیشه‌ی مات ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "frosted glass"
