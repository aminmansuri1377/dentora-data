      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مرز نامرئی عاج سالم و پوسیده را رنگی کن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کف حفره ظاهر یکدستی دارد و با چشم نمی‌شود گفت عاج پوسیده تا کجاست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای ساختن PSZ و رسیدن به CRE به چه ابزاری تکیه می‌کنی و آن را چطور به کار می‌بری؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کریز دیتکتور دای (CDD) چیست؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محلولی رنگی، معمولاً قرمز یا سبز، برای تشخیص پوسیدگی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کلاژن دناتوره‌شده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در عاج پوسیده می‌چسبد و آن را رنگ می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمک می‌کند بین عاج سالم و پوسیده تمایز بگذاری."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا مهم است؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تشخیص دقیق پوسیدگی، به‌خصوص در مراحل اولیه و پوسیدگی‌های پنهان؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفظ ساختار سالم دندان با حذف کامل پوسیدگی بدون آسیب به بافت سالم؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایجاد PSZ با اطمینان از حذف کامل پوسیدگی از این ناحیه؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعیین CRE با کمک پروب پریودنتال برای جلوگیری از آسیب به پالپ."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نحوه‌ی استفاده"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفره را تمیز و خشک کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک قطره CDD را با میکروبراش روی ناحیه‌ی پوسیدگی بمال."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بگذار "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۰ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " روی دندان بماند تا کامل نفوذ کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان را کامل با آب بشوی و با دقت خشک کن."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
