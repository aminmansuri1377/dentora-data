                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "صورتی کم‌رنگ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پوسیدگی خفیف‌تر و عاج پوسیده‌ی داخلی."
