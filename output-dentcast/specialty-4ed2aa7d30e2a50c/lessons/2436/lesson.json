                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "محل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آن حذف کن و در صورت نیاز مراحل را تکرار کن تا به CRE برسی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کجا چه رنگی مجاز است؟"
