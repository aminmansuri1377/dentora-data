                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حق با او نیست، چون شواهد نشان داده رابردم بقای لمینیت را کم می‌کند و بهتر است در مرحله‌ی سمان کردن لمینیت کاملاً کنار گذاشته شود"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
