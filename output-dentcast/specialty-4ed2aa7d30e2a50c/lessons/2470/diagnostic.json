        {
          "tag": "text",
          "text": "همکارت می‌گوید: «آب و اتانول سایلان هم در باند نقش دارند؛ برای همین سایلان را خشک نمی‌کنم و مستقیم سمان می‌زنم.» اشتباه این برداشت چیست؟"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۱"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباهش فقط این است که باید با هوای سرد خشک کند"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۲"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباهی ندارد؛ حلال‌ها واکنش سیلان را کامل می‌کنند"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۳"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آب و اتانول در باندینگ نقشی ندارند؛ هوای گرم آن‌ها را تبخیر و واکنش سیلان با پرسلن را تسریع می‌کند"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۴"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباهش این است که به‌جای خشک کردن باید سطح را با آب پرفشار بشوید تا اتانول برود و آب باقی بماند، چون آب برای هیدرولیز سیلان روی پرسلن لازم است"
                }
              ]
            }
          ]
        }
