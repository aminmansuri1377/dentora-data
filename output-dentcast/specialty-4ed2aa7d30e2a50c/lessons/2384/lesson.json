                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Resin Infiltration"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ") روشی کم‌تهاجمی‌تر و مؤثرتر برای درمان لکه‌های سفید مینایی است و جایگزینی کم‌تهاجمی برای ونیرها."
