                    },
                    {
                      "tag": "text",
                      "text": " تماسی روی پرمولرها، لترال‌ها و سانترال‌ها نباید باشد و تداخل‌ها اصلاح می‌شوند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "وورکینگ، گروپ فانکشن خلفی:"
