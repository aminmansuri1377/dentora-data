                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "طراحی نادرست کانتور دیستال لترال:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برجستگی یا over-contour در این ناحیه به‌عنوان نقطه‌ی تماس زودرس عمل می‌کند و نیرو را مستقیماً به لبه‌ی سرامیک می‌رساند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیامد، وارد شدن نیرو به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لبه‌ی نازک سرامیک"
