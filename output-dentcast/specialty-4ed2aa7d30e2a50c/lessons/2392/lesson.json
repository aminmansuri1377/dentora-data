                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سمت نان‌وورکینگ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هیچ تماسی، نه روی دندان و نه روی سرامیک، قابل قبول نیست."
