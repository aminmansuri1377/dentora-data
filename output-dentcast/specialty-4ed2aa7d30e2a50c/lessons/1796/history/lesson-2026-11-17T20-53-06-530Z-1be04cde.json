                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/ad7e26c8822d867423374f602e8b95df80245224662b8fb3cad9ccc168cdc041.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رادیوگرافی سمت چپ فک پایین: روکش‌های تازه‌ی متصل و درگیری فورکای دندان ۶ "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(DentCast — Dr. Fouad Shahabian)"
