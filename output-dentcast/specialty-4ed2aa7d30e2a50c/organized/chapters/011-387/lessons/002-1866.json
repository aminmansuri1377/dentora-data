                    {
                      "tag": "text",
                      "text": " محصول "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Panavia V5"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " که دوال‌کیور و آزادکننده‌ی فلوراید است، رنگ پایدار دارد و برای ونیرها مناسب است."
                    }
                  ]
                }
              ]
            },
