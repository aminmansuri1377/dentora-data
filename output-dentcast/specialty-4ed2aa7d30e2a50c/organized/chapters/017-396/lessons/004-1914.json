  "steps": [
    {
      "id": "theory:8266c801c80a6573e80e7f4b0475edd49c049b76157504fa139b680d71f286b6",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "fbbae644caeb89e017e6a65ab3ed77b538ccdb8dc390d7b7b9b2713576d70176",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو مرحله یا یک مرحله؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پترن رزینی پست را داخل کانال ساخته‌ای و رزین هنوز کاملاً ست نشده است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قاعده‌ای که بین متخصص‌های پروتز زیاد تکرار می‌شود می‌گوید دست نگه دار. باید صبر کنی؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قاعده‌ی رایج: دومرحله‌ای"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اول پترن پست را داخل کانال بساز، صبر کن تا رزین کاملاً ست شود، و تازه بعد از آن کور را اضافه کن و فرم بده. دلیلش: وقتی هم‌زمان روی هر دو کار می‌کنی، چون رزین داخل ریشه هنوز کاملاً ست نشده، فشاری که برای شکل دادن به کور می‌آوری منتقل می‌شود و در پست "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«عدم تطابق»"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "misfit"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ایجاد می‌کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رویکرد درست اینجا: یک‌مرحله‌ای"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پست و کور از همان ابتدا یک‌مرحله‌ای ساخته می‌شود، با آگاهی کامل از دلیل و نتیجه‌اش. آنچه اسمش را «عدم تطابق» می‌گذارند، نه‌تنها نقطه‌ضعف نیست، بلکه در رسیدن به هدف نهایی درمان کمک می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:b2336a27c1dde93705e680b9d3ac9b1e7d6383c24453c23bdbe3911b9a002596",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "a6553d3f0580724210c22209fabd10e09ff45bdf17d6ddf2037bbb48bef62c2f",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پست پسیو، نه اکتیو"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هدف طراحی پست"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در طراحی پست برای دندان اندو شده، پستی که «اکتیو» باشد به هیچ وجه مطلوب نیست. پست باید کاملاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«پسیو»"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بنشیند تا استرس‌های وارد به ریشه را کنترل کند و خطر فرکچر را به حداقل برساند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پست پسیو:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بدون فشردن خودش داخل کانال می‌نشیند و اجازه می‌دهد استرس وارد به ریشه کنترل و توزیع شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پست اکتیو:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " با فشردن دیواره‌های کانال، خودش منبع استرس اضافه و افزایش خطر فرکچر ریشه می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا عدم فیت اینجا مزیت است"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جابجایی ظریف و عدم تطابقی که فشار فرم‌دهی کور در روش یک‌مرحله‌ای در پترن رزینی ایجاد می‌کند، دقیقاً همان چیزی است که باعث می‌شود پست ریختگی نهایی کمی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آزادتر و پسیوتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " داخل کانال بنشیند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اگر رسیدن به فیت صددرصدی و بدون گپ در کانال به قیمت پست اکتیو و اعمال استرس به ریشه تمام شود، این دقت تکنیکی در تضاد با سلامت دندان است. سلامت درازمدت ریشه با نشستن آرام و کنترل استرس‌ها تأمین می‌شود، نه با یک درگیری سفت و سخت مکانیکی."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
