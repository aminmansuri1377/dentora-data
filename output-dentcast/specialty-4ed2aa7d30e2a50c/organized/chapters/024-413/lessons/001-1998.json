      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آبسه‌ای که بعد از جراحی برگشت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار جوانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با یک ایمپلنت در دندان یکِ سمت چپ آمده و قرار است درمان زیبایی ناحیه‌ی قدامی انجام شود. روکش ایمپلنت از نظر زیبایی مشکل دارد و تصمیم به تعویضش گرفته شده، اما آبسه در ناحیه‌ی ایمپلنت مسیر درمان را پیچیده کرده است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/dcst-insight-insight9_1.webp",
                  "alt": "رادیوگرافی ایمپلنت ناحیه‌ی قدامی هنگام تریس مسیر آبسه",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/a18048c116385c6d8de3dd962483fdec8dd4d9bd7f396a55cb851ded5f95aed1.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رادیوگرافی ایمپلنت ناحیه‌ی قدامی هنگام تریس مسیر آبسه "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(DentCast — Dr. Fouad Shahabian)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آنچه تا اینجا انجام شده"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جراح اولیه ناحیه‌ی ایمپلنت را باز کرد، ناحیه را تمیز کرد و پودر استخوان گذاشت؛ اما آبسه برگشت."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از دید جراح، درمان قطعی خارج‌کردن ایمپلنت بود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی هیچ جراحی حاضر نبود در بیمار جوان و ناحیه‌ای کاملاً زیبایی، ریسک آسیب به تابل باکال را بپذیرد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تریس مسیر آبسه"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "با تریس مسیر آبسه مشخص شد منشأ آبسه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانکشن ایمپلنت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ نه استخوان و نه فیکسچر. بنابراین نیازی به خارج‌سازی ایمپلنت نبود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "سؤال بعدی این است: چرا کانکشن منشأ آبسه است؟"
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
