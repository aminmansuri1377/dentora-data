  "steps": [
    {
      "id": "theory:17476e7665d9f4075bf82e92e842928a2c99ad55ad67efeb7f1d17299a92b070",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6621ea56a9dc831244478e4550cf6e08036100dea328919d287db641f4b97f2b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فشار عضله، حتی بدون تماس دندان"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو سؤال رایج: آیا bruxism یک بیماری است؟ و آیا یک عدد ثابت می‌تواند مرز سالم و بیمار را معین کند؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کنسنسوس بین‌المللی ۲۰۱۸ که برای به‌روزرسانی تعریف ۲۰۱۳ برگزار شد، مستقیماً به همین دو سؤال مربوط است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این کنسنسوس چیست"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Commentary"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است، نه پژوهش آزمایشگاهی تازه؛ جمع‌بندی توافق گروهی از متخصصان برجسته‌ی حوزه‌ی bruxism که حتی روی عنوانش احتیاط کرده: «گزارش یک کار در حال انجام» ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "a work in progress"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ")؛ یعنی حرف آخر نیست، یک توافق میانی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعریف ساده‌ی ۲۰۱۳ به‌خوبی جا افتاد، اما دو گیر داشت: دو اصطلاح bracing و thrusting که مبهم مانده بودند، و سیستم نمره‌دهی‌ای که سرش اختلاف‌نظر بود. برای حل این دو گیر، در سال ۲۰۱۷ جلسه‌ای بین‌المللی در سان‌فرانسیسکو برگزار شد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چهار اصطلاح پایه"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "با نیاز به تماس دندانی:"
                        }
                      ]
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Clenching"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یعنی فشردن دندان‌ها روی هم، و "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Grinding"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یعنی سابیدن دندان‌ها به هم."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بدون نیاز به تماس دندان‌ها:"
                        }
                      ]
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Bracing"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یعنی نگه‌داشتن فک، با فشار، در یک حالت ثابت؛ عضلات منقبض و فک قفل است، بی‌آنکه دندان‌ها لزوماً به هم برسند. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Thrusting"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یعنی حرکت‌دادن فک، با فشار، به جلو یا طرفین؛ باز هم بدون نیاز به برخورد دندان‌ها."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پیام این چهار اصطلاح کنار هم: bruxism در اصل یک فعالیت عضلانی است، نه صرفاً یک اتفاق روی سطح دندان. عضله می‌تواند بی‌آنکه دندان‌ها اصلاً به هم بخورند در حال فعالیت بیش از حد باشد؛ هماهنگ با این دیدگاه که bruxism از مغز فرمان می‌گیرد (مرکزی)، نه از نحوه‌ی چیدمان دندان‌ها (محیطی)."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:2b731aaf8ab904cec03148ba5277b7e97c90f3eccc5a0b41d44f92b0cd5bc8c5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "f8d60b7610470760855d4c65e4f7b601d742bc9156785a48372741724e2b4693",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو تعریف، و رفتار به‌جای بیماری"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو تعریف به‌جای یک"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "span",
                          "attributes": {
                            "dir": "ltr"
                          },
                          "children": [
                            {
                              "tag": "text",
                              "text": "Sleep bruxism"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": ":"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فعالیت عضلات جویدن حین خواب، که می‌تواند منظم ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "rhythmic"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ") یا نامنظم ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "non-rhythmic"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ") باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "span",
                          "attributes": {
                            "dir": "ltr"
                          },
                          "children": [
                            {
                              "tag": "text",
                              "text": "Awake bruxism"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": ":"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فعالیت عضلات جویدن حین بیداری، به شکل تماس مکرر یا طولانی دندان‌ها، یا bracing و thrusting."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو نکته در این تعریف‌ها عمدی است. هر دو با «فعالیت عضلانی» شروع می‌شوند تا تأکید کنند منشأ مشکل عضله است، نه دندان. و هر دو با «در افراد سالم» تمام می‌شوند، چون در بیشتر افراد bruxism بیماری نیست، اما در بعضی افراد نشانه‌ی یک مشکل واقعی است، مثل وقفه‌ی تنفسی خواب ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "sleep apnea"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ") یا صرع، که باید جدی گرفته شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیماری است یا رفتار؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرق هست بین چیزی که خودش ذاتاً آسیب می‌زند (بیماری، "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "disorder"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ") و چیزی که فقط احتمال آسیب را بالا می‌برد، بی‌آنکه تضمینش کند (عامل خطر، "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "risk factor"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ")."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نتیجه‌ی گروه: در فرد سالم bruxism بیماری نیست؛ یا یک عامل خطر است، یا صرفاً یک رفتار حرکتی با علت‌های چندگانه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "bruxism می‌تواند خطر درد عضلانی، درد مفصل گیجگاهی‌فکی (TMD)، سایش شدید دندان و خراب‌شدن زودرس کارهای پروتزی را بالا ببرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ای که معمولاً نادیده گرفته می‌شود: گاهی bruxism حتی محافظ است؛ در وقفه‌ی تنفسی خواب می‌تواند راه هوایی را باز نگه دارد، و در ریفلاکس معده (GERD) با افزایش بزاق از سایش شیمیایی دندان جلوگیری کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "سه حالت ممکن: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌اثر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (رفتاری بی‌ضرر)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عامل خطر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (مرتبط با پیامد منفی) یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عامل محافظ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (مرتبط با پیامد مثبت)؛ و این‌ها می‌توانند هم‌زمان رخ دهند. یک بیمار می‌تواند هم‌زمان از sleep bruxism هم سایش دندان بگیرد و هم راه هوایی‌اش باز بماند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
