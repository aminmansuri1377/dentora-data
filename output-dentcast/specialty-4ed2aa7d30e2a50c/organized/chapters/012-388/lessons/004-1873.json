                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حجم واقعی تاج بیشتر به چشم می‌آید."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ادراک عرض دندان افزایش می‌یابد."
                    }
                  ]
                }
              ]
