              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی روکش جای درست و position درست ندارد، عملاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیچ ارزیابی‌ای قابل اعتماد نیست"
