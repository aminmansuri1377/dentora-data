                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اینکه با یک اباتمنت زاویه‌دار مسیر اصلاح می‌شود و تمام؛ در حالی که زاویه‌ی فیکسچر خودش را در عوارض بعدی نشان می‌دهد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
