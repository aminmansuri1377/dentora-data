      "contentKey": "98c7eeffa1532a6e39d15773f88c0153c605d7ae746a8faaa69706b0a2586605",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سیستمی که بدن از آن محافظت نمی‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نتایج یک مقاله را می‌خوانی که ایمپلنت و دندان را با عدد و درصد کنار هم گذاشته است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از نگاه کردن به عددها، چه سؤالی باید بپرسی؟ پاسخ از ماهیت خود ایمپلنت شروع می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ایمپلنت، سیستمی بدون حمایت بیولوژیک"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدن از ایمپلنت مثل دندان محافظت نمی‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به همین دلیل، اگر قرار است در بلندمدت پایدار بماند، باید از ابتدا به‌صورت یک سیستم خودمحافظ (self-defensive) درمان شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "طراحی خودمحافظ یعنی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جراحی با هدف "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حفظ استخوان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، نه صرفاً جایگذاری ایمپلنت؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "طراحی پروتزی که "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بار، میکروحرکت و التهاب"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را کنترل کند؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و تصمیم‌گیری‌ای که بداند ایمپلنت "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حاشیه‌ی خطا ندارد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پایداری بلندمدت ایمپلنت از بیرون نمی‌آید؛ باید در خود درمان تعبیه شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
