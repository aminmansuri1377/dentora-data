                          "tag": "text",
                          "text": "انامل:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بقا ۹۹٪ · موفقیت ۹۹٪ (محدوده‌ی هر دو ۹۸ تا ۱۰۰)"
                    }
