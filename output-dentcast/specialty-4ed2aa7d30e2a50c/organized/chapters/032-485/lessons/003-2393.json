                      "tag": "text",
                      "text": " بقا ۹۵٪ · موفقیت ۹۵٪ (۹۱ تا ۱۰۰ و ۹۰ تا ۹۹)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
