  "steps": [
    {
      "id": "theory:af8b16ec4759d7cd88e043178f6e7d16429116007334721c220d888a17c58ef7",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "bdb60f0dbc1a1b63cbf6885dd85a474832d18621718f1310f7f7774b8a7c9581",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "حفظ انامل و طرح preparation"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندانی با ترمیم کامپوزیت بزرگ یا اکسپوژر قابل‌توجه دنتین قرار است ونیر سرامیکی بگیرد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از تراش و باند، کدام تصمیم‌ها سرنوشت ونیر را تعیین می‌کنند؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حفظ انامل مهم‌ترین متغیر است"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انامل مطلوب‌ترین بستر برای adhesion ونیر است؛ حفظ انامل هنگام preparation و قرار گرفتن مارژین‌ها روی انامل برای موفقیت بلندمدت اهمیت دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رویکردهای محافظه‌کارانه، از جمله تکنیک‌های non-preparation و ونیرهای با ضخامت حداکثر حدود ۰/۲ میلی‌متر، به حفظ انامل کمک می‌کنند. ساخت چنین ونیرهای فوق‌نازکی با تکنیک‌های دستی، heat-press و CAD-CAM دشوار بوده و "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "3D printing"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌تواند یک راهکار بالقوه باشد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روی کامپوزیت قدیمی محتاط‌تر باش"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ونیرهای باندشده به ترمیم‌های کامپوزیتی موجود، نسبت به ساختار دندان، عوارض بیشتری نشان دادند. conditioning و bonding protocol مناسب و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "silica-coating"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کامپوزیت موجود می‌تواند نتایج را بهتر کند، هرچند نتایج همچنان از باند به ساختار دندان ضعیف‌تر بود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گسترش پالاتال، نه palatal chamfer"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در دندان‌هایی با ترمیم کامپوزیت بزرگ یا اکسپوژر قابل‌توجه دنتین، preparation در صورت نیاز به سمت پالاتال گسترش پیدا کند تا سطح بیشتری از باند روی انامل بیفتد و سطح اتصال زیاد شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "palatal chamfer"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بدون اندیکاسیون مشخص پرهیز کن: محافظه‌کارانه نیست و در مقایسه با shoulder، marginal discrepancy بیشتری نشان داده است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ناحیه‌ی سرویکال حساس‌ترین نقطه است"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مایکرولیکیج و تغییر رنگ مارژین بیشتر در سرویکال دیده شدند؛ به دلیل کاهش ضخامت انامل در این ناحیه و احتمال بیشتر قرار گرفتن مارژین روی دنتین. مارژین‌های پروگزیمال که پنهان بودند، عموماً بدون تغییر رنگ گزارش شدند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:fd48782e1f98276ca7c5c36064a5ac3f9d4dae67d7512163d38e1e4c8098ab5f",
      "sourceId": null,
