  "steps": [
    {
      "id": "theory:0b2da5339ded037a7f2750f22ff4758b6691b54f716d4f4c4f544ba0a6595165",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "31dab137c2a20e929232c3ae710ce1b9dbbc23fd3742b7f62c5dd1c3f729723d",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کراون زیرکونیا روی تراشی با گیر خوب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کراون زیرکونیا آماده‌ی سمان است و تراش دندان گیر خوب و کافی دارد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌توانی مثل بقیه‌ی سرامیک‌ها با HF اچش کنی؟ اصلاً لازم است سراغ باندینگ بروی؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "زیرکونیا در برابر اچینگ مقاوم است"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "زیرکونیا در برابر اسید هیدروفلوئوریک (HF) مقاوم است؛ پس روش‌های باندینگ سرامیک همراه با اچینگ اسیدی، که برای بقیه‌ی سرامیک‌ها به کار می‌رود، برای زیرکونیا قابل استفاده نیست."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سمان کردن کانونشنال"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر آماده‌سازی دندان گیر خوب و کافی داشته باشد، همیشه لازم نیست سراغ باندینگ بروی؛ می‌توانی از سمان‌های معمولی مثل گلاس آینومر یا گلاس آینومر رزین‌مدیفاید استفاده کنی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "توصیه شده که حتی برای سمان کردن معمولی هم، زیرکونیا را قبلش سندبلاست کنی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "احتیاط در سندبلاست"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چه برای سیلیکا کوتینگ و چه برای سمان کردن معمولی: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار کم، ذرات کوچک (مثلاً ۵۰ میکرون) و مدت کوتاه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". سندبلاست طولانی با ذرات ۵۰ میکرون می‌تواند به زیرکونیا آسیب بزند و خواص فیزیکی‌اش را کم کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:7d9ef94e62bbf397fa1940d2b3532eb29ddf7ce34835d6ac843597926abffc2a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "412ed675eeeee9e63f503e45f8c0d65ff1027cfc3406503313751dc591502c67",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "وقتی باند لازم است: سیلیکا کوتینگ و MDP"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سیلیکا کوتینگ"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یکی از روش‌های خیلی مؤثر برای باندینگ زیرکونیا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باز هم سندبلاست می‌کنی، اما به‌جای ذرات سندبلاست معمولی با ذرات آلومینیوم اکساید پوشیده‌شده با سیلیکا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بعد از سیلیکا کوتینگ سایلان را اعمال می‌کنی و فرایند باندینگ عادی را ادامه می‌دهی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای باندینگ به سطوح فلزی و کامپوزیت هم به کار می‌رود، چون سطح را زبر می‌کند و گروه‌های هیدروکسیل را برای باند سایلان زیاد می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرسلن‌های فلدسپاتیک به سیلیکا کوتینگ نیاز ندارند، چون خودشان به اندازه‌ی کافی گروه‌های Si-OH و هیدروکسیل آزاد دارند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پرایمرهای حاوی مونومرهای فسفاتی (مثل MDP)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این مونومرها مستقیماً به زیرکونیا باند می‌شوند و قدرت باند را افزایش می‌دهند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "روش:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یک لایه اعمال کن و با هوای ملایم حلالش را تبخیر کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "توصیه می‌شود قبل از استفاده از پرایمر زیرکونیا، زیرکونیا را سندبلاست کنی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جایگزین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اگر به پرایمر مخصوص زیرکونیا دسترسی نداری، از باندینگ ایجنت‌های یونیورسال که MDP دارند استفاده کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اخطار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هرگز سطح زیرکونیا را با اسید فسفریک تمیز نکن؛ این کار باند شیمیایی حاصل از مونومرهای فسفاتی مانند MDP را مختل می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
