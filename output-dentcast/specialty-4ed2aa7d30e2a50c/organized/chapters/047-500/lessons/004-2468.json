    {
      "id": "theory:0eafc4a818bc48ea00df81f9f44cccf57ae085e05a3ea1c7219c98e89a037604",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "04bb4f9703aa4115fc42e80234e0471330044b9b4612c58e4f065e4abb1c17fc",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رستوریشن اچ و سایلان‌زده در Try-in آلوده شد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رستوریشن گلاس سرامیکی که قبلاً با اسید هیدروفلوئوریک اچ و سایلان‌زده شده، در Try-in آلوده شده است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چطور مطمئن شوی باندینگ به خطر نمی‌افتد؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آلودگی از کجا می‌آید؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بزاق، خون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ذرات سیلیکون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در مرحله‌ی Try-in (قرار دادن موقت رستوریشن در دهان بیمار برای بررسی)، به‌ویژه وقتی مواد قالب‌گیری سیلیکونی به کار رفته باشد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیشگیری"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هنگام try-in از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رابردم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " استفاده کن؛ احتمال آلودگی با خون و بزاق کم می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از try-in، رستوریشن را به‌طور کامل با آب فراوان بشوی تا هر بزاق یا خون چسبیده به آن از بین برود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پروتکل پاکسازی به دو عامل بستگی دارد"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نوع سرامیک:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سرامیک‌های مختلف پروتکل پاکسازی متفاوتی می‌خواهند؛ مثلاً زیرکونیا نباید با اسید فسفریک تمیز شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نوع آلودگی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " روش پاکسازی برای بزاق و خون با ذرات سیلیکون فرق دارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نگهداری رستوریشن آماده‌شده"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در معرض نور مستقیم خورشید قرار نگیرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در محیط پرگردوغبار نگهداری نشود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سطح باندینگ با دستکش لاتکس لمس نشود؛ این سطوح بسیار مستعد آلودگی‌اند و قدرت باند کم می‌شود."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:9f6c05b3297a7cb40aa23612e0135915ef24b883b7a29556a56d49a7851cc66c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "c69badab74fddd11d12b15fc21f036660c0b031f0ba17f728ff611763fa4de8b",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پاکسازی بر اساس نوع آلودگی، و سایلان دوباره"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آلودگی با بزاق یا خون"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سطح با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اسید فسفریک ۳۵ تا ۳۷٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " به مدت ۳۰ تا ۶۰ ثانیه پاکسازی شود؛ یا با خمیرهای پاک‌کننده مانند IvoClean به مدت ۲۰ ثانیه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بعد ۳۰ ثانیه شستشو با آب پرفشار و سپس خشک کردن با هوا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "توجیه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پروتئین‌های بزاق یا خون با اسید فسفریک پاک و منعقد می‌شوند و سپس با شستشو با آب از بین می‌روند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آلودگی سیلیکون"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سطح مجدداً با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اسید هیدروفلوئوریک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اچ شود؛ زمان به نوع سرامیک بستگی دارد: معمولاً ۲۰ تا ۶۰ ثانیه، و برای سرامیک‌های فلدسپاتیک تا ۹۰ ثانیه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بعد ۳۰ ثانیه شستشو و سپس خشک کردن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "توجیه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بقایای سیلیکون روی گلاس سرامیک‌ها بسیار پایدارند و تنها با اچینگ اسید هیدروفلوئوریک به‌طور مؤثر حذف می‌شوند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اعمال مجدد سایلان"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از پاکسازی، سایلان را با میکروبرس روی سطح باندینگ بزن، ۶۰ ثانیه باقی بماند، سپس با هوا خشک کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پس از اسید فسفریک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (بزاق/خون): اعمال مجدد سیلان قدرت باند سمان‌های رزینی را افزایش می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پس از اچ مجدد HF"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (سیلیکون): لایه‌ی سیلان قبلی از بین می‌رود، پس اعمال مجدد سیلان الزامی است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی سطح کاملاً آماده شد، پروتکل استاندارد سمان کردن به بهترین نحو انجام می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
