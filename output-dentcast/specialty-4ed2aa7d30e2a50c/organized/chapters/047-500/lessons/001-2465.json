            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رسوب سفید به‌جامانده نشانه‌ی over-etching است، نه نشانه‌ی اچ خوب."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این رسوب شامل نمک‌های فلزی حاصل از واکنش HF است و اگر تمیز نشود، قدرت باند را کاهش می‌دهد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تمیز کردن رسوب سفید"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آب به‌تنهایی کافی نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "می‌توان از استون یا الکل با برس استفاده کرد."
