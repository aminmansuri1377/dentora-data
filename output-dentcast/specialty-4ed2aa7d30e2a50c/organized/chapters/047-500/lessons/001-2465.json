                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هشدار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اور-اچینگ باعث تضعیف پرسلن و کاهش قدرت باند می‌شود."
