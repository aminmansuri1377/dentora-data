  "steps": [
    {
      "id": "theory:4aed32a9b1f701911906f057df9e69c4fd2344ad1b7f76b1b9faaf4b305c4a0b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "ec76d303e462c7fad0a31169e3755182983800a86a7122528fa703f21847a01d",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تراش انله تمام شد و عاج اکسپوز است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "دندان را برای انله تراش داده‌ای و سطح عاج اکسپوز شده است. همین حالا قالب بگیری و دندان را با موقت به جلسه‌ی بعد بفرستی، یا اول کاری روی این عاج تازه انجام دهی؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ایده‌ی IDS"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بلافاصله بعد از تراش دندان برای رستوریشن غیرمستقیم (مثل ونیر، اینله، انله)، سطح عاج اکسپوزشده پیش از قالب‌گیری با باندینگ سیل می‌شود. IDS قبل از قالب‌گیری توصیه می‌شود، چون مزایای بیشتری دارد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا IDS؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افزایش چشمگیر قدرت باند"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاهش لیکیج و نشتی باکتریایی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاهش حساسیت دندان و راحتی بیشتر بیمار"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بقای بهتر رستوریشن در درازمدت"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی مهم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دنتین تازه‌تراش‌خورده بهترین سطح برای باندینگ است و IDS از آلودگی آن در مرحله‌ی تمپوراری (با سمان موقت، بزاق و…) جلوگیری می‌کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مراحل کلینیکی (تکنیک Total-Etch)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شناسایی دنتین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اچ کوتاه (۲ تا ۳ ثانیه)، شستشو و خشک کردن تا مینای اچ‌شده مشخص شود؛ سپس سطح دنتین دوباره تازه (Re-freshen) شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اچ دنتین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " با اسید فسفریک، ۵ تا ۱۵ ثانیه، بلافاصله پس از تراش؛ سپس شستشوی کامل و دقیق."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خشک کردن (بسیار مهم):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آب اضافه با ساکشن گرفته شود و از باد هوا استفاده نشود. نه خیلی خشک (کلاپس کلاژن)، نه خیلی مرطوب (باند ضعیف)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "باندینگ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پرایمر (در سیستم ۳ مرحله‌ای) یا ادهزیو Self-priming (در سیستم ۲ مرحله‌ای)؛ سیستم ۳ مرحله‌ای اغلب پایدارتر در نظر گرفته می‌شود. ادهزیو رزین دقیق و فقط روی دنتین زده و لایت‌کیور می‌شود (مثلاً ۲۰ ثانیه)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لایه‌ی گلیسرین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای مهار اکسیژن زده می‌شود و سپس کیور نهایی (مثلاً ۱۰ ثانیه)."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a320c3c0d6477fa0c2222c50a377f053fa1c72c54c851a4f30d410a8a0eaf722",
