  "steps": [
    {
      "id": "theory:1f9991ac90e45455b4b4f6dd3c45633880a4e7543201b5ac5360d5e6b2e9e4fa",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6d2204ce4ba58af5bde5479222792ea906f8638b0194b23266ff39403d1d00ed",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "حساسیت پس از ترمیم؛ ماجرا در کف حفره است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "حفره‌ای را با تکنیک bulk-fill پر کرده‌ای و بیمار از حساسیت پس از ترمیم شکایت دارد؛ همان حساسیت کلاسیکی که معمولاً با ترمیم‌های کامپوزیت دیده می‌شود. در کف حفره چه اتفاقی افتاده، و IDS و رزین کوتینگ چطور جلویش را می‌گیرند؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بلوغ باند و استرس پلیمریزاسیون"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باند عاج برای رسیدن به حداکثر استحکام به زمان نیاز دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر با bulk-fill باند عاجِ در حال تشکیل بلافاصله به مینا وصل شود، مرکز جرم کامپوزیت از باند عاج (که زمان بیشتری برای بلوغ می‌خواهد) دور می‌شود و به سمت باند مینا (که سریع‌تر بالغ می‌شود) می‌رود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "علت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مینا خشک است و عاج مرطوب و انعطاف‌پذیر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نتیجه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " با اتصال زودهنگام این دو بستر بسیار متفاوت، ماده‌ی ترمیمی از لایه‌ی هیبرید در حال تشکیل جدا می‌شود و شکافی در پایه‌ی حفره ایجاد می‌شود؛ این شکاف‌ها می‌توانند به حساسیت پس از ترمیم منجر شوند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سیل فوری عاج (IDS)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تعریف:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " انجام مراحل باندینگ بلافاصله پس از تراش دندان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مراحل:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " معمولاً کاندیشنینگ (با توتال‌اچ یا سلف‌اچ)، پرایمینگ و یک لایه ادهزیو با ضخامت مناسب روی عاج تازه‌تراش‌خورده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مزیت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " باند عاج در محیطی بدون استرس، بدون تأثیر استرس پلیمریزاسیون یا نیروهای C-Factor، به حداکثر استحکام بالقوه‌اش می‌رسد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "IDS اولین لایه‌ی Biobase را تشکیل می‌دهد."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a87c6a1242510d7b31ec744a22097b1fd5d49fb125ba9ab7366b24f8d0d6ce32",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "a8a0cc8ef69191304c9208217fda94013b14f1529bf6ab5c19b7d3b2cca6eee5",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سیستم‌های استاندارد طلایی و رزین کوتینگ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه سیستم استاندارد طلایی برای IDS"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "Optibond FL، Clearfil SE Protect و Clearfil SE Bond. تکنیک استفاده از آن‌ها بسیار متغیر است و درک عمیق مواد دندانی و تعاملشان با بافت‌های سخت دندان ضروری است؛ مثلاً Optibond FL توتال‌اچ است و Clearfil SE Protect سلف‌اچ."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تکنیک Clearfil SE Protect"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مینا و عاج ۲۰ ثانیه پرایم و سپس ۱۰ ثانیه با هوا خشک می‌شوند تا حلال تبخیر شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ادهزیو به‌صورت یک لایه‌ی یکنواخت زده می‌شود و اضافه‌اش با یک میکروبراش تمیز و خشک برداشته می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لایه‌ی ادهزیو برای جلوگیری از مهار بیشتر، هوا خشک نمی‌شود و ۲۰ ثانیه کیور می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لایه‌ی ادهزیو SE Protect نازک‌تر از Optibond FL است؛ پس با آن یک لایه رزین کوتینگ (RC) توصیه می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "استحکام باند"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیستم‌های استاندارد طلایی می‌توانند به استحکام باند نزدیک به DEJ (حدود ۵۰ مگاپاسکال) برسند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پتانسیل استحکام باند به عاج بیشتر از مینا است: با تکنیک صحیح، عاج سطحی بدون پوسیدگی دو برابر مینا پتانسیل استحکام باند دارد؛ این به سلسله‌مراتب قابلیت باند (HOB) برمی‌گردد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رزین کوتینگ (RC)"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قرار دادن ۰٫۵ میلی‌متر کامپوزیت میکروفیلد و فلو روی لایه‌ی IDS. مزایا:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاهش ضخامت لایه‌ی مهارشده با اکسیژن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زمان بیشتر برای توسعه‌ی باند عاج و بلوغ لایه‌ی هیبرید"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جلوگیری از ترانسودا (حرکت مایع پالپ) از طریق لایه‌ی IDS"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تشکیل بخشی از Biobase"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی ترمیم روی لایه‌ای از IDS و RC که به‌طور بهینه انجام شده قرار بگیرد، استحکام باند به عاج "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چسبنده (cohesive)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
