          "children": [
            {
              "tag": "text",
              "text": "نسل‌ها، یونیورسال‌ها و Selective Etch"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نسل ۴ و ۵: سیستم‌های توتال‌اچ"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نسل ۴:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سیستم دوبطری با پرایمر و ادهزیو جداگانه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نسل ۵:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سیستم تک‌بطری با پرایمر و ادهزیو ترکیب‌شده."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکات بالینی نسل ۵:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اچ مینا ۳۰ ثانیه؛ اچ عاج ۱۰ تا ۱۵ ثانیه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خشک کردن ملایم عاج و خشک نکردن بیش از حد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر عاج بیش از حد خشک شد، کلرهگزیدین ۲٪ به‌مدت ۳۰ ثانیه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اعمال بیش از یک لایه باندینگ توصیه می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نسل ۶ و ۷: سیستم‌های سلف‌اچ"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نسل ۶:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سیستم دوبطری با پرایمر و ادهزیو جداگانه یا ترکیب‌شده، با حلال آب و مناسب عاج."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نسل ۷:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سیستم تک‌بطری با پرایمر و ادهزیو ترکیب‌شده."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ادهزیوهای یونیورسال"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به نسل خاصی وابسته نیستند و با هر دو تکنیک توتال‌اچ و سلف‌اچ قابل استفاده‌اند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش Selective Etch"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در حفراتی که هم مینا و هم عاج دارند، مارجین‌های مینایی ۳۰ ثانیه اچ می‌شوند و سپس ادهزیو سلف‌اچ به کل حفره اعمال می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "سلف‌اچ عاج را از کلاپس کلاژن در امان نگه می‌دارد ولی ممکن است مینا را خوب اچ نکند؛ اچ انتخابی مارجین‌های مینایی راه‌حل میانه‌ی همین معامله است."
                }
              ]
            }
          ]
        }
      ],
