  "steps": [
    {
      "id": "theory:d41a77865d7b612f25cd31e91b4121f1fe69e16b2f5f726a4f97b7b16312a13d",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "5439c10782da0a5c4a36d630141ab02408a4e40530890e3fdb3b384e49d28350",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "عاج اچ‌شده را چقدر خشک کنی؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفره را با توتال‌اچ آماده کرده‌ای."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اسید را کاملاً شسته‌ای و حالا پیش از باندینگ باید دندان را خشک کنی. اگر عاج را بیش از حد خشک کنی چه می‌شود، و سلف‌اچ چه فرقی می‌کرد؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش Etch and Rinse یا توتال‌اچ"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک اسید به سطح دندان اعمال می‌شود تا "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لایه‌ی اسمیر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و دبری‌ها را حذف کند و توبول‌های عاجی را باز کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این روش فیبرهای کلاژن عاج زیرین را هم اکسپوز می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از اچ، اسید کاملاً شسته می‌شود و سپس دندان پیش از اعمال باندینگ خشک می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عیب:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " خشک کردن بیش از حد عاج اچ‌شده می‌تواند به کلاپس فیبرهای کلاژن برسد. اگر کلاژن کلاپس کند، رزین باندینگ ممکن است نتواند به‌طور کافی نفوذ کند و نتیجه، باند ضعیف‌تر و افزایش حساسیت پس از درمان است. به همین دلیل عاج نمناک شرط اجرای درست توتال‌اچ است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سلف‌اچ"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرحله‌ی جداگانه‌ی اچ با اسید فسفریک و شست‌وشو حذف می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خود پرایمر حاوی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مونومرهای اسیدی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است که هم‌زمان سطح دندان را اچ و پرایم می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از اعمال پرایمر اسیدی، سطح با هوا خشک می‌شود و سپس رزین باندینگ اعمال می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مزیت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از کلاپس کلاژن مرتبط با عاج اچ‌شده‌ی خشک جلوگیری می‌کند و باندینگ بهتری می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عیب:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ممکن است مینا را به‌طور مؤثر اچ نکند و استحکام باند به مینا را به خطر بیندازد."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:6934aed73e3142ca313ff1fe7b3248ae22d2e4a6f4b58f8093a7888049efb0ad",
