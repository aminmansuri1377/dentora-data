      "contentKey": "b7948e3ca2eb471924a2b7f293498ae8edc3c3345eafe2ee939b230159f49ff9",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "روکشی که در حرکت طرفی تداخل دارد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانین بیمار بلند نیست و تقریباً هم‌ارتفاع کاسپ باکال پره‌مولرهاست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هنگام تنظیم اکلوژن یک روکش، در حرکات طرفی فشار اکلوژن فقط روی پره‌مولر می‌افتد. نوع اکلوژن چیست و کجا را باید تنظیم کرد؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تشخیص نوع اکلوژن"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی کانین بلند نیست و تقریباً هم‌ارتفاع کاسپ باکال پره‌مولرهاست، می‌توان انتظار داشت اکلوژن از نوع "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گروپ فانکشن خلفی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "posterior group function"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ") باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در این نوع اکلوژن، در حرکات سمت کارگر علاوه بر کانین، دندان‌های خلفی‌تر هم درگیر می‌شوند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تداخل سمت کارگر"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روکش در حرکات طرفی تداخل دارد: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شیب پالاتالی کاسپ باکال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پره‌مولر درگیر است و فشار اکلوژن در حرکات طرفی فقط روی پره‌مولر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تداخل سمت کارگر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است؛ تماس‌ها در حرکت طرفی هم‌زمان نیستند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اصلاح: شیب پالاتالی کاسپ باکال پره‌مولر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با احتیاط"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تنظیم می‌شود تا تماس‌ها هم‌زمان شوند. در بازسازی اکلوژن گروپ فانکشن، حواست به تداخل سمت کارگر باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:484344c5470cf31fae0b3e5e5915e7be5b0e5486d7a99db6d4e7cd2aefdaa154",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "dfadfa72357fdbc5909ba7f7c23982653e7ba227a3201981017d1fcb300ffdc3",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رابطه‌ی کانینی کلاس I؛ چرا گاهی بر اصلاح فضا اولویت دارد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در برخی طرح‌های درمان، برای اصلاح فضا باید دندان‌ها جابه‌جا شوند. این جابه‌جایی همیشه فقط یک حرکت مکانیکی برای بستن یا ایجاد فضا نیست؛ می‌تواند روابط اکلوزالی، گایدنس فانکشنال و هماهنگی فکین را تغییر دهد. یکی از روابط کلیدی که ممکن است تغییر کند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رابطه‌ی کانینی کلاس I"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ برای همین ارتودنتیست گاهی برای حفظ عملکرد اکلوزالی مناسب، از جابه‌جایی‌هایی که این رابطه را بر هم می‌زنند اجتناب می‌کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اهمیت و پیامدها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رابطه‌ی کانینی کلاس I نقش مهمی در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هدایت حرکات جانبی فک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و جلوگیری از تداخل‌های اکلوزالی دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبود آن می‌تواند تداخل اکلوزالی با دندان مقابل بسازد: سایش دندانی (Attrition)، لبیالی شدن کانین فک بالا و لینگوالی شدن دندان مقابل در فک پایین."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نشانه‌ای از مشکلات زمینه‌ای"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جت غیرنرمال: افزایش‌یافته در کلاس II، کاهش‌یافته در کلاس III."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدم تطابق میدلاین‌ها ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Midline discrepancy"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ")."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناهماهنگی‌های اسکلتی یا دندانی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "راهنمایی تشخیصی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر اندازه‌ی دندان‌ها نرمال باشد، نبود رابطه‌ی کلاس I می‌تواند ما را به بررسی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آف‌بودن میدلاین‌ها"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هدایت کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر در یک سمت رابطه‌ی کلاس II و در سمت دیگر کلاس I دیده شود، معمولاً میدلاین‌ها هم‌راستا نخواهند بود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اصلاح فضا تنها یک جابه‌جایی ساده‌ی دندانی نیست؛ تصمیمی است که باید در چارچوب عملکرد اکلوزالی، هدایت فانکشنال و تعادل نیروهای فکی ارزیابی شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
