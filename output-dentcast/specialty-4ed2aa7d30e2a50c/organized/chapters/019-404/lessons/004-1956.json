      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پست و کوری که بیرون نمی‌آید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پست و کور تازه ساخته‌شده را امتحان کرده‌ای و حالا بیرون نمی‌آید."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فیت خیلی دقیق است و اصطکاک زیاد؛ نه با سوند درمی‌آید، نه با دست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کشیدن با پنس یا تلاش‌های معمول نتیجه نمی‌دهد و حتی ممکن است باعث آسیب یا تغییر شکل کور شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترفند فرز نیف‌اِج"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/dcst-insight-insight15.webp",
                  "alt": "فرز نیف‌اِج که در بدنه‌ی کور گیر کرده و دسته‌ی کمکی خارج کردن آن شده است",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/7c2f058dbec51a38c74a64e81acf6593839971e6cbbceec6807ca6a2bc45392b.webp"
