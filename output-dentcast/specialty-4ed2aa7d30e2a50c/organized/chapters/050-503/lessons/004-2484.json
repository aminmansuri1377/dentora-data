  "steps": [
    {
      "id": "theory:89233be815077185fb13caf23a259a61e8098fbd4f23325f1beeb068d7778522",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "db636391a8172a4f58f6e635b0ee1b657986be7f782e37e88bced79c5e146885",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ادهزیو نازک، سطح چسبناک"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بایوبیس را با یک سیستم باندینگ با لایه‌ی ادهزیو بسیار نازک، مثل Clearfil SE Protect، می‌سازی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر رزین کوتینگ نگذاری، آیا این لایه‌ی نازک اصلاً درست پلیمریزه می‌شود؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لایه‌ی مهارشده با اکسیژن چیست"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Oxygen-Inhibited Layer (OIL)، که Air Inhibition Layer و Oxygen Inhibition Layer هم نامیده می‌شود، لایه‌ای از رزین است که در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مجاورت با اکسیژن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پلیمریزاسیون کامل در آن رخ نمی‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "علت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اکسیژن با رادیکال‌های آزاد (Free Radicals)، که آغازگر پلیمریزاسیون‌اند، واکنش می‌دهد؛ در نتیجه رادیکال‌ها دیگر نمی‌توانند مونومرها را به الیگومرها و پلیمرها (زنجیره‌های بلندتر) تبدیل کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ضخامت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " معمولاً بین ۱۰ تا ۴۰ میکرون."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "در ادهزیو بسیار نازک، همین ۱۰ تا ۴۰ میکرون می‌تواند سهم بزرگی از کل ضخامت باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a3b751297ff9887f4440ed85fdd96d640ba8eb87ac0bb483969d186044396c7f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ebd4cdf6d9a0ea8c8b5d619bdc4ff07d0a8b1c5e7503c1b31267d2bc1329a15c",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو راه حل، و OIL در بایوبیس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو راه حل"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "افزودن رزین کوتینگ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فراهم کردن رادیکال‌های آزاد بیشتر با افزودن یک لایه Resin Coating."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لایه‌ی گلیسیرین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مسدود کردن اکسیژن و کیورینگ از میان لایه‌ی گلیسیرین. این روش فقط باید برای کیورینگ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لایه‌ی نهایی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " رزین استفاده شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر ترمیم مستقیم در همان جلسه انجام می‌شود، نیازی به کیورینگ لایه‌ی IDS یا RC از میان گلیسیرین نیست، زیرا لایه‌های بعدی رزین رادیکال‌های آزاد لازم را فراهم می‌کنند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "OIL هنگام ایجاد بایوبیس (Biobase)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با سیستم‌های باندینگی که لایه‌ی ادهزیو نازکی دارند، توجه به OIL اهمیت دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Clearfil SE Protect:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " لایه‌ی ادهزیو بسیار نازک‌تری نسبت به Optibond FL دارد. اگر RC استفاده نشود، ممکن است به‌طور قابل توجهی پلیمریزه نشود. با قرار دادن یک لایه RC ضخامت لایه‌ی ادهزیو افزایش می‌یابد تا با اثر OIL در این ناحیه‌ی حیاتی (محل اتصال بایوبیس) مقابله شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Optibond FL:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " لایه‌ی ادهزیو ضخیم‌تری دارد؛ ممکن است یک لایه‌ی اضافی از خود ادهزیو Optibond FL به‌عنوان لایه‌ی RC مناسب باشد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خطر OIL را ضخامت ادهزیو تعیین می‌کند: هرچه ادهزیو نازک‌تر، RC ضروری‌تر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
