      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بایوبیس تمام شد؛ حالا قالب؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراش یک رستوریشن Indirect تمام شده است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باند عاج را همین حالا بزنی یا روز تحویل؟ ضخامت لایه‌های اولیه تا کجا مجاز است؟ و اگر قالب را بلافاصله بعد از ساخت بایوبیس بگیری، چه باید بکنی؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قانون آلمان-دلیپری (Alleman-Deliperi Rule) در مورد بایوبیس"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ضخامت لایه‌های اولیه‌ای که در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵ دقیقه‌ی ابتدایی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به دنتین باند می‌شوند نباید بیش از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱٫۵ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لایه‌های بایوبیس (در ۵ دقیقه‌ی ابتدایی)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مهر و موم فوری عاج (Immediate Dentin Sealing - IDS)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوشش رزین (Resin Coating - RC) به ضخامت ۰٫۵ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کامپوزیت (تقویت‌شده با الیاف) به ضخامت ۱ میلی‌متر"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "سقف ضخامت برای این است که تنش انقباض روی باند نوپای عاجی از حد نگذرد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
