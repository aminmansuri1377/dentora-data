      "contentKey": "338ef057e9674deb22f6cf8e98ebc416f28b8f06668c656536a76ccd82e332fa",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "باند تازه، کامپوزیت بلافاصله؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روی عاج تراش‌خورده IDS زده‌ای و ترمیم مستقیم در همین جلسه ادامه دارد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آیا بلافاصله کامپوزیت و تنش‌هایش را روی این باند تازه بگذاری؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جداسازی با زمان (Decoupling With Time - DWT) چیست"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از لحظه‌ای که IDS انجام می‌شود، باند به عاج شروع به شکل‌گیری می‌کند و لایه‌ی هیبرید شروع به بلوغ می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استحکام باند بلافاصله به حداکثر پتانسیل خود نمی‌رسد؛ برای تکامل به "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زمان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نیاز دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باند عاج پس از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " به "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۹۰٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " استحکام نهایی خود می‌رسد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مراحل بعد از IDS"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از IDS می‌توان لایه‌ی رزین کوتینگ (Resin Coating - RC) را قرار داد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این کار معمولاً با یک پروب پریودنتال انجام می‌شود؛ RC باید یکنواخت و با ضخامت ۰٫۵ میلی‌متر روی عاج و DEJ (محل اتصال عاج و مینا) پخش شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در طول پلیمریزاسیون، لایه‌ی رزین کوتینگ به سمت لایه‌ی هیبرید در حال شکل‌گیری حرکت می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "DWT یعنی همین پنج دقیقه را بخشی رسمی از پروتکل بدانی، نه اینکه باند نوپا را بلافاصله زیر بار بگذاری."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:d13568609a6857641e27bf0041ad7515efbd4515a366a3df7e4efb42599e4365",
      "sourceId": null,
      "identityOrigin": "local-step",
