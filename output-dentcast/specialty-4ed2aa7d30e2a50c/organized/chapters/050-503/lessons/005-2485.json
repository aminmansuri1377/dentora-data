  "steps": [
    {
      "id": "theory:2067d2aec112da73b83b0506d268f1050dae87951d619f5ba9936f0b32599a3a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "502483e3f22c9211730bf7d8912a6a04c557725b79d6a8d00a346a02df3786b6",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "باندینگ زده شد؛ کیور کنی یا نه؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در یک ترمیم رزینی مستقیم، باندینگ را زده‌ای."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آن را جداگانه کیور کنی، یا کامپوزیت را مستقیماً روی باندینگ کیورنشده بگذاری؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این تفاوت ظاهراً ساده می‌تواند بر استحکام اتصال، کنترل رطوبت، حساسیت پس از درمان و حتی سهولت کار بالینی اثر بگذارد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کیور کردن باندینگ قبل از کامپوزیت"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "افزایش استحکام باند:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پلیمریزاسیون کامل باندینگ شبکه‌ی رزینی پایدارتری می‌سازد و اتصال دندان و کامپوزیت را تقویت می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کنترل بهتر رطوبت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " با کیور شدن باند، احتمال نفوذ رطوبت به لایه‌ی اتصال کم می‌شود و ریسک تضعیف باند کمتر می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کاهش حساسیت پس از درمان:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بسته شدن بهتر توبول‌ها و پلیمریزاسیون کامل‌تر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سهولت لایه‌گذاری کامپوزیت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سطح یکنواخت باند کیورشده، کنترل و شکل‌دهی کامپوزیت را ساده‌تر می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محدودیت‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لایه‌ی مهارکننده‌ی اکسیژن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هنگام کیور، لایه‌ای غنی از مونومرهای پلیمریزه‌نشده روی سطح باند ایجاد می‌شود که می‌تواند اتصال شیمیایی بین باند و کامپوزیت را تضعیف کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "افزایش زمان درمان:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یک مرحله‌ی کیور اضافی پروسه را طولانی‌تر می‌کند."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
