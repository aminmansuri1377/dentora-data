      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "محیط را کامل پاک کن: Peripheral Seal Zone"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوسیدگی عمیقی نزدیک پالپ پیش رویت است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر همه‌جا را تا آخر تعقیب کنی، پالپ اکسپوز می‌شود. کجا برداشت پوسیدگی باید کامل باشد و کجا کنترل‌شده و محدود بماند؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "منطق کار این است: برداشت کامل در محیط انجام می‌شود و برداشت در ناحیه‌ی مرکزی نزدیک پالپ، کنترل‌شده و محدود می‌ماند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "Peripheral Seal Zone (PSZ)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پریفرال سیل زون به "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲ تا ۳ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از ساختار خارجی‌تر دندان گفته می‌شود: مینا، DEJ و عاج سطحی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در PSZ برداشت کامل "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پوسیدگی و ترک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ضروری است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از Caries Detector Dye (CDD) یا مواد تشخیص‌دهنده‌ی پوسیدگی استفاده می‌شود تا مطمئن شوی در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱ تا ۲ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " داخل DEJ پوسیدگی وجود ندارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در PSZ می‌توان به استحکام باند "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳۰ تا ۵۰ مگاپاسکال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " رسید."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "PSZ عاری از پوسیدگی، با همین باند بالا، پایه‌ی سیل کل ترمیم است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:7a3604110b95e1c838417b1c69e797cac60f1120b10d72e7fdba8e89994d0212",
