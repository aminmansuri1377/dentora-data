    {
      "id": "question:41236",
      "sourceId": "41236",
      "identityOrigin": "source-question-id",
      "sourceProgress": "width: 57.1429%;",
      "contentKey": "16820a4138614a5322c8d169899ab682005670f46880d87fa814d2b0230b9d88",
      "position": 5,
      "kind": "question",
      "type": "single-choice",
      "prompt": "همکارت می‌گوید: «متاآنالیز جدید نشان داد کامپوزیت خلفی حالا از آمالگام بهتر است.» اشتباه رایج در این جمله کدام است؟",
      "sourceContent": [
        {
          "tag": "div",
          "attributes": {},
          "children": [
