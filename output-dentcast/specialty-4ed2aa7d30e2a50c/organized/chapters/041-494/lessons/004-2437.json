  "steps": [
    {
      "id": "theory:f3fa7ca67d831757ef78a60ecd5711af885e906fa277b51d6aa3ce2576f99236",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "1579afaa3d6c8d47a56a8cb6bcdcd6ea1dea676b6ef39c86225975b80abdd16c",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "یک زبان مشترک برای پوسیدگی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک همکار می‌گوید «پوسیدگی را کامل برداشتم»، دیگری می‌گوید «selective برداشتم» و سومی از «مدیریت پوسیدگی» حرف می‌زند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آیا همه درباره‌ی یک چیز حرف می‌زنند؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گروهی از متخصصان پوسیدگی دندان از سراسر دنیا توصیه‌هایی اجماعی داده‌اند تا اصطلاحات برداشت پوسیدگی و مدیریت ضایعات پوسیدگی بین دندانپزشکان، محققان و دانشجویان یکدست شود و سردرگمی کمتر شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا زبان مشترک مهم است؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نتایج تحقیقات قابل فهم‌تر و قابل استنادتر می‌شوند؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آموزش مفاهیم پوسیدگی به دانشجو ساده‌تر و مؤثرتر می‌شود؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندانپزشکان تجربه و دانششان را راحت‌تر به اشتراک می‌گذارند؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با همفکری، بهترین روش درمان برای هر بیمار انتخاب می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چهار اصطلاح پایه"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Dental Caries:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " خود بیماری پوسیدگی که در اثر عواملی مثل باکتری‌ها، رژیم غذایی و بهداشت دهان ایجاد می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Carious Lesion:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ضایعه‌ای که بیماری پوسیدگی در ساختار دندان (مینا، عاج و در موارد شدیدتر پالپ) ایجاد می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Caries Management:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مدیریت کلی بیماری در سطح بیمار؛ آموزش بهداشت دهان، فلوراید، رژیم غذایی مناسب و تغییر عادت‌های غذایی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Carious Lesion Management:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مدیریت ضایعه در سطح یک دندان خاص؛ روش‌های برداشت پوسیدگی و ترمیم."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "Dental Caries و Carious Lesion نباید به‌جای هم به کار بروند؛ به دو چیز متفاوت اشاره دارند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:17e9ca56da7deadd76e55033c6aef6f51d210530bbbc8252342d473defb735a9",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "e6a3f5af69a32adaea1a88d5beef393983a3ec029a2a735c1fd690c4b03223d1",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "از No Removal تا Nonselective: هر روش تا کجا برمی‌دارد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "No Removal (بدون برداشت)"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هیچ بافت پوسیده‌ای برداشته نمی‌شود؛ ضایعه با روش‌های غیرتهاجمی کنترل و غیرفعال می‌شود:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سیلانت رزینی یا گلاس‌آینومر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ضایعه را از محیط دهان جدا می‌کند تا باکتری‌ها به مواد غذایی دسترسی نداشته باشند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Hall Technique:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مخصوص دندان‌های شیری؛ روکش پیش‌ساخته‌ی فلزی کل دندان و ضایعه را می‌پوشاند و مهر و موم می‌کند تا دندان شیری تا زمان افتادن طبیعی حفظ شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Nonrestorative Cavity Control:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شکل حفره طوری تغییر می‌کند که با مسواک قابل تمیز کردن باشد و تجمع پلاک کم شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "No Removal برای همه‌ی ضایعات مناسب نیست؛ مثلاً در ضایعات عمیقی که به پالپ نزدیک شده‌اند ممکن است مؤثر نباشد و برداشت بافت پوسیده لازم شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش‌های برداشت"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ART:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " با ابزار دستی فقط بافت پوسیده‌ی نرم برداشته و حفره با موادی مثل گلاس‌آینومر پر می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Selective Removal to Soft Dentine:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای ضایعات عمیق، تا عاج نرم، تا به پالپ آسیب نرسد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Selective Removal to Firm Dentine:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای ضایعات سطحی‌تر، تا عاج سفت (Leathery)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Stepwise Removal:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دو مرحله؛ مرحله‌ی ۱ تا عاج نرم و ترمیم موقت، مرحله‌ی ۲ شش تا دوازده ماه بعد، برداشت تا عاج سفت و ترمیم دائمی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Nonselective Removal to Hard Dentine:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برداشت کامل تا عاج سخت؛ در گذشته رایج بود، اما امروز به دلیل احتمال آسیب به پالپ دیگر توصیه نمی‌شود."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
