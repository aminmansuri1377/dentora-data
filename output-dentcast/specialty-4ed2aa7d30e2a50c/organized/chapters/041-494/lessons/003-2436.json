  "steps": [
    {
      "id": "theory:ac4c0c2e566c23179854c70a2afd28386f841597219919a031fa117d46d16673",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f7a7853a06f5e8d4e9e70bf777652dead2040fed299935a7702ce3667c05257a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مرز نامرئی عاج سالم و پوسیده را رنگی کن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کف حفره ظاهر یکدستی دارد و با چشم نمی‌شود گفت عاج پوسیده تا کجاست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای ساختن PSZ و رسیدن به CRE به چه ابزاری تکیه می‌کنی و آن را چطور به کار می‌بری؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کریز دیتکتور دای (CDD) چیست؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محلولی رنگی، معمولاً قرمز یا سبز، برای تشخیص پوسیدگی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کلاژن دناتوره‌شده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در عاج پوسیده می‌چسبد و آن را رنگ می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمک می‌کند بین عاج سالم و پوسیده تمایز بگذاری."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا مهم است؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تشخیص دقیق پوسیدگی، به‌خصوص در مراحل اولیه و پوسیدگی‌های پنهان؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفظ ساختار سالم دندان با حذف کامل پوسیدگی بدون آسیب به بافت سالم؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایجاد PSZ با اطمینان از حذف کامل پوسیدگی از این ناحیه؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعیین CRE با کمک پروب پریودنتال برای جلوگیری از آسیب به پالپ."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نحوه‌ی استفاده"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفره را تمیز و خشک کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک قطره CDD را با میکروبراش روی ناحیه‌ی پوسیدگی بمال."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بگذار "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۰ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " روی دندان بماند تا کامل نفوذ کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان را کامل با آب بشوی و با دقت خشک کن."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:803cdebb8f2257d729c9867dfae4aa71950c74bd73dd1f9a4824f0bf81f3e61b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "f3b2013dc1de2a5218c7cf656a286034a1f2faa6e9f525cb0ed21f2c2391c0f2",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "خواندن رنگ، و شست‌وشو پیش از باندینگ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بررسی رنگ"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "قرمز تیره:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پوسیدگی شدید و عاج پوسیده‌ی بیرونی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "صورتی کم‌رنگ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پوسیدگی خفیف‌تر و عاج پوسیده‌ی داخلی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوسیدگی را با توجه به رنگ و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "محل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آن حذف کن و در صورت نیاز مراحل را تکرار کن تا به CRE برسی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کجا چه رنگی مجاز است؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "در PSZ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کاملاً عاری از رنگ؛ چه قرمز و چه صورتی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "در محدوده‌ی CRE:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " صورتی کم‌رنگ قابل قبول است، اما قرمز تیره باید حذف شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "CDD در کنار تکنولوژی‌های دیگری مثل DIAGNOdent برای تشخیص باکتری‌ها به کار می‌رود. دو نوع اصلی CDD، قرمز و سبز، در اصول استفاده فرقی ندارند؛ و مهارت و دقت دندانپزشک در استفاده از CDD و ایجاد PSZ بسیار مهم است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آیا CDD باند را ضعیف می‌کند؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در یک مطالعه، اثر این محلول‌ها بر استحکام باند کششی (Tensile Bond Strength) چهار سیستم ادهزیو به دنتین سالم گاوی بررسی شد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اگر کاملاً شسته شود:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هیچ‌کدام از سیستم‌های باندینگ کاهش معنی‌داری در استحکام باند نشان ندادند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اگر شسته نشود (سطح آلوده):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " استحکام باند کششی در Clearfil SE Bond و Single Bond به‌طور قابل توجهی کاهش یافت."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عامل مزاحم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پروپیلن گلیکول (Propylene Glycol)، یکی از اجزای اصلی این محلول‌ها، بر استحکام باند هر چهار سیستم اثر می‌گذارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "CDD به شرط شست‌وشوی کامل با آب اثر نامطلوبی بر باند به عاج سالم ندارد؛ باقی ماندن هر اثری از محلول روی دنتین می‌تواند باندینگ را ضعیف کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
