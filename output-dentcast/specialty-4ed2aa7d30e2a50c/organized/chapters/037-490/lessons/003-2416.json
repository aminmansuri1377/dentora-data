      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "روش اجرا و چهار اصل موفقیت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش اجرا"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "روش اولیه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یک اپلاینس متحرک کبالت‌کروم که روی سطح پالاتال دندان‌های قدامی ماگزیلا قرار می‌گرفت."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کیس شاخص:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیمار ۱۸ ساله‌ای هشت ماه به‌صورت ۲۴ ساعته از اپلاینس استفاده کرد تا فضای کافی برای ترمیم فراهم شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اجرای امروزی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " همان اصول با مواد ادهزیو (کامپوزیت یا سرامیک) و به شکل رستوریشن‌های فیکس موضعی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اصول موفقیت"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رستوریشن یا اپلاینس فقط روی سطح انسیزال یا اکلوزال قرار گیرد و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "با مخاط تماس نداشته باشد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضخامت ماده به‌طور مستقیم میزان فضای ایجادشده را تعیین می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیروهای اکلوزالی در راستای "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "محور طولی دندان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " منتقل شوند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تماس‌های اکلوزالی پایدار باشند و اپلاینس مانع رویش یا حرکت جبرانی سایر دندان‌ها نشود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "میزان موفقیت این روش در مطالعات بین "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۹۴ تا ۱۰۰ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گزارش شده، مستقل از سن و جنسیت بیمار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "با این حال بسیاری از دندانپزشکان همچنان روش‌های پروستودنتیک سنتی را ترجیح می‌دهند؛ مسئله‌ای که بیشتر ریشه در فرهنگ آموزشی دارد تا شواهد بالینی."
                }
              ]
            }
          ]
        }
      ],
