  "steps": [
    {
      "id": "theory:3895a185ef6accd4219c737d5f112bcdf8c76d11c24280263bd6bfeffccdf758",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "62abb35a60e3fa43f59e0fc9f07f29eeee8ec1d5d559792470af68b91f474f56",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فضایی که از حرکت دندان‌ها می‌آید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیماری سایش موضعی در دندان‌های قدامی دارد و فضای کافی برای ترمیم نیست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان‌ها از قبل ارتفاع تاجی کمی دارند؛ تراش برای روکش هم رتنشن و رزیستنس ناکافی می‌سازد و ساختار باقی‌مانده را بیش از پیش تحلیل می‌برد. چطور بدون تراش تهاجمی یا کرون لنگتنینگ جراحی فضا بسازیم؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانسپت دال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یک رویکرد محافظه‌کارانه برای ایجاد فضای بین‌اکلوزالی در سایش موضعی دندانی است: یک رستوریشن یا اپلاینس موضعی در حالت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوپرااکلوزال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قرار می‌گیرد و طی چند هفته تا چند ماه، سایر دندان‌ها حرکت می‌کنند تا اکلوژن کامل دوباره برقرار شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مکانیسم بازآرایی اکلوزالی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اینتروژن دندان‌های قدامی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دندان‌هایی که زیر بار رستوریشن سوپرااکلوزال قرار می‌گیرند، به‌تدریج اینترود می‌شوند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سوپرااراپشن دندان‌های خلفی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دندان‌هایی که از تماس اکلوزالی خارج شده‌اند، به‌صورت جبرانی رویش می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سهم هر مکانیسم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در مطالعات کلاسیک، حدود ۴۰ درصد فضا از اینتروژن و حدود ۶۰ درصد از اراپشن جبرانی دندان‌های مقابل گزارش شده است."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:65b01fbd55c44a6d7d622a4e87bc3f8c58848a1f68d772486e36d1355996c878",
