                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دو مسیر باقی می‌ماند:"
                        }
                      ]
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "crown lengthening"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای رسیدن به "
