    {
      "id": "theory:fef0988244c337f9169bbe99b72e0279354f5624562ffe57d15d75d1ed7e57c5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "145adff115b9e9b467739bcd2b19db78bd8bbb73618577c0fe412f0c8eb6eebd",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیش از انتخاب ترمیم، ساختار دندان را بسنج"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار از حساسیت به سرما و شیرینی و درد هنگام گاز گرفتن شکایت دارد و دندان درمان قبلی دارد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از انتخاب نوع ترمیم، چه چیزهایی را باید در این دندان سنجید؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هدف تشخیص آسیب‌های ساختاری این است که درمان به سمتی برود که تا حد امکان ساختار طبیعی دندان حفظ شود و از مشکلات بعدی مانند شکستگی، پوسیدگی و آسیب به پالپ جلوگیری شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "شرح حال و چهار Red Flag"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علاوه بر گرفتن شرح حال کامل (سابقه‌ی حساسیت، درد و درمان‌های قبلی)، به چهار Red Flag در دندان توجه کن:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترک‌های داخل عاج"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عرض ایستموس بزرگ‌تر از ۲ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضخامت کاسپ کمتر از ۳ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمق باکس بزرگ‌تر از ۴ میلی‌متر"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "Red Flag اول: ترک‌های داخل عاج"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترک‌های داخل عاج می‌توانند به‌صورت شکستگی‌های حاشیه‌ای محیطی ("
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "PRF"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یا Peripheral Rim Fracture) دیده شوند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای اینکه بدانی PRF به عاج گسترش یافته یا نه، معاینه‌ی دقیق با بزرگنمایی و بررسی سابقه‌ی بیمار ضروری است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترک‌های عاجی می‌توانند باعث حساسیت به سرما، شیرینی یا درد هنگام گاز گرفتن شوند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "ترک‌های داخل مینا را می‌توان با روش‌های ترمیمی باندشونده ترمیم کرد، اما ترک‌های داخل عاج نیاز به مداخله‌ی بیشتری دارند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:faa52cbef4401d14f1759b8c77130561c7be6c03841593cc4ca7b4616c35f2b6",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "80019fd4da53844ebe5f9f0c3430fb85bb2225c355dcc9cf8ddac781bd8ac824",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ایستموس، کاسپ، باکس و Rainey Ridge"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عرض ایستموس بزرگ‌تر از ۲ میلی‌متر"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ایستموس فاصله‌ی بین دو دیواره‌ی حفره در دندان است. عرض ایستموس در حد ۲ میلی‌متر می‌تواند مقاومت دندان در برابر شکستگی را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تا ۶۰٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاهش دهد. ترمیم‌های آمالگام یا کامپوزیت بدون باند می‌توانند flexure دندان را افزایش دهند و در نتیجه ترک و پوسیدگی بیشتری ایجاد کنند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ضخامت کاسپ کمتر از ۳ میلی‌متر"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کاسپ‌های با ضخامت کمتر از ۳ میلی‌متر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«خشک»"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در نظر گرفته می‌شوند، زیرا اتصال بین پالپ و DEJ از طریق مایع عاجی از بین می‌رود. کاسپ‌های خشک انعطاف‌پذیری کمتری دارند و بیشتر در معرض شکستگی‌اند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عمق باکس بزرگ‌تر از ۴ میلی‌متر"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عمق باکس یعنی عمق حفره‌ی آماده‌سازی‌شده در دندان. عمق باکس بیشتر از ۴ میلی‌متر به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "BioRim"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان تجاوز می‌کند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "BioRim شامل ۲ تا ۳ میلی‌متر از ساختار دندان (مینا، DEJ/DEC و عاج سطحی) بالای CEJ است و به دلیل استحکام بالا، حفظ رطوبت عاج و حفظ سلامت پالپ بسیار مهم است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مینا در ناحیه‌ی BioRim ساختار منشوری منظمی ندارد و bevel کردن آن می‌تواند مینا را تضعیف کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر BioRim از بین رفته باشد، می‌توان آن را با Deep Margin Elevation (DME) بازسازی کرد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "Rainey Ridge و PRF"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "Rainey Ridge یک ریج ترانسورس مایل زیر سطح اکلوزال است که زیر پیت و فیشورهای سطح جونده قرار دارد و به اتصال بخش‌های مختلف دندان کمک می‌کند؛ مانند یک «ستون فقرات» به دندان استحکام می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بریدن Rainey Ridge در طول آماده‌سازی حفره ساختار دندان را تضعیف و flexure را زیاد می‌کند، و این افزایش flexure می‌تواند به شکستگی‌های حاشیه‌ای محیطی (PRF) برسد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
