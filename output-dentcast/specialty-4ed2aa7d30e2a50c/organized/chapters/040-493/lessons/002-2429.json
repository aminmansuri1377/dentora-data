  "steps": [
    {
      "id": "theory:539c71bf8a88f3560a5dc9efa5e39b0dcfbd2aa4fdb5d60a71b0a495fd378149",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "ef7cd01e8dc8026540d8157fc59d7d9125f92282536c66a842da215ff9df43c9",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "علائمی که آرام می‌شوند، ترکی که می‌ماند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار از حساسیت به سرما و شیرینی و درد هنگام گاز زدن گفته، ولی حالا علائمش کمتر شده است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آیا آرام شدن علائم یعنی ترکی در کار نیست؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بعد از معاینه‌ی بالینی و بررسی ۴ Red Flag، گرفتن شرح حال کامل اهمیت بالایی دارد: از بیمار درباره‌ی حساسیت به سرما، شیرینی یا درد هنگام گاز زدن بپرس (که می‌تواند نشانه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Cracked Tooth Syndrome"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد) و سابقه‌ی دندان‌درد و درمان‌های قبلی را هم بررسی کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رمینرالیزاسیون ترک‌ها به دلیل تشکیل عاج ثالثیه (Tertiary Dentin) و کاهش حرکت هیدرودینامیک می‌تواند علائم را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "موقتاً"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تسکین دهد؛ همین تشخیص سندرم ترک دندان را دشوار می‌کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رشد ترک (Crack Propagation)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترک‌های کوچک‌تر برای رشد به نیروی بالاتری نیاز دارند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترک‌های بزرگ‌تر با نیروی کمتری رشد می‌کنند و به شکستگی می‌رسند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش‌های دیدن ترک (Crack Visualization)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بزرگنمایی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " استفاده از بزرگنمایی بالا برای تشخیص ترک‌ها ضروری است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رنگ ترک:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ترک‌های قدیمی معمولاً تیره‌ترند و راحت‌تر دیده می‌شوند؛ ترک‌های جدید روشن‌ترند و تشخیصشان دشوارتر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دهیدراته کردن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای ترک‌های مورب یا افقی، دندان را ۱۰ ثانیه با هوای فشرده خشک کن؛ عاج بالای ترک چون رطوبت کمتری از پالپ می‌گیرد Opaqueتر دیده می‌شود. این روش برای ترک‌های عمودی مناسب نیست، چون هر دو طرف ترک به‌طور یکسان از پالپ رطوبت می‌گیرند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پرایمر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پرایمر شکست نور را در ترک تغییر می‌دهد و می‌تواند به تشخیص بهتر آن کمک کند."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:e72939b69f07334138e0c3a2c59c81c9043af86bd25ddacabcb786c9970b6810",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ea80d5ea13eaa93cb7511b604a08fda66fa8779efde74d696eb44e8a8313b2a3",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "درمان ترک: مینا یا عاج، افقی یا عمودی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترک‌های محدود به مینا"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این ترک‌ها را می‌توان Biomimetic در نظر گرفت. با ترمیم Adhesive، دندان به حالت طبیعی برمی‌گردد و احتمال شکستگی یا پوسیدگی ثانویه کاهش پیدا می‌کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترک‌های درگیرکننده‌ی عاج"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این ترک‌ها Biomimetic نیستند و در صورت امکان باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Crack Dissection"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و حذف ترک انجام شود."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روکش کامل (Full Coverage Crown)، آنله پارسیل (Partial Onlay)، تنظیم اکلوزال (Occlusal Adjustment) یا باندینگ ترک با کامپوزیت یا فیبر (مثل Ribbond) در این موارد معمولاً موفق نیستند، چون ترک همچنان وجود دارد و می‌تواند به رشدش ادامه دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنله پارسیل با باندینگ برای ترک‌های افقی یا مورب ممکن است مفید باشد، اما برای ترک‌های عمودی معمولاً مؤثر نیست."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جهت ترک و پیامد آن"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترک‌های مورب/افقی کمتر به نکروز پالپ می‌رسند؛ اگر تشخیص داده نشوند، شایع‌ترین عارضه‌شان شکستگی کاسپ است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترک‌های عمودی بیشتر باعث نکروز پالپ یا شکستگی Catastrophic می‌شوند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "روش Crack Dissection به‌عنوان روش درمانی انتخابی در این موارد در نظر گرفته می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
