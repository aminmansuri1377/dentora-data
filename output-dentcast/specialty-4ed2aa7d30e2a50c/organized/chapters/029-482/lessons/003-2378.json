      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دیاستمی که با لمینیت بسته نمی‌شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار با شکایت زیبایی مراجعه کرده است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در معاینه، یک دیاستم در ناحیه‌ی میدلاین بین دندان‌های سانترال وجود دارد و در ناحیه‌ی دیستال سانترال نیز فضا دیده می‌شود. عرض دندان‌ها در محدوده‌ی نرمال است. آیا دیاستم را مستقیم با لمینیت می‌بندی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/dcst-chairside-cs1.webp",
                  "alt": "دیاستم میدلاین بین سانترال‌ها و فضا در ناحیه‌ی دیستال سانترال",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/54f8bb7e9b9992cf2d6e86d15fd7f98ba5c9aec69817212ee150fea68a824089.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیاستم میدلاین بین سانترال‌ها و فضا در ناحیه‌ی دیستال سانترال "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(DentCast — Dr. Fouad Shahabian)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اولین پیامد: پهن شدن سانترال‌ها"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بستن دیاستم با لمینیت به‌صورت مستقیم باعث "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افزایش عرض سانترال‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شود. چون بیمار به ابعاد نرمال دندان‌های خود عادت دارد، پهن شدن دندان‌ها می‌تواند از نظر ذهنی و زیبایی‌شناختی برای او قابل پذیرش نباشد."
                }
              ]
            }
          ]
        }
