          "children": [
            {
              "tag": "text",
              "text": "لثه، میدلاین و تناسبات دندانی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آنالیز دنتوجینجیوال و میدلاین"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سطح لثه‌ی چهار دندان قدامی تقریباً هم‌سطح است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لترال‌ها معمولاً کمی اینسیزال‌تر از سانترال‌ها قرار می‌گیرند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قوس لثه (Scallop) ایده‌آل حدود ۴ تا ۵ میلی‌متر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "میدلاین باید عمودی باشد؛ انحراف تا ۴ میلی‌متر قابل قبول است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تناسبات دندانی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "طول نرمال سانترال: حدود ۱۰٫۵ تا ۱۲ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نسبت عرض به طول ایده‌آل: ۷۵ تا ۸۰ درصد"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لترال‌ها: ۱ تا ۲ میلی‌متر کوتاه‌تر از سانترال"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیش‌ها: حدود ۰٫۵ تا ۱ میلی‌متر کوتاه‌تر از سانترال"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با حرکت به سمت دیستال، دندان‌ها باید کوچک‌تر به نظر برسند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قانون ۱-۲-۳-۴-۵"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عرض لترال ≈ دو سوم عرض سانترال"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عرض نیش ≈ چهار پنجم عرض لترال"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "قوانین McLaren نسخه‌ی درمان نیستند؛ یک چارچوب ذهنی سریع‌اند برای تحلیل زیبایی قبل از ورود به فاز درمان. طراحی لبخند، قبل از هر چیز، «دیدن درست» است."
                }
              ]
            }
          ]
        }
