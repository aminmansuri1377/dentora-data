  "steps": [
    {
      "id": "theory:100b51cc3679dfadf3bb4045d84e27dc798f08bc4c12fd4a02a48120a612ab65",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "9e971a501cb48566efa6f2dab371d1d59ffd5d2c656bcb7daa4afec7322128f4",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مولر، پرمولر، اینسایزور: سه جواب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "می‌خواهی به‌جای پست‌وکراون اندوکراون بگذاری."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آیا این جایگزین برای هر دندانی به یک اندازه قابل‌اتکاست؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک مرور سیستماتیک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴۱ مطالعه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را کنار هم گذاشته است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۸ مطالعه‌ی کلینیکی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۳ مطالعه‌ی in vitro"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". جواب برای هر دندانی یکسان نیست و تصمیم بالینی دقیقاً همین‌جا شکل می‌گیرد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولرها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " روی مولرهای تخریب‌شده، اندوکراون درمان فوق‌العاده قابل اعتمادی با بقای بالا در کوتاه‌مدت، میان‌مدت و بلندمدت است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پرمولرها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مطالعات کلینیکی نرخ بقای کمتری نشان داده‌اند و همه‌ی شکست‌ها از دست رفتن ادهیژن بوده است؛ ولی مطالعات in vitro مقاومت به شکستی قابل مقایسه با کراون‌های دارای پست ثبت کرده‌اند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اینسایزورها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مطالعه‌ی کلینیکی در دسترس نیست، مطالعات in vitro کم و نتایجشان متناقض است، و در حال حاضر نمی‌توان اندیکاسیون کلینیکی برای آن‌ها بیان کرد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علت اصلی شکست"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کراون‌های معمولی (با یا بدون پست) شکست فاجعه‌بار (catastrophic) مثل شکست ریشه‌ی بیشتری دارند. در اندوکراون، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۷۱٪ شکست‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مربوط به شل شدن و دیس‌باند شدن است که قابل ترمیم و مدیریت است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:10f803d5f2f9daf222b504508baf1dc78f9be7bd19f6d5ae51093308d7ab2a5c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "99529b3b7607784ff28c2a577f9c00970b2af8c7eaec3075009b799b1c4792fd",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کلیدهای موفقیت: ماده، باند، طراحی حفره"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "انتخاب متریال"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کامپوزیت‌های نانوفیل:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مدول الاستیسیته‌شان مشابه دندان است؛ استرس‌ها را به‌خوبی جذب می‌کنند و احتمال شکست غیرقابل‌جبران را کاهش می‌دهند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سرامیک‌های لیتیوم دی‌سیلیکات:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " زیبایی بالا و ادهیژن عالی؛ سرامیک‌ها به‌طور کلی ادهیژن پلاک کمتری نسبت به کامپوزیت‌ها دارند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "چون بخش عمده‌ی شکست‌ها ناشی از دیس‌باند شدن است، رعایت دقیق "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروتکل باندینگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و استفاده از متریالی با ادهیژن بالا حیاتی است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "طراحی حفره"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر ارتفاع باقی‌مانده‌ی دیواره‌های پالپ چمبر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کمتر از ۲ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " باشد، ریسک دیس‌باند شدن بالا می‌رود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به‌جای برداشتن اندرکات‌ها با برداشتن بافت، بهتر است آن‌ها را با مواد مناسب "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بلاک‌اوت (Block-out)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کنی تا نسج دندان و استحکام کلی حفظ شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دادن "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فرول"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مقاومت به شکست اندوکراون را افزایش می‌دهد، اما تلاش برای ایجاد فرول نباید به قیمت از دست رفتن مینای دندان، مخصوصاً نزدیک CEJ، تمام شود. این جمع‌بندی خاص همین مرور است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اندوکراون یک درمان کاملاً قابل‌اعتماد، به‌ویژه برای مولرهاست؛ به شرطی که اصول طراحی حفره، پروتکل باندینگ و انتخاب متریال (مثل نانوکامپوزیت‌ها یا لیتیوم دی‌سیلیکات) با دقت و استاندارد بالا رعایت شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
