  "steps": [
    {
      "id": "theory:5dc9bbf613d1080a1dd4060055988588ec6e6a69f641642293cc471507979441",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6d9936006a609f51f3718f2695f8536ef1966f6c87c260602c70ecb1bc639e33",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دندان اندوشده؛ پست لازم است؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک دندان اندوشده باید ترمیم شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و می‌خواهی در مسیر دندانپزشکی مینیمال‌اینویسیو بمانی. راه قدیمی پست‌وکراون است: پست داخل کانال و روکش روی آن. آیا واقعاً باید وارد کانال ریشه شوی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اندوکراون دقیقاً برای همین ساخته شده است. هدف اصلی این رستوریشن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استفاده نکردن از پست و وارد نشدن به کانال‌های ریشه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، چون قرار دادن پست در کانال باعث تضعیف ریشه می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اندوکراون چیست؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک رستوریشن "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "یک‌تکه (مونولیتیک)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روی یک مارجین "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بات‌جوینت (Butt-joint)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " قرار می‌گیرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فقط از فضای پالپ چمبر کمک می‌گیرد؛ گیرش از پالپ چمبر و باند ادهزیو می‌آید، نه از پست."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "با پیشرفت سرامیک‌ها و سیستم‌های باندینگ، اندوکراون به یک جایگزین عالی برای پست‌وکراون‌های قدیمی تبدیل شده است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کجا و کجا نه؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تجویز:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بهترین گزینه برای دندان‌های مولر است؛ برای پرمولرها و قدامی‌های ماگزیلا هم با کمی اختلاف‌نظر استفاده می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "منع:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " وقتی امکان ایزولاسیون و باندینگ خوب وجود ندارد، عمق حفره کمتر از ۳ میلی‌متر است یا عرض مارجین سرویکال کمتر از ۲ میلی‌متر است، سراغ اندوکراون نرو."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
