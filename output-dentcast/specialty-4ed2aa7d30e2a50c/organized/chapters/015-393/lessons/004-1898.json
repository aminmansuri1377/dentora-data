  "steps": [
    {
      "id": "theory:75f344fcce9e0679d9389b5715ec4511faf800b3c9e7d69c4bb217c2aebc1d02",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "5a2a56fb0cb804d0bc472520dd3102a755d78f03789beede7091f035a9120876",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مواد مدرن: RMC یا LDS؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای آنله‌ی یک مولر باید بین resin matrix ceramic و lithium disilicate انتخاب کنی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حالا که مواد مدرن آمده‌اند، انتخاب ماده فرقی می‌کند؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای این سؤال باریک‌تر باید سراغ شواهد تازه‌تر و کنترل‌شده‌تر رفت. یک مرور سیستماتیک جدید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فقط RCTها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را وارد کرده تا مواد امروزی را head-to-head مقایسه کند: "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "resin matrix ceramic (RMC)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در برابر "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "lithium disilicate (LDS)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و leucite-reinforced glass ceramic. متاآنالیز روی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ RCT"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲۵۲ ترمیم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام شده است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بقای سه‌ساله:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای LDS حدود ۹۴٪ و برای RMC حدود ۸۹٪."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مهم‌ترین یافته:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هیچ تفاوت معناداری بین مواد مختلف پیدا نشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برآوردها کمی به سمت LDS متمایل بودند در restoration failure و loss of retention، و کمی به سمت RMC در bulk fracture؛ ولی هیچ‌کدام از نظر آماری معنادار نبودند و سطح قطعیت شواهد پایین ارزیابی شد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "این برآوردها جهت‌گیری‌اند، نه برتری اثبات‌شده‌ی یک ماده بر دیگری."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آن تفاوت‌های کوچک از کجا می‌آیند؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "loss of retention در RMC:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تقریباً تمام این سیگنال از یک مطالعه می‌آید، با ۹ مورد debonding، و همان مطالعه روی دندان‌های non-vital کار کرده است؛ پس الگوی عمومی RMC نیست و دلیلش احتمالاً اجرای bonding است، نه خود ماده. داده‌های آزمایشگاهی: RMC بدون surface pretreatment فقط حدود ۲۳ مگاپاسکال bond strength می‌دهد، ولی همان ماده با sandblasting و adhesive به حدود ۱۰۰ مگاپاسکال می‌رسد. RMC حساس به تکنیک است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "bulk fracture:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " RMC کمی بهتر عمل کرد، که با خاصیت elastic و توان جذب stress آن سازگار است. این دو سیگنال در جهت مخالف هم نشان می‌دهند انتخاب ماده یک trade-off است، نه پیروزی مطلق."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5536f5edb7f5d6e86475189a98fd8f3abe8b206f1efca35ccfb0e1df8664db9e",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "7604aa510e462e66b39f52bde6bde6b4eff36d775d8db638794ecc3099492ad4",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تناقض vitality و نتیجه‌ی بالینی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک تناقض ظاهری"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "داده‌های بلندمدت می‌گفتند vitality خیلی مهم است، ولی مرور تازه در زیرگروه vital در برابر non-vital تفاوت معناداری پیدا نکرد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این تناقض احتمالاً واقعی نیست و مسئله‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زمان و تعداد مطالعه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است: داده‌ی non-vital در مرور جدید عملاً از یک مطالعه می‌آید و فقط سه‌ساله است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نتیجه‌ی نامطلوب non-vital بودن اثری تجمعی و کند است؛ برای دیدنش نه حجم کافی هست نه زمان کافی. این زیرگروه "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "underpowered"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است و معنادار نبودنش را نباید «نبود اثر» خواند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نمای بلندمدت‌تر همچنان به اهمیت vitality اشاره می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در کلینیک چه نتیجه‌ای می‌گیری؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو بدنه‌ی شواهد، با حدود بیست سال فاصله، به یک نتیجه می‌رسند: داخل خانواده‌ی سرامیک‌ها، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هویت ماده پیش‌بینی‌کننده‌ی ضعیفی برای بقاست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". آنچه بقا را جابه‌جا می‌کند: اجرای درست پروتکل bonding، باقی‌مانده‌ی بافت دندان و vitality، و محیطی که دندان در آن قرار دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پرسش «کدام ماده» کم‌اهمیت‌تر از «چطور باند می‌کنی و روی چه دندانی» است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هنوز بی‌جواب"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رفتار بلندمدت RMC مدرن نامعلوم است، چون داده‌ی RCT آن کوتاه‌مدت است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترمیم‌های minimally invasive مثل occlusal veneerهای نازک هنوز مطالعه‌ی کافی ندارند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اینکه مواد امروزی در ده سال از همان کف قدیمی glass-ceramic بهتر عمل می‌کنند یا نه، هنوز جواب قطعی ندارد."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
