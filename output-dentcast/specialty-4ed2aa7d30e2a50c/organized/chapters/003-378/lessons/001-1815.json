    {
      "id": "theory:d2085806b06d4c5b128630ff3356f42fa2b5acc3ab6db828a498ef5f4a79bcf1",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "d352064049bab49548db4234023f14066b679e28f3c127a2a9d28e240d5c16f7",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا با وجود اصرار بیمار دست نگه داشتیم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "طرح درمان مشخص شد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خارج کردن روکش، درمان ریشه و پروتز مجدد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". ولی بیمار به‌شدت مستأصل بود، اصرار داشت کار همان لحظه انجام شود و اصلاً تمایل نداشت به درمانگر قبلی مراجعه کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا روکش تازه را همان جلسه برنداشتیم"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نمی‌دانیم دقیقاً زیر آن روکش چه خبر است: میزان و نحوه‌ی تراش، وضعیت فرول، پرفوریشن احتمالی و…"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایرادهای کار قبلی تا وقتی روکش خارج نشود، مشخص نیستند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر ما روکش را خارج کنیم، هر ایرادی که زیر آن باشد، حتی اگر کار ما نباشد، ممکن است "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "به پای ما نوشته شود"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محافظت از خود ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Self-Protection"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ")"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای جلوگیری از مسائل قانونی ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Medico-legal"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ")، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم مرحله‌ی خارج کردن روکش تازه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باید توسط درمانگر قبلی انجام شود. این کار دو فایده دارد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسئولیت وضعیت دندان تراش‌خورده شفاف می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار با وضعیت واقعی دندانش (بدون روکش) مراجعه می‌کند و طرح درمان بر اساس «آنچه می‌بینیم» خواهد بود، نه «آنچه حدس می‌زنیم»."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "همیشه «درمان فوری» بهترین لطف به بیمار نیست. عجله در کمک به بیمار مستأصل نباید باعث شود مسئولیت کورکورانه‌ی یک طرح درمان نامشخص را بپذیری؛ ارجاع به همکار قبلی فقط برای خارج کردن روکش، مسیر درمان را شفاف می‌کند و از دردسرهای قانونی پیشگیری می‌کند."
                }
              ]
            }
          ]
        }
      ],
