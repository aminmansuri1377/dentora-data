      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "خواستهٔ بیمار و ترتیب درمان"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار پس از روکش شدن ده دندان، هنوز از فاصله‌ها و بزرگی روکش‌ها ناراضی است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو خواستهٔ ناسازگار"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کوچک‌تر کردن روکش‌ها فاصله را بیشتر می‌کند و بستن فاصله‌ها با روکش، آن‌ها را دوباره بزرگ می‌کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "راه‌حل مشترک"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "راه پاسخ دادن به هر دو خواسته، جابه‌جایی خود دندان‌ها و رفتن به سمت ارتودنسی است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
