  "steps": [
    {
      "id": "theory:edd4a30da693773b782a56a5ccbb288e949749aa8108dc0862b574453dada62e",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "a775f48c65ba47148d45d93fd5e7a48b4af0e25c2bddc1ba5b4048c767ed0b95",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آنلِی سالم، بیمار ناراضی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنلِی سرامیکی از نظر عملکردی سالم است، ولی بیمار از تغییر رنگ لبه‌ی آن ناراضی است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چرا چنین نقصی پیش می‌آید و آنلِی‌های سرامیکی در درازمدت چقدر دوام می‌آورند؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تغییر رنگ مارجینال می‌تواند حتی وقتی خود آنلِی سالم است باعث نارضایتی بیمار شود: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سمان رزینی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در فضای خالی مارجین ساییده می‌شود و تغییر رنگ می‌دهد و این از نظر زیبایی برای بیمار قابل قبول نیست."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آنلِی سرامیکی یعنی چه"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هر رستوریشنی که کل سطح دندان را پوشش نمی‌دهد اما "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم یک کاسپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را می‌پوشاند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "طول عمر و میزان بقا"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک مرور نظام‌مند، مطالعات را به دو گروه میان‌مدت (۲ تا ۵ سال) و درازمدت (بیش از ۵ سال) تقسیم کرد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "میان‌مدت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " میزان بقای ۹۱ تا ۱۰۰ درصد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "درازمدت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " میزان موفقیت ۷۱ تا ۹۸٫۵ درصد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آنلِی‌های سرامیکی درمان‌های موفقی‌اند؛ پراکندگی عددها در درازمدت خودش نشان می‌دهد اجرا و انتخاب کیس تعیین‌کننده است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:464f44d434502cfa2ea51ff41c763ad7cf24b923649dbcfe25f4dea62f4bae04",
