                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/aa19d6e12bf9bab44ae22f45c6e4af04deb5a53549f73b1e8ea8d92502aeccfb.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رادیوگرافی روکش ایمپلنتی قدامی؛ فاصله‌ی عمودی بین فینیش‌لاین اباتمنت و مارجین روکش "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
