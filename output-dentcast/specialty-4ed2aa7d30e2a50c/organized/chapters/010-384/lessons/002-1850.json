      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پوتی، واش و زمان ست شدن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مرحله‌ی قالب اولیه (پوتی)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر بیلدآپ کامپوزیت یا رستوریشن موقت با پایه‌ی متاکریلات داری، اسمیر لایر را با الکل پاک کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نخ‌گذاری لثه قبل از گرفتن قالب اولیه‌ی پوتی انجام شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تری دست‌کم ۳ میلی‌متر ضخامت ماده اطراف دندان‌ها داشته باشد و با سطوح اکلوزال تماس نداشته باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دهان بیمار نیمه‌باز باشد تا فشار از فک پایین اعمال نشود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آماده‌سازی برای مرحله‌ی اصلاحی (واش)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مواد اضافی لبه‌ی تری با تیغ شماره‌ی ۱۱ حذف شود؛ در قوس کامل، ناحیه‌ی کام صاف و هموار شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مواد بین‌دندانی حذف شود، اما سطوح اکلوزال حفظ شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایندکس‌گذاری بین دندان‌ها برای نشاندن صحیح تری، و کانال‌های اسکیپ برای خروج واش."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مرحله‌ی دوم (واش)"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "واش داخل قالب پوتی و اطراف دندان‌ها قرار می‌گیرد. تکنیک مورد استفاده: با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ هوا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " واش را پیش از نشاندن تری به سمت خط ختم هدایت کن."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "زمان کار و زمان ست شدن"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هر ماده زمان کار ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "WT"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ") و زمان ست شدن ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "ST"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ") مشخصی دارد و ست شدن داخل دهانی بعد از WT آغاز می‌شود. اگر قالب قبل از پایان WT نشانده شود، زمان باقی‌مانده باید به ST اضافه شود؛ یعنی صبر بیشتر در دهان، نه کمتر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "برداشتن زودهنگام قالب، شایع‌ترین علت اعوجاج الاستیک است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
