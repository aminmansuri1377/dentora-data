  "steps": [
    {
      "id": "theory:58a0276e06b03900bb6cddfa789031a7c67245837296f19a12b24661d007023c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "bc3dcec086e62195136f977ef71a1c215bf7a4b3cf54e243411697cb2d20c018",
      "position": 1,
