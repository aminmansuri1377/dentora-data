      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فودایمپکشن زیر روکش قدیمی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این دندان روکش قبلی دارد و بیمار از فود ایمپکشن شکایت دارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که به درد و التهاب لثه رسیده است. عامل فود ایمپکشن، کانتکت پروگزیمال نادرست روکش قبلی است. روکش خارج شد؛ حالا تراش را برای چه اصلاح می‌کنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/dcst-insight-insight73.webp",
                  "alt": "دندان پس از خارج کردن روکش قدیمی: کور آمالگام، لثه‌ی ملتهب و خونریزی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/35387b2ac99645a2d7610f2c63cc6705b571dcd911dd98213aff1fc3c754424a.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان پس از خارج کردن روکش قدیمی: کور آمالگام، لثه‌ی ملتهب و خونریزی "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(DentCast — Dr. Fouad Shahabian)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اصلاح تراش، جدا از شکایت"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روکش خارج شد و ابتدا اصلاح تراش انجام شد. اصلاح تراش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لزوماً ارتباطی با شکایت سابجکتیو بیمار ندارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": تراش اینجا اصلاح شد چون تراش قبلی ایراد داشت، نه به این دلیل که بیمار از فود ایمپکشن شکایت داشت."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آمالگام در دو طرف اورهنگ داشت؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فینیش‌لاین نامناسب بود؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیواره‌ها نیاز به اصلاح داشتند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فینیش‌لاین و دیواره‌ها اصلاح شدند. مشکل کانتکت، که علت شکایت بیمار بود، در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرحله‌ی طراحی روکش جدید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حل می‌شود. این دو مسیر جدا هستند: تراش ایراددار حتی بدون هیچ شکایتی هم باید اصلاح شود."
                }
              ]
            }
          ]
        }
      ],
