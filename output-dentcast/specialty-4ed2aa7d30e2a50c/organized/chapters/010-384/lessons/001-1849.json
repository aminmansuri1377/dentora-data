      "contentKey": "eb630a803657572934a3b09244a72fd97ef4c777ad94dd4f8f3ae73eaa33f2e0",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "روش قالب‌گیری و تری"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراش روکشی با مارجین زیرلثه‌ای آماده است و باید قالب بگیری."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کدام روش، کدام ماده و کدام تری؟ و پیش از آن با لثه چه می‌کنی؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه روش اصلی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دومرحله‌ای ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Two-step"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ")"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تک‌مرحله‌ای ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "One-step"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ")"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مونوفاز ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Monophase"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ")"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قالب‌گیری دومرحله‌ای"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو ویسکوزیته از یک نوع ماده (پوتی و واش): مرحله‌ی اول قالب پوتی، مرحله‌ی دوم تزریق لایت‌بادی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوتی سفت مثل یک تری اختصاصی عمل می‌کند و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فشار هیدرولیکی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بهتری می‌سازد که واش را به عمق سالکوس می‌راند؛ جزئیات نواحی کم‌دسترس بهتر ثبت می‌شود. برای همین برای مارجین‌های زیرلثه‌ای مناسب است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوتی و واش باید از یک خانواده‌ی سیلیکون باشند (A یا C). پلی‌اترها به‌دلیل سختی بالا مناسب نیستند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای اینله، آنله و ایمپلنت استفاده نمی‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تری قالب‌گیری"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تری فلزی سوراخ‌دار ارجح است و باید خاصیت الاستیسیته‌ی کافی داشته باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فاصله‌ی دندان تا تری = ۲ برابر عمق آندرکات؛ فاصله‌ی تری تا فک = دست‌کم ۳ تا ۵ میلی‌متر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دمینگ یا بلاکینگ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Damming/Blocking"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "): لبه‌های انتهایی تری با موم یا ماده‌ی مسدودکننده بسته می‌شود تا ماده نشت نکند و جزئیات دقیق‌تر ثبت شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قبل از قالب‌گیری نهایی، نشست تری در دهان چک شود."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:e12c71f0bce4cbb8b8bf1f3f745cccdb7c93f7b60b4deeb95a6686a0b5ca6d2e",
