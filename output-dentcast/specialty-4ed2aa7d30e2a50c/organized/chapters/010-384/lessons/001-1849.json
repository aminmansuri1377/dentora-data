      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کنار زدن لثه و نخ‌گذاری"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه روش آشکارسازی فینیش‌لاین ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Gingival Retraction"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ")"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مکانیکی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نخ زیرلثه‌ای"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شیمیایی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جراحی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ژنژیوکتومی، وقتی نیاز به برداشت بافت باشد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "تماس طولانی مواد اسیدی با لثه مضر است. برخی مواد شیمیایی با "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "A-silicone"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ناسازگارند و ست شدن ماده را مختل می‌کنند؛ کامپتیبیلیتی را بررسی کن. اگر خون کنترل نشد، قالب‌گیری باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۸ تا ۱۰ روز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به تعویق بیفتد؛ بافتی که خونریزی‌اش مهار نمی‌شود قالب معتبر نمی‌دهد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نخ‌های زیرلثه‌ای"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از نظر ساختار: "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Twisted – Braided – Woven"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از نظر ترکیب: ساده ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Plain"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ") یا آغشته به مواد شیمیایی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش قرار دادن نخ"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "span",
                          "attributes": {
                            "dir": "ltr"
                          },
                          "children": [
                            {
                              "tag": "text",
                              "text": "Single Cord"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": ":"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای سالکوس‌های کم‌عمق و دندان‌های محدود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "span",
                          "attributes": {
                            "dir": "ltr"
                          },
                          "children": [
                            {
                              "tag": "text",
                              "text": "Double Cord"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": ":"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نخ نازک زیر مارجین، نخ ضخیم روی آن؛ در زمان قالب‌گیری فقط نخ ضخیم‌تر خارج می‌شود. سالکوس باز می‌ماند و نخ زیرین همچنان خون و مایع را مهار می‌کند. مناسب سالکوس‌های عمیق‌تر و دندان‌های متعدد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ریترکشن پیست‌ها ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Retraction Pastes"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ")"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترکیب ماده‌ی منعقدکننده + ماده‌ی افزایش حجم ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Kaolin"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "): کنترل خون و کنار زدن ملایم بافت لثه."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "موفقیت قالب‌گیری فقط به ماده و روش نیست؛ به مدیریت بافت نرم، کنترل رطوبت و دقت در جزئیات بستگی دارد. هر گام دقیق به فیت بهتر و مارجین سالم‌تر ختم می‌شود."
                }
              ]
            }
          ]
        }
