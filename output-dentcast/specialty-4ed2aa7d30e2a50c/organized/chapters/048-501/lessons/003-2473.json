  "steps": [
    {
      "id": "theory:9663bdbd5c36e50652a76b08bb4c33fd669beab77803e363fd4f34b65358af6a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "77890fb58c53c9cd953701d9a7930e02901321c32677a0c3e72f5c0d7ffb8835",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کراون خلفی کیوبیک؛ مثل تتراگونال با آن کار کنی؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک روکش خلفی از زیرکونیای کیوبیک رسیده که در بعضی نواحی نازک است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آیا آن را همان‌طور سندبلاست و سمان می‌کنی که زیرکونیای تتراگونال را؟ پاسخ به این برمی‌گردد که نسل مکعبی چطور ساخته شد و چه چیزی را از دست داد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "زیرکونیا یکی از مهم‌ترین جایگزین‌های "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "PFM"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در دندانپزشکی مدرن است و سه فاز بلوری دارد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تتراگونال، مونوکلینیک و کیوبیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه گام در تکامل"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نسل اول، تتراگونال تقویت‌شده با استحکام بالا:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای پایداری فاز تتراگونال در دمای اتاق اکسید ایتریوم اضافه می‌شد، و برای جلوگیری از "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "LTD"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (تخریب دمای پایین) حدود ۰٫۲۵٪ آلومینا. مشکل: ظاهر بسیار کدر و سفید و فاقد زیبایی؛ مناسب قدام نبود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کاهش آلومینا:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از ۰٫۲۵٪ به ۰٫۰۵٪؛ شفافیت کمی بهتر شد ولی برای رستوریشن قدامی کافی نبود، و خواص مکانیکی تغییر چشمگیری نکرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نسل جدید، پایدارسازی فاز مکعبی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " افزایش ایتریوم تا ۸ تا ۱۰ مول درصد؛ زیرکونیا ۱۰ تا ۱۵٪ فاز مکعبی دارد و شفافیت و زیبایی به‌طور چشمگیری بالا رفته است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Transformation Toughening"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در زیرکونیای تتراگونال، هنگام ایجاد ترک، تبدیل تتراگونال به مونوکلینیک رخ می‌دهد؛ بلور مونوکلینیک ۳ تا ۵٪ بزرگ‌تر است، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنش فشاری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ایجاد می‌کند و رشد ترک را متوقف می‌کند. در زیرکونیای مکعبی این مکانیسم وجود ندارد، پس استحکام ترک‌مقاوم کمتر است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "استحکام خمشی زیرکونیای مکعبی ۶۰۰ تا ۷۵۰ مگاپاسکال است، حدود ۴۰٪ کمتر از نسل تتراگونال، ولی برای رستوریشن تک‌واحدی در هر ناحیه‌ی دهان کاملاً کافی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "هدف نهایی: یک ماده‌ی کاملاً سرامیکی، یکپارچه و بدون لایه که بیشترین زیبایی را بدهد و روند کار را ساده کند (اسکن ← طراحی ← میلینگ)."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:cde7d96f69937414b4c6cca47f16faea49174d819c9434e7e27b55c1856f49ab",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "209a4dcc57a693c7544f8b4c0491bfc84919101871d9a024eb969e2609802dcd",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "زیرکونیای کیوبیک: پیش از سینتر، در کوره، هنگام باند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قبل از سینتر ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Green State"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ")"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قبل از ورود به کوره زیرکونیا در حالت خام است؛ مشابه یک بلوک گچی سفت که تراشش آسان است، و استحکامش مشابه زیرکونیای معمولی قبل از سینتر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مارجین‌های زیرکونیای کیوبیک حتی در این مرحله هم شکننده‌تر از زیرکونیای تتراگونال‌اند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بهترین زمان ایجاد تکسچر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " طبیعی قبل از سینتر است؛ ایجاد بافت پس از سینتر سطح زبر و غیرطبیعی می‌سازد و می‌تواند سبب سایش دندان مقابل شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نکات لابراتواری"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زیرکونیای مکعبی نسبت به تغییر دما در حین سینتر بسیار حساس است؛ نوسان ۳۰ درجه می‌تواند شفافیت نهایی را تغییر دهد، پس کوره‌ی استاندارد ضروری است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رنگ‌آمیزی و گلیزینگ پس از سینتر تأثیری بر شفافیت ندارند؛ و برخی رنگ‌ها پس از پخت تغییر سایه می‌دهند و پیش‌بینی نتیجه دشوار است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گلیزینگ به‌تنهایی کافی نیست؛ برای طبیعی شدن سطح، پولیش مکانیکی حتماً باید انجام شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شفافیت: برابر با "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "e.max MT"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اما کمتر از e.max HT."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سندبلاست و باندینگ"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سندبلاست برای باندینگ ضروری است. روی تتراگونال استحکام ثابت می‌ماند یا حتی بیشتر می‌شود (به‌دلیل تحریک تبدیل فازی)؛ روی مکعبی، سندبلاست با فشار ۲ تا ۴ بار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استحکام را کاهش می‌دهد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در روکش‌های خلفی، در نواحی نازک باندینگ کاملاً ضروری است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروتکل: آلومینای ۳۰ میکرون سیلیکوت‌شده، پرایمر حاوی سایلان + MDP، و کاهش فشار سندبلاست به کمتر از ۲ تا ۴ بار."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مزیت باندینگ: توزیع تنش در سطح روکش و کاهش ریسک شروع ترک، چون زیرکونیای مکعبی فاقد "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Transformation Toughening"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
