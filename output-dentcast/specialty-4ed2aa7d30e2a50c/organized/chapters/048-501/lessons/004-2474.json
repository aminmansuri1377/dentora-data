      "contentKey": "12e437af9fe976895847a4b106c9e891724dd3967d48f8fa8b820841dffb19a0",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ونیر HT؛ کدام سمان؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای ونیر (لمینت) سرامیکی، سرامیک با شفافیت بالا ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "HT – High Translucency"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ") انتخاب کرده‌ای و حالا باید سمان رزینی را انتخاب کنی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سمان شفاف یا روشن؟ "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Light-Cure"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا Dual-Cure؟ و رنگ کار در درازمدت چقدر ثابت می‌ماند؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک مطالعه دو عامل اصلی مؤثر بر پایداری رنگ ونیرهای سرامیکی را بررسی کرده است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوع سرامیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سمان رزینی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مورد استفاده."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نوع سرامیک"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سرامیک‌های با شفافیت بالا ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "HT"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ") بیشترین میزان تغییر رنگ را در درازمدت نشان دادند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سمان رزینی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای سرامیک‌های HT، بهتر است از سمان‌های شفاف ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Transparent / Clear"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ") استفاده شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یافته‌ی مهم: هرچه "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "brightness"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سمان کمتر باشد، پایداری رنگ بهتر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در سمان‌های روشن‌تر، تمایل به تغییر رنگ (به دلیل تجزیه‌ی پلیمرها) بیشتر است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "توصیه‌ی بالینی: اگر از سرامیک "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "HT"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " استفاده می‌کنی، سمان باید شفاف و با روشنایی پایین باشد. "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "HT"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با سمان روشن یعنی ترکیب «تمام عوامل بد» و افزایش احتمال تغییر رنگ."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
