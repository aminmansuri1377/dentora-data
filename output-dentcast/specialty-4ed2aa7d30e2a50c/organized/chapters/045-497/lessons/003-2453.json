      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کاربردهای پیشرفته، منع مصرف و پروتکل کار"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کاربردهای کلینیکی کمتر دیده‌شده"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اسپلینت پریودنتال متحرک:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برخلاف اسپلینت‌های فیکس، بیمار راحت مسواک و نخ می‌زند؛ پس بهداشت خیلی بهتر حفظ می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کمک به جراحی لثه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کانتور ایده‌آل لثه را قبل از جراحی شبیه‌سازی می‌کنی و با بیمار به توافق می‌رسی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گزینه‌ی غیرتهاجمی برای بیماران خاص:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای کسانی که شرایط درمان تهاجمی ندارند (بیماری‌های سیستمیک، مصرف داروهای خاص، فوبیای دندانی و…)، یک گزینه‌ی محافظه‌کارانه است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "موارد منع مصرف"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیماری پریودنتال شدید با موبیلیتی بالا:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ریتنشن از دست می‌رود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پروتروژن شدید:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ضخامت اضافه (حدود ۰٫۵ میلی‌متر) می‌تواند وضعیت را بدتر کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بی‌دندانی کامل:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای گیر دست‌کم به چهار دندان یا اباتمنت ایمپلنت نیاز است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پروتکل قالب‌گیری"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "قوس اصلی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فقط سیلیکون (PVS) یا پلی‌اتر؛ آلژینات ممنوع است، به احتمال زیاد چون دقتش برای گیر دقیق این اپلاینس کافی نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "قوس مقابل:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آلژینات قابل قبول است، ولی باید سریع ریخته شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بایت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ثبت دقیق با سیلیکون یا وکس."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تحویل و تنظیم"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ابتدا ممکن است تنگ باشد یا روی صحبت و حرکت زبان اثر بگذارد؛ معمولاً ظرف ۱۰ تا ۱۵ دقیقه برطرف می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گذاشتن و برداشتن همیشه با دو دست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقاط فشار داخلی بدون از دست رفتن گیر قابل اصلاح‌اند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سطح لینگوال برای راحتی بیشتر قابل نازک‌سازی است، به شرط حفظ حداقل ضخامت ۰٫۷۵ میلی‌متر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکلوژن حتماً چک و تنظیم شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "در نهایت، پولیش کامل برای ایجاد سطحی صاف و قابل تحمل برای بیمار."
                }
              ]
            }
          ]
        }
      ],
