      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مرز فرضیهٔ تصویری و تشخیص"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برداشت اولیه از عکس چهره با دیدن ویدیوها در بعضی بخش‌ها سازگار نبود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عکس و معاینه"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عکس برای فرضیه‌سازی مفید است، اما برای طرح درمان کافی نیست؛ تشخیص را معاینه می‌سازد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محدودیت تصویر"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "زاویهٔ لنز نسبت‌ها را تغییر می‌دهد، نور سایه‌ها را کم‌وزیاد می‌کند و فریم ممکن است میان حرکت لب ثبت شده باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a547c20341257425aa2e0b67e0940af9bbdc57da151526c104951f8bf4bf49df",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "e3704735f694f06c7ccaa3c7595b7c2fda88e26684c2add6118b5b5ac9665024",
      "position": 2,
      "kind": "theory",
