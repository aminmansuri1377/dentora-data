  "steps": [
    {
      "id": "theory:06c7ac404ab2a92416d09d94e0baee73b4f9a89afaf83fc8f6ef0ad18dbc75ae",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "3ab37d71bd9068205db7c6157844631de7b00736a40967c90d8b92219d70a9ed",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "امتیاز تجمعی، تصمیم مدیریت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "معاینه‌ی BEWE بیمار تمام شده و شش امتیاز را جمع زده‌ای."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این عدد حالا چه می‌گوید: چه کاری انجام بدهی و بیمار را هر چند وقت دوباره ببینی؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جدول ریسک و مدیریت"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "≤ ۲ · ریسک None:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مشاهده‌ی روتین. پیگیری هر ۳ سال."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳ تا ۸ · ریسک کم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بررسی و توصیه‌ی بهداشت دهان و رژیم غذایی، مشاهده‌ی روتین. پیگیری هر ۲ سال."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۹ تا ۱۳ · ریسک متوسط:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بررسی بهداشت و رژیم، شناسایی و حذف عامل اصلی، اقدامات فلوراید برای افزایش مقاومت سطح؛ ترجیحاً ترمیم نکن و با کست مطالعه یا عکس مانیتور کن. پیگیری هر ۶ تا ۱۲ ماه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "≥ ۱۴ · ریسک بالا:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مثل سطح متوسط، و در موارد پیشرفت شدید مراقبت ویژه که ممکن است شامل ترمیم باشد. پیگیری هر ۶ تا ۱۲ ماه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای بیمارانی که در معرض اسید intrinsic یا extrinsic هستند، فاصله‌ی پیگیری را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶ ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بگذار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "این حدود آستانه‌ای بر پایه‌ی تجربه و مطالعات تعیین شده‌اند، پیشنهادی‌اند و باید با گذر زمان بازنگری شوند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مرزهای BEWE"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای سنجش "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پیشرفت ساییدگی در طول زمان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " طراحی نشده؛ ارزیابی مقطعی و مکمل قضاوت بالینی است، نه ابزار مقایسه‌ی قبل و بعد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راهنمای انتخاب تکنیک پروتزی یا ترمیمی نمی‌دهد، چون در این سطح تصمیم‌گیری تنوع بین کلینیسین‌ها زیاد است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شاخص غربالگری است؛ برای بررسی دقیق‌تر به نسخه‌ی مفصل‌تری نیاز است."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:1e667f87b7824c30fcfe8c0f623bf7b42fc371f9f853eb6cde62c3b42d485f9c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "253775ce09f5ad73dcfa0b9aab8de28e21bdcdfda72e7e224d3d34583dae41c2",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اشتباهات تشخیصی و BEWE در کودکان"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تحلیل لثه ساییدگی نیست"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تقعر معمول کنار حاشیه‌ی لثه ساییدگی نیست؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آناتومی نرمال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان است. در صورت شک، با پروب نوک‌گرد (WHO) به‌صورت لمسی بسنج و با دندان مجاور مقایسه کن."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پوسیدگی سرویکال erosion نیست"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوسیدگی ریشه "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "قهوه‌ای-نارنجی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است و سطحش نرم و ترد؛ تجمع پلاک هم معمولاً همراه آن است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساییدگی بدون پوسیدگی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هم‌رنگ بافت دندان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است و سطحش سخت."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضایعه‌ی پوسیدگی همراه با ساییدگی: امتیاز BEWE همان سطح را بدون توجه به پوسیدگی ثبت کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شک بین پوسیدگی و erosion: آن را پوسیدگی در نظر بگیر و امتیاز "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ثبت کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "BEWE در کودکان"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همان پروتکل و همان گرید برای کودکان و دندان‌های شیری به کار می‌رود و سکستانت‌ها به قدامی و خلفی تقسیم می‌شوند. دندان شیری مستعدتر به ساییدگی است، پس امتیاز معمولاً بالاتر خواهد بود؛ ارزیابی ریسک باید این را در نظر بگیرد و در موارد پرخطر فاصله‌ی پیگیری به ۶ تا ۱۲ ماه کاهش پیدا کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "BEWE شدت از دست رفتن بافت را می‌سنجد، نه علت آن را؛ اما تشخیص درست اینکه چه چیزی اصلاً ساییدگی است، پیش از هر امتیاز با توست."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
