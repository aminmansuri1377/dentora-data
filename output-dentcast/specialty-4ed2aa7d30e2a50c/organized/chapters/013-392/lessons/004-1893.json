  "steps": [
    {
      "id": "theory:67ad484acae3310d56cd548f9c9cfe611cab2a4f44c3859c88b821084e607f98",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "9b5c39f97f7a61895414af43bc3b75bbb0132e76155f1cb8335cffb7c4077d41",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "روکشی که «سال‌هاست مشکلی ندارد»"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان پایه‌ی کاندید پروتز پارسیل یک روکش قدیمی دارد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ظاهر روکش کاملاً سالم است و بیمار می‌گوید «سال‌هاست بدون مشکل کار می‌کند». دست نزدن به آن هزینه‌ی درمان را پایین می‌آورد. نگهش می‌داری؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مهم‌ترین بخش در موفقیت بلندمدت یک پروتز پارسیل متحرک ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "RPD"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ")، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان‌های پایه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ("
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "Abutment Teeth"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ") هستند. سلامت، طول ریشه و قدرت پریودنتال این دندان‌ها طول عمر درمان را تعیین می‌کند؛ چون کل فلسفه‌ی طراحی پارسیل، کنترل دقیق، توزیع و هدایت نیروهای اکلوزالی به همین پایه‌هاست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وسوسه‌ی دست نزدن به روکش قدیمی و کاهش هزینه‌ی بیمار بسیار بالاست؛ اما این تصمیم می‌تواند پایه‌ی کل درمان را متزلزل کند. روکش قدیمی روی دندان پایه حکم یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«اتاق تاریک»"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را دارد: تا از دهان خارج نشود، درباره‌ی این چهار متغیر نمی‌شود نظر قطعی داد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کیفیت و ارتفاع فرول"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Ferrule Effect"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "): آیا دندان باقی‌مانده فرول کافی برای تحمل نیروهای گشتاوری ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Torque"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ") و اهرمی پارسیل را دارد؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سلامت ساختار زیرین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " وضعیت عاج باقی‌مانده، پوسیدگی‌های ثانویه‌ی پنهان یا ترک‌های ریز در تاج و ریشه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کیفیت سمان و مهروموم آن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Seal"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "): آیا سمان قدیمی دچار انحلال یا واش‌اوت شده و خطر شست‌وشوی عاج زیرین وجود دارد؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شکل‌دهی اختصاصی برای پارسیل:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " امکان تراش دقیق رست‌سیت‌ها، گایدپلین‌ها و تغییرات لازم برای گیر و هدایت مناسب پارسیل روی روکش جدید."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:30e6a01e4bba90b8b853aa5a6f16420a8e43fb7cbc1e44613011bcfadfc1d3be",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "8845f3b92683e61c93d4d786817b7750d713af541c240880e1f814613ff434ac",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پروتکل سه‌گامی دندان پایه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تلاش برای صیانت از هزینه‌ی بیمار با حفظ روکش قدیمی روی دندان پایه، ممکن است به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شکست کامل درمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ختم شود. پروتز پارسیل نیروهای دینامیک سنگینی به دندان پایه وارد می‌کند؛ اگر پایه‌ی زیرین از نظر ساختاری مشکل‌دار یا ضعیف باشد، کل پروتز شکست خواهد خورد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پروتکل پیشنهادی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱. خارج کردن روکش قدیمی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " حتی با ظاهر سالم و رضایت بیمار، روکش قدیمی باید خارج شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲. ارزیابی بیومکانیک و ساختاری:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بررسی مجدد فرول، برداشتن تمام پوسیدگی‌ها و بازسازی مجدد کور در صورت نیاز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳. طراحی اختصاصی روکش جدید:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ساخت روکش جدید با پیش‌بینی دقیق رست‌سیت‌ها ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Rest Seat"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ")، گایدپلین‌ها ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Guide Plane"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ") و کانتور لازم برای بازوی گیردار ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Retentive Arm"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ")، مطابق با مسیر نشست ("
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "Path of Insertion"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ") پارسیل."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رست‌سیت‌ها، گایدپلین‌ها و کانتور بازوی گیردار تنها با طراحی اختصاصی روکش برای همان پارسیل قابل پیش‌بینی و اجرا هستند و در یک روکش معمولی لحاظ نمی‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "دندان پایه ستون اصلی سازه‌ی پارسیل است. کاهش هزینه با دست نزدن به روکش‌های قدیمی، ریسک شکست بیومکانیک کل درمان را بالا می‌برد؛ برداشتن روکش قدیمی، ارزیابی کیفیت فرول و ساخت روکش اختصاصی مطابق با طراحی پارسیل، تنها راه تضمین پیش‌بینی‌پذیری و طول عمر درمان است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
