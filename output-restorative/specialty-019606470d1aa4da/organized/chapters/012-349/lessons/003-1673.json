                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دهانشویه بر همه برتری دارد چون تماس آن با سطوح پروگزیمال ریشه از بقیه‌ی روش‌ها یکنواخت‌تر است و به همکاری کمتری از سوی بیمار نیاز دارد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
