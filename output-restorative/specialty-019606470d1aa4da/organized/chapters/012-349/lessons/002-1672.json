  "steps": [
    {
      "id": "theory:63c6f0cd0d653c28ed25de785eb7d9f8cee1f1a7ac58f5ce1e48dd3cf014f25a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f594abea6b6816b461d9881a177ece9307b8656cebbd8cbf3d1b7eb2726eebe8",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو ضایعه‌ی قهوه‌ای، دو تصمیم متفاوت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کیس:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی ریشه‌ی دو دندان یک بیمار، دو ناحیه‌ی قهوه‌ای می‌بینی که در عکس تقریباً شبیه هم‌اند. سوند را با فشار ملایم روی آن‌ها می‌کشی: یکی از سطح سالم اطراف سخت‌تر است و نوک سوند رویش سُر می‌خورد؛ دیگری چسبنده است و سوند کمی در آن گیر می‌کند. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کدام‌یک به تراش نیاز ندارد؟"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رنگ، شاخص قابل اعتمادی برای فعالیت نیست"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پژوهشگران کوشیده‌اند ضایعات را بر پایه‌ی رنگ دسته‌بندی کنند (روشن‌تر = فعال‌تر)، ولی نتایج متناقض بوده است. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "امروز رنگ را شاخص قابل اعتمادی برای فعالیت پوسیدگی نمی‌دانند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ضایعات تازه معمولاً نواحی کوچک زرد تا قهوه‌ای روشن‌اند. ضایعات پیشرفته قهوه‌ای تیره تا سیاه‌اند و اگر متوقف شده باشند، به سختی سطح سالم یا سخت‌تر از آن‌اند. پس رنگ سیاه، اگر سطح سخت باشد، اغلب نشانه‌ی "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "توقف"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ضایعه است نه پیشرفت آن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سختی سطح بهترین معیار بالینی موجود است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نرمی سطح را با یک وسیله‌ی دستی می‌سنجی. ضایعه‌ی فعال را «چسبنده» یا «چرمی» توصیف می‌کنند و هنگام بیرون کشیدن نوک سوند کمی مقاومت می‌کند. رنگ‌آمیزی با محلول‌های آشکارساز پوسیدگی هم روی سمنتوم و عاج نتیجه‌ی ثابتی نمی‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a6eae9ecaa3f179798459cca78bc1c356cfe3fecd27cc76a3bf11f531e7c3c9a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "7e6f65c975bdd3cb8bace322d70181518ce910e10a0b27a88f1d3c4602fbd6f3",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "معاینه‌ای که ضایعه را از دست نمی‌دهد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اول بیمار پرخطر را بشناس"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نخستین گام تشخیص، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شناختن زودهنگام بیمار پرخطر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، پیش از آنکه بیماری از نظر بالینی آشکار شود: عوامل مساعدکننده و عادت‌های بهداشتی او را بررسی کن تا معاینه‌ات هدفمند شود و بتوانی زودتر درمان پیشگیرانه را شروع کنی."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اول تمیزکاری، بعد قضاوت"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پلاک و دبری روی سطوح ریشه را می‌پوشانند؛ پس در بیمار پرخطر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از معاینه‌ی بالینی، یک پروفیلاکسی کامل انجام بده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". سپس لثه را با پوار به‌آرامی کنار بزن، با وسیله‌ی دستی کنار نگه دار، و از ترانس‌ایلومیناسیون، آینه‌ی نوردار و دوربین داخل‌دهانی کمک بگیر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوند را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با فشار ملایم تا متوسط"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به کار ببر. سطح ریشه ذاتاً از مینا نرم‌تر است و تفاوت سختی بافت سالم و پوسیده روی سمنتوم و عاج بسیار کمتر از مینا است. در یک مطالعه، خم کردن نوک سوند به زاویه‌ی ۳۰ درجه توان تشخیص پوسیدگی ریشه را بیشتر کرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "ضایعه‌ای که قرار است به‌جای ترمیم رمینرالیزه شود، نباید با سوند خراشیده یا سوراخ شود؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آسیب به سطح ضایعه، احتمال رمینرالیزاسیون را کم می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رادیوگرافی کمک می‌کند، ولی تصمیم را تعیین نمی‌کند"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رادیوگرافی برای یافتن ضایعات پروگزیمال اولیه‌ی ریشه مفید است، ولی آرتیفکت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برن‌اوت سرویکال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، یعنی ناحیه‌ی رادیولوسنت میان لبه‌ی مینا و کرست استخوان، گاهی به تفسیر نادرست می‌انجامد. در بیمارانی که از دست رفتن چسبندگی چشمگیر دارند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بایت‌وینگ عمودی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سطوح پروگزیمال ریشه را بهتر نشان می‌دهد. سامانه‌ی ICDAS، که حاصل همکاری بین‌المللی متخصصان تشخیص پوسیدگی است، برای پوسیدگی ریشه هم کد دارد؛ روش‌های مبتنی بر فلورسانس هم امیدبخش بوده‌اند."
                }
              ]
            }
          ]
        }
      ],
