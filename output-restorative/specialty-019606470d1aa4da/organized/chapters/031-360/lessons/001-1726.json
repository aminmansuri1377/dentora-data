  "title": "درس اول: دو تراش، دو سرنوشت",
  "specialtyKey": "019606470d1aa4da",
  "chapter": {
    "id": "360",
    "title": "اصول تراش و بیومکانیک",
    "position": 31
  },
  "position": 1,
  "importReady": true,
  "countsComparedWithConfiguredExpectation": false,
