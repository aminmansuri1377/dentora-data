  "steps": [
    {
      "id": "theory:0fe062db59ea04adddeb9b0af7665bdbd967ecc7abab6266393a51fd4cbf8c6b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "1b7196257e14aab411264c5262805567c97824d11f91c6afa39d4dfe55a91f4a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "یک بیمار، دو آمالگام، دو سرنوشت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک بیمار، دو مولر پایین، دو آمالگام دوسطحی که یک روز و با یک دست گذاشته شده‌اند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ده سال بعد یکی هنوز سر جایش است و دیگری در ماه چهاردهم از محل تنگه شکست و کاسپ لینگوال را هم با خودش برد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماده یکی بود. دست یکی بود. بیمار یکی بود. پس تفاوت کجا بود؟ در شکل تراش."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراش دندان یعنی تغییر مکانیکی یک دندان معیوب، آسیب‌دیده یا بیمار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به‌گونه‌ای که قرار دادن ماده‌ی ترمیمی، فرم و عملکرد و زیبایی طبیعی را برگرداند. و این کار همیشه چهار هدف را هم‌زمان دنبال می‌کند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حفظ بیشترین بافت سالم ممکن."
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دندان پیش از آنکه دستت به آن برسد ضعیف شده است؛ تو قرار نیست ضعیف‌ترش کنی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "برداشتن همه‌ی عیب‌ها"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، هم‌زمان با محافظت از مجموعه‌ی پالپ و عاج."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شکل‌دادن تراش"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " طوری که زیر نیروی جویدن، نه دندان بشکند، نه ترمیم، و نه ترمیم جابه‌جا شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فراهم‌کردن امکان قرار دادن زیبای ماده‌ی ترمیمی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آنجا که زیبایی مطرح است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و پوسیدگی تنها دلیل تراش نیست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان شکسته، ترمیم معیوب، دندان بدشکل یا بدجایگاه مادرزادی، و نیاز به بهبود زیبایی هم مداخله‌ی ترمیمی را ایجاب می‌کنند. به همین دلیل امروز به‌جای «تراش حفره» می‌گوییم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراش دندان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و هشداری که پایه‌ی همه‌ی این ماژول است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تراش یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برش جراحی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. کارهایی که در ماژول‌های اول انجام دادی درست بودند، چون این چهار هدف را با هم برآورده می‌کردند — نه چون شکلشان در یک الگوی آماده همان‌طور کشیده شده بود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:893a47d6ad8d0746dcaa8bd380363de56af0f9bda3e15d052b68da022c88de6a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5c75381d6735789aee041e88ad6b39770ef1227b49f4b619037dfa09c64a7177",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ماده پیش از فرز تصمیم گرفته است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا تراش آمالگام و تراش کامپوزیت شبیه هم نیستند؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چون بافت دندان طبیعی می‌تواند زیر بار دوره‌ای جویدن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خمش اندک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را بدون شکستن تحمل کند، و مواد ترمیمی این توانایی را به یک اندازه ندارند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مواد پلی‌کریستالین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مانند آمالگام، توانایی بسیار محدودی برای خمش بدون شکست دارند. بنابراین تراششان باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضخامت کافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از ماده را تضمین کند تا اصلاً خمشی رخ ندهد: به‌طور کلی حداقل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱٫۵ تا ۲ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". همین محدودیت است که گاهی تراش را وادار می‌کند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بافت سالم را هم عمداً بردارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — نه به‌خاطر بیماری، به‌خاطر ماده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مواد پلیمری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مانند کامپوزیت رزین، توان خمش بیشتری دارند و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حداقل ضخامت لازم ندارند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". پس تراششان عموماً فقط برداشتن بافت بیمار است و می‌تواند تا هر اندازه نازک باشد که برای بازسازی آناتومی لازم است. به همین دلیل تراش برای مواد پلیمری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ذاتاً کم‌تهاجمی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طراحی می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و قانون دیواره‌ی مینایی، برای هر دو یکسان است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جهت‌گیری دیواره‌ها دست‌کم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۹۰ درجه نسبت به سطح خارجی مینا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد تا پیوستگی با عاج حامی زیرین حفظ شود. دیواره‌ای از این دست، بار اکلوزالی را تحمل می‌کند. دیواره‌ی بادوام‌تر آن است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پریسم‌های تمام‌طول"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " داشته باشد که در سمت حفره با پریسم‌های کوتاه‌تر پشتیبانی شده‌اند. و هر جا پوسیدگی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اتصال مینا-عاج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را به خطر انداخته باشد، مینای سطحیِ بالای آن زیر بار دوره‌ای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مستعد شکست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ بیشتر طرح‌های تراش همان مینای بی‌تکیه‌گاه را برمی‌دارند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و دو واژه که محدوده‌ی کار را تعیین می‌کنند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تراش معمولاً به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تاج بالینی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " محدود می‌ماند، یعنی همان بخشی که در دهان نمایان است. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تاج آناتومیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چیز دیگری است: از خط سرویکال تا سطح اکلوزال یا لبه‌ی انسیزال، پوشیده از مینا. با تحلیل لثه، تاج بالینی بزرگ‌تر از تاج آناتومیک می‌شود و بخشی از ریشه را هم در بر می‌گیرد. تراشی که بخش بزرگی از سطح تاج بالینی را دست‌نخورده می‌گذارد "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داخل‌تاجی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ و هر جا تخریب شدید باشد و مینای باقی‌مانده بخش بزرگی از حمایت عاجی‌اش را از دست داده باشد، کار به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراش برون‌تاجی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌رسد که بافت باقی‌مانده را احاطه و تقویت می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
