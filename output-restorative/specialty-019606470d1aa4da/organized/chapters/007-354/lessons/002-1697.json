  "order": "first-encounter-with-remediation-visits-preserved",
  "steps": [
    {
      "id": "theory:1a24923df39f081ad56df103ab9d2d0a983ef3f9f4eeca0ce524c942539dbafd",
      "sourceId": "theory:1a24923df39f081ad56df103ab9d2d0a983ef3f9f4eeca0ce524c942539dbafd",
      "sourceProgress": "width: 0%;",
      "contentKey": "b53b6159beaae6d06a53b4e09e6f5bf3b625b901e8dc91ff7d3088b39fc089a0",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کیس: میان A2 و B2 مردد مانده‌ای"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سر یونیت، دو تب در دست داری و نمی‌توانی انتخاب کنی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یکی «کمی زردتر» است و دیگری «کمی روشن‌تر». مشکل اینجاست که با یک واژه‌ی کلی، «رنگ»، درباره‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه ویژگی مستقل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حرف می‌زنی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رنگ سه بعد دارد:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هیو (Hue)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": خانواده‌ی رنگ، مثل قرمز، زرد، سبز یا آبی. هیوها روی محیط یک دایره‌ی ۳۶۰ درجه قرار می‌گیرند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ولیو یا روشنایی (Value)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": تفاوت روشن و تیره. محور عمودی وسط دایره است؛ پایینش سیاه مطلق و بالایش سفید مطلق."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کروما (Chroma)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": تفاوت کم‌رنگ و پررنگ، یا رنگ‌پریده و اشباع. کروما فاصله از محور عمودی به سمت همان هیو است؛ هرچه دورتر، کروما بیشتر."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرق هیو و کروما:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هیو به "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رنگ‌های مختلف"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مربوط است و کروما به "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شدت یک رنگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ مثل قرمز کم‌رنگ در برابر قرمز پررنگ."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ویژگی‌های ظاهری جز رنگ:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اپسیتی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " توان ماده برای سد کردن عبور نور است و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترانس‌لوسنسی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درست عکس آن. ماده‌ی دارای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اپالسنس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " زیر نور بازتابیده آبی‌گون و زیر نور عبوری نارنجی یا قهوه‌ای دیده می‌شود. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فلورسنس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی ماده نور را جذب کند و خودبه‌خود نوری با طول موج بلندتر گسیل کند؛ زیر نورهای اصلاح‌شده‌ی مطب معمولاً دیده نمی‌شود و زیر نور فرابنفش (مثلاً «نور سیاه» یا نور خورشید) پیدا می‌شود. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایریدسنس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جلوه‌ی رنگین‌کمانیِ وابسته به زاویه است و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گلاس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " براقیت سطح."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:1fe319f2d978fd6e355860cd3568269088a93efe4e0d0595f859515270373ede",
      "sourceId": "theory:1fe319f2d978fd6e355860cd3568269088a93efe4e0d0595f859515270373ede",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "e1af1540b887aa247d590b9dbc26460f4d5e29008c83ff130fc58f34ece6eda7",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "نظام‌های نمادگذاری و راهنماهای شید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نظام‌های نمادگذاری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در گذشته نظام هیو-ولیو-کرومای مانسل و دو فرمول CIE، یعنی CIE سال ۱۹۳۱ (xyY) و CIE سال ۱۹۶۴ (XYZ)، در دندانپزشکی به کار رفته‌اند. امروز پرکاربردترین نظام "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "CIELAB"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. مختصات قائم آن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "L*"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (روشنایی)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "a*"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (منفی سبز، مثبت قرمز) و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "b*"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (منفی آبی، مثبت زرد) است و مختصات قطبی‌اش L*، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "C*ab"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (کروما، فاصله از محور) و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "hab"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (هیو، زاویه روی صفحه‌ی افقی)."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اختلاف رنگ در CIELAB با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ΔE*ab"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشان داده می‌شود؛ E از واژه‌ی آلمانی "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Empfindung"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به معنی «حس» می‌آید. این عدد همه‌ی ابعاد رنگ را در بر می‌گیرد و هم از تفاوت‌های L*a*b* و هم از تفاوت‌های روشنایی، کروما و هیو محاسبه می‌شود. فرمول تازه‌تر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "CIEDE2000"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اختلاف را با ΔE’ نشان می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "VITA Classical"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از ۱۹۵۶ در دسترس است و شید بیشتر کامپوزیت‌ها بر پایه‌ی آن نام‌گذاری شده است. در چیدمان A تا D، گروه‌ها بر پایه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "A قرمز، B زرد، C خاکستری، D قرمزِ خاکستری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". درون هر گروه، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدد بزرگ‌تر یعنی کرومای بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (B4 اشباع‌تر از B1). چیدمان دوم، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مقیاس ولیو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، تب‌ها را از روشن به تیره (از B1 تا C4) می‌چیند و تنها دستورش این است: «بهترین تطبیق کلی را انتخاب کن.» این چیدمان اغلب برای پایش چشمی بلیچینگ به کار می‌رود و نتیجه بر حسب "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "واحد راهنمای شید (SGU)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گزارش می‌شود، هرچند ترتیب و توزیع ناهموار رنگ‌هایش دقت آن را کم می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "VITA 3D-Master:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نام هر تب ترکیب "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدد-حرف-عدد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدد اول = ولیو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (۰ روشن‌ترین تا ۵ تیره‌ترین)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حرف = هیو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (L زردگون، M متوسط، R قرمزگون) و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدد آخر = کروما"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (۱ کمترین تا ۳ بیشترین). دو نیاز اصلی هر راهنمای شید، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترتیب منطقی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "توزیع رنگی کافی در فضای رنگ دندان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و این راهنماها هر دو را بهتر از بقیه دارند؛ پس احتمال یافتن تطبیق خوب با آن‌ها از همه بیشتر است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Toothguide:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سه گام دارد. در گام اول با همه‌ی تب‌ها روشنایی تعیین می‌شود و ۲۹ شید به چند تب کاهش می‌یابد؛ کروما و هیو در دو گام جداگانه‌ی بعدی. تغییرات کروما در هر گروه عمودی است و تغییرات هیو فقط در گروه‌های ۲، ۳ و ۴ وجود دارد. این روش برای کم‌تجربه‌ها دشوار است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Linearguide:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " همان تب‌ها با چیدمانی دیگر. در گام اول فقط یک ردیف خطی از تب‌های میانی هر گروه (شش تب) به کار می‌رود؛ گام دوم تنظیم دقیق درون همان گروه است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Bleachedguide:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نخستین راهنمایی که برای ارزیابی چشمی بلیچینگ ساخته شد؛ ۲۹ واحد دارد، دامنه‌ی رنگی گسترده‌تر و توزیع یکنواخت‌تری از VITA Classical دارد و شیدهای بسیار روشن را هم پوشش می‌دهد."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
