  "title": "درس دوم: زبان رنگ — هیو، کروما، ولیو و ترانس‌لوسنسی",
  "specialtyKey": "019606470d1aa4da",
  "chapter": {
    "id": "354",
    "title": "لایه‌گذاری، رنگ و پرداخت کامپوزیت",
    "position": 7
  },
  "position": 2,
  "importReady": true,
  "countsComparedWithConfiguredExpectation": false,
  "sourceSessionFinished": true,
