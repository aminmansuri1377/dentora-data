                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اثر رنگ‌های اطراف را بسیار کم می‌کند، به‌ویژه اگر چراغ سقفی خاموش باشد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۳"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دمای رنگ نور را گرم‌تر می‌کند و در نتیجه هیوی دندان را به گروه قرمز نزدیک‌تر نشان می‌دهد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۴"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیاز به وارسی شید زیر نورهای دیگر را از بین می‌برد"
                    }
                  ]
                }
              ]
            }
          ]
        }
