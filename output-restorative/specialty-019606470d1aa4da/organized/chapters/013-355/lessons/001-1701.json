  "title": "درس اول: پوسیدگی عمیق — بردارم یا نگه دارم؟",
  "specialtyKey": "019606470d1aa4da",
  "chapter": {
    "id": "355",
    "title": "پالپ را زنده نگه دار، عمق پوسیدگی و حذف انتخابی",
    "position": 13
  },
  "position": 1,
  "importReady": true,
