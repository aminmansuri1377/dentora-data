    {
      "id": "question:31975",
      "sourceId": "31975",
      "identityOrigin": "source-question-id",
      "sourceProgress": "width: 42.8571%;",
      "contentKey": "5710bd74729a2940a8946ad22776193ea0813c5442bb4a861e7b1b997c395212",
      "position": 4,
      "kind": "question",
      "type": "single-choice",
      "prompt": "بیمار با ترشح بزاقی پرحجم و تحمل پایین برای رابردم مراجعه کرده و ضایعه‌ی کلاس III کوچکی در لترال دارد. کدام ضعف کامپوزیت در این کیس از همه مهم‌تر است؟",
      "sourceContent": [
        {
          "tag": "div",
          "attributes": {},
          "children": [
