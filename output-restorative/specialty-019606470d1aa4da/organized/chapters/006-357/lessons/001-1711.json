  "title": "درس اول: کیس قدامی — مستقیم یا غیرمستقیم؟",
  "specialtyKey": "019606470d1aa4da",
  "chapter": {
    "id": "357",
    "title": "ترمیم‌های مستقیم قدامی: کلاس III، IV و V",
    "position": 6
  },
  "position": 1,
  "importReady": true,
  "countsComparedWithConfiguredExpectation": false,
