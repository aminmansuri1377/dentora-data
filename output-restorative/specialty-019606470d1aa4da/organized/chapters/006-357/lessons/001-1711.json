  "steps": [
    {
      "id": "theory:963da9dea5db28e7443b5fe5b56cf658beab90ad7f25740b34b53ba0a51dc792",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "04bf5d8c33aca5bd560366a42b3ad661e5fb8f9f3f0ab313aea9e9e3f49ff494",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دختر ۱۹ ساله، گوشه‌ی سانترال شکسته"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیروز افتاده و گوشه‌ی مزیوانسیزال سانترال بالا شکسته."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پالپ درگیر نیست، پوسیدگی ندارد. همراهش می‌پرسد: «روکش بگذاریم که دیگر نشکند؟»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پاسخ بالینی: نه."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دلیلش هم هزینه نیست. بافتی که برای تراش یک ترمیم غیرمستقیم برداشته می‌شود، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هرگز برنمی‌گردد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". ترمیم مستقیم کامپوزیت امروز بدون برداشتن بافت سالم، شکل و رنگ را برمی‌گرداند؛ و اگر سال‌ها بعد لازم شد، می‌شود آن را با درمان ماندگارتری عوض کرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کامپوزیت پرکاربردترین ماده‌ی ترمیمی مستقیم در دندان‌های قدامی است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در میان مواد مستقیم، بهترین ترکیب حفظ بافت، زیبایی و دوام را دارد. کاربردش هم فقط پوسیدگی نیست: دیاستم، لترال میخی‌شکل و دندان‌های بدفرم یا بدرنگ را هم با آن درمان می‌کنیم."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی شش ضعف دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هنگام پلیمریزاسیون انقباض پیدا می‌کند، برای باند درست به ایزولاسیون خوب نیاز دارد، مقاومت سایشی‌اش از سرامیک کمتر است، مستعد لب‌پریدگی است، به عاج و سطح ریشه به‌خوبیِ مینا باند نمی‌شود، خاصیت ضدباکتریایی ندارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:95a2ff75210fb67c490db14ddecaaa075f3dbe0975a4999f32e9e824cbdc514a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "eb58daa66d638d596035770ebe90c61a523ba408c0ddb55e49c2084ecaa78ecf",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چند سال دوام می‌آورد، و چه چیزی خرابش می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عددی که باید در ذهنت باشد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بین "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶۰ تا ۸۰ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیم‌های کلاس III و کلاس V قدامی پس از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵ سال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هنوز قابل‌قبول‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلاس IV استثناست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیم کلاس IV روی دندان شکسته "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمر کوتاه‌تری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از کلاس III و V دارد، چون "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بار اکلوزال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیشتری تحمل می‌کند. برای همین در کلاس IV باید دقت بیشتری به خرج دهی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پنج علت شایع تعمیر یا تعویض ترمیم قدامی:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رنگ‌گرفتگی حاشیه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تغییر رنگ سطح"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوسیدگی ثانویه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لب‌پریدگی لبه در نواحی پرتنش"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شکست خود ترمیم"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و چهار متغیری که بیش از همه بقای ترمیم قدامی را تعیین می‌کنند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خودِ درمانگر، محل و اندازه‌ی ترمیم، سن بیمار و ریسک پوسیدگی او، سوبسترایی که به آن باند می‌کنی. سه متغیر آخر کاملاً دست تو نیست؛ اولی هست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ونیر: مستقیم یا سرامیکی؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ونیر سرامیکی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استاندارد طلایی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " زیبایی و طول عمر است. ونیر کامپوزیت مستقیم در عوض محافظه‌کارانه‌تر است، در یک جلسه و بدون لابراتوار انجام می‌شود، هزینه‌ی کمتری دارد، دندان مقابل را زودتر از موعد نمی‌ساید و به‌راحتی تعمیر می‌شود. ولی ظاهرش را به‌خوبیِ سرامیک حفظ نمی‌کند و زمان کار روی صندلی هم کم نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ریسک بیمار هم انتخاب ماده را عوض می‌کند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وقتی حاشیه‌ی لثه‌ای روی سطح ریشه است و مینایی برای باند نمانده: در بیمار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرخطر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌توان بخش سرویکال را با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "RMGI"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پر کرد و بقیه را با کامپوزیت ("
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساندویچ باز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "). این روش حساسیت پس از ترمیم را کم می‌کند و از حاشیه‌ی عاجی در برابر دمینرالیزاسیون محافظت می‌کند. در بیمار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کم‌خطر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، یک سیستم باندینگ عاجی معتبر و کامپوزیت کافی است و آندرکات مکانیکی لازم نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درباره‌ی اثر مواد رهاکننده‌ی فلوراید بر پوسیدگی ثانویه، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شواهد قطعی نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". با این حال، در بیماران پرخطر مبتلا به خشکی دهان، کنار ترمیم‌های RMGI پوسیدگی کمتری دیده شده است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
