  "steps": [
    {
      "id": "theory:1e73187fbd1dda1ca59e2830d6957563a510c475827f7cc44c8aca29e10ecb8c",
      "sourceId": "theory:1e73187fbd1dda1ca59e2830d6957563a510c475827f7cc44c8aca29e10ecb8c",
      "sourceProgress": "width: 0%;",
      "contentKey": "71ba8b5b43a52302bf4a3b81b31ee6fd862934062d597c839b26f80f7478ab1b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو دندانپزشک، یک ضایعه، دو لبخند متفاوت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیستال لترال بالا یک ضایعه‌ی پروگزیمال دارد که به عاج رسیده."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یک دندانپزشک از لینگوال وارد می‌شود و مینای فاسیال را دست‌نخورده نگه می‌دارد؛ دیگری از فاسیال وارد می‌شود چون «دیدش بهتر است». شش ماه بعد، ترمیم دوم هنگام حرف زدن دیده می‌شود و ترمیم اول نه."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی اصلی این تراش:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خط محیطی ترمیم کامپوزیت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقص‌محور"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ یعنی فقط "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گستره‌ی ضایعه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دسترسی لازم برای برداشتن عاج پوسیده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آن را تعیین می‌کنند. گسترش بیشتر لازم نیست و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشتن بافت سالم برای ساختن آندرکات مکانیکی منع دارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل ضایعه شکل تراش را تعیین می‌کند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پوسیدگی پروگزیمال معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمی جینجیوال‌تر از نقطه‌ی تماس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ پس تراش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از زیر نقطه‌ی تماس به سمت جینجیوال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گسترش می‌یابد و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بخش انسیزالی تماس لزوماً برداشته نمی‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این را همیشه به خاطر داشته باش:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مینای طبیعی از زیباترین ماده‌ی ترمیمی هم طبیعی‌تر به نظر می‌رسد. پس تراش کلاس III "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نباید به سطح فاسیال کشیده شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، مگر آنکه مینای همان سطح پوسیده یا از دست رفته باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر ماده RMGI باشد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (مثلاً در بیمار پرخطر): تراش شبیه تراش کامپوزیت است ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بول زده نمی‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". این ماده به مینا و عاج باند می‌شود، پس شیار یا نقطه‌ی گیر هم لازم نیست؛ تنها دلیل برداشتن بافت سالم، باز کردن دسترسی برای برداشتن عاج پوسیده است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:cda4a5f369bda94cbed05d99d1e83d6b3a236d944dbbed2032d011439a9516c3",
      "sourceId": "theory:cda4a5f369bda94cbed05d99d1e83d6b3a236d944dbbed2032d011439a9516c3",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "9416614ec66cddb084ddbb117b2edc686c441c5d9cbedc128ee7cde32e078300",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تراش نعلبکی، مینای بی‌تکیه‌گاه و بحث بول"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی ضایعه به مینا محدود است،"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با فرز گرد یا الماسی و توربین تراش می‌دهی و حفره شبیه یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نعلبکی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شود، بدون هیچ آندرکاتی. گیر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باند به مینا و عاج اچ‌شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌آید. دوام همین تراش نعلبکی‌شکل در مطالعات آزمایشگاهی و در پیگیری بالینی سه‌ساله نشان داده شده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسیر دسترسی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در ترمیم‌های بزرگ‌تر کلاس III، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دسترسی لینگوالی ارجح"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. نفوذ اولیه را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از مارجینال ریج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نزدیک دندان مجاور"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام بده، بی‌آنکه به آن آسیب بزنی. تعداد فرزها را کم نگه دار: فرز گرد شماره‌ی ۲ یا فرز گلابی کارباید یا الماسی با توربین برای دسترسی کافی است. عاج دمینرالیزه را با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکسکاواتور قاشقی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا فرز گرد بزرگ با آنگل (سرعت پایین) بردار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دسترسی فاسیال فقط دو اندیکاسیون دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ضایعه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از قبل سطح فاسیال را درگیر کرده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد، یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان مجاور روی این دندان افتاده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و راه لینگوال را بسته باشد. در این حالت هم خط محیطی را تا حد ممکن محافظه‌کارانه نگه دار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مینای فاسیالِ بی‌تکیه‌گاه را برندار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌توانی آن را نگه داری و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از داخل اچ و باند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کنی. این یکی از تفاوت‌های اصلی ترمیم باندشونده با ترمیمی است که گیرش مکانیکی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بحث بول:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بول را برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کم کردن شکست مینا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انتقال تدریجی رنگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیشنهاد کرده‌اند. ولی باند به مینا از نظر بالینی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدون بول هم کافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و در ریزنشت حاشیه‌ای کلاس III، بین حاشیه‌ی بول‌دار و بدون بول "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تفاوت معناداری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیده نشده. پس بول بیشتر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای زیبایی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است تا گیر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "از بول خیلی پهن پرهیز کن؛ ولی وقتی حداکثر زیبایی لازم است، بول فاسیال را می‌توان تا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ میلی‌متر یا بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ادامه داد. یک استثنا: اگر بول، مینای سرویکال را از بین ببرد و حاشیه را به عاج یا نزدیک آن برساند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در ناحیه‌ی سرویکال بول نزن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماتریکس و وج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ماتریکس رایج کلاس III "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوار ماتریکس شفاف پلاستیکی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. وج چوبی میان دندان‌ها و روی ماتریکس پنج کار می‌کند: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حاشیه‌ی جینجیوال را سیل می‌کند، دندان‌ها را کمی از هم جدا می‌کند، از لثه‌ی بین‌دندانی محافظت می‌کند، تماس پروگزیمال کافی را تضمین می‌کند و رابردم و بافت را به سمت جینجیوال می‌راند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". نوار شفافی که درست وج شده باشد، اضافه‌ی ماده (فلش) را در حاشیه‌ی جینجیوال کم می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وج همیشه لازم نیست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر رابردم خوب نشسته باشد، معمولاً به حاشیه‌ی جینجیوال دسترسی مستقیم داری و بدون وج هم می‌توانی کامپوزیت را بگذاری و حاشیه را سیل کنی؛ لیگاتور نخ دندان با راندن رابردم و لثه به سمت اپیکال به این دسترسی کمک زیادی می‌کند. اگر وج ماتریکس را تغییر شکل دهد یا کانتور سرویکال را خراب کند، آن را نگذار، یا تا پس از گذاشتن و کیور کردن اولین لایه‌ی سرویکال صبر کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
