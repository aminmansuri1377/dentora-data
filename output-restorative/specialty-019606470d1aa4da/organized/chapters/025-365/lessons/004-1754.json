  "steps": [
    {
      "id": "theory:fd9e934f8517f42f3c66b4f3eaccf3766433aa1096209f19f300adfb318e6de6",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "fd890ee56133f60b254d150c9dfd010f8ec8fcf22375abaf3182a3884b709852",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "یک نقص پوسیده در لبه‌ی یک ترمیم خوب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنله‌ی کامپوزیتی مولر اول بالا از هر جهت خوب است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، جز یک نقص پوسیده‌ی کوچک در لبه‌ی باکال. تعویض کامل یعنی تراش بیشتر، هزینه‌ی بیشتر و ریسک بیشتر برای پالپ."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر ترمیم یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقص پوسیده‌ی منفرد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشت کامل پوسیدگی تأیید شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، ترمیم همان ناحیه بدون تعویض کل ترمیم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قابل‌قبول و اغلب ارجح"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. بازسازی کانتور یا روکش‌کردن سطح ترمیم موجود هم می‌تواند تعویض را به تأخیر بیندازد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تعمیر و بازسطح‌سازی کامپوزیت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تعمیر ترمیم‌های ریختگی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مؤثر نشان داده شده‌اند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آمالگام با نقص موضعی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " با آمالگام یا رزین سیلانت تعمیر می‌شود. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سیل‌کردن درزهای غیرپوسیده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "ی آمالگام با کامپوزیت فلو یا سیلانت، عمر ترمیم را بلندتر می‌کند. سیل‌کردن ترمیم همراه با پیت‌وفیشورهای اطرافش هم بافت سالم را حفظ و لبه‌ها را محافظت می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعمیر، سیل یا تعویض کامپوزیت با لبه‌ی معیوب، عمر ترمیم را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "به‌طور معنادار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بهتر می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطر:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در بیمار پرخطر، احتمال پوسیدگی عودکننده کنار کامپوزیت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم دو برابر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آمالگام است. تعمیر بدون کنترل ریسک، فقط ساعت را عقب می‌کشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a82e32e26a528ac62b431f009bc6b008e73c014cfa266376eec0d766bfdf6315",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5d1115589d8e5240e8337fac98b4c9e92c0ed72b200e5b2cf978819cd805b824",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تکنیک تعمیر، و وقتی باید کل ترمیم برود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعمیر کامپوزیت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ناحیه‌ی در دسترس را با فرز الماسی زبر کن، اچ کن، ادهزیو مناسب بزن، کامپوزیت بگذار، فرم بده و پرداخت کن. اگر نقص در دسترس نیست، تراشی بساز که ناحیه را آشکار کند؛ ممکن است ماتریکس لازم شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفره‌ای که بلافاصله پس از گذاشتن دیدی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر هنوز فرم‌دادن شروع نشده و ایزولاسیون حفظ شده، کامپوزیت را مستقیم اضافه کن — "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لایه‌ی مهارشده با اکسیژن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باند را ممکن می‌کند. اگر فرم‌دادن انجام شده، سطح را با یک چرخه‌ی کوتاه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اچ و شست‌وشو و ادهزیو دوباره"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «تازه» کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خط سفید کنار لبه‌ی مینایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جدایی ریز یا ترک ریز مینای لبه (اچ و باند ناکافی، کیور پرشدت و سریع، پرداخت خشن). برخی را فقط پایش کن؛ بقیه را با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیل‌کردن با ادهزیو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشت محافظه‌کارانه و ترمیم دوباره"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اصلاح کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعمیر آمالگام سخت‌شده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ناحیه را مثل یک ترمیم کوچک دوباره تراش بده، با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمق و گیر کافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — گاهی تماماً درون خود آمالگام قبلی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از ترمیم بزرگ، تکلیف پالپ را روشن کن."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر پیش‌آگهی پالپ نامشخص است، درمان ریشه پیش از ترمیم بهتر است؛ وگرنه ممکن است مجبور شوی ترمیم تازه را برای دسترسی باز کنی. و وقتی تست سرما و تست الکتریکی تصویر روشنی نمی‌دهند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفره‌ی آزمون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — شروع تراش بدون بی‌حسی — حیات پالپ را نشان می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعویض کامل آمالگام وقتی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حفره‌ی لبه‌ای تعمیرنشدنی به‌ویژه در یک‌سوم لثه‌ای، کانتور پروگزیمال نامناسب یا اورهنگ عامل تخریب پریودنتال، ناهماهنگی مارجینال ریج با گیر غذا، اوورکانتور باکال یا لینگوال، تماس باز یا نادرست، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوسیدگی عودکننده‌ای که با تعمیر درمان‌شدنی نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، دیچینگ عمیق‌تر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰٫۵ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای ترمیم هم‌رنگ:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کانتور تعمیرنشدنی، حفره‌ی بزرگ، رنگ‌گرفتگی عمیق لبه، پوسیدگی عودکننده، زیبایی غیرقابل‌قبول."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
