  "steps": [
    {
      "id": "theory:dffc7c52b0160d4263b55c26b317d6826f4b1c2f6203d8d771d32de139c43c3e",
      "sourceId": "theory:dffc7c52b0160d4263b55c26b317d6826f4b1c2f6203d8d771d32de139c43c3e",
      "sourceProgress": "width: 0%;",
      "contentKey": "aa10956be447b1014aab9aee16a178a4a70402248c595e433da0eef38b6dc017",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پرسلن شکست. تقصیر لابراتوار بود؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنله‌ی سرامیکی مولر اول بالا، چهارده ماه پس از چسباندن، از ناحیه‌ی فوسای مرکزی ترک برداشته."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیمار برکسیسم ندارد، تماس‌ها متعادل‌اند و سمان رزینی دوال‌کیور بوده. عکس قدیمی تراش را باز می‌کنی: ضخامت سرامیک در فوسای مرکزی کمتر از یک میلی‌متر بوده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لابراتوار هیچ کاری نمی‌توانست بکند. ضخامت سرامیک را "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تعیین کرده‌ای، نه تکنسین."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عددهایی که ضخامت را تضمین می‌کنند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاهش اکلوزال باید یکنواخت باشد و دست‌کم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱٫۵ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در فوسای مرکزی و روی کاسپ غیرعملکردی و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی کاسپ عملکردی فضا بدهد. استحکام نهایی یک ماده‌ی ترمیمی معمولاً یک خاصیت فیزیکی ذاتی تصور می‌شود، در حالی که وابسته است: دست دندانپزشک آن را جابه‌جا می‌کند. بحرانی‌ترین بُعد برای استحکام، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضخامت اکلوزال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و نازک‌تر از توصیه‌ی سازنده، بی‌استثنا استحکام کمتر و خطر شکست بیشتر می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و ایسموس را فراموش نکن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عرض فاسیولینگوال ایسموس تراش باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم ۲ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد، وگرنه اینله یا آنله از همان‌جا می‌شکند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:6726c513be0b0e9e96dbd679d6e2274fe3ddae06e10c58bac7719d3dcea235f7",
      "sourceId": "theory:6726c513be0b0e9e96dbd679d6e2274fe3ddae06e10c58bac7719d3dcea235f7",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "0f3884b27d7e8f3caefce9c9990d30272396f766478219025b3ebbec6be847be",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آندرکات، زاویه‌ی تیز، و دو واژه‌ای که فقط در دنیای دیجیتال معنا دارند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراشی که برای چشم بی‌عیب است، می‌تواند برای فرز میلینگ غیرقابل‌ساخت باشد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دو واژه این را توضیح می‌دهند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اُورمیلینگ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — دستگاه ناچار می‌شود ماده‌ی بیشتری از سطح داخلی ترمیم بتراشد تا ترمیم کامل بنشیند؛ نتیجه، ترمیمِ نازک‌تر از طراحی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آندرمیلینگ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — هر هندسه‌ای که از قطر خودِ ابزار میلینگ کوچک‌تر باشد اصلاً برداشته نمی‌شود؛ ماده‌ی باقی‌مانده نمی‌گذارد ترمیم کامل بنشیند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پادزهر هر دو یکی است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کانتور نرم، منحنی‌های روان و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گرد کردن همه‌ی زوایای گذر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". زاویه‌ی داخلی تیز، فرورفتگی و تقعر ناگهانی در سطح داخلی تراش، همان‌جاهایی‌اند که انطباق داخلی را خراب می‌کنند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آندرکات، اشتباه رایج خودش را دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دوربین دیجیتال آندرکات را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با دقت ثبت می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و آن را در مدل مجازی نشان می‌دهد، ولی فرایند میلینگ آن را بازتولید نمی‌کند؛ پس آن فضا در نهایت با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پر می‌شود. بلاک‌اوت آندرکات "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داخل نرم‌افزار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " توصیه نمی‌شود، چون مدل دیجیتال را دستکاری می‌کند و به بی‌دقتی داخلی می‌انجامد؛ اگر بلاک‌اوت لازم است، آن را با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماده‌ی جایگزین عاج و پیش از اسکن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام بده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و منطق نگه‌داشتن ترمیم، هندسه را عوض می‌کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در آنله‌ی سرامیکی ماشینی، گیر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چسبندگی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌آید نه از هندسه؛ پس نوار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرول"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و دیواره‌های موازیِ کست طلا اینجا جا ندارند — یا ترمیم نمی‌نشیند یا سطح داخلی بیش از اندازه تراشیده و نازک می‌شود. در لبه هم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بول و نایف‌اج ممنوع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "اند، چون لبه‌ی نازک سرامیک می‌پرد؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اتصال سربه‌سر ۹۰ درجه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترجیح دارد. اگر برای زیبایی به گذار نرم رنگ در سطح فاسیال نیاز داری، همان اتصال سربه‌سر را با فرز الماسی فوتبالی و زاویه‌ی حدود ۴۵ درجه اصلاح کن تا ضخامت سرامیک تدریجی شود ولی لبه حجیم بماند."
                }
              ]
            }
          ]
        }
      ],
