  "steps": [
    {
      "id": "theory:6dace22d8d0aa46650a96ea7f3f6e3ddf82ffd3d7fd8c284644e393a639cd73f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "9aecaaa621ef1dedd226a4e0ef96db9be5285655dca8ac404ac5886c09fe7638",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "موقت برای سومین بار افتاد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار برای سومین بار در ده روز با موقتِ افتاده در دستش برگشته."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عیب از دست تو نیست؛ از خودِ طراحی تراش است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترمیم موقت روی اینله و به‌ویژه آنله‌ی زیبایی یک چالش واقعی است، چون تراش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمداً غیرگیرنده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طراحی شده. در تراش ادهزیو، گیر و مقاومت را قرار است "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چسبندگی به مینا و عاج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بدهد، نه هندسه؛ ولی موقت هنوز چسبانده نشده و باید با همان هندسه‌ی بی‌گیر سر کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهار راهکاری که کار می‌کنند:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سمان موقتِ گیرنده‌تر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " به‌دلیل طراحی غیرگیرنده‌ی تراش آنله، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پلی‌کربوکسیلات"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سمان موقت انتخابی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آندرکات مکانیکی کوچک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " روی سطح داخلی (اینتاگلیو) خود موقت."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اتصال موقت‌های مجاور به هم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، اگر دندان‌های کناری هم در حال ترمیم‌اند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اسپات‌اچ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یک ناحیه‌ی داخلی محدود و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دور از همه‌ی مارجین‌ها"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را با اسید فسفریک اچ کن و موقت را همان‌جا بچسبان."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بهای اسپات‌اچ را بپرداز:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس از برداشتن موقت، ممکن است به فرز الماسی فینیشینگ نیاز داشته باشی تا آن ناحیه‌ی چسبیده برداشته شود و پیش از تحویل ترمیم، ادهزیو کاملاً از سطح تراش پاک شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:32ae2d2b61ecfe729087ba5b6b1f856be526be5c49aa08b203296d0582755057",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "6c08bd75c637dc554d16bdb264680f5a0623c9c7610306577ead423e383c899f",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "از استنت تا پالپ: ترتیبی که حساسیت را کم می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترتیب کارها خودش یک تکنیک است:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رنگ را پیش از دهیدراته‌شدن دندان انتخاب کن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، سپس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استنت ساخت موقت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را بگیر، و بعد سراغ برداشتن پوسیدگی و ترمیم قدیمی برو. اگر ترتیب را جابه‌جا کنی، دندانِ خشک‌شده رنگ واقعی‌اش را نشان نمی‌دهد و استنتی هم برای بازسازی آناتومی باقی نمی‌ماند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "موقت را چطور بسازی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " موقت را می‌توان به روش معمول با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آکریل یا کامپوزیت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ساخت و با سمان موقت چسباند. برای تراش‌های اینله، مواد "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیمه‌منعطف لایت‌کیور"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم هستند: پرایمر عاجی را در تراش بگذار و هوا خشک کن، یا مقدار کمی لاینر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گلاس‌آینومر اصلاح‌شده با رزین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی کف پالپال بگذار و پلیمریزه کن؛ سپس تراش را با ماده پر کن، از بیمار بخواه در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حداکثر بین‌کاسپی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ببندد تا اکلوژن شکل بگیرد، زیادی را با سوند بردار و ماده را کیور کن. این روش فقط برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کوتاه‌مدت و در تراش‌های کوچک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " توصیه می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو باور که باید تصحیح شوند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیس گلاس‌آینومر روزگاری برای محافظت عاج و «ایده‌آل‌سازی» فرم تراش گذاشته می‌شد؛ امروز روشن است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیازی به محافظت عاج در برابر اسید فسفریک نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و گلاس‌آینومر فقط برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بلاک‌اوت آندرکات"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جا دارد. و درباره‌ی اوژنول: مشهور است که سمان موقت اوژنول‌دار نباید با ترمیمی که قرار است با سمان رزینی باند شود به کار رود، ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ادبیات علمی دوپهلو است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — بخشی از مطالعات مهار ست رزین را تأیید می‌کنند و بخشی هیچ اثری بر استحکام باند نشان نداده‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه نکته‌ی کوتاه که در انتخاب موقت کارت را راه می‌اندازند:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بلوک‌های ماشینی موقت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از پیش در کارخانه پلیمریزه شده‌اند، پس لایه‌ی مهارشده با اکسیژن و انقباض پلیمریزاسیونِ آکریل سلف‌کیور یا لایت‌کیور را ندارند و برای موقت‌های بلندمدت و حتی چندواحدی مناسب‌اند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانتور کمتر از حد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، برخلاف اورکانتور، معمولاً از نظر زیستی تحمل می‌شود، و در مسیر کامل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چیرساید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اصلاً دوره‌ی موقتی در کار نیست، چون قالب سنتی، موقت و جلسه‌ی دوم حذف می‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و پیش از هر تراش برای ترمیم ریختگی:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وایتالیتی پالپ را تست کن و رادیوگرافی بگیر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". پالپی که پیش‌تر با پوسیدگی و ترمیم‌های مکرر ضربه خورده، ممکن است با ترومای خودِ تراش نکروز شود. اگر وایتالیتی مشکوک بود، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ تا ۶ ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بعد دوباره ارزیابی کن؛ و اگر کار به درمان ریشه کشید، انجامش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیم غیرمستقیم آسان‌تر، پیش‌بینی‌پذیرتر و برای بیمار اقتصادی‌تر است. درمان ریشه از داخل ترمیم نهایی، گیر تاج را کم و نشت مارجینال و پوسیدگی عودکننده را زیاد می‌کند. بهترین محافظ پالپ هم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لایه‌ی ضخیم عاج سالم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: زیر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عاج باقی‌مانده، واکنش پالپی برانگیخته می‌شود و اگر عاج خیلی نازک بود، سیلر یا لاینر بگذار و پیش از چسباندن ترمیم نهایی یک دوره‌ی مشاهده بگذران تا مطمئن شوی دندان بی‌علامت می‌ماند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
