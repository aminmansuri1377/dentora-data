                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کم کردن مقدار سمان موقت تا لایه نازک‌تر و گیر بیشتر شود"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۴"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زدن وازلین روی تراش پیش از سمان‌کردن تا موقت بهتر بنشیند"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [
        {
          "id": "ec067cc01c9cbd97058c5d95b2942fbf11ce0238863075f4a7ad62f63637b73c",
