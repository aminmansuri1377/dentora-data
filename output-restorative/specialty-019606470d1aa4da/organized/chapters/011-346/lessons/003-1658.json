  "steps": [
    {
      "id": "theory:86933311aa4d78bc90c95cf68f240c3cd52710018832858799f89e11e269c057",
      "sourceId": "theory:86933311aa4d78bc90c95cf68f240c3cd52710018832858799f89e11e269c057",
      "sourceProgress": "width: 0%;",
      "contentKey": "0b2d54dbb136e70ec3829c07f8e192550fd7546b5fe8f51413f566437c41da9d",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "یک خط، پنج ماده"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "نماینده‌ی شرکت سه محصول روی میزت می‌گذارد و می‌گوید هر سه «فلوراید آزاد می‌کنند». این جمله درست است، ولی کمکی به انتخاب نمی‌کند؛ چون رهایش فلوراید در دو سر این خانواده چند برابر تفاوت دارد. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تا ندانی هر ماده کجای این طیف است، نمی‌توانی آگاهانه انتخاب کنی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "طیف مواد رهاکننده‌ی فلوراید"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این مواد بر اساس شباهت خواص فیزیکی، مکانیکی و نحوه‌ی ست در پنج دسته قرار می‌گیرند: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کامپوزیت رزینی، کامپومر، جیومر، RMGI، گلاس‌آینومر سنتی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "کامپوزیت‌های رهاکننده‌ی فلوراید در یک سر طیف‌اند و کمترین فلوراید را آزاد می‌کنند؛ گلاس‌آینومرهای سنتی در سر دیگرند و بیشترین رهایش را دارند. کامپومر به کامپوزیت شبیه‌تر است و RMGI به گلاس‌آینومر سنتی. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جیومر دسته‌ی جدیدتری است که میان RMGI و کامپومر قرار می‌گیرد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "RMGI — دو واکنش در یک ماده"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "RMGI اجزای هر دو گروه را دارد: شیشه‌ی فلوروآلومینوسیلیکات و پلی‌آکریلیک اسید از گلاس‌آینومر، و آغازگر نوری یا شیمیایی و مونومرهای متاکریلات از کامپوزیت. بنابراین هم با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "واکنش اسید-باز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ست می‌شود و هم با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پلیمریزاسیون رادیکال آزاد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "موقع انتخاب محصول: RMGIهای خمیر-خمیر راحت‌تر مخلوط و جای‌گذاری می‌شوند، ولی در یک مطالعه استحکام گیر کراون آن‌ها از نوع پودر-مایع کمتر بود. همچنین سازندگان برای بهبود هندلینگ و استحکام، مقدار رزین را بیشتر کرده‌اند؛ به همین دلیل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مقدار رزین در برندهای مختلف تفاوت زیادی دارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:725c975e9e95701180911878ed59270c0086c709bfad47343c92c70115d1471b",
      "sourceId": "theory:725c975e9e95701180911878ed59270c0086c709bfad47343c92c70115d1471b",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5ba0eaf6fda502889126d3169b56b1fbfb13a517a33b6111a26900ce50d05df5",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کامپومر، جیومر و بهای رهایش"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کامپومر — کامپوزیتِ اصلاح‌شده با پلی‌اسید"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نام کامل آن کامپوزیت رزینی اصلاح‌شده با پلی‌اسید است و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترکیبش عمدتاً کامپوزیت است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". به مونومرهای دی‌متاکریلات ماتریکس، گروه‌های کربوکسیلیک اضافه شده و فیلرهای شیشه‌ی فلوروآلومینوسیلیکات تا حدی سایلن‌دار شده‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "در عمل: کامپومر برای باند قابل‌قبول به اچ و باندینگ عاجی نیاز دارد؛ یعنی برخلاف گلاس‌آینومر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خودچسبنده نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". رهایش فلورایدش از کامپوزیت بیشتر و از گلاس‌آینومر و RMGI کمتر است، و مقاومت سایشی‌اش میان RMGI و کامپوزیت قرار دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو عدد: در ترمیم‌های محافظه‌کارانه‌ی کلاس ۱ و ۲ دندان شیری، میانگین سایش یک کامپومر پس از یک سال ۱۹۰ میکرومتر بود؛ در حالی که سایش یک کامپوزیت مقاوم به سایش حدود ۱۰ میکرومتر بود. در یک پیگیری چهارساله هم ترمیم‌های خلفی کامپومر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۶ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شکست داشتند. انبساط ناشی از جذب آب مشکل کامپومرهای اولیه بود و در محصولات امروزی کمتر شده است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جیومر — فناوری PRG"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "نام جیومر از glass-ionomer و polymer گرفته شده است. جیومر فیلر PRG (گلاس‌آینومر از پیش واکنش‌داده) دارد؛ یعنی فاز گلاس‌آینومری پایدار درون ماتریکس رزینی. برای ساخت این فیلر، شیشه‌ی فلورایددار با پلی‌آلکنوئیک اسید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در آب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " واکنش می‌دهد؛ سپس فریزدرای، آسیاب و سایلن‌دار می‌شود و به ماتریکس رزینی اضافه می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فیلر PRG دو نوع دارد: در S-PRG (واکنش سطحی) فقط یون‌های سطح ذره واکنش داده‌اند؛ پس لایه‌ی نازکی از فاز گلاس‌آینومر دور یک هسته‌ی شیشه‌ای واکنش‌نداده قرار دارد. در F-PRG (واکنش کامل) تمام ذره واکنش داده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "چرا مهم است؟ ماتریکس دی‌متاکریلات عمدتاً آب‌گریز است و فلوراید فقط با جذب آب و حرکت زنجیره‌های پلیمری می‌تواند از آن عبور کند. در جیومر، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فلوراید در فیلرهای PRG راحت‌تر برای رهایش و شارژ مجدد در دسترس است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". در یک پیگیری هشت‌ساله هم هیچ‌یک از ۴۱ ترمیم جیومر کلاس ۱ و ۲ در دندان دائمی شکست نخورد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بهای رهایش بیشتر"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "رهایش فلوراید و استحکام فشاری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رابطه‌ی معکوس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارند: موادی که فلوراید بیشتری آزاد می‌کنند، معمولاً استحکام کمتری دارند. این بده‌بستان اصلی کل این خانواده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "یک استثنا که در امتحان زیاد اشتباه می‌شود: رهایش فلوراید جیومر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متوسط"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، ولی شارژ مجددش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زیاد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و هم‌رده‌ی گلاس‌آینومر و RMGI است. رهایش و شارژ همیشه هم‌جهت نیستند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
