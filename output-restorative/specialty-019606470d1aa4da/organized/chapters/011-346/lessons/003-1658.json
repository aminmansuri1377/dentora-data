                  "children": [
                    {
                      "tag": "text",
                      "text": "یکی از دو برند در واقع کامپومر است که با برچسب RMGI عرضه شده است"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
