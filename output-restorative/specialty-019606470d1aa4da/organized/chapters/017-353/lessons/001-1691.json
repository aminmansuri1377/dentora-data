  "steps": [
    {
      "id": "theory:5c85afa6bebec2075d2827264c62f88bfc5dd7604ce81903a4304b4bf1b79c3e",
      "sourceId": "theory:5c85afa6bebec2075d2827264c62f88bfc5dd7604ce81903a4304b4bf1b79c3e",
      "sourceProgress": "width: 0%;",
      "contentKey": "fcae0279b13c1f0dc636c1474b8e7e747b2a18b2dfc0961e4340d78b134f2cb6",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو بار تماس را ساختی و هر دو بار باز ماند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مولر اول مندیبل، ترمیم MOD قدیمی و شکسته."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فاصله‌ی بین‌دندانی زیاد است؛ دو بار با کامپوزیت مستقیم تماس پروگزیمال ساخته‌ای و هر بار نخ دندان بی‌مقاومت رد شده. ماده را عوض کنی یا "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اینجا مسئله دیگر ماده نیست، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جای ساختن کانتور"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. در ترمیم مستقیم، کانتور و تماس را داخل دهان می‌سازی؛ در غیرمستقیم، بیرون دهان. و کانتور بیرون‌دهانی یک برتری ساده دارد: اگر تماس کافی نباشد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از سمان‌کردن اصلاحش می‌کنی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مشکل دوم ترمیم مستقیم، انقباض است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کامپوزیت هنگام پلیمریزاسیون ۲ تا ۴ درصد جمع می‌شود و معمولاً در کم‌گیرترین حاشیه، یعنی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حاشیه‌ی جینجیوال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، شکاف می‌سازد. از آن شکاف ریزنشت و ورود باکتری آغاز می‌شود و پیامدش تحریک پالپ و حساسیت است. همین انقباض می‌تواند خمش کاسپ بسازد که گاه با خطوط کریز در مینا و حساسیت پس از کار همراه است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و اینجا باید صادق باشیم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در ترمیم غیرمستقیم، انقباض کاملاً حذف نمی‌شود؛ فقط "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به لایه‌ی نازک سمان رزینی منتقل می‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". آن لایه هم ۲ تا ۷ درصد جمع می‌شود و تنش انقباض در لایه‌های نازک سمان می‌تواند به‌اندازه‌ی افزایش‌های ضخیم کامپوزیت یا حتی بیشتر باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:7481b0ab575e3c7b0d359cd68d13c95d5680885fd0ec56a67fdbfb91791ae1fb",
      "sourceId": "theory:7481b0ab575e3c7b0d359cd68d13c95d5680885fd0ec56a67fdbfb91791ae1fb",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "b8fcff4db5f62f5b28cfbdc6a7a6b6e0eb185dc870c3a2f5e7fe76d8b5c62706",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آنچه پیگیری بلندمدت نشان داد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آزمایشگاه یک چیز گفت، بالین چیز دیگر"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در شرایط آزمایشگاهی، اینله‌ی کامپوزیتی ریزنشت کمتر، استحکام و سختی بیشتر و حساسیت پس از کار کمتری نسبت به کامپوزیت مستقیم نشان می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی در دهان بیمار، این برتری تکرار نشد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در یک مطالعه‌ی بالینی ۵ ساله و یک مطالعه‌ی ۱۱ ساله، میان اینله‌ی کامپوزیتی و ترمیم مستقیم کامپوزیتی تفاوت آماری معناداری در میزان موفقیت دیده نشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و وقتی این را کنار هزینه‌ی بیشتر و نیاز مکرر به برداشتن ساختار سالم بیشتری از دندان بگذاری، دفاع از اینله‌ی کامپوزیتی در برابر کامپوزیت مستقیم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دشوار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس کی واقعاً غیرمستقیم؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه موقعیت که در آن‌ها اینله توصیه‌شدنی است:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فاصله‌ی بین‌دندانی زیاد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " که ساختن تماس پروگزیمال درست را دشوار می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیاز به "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساختن یک رابطه‌ی اکلوزالی مشخص"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقصی که بیش از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دوسوم پهنای بین‌کاسپی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گسترش دارد، یعنی ایسموس بزرگ."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و قاعده‌ی پیش‌فرض:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای تراش‌های اینله‌ی دو و سه سطحی با پهنای متوسط، کامپوزیت مستقیم را اول در نظر بگیر."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو دروازه که بازشان نکنی، وارد نشو"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دروازه‌ی اول، ایزولاسیون:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر ایزوله کردن دندان ممکن نیست، ترمیم چسبنده نباید گذاشته شود. این یک ترجیح نیست، یک شرط ورود است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دروازه‌ی دوم، مینا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای بیشترین موفقیت بلندمدتِ قابل پیش‌بینی، همه‌ی حاشیه‌ها باید روی مینا بنشینند، چون باند و سیل روی مینا قابل اتکاتر از عاج است. و در حالت آرمانی، بیمار نشانه‌ای از عادت پارافانکشنال نداشته باشد."
                }
              ]
            }
          ]
        }
      ],
