  "steps": [
    {
      "id": "theory:b0abbb7f188bd002d8286dc5e6120f1fae0b4516d20489d2635e8bfa80f48f0f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "124429c7b6f1078dbd3d688a478f0a93bae24cc9f83f30ca882c8cff0cd8496c",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بیمار براکسر است و زیبایی هم می‌خواهد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار ۴۵ ساله با براکسیزم آشکار، مولر دوم مندیبل، و درخواست صریح «چیزی که رنگ دندان باشد»."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سرامیک، کامپوزیت آزمایشگاهی، یا طلا؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از پاسخ، یک واقعیت را بپذیر: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در برابر تنش‌های مکانیکی مانند براکسیزم، ترمیم‌های ریختگی طلا کارآمدتر از اینله و آنله‌ی تمام‌سرامیک عمل کرده‌اند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و ماندگاری طلا عدد دارد. اگر با دقت به کار رود، آلیاژ طلا بیشترین ماندگاری را در میان مواد ترمیمی دارد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بقای ۸۷ تا ۹۷ درصد در ۱۰ سال"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۸۷ تا ۹۰ درصد در ۲۰ سال"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۷۳٫۵ تا ۹۸ درصد در ۳۰ سال"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک مقایسه‌ی تصادفی‌شده‌ی پنج‌ساله که باید بدانی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در ارزیابی سه سامانه‌ی اینله‌ی سرامیکی در کنار اینله‌ی طلا، ۲۰ درصد اینله‌های سرامیکی تقویت‌شده با لوسایت شکست خوردند و ۷۰ درصد کل سامانه‌های سرامیکی دیچینگ حاشیه‌ای نشان دادند؛ در حالی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در اینله‌های طلا هیچ شکستی رخ نداد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:e0401b1de035e016d95b8dc156edac4386540c0ac195e76e804ba9449163d82a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "404d41cb8a2c5a38c96ae97652227b8d5be218ecb452b2bafa4df37a8ce81f6a",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه ماده، سه نقطه‌ضعف"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سرامیک: خودش کم می‌ساید، ولی دندان مقابل را می‌ساید"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سایش خودِ ترمیم سرامیکی عامل مهمی نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ مسئله دندان مقابل است. پرسلن فلدسپاتیک سنتی به‌شدت ساینده است و سایش چشمگیر دندان مقابل می‌سازد. نسل پرسلن‌های کم‌ذوب سایش معنادار کمتری نشان دادند، و سرامیک‌های پرس‌شدنی تا حدی به همین دلیل محبوب شدند که کمتر ساینده‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برتری اصلی سرامیک بر کامپوزیت جای دیگری است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چسبندگی سمان رزینی به پرسلن اچ‌شده قابل اتکاتر و بادوام‌تر از چسبندگی به کامپوزیت ازپیش‌پلیمریزه است. یعنی برتری سرامیک مستقیماً به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اتکاپذیری فرایند سمان‌کردن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برمی‌گردد. سرامیک همچنین نشت کمتری از اینله‌ی کامپوزیتی نشان می‌دهد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کامپوزیت آزمایشگاهی: آسان با تو، سخت با سمان"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برتری‌اش این است که کار کردن با آن آسان‌تر است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، هم در مطب و هم در لابراتوار. اینله‌ی کامپوزیتی را می‌توان با فشار متوسط و بدون ترس از شکستن نشاند، و اگر تماس پروگزیمال حین تنظیم از بین برود، به‌سادگی با افزودن کامپوزیت نوری جایگزین می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در مقابل، اینله‌ی سرامیکی کاملاً شکننده است و حین پرو مستعد شکستن."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر تماس پروگزیمالش ناخواسته برداشته شود، بازسازی‌اش افزودن پرسلن کم‌ذوب و کیور دوباره در کوره می‌خواهد و پس از آن، ترمیم باید پیش از سمان‌کردن دوباره با اسید هیدروفلوریک اچ شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و نقطه‌ضعف پنهان کامپوزیت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سطح داخلی‌اش لایه‌ی مهارشده با اکسیژن ندارد و گروه‌های متاکریلات واکنش‌نداده‌اش نسبتاً کم است؛ پس پیوند شیمیایی قابل اتکایی میان آن و سمان رزینی شکل نمی‌گیرد. چاره، سندبلاست سطح داخلی با آلومینای ۵۰ میکرون است تا زبری لازم برای گیر اصطکاکی فراهم شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "طلا: هم‌سایش با مینا"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "طلا با سرعتی مشابه مینا سایش می‌یابد، پس سایش شتاب‌یافته‌ی دندان مقابل نمی‌سازد. به‌ندرت می‌شکند، در برابر خوردگی مقاوم است و از سازگارترین مواد زیستی شمرده می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و هزینه‌اش کجاست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ایراد اصلی طلا هزینه‌ی اولیه‌ی بالاتر است، چون دست‌کم دو جلسه و هزینه‌ی لابراتوار می‌خواهد. و یک هشدار عملی: تماس مستقیم آلیاژ طلا با آمالگام حاوی روی می‌تواند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خوردگی گالوانیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و اثرهای ناخوشایند و گاه دردناکِ گذرا بسازد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
