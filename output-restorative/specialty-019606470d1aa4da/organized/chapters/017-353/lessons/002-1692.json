  "steps": [
    {
      "id": "theory:be915561a4b4268d4e6c3a36985e85c394499c5d901aabe338273d09a82a7bb5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "730178bd04308e619d2f10efa4befcffa1e9d8733e02092324505dfa5711ed2a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه ترمیم روی سینی، کدام کدام است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه ترمیم غیرمستقیم روی سینی گذاشته‌اند و از تو می‌پرسند کدام اینله است، کدام آنله و کدام اورلی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر پاسخت «اندازه‌شان فرق دارد» باشد، مرز را نگرفته‌ای."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مرز "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اندازه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیست، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاسپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اینله"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ترمیمی است کاملاً داخل‌تاجی، معمولاً با گسترش اکلوزال و پروگزیمال، که "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هیچ کاسپی را نمی‌پوشاند"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آنله"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در اصل همان اینله است که یک یا چند کاسپ را می‌پوشاند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آنله‌ی کامل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تمام سطح اکلوزال را می‌پوشاند و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آنله‌ی پارسیل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تنها بخشی از آن را. همان پوشش کاملِ سطح اکلوزال است که در گفتار روزمره "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اورلی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " خوانده می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و نکته‌ی مفهومی که آنله را ویژه می‌کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آنله اصول ترمیم داخل‌تاجی و برون‌تاجی را با هم دارد. به همین دلیل، با اینکه از کراون پارسیل یا کامل محافظه‌کارانه‌تر است، همان اندازه از ساختار باقی‌مانده محافظت می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:f9e1594f4360453c9311f23114418dec86a65ede9fa69954281ee6d692483d49",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "4077e9aa34d7b3731621d594262b7c8e59fa565d5fb8901828b4670d5b7283a6",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "طیف، ضخامت، و مولر کوتاه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک طیف، نه چند جعبه‌ی جدا"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترمیم‌های غیرمستقیم یک پیوستارند: از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اینله"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (ترمیم کوچک داخل‌تاجی) تا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوشش کامل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (ترمیمی که تمام سطح تاجی را می‌پوشاند). آنله و ترمیم‌های پوشش‌پارسیل دورگه‌اند و ویژگی داخل‌تاجی و برون‌تاجی را با هم دارند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ای که انتخاب میان آن‌ها را تعیین می‌کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طرحی را برگزین که کمترین ساختار سالم را بردارد و در همان حال دندان را توانا کند نیروهای فانکشنال و پارافانکشنال را تحمل کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عدد ضخامت را حفظ کن"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کاهش اکلوزال باید یکنواخت و به‌اندازه‌ای باشد که استحکام سرامیک رویی تأمین شود: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم ۱٫۵ میلی‌متر در فوسای مرکزی و ۲٫۰ میلی‌متر روی کاسپ‌های فانکشنال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "چرا این عدد اهمیت دارد؟ چون "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شکست توده‌ای"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به‌ویژه آنجا رخ می‌دهد که ضخامت ماده کمتر از ۲ میلی‌متر باشد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مولری که قبلاً باید جراحی می‌شد"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مولری با بُعد اکلوزوجینجیوال کوتاه را در نظر بگیر. با تراش کراون معمولی، به‌دست آوردن گیر و مقاومت اگزیال دشوار است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی تراش آنله‌ی پرسلن تنها ۲ میلی‌متر کاهش اکلوزال می‌خواهد و برای گیر و مقاومت هیچ کاهش اگزیالی لازم ندارد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مولر کوتاهی که پیش‌تر برای کراون پوشش‌کامل به جراحی افزایش طول تاج نیاز داشت، حالا محافظه‌کارانه‌تر با آنله ترمیم می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای دندان اندوشده طرح دیگری هم پیشنهاد شده است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اندوکراون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، که کور را در خود کراون یکپارچه می‌کند و سطح در دسترس برای سمان چسبنده را به‌طور معنادار افزایش می‌دهد؛ به‌ویژه در تاج‌های بالینی کوتاه سودمند است. ولی هنوز به‌خوبی ارزیابی بالینی نشده و ممکن است در پرمولرها مسئله‌ساز باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
