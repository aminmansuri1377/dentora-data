    {
      "id": "question:30527",
      "sourceId": "30527",
      "sourceProgress": "width: 42.8571%;",
      "contentKey": "45df3ea2b956c7d08a58027802c80a7f5765070bcdc2a0539b15ec56570eee6f",
      "position": 4,
      "kind": "question",
      "type": "single-choice",
      "prompt": "تفاوت کلیدی میان توتال‌اچ سه‌مرحله‌ای و دومرحله‌ای چیست؟",
      "sourceContent": [
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تفاوت کلیدی میان توتال‌اچ سه‌مرحله‌ای و دومرحله‌ای چیست؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۱"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تفاوت تنها در زمان تابش نور است؛ سه‌مرحله‌ای به سه بار تابش نیاز دارد و دومرحله‌ای تنها به دو بار تابش جداگانه"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۲"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
