  "steps": [
    {
      "id": "theory:bdb31becdaa44d74239561bd8a6bb4a3100936134a0e9aeae4ed665a32386937",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "28e282b78326bc69f8c649d3b8579f4a3b153eac7e515a4459d71ea11bfc2b28",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "حفره را با فرز درشت تراشیدی؛ حالا چه؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفره را با یک فرز الماسی درشت تراشیده‌ای"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و سراغ یک سلف‌اچ اولترامایلد می‌روی. بدون اچ جداگانه ادهزیو را می‌زنی و کامپوزیت را می‌گذاری. سه سال بعد، دور مارجین‌ها خط افتاده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مقصر لایه‌ای بود که با چشم دیده نمی‌شود: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اسمیر لایر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "هر تراش مکانیکی لایه‌ای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌شکل به ضخامت ۱ تا ۵ میکرومتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از خرده‌های آلی و معدنی روی مینا و عاج باقی می‌گذارد. این لایه دهانه‌ی توبول‌های عاجی را می‌بندد و نفوذپذیری عاج را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تا ۸۶٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کم می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ضخامتش به فرز بستگی دارد: فرز الماسی با دانه‌بندی متوسط لایه‌ای حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵ میکرومتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و متراکم‌تر می‌سازد و فرز کارباید حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ میکرومتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". اسمیر لایر باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشته یا نفوذپذیر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شود، وگرنه مونومر به عاج نمی‌رسد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "با سلف‌اچ مایلد و اولترامایلد، اسمیر لایر ضخیم‌تر یعنی باند ضعیف‌تر، چون اجزای این لایه اسید را زودتر خنثی می‌کنند. پس اگر چنین ادهزیوی می‌زنی، دیواره‌ها را با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرز الماسی ریز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سبک صاف کن تا اسمیر لایر نازک شود. زمان اعمال طولانی‌تر و مالش فعال ادهزیو هم کمک می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:d7b51833405ec0124e62122186fb0c5047d9957302c0365bcf83b1f8a272deed",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "90652e9680f8f1b765e93507933dee0576bc62c030553dde3888a9c91a741a85",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "زمان اچ و ساخته‌شدن لایه‌ی هیبرید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روی مینا"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اچ، سطح در دسترس را بسیار بیشتر می‌کند و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انرژی سطحی اولیه را تقریباً دو برابر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌کند. رزین درون ریزحفره‌ها می‌رود و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماکروتگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در پیرامون پریسم‌ها و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "میکروتگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در هسته‌ی آن‌ها می‌سازد. الگوی اچ (نوع ۱ تا ۳) را ترکیب و ساختار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خودِ مینا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تعیین می‌کند، نه دندانپزشک."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مینای پرفلوراید و مینای "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آپریسماتیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در برابر اچ مقاوم‌ترند. طولانی‌کردن اچ تا ۶۰ ثانیه سطح را زبرتر می‌کند، ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استحکام باند را بالا نمی‌برد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روی عاج"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اسید فسفریک ۳۵ تا ۳۷ درصد اسمیر لایر و اسمیرپلاگ‌ها را برمی‌دارد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳ تا ۵ میکرومتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از عاج سطحی را دمینرالیزه می‌کند و دهانه‌ی توبول‌ها را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قیفی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌کند، چون عاج پری‌توبولار مینرال بیشتری دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عاج سالم را بیش از ۱۵ ثانیه اچ نکن."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پرایمر و رزین باندینگ فقط چند میکرومتر در عاج دمینرالیزه نفوذ می‌کنند. اگر دمینرالیزاسیون از این عمق جلوتر برود، در کف لایه‌ی هیبرید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناحیه‌ای ضعیف از کلاژن عریان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌ماند و شکست از همان‌جا شروع می‌شود. در عاج مسن یا اسکلروتیک، اچ تا ۳۰ ثانیه می‌تواند مناسب باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "برای همین اچانت را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اول روی مارجین‌های مینایی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و بعد روی عاج بگذار تا مینا وقت کافی بگیرد و عاج بیش از حد اچ نشود. زمان شست‌وشو را هم‌اندازه‌ی زمان اچ بگیر."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حاصل کار"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نفوذ مونومر به عاج اچ‌شده "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لایه‌ی هیبرید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را می‌سازد: ترکیبی از کلاژن، مونومرهای رزین و بازمانده‌های اسمیر لایر. کیفیت باند به دو چیز بستگی دارد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دمینرالیزاسیون بستر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نفوذ بعدی مونومرها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در لایه‌ی دمینرالیزه. غلظت رزین از سطح به عمق کم می‌شود؛ پس ضعیف‌ترین بخش لایه‌ی هیبرید، کف آن است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در سلف‌اچ، دمینرالیزاسیون و نفوذ مونومر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هم‌زمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رخ می‌دهند؛ برای همین این سامانه‌ها به اورچینگ و اوردرای بسیار کمتر حساس‌اند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
