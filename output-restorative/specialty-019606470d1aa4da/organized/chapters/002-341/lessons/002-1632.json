  "steps": [
    {
      "id": "theory:d4782c5a46e1c5d8ceb982558d8d5217f4de1f4afce80d5d9b8ce481cbc289d0",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "0db73d94e6462b5213124cda7aa81d6956e20f51888acef7cd1a39869686f3bd",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کلمپ می‌لغزد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مولر دوم مندیبل، نیمه‌رویش‌یافته."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کلمپ معمولِ مولر را می‌گذاری؛ می‌چرخد و می‌پرد. دوباره می‌گذاری و این بار بیشتر بازش می‌کنی تا محکم‌تر بنشیند، ولی بدتر می‌شود. اشتباه کجا بود؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو اشتباه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کلمپ را باید بر اساس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شکل تاج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انتخاب کنی (برای مولر نیمه‌رویش‌یافته، کلمپ مخصوص همین وضعیت). و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باز کردن بیش از حد، کمان کلمپ را برای همیشه ضعیف می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ کلمپی را که بیش از حد باز شده معمولاً باید کنار گذاشت."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپ فقط باید با چهار نوک فک‌هایش با دندان تماس داشته باشد. اگر جای دیگری از فک به دندان بخورد، نقاط تماس به هم نزدیک می‌شوند و کلمپ می‌چرخد. کلمپ را فقط به اندازه‌ای باز کن که از برجسته‌ترین قسمت تاج رد شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:0b0060ff1e78ceee0d6631b8d06c43e1409611e98035d359cb90d4afe819aead",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "be2b9e7880aa50c5b8c6bf9cb7a639e1fe92080d9cb4fc608ac62d89f04e34aa",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "وسایل رابردم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پانچ و سوراخ‌ها"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پانچ آیوری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شش اندازه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سوراخ دارد (۱ کوچک‌ترین، ۶ بزرگ‌ترین). برای ورق لاتکس سنگین: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵ برای مولری که کلمپ می‌گیرد، ۴ برای بقیه‌ی مولرها، ۳ برای پرمولرها، کانین و سنترال ماگزیلا، و ۲ برای لترال ماگزیلا و انسیزورهای مندیبل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". سوراخ باید تمیز بریده شود: سوراخ ناقص زبانه‌هایی به جا می‌گذارد که جلوی سیل را می‌گیرند، و اگر زبانه‌ها را بکنی، لبه‌ی ناصاف می‌ماند و رابردم از همان‌جا پاره می‌شود. برای کلاس V فاسیال، سوراخ همان دندان را حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱ میلی‌متر به سمت فاسیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جابه‌جا کن تا کلمپ رترکتور بتواند رابردم را کنار بزند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپ‌ها"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپ یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بال‌دار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است (رابردم را پیش از رفتن به دهان روی بال‌هایش می‌کشی) یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدون بال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (شماره‌اش با حرف W شروع می‌شود). کلمپ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروانه‌ای"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (212SA) فقط رترکتور است. برای کار روزمره: "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "W8A / W8ASA / B1"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای مولر، W2A برای پرمولر و 212SA برای کلاس V. کلمپ‌های مکمل: "
                },
                {
                  "tag": "span",
                  "attributes": {
                    "dir": "ltr"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "W0 / 00"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای انسیزورهای کوچک، W1A با فک‌های متمایل به سمت لثه، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "W14A برای مولر نیمه‌رویش‌یافته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپ 212SA دو کمان دارد، پس نمی‌توان دو تا از آن را روی دو دندان مجاور گذاشت (برای دو کلاس V کنار هم، از هر کلمپ یک کمان را می‌برند). این کلمپ را باید با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کامپوند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (قرمز یا سبز) روی سطوح اکلوزال و لینگوال تثبیت کرد، وگرنه در جهت مزیودیستال می‌لغزد و به ریشه آسیب می‌زند. کامپوند را از ناحیه‌ی کار دور نگه دار."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تماس چهارنقطه‌ای"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "فقط "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوک فک‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باید با دندان تماس داشته باشند: دو نقطه روی هر فک، روی هم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهار نقطه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". لازم نیست فک کلمپ دقیقاً روی دندان جفت شود، چون "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیل را رابردم ایجاد می‌کند، نه کلمپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فریم، نگه‌دارنده و فورسپس"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فریم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یانگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی سطح بیرونی رابردم قرار می‌گیرد و با صورت تماس ندارد؛ فریم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نایگارد-اوستبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی سطح داخلی قرار می‌گیرد و با صورت یا نپکین تماس دارد. فریم پلاستیکی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رادیولوسنت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و برای کاری که وسطش رادیوگرافی لازم است مناسب است، ولی استریل حرارتی را به خوبی فریم فلزی تحمل نمی‌کند. فریم فلزی کم‌حجم‌تر است، سال‌ها دوام دارد و نوع سرگرد آن در صورت برخورد، چشم بیمار را حفظ می‌کند. نگه‌دارنده‌ی بندی (strap holder) بیشترین کنار زدن لب و گونه و بیشترین پایداری را دارد، ولی برای بیمار ناراحت‌تر است و بدون نپکین نباید به کار برود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فورسپس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آیوری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تثبیت‌کننده‌هایی نزدیک نوک دارد که جلوی چرخش کلمپ را می‌گیرند؛ فورسپس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استوکس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با شیارهای نزدیک نوک اجازه‌ی چرخش می‌دهد و برای دندان‌هایی که به مزیال یا دیستال متمایل‌اند مناسب‌تر است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
