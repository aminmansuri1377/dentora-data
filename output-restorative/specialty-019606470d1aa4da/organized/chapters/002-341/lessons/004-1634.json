      "sourceId": "theory:9416b6ecd0380efdc6dc9ef994dbe1149551face506ecea63be6cc62de32f414",
      "sourceProgress": "width: 0%;",
      "contentKey": "1851758b54b554251ba47ad2dd860309bb555c627f542b6914ad1a31f8f43407",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بیماری که رابردم را تحمل نمی‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودکی برای فیشورسیلانت مولر اول دائمی آمده است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رفلکس تهوع دارد و هر بار که رابردم به صورتش نزدیک می‌شود، خودش را عقب می‌کشد. کار را لغو می‌کنی یا راه دیگری داری؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راه دیگری هست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هدف، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آلوده نشدن میدان کار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. رول پنبه‌ای که درست کنار دهانه‌ی مجاری بزاقی گذاشته شود، همراه ساکشن، یا وسیله‌ای که هم زبان و گونه را کنار بزند و هم ساکشن کند، برای بسیاری از کارها کافی است؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به شرط اینکه میدان واقعاً خشک بماند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "ولی یادت باشد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیچ‌کدام از این وسایل ایزولاسیونی به کاملی رابردم نمی‌دهند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انتخاب آن‌ها یعنی پذیرفتن کمی ایزولاسیون کمتر در برابر راحتی بیشتر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:111c0c92074db15fa53ede62cc24e0a26134585858b7c413b354be21538c2077",
      "sourceId": "theory:111c0c92074db15fa53ede62cc24e0a26134585858b7c413b354be21538c2077",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "021e4df19ad8180632267c7797bec45d25e1ed09069cfb5de59921d438aeb286",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "وسایل ایزولاسیون و مواد جاذب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وسایل"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایزولایت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ساکشن، کنار زدن زبان و گونه، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بایت بلاک سرخود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نور"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در یک وسیله. دهانی یک‌بارمصرف آن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شش اندازه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد: کوچک، متوسط و بزرگِ معمولی، و همین سه اندازه در نوع مخصوص "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وستیبول عمیق"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Svedopter:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رترکتور فلزی زبان برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خلفی مندیبل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، با تیغه‌ی عمودی آینه‌مانند و تیغه‌ی قابل تنظیم زیر چانه؛ به‌ویژه برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراش و سمان کردن پروتز ثابت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مفید است. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Hygoformic:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " همین کاربرد را دارد، ولی تیغه‌ی بازتابنده ندارد و معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای بیمار راحت‌تر است و به بافت لینگوال کمتر آسیب می‌زند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ پیش از استفاده باید آن را دوباره خم کرد و فنرش را کمی باز کرد. کنار هر دو، رول پنبه در کف دهان و در وستیبول باکال ماگزیلا روبه‌روی دهانه‌ی مجرای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پاروتید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گذاشته می‌شود. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Vac-Ejector:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بایت بلاک، رترکتور زبان و اتصال ساکشن پرحجم، با سه دفلکتور: یکی برای هر دو سمت ماگزیلا و یکی برای هر سمت مندیبل."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بایت بلاک لاستیکی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را می‌توان پس از گذاشتن رابردم هم در سمت مقابل گذاشت تا بیمار بدون خستگی دهانش را باز نگه دارد؛ بستن یک نخ به آن برای بیرون کشیدن در صورت لزوم توصیه می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مواد جاذب"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "رول پنبه را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جایی می‌گذاری که مجرای غدد بزاقی به دهان باز می‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ گاز تاشده هم می‌تواند جای آن را بگیرد. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "parotid shield"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، یک مثلث کاغذی جاذب، روی سطح فاسیال دندان‌های خلفی بزاق پاروتید را جذب می‌کند؛ هم کنار رول پنبه به کار می‌رود و هم به‌تنهایی. ایزولاسیون با مواد جاذب و ساکشن از رابردم کم‌اثرتر است، ولی برای کارهایی که به ایزولاسیون کامل نیاز ندارند مفید است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای بیمار حساس به لاتکس، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رابردم بدون لاتکس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به کار ببر که کشسانی‌اش بسیار نزدیک به لاتکس است، و بقیه‌ی وسایل لاتکسی، مثل دستکش، را هم کنار بگذار."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
