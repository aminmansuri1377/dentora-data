  "title": "درس سوم: برگشت‌پذیر، برگشت‌ناپذیر، نکروز — و تصمیمی که از آن می‌آید",
  "specialtyKey": "019606470d1aa4da",
  "chapter": {
    "id": "359",
    "title": "درد، حساسیت و تشخیص افتراقی",
    "position": 16
  },
  "position": 3,
  "importReady": true,
  "countsComparedWithConfiguredExpectation": false,
  "sourceSessionFinished": true,
