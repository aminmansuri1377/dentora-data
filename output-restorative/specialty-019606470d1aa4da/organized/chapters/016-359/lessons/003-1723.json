  "order": "first-encounter-with-remediation-visits-preserved",
  "steps": [
    {
      "id": "theory:b8dce87bd2c6c5b59468a0de9d7e76b26ef1446f7dd7181e92b0bde5f3334f78",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "84345c8cf0515848983aa0eb31d8ae25d3cd7deefde7c9518705e3822de7316e",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "یک ثانیه درد، یا دو دقیقه؟ کل تصمیم همین‌جاست"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو بیمار، هر دو با شکایت «به سرما حساسم»."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی اولی، پنبه‌ی سرد را که برمی‌داری، درد همان لحظه قطع می‌شود. روی دومی، درد اول تیز است، بعد مبهم می‌شود و تا دقیقه‌ها می‌ماند. ظاهر شکایت یکی است؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تصمیم درمانی‌شان کاملاً متفاوت است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تست سرما چهار خروجی دارد، نه دو تا:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پاسخ طبیعی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — شدت و دوامی شبیه دندان شاهد ⟵ پالپ طبیعی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بی‌پاسخ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ⟵ به سود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نکروز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پالپ."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پاسخ اغراق‌شده ولی گذرا"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — شدیدتر از شاهد ولی با برداشتن محرک تمام می‌شود ⟵ به سود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پالپیت برگشت‌پذیر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پاسخ اغراق‌شده و ماندگار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — اول تیز، بعد مبهم، و ماندگار تا گاهی چند دقیقه ⟵ به سود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پالپیت برگشت‌ناپذیر علامت‌دار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس تفاوت‌گذار، شدت درد نیست؛ دوام آن است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیمار می‌تواند از درد شدیدِ یک‌ثانیه‌ای فریاد بزند و پالپش هنوز قابل بازگشت باشد. و ماندگاری همان نقطه‌ای است که رشته‌های C وارد صحنه شده‌اند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:0e8604cef270b0b3f7f3b22d9f589a68a459469644bb41943f11dd67945189f0",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "a805940bdb5b31d2c58f2b4b339b8ab290837ee5bb4af619ec847c9b9e6e4cc0",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "از تشخیص تا تصمیم، بدون پرش"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "واژه‌ها باید دقیق باشند، چون هر واژه یک اقدام را فعال می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پالپ طبیعی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — بی‌علامت و پاسخ طبیعی به تست ⟵ هیچ درمان اندودنتیکی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پالپیت برگشت‌پذیر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — التهابی که انتظار می‌رود فروکش کند و پالپ به حالت عادی برگردد. نشانه‌های معمول: پوسیدگی یا ترمیم عمیق، کار دندانپزشکی اخیر، نشت حاشیه‌ای، علائم: حساسیت به سرد و شیرین، پاسخ اغراق‌شده به سرما ⟵ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پایش"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، برداشتن پوسیدگی، گذاشتن یا تعویض ترمیم معیوب."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پالپیت برگشت‌ناپذیر علامت‌دار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — پالپ زنده ولی چنان ملتهب که توان بهبود ندارد. توصیف‌گرها: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "درد حرارتی ماندگار، درد خودبه‌خودی، درد ارجاعی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ⟵ درمان ریشه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پالپیت برگشت‌ناپذیر بی‌علامت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — بدون هیچ علامتی، ولی التهابی که پوسیدگی، تراش یا تروما ساخته است؛ نشانه‌ی معمول: پوسیدگی عمیق تا پالپ یا اکسپوژر ⟵ درمان ریشه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نکروز پالپ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — مرگ پالپ؛ معمولاً بی‌پاسخ به تست‌ها ⟵ درمان ریشه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و طرف پری‌اپیکال، جداگانه:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پری‌اپیکال طبیعی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (بدون رادیولوسنسی، لیگامان یکنواخت، پاسخ طبیعی به دق و لمس و بایت‌تست)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پریودنتیت اپیکال علامت‌دار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (درد به دق، لمس یا بایت‌تست؛ اگر پاسخ پالپی طبیعی بود، اول اکلوژن، وضعیت پریودنتال و کرک را بررسی کن)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پریودنتیت اپیکال بی‌علامت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (رادیولوسنسی با منشأ پالپی، تست‌های اپیکال طبیعی، بی‌پاسخ به تست پالپ)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آبسه‌ی حاد اپیکال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (تورم نوسان‌دار، درد خودبه‌خودی ⟵ برش و تخلیه و سپس درمان ریشه)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آبسه‌ی مزمن اپیکال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (سینوس‌ترکت که باید با گوتاپرکا ردیابی شود)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استئیت متراکم‌شونده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (رادیواوپاسیته‌ی اپکس با فضای لیگامان مشخص ⟵ پایش)."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و تصمیمی که برنامه‌ی ترمیمی تو را عوض می‌کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندانی با علائم پالپیت برگشت‌پذیر پس از یک ترمیم تازه را می‌توان چند هفته پایش کرد. ولی اگر همان دندان قرار است "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روکش شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، انتظار کشیدن گران تمام می‌شود؛ بسیاری از این موارد بعداً نکروز می‌شوند و آن‌وقت باید از داخل روکش تازه دسترسی بزنی. در این حالت رفتن به سراغ درمان ریشه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیم نهایی، انتخاب سنجیده‌تری است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
