              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۴"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
