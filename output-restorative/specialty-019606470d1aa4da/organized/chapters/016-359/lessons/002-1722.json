                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکروز پالپ، آبسه‌ی حاد اپیکال، و پریودنتیت اپیکال بی‌علامت با منشأ پالپی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
