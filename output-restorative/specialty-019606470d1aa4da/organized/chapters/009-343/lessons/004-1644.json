                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمتر از نیم کیلوگرم برای همه‌ی انواع"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
