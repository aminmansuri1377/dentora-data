                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبود علائم، نبود پاتولوژی پری‌اپیکال، و ابچوریشن متراکم با گستره‌ی کافی روی رادیوگرافی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
