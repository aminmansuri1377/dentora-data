  "steps": [
    {
      "id": "theory:7ced18a627c37295ebf894bdd0eb300cf482578dd787499b0a5dd94b7d18645f",
      "sourceId": "theory:7ced18a627c37295ebf894bdd0eb300cf482578dd787499b0a5dd94b7d18645f",
      "sourceProgress": "width: 0%;",
      "contentKey": "93099664ed530ee43e80bd8e5fd034793393c2f8288a30a11aa7973dc1fdec5b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "قبل از آنکه فرز را برداری"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کیس:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیمار با سانترال ماگزیلای اندوشده آمده که ترمیم موقتش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شش هفته پیش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " افتاده و خودش هم متوجه نشده. دندان بی‌علامت است و می‌خواهی همین امروز کور بگذاری و تراش کنی. اما یک پرسش هنوز بی‌پاسخ است: آیا سیل این کانال هنوز قابل اعتماد است؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چک‌لیست پیش از ترمیم"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از هر تصمیم ترمیمی، کیفیت اندوی موجود سنجیده می‌شود: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبود علائم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبود پاتولوژی پری‌اپیکال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ابچوریشن متراکم با گستره‌ی کافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی رادیوگرافی. بیماری پریودنتال باید کنترل شده باشد و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نسبت تاج به ریشه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با توجه به جایگاه دندان در قوس و کارکرد انتظاری‌اش ارزیابی شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "یک یافته‌ی ساده‌ی مثبت: دندانی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هم از مزیال و هم از دیستال تماس پروگزیمالی دارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، پیش‌آگهی بهتری دارد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پنجره‌ی آلودگی"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر پرکردگی کانال به محیط دهان اکسپوز شده باشد، آلودگی پری‌اپکس با باکتری یا توکسین می‌تواند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ظرف چند روز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رخ دهد. داده‌ی بالینی قطعی برای «چند روز مجاز است» وجود ندارد؛ بسیاری از کلینیسین‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ هفته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اکسپوژر را به‌عنوان راهنمای قراردادی برای ریتریتمنت به کار می‌برند. و فاصله‌ی طولانی میان اندو و ترمیم نهایی، نرخ شکست را به‌طور معناداری بالا می‌برد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:900c98dc980ec39ec54219d8fb47d7344027da7cb471e3a2a38d9d51bbb8b3f3",
      "sourceId": "theory:900c98dc980ec39ec54219d8fb47d7344027da7cb471e3a2a38d9d51bbb8b3f3",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "68d9a022495c3d079678a629b807a98ccb4f1fa854abbe4cf9617dbf9d13a144",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فرول: دو میلی‌متری که بقای ترمیم به آن بسته است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فرول چیست"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرول"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی نواری از ماده که به‌صورت دور تا دور ناحیه‌ی سرویکال دندانِ کراون‌شده را در بر می‌گیرد. در کاربرد روزمره، به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارتفاع عمودی عاج باقی‌مانده از مارجین پیش‌بینی‌شده‌ی تراش تا انتهای کرونال آن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم گفته می‌شود؛ همان بخشی که کراون می‌تواند دورش حلقه بزند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کارکردش مکانیکی است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تقویت ساختار باقی‌مانده و کمک به ترمیم برای تحمل نیروهای لترال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". ارتفاع عاج باقی‌مانده چنان تعیین‌کننده است که برخی آن را از نوع پست و کور هم مهم‌تر می‌دانند، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "طول فرول در افزایش مقاومت به بارگذاری چرخه‌ای از طول پست مؤثرتر بوده است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اعداد"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فرولی به ارتفاع تنها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱٫۰ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، مقاومت به شکست دندانِ بدون ساختار تاجی را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو برابر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌کند. بیشترین سود از فرول "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم ۱٫۵ تا ۲٫۰ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انتظار می‌رود. نبود فرول کافی، خطر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خارج شدن پست و کراون، شکست پست و شکست ریشه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را بالا می‌برد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و حساب دوم را فراموش نکن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عرض بیولوژیک حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و مارجین نباید به آن تجاوز کند. پس با حداقل فرول ۲ میلی‌متری، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم ۴ میلی‌متر ساختار سالم فوق‌آلوئولار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای ثبات مکانیکی و سلامت پریودنتال لازم می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی این ۴ میلی‌متر در کار نیست"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکستروژن ارتودنتیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جراحی افزایش طول تاج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌تواند ارتفاع عاج بسازد. ولی هر دو بها دارند: چون ریشه مخروطی است، با پایین رفتن مارجین "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قطر مقطع تراش نهایی و نسبت تاج به ریشه هر دو کوچک‌تر می‌شوند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ به‌علاوه‌ی هزینه، ناراحتی بیمار و خطر برای زیبایی و ساپورت دندان‌های مجاور. پس پرسش امروز دیگر «می‌شود ترمیمش کرد؟» نیست، بلکه «"
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چقدر دوام می‌آورد؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "» است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
