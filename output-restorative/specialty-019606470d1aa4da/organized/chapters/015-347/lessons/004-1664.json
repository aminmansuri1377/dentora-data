  "steps": [
    {
      "id": "theory:e4224ca310be72ef17fd5a996259ef4cb8009bf920a8fd954b62148d9d1ce917",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "eb0e440f39cac142e52104c04945ffd327113f2c7df1590065cd11f9a09d0731",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سانترالی که فقط دسترسی‌اش باز شده بود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کیس:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سانترال ماگزیلای دختری نوجوان پس از ضربه نکروز شده و اندو شده است. تاج کاملاً سالم است و فقط حفره‌ی دسترسی باز است. همکارت پست و کراون پیشنهاد داده است. تو چه می‌کنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پاسخ، کم‌ترین کار ممکن است: در نکروز پالپیِ ناشی از تروما، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنها ترمیم لازم، سیل کردن حفره‌ی دسترسی است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". اگر کلاس ۳ متوسطی هم کنارش باشد، باز هم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نه پست لازم است نه پوشش کامل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ کامپوزیت رزین باندشده کافی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی مقدار متوسطی از ساختار تاجی رفته ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم ۵۰٪ مینای تاجی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مانده است، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ونیر پرسلن باندشده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌تواند ترمیم انتخابی باشد؛ انسیزورهای اندوشده‌ی ونیرشده مقاومتی نزدیک به دندان سالم نشان داده‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "و یک قاعده‌ی سخت: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشتن ساختار اضافی صرفاً برای جا دادن پست اندیکاسیون ندارد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در دندان قدامی با لبه‌ی انسیزال سالم، جا دادن پست از راه حفره‌ی دسترسی اغلب دشوار هم هست، چون مسیر ورود مستقیمی به کانال وجود ندارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:eeacfe1c2490d3355909bb0737006adf7b600955d9da65d20b5f40690a6f2b8b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ac74e966670bf3b00ab4b2178e1c8fade235af4298472385355aff6d73cedbe0",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "در خلفی، کاسپ را بپوشان"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عددها تردیدی باقی نمی‌گذارند"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلید موفقیت در خلفیِ اندوشده، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترمیم با پوشش کامل کاسپی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. مولرهایی که پس از ابچوریشن کراون نشدند، با نرخی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شش برابر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیشتر از دست رفتند. بقای ده‌ساله‌ی دندان‌های کراون‌شده "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۸۱٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در برابر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶۳٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای ترمیم مستقیم گزارش شده، و در دندان‌های کشیده‌شده، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۸۵٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پوشش کامل تاجی نداشتند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آمالگام بدون پوشش کاسپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نرخ موفقیت بالینی پایینی دارد و توصیه نمی‌شود. اما آمالگامِ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پوشش کاسپ در دست اپراتور ماهر می‌تواند جایگزین کم‌هزینه‌ی کراون باشد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آمالکور"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در تکنیک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کرونال-رادیکولار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، به‌جای گذاشتن پست، از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اتاقک پالپ و ۲ تا ۳ میلی‌متر کرونالِ هر کانال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای گیر ماده‌ی بیلدآپ استفاده می‌شود. با آمالکور معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پست لازم نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ پست تنها وقتی لازم می‌شود که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمق اتاقک برای گیر کور کافی نباشد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ماده‌ی کور"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آمالگام:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " استحکام بالا، مدول الاستیک حدود سه برابر کامپوزیت، کم‌حساس به رطوبت و با کنتراست رنگی مفید برای مارجین‌گذاری عمیق در سالکوس — ولی استحکام اولیه‌اش پایین است و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۵ تا ۲۰ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انتظار می‌خواهد و می‌تواند لثه را دائمی رنگی کند؛ پس در ناحیه‌ی زیبایی نه. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گلاس‌آینومر:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رهاسازی فلوراید و ثبات ابعادی، ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شکننده و کم‌مقاوم به خستگی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و نامناسب برای کور وسیع. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کامپوزیت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رایج‌ترین انتخاب، با خواص مکانیکی خوب و باند به ساختار دندان."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "یک هشدار ظریف: باند کامپوزیت به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عاج کف اتاقک پالپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به قوت باند به عاج تاجی نیست و باند رزینی با زمان و کارکرد تضعیف می‌شود؛ پس هر جا می‌توانی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گیر مکانیکی کمکی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای کور بساز."
                }
              ]
            }
          ]
        }
      ],
