      "prompt": "برای کور یک سانترال ماگزیلا که قرار است زیر کراون تمام‌سرامیک برود، کدام ماده کنار گذاشته می‌شود و چرا؟",
      "sourceContent": [
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "برای کور یک سانترال ماگزیلا که قرار است زیر کراون تمام‌سرامیک برود، کدام ماده کنار گذاشته می‌شود و چرا؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۱"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گلاس‌آینومر رزین‌مدیفاید، چون تنها ماده‌ای است که زیر سرامیک شفاف کدر و خاکستری دیده می‌شود"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۲"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کامپوزیت، چون رنگش با سرامیک شفاف تداخل می‌کند و در ناحیه‌ی سرویکال سایه‌ی خاکستری می‌سازد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۳"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آمالگام، چون می‌تواند در حین تراش لثه‌ی مارجینال را به‌شکل برگشت‌ناپذیری رنگی کند"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۴"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیچ‌کدام، چون در ناحیه‌ی زیبایی رنگ ماده‌ی کور هیچ اثری بر نتیجه‌ی نهایی کراون ندارد"
                    }
                  ]
                }
              ]
            }
          ]
        }
