      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مولری که نصف شد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کیس:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مولر دوم مندیبل، سه سال پیش اندو شده و با یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آمالگام اکلوزال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بسته شده است. بیمار امروز با شکستی می‌آید که تا زیر لثه رفته و دندان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غیرقابل ترمیم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. دندان بدون درد بود، اندو بی‌نقص بود، رادیوگرافی تمیز بود. پس چه چیزی شکست؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نخستین چیزی که باید از ذهنت پاک شود"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سال‌ها تصور می‌شد دندان اندوشده "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ذاتاً شکننده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و آب خود را از دست داده. پژوهش‌های بعدی این را رد کردند: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عاج دندان اندوشده خواص مکانیکی معادل دندان درمان‌نشده دارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و از نظر محتوای رطوبت و اتصالات عرضی کلاژن هم تفاوت معناداری ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پس «شکنندگی عاج» توضیح شکست نیست. توضیح، جای دیگری است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساختاری که دیگر آنجا نیست."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:414fb8ce4f4a98751d89068c236132c1b2e151c47cdf066095f804f360969c44",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
