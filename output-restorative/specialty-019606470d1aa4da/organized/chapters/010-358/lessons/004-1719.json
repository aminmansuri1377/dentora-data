                    {
                      "tag": "text",
                      "text": "هیچ اسلاتی لازم نیست، چون از دست رفتن دو line angle خودبه‌خود آندرکات کافی در تراش ایجاد می‌کند و گیر آمالگام را تأمین می‌کند"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
