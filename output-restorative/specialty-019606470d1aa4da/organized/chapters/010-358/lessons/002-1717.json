    {
      "id": "theory:a8686843d91ea33460a160ce6457c8253b3bb1d7dcafa2a8e471c8c2cc240e43",
      "sourceId": "theory:a8686843d91ea33460a160ce6457c8253b3bb1d7dcafa2a8e471c8c2cc240e43",
      "sourceProgress": "width: 0%;",
      "contentKey": "df29b728ed63816a8810cc315d150a10b462893f8eba26a1f2004b6eb2ad7273",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کاسپی که هنوز نشکسته، ولی ضعیف شده است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرمولر دوم بالا، آمالگام MOD قدیمی را برداشته‌ای و پوسیدگی را پاک کرده‌ای."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاسپ لینگوال هنوز سالم است، ولی دیواره‌اش نازک شده و عاج زیرش کم است. آن را بپوشانی یا دست نزنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "معیار تصمیم: گسترش تراش را از شیار اصلی به سمت نوک کاسپ بسنج."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گسترش "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تا نصف"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فاصله ⟵ کاسپ را نپوشان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گسترش "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نصف تا دوسوم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ⟵ پوشش کاسپ را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "در نظر بگیر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گسترش "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیش از دوسوم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ⟵ معمولاً کاسپ را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کاهش بده و بپوشان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "معیار دیگر:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر گسترش فاسیولینگوال بخش اکلوزال از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دوسوم فاصله‌ی میان نوک کاسپ فاسیال و لینگوال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بگذرد، معمولاً برای ساختن فرم مقاومت کافی، کاهش کاسپ لازم می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استثنا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حتی با گسترش بیش از دوسوم، اگر با قضاوت خودت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حمایت عاجی و استحکام کاسپ کافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد، می‌توانی نپوشانی. مهم‌ترین چیزی که در یک کاسپ مشکوک می‌سنجی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مقدار عاج حمایت‌کننده‌ی زیر آن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه ظاهر مینا. باندینگ آمالگام هم در آزمایشگاه کاسپ را تقویت می‌کند، ولی این اثر با گذشت زمان کم می‌شود؛ پس کاسپ شدیداً ضعیف را همچنان کاهش بده و بپوشان."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:17f3a2d665006c802ab07cb828b9c9ae8239894da25a77bf0804d490fc7652f6",
      "sourceId": "theory:17f3a2d665006c802ab07cb828b9c9ae8239894da25a77bf0804d490fc7652f6",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "e0cf87025846e795282cb7f7752c9f53f2491b1d864b378e008c638512eb3b82",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چقدر کم کنم، و چرا آناتومیک؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی تصمیم به پوشش گرفتی، مقدار کاهش سلیقه‌ای نیست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاسپ فانکشنال دست‌کم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و کاسپ نانفانکشنال "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱٫۵ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاهش می‌خواهد. برای کاسپ‌های سنتریک‌هولدینگ مولر و پرمولر، ضخامت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲٫۵ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم توصیه شده است. هرچه بار عملکردی بیشتر باشد، ضخامت بیشتری لازم است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دلیل این اعداد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جلوگیری از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خم‌شدن (فلکسچر) آمالگام زیر بار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". آمالگامِ نازک زیر بار خم می‌شود و می‌شکند. این اعداد کمترین ضخامتی است که جلوی این خم‌شدن را می‌گیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استثنای زیبایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در کاسپ فاسیال پرمولر بالا که تماس عملکردی کم یا هیچ دارد، کاهش کمتر پذیرفتنی است تا بیشترین مقدار مینای فاسیال برای زیبایی باقی بماند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تکنیک:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاسپ بدون حمایت را در همان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراش اولیه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاهش بده تا دید و دسترسی برای مراحل بعد بهتر شود. اول depth cut بزن (شیارهای راهنمای عمق روی خود کاسپ)، بعد فاصله‌ی بین آن‌ها را بردار و در پایان گوشه‌های داخلی تیز را گرد کن تا تنش در آمالگام متمرکز نشود. عمق depth cut را می‌توانی با طول سر فرز بسنجی، ولی این طول در برندهای مختلف و حتی در فرزهای یک برند یکسان نیست؛ پس اول آن را با Boley gauge یا پروب اندازه بگیر. فرز را موازی شیب کاسپ بگیر: برای کاهش کاسپ فاسیال، شیب لینگوالی و برای کاسپ لینگوال، شیب فاسیالی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاهش آناتومیک، نه تخت."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کانتور کاسپ کاهش‌یافته باید شبیه کانتور طبیعی کاسپ نتراشیده باشد. کاهش از شیب‌های مزیودیستالی کاسپ پیروی می‌کند؛ صاف‌کردن کاسپ تا یک سطح تخت، بافت سالم را بی‌دلیل هدر می‌دهد. یک عادت خوب: پیش از کاهش، ارتفاع نوک کاسپ را نسبت به دندان‌های مجاور با پروب ثبت کن تا بتوانی همان ارتفاع را با آمالگام بازسازی کنی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر فقط یکی از دو کاسپ فاسیال (یا لینگوال) را می‌پوشانی، کاهش را کمی از ناحیه‌ی شیار جلوتر ببر تا به کاسپ تراش‌نخورده برسد و مارجین کاووسورفیس ۹۰ درجه بسازد؛ این کار لبه‌ی آمالگام را ضخیم و محکم نگه می‌دارد. و یادت باشد: پوشش کاسپ ارتفاع دیواره‌های عمودی را کم می‌کند، پس نیاز به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گیر ثانویه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (شیار، اسلات، پین) بیشتر می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
