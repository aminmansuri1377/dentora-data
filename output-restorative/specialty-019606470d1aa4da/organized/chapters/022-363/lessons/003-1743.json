  "steps": [
    {
      "id": "theory:bc8e184efb45bad9b00daa3db7d864fddadbab1bf43c9ab15ccf03f12d3f3a6b",
      "sourceId": "theory:bc8e184efb45bad9b00daa3db7d864fddadbab1bf43c9ab15ccf03f12d3f3a6b",
      "sourceProgress": "width: 0%;",
      "contentKey": "a2a5c293e30cadb8ea729d616427c5c1549614b6423c4ac75e4ceec6dd0077eb",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "لبخندی که «پیر» به نظر می‌رسد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آقای ۴۵ ساله می‌گوید لبخندش «خسته» است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان‌هایش سالم‌اند ولی لبه‌های انسیزال صاف و ساییده، زاویه‌ها تیز و امبرژرهای انسیزال بسته شده‌اند. ترمیمی لازم نیست؛ شاید فقط چند دقیقه کار روی مینا لازم باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نشانه‌های لبخند جوان:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " زاویه‌های انسیزال "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گرد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، امبرژرهای انسیزال و فاسیال "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، لاین‌انگل‌های فاسیال "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نرم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". لبخند مسن‌تر پس از سایش: امبرژرهای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بسته‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و زاویه‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمتر گرد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". پس کانتورینگ زیبایی معمولاً یعنی گرد کردن زاویه‌ها، کم کردن لاین‌انگل‌های فاسیال و باز کردن امبرژرها."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مثال دوم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لبه‌های انسیزال زبر و لب‌پریده‌ی دو سانترال — کمی کوتاه کردن لبه‌ها و شکل‌دادن قرینه‌ی هر دو دندان."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار باید بداند چه اتفاقی می‌افتد و خودش آن را بخواهد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از تراش، محدوده را با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مداد یا ماژیک الکلی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی دندان علامت بزن (یا با تصویرسازی دیجیتال نشان بده) تا بیمار تصوری از نتیجه داشته باشد. تراش مینا برگشت ندارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:3dd9433b2eb025edb54b20ed4ccc48ed3338ad4b6e614a7d7cc7782794e9b2de",
      "sourceId": "theory:3dd9433b2eb025edb54b20ed4ccc48ed3338ad4b6e614a7d7cc7782794e9b2de",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "b04e1a3b62939e54fb6b32bafe722de000ae3e2ee0fc1c83e698a219ca3adcb1",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "خط قرمز: مینا و فانکشن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تمام تراش در مینا محدود می‌ماند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — به همین دلیل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی لازم نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و ایزولاسیون با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رول پنبه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کافی است. فرز الماسی برای شکل‌دادن، و دیسک و پوینت ساینده برای فینیش و پالیش. لبه‌های گردشده "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمتر لب‌پر می‌شوند و کمتر می‌شکنند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خط قرمز فانکشنال:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از هر تغییر، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکلوژن و به‌ویژه هدایت قدامی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را بسنج. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فانکشن پروتروسیو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را ارزیابی کن تا این تماس ناخواسته حذف نشود. اگر اکلوژن اجازه دهد، می‌توان مینای لینگوال را کمی کاست تا بعد فاسیولینگوال لبه کم شود — ولی نواحی لینگوالی که در تماس پروتروسیو شرکت دارند دست‌نخورده می‌مانند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاربردهای دیگر تراش مینا:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چرخش خفیف:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مینای ناحیه‌ی برجسته را کم کن و ناحیه‌ی کم‌حجم را با کامپوزیت افزایش بده — تراش برجستگی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فقط در مینا"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کانین به جای لترال غایب:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سطح فاسیال و زاویه‌ی کاسپ کانین را شکل بده تا شبیه لترال شود؛ امبرژر مزیوانسیزالی که باز می‌ماند با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "افزودن کامپوزیت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اصلاح می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دندانی که به‌طور قابل‌توجه فاسیالی قرار گرفته:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تراش جوابش نیست؛ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ارتودنسی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بهترین درمان است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی کلی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فقط مشکلاتی را به این روش درمان کن که بدون تغییر چشمگیر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکلوژن یا کانتور لثه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قابل‌اصلاح‌اند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
