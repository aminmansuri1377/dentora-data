  "steps": [
    {
      "id": "theory:0759f714bbf3da621ac7d727768660db98dca8f4f8e523f636ac86c8a613e971",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "1ab3ac2121bbe3a30471424e87e480574a0f219ff3c5ffa894bb5f6af2a7acda",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "یک فاصله، سه مسیر"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۲۶ ساله بین دو سانترال بالا فاصله دارد و می‌گوید «همین امروز پرش کنید». اگر بی‌درنگ کامپوزیت بگذاری، شاید فاصله برگردد؛ شاید هم دو سانترال پهن و بی‌تناسب تحویل بدهی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اول علت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فرنوم لبی برجسته با رشته‌های غیرالاستیک که تا بین دو دندان کشیده شده، دندان غایب مادرزادی، دندان کوچک یا بدشکل، ناهماهنگی اندازه‌ی دندان‌های دو فک (بولتون)، دندان اضافه، وراثت. و علت‌هایی که فاصله را بعداً می‌سازند: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار زبان، بیماری پریودنتال، فروریختن بایت خلفی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیاستما را بدون شناختن و درمان علت زمینه‌ای درمان نکن."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گاهی درمان خود علت، فاصله را می‌بندد. و یادت باشد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر دیاستمایی درمان نمی‌خواهد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ بسیاری از بیماران با فاصله‌ی بین دندان‌هایشان کاملاً راحت‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از هر اقدام، اکلوژن را هم ارزیابی کن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — بستن فاصله نباید هدایت قدامی را به هم بزند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:541574fc24a4c7d8759b68e64dac1cf54cfdc4d9a0fd3c971abae7fc56121af9",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "56bd5e499c43b0f14d833c9346de247c9e98688f231224f51af2d5e94aa5cda1",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اندازه، مسیر را تعیین می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دیاستما را می‌شود با جراحی، درمان پریودنتال، ارتودنسی یا پروتز درمان کرد — ولی این‌ها همیشه عملی یا مقرون‌به‌صرفه نیستند و گاهی بستن دائمی نمی‌دهند. در کیس‌های منتخب، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افزودن کامپوزیت به سطوح پروگزیمال با باندینگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جایگزین محافظه‌کارانه است؛ معمولاً بی‌آنکه نسجی برداشته شود."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فاصله‌ی کوچک (۱ میلی‌متر یا کمتر):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کامپوزیت شبه‌مینا روی پروگزیمال دو دندان کافی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فاصله‌ی متوسط تا بزرگ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یک لایه‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اپک یا شبه‌عاج"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " لازم است تا تیرگی دهان از پشت ترمیم دیده نشود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیش از ۲٫۵ میلی‌متر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ترکیب ونیر مستقیم با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جابه‌جایی ارتودنتیک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را در نظر بگیر."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فاصله‌ی خیلی بزرگ را فقط با کامپوزیت نبند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نتیجه، دو سانترال بیش از حد پهن است — یک مشکل زیبایی تازه به جای مشکل قبلی. راه بهتر: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فاصله را با ارتودنسی بین چهار اینسایزور پخش کن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تا افزودن‌های کوچک، قرینه و برابر روی سانترال‌ها و لترال‌ها بنشینند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از تصمیم، بیمار ببیند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عکس، طرح خطی، تصویرسازی دیجیتال، مدل با فضای پرشده، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماک‌آپ کامپوزیتی روی دندان اچ‌نشده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". همه‌ی گزینه‌ها — از جمله "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان‌نکردن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — باید پیش از افزودن کامپوزیت سنجیده شوند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
