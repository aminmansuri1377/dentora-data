  "steps": [
    {
      "id": "theory:8b642dfbbc6398ee18ddc5c87466ab9a7a90d294b81403f2626314211bf237a0",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "fd136dc3a582224e3ca4891aedaadca2013ec17d63333fa66f8e1c6e74989724",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فضایی که برای ترمیم نمانده"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همان مرد ۳۵ ساله برگشته. ریفلاکسش درمان شده، نوشابه را کنار گذاشته و شب‌ها پلاک می‌گذارد. حالا می‌خواهد دندان‌هایش را بلند کنی. در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حداکثر تماس دندانی (MI)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، یعنی وقتی دندان‌ها را روی هم می‌گذارد، برای ترمیم اکلوزال مولرها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تقریباً هیچ فضایی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از تراش، کمبود فضا را تشخیص بده."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر فضا کم است، دو راه داری:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فضا بساز:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " افزایش طول تاج با جراحی، اینتروژن ارتودنسی، یا کوتاه‌کردن دندان مقابل."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ماده‌ی دیگری انتخاب کن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " که برای مقاومت به حجم کمتری نیاز دارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی سایش یا اروژن ژنرالیزه است،"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اغلب بدون "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افزایش ارتفاع عمودی اکلوزال (VDO)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضایی برای بازسازی نمی‌ماند. این یک بازسازی پیچیده است، نه ترمیم تک‌دندان: مدل‌های مانت‌شده، آنالیز اکلوزال، واکس‌آپ تشخیصی و آزمودن ارتفاع تازه با ترمیم موقت پیش از کار نهایی."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:44c28911023b3951baff9147c1154a1f99ca70c2e6261cb4990533e834b2f979",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "2f2e67dd306d4b1fe431376461a352c3375b7ad693dacf8ff1c249f5fb294cc6",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "افزودن به‌جای تراشیدن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کی ترمیم کنیم؟"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ناحیه‌ی ساییده یا اروزیو فقط وقتی ترمیم می‌شود که مثلاً پوسیده باشد، ساختار دندان را تضعیف کرده باشد، حساسیتی داشته باشد که به درمان محافظه‌کارانه جواب نداده، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "در حال پیشرفت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " باشد (ضایعه‌ی پایدار و بی‌علامت فقط پیگیری می‌شود)، پلاک را به‌طور مزمن نگه دارد و مشکل لثه‌ای بسازد، در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "طراحی پروتز پارسیل متحرک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (جایگاه رست یا بازوی کلاسپ) قرار بگیرد، خطر درگیری پالپ داشته باشد، بیمار زیبایی بخواهد، یا اروژن ژنرالیزه‌ی خلفی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ارتفاع عمودی را کم کرده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رویکرد افزایشی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کامپوزیت اجازه می‌دهد ضایعه‌های غیرپوسیدگی با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تراش بسیار کم یا بدون فرز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ترمیم شوند. مداخله‌ی زودهنگام در کاسپ‌های کاسه‌ای خدمت ارزشمندی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ونیر روی سطح لبیال که اروژن یا ابریژن شدید آن را کم‌حجم کرده:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تراش داخل مینا لازم نیست؛ فقط مینا را زبر کن و مارجین‌ها را مشخص کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ماده در برابر دندان مقابل:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سرامیک می‌تواند مینای مقابل را شدیداً بساید؛ در مقابل، طلای ریختگی پالیش‌شده از مینا و آمالگام مقاوم‌تر است و دندان مقابل را کم می‌ساید. در نواحی براکسیزم از آلیاژ طلا استفاده کن، هدایت قدامی بساز، تداخل‌ها را بردار و سطح سرامیک را دوره‌ای پالیش کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نایت‌گارد بخشی از درمان است، نه ضمیمه‌ی آن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در براکسیزم خواب، پلاک اکلوزال شبانه دندان‌ها و ترمیم‌های غیرمستقیم تازه را محافظت می‌کند."
                }
              ]
            }
          ]
        }
      ],
