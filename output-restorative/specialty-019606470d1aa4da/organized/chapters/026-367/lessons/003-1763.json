  "steps": [
    {
      "id": "theory:b7715e1d0e6e2303d4417060834d5ff5d804402e821a4e1bbae3023149ba9b9a",
      "sourceId": "theory:b7715e1d0e6e2303d4417060834d5ff5d804402e821a4e1bbae3023149ba9b9a",
      "sourceProgress": "width: 0%;",
      "contentKey": "368210c98d2eca27b19bd4c633d956e8870ba373d8066637d827f1c6650f4ac0",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بیماری که از ریفلاکسش خبر ندارد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "زن ۴۲ ساله با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکلوزال‌های کاسه‌ای مولرهای پایین و کام براق دندان‌های قدامی بالا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آمده. می‌پرسی «ترش کردن یا سوزش سر دل دارید؟» می‌گوید «نه، هیچ‌وقت». نوشیدنی ورزشی نمی‌خورد و لیمو نمی‌مکد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ریفلاکس معده به مری (GERD) وقتی رخ می‌دهد که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اسفنکتر مری ناکارآمد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد و از علل شایع اروژن دندانی است. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بسیاری از مبتلایان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از علائم معده‌ای خود خبر ندارند یا آن را به دندان‌هایشان ربط نمی‌دهند. دندانپزشک ممکن است نخستین کسی باشد که نشانه‌هایش را می‌بیند؛ ولی درمان بیماری کار پزشک است، پس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارجاع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خاستگاه‌های اسید را مرور کن:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "داخلی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ریفلاکس، استفراغ مکرر در بولیمیا، استفراغ ناشی از شیمی‌درمانی، و محتویات معده در دهان در دوره‌های مصرف زیاد الکل."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خارجی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نوشیدنی‌های ورزشی و گازدار، دمنوش‌های گیاهی، مکیدن لیمو، و غرغره‌کردن نوشابه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در بولیمیا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تشخیص اغلب دشوار است؛ دندانپزشک باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با ملاحظه ولی صریح"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این احتمال را با بیمار در میان بگذارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:4f26d14441dd80292b8ec81f3b46f7ed16ad32c82945ca70729bf180eb1c85f4",
      "sourceId": "theory:4f26d14441dd80292b8ec81f3b46f7ed16ad32c82945ca70729bf180eb1c85f4",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "28ff2117e0547d436b66ce8b2d658b8204a697374946fa82d32d1a228e50517c",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بزاق، مسواک و خواب شبانه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بزاق مهم‌ترین عامل زیستی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در سرعت پیشرفت اروژن است. اروژن با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جریان کم و ظرفیت بافری پایین بزاق"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " همراه است، و غذا و نوشیدنی اسیدی خودشان ظرفیت بافری را کم می‌کنند. آزمون بزاق، جریان و ظرفیت بافری را نشان می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "داروهایی که دهان را خشک می‌کنند"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (مانند برخی ضدافسردگی‌ها، آنتی‌هیستامین‌ها و داروهای فشار خون) این سپر را ضعیف می‌کنند؛ فهرست دارویی بیمار را بخوان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مسواک روی مینای نرم‌شده با اسید"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از دست رفتن بافت را تند می‌کند. مقدار کم (به اندازه‌ی یک نخود) از خمیردندان "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کم‌ساینده با pH خنثی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سرعت اروژن و ابریژن را کم می‌کند؛ بلافاصله پس از حمله‌ی اسیدی مسواک نزن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "براکسیزم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " علت پارافانکشن می‌تواند استرس، مشکلات راه هوایی یا آپنه‌ی خواب باشد. تغییر عادت پارافانکشنال بسیار دشوار است؛ پس از دندان‌ها با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پلاک اکلوزال شبانه (نایت‌گارد)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " محافظت کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ثبت کن تا بتوانی مقایسه کنی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مدل مطالعه، عکس یا اسکن دیجیتال در طول زمان نشان می‌دهد فرایند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فعال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است یا متوقف شده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
