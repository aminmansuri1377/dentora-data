  "order": "first-encounter-with-remediation-visits-preserved",
  "steps": [
    {
      "id": "theory:5c34f944a14b1a41b0a361e42c3acfc7131cca30c03e15ab67f9ca4426a1a1d9",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "cac077124744bac951772273f28dbad61e249f7a499b3f6a61a5b210f954c6a8",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رابردم را زدی، بعد رنگ را انتخاب کردی. اشتباه کجا بود؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترمیم کلاس ۴ سانترال بالا."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رابردم را گذاشتی، پنج دقیقه تراش کردی و بعد شید را با شیدگاید انتخاب کردی. کامپوزیت پس از برداشتن رابردم یک درجه تیره‌تر از دندان به نظر می‌رسد. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کامپوزیت عوض نشد؛ دندان عوض شده بود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مینا جدا از بلورهایش، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ تا ۱۲ درصد حجمی آب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد که در فضاهای بین بلوری و شبکه‌ای از ریزمنافذ جا گرفته است. وقتی دندان خشک شود هوا جای آب این منافذ را می‌گیرد و مینا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گچی و روشن‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیده می‌شود. این تغییر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برگشت‌پذیر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و با بازگشت به محیط مرطوب دهان از بین می‌رود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شید را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از ایزولاسیون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و زیر نور با طیف کامل انتخاب کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "همان پدیده، در جای دیگری از این مسیر:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ضایعه‌ی سفید (white spot) هم یک مینای متخلخل است. خشک‌کردن آشکارش می‌کند، چون هوا جای آب را در منافذ می‌گیرد. پوار زدن یک ترفند تشخیصی است که از بافت‌شناسی می‌آید."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضایعه‌ی اولیه‌ی فعال روی سطح "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مرطوب"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تا حد زیادی ناپدید می‌شود و پس از خشک‌کردن کدر و زبر است. مینای "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هیپوکلسیفیه‌ی تکاملی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در هر دو حالت کدر ولی صاف و سخت می‌ماند و خشک و تر شدن تغییر چندانی در آن نمی‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی دمینرالیزاسیون به نزدیکی اتصال مینا-عاج رسیده باشد، حجم منافذ چنان زیاد است که ضایعه "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "روی سطح مرطوب هم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیداست. پیشرفت دمینرالیزاسیون در ضخامت مینا می‌تواند "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۴ تا ۵ سال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " طول بکشد."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:81800e34a7513c61b92c7aca2d0b9459bafc7506a434b19b7f8eb5d931b12fe6",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "554e1aa71695fef89e52bec9f939ce14b097d9f220502f5c5752ca4f2e6a7dfc",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مینای شفاف، عاج کدر: از رنگ به تصمیم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شفافیت مینا مستقیماً به میزان مینرالیزاسیون آن وابسته است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و رنگ مینا بیش از همه تابع "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضخامت خودش و رنگ عاج زیرین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لبه‌ی انسیزال دندان جوان:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مینای ضخیم و بدون عاج پشتش ⟵ ته‌رنگ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خاکستری یا کمی آبی شفاف"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ناحیه‌ی سرویکال:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مینا نازک می‌شود و عاج از پشتش پیداست ⟵ رنگ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زرد-نارنجی پرکروماتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عاج:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " معمولاً سفید-زرد و کمی تیره‌تر از مینا. سطحش "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "متخلخل‌تر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است، پس "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کدر و مات"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دیده می‌شود؛ مینا "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شفاف و براق"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سر یونیت، همین تفاوت ابزار توست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حین تراش، عاج را از مینا با سه نشانه جدا می‌کنی — "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رنگ و کدری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بازتاب نور"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سختی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". عاج در برابر نوک تیز سوند بیشتر وا می‌دهد، و عاجِ نزدیک پالپ نرم‌تر از عاج محیطی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با افزایش سن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رنگ دندان پرتر می‌شود؛ زردی دندان سالمند را به نازک‌تر یا شفاف‌تر شدن مینا، انباشت عناصر کمیاب در مینا و احتمالاً اسکلروز عاج نسبت می‌دهند. عاجی که مدت‌ها با مایعات دهان، ترمیم‌های قدیمی یا پوسیدگی کندپیشرو تماس داشته، می‌تواند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قهوه‌ای یا سیاه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
