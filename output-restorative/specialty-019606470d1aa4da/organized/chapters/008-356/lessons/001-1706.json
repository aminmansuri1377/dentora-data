  "steps": [
    {
      "id": "theory:714f32865a7e37b0a0a102e7b578154bfe55f20d82dafb50e45616d89946c31c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "fe31da19ff12017da05a33b52d21076b8938a430c6b883be3d0a7ffa623848d7",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تیر کشید و تمام شد، یا تیر کشید و ماند؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار ۳۲ ساله، دو روز پس از کامپوزیت MOD روی مولر اول پایین برگشته."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌گوید آب سرد که می‌خورد، دندان تیر تیزی می‌کشد و تا لیوان را زمین بگذارد تمام شده. شب‌ها بیدارش نمی‌کند و با جویدن هم دردی ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو دندانپزشک، دو تصمیم."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یکی ترمیم را همان جلسه برمی‌دارد و از نو می‌گذارد. دیگری اکلوژن را چک می‌کند، برای بیمار توضیح می‌دهد و دو هفته بعد دوباره او را می‌بیند. معاینه‌ی هر دو یکسان بوده است؛ فرقشان این است که دومی می‌داند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این شکایت چقدر شایع است و معمولاً به کجا می‌رسد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو پرسش کلیدی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «درد چه ویژگی‌هایی دارد؟» و «از کی شروع شده؟». همه‌ی این درس بر همین دو پرسش استوار است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک هشدار از همین ابتدا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برداشتن و تعویض یک ترمیم تازه درمان نیست؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آسیب تازه‌ای"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به همان پالپ است. حفره عمیق‌تر می‌شود و عاج باقی‌مانده نازک‌تر. در حالی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضخامت عاج باقی‌مانده مهم‌ترین عامل منفرد در محافظت پالپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. اگر دلیلی برای تعویض نداری، خود تعویض می‌تواند مشکل بعدی را بسازد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:2f90c39243e2b019a501c70eb5afc7148e95b544f879594fb542b1f6a3cb2632",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "fdb9ba136aefefac2f98f07bf04b365b25644633cd278b3c619755684d1fb25e",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چقدر شایع است و کی خودبه‌خود برطرف می‌شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آمار اطمینان‌بخش است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در یک بررسی، از بیمارانی که ۲۴ ساعت پس از گذاشتن ترمیم پرسیده شدند، حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵۰٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نوعی ناراحتی گزارش کردند؛ ولی ۷۸٪ همین افراد ناراحتی را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خفیف و گذرا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " توصیف کردند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پژوهش‌های تازه‌تر نشان داده‌اند بیشتر بیماران آمالگام اصلاً حساسیت حرارتی پس از ترمیم ندارند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چه ضایعه عمیق باشد چه سطحی، و چه سیلر یا لاینر گذاشته شده باشد چه نه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". آن‌هایی هم که ناراحتی دارند، تقریباً همه آن را جزئی می‌دانند و این ناراحتی تقریباً همیشه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ظرف ۳۰ روز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برطرف شده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نتیجه‌ی عملی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شیوع و شدت این مشکل احتمالاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیش از واقع برآورد شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. پس برخورد پیش‌فرض تو با درد کوتاهِ برانگیخته در روزهای نخست، «پیگیری» است نه «مداخله»."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این چهار نشانه برخورد پیش‌فرض را عوض می‌کنند:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "درد خودبه‌خودی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": بدون هیچ محرکی شروع می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "درد شبانه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " که بیمار را از خواب بیدار می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ماندن درد پس از برداشتن محرک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": سرما رفته و درد هنوز هست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "درد هنگام گاز گرفتن یا رها کردن گاز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": این یکی اصلاً از جنس حساسیت حرارتی نیست و اول باید اکلوژن را بررسی کرد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر هر کدام از این‌ها وجود داشت، منتظر پایان ۳۰ روز نمان و عیب‌یابی را شروع کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
