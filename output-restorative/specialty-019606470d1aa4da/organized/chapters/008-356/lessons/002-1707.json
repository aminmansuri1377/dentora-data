  "steps": [
    {
      "id": "theory:a1578946c24d07e6cc8a406d53677c11aad1ca3dfd93d18a9e42948ef047b9de",
      "sourceId": "theory:a1578946c24d07e6cc8a406d53677c11aad1ca3dfd93d18a9e42948ef047b9de",
      "sourceProgress": "width: 0%;",
      "contentKey": "9cf4e6582ff2f436041d59785e779fe8548af71cc60a3d0ccc30a67aee4d9982",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو ترمیم یکسان، یک بیمار ناراضی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو آمالگام با عمق یکسان در دو کوادرانت، هر دو با یک ماده و یک تکنیک."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یکی بی‌صداست و دیگری به سرما تیر می‌کشد. اگر علت، عبور سرما از داخل ماده به پالپ بود، هر دو باید یک‌جور رفتار می‌کردند؛ ولی نکردند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس عامل دیگری در کار است که جنس ماده و ضخامت عایق آن را توضیح نمی‌دهند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آن عامل، کیفیت "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو نظریه، دو راه‌حل متفاوت:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نظریه‌ی شوک حرارتی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": حساسیت نتیجه‌ی انتقال مستقیم تغییر دما از دهان، از راه ماده‌ی ترمیمی، به پالپ است؛ به‌ویژه وقتی عاج باقی‌مانده نازک باشد. راه‌حلش: ضخامت کافی از یک ماده‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عایق با نفوذپذیری حرارتی پایین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نظریه‌ی هیدرودینامیک پالپی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": حساسیت نتیجه‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جابه‌جایی مایع درون توبول‌ها"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است. راه‌حلش: سیل کردن توبول‌ها."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک نتیجه‌ی مستقیم از نظریه‌ی اول:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نفوذپذیری حرارتی کامپوزیت آن‌قدر پایین است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیس عایق حرارتی زیر آن لازم نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". بیس برای محافظت حرارتی فقط زیر ترمیم‌های فلزی به کار می‌رود که دما را بیشتر منتقل می‌کنند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:802843fc31d520628dc6ce0b62c9c1a206d586c4551cba6bb9f20028ec491249",
      "sourceId": "theory:802843fc31d520628dc6ce0b62c9c1a206d586c4551cba6bb9f20028ec491249",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "0baeabd15c595b262076f5f398982f6e4eeea72996d94b3fdb37977bd9fafd26",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا ستون مایع درد می‌سازد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نظریه‌ی پذیرفته‌شده‌تر این است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیشتر ترمیم‌ها میان دیواره‌ی حفره و ماده‌ی ترمیمی یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارند که مایع عاجی از آن آهسته به بیرون حرکت می‌کند. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرما این مایع را ناگهان منقبض می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، جریان ناگهان تند می‌شود و بیمار همین تغییر جریان را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حس می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا ترمیم‌های عمیق‌تر دردسر بیشتری دارند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با نزدیک شدن به پالپ، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراکم و قطر توبول‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و همراه آن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نفوذپذیری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عاج بیشتر می‌شود. توبول‌ها نزدیک اتصال مینا-عاج حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سطح را اشغال می‌کنند و نزدیک پالپ حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲۲٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". پس هم مایع بیشتری در دسترس است و هم جریان سریع‌تری ممکن است. به همین دلیل استحکام باند در عاج عمیق هم معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از عاج سطحی گزارش شده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نتیجه‌ی منطقی نظریه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر توبول‌ها بسته شوند، جریان مایع متوقف می‌شود و سرما دیگر درد ایجاد نمی‌کند. پس آنچه حساسیت حرارتی را کم می‌کند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیل مؤثر توبول‌های عاجی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه ضخامت معینی از ماده‌ی عایق. میکروسکوپ الکترونی هم این را تأیید کرده است: در عاج حساس، دهانه‌ی باز توبول‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به‌طور معنادار بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این یافته جهت دندانپزشکی ترمیمی را تغییر داد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عایق‌سازی حرارتی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به‌سوی "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیل عاج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". و توجه را به چیزی جلب کرد که پیش‌تر فرعی به نظر می‌رسید: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یکپارچگی فصل مشترک ماده‌ی ترمیمی و دندان تراش‌خورده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر زیر آمالگام بیس می‌گذاری:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰٫۵۰ تا ۰٫۷۵ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ماده‌ی بیس برای کاهش انتقال دما کافی است، پس ضخامت بیس نباید از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰٫۷۵ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیشتر شود؛ چون با ضخیم‌تر شدن بیس، مقاومت آمالگام روی آن در برابر شکست کم می‌شود. خاصیتی که تعیین می‌کند بیس یا لاینر چقدر از آمالگام حمایت کند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مدول الاستیسیته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
