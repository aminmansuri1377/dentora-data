  "title": "درس دوم: مایع توبولی، گپ و نظریه‌ی هیدرودینامیک",
  "specialtyKey": "019606470d1aa4da",
  "chapter": {
    "id": "356",
    "title": "حساسیت پس از ترمیم و عیب‌یابی",
    "position": 8
  },
  "position": 2,
  "importReady": true,
  "countsComparedWithConfiguredExpectation": false,
  "sourceSessionFinished": true,
