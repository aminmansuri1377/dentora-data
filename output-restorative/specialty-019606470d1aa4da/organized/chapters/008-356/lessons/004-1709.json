  "steps": [
    {
      "id": "theory:7aebb75fe022012dfd351159f451be1306ca28fbf6375fb3e8bbba0aa6a525b9",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "1a4730312f3781edac01d88702b3c80f941ce7f0d0eacdc8b5c8206d061bd7b7",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "روز دهم، و بیمار هنوز ناراضی است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "همان بیمار، ده روز بعد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این بار می‌گوید موقع جویدن نان هم درد دارد. سه راه به ذهنت می‌رسد: تنظیم اکلوژن، تعویض ترمیم، ارجاع برای اندو. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترتیب بررسی، نتیجه را تعیین می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ اگر از مرحله‌ی آخر شروع کنی، ممکن است دندانی را که فقط یک تماس زودرس داشت، درمان ریشه کنی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی ترتیب:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از بررسی‌ای شروع کن که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارزان‌تر، سریع‌تر و برگشت‌پذیرتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است؛ و فقط وقتی به مرحله‌ی بعد برو که مرحله‌ی قبلی مشکلی نشان نداده باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک اصل که در همه‌ی مرحله‌ها صادق است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " التهاب قابل‌توجه پالپ بیشتر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باکتری‌ها و سمومشان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ناشی می‌شود تا از سمیت خود مواد دندانی؛ واکنش پالپ به مواد، خفیف و گذراست. باکتری‌ها از راه بزاق و از گپ مارجینال وارد می‌شوند. پس هر اقدامی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را بهتر کند، هم درد را کم می‌کند و هم از پالپ در درازمدت محافظت می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:55925f8a68575c41dc89fe57722fc1a42416c13dba4a0d39d4a1102287448e27",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "741b49af4a6a4240324c5748b94ac9fc4e4ee49af4b23d3687dc479a6e8ad85c",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چهار مرحله، و شرط‌های باز کردن ترمیم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرحله‌ی ۱: تماس زودرس."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اولین چیزی که چک می‌کنی و ارزان‌ترین چیزی که اصلاح می‌کنی. نشانه‌ی راهنما: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد هنگام گاز گرفتن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، نه لزوماً با سرما. با کاغذ آرتیکولاسیون در وضعیت بسته و در حرکات جانبی بررسی و تنظیم کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرحله‌ی ۲: درز مارجین و نقص سیل."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مارجین را با بزرگ‌نمایی و پروب ته‌گرد بررسی کن. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گپ مارجینال به ریزنشت، حساسیت و تغییر رنگ مارجین می‌انجامد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ریزنشت یعنی عبور باکتری، مایع، مولکول یا یون در طول فصل مشترک ترمیم و دیواره‌ی حفره. فصل مشترک ماده و دندان منشأ بخش قابل‌توجهی از شکست ترمیم‌هاست و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوسیدگی ثانویه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در مطالعات بالینی سهم بزرگی از این شکست‌ها را دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرحله‌ی ۳: ترک."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشانه‌ی کلیدی اینجا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد هنگام رها کردن گاز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه هنگام فشار دادن. با بایت‌تست روی تک‌تک کاسپ‌ها دنبالش بگرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرحله‌ی ۴: وضعیت پالپ."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حالا پالپیت برگشت‌پذیر را از برگشت‌ناپذیر افتراق بده. یادت باشد "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضخامت عاج باقی‌مانده مهم‌ترین عامل منفرد در محافظت پالپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: ۰٫۵ میلی‌متر عاج اثر مواد سمی را ۷۵٪ و ۱ میلی‌متر آن را ۹۰٪ کم می‌کند. با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ میلی‌متر یا بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " واکنش پالپی اندکی رخ می‌دهد، و بیشترین آسیب وقتی است که این ضخامت از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰٫۲۵ تا ۰٫۳۰ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیشتر نباشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باز کردن ترمیم وقتی موجه است که:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشانه‌ی هشدار (درد خودبه‌خودی، شبانه یا ماندگار) وجود داشته باشد "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شکایت از ۳۰ روز بگذرد و بدتر شود، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بررسی اکلوژن و ترک منفی باشد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شاهدی از نقص سیل یا پوسیدگی باقی‌مانده داشته باشی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هزینه‌ی باز کردن را فراموش نکن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هر تعویض، حفره را عمیق‌تر و عاج باقی‌مانده را نازک‌تر می‌کند. اگر شرط‌ها جمع نیستند، پیگیری همراه با ثبت شدت شکایت انتخاب امن‌تری است؛ و اگر یافته‌ها به پالپیت برگشت‌ناپذیر اشاره دارند، درمان بعدی اندو است، نه یک ترمیم تازه."
                }
              ]
            }
          ]
        }
      ],
