  "steps": [
    {
      "id": "theory:a72244e81d97906278b63f9271e8ab1b6aedd6d9cec3e15398c52de8257eae3c",
      "sourceId": "theory:a72244e81d97906278b63f9271e8ab1b6aedd6d9cec3e15398c52de8257eae3c",
      "sourceProgress": "width: 0%;",
      "contentKey": "6a73c86a05285da507a6ecf10b93d44cf9e208c926593b55594806a2d514973e",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چند ثانیه پوار اضافه و کلاژنی که فرو ریخت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفره را اچ کردی، شستی و برای اینکه «مطمئن شوی خشک است» چند ثانیه پوار زدی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مینا مات و گچی شد و خیالت راحت شد. ولی در عاج زیر آن، اتفاق دیگری افتاد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اچ روی عاج، شبکه‌ای از کلاژن برهنه به جا می‌گذارد که فضاهایش با آب پر است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر این آب با هوا تبخیر شود، حجم شبکه‌ی کلاژن به حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک‌سوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حجم اولیه فرو می‌ریزد. مونومرها دیگر به فضاهای نانومتری نمی‌رسند، لایه‌ی هیبرید ناقص می‌ماند و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استحکام باند به‌شدت افت می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ به‌ویژه در ادهزیوهای استون‌دار و تا حدی در اتانول‌دارها."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عاج اچ‌شده باید چه ظاهری داشته باشد؟"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرطوب و براق"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ نه خیس و نه خشک. اگر برای دیدن مات و گچی شدن مینا ناچار شدی خشک کنی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرطوب کردن دوباره‌ی عاج کار پذیرفته‌شده‌ای است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، چون کلاژن نوع یک با آب‌رسانی دوباره باز می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج در سمت دیگر:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ادهزیوهای سلف‌اچ این مشکل را ندارند، ولی قاعده‌ی خودشان را دارند. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اچ فسفریک روی عاج پیش از ادهزیو سلف‌اچ، استحکام باند عاجی را به‌طور معنادار کم می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و با بالا بردن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نفوذپذیری عاج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌تواند حساسیت پس از ترمیم بسازد. اچ انتخابی یعنی اسید فسفریک فقط روی مینا."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آیا نوع ادهزیو تعیین‌کننده است؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بخشی از شواهد، به‌ویژه در حفره‌های عمیق‌تر، حساسیت کمتری با سلف‌اچ نشان داده است، ولی پژوهش‌های بالینی دیگر و یک مرور نظام‌مند رابطه‌ای میان نوع ادهزیو و حساسیت پس از ترمیم پیدا نکرده‌اند. تجربه و تکنیک دندانپزشک احتمالاً سهم مهم‌تری دارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:06295aafb5bd6cb67614ee0b15acd71e31cc298292e4b417f426041c6feae9a1",
      "sourceId": "theory:06295aafb5bd6cb67614ee0b15acd71e31cc298292e4b417f426041c6feae9a1",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "d4febf587554671129075813b9a48040aa3d4c9d8d9c47f7e86f8d1d4a357620",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "حلال، نور و انقباض: سه خطای پنهان دیگر"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱) حلالی که تبخیر نشد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لایه‌ی ادهزیو باید با دقت نازک شود. در ادهزیوهای توتال‌اچ دومرحله‌ای، تکرار کاربرد به تبخیر کافی حلال کمک می‌کند. اگر حلال بماند، پلیمریزاسیون ناقص می‌شود و مقدار زیادی مونومر آب‌دوست و آب در لایه باقی می‌ماند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد از کجا می‌آید؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر پیش از کیور ادهزیو، مایع عاجی پیوسته از توبول‌های باز تراوش کند، در فصل مشترک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تاول‌های میکروسکوپی پرآب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تشکیل می‌شود. بعد از ترمیم، فشار جویدن روی این تاول‌ها مثل یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پمپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عمل می‌کند، مایع را با سرعت در توبول‌ها جابه‌جا می‌کند و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فیبرهای عصبی A-δ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پالپ را تحریک می‌کند. نتیجه: حساسیت."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲) نوری که کم رسید."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دستورالعملی که دست‌کم ۴۰۰ میلی‌وات بر سانتی‌متر مربع به مدت ۴۰ ثانیه می‌خواهد، یعنی دست‌کم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۶ ژول بر سانتی‌متر مربع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی سطح. ولی حداقل انرژی لازم برای کیور کافیِ "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کف"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لایه به برند و شید بستگی دارد و از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶ تا ۲۴ ژول بر سانتی‌متر مربع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " متغیر است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نور عبوری با افزایش ضخامت به‌صورت "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نمایی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کم می‌شود؛ پس "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دو برابر کردن زمان تابش، اثر دو برابر شدن ضخامت لایه را جبران نمی‌کند"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شیدهای "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کدرتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عمود نبودن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نوک لایت‌کیور بر سطح، عمق کیور را کم می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نور LED واگراست؛ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "با دور شدن نوک، ایردیانس حتی در فاصله‌های کوتاه (مثلاً ۱۰ میلی‌متر) به‌سرعت افت می‌کند"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳) انقباضی که راه فرار نداشت."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " C-factor نسبت سطوح باندشده به سطوح آزاد است. در یک حفره‌ی اکلوزال، کامپوزیت به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پنج سطح"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باند می‌شود و فقط سطح اکلوزال آزاد است؛ یعنی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "C-factor برابر ۵"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". تنشی که آزاد نشود، به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جدا شدن باند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گپ مارجینال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌انجامد و ریزنشت و حساسیت پس از ترمیم را بیشتر می‌کند. برای تحمل این تنش، استحکام باند فوری حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۷ مگاپاسکال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لازم است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرعت کیور هم مهم است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نقطه‌ی ژل خیلی زود در طول تابش فرا می‌رسد و با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایردیانس بسیار بالا زودتر هم می‌رسد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ پس تنش فصل مشترک و گپ بیشتر می‌شود. حالت‌های «شروع نرم» (soft-start) و «پالس-تأخیر» (pulse-delay) برای کند کردن واکنش و کم کردن تنش طراحی شده‌اند، ولی هیچ‌کدام در کلینیک بهتر از تابش پیوسته با توان کامل عمل نکرده‌اند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
