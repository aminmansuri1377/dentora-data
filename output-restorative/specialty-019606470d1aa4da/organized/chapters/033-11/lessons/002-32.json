                              "text": "$5.5$"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": ". در پایین‌تر از این مرز، مینا شروع به حل شدن می‌کند. (به مرز قرمز در نمودار دقت کنید)."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
