            {
              "tag": "h4",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نکات کلیدی در تصویر:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
