              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پوسیدگی دندان حاصل برهم‌خوردن تعادل میان از دست رفتن املاح ("
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Demineralization"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ") و رسوب مجدد املاح ("
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Remineralization"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ") است. کلید این نبرد در دست pH بیوفیلم است."
                },
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/HKxEd1ZCpDeHv6DJmskhh2r4eZ0tb0W544b3ZJsg.webp",
                  "alt": "",
