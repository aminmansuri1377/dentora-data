      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اتیولوژی پوسیدگی دندان: یک نبرد ۴ عاملی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پوسیدگی دندان یک تخریب ساده‌ی شیمیایی یا صرفاً یک عفونت باکتریایی نیست؛ بلکه یک بیماری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چندعاملی (Multifactorial)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و وابسته به بیوفیلم است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/YfVFkzECpM6AKMeD03ZnfOrY2aUL6aFBRe5wIds9.png",
                  "alt": "",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/84fe80447eb97b89193fbf30953b8da496901739a3ee202b809f34481afb0a75.png"
                },
                {
                  "tag": "text",
                  "text": "۴ رکن اصلی اتیولوژی پوسیدگی (Keyes & Newbrun Diagram):"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {
                "start": "1"
              },
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "میزبان و دندان (Host & Tooth):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " آناتومی شیارها، کیفیت مینا و میزان/قدرت بافری بزاق."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بیوفیلم میکروبی (Microscopic Biofilm):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " کلونی باکتری‌های پوسیده‌زا روی سطح دندان."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ماده زمینه (Substrate):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " کربوهیدرات‌های قابل تخمیر (به‌ویژه "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ساکارز"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " که پیش‌ساز تولید اسید و ماتریس چسبنده است)."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "زمان (Time):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " فرکانس تکرار تماس اسید با دندان در طول روز."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
