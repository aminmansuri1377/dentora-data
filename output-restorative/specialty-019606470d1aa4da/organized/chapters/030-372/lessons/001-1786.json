  "steps": [
    {
      "id": "theory:aa1dcad3c2297f5a0abdb9aa8ee5d34305afbdf4964c37abc4f21d822a294d83",
      "sourceId": "theory:aa1dcad3c2297f5a0abdb9aa8ee5d34305afbdf4964c37abc4f21d822a294d83",
      "sourceProgress": "width: 0%;",
      "contentKey": "9ed2644e449786747692604556ef2f2b466095ea3d6ac4f3710a8bf6aaf3f039",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه ترمیم خراب، سه داستان متفاوت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روز فراخوان است و سه ترمیم خلفی خراب جلوی تو هستند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اولی کامپوزیتی است که از وسط دو تکه شده. دومی سالم به نظر می‌رسد، ولی زیر مارجین جینجیوالش سایه‌ی تیره‌ای دیده می‌شود. سومی هنوز سر جایش است، اما سطح اکلوزالش ناصاف و گودافتاده شده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان هر سه «تعویض ترمیم» است، ولی علتشان یکی نیست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر علت را نشناسی، ترمیم بعدی هم به همان شکل خراب می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه سازوکار شکست ماده:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شکست حجمی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ماده زیر بار می‌شکند، چون چقرمگی شکستش کم است یا ضخامتش کافی نبوده است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شکست مرزی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بین ماده و دندان فاصله باز می‌شود. عامل اصلی آن "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "انقباض پلیمریزاسیون"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و تفاوت انبساط حرارتی است. نتیجه‌اش ریزنشت، حساسیت و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پوسیدگی ثانویه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تخریب سطحی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سایش، نرم‌شدن شیمیایی و در آمالگام خوردگی، سطح ترمیم را کم‌کم از بین می‌برند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "در ترمیم‌های کامپوزیتی خلفی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوسیدگی ثانویه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یکی از علت‌های مهم شکست است و شکاف مارجین جینجیوال راه ورود باکتری را باز می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:aba6e4ffe2abd7ed2215bfe9ebe6c94b85b5d9aa742cae3f58efe540744d332c",
      "sourceId": "theory:aba6e4ffe2abd7ed2215bfe9ebe6c94b85b5d9aa742cae3f58efe540744d332c",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "1c762e3784a32af4328303522c2bf141c89e9075fd7c3fba035c01ec5efc2f5f",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هر ویژگی ماده، به یک نوع شکست گره خورده"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی کلی ساده است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیمی که خواص مکانیکی‌اش به مینا و عاج نزدیک‌تر باشد، معمولاً عمر بیشتری دارد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چقرمگی شکست:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " چقرمگی شکست کامپوزیت در مقایسه با مواد فلزی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پایین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است و شکست حجمی آن در ترمیم‌های خلفی علت شایعی برای شکست است. فیلر بیشتر، چقرمگی را بالا می‌برد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سایش:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دو نوع است. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ابریژن (abrasion)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " به‌طور یکنواخت کل سطح را درگیر می‌کند و علتش ذرات حین جویدن است. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اتریشن (attrition)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فقط در نقاط تماس اکلوزالی رخ می‌دهد و علتش تماس مستقیم با دندان مقابل است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جذب آب:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آب بیشتر جذب رزین می‌شود و اتصال فیلر به رزین را ضعیف می‌کند. به این پدیده "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تخریب هیدرولیتیک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌گویند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پیامد عملی: کامپوزیتی که کامل کیور نشده، آب بیشتری جذب می‌کند، تخریب هیدرولیتیک بیشتری دارد و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیشتر ساییده می‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". پس خطای کیور بعداً به‌صورت سایش دیده می‌شود."
                }
              ]
            }
          ]
        }
      ],
