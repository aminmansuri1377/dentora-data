  "steps": [
    {
      "id": "theory:b471c89245c74fd5991f85e939ce1e169b6a584b71c75ffa82f3ca9a44beeefe",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "9fd4f223844f98508f8be05e5be538eb5a1c0596822c1361a40f601a3c92419b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آمالگامی که از لبه ترک خورد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک آمالگام قدیمی را نگاه می‌کنی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وسط ترمیم سالم است، اما دور تا دور مارجین اکلوزالی شیار باز شده، انگار لبه‌ها ریخته‌اند. ترمیم کناری آن ده سال است که بدون مشکل مانده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تفاوت در دو چیز است: ترکیب آلیاژ و شکل لبه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آلیاژ پرمس:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آلیاژهای قدیمی کم‌مس دست‌کم ۶۵٪ نقره، ۲۹٪ قلع و کمتر از ۶٪ مس داشتند. آلیاژ پرمس ۱۲ تا ۳۰ درصد مس دارد و فاز "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گاما ۲ (قلع-جیوه)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را، که ضعیف و بسیار خورنده است، حذف کرده است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "استحکام لبه‌ی محدود:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آمالگام شکننده است. مارجین آن باید "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حدود ۹۰ درجه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " باشد، چون لبه‌ی حاد یا «باله‌ای» زیر بار جویدن می‌شکند و شیار حاشیه‌ای می‌سازد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ضخامت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در نواحی تماس اکلوزالی دست‌کم ۱٫۵ تا ۲ میلی‌متر و در نواحی اگزیال ۰٫۷۵ میلی‌متر، تا ماده زیر بار خم نشود و نشکند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آلودگی رطوبتی هنگام کندانس، تخلخل ایجاد می‌کند: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استحکام کم می‌شود و خوردگی و خزش افزایش می‌یابد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در آلیاژ کم‌مس روی‌دار، رطوبت به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انبساط تأخیری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم منجر می‌شود. آلیاژ پرمس روی‌دار این پدیده را نشان نمی‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:f1f3ec7f514f065f214e5ee54e80336fd730c1c4063680b9f9c3060c8ba5450b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "f3d6b35edb9697dfc8fdc759c707398bfb7e6ba28fa89c0e836362fc63212e2c",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آمالگام در برابر کامپوزیت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خوردگی همیشه بد نیست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آمالگام در ابتدا ریزنشت دارد، اما محصولات خوردگی کم‌کم فضای ریز بین ترمیم و دیواره را پر می‌کنند. این فرایند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیل‌شدن خودبه‌خودی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، خودبه‌خود متوقف می‌شود و چند ماه طول می‌کشد. آمالگام تنها ماده‌ی ترمیمی است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیل مرزی‌اش با گذشت زمان بهتر می‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "استحکام و سایش:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آمالگام استحکام فشاری بالا و مقاومت سایشی عالی دارد و با سرعتی نزدیک به ساختار دندان ساییده می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مدول:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تغییر شکل الاستیک کامپوزیت "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شش تا هشت برابر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آمالگام است، یعنی مدول الاستیک آن پایین‌تر است. این ویژگی با شکست حجمی، ریزترک‌ها و مقاومت کم در برابر بار اکلوزالی مرتبط است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حرارت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آمالگام عایق نیست. کامپوزیت رسانایی حرارتی پایینی دارد، ولی ضریب انبساط حرارتی آن بسیار بیشتر از دندان است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پوسیدگی ثانویه:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در بیماران با ریسک پوسیدگی بالا، احتمال پوسیدگی ثانویه در کنار آمالگام "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دست‌کم دو برابر کمتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از کامپوزیت است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "در کامپوزیت، باند و کیور درست تعیین‌کننده است. آمالگام به تکنیک و رطوبت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حساسیت کمتری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد، اما تراش بیشتری می‌خواهد و زیبا نیست."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
