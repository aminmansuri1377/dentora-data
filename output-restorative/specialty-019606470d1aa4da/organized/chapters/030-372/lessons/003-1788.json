  "steps": [
    {
      "id": "theory:bb87a73a348dabbd0a40c4f4438f3097b2180087899450e2e20f25ee269b1df7",
      "sourceId": "theory:bb87a73a348dabbd0a40c4f4438f3097b2180087899450e2e20f25ee269b1df7",
      "sourceProgress": "width: 0%;",
      "contentKey": "b283e82b6968677365e975e1a4fcef5c22f6a0f62543dd3ad7359c506326ae38",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سطح سخت است، کف نه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک کلاس II عمیق را با لایه‌ی ۴ میلی‌متری کامپوزیت معمولی پر کرده‌ای."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دستگاه را ۲۰ ثانیه روشن نگه داشتی، ولی سر دستگاه روی کاسپ تکیه داشت و حدود ۸ میلی‌متر با کف جعبه فاصله داشت. سطح ترمیم سخت و براق است. شش ماه بعد مارجین جینجیوال باز شده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نزدیک‌ترین لایه به نور به‌راحتی کیور می‌شود، اما لایه‌های عمقی ممکن است هیچ‌وقت کافی کیور نشوند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیامد کیور ناقص: استحکام باند پایین یا حتی صفر، ریزنشت بیشتر، آزادشدن مواد ناخواسته، شکست و سایش بیشتر ترمیم."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهار مرحله‌ی پلیمریزاسیون افزایشی رادیکال آزاد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فعال‌سازی، شروع، انتشار (propagation) و پایان. فوتون باید با طول موج درست جذب فوتواینیشیاتور شود تا رادیکال ساخته شود. اگر طول موج مناسب نباشد، واکنشی رخ نمی‌دهد، هر قدر هم نور قوی باشد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کامفورکینون (CQ):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آغازگر نوریش نوع II است و بیشترین جذبش در نور آبی نزدیک "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۴۷۰ نانومتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لوسیرین TPO:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آغازگر نوریش نوع I است و فقط نور بنفش زیر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۴۲۰ نانومتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را جذب می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستگاه‌های LED نسل اول و دوم تقریباً نوری زیر ۴۲۰ نانومتر نداشتند. دستگاه‌های چندطیفی هم نور بنفش دارند و هم نور آبی."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:c6f534e307fb414531360097f92ab9b9d469c47ed804a84b14db8ecc77f766fc",
      "sourceId": "theory:c6f534e307fb414531360097f92ab9b9d469c47ed804a84b14db8ecc77f766fc",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "6193e46dda01769d4b77a40efcb3aea0bb9a44bdb657c6ae8ae41dc7eab46ff6",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "انرژی، فاصله، ضخامت و ایمنی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "انرژی تابشی = تابش × زمان."
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مثلاً ۴۰۰ mW/cm² به مدت ۴۰ ثانیه، ۱۶ J/cm² انرژی می‌دهد. اما "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رابطه‌ی متقابل واقعی بین زمان و تابش وجود ندارد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ". تابش ۱۶۰۰۰ mW/cm² در یک ثانیه همان نتیجه را نمی‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فاصله:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " عددی که سازنده اعلام می‌کند در سر دستگاه اندازه‌گیری شده است. در فاصله‌ی ۸ میلی‌متری، بعضی دستگاه‌ها فقط حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲۵٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آن مقدار را به ماده می‌رسانند. نور را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تا حد ممکن نزدیک و عمود"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بر سطح نگه دار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ضخامت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " با افزایش ضخامت، نور رسیده به کف به‌صورت "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نمایی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کم می‌شود. پس دو برابر کردن زمان، اثر دو برابر شدن ضخامت لایه را جبران نمی‌کند. نور بنفش تقریباً از ۲ میلی‌متر اول عمیق‌تر نمی‌رود. رنگ‌های اپک هم زمان نوردهی بیشتری لازم دارند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "قطر نوک:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اگر توان یکسان باشد، نوک ۷ میلی‌متری حدود دو برابر نوک ۱۰ میلی‌متری تابش دارد. با این حال این دستگاه لزوماً قوی‌تر نیست، و نوک‌های turbo با افزایش فاصله سریع افت می‌کنند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایمنی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " افزایش ۵٫۵ درجه‌ای دمای پالپ در دندان میمون در ۱۵٪ موارد به نکروز انجامید. برای کاهش گرما، هنگام نوردهی با پوار روی دندان هوا بدم. خطر نور آبی بیشتر در ۴۱۵ تا ۴۸۰ نانومتر است و اوج آن ۴۴۰ نانومتر است. بدون محافظ نارنجی، اگر از ۳۰ سانتی‌متری مستقیم به نور نگاه کنی، شاید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فقط هفت نوردهی یک‌ثانیه‌ای"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از حد مجاز روزانه بگذرد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
