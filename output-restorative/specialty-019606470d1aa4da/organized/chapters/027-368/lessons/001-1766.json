      "sourceProgress": "width: 0%;",
      "contentKey": "dbabda40cf92ad2afc2d3b58c6d8de6302688a815cf7de4a3d7108a794c30a9a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دندانی که فقط هنگام جویدن درد می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زن ۴۲ ساله"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌گوید «سمت چپ پایین، وقتی چیز سفتی می‌جوم و فکم را باز می‌کنم، یک تیر تیز می‌کشد». گاهی با آب سرد هم تیر می‌کشد. نمی‌تواند بگوید کدام دندان است. مولر اول ترمیم آمالگام متوسط دارد، رادیوگرافی تمیز است و دق هم پاسخ روشنی نمی‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این همان تصویر آشنای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سندرم دندان ترک‌خورده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناراحتی هنگام جویدن، به‌ویژه درد در لحظه‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "وارد کردن یا رها کردن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فشار"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حساسیت به سرما بدون علت آشکار"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار اغلب "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دندان مقصر را پیدا نمی‌کند"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "عکس، معاینه‌ی چشمی، دق و تست‌های پالپ در این بیماران معمولاً کمکی نمی‌کنند. دو تست کارآمد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترانس‌ایلومیناسیون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بایت‌تست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هستند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:53dff9faadf147b9b2fb303d9b3def6f655c3ee4d768cb06cc622bf9d99d73b8",
      "sourceId": "theory:53dff9faadf147b9b2fb303d9b3def6f655c3ee4d768cb06cc622bf9d99d73b8",
      "sourceProgress": "width: 14.2857%;",
