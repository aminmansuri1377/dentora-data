  "order": "first-encounter-with-remediation-visits-preserved",
  "steps": [
    {
      "id": "theory:d3eae37ae70b7a8bf08a078946d4227b8ead1f24f7d2379a4fd77c4a155705f1",
      "sourceId": "theory:d3eae37ae70b7a8bf08a078946d4227b8ead1f24f7d2379a4fd77c4a155705f1",
      "sourceProgress": "width: 0%;",
      "contentKey": "979c7f162afdc67c81ac1e890f96dfb37482d060cc954508439ff8a417902344",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بسته‌ای که نشانگرش تغییر رنگ داده، ولی…"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستیار جدید ابزارهای بیمار قبلی را مستقیم بسته‌بندی کرده و در اتوکلاو گذاشته است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نوار نشانگر روی بسته تغییر رنگ داده و او می‌گوید «پس استریل است». ولی روی یک اکسکاواتور هنوز دبری خشک‌شده دیده می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرخه‌ی ابزار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جمع‌آوری و انتقال ایمن ← "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تمیزکاری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (ترجیحاً با دستگاه اولتراسونیک یا شست‌وشوی خودکار، نه با برس دستی که خطر فرورفتن ابزار در دست را بالا می‌برد) ← خشک‌کردن و بازبینی ← "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بسته‌بندی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ← "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استریلیزاسیون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ← نگهداری در بسته‌ی سالم و باز کردن آن کنار یونیت."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دبری و خون، سدی میان عامل استریل‌کننده و سطح ابزار می‌سازند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ابزار آلوده حتی پس از چرخه‌ی کامل اتوکلاو هم قابل اعتماد نیست. نوار نشانگر بیرون بسته فقط می‌گوید بسته از دستگاه گذشته، نه اینکه محتوایش استریل است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "طبقه‌بندی ابزار بر پایه‌ی خطر:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بحرانی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": وارد بافت نرم یا استخوان می‌شود ← "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "استریلیزاسیون"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نیمه‌بحرانی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": با مخاط تماس دارد (آینه، کندانسور، هندپیس) ← "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "استریلیزاسیون حرارتی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اگر در برابر حرارت مقاوم باشد، وگرنه دست‌کم ضدعفونی سطح بالا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "غیربحرانی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": فقط با پوست سالم تماس دارد ← "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تمیزکاری و ضدعفونی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (سطح پایین یا متوسط)."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:7fed944b169192a641d7e9fa2c04af7f17f81d6d9ef6202d7affdb406deab668",
      "sourceId": "theory:7fed944b169192a641d7e9fa2c04af7f17f81d6d9ef6202d7affdb406deab668",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "d949e4348835d54012c8a2a63de3bdb9b97c70ec235c6a3ec31d7f71d2f1be51",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "استریل شد؛ از کجا می‌دانی؟ و بعدش چه؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه لایه‌ی پایش:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مکانیکی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": زمان، دما و فشار هر چرخه را روی نمایشگر یا چاپگر دستگاه ببین."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شیمیایی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": نشانگری که با شرایط استریلیزاسیون تغییر رنگ می‌دهد، بیرون و داخل بسته. نشان می‌دهد شرایط به "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آن نقطه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " رسیده، نه اینکه میکروب‌ها کشته شده‌اند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیولوژیک (تست اسپور)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": تنها روشی که مستقیماً کشته شدن مقاوم‌ترین میکروارگانیسم‌ها را می‌سنجد. دست‌کم "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هفته‌ای یک بار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " انجامش بده."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا ابزار دستی از فولاد ضدزنگ است؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فولاد کربنی سخت‌تر است و تیزی را بهتر حفظ می‌کند، ولی ابزار باید بین بیماران با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بخار یا حرارت خشک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " استریل شود و فولاد ضدزنگ در برابر خوردگی مقاوم‌تر است. در این آلیاژ، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کروم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مقاومت به خوردگی و براقیت می‌دهد و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کربن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سختی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نگهداری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " همه‌ی هندپیس‌ها استریل می‌شوند، ولی استریلیزاسیون پیاپی عملکرد را کم می‌کند (عمر، توان، سرعت توربین، نور فیبر نوری، لنگی، صدا، چاک و الگوی اسپری). تیزکردن با دستگاه را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بین بیماران و پیش از استریلیزاسیون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام بده. اگر حین کار تیز می‌کنی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سنگ استریل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به کار ببر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سنگ تیزکن را با روغن استریل نکن."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روغن در استریلیزاسیون غلیظ می‌شود و لایه‌ای شبیه لاک می‌سازد که سایش لازم برای تیزکردن را از بین می‌برد. به‌جای روغن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به کار ببر و پیش از استریلیزاسیون، براده‌های فلز را با شست‌وشو یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستگاه اولتراسونیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پاک کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
