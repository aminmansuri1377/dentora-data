  "id": "1773",
  "title": "درس سوم: چرخه‌ی ابزار — از تمیزکاری تا قفسه",
  "specialtyKey": "019606470d1aa4da",
  "chapter": {
    "id": "369",
    "title": "کنترل عفونت، ارگونومی و ایمنی در اتاق ترمیمی",
    "position": 28
  },
  "position": 3,
  "importReady": true,
  "countsComparedWithConfiguredExpectation": false,
  "sourceSessionFinished": true,
