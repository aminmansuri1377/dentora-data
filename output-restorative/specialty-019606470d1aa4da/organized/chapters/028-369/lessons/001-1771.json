  "steps": [
    {
      "id": "theory:ad6c1c5fc706ed8e923104c543b9150fd543dbad1d691b1d840839eef3bff63a",
      "sourceId": "theory:ad6c1c5fc706ed8e923104c543b9150fd543dbad1d691b1d840839eef3bff63a",
      "sourceProgress": "width: 0%;",
      "contentKey": "b8a77261e0cd8e00955f5403029d04b1b7041823b7f56de2a41bdd3729039168",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ساعت ۹ صبح: تعویض یک آمالگام قدیمی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار اول، آمالگام MOD قدیمی روی مولر اول بالا."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فرز توربین با سرعت بالا روی آمالگام می‌چرخد. از دهان بیمار ذرات ترمیم قدیمی، دندان، باکتری و قطرات آب با سرعت زیاد بیرون می‌آیند. دستیار ساکشن را کمی دورتر گرفته، چون «جلوی دید را می‌گیرد»."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آئروسل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی پخش ذرات بسیار ریز آب، دبری دندان، میکروارگانیسم و ماده‌ی ترمیمی در هوا. تراش آمالگام یا کامپوزیت هم ذرات "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زیرمیکرونی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌سازد و هم بخار. ذراتی که استنشاق شوند می‌توانند آلوئول‌ها را تحریک کنند. بخار حاصل از تراش آمالگام "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیشتر جیوه است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساکشن پرحجم (HVE) نزدیک دندان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، بخار و ذرات را در همان منبع می‌گیرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رابردم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " جلوی استنشاق "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دهانی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیمار را می‌گیرد، ولی استنشاق "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بینی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بخار و ذرات ریزتر هنوز ممکن است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ماسک یک‌بارمصرف"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " باکتری و بیشتر ذرات را می‌گیرد، جز ریزترین‌ها. ماسک "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بخار جیوه و بخار مونومر رزین را فیلتر نمی‌کند"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پس ساکشنی که دور گرفته شده فقط دید را باز نکرده؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مهم‌ترین لایه‌ی حفاظت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را هم برداشته است. ماسک جای آن را نمی‌گیرد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:8a6888313c602e09afa67d992ff9398e9f636b9519b0f3ba9a3f7919014872ce",
      "sourceId": "theory:8a6888313c602e09afa67d992ff9398e9f636b9519b0f3ba9a3f7919014872ce",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "bd022c052cff789a84f29899aa1802f50a9df93c4265fd0e12c080da3638df1e",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ساعت ۱۱: کامپوزیت، لایت‌کیور و یک هندپیس برقی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار دوم کامپوزیت کلاس ۲ دارد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هندپیس تازه از استریلیزاسیون آمده، روغن‌کاری شده و مستقیم سراغ دندان می‌رود. سر لایت‌کیور با یک روکش پلاستیکی چروک و درزدار پوشیده شده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه نقطه‌ی خطر در همین یک صحنه:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "روغن اضافه‌ی هندپیس."
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بسیاری از هندپیس‌ها، طبق دستور سازنده، پس از استریلیزاسیون روغن‌کاری می‌شوند و روغن اضافه در شروع کار روی تراش پاشیده می‌شود. پیش از کارهایی مثل باندینگ، هندپیس را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چند ثانیه بیرون از دهان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " راه بینداز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بدنه‌ی لایت‌کیور اتوکلاو نمی‌شود."
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کل دستگاه و راهنمای نور را با روکش پلاستیکی شفاف بپوشان، اما "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "یک لایه، صاف، بدون چروک و بدون درز روی نوک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ". درزی که از جلوی پرتو بگذرد نور را کم می‌کند و پلیمریزاسیون را ضعیف می‌کند. حتی با روکش، بدنه‌ی دستگاه بین بیماران با ضدعفونی‌کننده‌ی مورد تأیید سازنده پاک می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هندپیس برقی فرسوده هشدار نمی‌دهد."
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هندپیس بادی فرسوده کند می‌شود و خبر می‌دهد، ولی موتور برقی برای جبران، توان بیشتری به سر هندپیس می‌فرستد و سر هندپیس به‌سرعت داغ می‌شود. در بیمار بی‌حس، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سوختگی ممکن است نخستین نشانه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " باشد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هم راه انتقال و هم خطر آسیب، با کارهای کوچک بسته می‌شوند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ساکشن درست، روکش درست، چند ثانیه راه‌اندازی، و نگهداری طبق دستور سازنده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
