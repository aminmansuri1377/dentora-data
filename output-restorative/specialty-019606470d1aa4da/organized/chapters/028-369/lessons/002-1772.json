  "steps": [
    {
      "id": "theory:021861152e1bcc0933ae9afc54f13d01bb8b8be4089ce11c1576919a6dec0efc",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "178eb782175214c1e1c236d969afdd8e9fc09298d1d95ea39e4b6e3899e58667",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بیماری که «مشکلی ندارد»"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار در فرم سابقه‌ی طبی نوشته «هیچ بیماری ندارم»."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دستیار پیشنهاد می‌دهد برای صرفه‌جویی، روکش‌های یونیت را فقط برای بیماران «پرخطر» عوض کنید. پاسخ درست این است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نمی‌دانی چه کسی ناقل است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ بسیاری از ناقلان خودشان هم نمی‌دانند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "احتیاط استاندارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی با خون، بزاق و هر ترشح بدن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "همه‌ی بیماران"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طوری رفتار کنی که گویی عفونی است. تصمیم به حفاظت را فرم سابقه تعیین نمی‌کند؛ نوع کار تعیین می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زنجیره‌ی عفونت شش حلقه دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عامل بیماری‌زا، مخزن، راه خروج، راه انتقال، راه ورود، میزبان مستعد. هر اقدام کنترل عفونت دست‌کم یکی از این حلقه‌ها را می‌شکند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دست:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شستن یا ضدعفونی دست پیش از پوشیدن دستکش و پس از درآوردن آن. دستکش "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جایگزین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شستن دست نیست و برای هر بیمار نو است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حفاظت فردی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ماسک، عینک با محافظ کناری یا شیلد صورت، و روپوش. عینک برای "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اپراتور، دستیار و بیمار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " لازم است."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:3c0552d0808fdb31fc4aa5f48b61b5e91e98368b4d9a69ef59f4936af3f828c7",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "98170529efbfc482769a2f92eefca63a8b5ab8ace6bcf38752f77d92aa2b1208",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سطح، آب یونیت و آئروسل"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سطوح تماس کلینیکی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (دسته‌ی چراغ، کلید یونیت، سر سرنگ آب و هوا) را یا با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روکش یک‌بارمصرف"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بپوشان و بین بیماران عوض کن، یا بین بیماران "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اول تمیز و بعد ضدعفونی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کن. ضدعفونی‌کننده روی لایه‌ی آلودگی خوب اثر نمی‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آب یونیت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لوله‌های باریک و آب راکد، جای مناسبی برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیوفیلم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. آب یونیت را طبق دستور سازنده پایش و تصفیه کن، و پس از هر بیمار خروجی‌هایی را که وارد دهان شده‌اند (هندپیس، سرنگ آب و هوا) حدود ۲۰ تا ۳۰ ثانیه با آب و هوا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تخلیه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کن. در کار جراحی از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آب استریل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با سیستم مخصوص استفاده کن؛ آب یونیت برای جراحی مناسب نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آئروسل را در منبع بگیر:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساکشن پرحجم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نزدیک دندان. آزمون ساده‌ی کارایی: نوک ساکشن را در یک لیوان "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۵۰ میلی‌لیتری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " آب فرو کن؛ آب باید در حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تمام شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رابردم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ به‌طور کلی پذیرفته شده که سد مؤثری برای کنترل عفونت در مطب است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساکشن بزاق جای ساکشن پرحجم را نمی‌گیرد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آب را آهسته برمی‌دارد و ظرفیت کمی برای جامدات دارد؛ کارش جمع کردن بزاق کف دهان است. نوک آن باید غیرساینده باشد و نوع یک‌بارمصرف پلاستیکی از نظر کنترل عفونت بهتر است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترتیب لایه‌ها را به خاطر بسپار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اول کنترل در منبع (ساکشن و رابردم)، بعد حفاظت فردی. ماسک آخرین لایه است، نه اولین."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
