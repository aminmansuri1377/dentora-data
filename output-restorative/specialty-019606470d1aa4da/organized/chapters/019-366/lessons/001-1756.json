  "steps": [
    {
      "id": "theory:74c6df5ad3fc822a0fed303704d6662698eca8d5d4334493201965c9e4953753",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "1a1b46ae1f68805cd1f57d3a67859745078684c501834d813dc8dadc165e02fe",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آنله سالم است؛ پس چه چیزی شکست خورد؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار آنله‌ی سرامیکی مولر اولش را در یک دستمال آورده."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شش ماه پیش گذاشته شده بود. خود آنله نشکسته. سطح داخلی‌اش براق و تمیز است و لایه‌ی سمان روی دندان مانده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جای سمان، فصل مشترکِ پاره‌شده را نشان می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سمان روی دندان یعنی اتصال سمان به ترمیم برقرار نشده بود، پس آماده‌سازی سطح داخلی را بررسی کن. سمان داخل ترمیم یعنی ایراد در سمت دندان است: ایزولاسیون، ادهزیو یا بستر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پرونده را که باز می‌کنی، سه نکته پیدا می‌شود: جلسه بدون رابردم انجام شده، سطح داخلی سرامیک فقط با الکل تمیز شده، و ادهزیوِ فقط لایت‌کیور را پیش از نشاندن ترمیم با پوار نازک و کیور کرده‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراش آنله عمداً غیرگیرنده است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گیر و مقاومت را چسباندن تأمین می‌کند، نه دیواره‌ها. برای همین برای این ترمیم‌ها فقط "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سمان رزینی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " توصیه می‌شود: هم به مینا و عاج می‌چسبد، هم به ماده‌ی ترمیم."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:daedd45f278c02ee50e3406a31c4cb68b4c70748852e45146aa750d690cc1ae1",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "a2a457d43670fc1513f7a50097772e54045aa947f3248f6a669158a15ff82ca1",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "زنجیره‌ای که از ضعیف‌ترین حلقه پاره می‌شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چسباندن ترمیم غیرمستقیم یک زنجیره است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان ⟵ ادهزیو ⟵ سمان ⟵ سطح آماده‌شده‌ی ترمیم. هر حلقه که ضعیف باشد، کل کار از همان‌جا جدا می‌شود."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ایزولاسیون:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هیچ ماده‌ای در حضور بزاق، خون، روغن یا دبری خوب کار نمی‌کند. رابردم مقرون‌به‌صرفه‌ترین وسیله است؛ اگر ممکن نبود، وسایلی مثل OptraGate یا Isolite."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ادهزیو:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ادهزیوی سه‌مرحله‌ایِ فقط لایت‌کیور زیر ترمیم غیرمستقیم جایی ندارد. اگر نازکش نکنی، جمع می‌شود و ترمیم کامل نمی‌نشیند؛ اگر با هوا نازکش کنی، استحکام باند به‌طور معنادار افت می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سازگاری:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بسیاری از ادهزیوهای دومرحله‌ای توتال‌اچ و تک‌مرحله‌ای سلف‌اچ با سمان‌های دوال‌کیور و سلف‌کیور ناسازگارند. پیش از کار مطمئن شو ادهزیو و سمان با هم پلیمریزه می‌شوند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سطح ترمیم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هر ماده آماده‌سازی خودش را می‌خواهد و الکل به‌تنهایی هیچ گیری نمی‌سازد. سرامیک شیشه‌ای را با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اسید هیدروفلوریک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اچ و سپس "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سایلن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌زنند؛ تفصیلش در درس ۳."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تاریخ مصرف:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " عمر قفسه‌ای رزین‌های دوال‌کیور کوتاه‌تر از کامپوزیت لایت‌کیور است. یک مخلوط آزمایشی در تاریکی باید ظرف حدود ۱۰ دقیقه سفت شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک مرز روشن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هیچ سمانی در درازمدت ضعف گیر و مقاومتِ تراش را جبران نمی‌کند. وقتی طراحی تراش درست است، نوع سمان اهمیت بالینی کمی دارد؛ در تراش‌های کم‌گیر است که انتخاب سمان سرنوشت‌ساز می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
