    {
      "id": "theory:e12b0c0177213f96e7f25826731dd8f604ecfbbf89753198dc3c2a754784dcec",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f0d79e725488e437ca2a7be47e5572d95ee783c1cb6a54e91f5d19357b492c37",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "1"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فرم مقاومت (Resistance Form): حفاظت در برابر شکست"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "(توضیح تصویر: این دیاگرام شفاف، دو حفره‌یِ مهندسی‌شده را مقایسه می‌کند. سمت چپ، یک حفره‌یِ غیراصولی (کم‌عمق و با زوایای تیز) را نشان می‌دهد که نیروهای جویدن (فلش‌های قرمز) باعث تمرکز استرس در کنج‌ها و شکستن دیواره‌یِ دندان می‌شوند. سمت راست، یک حفره‌یِ اصولی (با عمقِ کافیِ ۱.۵ میلی‌متر و زوایای داخلیِ گرد) را نشان می‌دهد که نیروها را به صورت یکنواخت توزیع کرده و دندان را از شکستن محافظت می‌کند (فلش‌های سبز)."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "blockquote",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فرم مقاومت (Resistance Form):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " طراحی حفره به‌گونه‌ای که هم بافتِ باقی‌مانده‌یِ دندان و هم ماده‌یِ ترمیمی، در برابر نیروهایِ عمودیِ جویدن مقاومت کرده و نشکنند (با رفرنس به تصویر بالا):"
                    }
                  ]
                },
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "🔑 "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اصول کلیدی تامین مقاومت (با رفرنس به تصویر):"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "ol",
                  "attributes": {
                    "start": "1"
                  },
                  "children": [
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "عمق کافی (Adequate Depth):"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " برای آمالگام، عمقِ حداقل "
                            },
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "۱.۵ تا ۲ میلی‌متر"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " در عاج الزامی است تا ترمیم ضخامت کافی داشته باشد و تحت فشار نشکند. (سمت راست تصویر)."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "زوایای داخلی گرد (Rounded Internal Angles):"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " زوایای داخلیِ حفره باید گرد باشند تا از تمرکز استرس (Stress Concentration) در کنج‌ها جلوگیری شود. زوایای تیز باعث شکستن دندان می‌شوند (سمت چپ تصویر)."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "کف حفره مسطح (Flat Floor):"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " کف حفره (دیواره پالپال) باید مسطح و عمود بر محور طولی دندان باشد تا نیروها را به طور یکنواخت توزیع کند."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "حفظ بافت سالم:"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " حفظ پشته‌های مارژینال و کاسپ‌ها، استحکام دندان را بالا می‌برد."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": []
            },
            {
              "tag": "p",
              "attributes": {},
