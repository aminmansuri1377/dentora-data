        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نقشه‌ی راه: مراحل اولیه آماده‌سازی (Initial Stages)"
                }
              ]
            },
            {
              "tag": "blockquote",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مراحل اولیه‌ی آماده‌سازی حفره، پایه‌یِ بیومکانیکِ ترمیم را بنا می‌کنند و شامل گام‌های زیر هستند :"
                    }
                  ]
                },
                {
                  "tag": "ol",
                  "attributes": {
                    "start": "1"
                  },
                  "children": [
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "فرم Outline (خط پیرامونی):"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " تعیینِ محدوده‌یِ نهاییِ لبه‌هایِ حفره روی سطح دندان. این خط باید تمام پوسیدگی‌هایِ سطحی و شیارهایِ مستعد را در بر بگیرد و روی مینایِ سالم قرار گیرد (خط سبز در تصویر)."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "فرم‌های اولیه مقاومت و گیر (Primary Resistance & Retention):"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "ul",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "li",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "p",
                                  "attributes": {},
                                  "children": [
                                    {
                                      "tag": "strong",
                                      "attributes": {},
                                      "children": [
                                        {
                                          "tag": "text",
                                          "text": "مقاومت:"
                                        }
                                      ]
                                    },
                                    {
                                      "tag": "text",
                                      "text": " تامینِ عمقِ کافی (حداقل ۱.۵ میلی‌متر برای آمالگام) و کفِ مسطح برای جلوگیری از شکستن دندان یا ترمیم."
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "tag": "li",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "p",
                                  "attributes": {},
                                  "children": [
                                    {
                                      "tag": "strong",
                                      "attributes": {},
                                      "children": [
                                        {
                                          "tag": "text",
                                          "text": "گیر:"
                                        }
                                      ]
                                    },
                                    {
                                      "tag": "text",
                                      "text": " ایجادِ دیواره‌هایِ همگرا (به سمت اکلوزال) برای قفل کردنِ فیزیکیِ آمالگام (خطوط آبی در تصویر)."
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "فرم دسترسی (Convenience Form):"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " تغییرِ شکلِ حفره به‌گونه‌ای که دیدِ کافی، دسترسیِ ابزارها به عمقِ پوسیدگی و امکانِ جایگذاریِ راحتِ ماده ترمیمی فراهم شود ."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": []
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/SqSS62i7WCy9NSbS4K4UwF5SemoiYE0OqlYDrcDN.webp",
