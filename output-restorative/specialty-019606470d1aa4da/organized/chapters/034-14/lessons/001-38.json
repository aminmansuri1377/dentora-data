      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بیوشیمی انحلال"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیوشیمی انحلال و pH بحرانی (Critical pH)"
                }
              ]
            },
            {
              "tag": "blockquote",
              "attributes": {},
              "children": [
                {
                  "tag": "h4",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرز انحلال: هیدروکسی آپاتیت در برابر فلورآپاتیت"
                    }
                  ]
                },
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مینا در حالت عادی در تعادل با املاح کلسیم و فسفات بزاق قرار دارد. وقتی pH محیط افت می‌کند، بزاق از املاح غیر‌اشباع شده و کریستال‌ها حل می‌شوند."
                    }
                  ]
                },
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "🔑 "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مرزهای طلایی pH بحرانی:"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "ul",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "مینای طبیعی (Hydroxyapatite - HA):"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " pH بحرانی آن "
                            },
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "5.5"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " است. در پایین‌تر از این مرز، انحلال کلسیم و فسفات آغاز می‌شود."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "مینای فلورآپاتیت (Fluorapatite - FA):"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " جانشینی یون فلوراید به جای هیدروکسید، کریستال‌ها را پایدارتر می‌کند. pH بحرانی آن به "
                            },
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "4.5"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " کاهش می‌یابد."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "یک واحد حاشیه امن:"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " حضور فلوراید باعث می‌شود مینا در برابر اسیدهای ضعیف‌تر (بین pH 4.5 تا 5.5) کاملاً مقاوم بماند."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
