              ]
            },
            {
              "tag": "blockquote",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عاج اسکلروتیک (Sclerotic / Transparent Dentin):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در پاسخ به تحریکات ملایم و مزمن (پوسیدگی کند یا سایش)، املاح کریستالی آپاتیت درون توبول‌ها رسوب کرده و آن‌ها را مسدود می‌کنند."
                    }
                  ]
                },
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "🔑 "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ویژگی‌های اسکلروز:"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "ul",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "نفوذپذیری (Permeability) عاج را به شدت کاهش داده و مانع نفوذ سموم به پالپ می‌شود."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "به دلیل انسداد توبول‌ها، سخت، صقلی و تیره دیده می‌شود."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اسید اتچ به سختی در آن نفوذ می‌کند، بنابراین نیاز به زمان اتچینگ بیشتری در ادهزیو دارد."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
