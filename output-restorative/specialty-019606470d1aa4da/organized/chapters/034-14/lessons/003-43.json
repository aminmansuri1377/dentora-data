              ]
            },
            {
              "tag": "blockquote",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعداد و قطر توبول‌های عاجی در طول بافت یکسان نیست:"
                    }
                  ]
                },
                {
                  "tag": "ul",
                  "attributes": {},
                  "children": [
