              ]
            },
            {
              "tag": "blockquote",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Streptococcus mutans"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " به عنوان عامل اصلی و آغازگرِ پوسیدگی مینا شناخته می‌شود. این باکتری دو سلاحِ کشنده دارد که با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساکارز (Sucrose)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فعال می‌شوند:"
                    }
                  ]
                },
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "🔑 "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سلاح‌های S. mutans:"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "ol",
                  "attributes": {
                    "start": "1"
                  },
                  "children": [
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "تولید ماتریس چسبنده:"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " با استفاده از آنزیم‌های خود، ساکارز را به پلیمرهایِ چسبندهِ خارجِ سلولی ("
                            },
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "Glucans/EPS"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": ") تبدیل می‌کند. این ماتریس، بیوفیلم را به دندان می‌چسباند و اسید را در مجاورت مینا محبوس می‌کند."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "اسیدزاییِ شدید:"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " ساکارز را به سرعت به اسید لاکتیک تبدیل کرده و pH محیط را به زیر ۵.۵ می‌رساند."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
