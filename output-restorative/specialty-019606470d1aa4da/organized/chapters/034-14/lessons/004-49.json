      "answer": null
    },
    {
      "id": "theory:f868bc7fd6d43ce2a53c4db813d12d61e819285536f3234a9c6b374dc00cf73a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "347eabca80d5c1ec682f3fe4caa6390aa487b13d13511d9fbd8e5a9e468a96f3",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "منحنیِ استفان و زمانِ چالشِ اسیدی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "منحنیِ استفان و زمانِ چالشِ اسیدی"
                }
              ]
            },
            {
              "tag": "blockquote",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تغییرات pH بیوفیلم پس از مصرفِ کربوهیدرات‌هایِ قابلِ تخمیر، توسط "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "منحنیِ استفان (Stephan Curve)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " توصیف می‌شود."
                    }
                  ]
                },
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "🔑 "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ویژگی‌های منحنی:"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "ul",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "سقوط سریع:"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " بلافاصله پس از مصرف قند، باکتری‌ها اسید تولید کرده و pH بیوفیلم در عرض چند دقیقه به شدت سقوط می‌کند و به زیر pH بحرانی (۵.۵) می‌رسد."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "دوران De:"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " تا زمانی که pH زیر ۵.۵ باقی بماند، فرآیند معدنی‌زدایی ادامه دارد."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "بازگشت کند:"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " بزاق به آرامی اسید را خنثی می‌کند و حدود "
                            },
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "۲۰ تا ۴۰ دقیقه"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " طول می‌کشد تا pH مجدداً به بالای ۵.۵ (محدوده Re) بازگردد."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "تکرار چالش:"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " اگر فرکانسِ مصرفِ قند زیاد باشد، دهان دائماً در وضعیت De قرار می‌گیرد و فرصت Re پیدا نمی‌کند."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:03aa6621bb79310a6af3fc837dc23b14e2cf45a68e59b5f0014a8947fe867324",
      "sourceId": null,
      "identityOrigin": "local-step",
