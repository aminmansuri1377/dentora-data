{
  "url": "https://app.dentigoapp.com/fa/lesson/1783",
  "title": "درس ۳: غیرمستقیم و زیبایی",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "ترتیب درست، نیمی از زیبایی است"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار ۳۸ ساله می‌خواهد «لبخندش روشن‌تر و مرتب‌تر» شود."
                }
              ]
            },
            {
              "tag": "text",
              "text": " دندان‌ها کمی زرد است، یک کامپوزیت کلاس III قدیمی رنگ گرفته و مولر اول یک آمالگام بزرگ با کاسپ ضعیف دارد. اگر اول کامپوزیت را عوض کنی و بعد بلیچ کنی، ترمیم تازه پس از بلیچینگ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تیره‌تر از دندان"
                }
              ]
            },
            {
              "tag": "text",
              "text": " دیده می‌شود."
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اول تصویر هدف:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طرح لبخند و ماک‌آپ پیش از هر تراش."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بعد رنگ پایه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بلیچینگ، سپس صبر تا رنگ تثبیت شود و باند دوباره قابل‌اعتماد شود."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سپس ترمیم‌ها:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رنگ را روی دندان مرطوب و پیش از ایزولاسیون انتخاب کن."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و آماده‌سازی هر سطح با منطق خودش:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سرامیک شیشه‌ای، زیرکونیا، کامپوزیت آزمایشگاهی و عاج هرکدام پروتکل جداگانه‌ای دارند."
                }
              ]
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در این مرور"
                }
              ]
            },
            {
              "tag": "text",
              "text": " بسیاری از گزینه‌های غلط، کار درستی را "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در زمان غلط"
                }
              ]
            },
            {
              "tag": "text",
              "text": " پیشنهاد می‌کنند."
            }
          ]
        }
      ]
    }
  ],
