      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیش از شروع مرور"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این مرور یک آزمون است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ۳۹ سؤال، بیشترشان سخت، و بسیاری دو مفهوم را به هم می‌دوزند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ظاهر بد ≠ ترمیم معیوب."
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دیچینگ کمتر از ۰٫۵ میلی‌متر، آبی آمالگام و خط فصل دو ترمیم، به‌تنهایی دلیل تعویض نیستند؛ خط شکست در ایستموس هست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هفت معیار:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یکپارچگی، درز لبه، فرم آناتومیک، سلامت پریودنتال، تماس‌ها، پوسیدگی عودکننده، زیبایی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پیش‌بینی‌کننده‌ها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " رادیولوسنسی، بافت نرم، مینای زیرخالی یا حفره، ترمیم لق، پلاک در درز. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "غیرپیش‌بینی‌کننده‌ها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دیچینگ کم‌عمق، آبی آمالگام و رنگ سطحی حاشیه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ثانویه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " = ضایعه‌ی تازه کنار ترمیم، با همان معیارهای اولیه، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "باقی‌مانده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " = برداشته‌نشده پیش از ترمیم."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چرخه‌ی ترمیم مجدد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، تعمیر نقص منفرد پس از تأیید برداشت کامل پوسیدگی، قابل‌قبول و اغلب ارجح است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مراقب گزینه‌هایی باش که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نتیجه‌شان درست ولی دلیلشان غلط"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            }
          ]
        }
      ],
