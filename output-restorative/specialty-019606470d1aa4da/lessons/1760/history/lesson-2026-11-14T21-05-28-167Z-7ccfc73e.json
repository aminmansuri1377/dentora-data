      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیش از شروع مرور"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این یک آزمون است، نه یک درس."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ۳۹ سؤال از هر چهار درس، از زاویه‌های تازه، به‌علاوه‌ی چند نکته‌ی تکمیلی."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جای سمان در ترمیم جداشده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، فصل مشترکِ شکست‌خورده را نشان می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تراش غیرگیرنده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ⟵ فقط سمان رزینی. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تراش خوش‌طرح"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ⟵ نوع سمان اهمیت کمی دارد. هیچ سمانی تراش ضعیف را در درازمدت نجات نمی‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زینک‌فسفات:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گیر اصطکاکی، بیشترین ریزنشت، اسلب سرد، ۹۰ ثانیه. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گلاس‌آینومر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیوند یونی، ۲۰ تا ۲۵ میکرون، ۵ دقیقه دور از رطوبت. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "RMGI:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ساده، کم‌حساسیت، با انبساط. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رزینی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " قوی‌ترین و نامحلول ولی حساس به تکنیک."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شیشه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ⟵ اسید هیدروفلوریک و سایلن جداگانه، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زیرکونیا"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ⟵ سندبلاست و MDP، بدون اسید هیدروفلوریک، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کامپوزیت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ⟵ سندبلاست بدون زدن مارجین و سایلن، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فلز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ⟵ سندبلاست، قلع یا پرایمر آلیاژ."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پروتکل:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تنظیم اکلوژن سرامیک بعد از سمان، مازاد پروگزیمال رزینی پیش از کیور، مازاد زینک‌فسفات و گلاس‌آینومر بعد از گیرش، ۹۰ ثانیه اکلوزال و ۳۰ ثانیه هر طرف."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سؤال‌های این مرور سخت‌ترند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و بسیاری دو درس را به هم می‌دوزند. عجله نکن."
                }
              ]
            }
          ]
        }
      ],
