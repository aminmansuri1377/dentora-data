                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بدون ماتریکس، نیروی کندانس به‌جای فشرده کردن آمالگام، آن را از تراش بیرون می‌راند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نوار ماتریکس فقط یک بار مصرف می‌شود و بعد دور ریخته می‌شود."
                }
              ]
            }
          ]
        }
