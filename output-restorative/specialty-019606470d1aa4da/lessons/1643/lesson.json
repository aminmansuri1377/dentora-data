                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرحله‌ی ماتریکس و وج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ایجاد می‌شود، نه هنگام پر کردن. ماتریکس پنج وظیفه دارد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آمالگام را محصور کند تا بتوان نیروی کندانس کافی وارد کرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "امکان بازسازی تماس با دندان مجاور را فراهم کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جلوی بیرون زدن آمالگام و ایجاد اورهنگ را در مارجین‌هایی که دید ندارند، مثل مارجین جینجیوال پروگزیمال، بگیرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانتور فیزیولوژیک سطح پروگزیمال را بسازد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به سطح پروگزیمال بافت سطحی قابل قبولی بدهد؛ به‌ویژه در ناحیه‌ی تماس که "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نه کارو می‌شود و نه برنیش"
