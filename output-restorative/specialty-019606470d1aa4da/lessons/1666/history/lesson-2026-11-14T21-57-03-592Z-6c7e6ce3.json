  "status": "incomplete",
  "steps": [
    {
      "id": "theory:5b4e1a1facf91e974ba0fc4c0dac511e4662c8c1bf6c033cc8c56321186e3ec8",
      "position": 1,
      "kind": "theory",
      "sourceQuestionId": null,
      "sourceStepId": null,
      "sourceProgress": "width: 0%;",
      "questionType": "unknown",
      "title": "درس ۱: بیمار سفیدی می‌خواهد — اول علت تغییر رنگ",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "یک لاترال تیره که درد ندارد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانم ۳۴ ساله می‌گوید «دندان‌هایم را سفید کن». همه‌ی دندان‌ها کمی زرد‌اند، ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لاترال پایین سمت چپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " واضحاً تیره‌تر است. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد ندارد، تورم ندارد، لق نیست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " او می‌خواهد همین امروز تری بگیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر تری را بدهی چه می‌شود؟ رنگ دندان روشن می‌شود و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنها نشانه‌ی موجود پاک می‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — بی‌آنکه بدانی زیر آن چه می‌گذرد. تیرگی یک دندان تکی می‌تواند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکروز پالپ با رادیولوسنسی اپیکال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رزورپشن داخلی یا خارجی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متامورفوز کلسیفیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد. در این حالت‌ها اغلب نه دردی هست، نه تورمی، نه لقی؛ تنها نشانه، تیره‌شدن خود دندان است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از هر نوع بلیچینگ، معاینه‌ی کامل به‌همراه رادیوگرافی غربالگری دندان‌های قدامی و هر دندان تکیِ تیره لازم است. جز احتمالاً در مورد پوسیدگی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بلیچینگ روند بیماری را متوقف نمی‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و ادامه‌ی آن روند می‌تواند به از دست رفتن دندان بینجامد. ضربه‌ی دوران کودکی هم ممکن است "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱ تا ۲۰ سال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بعد به نکروز برسد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و درباره‌ی همین دندان:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر متامورفوز کلسیفیک باشد، دندان می‌تواند زنده بماند ولی کاندید خوبی برای درمان ریشه و بلیچینگ داخلی نیست؛ بلیچینگ خارجیِ چنین دندان تکیِ تیره‌ای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بهتر است با تری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:db387aef50394b5abc8c7491ffa070395c004fc2a5fd431a01500f9c919e8c9d",
      "position": 2,
      "kind": "theory",
      "sourceQuestionId": null,
      "sourceStepId": null,
      "sourceProgress": "width: 14.2857%;",
      "questionType": "unknown",
      "title": "درس ۱: بیمار سفیدی می‌خواهد — اول علت تغییر رنگ",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "علت را بشناس تا سرعت را پیش‌بینی کنی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لکه یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکسترینسیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است (روی سطح، با تمیزکردن بیرونی برداشته می‌شود) یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اینترینسیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (درون دندان، تنها از راه بلیچینگ دسترسی‌پذیر). و مرز این دو نفوذپذیر است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برخی لکه‌های سطحی که مدت طولانی می‌مانند، درونی می‌شوند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — نیکوتین نمونه‌ی کلاسیک آن است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سرعت پاسخ بر پایه‌ی علت"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سریع‌ترین:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تیرگی ناشی از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سن، ژنتیک، سیگار و قهوه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متوسط:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لکه‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قهوه‌ای"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و قهوه‌ای فلوئورسان. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کندترین:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تتراسایکلین آبی‌خاکستری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که سرسخت است و به‌ندرت کاملاً برداشته می‌شود؛ بیشتر روشن می‌شود تا پاک. و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لکه‌های سفید اصلاً با بلیچینگ برداشته نمی‌شوند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — فقط وقتی بقیه‌ی دندان روشن‌تر شود، کمتر به چشم می‌آیند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چند علت که باید بشناسی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تتراسایکلین در حین کلسیفیکاسیون با کلسیم کیلیت می‌شود و در عاج می‌نشیند؛ نور خورشید آن را تیره‌تر و خاکستری‌آبی می‌کند، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مولرها که آفتاب نمی‌بینند زردتر می‌مانند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". مینوسایکلین می‌تواند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان کاملاً تشکیل‌شده و رویش‌یافته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را هم لکه‌دار کند. فلوراید بیش از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱ تا ۲ ppm"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در آب، آملوبلاست‌ها را دچار اختلال متابولیک می‌کند: مینای زیرسطحی هیپومینرالیزه و متخلخل با لایه‌ی سطحی خوب‌مینرالیزه. و سن: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عاج ثانویه‌ی تیره‌تر و مات‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در کنار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نازک‌شدن مینا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چه کسی کاندید نیست"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "منع:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انتظارات غیرواقعی، ناتوانی یا بی‌میلی به پیروی از پروتکل، ترمیم‌های هم‌رنگ گسترده‌ای که نیاز به تعویض ندارند یا بیمار حاضر به تعویضشان نیست، تحمل‌نکردن مزه (خانگی) یا تکنیک (مطب)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بارداری یا شیردهی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش‌آگهی محتاطانه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سابقه‌ی دندان‌های حساس، دندان‌های شفاف، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک‌سوم لثه‌ای بسیار تیره که در لبخند دیده می‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، سطوح ریشه‌ی اکسپوز، لکه‌های سفید وسیع و آشکار، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اختلال مفصل گیجگاهی‌فکی یا براکسیزم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". و بدان که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ریشه‌ها به‌خوبی تاج آناتومیک سفید نمی‌شوند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            }
          ]
        }
      ],
