                {
                  "tag": "ul",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "Type I (کلاسیک و شایع‌ترین):"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " انحلال ترجیحی "
                            },
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "مرکز/تنه منشور (Rod Core/Body)"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": "، در حالی که غلاف و دم سالم می‌مانند (نمای کندوی زنبور عسل)."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "Type II:"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " انحلال ترجیحی "
                            },
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "محیط و دم منشور (Interrod/Tail)"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": "، در حالی که مرکز منشور سالم می‌ماند."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "p",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "strong",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "Type III:"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": " انحلال نامنظم و درهم‌برهم که الگوی مشخصی ندارد (معمولاً در مینای بدون منشور/Aprismatic رخ می‌دهد)."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
