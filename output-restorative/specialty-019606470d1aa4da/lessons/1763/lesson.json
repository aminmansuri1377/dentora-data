        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بزاق مهم‌ترین عامل زیستی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در سرعت پیشرفت اروژن است. اروژن با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جریان کم و ظرفیت بافری پایین بزاق"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " همراه است، و غذا و نوشیدنی اسیدی خودشان ظرفیت بافری را کم می‌کنند. آزمون بزاق، جریان و ظرفیت بافری را نشان می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "داروهایی که دهان را خشک می‌کنند"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (مانند برخی ضدافسردگی‌ها، آنتی‌هیستامین‌ها و داروهای فشار خون) این سپر را ضعیف می‌کنند؛ فهرست دارویی بیمار را بخوان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مسواک روی مینای نرم‌شده با اسید"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از دست رفتن بافت را تند می‌کند. مقدار کم (به اندازه‌ی یک نخود) از خمیردندان "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کم‌ساینده با pH خنثی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سرعت اروژن و ابریژن را کم می‌کند؛ بلافاصله پس از حمله‌ی اسیدی مسواک نزن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "براکسیزم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " علت پارافانکشن می‌تواند استرس، مشکلات راه هوایی یا آپنه‌ی خواب باشد. تغییر عادت پارافانکشنال بسیار دشوار است؛ پس از دندان‌ها با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پلاک اکلوزال شبانه (نایت‌گارد)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " محافظت کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ثبت کن تا بتوانی مقایسه کنی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مدل مطالعه، عکس یا اسکن دیجیتال در طول زمان نشان می‌دهد فرایند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فعال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است یا متوقف شده."
                }
              ]
            }
          ]
        }
