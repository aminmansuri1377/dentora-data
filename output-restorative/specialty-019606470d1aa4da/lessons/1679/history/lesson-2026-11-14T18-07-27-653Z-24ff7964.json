  "steps": [
    {
      "id": "theory:301a0ec4abf04ac25fed525affc6853f331ebf862e5c15e636a6178f74c39f67",
      "position": 1,
      "kind": "theory",
      "sourceQuestionId": null,
      "sourceStepId": null,
      "sourceProgress": "width: 0%;",
      "questionType": "unknown",
      "title": "درس ۴: خطاهای رایج در اجرای باند",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "حفره را تا گچی‌شدن خشک کردی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دانشجویی اچ را می‌شوید و حفره را با پوار خشک می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تا مارجین‌های مینایی ظاهر "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مات و گچی (frosty)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیدا کنند. منطقش روشن است: «می‌خواهم مطمئن شوم مینا خوب اچ شده.» بیمار با حساسیت پس از ترمیم برمی‌گردد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "او مینا را درست ارزیابی کرد، ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عاج را بیش از حد خشک کرد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خشک‌کردن، بیشتر آب شبکه‌ی کلاژن دمینرالیزه را بیرون می‌کشد و فیبریل‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روی هم می‌خوابند (collapse)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". فیبریل‌ها با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیوندهای هیدروژنی تازه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به هم می‌چسبند و ساختار جمع‌شده سفت می‌شود. فضای میان فیبریل‌ها از بین می‌رود و رزین جایی برای نفوذ ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "راه‌حل، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باند مرطوب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: عاج پس از شست‌وشو کمی مرطوب می‌ماند. اگر بیش از حد خشک شد، یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گلوله‌ی پنبه‌ی مرطوب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را حدود ۳۰ ثانیه روی آن بگذار تا شبکه‌ی کلاژن دوباره باز شود. محلول آبی کلرهگزیدین هم برای همین مرطوب‌سازی به کار می‌رود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:794417b0346e7f5b38e5cca60e69c0f65e34f6d83298d41d6b123298805bdcba",
      "position": 2,
      "kind": "theory",
      "sourceQuestionId": null,
      "sourceStepId": null,
      "sourceProgress": "width: 14.2857%;",
      "questionType": "unknown",
      "title": "درس ۴: خطاهای رایج در اجرای باند",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پنج جایی که کار خراب می‌شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱) رطوبت"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هدف، سطحی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "براق و مرطوب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. رطوبت اضافه را با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پنبه‌ی کمی مرطوب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بگیر، نه با فشار هوا. ظاهر مات و گچی که روی مینا نشانه‌ی اچ کافی است، روی عاج یعنی خشکی بیش از حد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باند مرطوب هیچ‌وقت استاندارد و تکرارپذیر نشد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " میزان مناسب رطوبت مشخص نیست و برای ادهزیوهای با حلال استون، اتانول و آب متفاوت است. عاج سطحی و عمقی هم نفوذپذیری متفاوتی دارند؛ پس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک حفره می‌تواند هم‌زمان نواحی خیلی خیس و خیلی خشک داشته باشد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲) مالش فعال"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پرایمر را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم ۳۰ ثانیه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با مالش روی عاج بزن. مالش، مونومر را بهتر به عمق می‌راند و هم‌زمان رطوبت اضافه‌ی سطح را کم می‌کند؛ پایداری درازمدت باند را هم بهتر می‌کند. طولانی‌تر کردن زمان اعمال پرایمر و ادهزیو هم نفوذ مونومر و تبخیر حلال را بیشتر می‌کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳) تبخیر حلال"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بعد حلال را با هوای ملایم کامل تبخیر کن: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم ۱۰ ثانیه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و در بطری‌های ترکیبیِ پرایمر و ادهزیو معمولاً ۳۰ تا ۴۰ ثانیه. تبخیر ناکافی حلال از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زیان‌بارترین خطاهای"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اعمال ادهزیو است: حلال باقی‌مانده پلیمریزه نمی‌شود و مثل یک نرم‌کننده، شبکه‌ی پلیمر را سست می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "سطح پرایم‌شده باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یکنواخت براق"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد؛ اگر گچی و مات بود، پرایمر را دوباره بزن. در بطری را هم باز نگذار تا حلالش نپرد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۴) ضخامت لایه"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رزین باندینگ معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حلال ندارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". آن را با قلم‌مو به ضخامت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶۰ تا ۱۲۰ میکرومتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برسان. نازک‌کردن با قلم‌مو بهتر از هواست؛ فشار هوا بعضی جاها را چنان نازک می‌کند که کیور نمی‌شوند و فقط "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لایه‌ی مهارشده با اکسیژن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در آن‌ها می‌ماند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این لایه‌ی سطحی به‌خاطر تماس با اکسیژن کامل کیور نمی‌شود، ولی عیب نیست: با کامپوزیت رویی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کوپلیمریزه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شود، به شرط آنکه زیرش لایه‌ی کیورشده باشد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۵) کیور"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۰ تا ۲۰ ثانیه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تابش. کمی بیشتر از زمان توصیه‌شده‌ی سازنده، پلیمریزاسیون را بهتر می‌کند؛ ولی به‌خاطر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افزایش دما و خطر آسیب پالپ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، به‌ویژه با دستگاه‌های پرتوان، به توصیه‌ی سازنده پایبند بمان."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حساسیت پس از ترمیم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " معمولاً از سیل ناقص می‌آید: مایع عاجی پیش از پلیمریزاسیون به فصل مشترک نشت می‌کند و تاول‌های ریز آبی می‌سازد. بعد فشار جویدن این مایع را در توبول‌ها جابه‌جا می‌کند و عصب را تحریک می‌کند."
                }
              ]
            }
          ]
        }
      ],
