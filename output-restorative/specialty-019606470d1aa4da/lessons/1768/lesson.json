                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار درس ۱ روی صندلی است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باید هم دندان و هم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بخشی از دندان"
