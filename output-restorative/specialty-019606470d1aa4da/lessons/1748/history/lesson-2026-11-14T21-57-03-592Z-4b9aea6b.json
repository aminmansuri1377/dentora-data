          "children": [
            {
              "tag": "text",
              "text": "گرادیشن، نسبت طلایی، و فریب چشم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اصل گرادیشن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با حرکت چشم از خط میانی به سمت خلف، هر دندان باید نسبت به همسایه‌ی مزیالش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متناسباً باریک‌تر"
                    }
