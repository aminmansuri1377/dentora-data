                {
                  "tag": "text",
                  "text": " دیده شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نسبت طلایی (۱٫۶۱۸ به ۱)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیشنهاد شده: از روبه‌رو، سانترال ۱٫۶۱۸ برابر لترال، و لترال ۱٫۶۱۸ برابر پهنای دیداری کانین. ولی در قوس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بسیار مخروطی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، دندان‌ها ممکن است به آن نزدیک شوند؛ در قوس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهارگوش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، نسبت طلایی سانترال‌هایی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیش از حد پهن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌سازد. در دندان‌های طبیعی، این نسبت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به‌ندرت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیده می‌شود. نسبت واقعی عرض سانترال به لترال با کولیس حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱٫۲ به ۱"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. تصمیم نهایی عرض‌ها با بیمار، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در موقت‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گرفته می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقاط تماس و امبرژورها:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نقاط تماس از سانترال تا کانین "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیوسته جینجیوال‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شوند: بین دو سانترال در یک‌سوم انسیزال، بین سانترال و لترال در محل اتصال یک‌سوم انسیزال و میانی، و بین لترال و کانین کمی جینجیوال‌تر. امبرژورهای انسیزال هم از سانترال تا کانین "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمیق‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شوند؛ امبرژورهای یکنواخت غیرطبیعی‌اند. تماس بیش از حد انسیزالی ⟵ امبرژور بسته. تماسی که به اندازه‌ی کافی جینجیوالی نیست ⟵ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مثلث سیاه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قانون چهره:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «چهره»ی دندان بخشی از سطح فاسیال است که بین "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لاین‌آنگل‌های انتقالی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیده می‌شود. برای پهن‌تر نشان دادن، لاین‌آنگل‌ها را به سمت امبرژورها ببر؛ برای باریک‌تر نشان دادن، به سمت خط وسط دندان. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانین:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیمه‌ی دیستالش نباید از روبه‌رو دیده شود. پس از ترمیم پرسلنی، کانین بیش از هر دندان دیگری گرادیشن را می‌شکند: چون "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برجستگی مزیودیستالش بیش از حد دیستال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، پهن دیده می‌شود. دندانپزشک باید از نیمه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیستوفاسیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به اندازه‌ی کافی تراش دهد و تکنسین باید کار را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از روبه‌رو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ببیند. و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اصل روشنایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اجسام روشن نزدیک و تیره‌ها دور دیده می‌شوند؛ ترمیم قدامی‌ها با ولیوی بالا، وقتی خلفی‌ها دست‌نخورده بمانند، می‌تواند جلو و عقب دهان را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از هم جدا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کند و گاهی ترمیم پرمولرها لازم می‌شود."
                }
              ]
            }
          ]
        }
