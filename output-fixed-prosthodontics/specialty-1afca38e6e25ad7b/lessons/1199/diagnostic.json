{
  "url": "https://app.dentigoapp.com/fa/lesson/1199",
  "title": "درس ۳: دترمینان‌های حرکت و پارافانکشن",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "دترمینان‌ها: چه چیزی را می‌توانی عوض کنی"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دترمینان‌ها، ساختارهای آناتومیکی‌اند که حرکت مندیبل را دیکته یا محدود می‌کنند. و آن‌ها را دقیقاً بر پایه‌ی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قابلیت تغییر توسط دندانپزشک"
                }
              ]
            },
            {
              "tag": "text",
              "text": " دسته‌بندی می‌کنند:"
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دترمینان قدامی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " = "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مفصل‌بندی دندان‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". یعنی اورلپ عمودی و افقی دندان‌های قدامی و شکل تقعر لینگوال قدامی‌های بالا. این‌ها «گاهی می‌توانند با درمان ترمیمی و ارتودنسی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تغییر داده شوند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "»."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دترمینان‌های خلفی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " = شکل برجستگی‌های مفصلی، آناتومی دیواره‌های داخلی حفره‌ها، و پیکربندی کندیل‌ها. این‌ها «"
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نمی‌توانند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " توسط دندانپزشک تغییر داده شوند»، و پاسخ‌های نوروماسکولار تنها به‌طور "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غیرمستقیم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — مثلاً با تغییر شکل دندان‌های در تماس یا با یک دستگاه اکلوزال — قابل تأثیرند."
                }
              ]
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اکنون فهرستی که مستقیماً به دست تو در واکس‌آپ ترجمه می‌شود —"
                }
              ]
            },
            {
              "tag": "text",
              "text": " اثر هر متغیر بر ارتفاع کاسپ خلفی:"
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شیب برجستگی مفصلی تندتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → کاسپ‌های خلفی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "می‌توانند بلندتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسطح‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → کاسپ‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باید کوتاه‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشند."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دیواره‌ی داخلی حفره که ترانسلیشن لترال بیشتری می‌دهد → کاسپ‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باید کوتاه‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترانسلیشن حداقلی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → کاسپ‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "می‌توانند بلندتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فاصله‌ی بین‌کندیلی بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → زاویه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کوچک‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " میان حرکت لاتروتروزیو و مدیوتروزیو، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → زاویه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بزرگ‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اورلپ افقی قدامی بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → کاسپ‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باید کوتاه‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "می‌توانند بلندتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اورلپ عمودی قدامی بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → کاسپ‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "می‌توانند بلندتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باید کوتاه‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پلن اکلوزال موازی‌تر با گاید کندیلار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → کاسپ‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باید کوتاه‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، کمتر موازی → "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "می‌توانند بلندتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "منحنی قدامی-خلفی محدب‌تر (شعاع کوتاه‌تر)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " → خلفی‌ترین کاسپ‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باید کوتاه‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، کم‌محدب‌تر → "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "می‌توانند بلندتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "الگو را ببین:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " اورلپ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "افقی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و اورلپ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عمودی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " اثر "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وارونه"
                }
              ]
            },
            {
              "tag": "text",
              "text": " دارند. افقیِ بیشتر یعنی فک باید مسافت افقی بیشتری طی کند تا دیس‌اکلوژن بیفتد، پس کاسپ کوتاه‌تر لازم است؛ عمودیِ بیشتر یعنی زودتر جدا می‌شوند، پس کاسپ بلندتر مجاز است. اگر همین یک منطق را بگیری، نیازی به حفظ کردن فهرست نداری."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اثر شیب تند برجستگی:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " «اگر بیمار برجستگی‌های با شیب تند داشته باشد، مؤلفه‌ی رو به پایینِ بزرگِ حرکت کندیل حین اکسکورسیون‌های لترال و پروتروزیو به "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جدایی زودهنگام دندان‌های خلفی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " می‌انجامد.»"
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک یافته‌ی مهم که فرض شهودی را رد می‌کند:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " «هیچ همبستگی‌ای برقرار نشده است؛ یعنی بیمارانی با "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "زاویه‌ی گاید قدامی تند"
                }
              ]
            },
            {
              "tag": "text",
              "text": " لزوماً "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دیس‌اکلوژن خلفی تند"
                }
              ]
            },
            {
              "tag": "text",
              "text": " ندارند، و بالعکس.» پس نمی‌توانی یکی را از روی دیگری حدس بزنی — باید هر دو را بسنجی."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "text",
              "text": "و «مقدار ساید-شیفت به نظر نمی‌رسد در نتیجه‌ی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "از دست دادن اکلوژن"
                }
              ]
            },
            {
              "tag": "text",
              "text": " افزایش یابد»."
            }
          ]
        }
      ]
    }
  ],
