{
  "url": "https://app.dentigoapp.com/fa/lesson/1296",
  "title": "درس ۵: مرور یونیت ۶.۲",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "شکننده، ولی مهارشده"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هسته‌ی این یونیت یک واقعیت مادی است:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " سرامیک شکننده است، در فشار قوی و در کشش ضعیف. هر تصمیم این یونیت — از تطابق ضریب انبساط تا استحاله‌ی زیرکونیا — تلاشی برای مهار همین واقعیت است."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اعداد زیرساخت:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " ضخامت حداقلی فلز "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰٫۳ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " برای نجیب و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰٫۲ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " برای فلز پایه؛ زاویه‌ی اتصال "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۹۰ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ فاصله‌ی اتصال از تماس سنتریک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دست‌کم ۱٫۵ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ و تمیزکاری اولتراسونیک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۵ دقیقه"
                }
              ]
            },
            {
              "tag": "text",
              "text": " با الکل "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۹۲ درصد"
                }
              ]
            },
            {
              "tag": "text",
              "text": " نه ۷۰ درصد."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اعداد پرسلن:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " سه بازه‌ی ذوب ۸۷۰ تا ۱۰۷۰، ۱۰۹۰ تا ۱۲۶۰، ۱۲۹۰ تا ۱۳۷۰ درجه؛ پخت متال‌سرامیک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۹۵۰ تا ۱۰۲۰ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ لوسیت "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حدود ۲۰ درصد حجمی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " پس از پخت؛ ضریب شکست اکسیدهای اپک‌کننده "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بالاتر از ماتریس شیشه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ و ضریب انبساط فلز "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۳٫۵ تا ۱۴٫۵"
                }
              ]
            },
            {
              "tag": "text",
              "text": " در برابر سرامیک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۳٫۰ تا ۱۴٫۰"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اعداد تمام‌سرامیک:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " کاهش تخلخل با خلأ از "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۵٫۶ به ۰٫۵۶ درصد حجمی"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ اندازه‌ی نقص طبیعی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲۰ تا ۵۰ میکرومتر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ زیرکونیا تتراگونال میان "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۱۷۰ و ۲۳۷۰ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ پایدارکننده "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳ مول درصد ایتریا"
                }
              ]
            },
            {
              "tag": "text",
              "text": " در 3Y-TZP؛ پخت اسلیپ‌کستینگ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۱۵۰ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و پرس حرارتی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۱۶۵ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ و لوسیت پرسی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳ تا ۱۰ میکرومتر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳۵ تا ۵۰ درصد حجمی"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و سه سازوکار باند متال‌سرامیک: باند شیمیایی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " از راه لایه‌ی اکسید بین‌سطحی (آهن، قلع و ایندیم، گالیم، کروم، تیتانیوم)؛ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گیر مکانیکی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " از سایش ذرات هوابرد؛ و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تنش فشاری پسماند"
                }
              ]
            },
            {
              "tag": "text",
              "text": " از ضریب انبساط اندکی بالاتر فلز."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک تصحیح اصطلاحی که باید حفظ شود:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " «degassing» نامی نادرست برای "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اکسیداسیون"
                }
              ]
            },
            {
              "tag": "text",
              "text": " است؛ گازها حین جامد شدن ریختگی خارج می‌شوند، نه در کوره‌ی پرسلن."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "در این مرور، ۱۳ خوشه‌ی مفهومی از هر چهار درس با هم می‌آیند — با تأکید بر انتخاب سیستم سرامیکی و بر منابع شکست."
            }
          ]
        }
      ]
    }
  ],
