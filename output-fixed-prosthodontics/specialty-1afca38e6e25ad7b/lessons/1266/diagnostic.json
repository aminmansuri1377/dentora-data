{
  "url": "https://app.dentigoapp.com/fa/lesson/1266",
  "title": "درس ۵: مرور یونیت ۴.۴",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "موقت، ولی نه سرسری"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "این یونیت با یک تصحیح واژگانی آغاز شد و با یک مبادله‌ی مهندسی پایان می‌یابد. «موقت» یعنی «برای فعلاً، در انتظار ترتیب دائمی» — نه «سهل‌انگارانه»."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و چهار الزام زیستی:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " محافظت از "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پالپ"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (توبول‌های قطع‌شده، نشت، پالپیت برگشت‌ناپذیر)؛ حفظ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سلامت لثه"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (کانتور و صافی، ایسکمی و سفید شدن بافت)؛ حفظ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تماس‌ها"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (سوپرااروپشن و حرکت افقی)؛ و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محافظت مکانیکی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " از دندان ضعیف‌شده."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اعداد کلیدی این یونیت:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " افزایش دمای پالپ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حدود ۱۰ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": " با PMMA مستقیم؛ اوج دما "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۷ تا ۹ دقیقه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ برداشتن در مرحله‌ی لاستیکی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲ تا ۳ دقیقه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ بنزوئیل پراکسید در "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۵۰ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": " تجزیه می‌شود؛ تبخیر مونومر نزدیک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۰۰ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ ورق ترموپلاستیک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰٫۵ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ بروز حساسیت آلرژیک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲۰ درصد"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ مونومر آزاد باقی‌مانده در بلانک CAD-CAM "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حدود ۱ درصد"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ و سقف فرز درون‌مطبی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پنج واحد"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و دو مبادله‌ی اصلی که در سراسر این یونیت تکرار می‌شوند: مونومر بزرگ‌تر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " = گرمای کمتر ولی استحکام کمتر؛ و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فیلر بیشتر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " = گرما و انقباض کمتر و استحکام بیشتر، تا جایی که دست‌کاری ممکن بماند."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک تشخیص که فراموشش نکن:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " روکش موقتی که پیوسته می‌شکند یا دی‌سمان می‌شود، یا از "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اکلوژن نادرست"
                }
              ]
            },
            {
              "tag": "text",
              "text": " خبر می‌دهد یا از "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فرم مقاومت و گیر ناکافی تراش"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "در این مرور، ۱۳ خوشه‌ی مفهومی از هر چهار درس با هم می‌آیند — با تأکید بر تصمیم‌گیری میان سه تکنیک و بر پیامدهای انتخاب ماده."
            }
          ]
        }
      ]
    }
  ],
