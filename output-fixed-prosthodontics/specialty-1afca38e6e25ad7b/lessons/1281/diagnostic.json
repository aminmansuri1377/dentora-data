{
  "url": "https://app.dentigoapp.com/fa/lesson/1281",
  "title": "درس ۵: مرور یونیت ۵.۳",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "از موم تا فلز"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این یونیت یک زنجیره‌ی مادی است:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " طراحی فریم‌ورک ← انتخاب آلیاژ ← اسپرو و اینوستمنت ← برنت‌اوت ← ریخته‌گری ← بازرسی عیوب. هر حلقه اعداد و مبادله‌های خودش را دارد."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اعداد فریم‌ورک:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " ضخامت حداقلی پرسلن در فصل‌مشترک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰٫۵ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ ارتفاع کالر در موم "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حدود ۰٫۵ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ استاپ ابزار کات‌بک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ فاصله‌ی استاپ سنتریک از اتصال پرسلن-فلز "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دست‌کم ۱٫۵ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ و زاویه‌ی سطح ونیرشونده با فریم‌ورک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۹۰ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اعداد آلیاژ:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " سایش مینا "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حدود ۱۰ میکرومتر در سال"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ آستانه‌ی سختی مینا "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حدود ۳۵۰ VHN"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ تطابق ضریب انبساط حرارتی در حدود "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰٫۵ در ۱۰⁻⁶ بر درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ فلزات "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۳٫۵ تا ۱۴٫۵"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و پرسلن‌ها "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۳٫۰ تا ۱۴٫۰"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ دمای انتقال شیشه‌ای "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۵۰۰ تا ۷۰۰ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ و چگالی طلا "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۹٫۳"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، پالادیوم "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۲٫۰"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، نیکل "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۸٫۹"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، کبالت "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۸٫۸"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اعداد ریخته‌گری:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " اسپرو "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲ تا ۲٫۵ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " با زاویه‌ی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۳۵ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ پوشش اینوستمنت روی الگو "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حدود ۶ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ مرز پایداری گچ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۶۵۰ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ برنت‌اوت "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۶۵۰ یا ۴۸۰ درجه به مدت ۴۵ دقیقه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ روش شتاب‌یافته "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۵ + ۱۵ دقیقه با کوره‌ی ۸۱۵ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ حداقل ضخامت موم "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰٫۳ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ و جرم آلیاژ "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۶ / ۹ / ۱۲ گرم"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک قاعده‌ی جهت‌دار که فراموشش گران است:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " ضریب انقباض حرارتی فلز باید اندکی بالاتر از پرسلن باشد تا سرامیک در تنش فشاری پسماند سودمند قرار گیرد."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و دو سازوکار مقاومت به خوردگی:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " در آلیاژهای نجیب، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نجابت ذاتی اتم‌ها"
                }
              ]
            },
            {
              "tag": "text",
              "text": "؛ در فلزات پایه، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پسیواسیون با لایه‌ی اکسید کروم"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "text",
              "text": "در این مرور، ۱۳ خوشه‌ی مفهومی از هر چهار درس با هم می‌آیند — با تأکید بر انتخاب آلیاژ در موقعیت‌های واقعی و بر عیب‌یابی ریختگی."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و گردش کار دیجیتال:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " برای ورود به آن، شکل مطلوب دندان را پیش از تراش ثبت می‌کنی: "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اسکن داخل‌دهانی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " دندان یا "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اسکن آزمایشگاهی کست یا قالب"
                }
              ]
            },
            {
              "tag": "text",
              "text": " پیش از درمان؛ اگر آناتومی خود دندان مناسب نیست، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تصویر آینه‌ای دندان دیگری"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، به‌ویژه در ناحیه‌ی زیبایی؛"
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اسکن "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "واکس‌آپ تشخیصی یا ترمیم موقتی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " که در دهان تأیید شده؛ و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کتابخانه‌ی دندان"
                }
              ]
            },
            {
              "tag": "text",
              "text": " نرم‌افزار. و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ساخت افزایشی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " می‌تواند تیتانیوم و آلیاژهایش را، به شرط "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پودر ریزدانه‌ی مناسب"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، بسازد؛ برخلاف ریخته‌گری تیتانیوم که به تجهیزات ویژه نیاز دارد."
            }
          ]
        }
      ]
    }
  ],
