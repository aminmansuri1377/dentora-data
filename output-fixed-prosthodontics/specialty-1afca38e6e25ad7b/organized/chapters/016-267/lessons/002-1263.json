  "steps": [
    {
      "id": "theory:7be7e554e2e46dbc463e1c4be7af126bfa364439f70de4950af23cf6c3739dab",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "34407872281cfd290f12f35fa2ebaa88719f5f344919d3659c3ffa03388223ab",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ترمیم موقت به‌عنوان ابزار تشخیصی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چه چیزهایی را می‌توان با ترمیم موقت ارزیابی کرد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «تغییرات در روابط عملکردی و بین‌قوسی می‌توانند با ترمیم‌های موقت ارزیابی شوند. این تغییرات می‌توانند به‌شکل تغییر در صفحه‌ی اکلوزال، گاید قدامی، الگوی دیس‌کلوژن، موقعیت درمانی، الگوهای عملکردی، و بعد عمودی اکلوزال باشند.»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و برای چه بیمارانی مهم‌تر است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «این به‌ویژه برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار دارای سایش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا کسانی که روش‌های ترمیمی متعدد آناتومی دندانشان را به‌شدت تغییر داده اهمیت دارد.»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و نقطه‌ی شروع:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «ترمیم‌های موقت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بر پایه‌ی یک واکس‌آپ تشخیصی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ساخته می‌شوند، پس از آنکه رکوردهای بالینی مناسب گرفته شده باشند. سپس به بیمار اجازه داده می‌شود اکلوژن جدید را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«تست‌درایو»"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کند، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هم کلینیسین و هم بیمار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌توانند تصمیم بگیرند چه زمانی وقت حرکت به سمت ترمیم‌های دائمی است.»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مهم‌ترین جمله‌ی این درس —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شکستن به‌عنوان تشخیص: «روکش‌های موقتی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیوسته می‌شکنند یا دی‌سمان می‌شوند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به کلینیسین می‌گویند که (۱) "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکلوژن درست نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، یا دست‌کم با حرکات عملکردی و پارافانکشنال بیمار سازگار نیست، یا (۲) فرم مقاومت و گیر تراش‌های دندان ناکافی است.»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "یعنی شکست مکرر یک شکست نیست؛ یک داده است. پیش از آنکه دوباره سمان کنی، از خودت بپرس کدام یک از آن دو علت برقرار است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5794cf2d5a87c4a266e27d984dc24939aa2299fd2fc928e81a77eb9e0f06c303",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "f0ed90c7a75baf7fe9198f9f1a3df28292816aedf078e5620f4e2b83aae70e55",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "زیبایی و انتقال کانتور به آزمایشگاه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قیاس با پروتز کامل:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «در درمان پروتز کامل، رسم است که یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارزیابی مومی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام شود تا بیمار پیش از پروسس شدن دنچر به تفسیر زیبایی‌شناختی دندانپزشک واکنش نشان دهد. بسیاری از دندانپزشکان این را ضروری می‌دانند به دلیل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فراوانی درخواست‌های بیماران برای تغییر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و سهولتی که چنین تغییراتی با آن انجام می‌شوند.»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و چرا در پروتز ثابت هم لازم است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «درمان پروتز ثابت در ناحیه‌ی زیبایی به‌شدت بر ظاهر اثر می‌گذارد، و باید به بیمار فرصت اظهار نظر داده شود. زیبایی و ظاهر شخصی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بسیار ذهنی و دشوار برای انتقال کلامی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "اند، و یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروتز شبیه‌ساز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌تواند نقشی حیاتی در ملاحظه‌ی زیبایی توسط بیمار و اثری که پروتز بر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تصویر او از خودش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد بازی کند.» و افزون بر آن: «گرفتن نظر دیگرانی که قضاوتشان ارزشمند است نیز مهم است.»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و چرا توصیف کلامی کافی نیست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «توصیف‌های کلامی به‌تنهایی اغلب "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیش از حد مبهم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "اند و مکرراً به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اصلاح‌های بیش از حد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌انجامند، که در ترمیم دائمی دشوار یا ناممکن‌اند که برگردانده شوند.»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و روال انتقال، گام به گام:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «ترمیم موقت شکل داده و اصلاح می‌شود تا ظاهرش برای دندانپزشک و بیمار متقابلاً قابل قبول باشد. وقتی این حاصل شد، قالبی از ترمیم موقت گرفته و کستی ریخته می‌شود. این کست همراه دستور کار پروتز ثابت به آزمایشگاه می‌رود، جایی که کانتورها در ترمیم دائمی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بازتولید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شوند.»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مسیر دیجیتال همان کار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «این کار را می‌توان با یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اسکنر داخل‌دهانی کنار صندلی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیز انجام داد.» و شرط بیشترین کارایی: «این فرایند وقتی کارآمدترین است که با یک واکس‌آپ تشخیصی دستی یا دیجیتال آغاز شود.»"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و نتیجه‌ی انسانی‌اش:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «دخیل کردن بیمار در تصمیم‌گیری، رضایت بیمار را افزایش می‌دهد.»"
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
