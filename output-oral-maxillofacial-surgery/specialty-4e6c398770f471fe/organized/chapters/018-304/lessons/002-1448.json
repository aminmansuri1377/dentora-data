  "steps": [
    {
      "id": "theory:71fbc1a15e32943a984e7e89ea2c8fd86cd19ed89c8c7111deb8f4590afb1e39",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "ea59962a6d248c0563cfc9755c74dbaffd351e506b5f4117bddf6ebeb02a3843",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چه کسی واقعاً عفونت را شکست می‌دهد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک جمله کل این درس را می‌سازد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در نهایت این دفاع میزبان بیمار است که پس از مدیریت جراحی، با عفونت مبارزه می‌کند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-16-1.webp",
                  "alt": "عفونت پری‌رادیکولار انسیزور بالا و تحلیل استخوان فاسیال",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/5211a520420cffce190b6df5ceb0b0b168e97dcd5abeb323b495cfd9e8368b76.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت پری‌رادیکولار انسیزور بالا و تحلیل استخوان فاسیال "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 16.1)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یعنی بخش حیاتی ترمیم پس از یک عفونت اودنتوژنیک، حضور یک سیستم دفاعی میزبان سالم است. جراحی و آنتی‌بیوتیک، شرایط را فراهم می‌کنند؛ ولی کارِ اصلی را بدن بیمار انجام می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و این نکته را دست‌کم نگیر:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اهمیت ارزیابی دقیق دفاع میزبان بیمار، و بهینه کردن آن، نمی‌تواند بیش از حد تأکید شود. و این، اهمیت گرفتن شرح‌حال کامل هنگام مراجعه‌ی بیمار را برجسته می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و قاعده‌ی عملی که از این نتیجه می‌شود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وقتی سازوکار دفاعی میزبان مختل است، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باید با مدیریت تهاجمی عفونت جبران شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — یعنی درمان جراحی و، در بیشتر موارد، درمان آنتی‌بیوتیکی کمکی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پس بیمار با نقص ایمنی، همان درمانی را نمی‌گیرد که بیمار سالم. نه چون عفونتش متفاوت است، بلکه چون کمکی که از بدن خودش می‌آید کمتر است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:f2ce9a5972905a8f38679bd8d6b1637c70239ed307315f9ab2989df19f471747",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "fd8420804620efeaa109002124ccdbf015d533697e0ed64c3c267ff782f8b699",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو دسته بیماری همراه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیماری‌های همراهی که به سیستم دفاعی میزبان آسیب می‌زنند، به دو دسته‌ی اصلی تقسیم می‌شوند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیماری‌های متابولیک که به‌قدر کافی کنترل نشده‌اند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حالاتی که مستقیماً بر سیستم ایمنی اثر می‌گذارند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مهم‌ترین مثال دسته‌ی اول:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیابت شیرین با کنترل ضعیف، که به‌شدت با اختلال ترمیم مرتبط است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مکانیسمش دقیقاً این است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هایپرگلایسمی سبب کاهش کموتاکسی و فاگوسیتوز لکوسیت‌ها می‌شود، و توانایی فرد در مقاومت و مبارزه با عفونت را به‌شدت مختل می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و نمونه‌های دسته‌ی دوم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سرطان‌های خونی مانند لوسمی و لنفوم، شیمی‌درمانی، داروهای سرکوب‌گر ایمنی و کورتیکواستروئیدها، و عفونت HIV شدید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک قاعده‌ی عملی برای موارد شدید:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیماران با عفونت‌های شدید، به‌ویژه در محیط بیمارستانی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیازمند کنترل دقیق قند خون‌اند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و همین‌جا حلقه به درس قبلی وصل می‌شود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر در مرور سیستم‌ها پُرادراری و پُرنوشی و پُرخوری را نپرسیده باشی، ممکن است دیابت تشخیص‌داده‌نشده‌ی بیمار را ندیده بگیری — و بعد تعجب کنی که چرا عفونتش پاسخ نمی‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
