  "steps": [
    {
      "id": "theory:d926742c6f0b96af8c64978a68bfb6ddaa3d04a580df9f9d625e729df29d7f25",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "8710e6ebf97a26e64bb2f0c2c1f719fabb14b060e9962eee93b7e96a9cdf6208",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اولین هدف تو"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عفونت‌های اودنتوژنیک می‌توانند از روتین و موضعی تا شدید و تهدیدکننده‌ی حیات باشند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-16-2.webp",
                  "alt": "عفونت پری‌اپیکال مولر پایین معمولاً از کورتکس لینگوال بیرون می‌زند",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/2e548eeacc74b1eb15092a0d24d4df00346787179f122fe86bb103721d90fae8.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت پری‌اپیکال مولر پایین معمولاً از کورتکس لینگوال بیرون می‌زند "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 16.2)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و اولین هدف درمانگر روشن است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تعیین شدت، و مداخله بر همان اساس. این اجازه می‌دهد عفونت کنترل شود و از پیشرفت به فضاهای بافتی بالقوه‌ی عمیق‌تر جلوگیری شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و تعیین شدت، یک ترتیب مشخص دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شرح‌حال کامل، سپس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "معاینه‌ی فیزیکی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و سپس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر آزمون کمکی لازم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — مانند مطالعات تصویربرداری و آزمایشگاهی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و چهار پرسش رایج در شرح‌حال بیماری فعلی:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«پیش از این مشکل، درد یا علامت دیگری داشتی؟ درمان دندانی یا ضربه‌ای در کار بود؟»"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«چه مدت این علائم را داشته‌ای؟»"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«آیا درد از نظر ماهیت، شدت یا محل تغییر کرد؟»"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«آیا برای این مشکل درمانی گرفته‌ای؟ اگر بله، چه درمانی؟»"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر یک از این چهار پرسش، یک اطلاعات مشخص می‌دهد —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و درس بعدی همین است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:b2cd73bb702d834ae04dfc51a36c498b15a78bcaed12dff42b7c8d0f42027fa4",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "ba6cae4b3aad273b6e30df9f04f829df5898502fe4c3a0ba41546231b4a1fa46",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چهار پرسش، چهار سرنخ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم اولیه ← منشأ عفونت."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر بیمار سابقه‌ی درد دندانی مزمن در ناحیه‌ی شکایت اصلی داشته، نکروز یا بیماری پریودنتال شدید همان دندان می‌تواند علت مشکوک باشد — و همین به تو اجازه می‌دهد در معاینه روی همان ناحیه تمرکز کنی."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-16-4.webp",
                  "alt": "سوراخ‌شدگی لینگوال بالای محل اتصال مایلوهایوئید",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/4644933d2e87db1ad4e548c4e19258bb471333631324b7f79fb4531203a0de3e.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوراخ‌شدگی لینگوال بالای محل اتصال مایلوهایوئید "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 16.4)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تغییر ماهیت و محل درد ← پیشرفت عفونت."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یک مثال دقیق: اگر درد از یک مولر مندیبل به درد فک و گردن تغییر کرده باشد، درمانگر باید سوءظن بالایی به گسترش به فضاهای عمیق‌تر داشته باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مدت علائم ← تهاجمی بودن عفونت —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و اینجا یک عدد کلیدی هست:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائمی که برای مدت طولانی (بیش از ۳۰ روز) ثابت و پایدار بوده‌اند، نشان‌دهنده‌ی یک عفونت مزمن‌اند که به‌وسیله‌ی سیستم دفاعی میزبان مهار شده است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "در سوی دیگر، علائم با شروع حاد و تشدید سریع، عموماً نشان‌دهنده‌ی عفونت تهاجمی‌تر، اختلال سیستم دفاعی میزبان، یا هر دو هستند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "و سابقه‌ی درمان پیشین ← سرنخ مهمی درباره‌ی تهاجمی بودن. اگر بیمار با عفونت مراجعه کند در حالی که علت عفونت برداشته شده و/یا عفونت تخلیه شده بوده، این می‌تواند نشان‌دهنده‌ی عفونتی تهاجمی باشد که نیازمند مدیریت تهاجمی‌تر است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:9b00d19aaaef297c5294e6ec0100b4c9dc4746ac13fef67975bbeb10a361e2ec",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "18e0fc489e706a82947980c3c850093a5548b7dfdbbadf74830df6e36df1f5db",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مرور سیستم‌ها، و آنچه پنهان می‌ماند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس از شرح‌حال دقیق، نوبت شرح‌حال پزشکی گذشته و شرح‌حال اجتماعی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک هشدار درباره‌ی فرم‌های پرسش‌نامه‌ای:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هنگام استفاده از فرم شرح‌حال سلامت، ضروری است که درمانگر نه‌تنها پاسخ‌های بیمار را مرور کند، بلکه آن پاسخ‌ها را با بیمار یا مراقبش "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیشتر بحث کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تا از دست رفتن موارد مهم یا سوءتفاهم پیش نیاید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و اگر بیمار راوی خوبی نیست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اغلب لازم است با پزشک مراقبت اولیه یا متخصص بیمار تماس گرفته شود تا شرح‌حال پزشکی کامل از راه مشاوره‌ی پزشکی به دست آید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گام بعدی، مرور کامل سیستم‌هاست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — و این مرحله‌ای است که در آن علائم بیشتری بیرون کشیده می‌شود: نه‌تنها علائم حفره‌ی دهان و سر و گردن، بلکه علائم کل بدن — مانند علائم عمومی، درد قفسه‌ی سینه، تنگی نفس، پُرادراری، پُرنوشی و پُرخوری."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و این مرحله دو دلیل حیاتی دارد:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شناسایی علائم مثبت و منفی مرتبط که می‌توانند عفونت‌های شدید را تأیید یا رد کنند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "یافتن مشکلات پزشکی بالقوه (بیماری‌های همراه) که می‌توانند بر ترمیم و برطرف شدن عفونت اثر بگذارند و در شرح‌حال پزشکی بیرون نیامده‌اند — مانند دیابت تشخیص‌داده‌نشده، عفونت HIV، یا سایر حالات نقص ایمنی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و توجه کن به آن سه علامتِ پُرادراری و پُرنوشی و پُرخوری در این فهرست —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این سه، تصویر کلاسیک دیابت تشخیص‌داده‌نشده‌اند. یعنی مرور سیستم‌ها، ابزار تو برای پیدا کردن همان چیزی است که بیمار خودش نمی‌داند دارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
