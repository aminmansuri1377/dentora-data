      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پرونده‌ی دوم: آبسه‌ی فضای باکال"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "همان قالب، ولی یافته‌های کاملاً متفاوت:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ناراحتی خفیف"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اختلال خفیف در سیستم دفاعی میزبان"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تورم خارج‌دهانی متوسط"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مرحله‌ی پیشرفته"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "سفتی (اندوراسیون) و حساسیت شدید گونه‌ی چپ ← "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تغییرات سلولیت"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "درگیری فضای اینفراتمپورال در تصویربرداری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مرحله‌ی پیشرفته، ناحیه‌ای دشوار"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مدیریت — کاملاً متفاوت:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارجاع فوری به جراح دهان و فک و صورت یا به بیمارستان محلی با پوشش جراحی فک و صورت."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مطالعات تصویربرداری بیشتر لازم است — سی‌تی با کنتراست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برش و تخلیه تحت بی‌هوشی عمومی، به علت درگیری فضای عمقی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "note"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "پایش بستری با معاینه‌ی بالینی و مطالعات آزمایشگاهی؛ چون ناتوانی در معاینه‌ی کافی فضای اینفراتمپورال، اتکای بیشتری به مطالعات کمکی مانند آزمایشگاه و تصویربرداری می‌طلبد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنتی‌بیوتیک وریدی در ابتدا لازم است تا تخلیه‌ی جراحی آبسه‌ی فضای فاشیال عمقی (فضای تمپورال عمقی) را تکمیل کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مهم‌ترین درس این مقایسه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تفاوت این دو پرونده در «چقدر تورم بزرگ است» نبود — در سفتی بافت، عمق فضای درگیر، و محدودیت دسترسی برای معاینه بود."
                }
              ]
            }
          ]
        }
      ],
