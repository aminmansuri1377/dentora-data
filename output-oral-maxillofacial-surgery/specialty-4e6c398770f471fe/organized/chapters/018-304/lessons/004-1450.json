      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پرونده‌ی اول: آبسه‌ی فضای وستیبولار"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یافته‌های کلیدی و معنای بالینی‌شان —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دقیقاً به همان شکلی که در شرح پرونده آمده:"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-17-6.webp",
                  "alt": "عفونت فضای وستیبولار بادی مندیبل که از راه داخل دهان تخلیه می‌شود",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/8187b0c18ea56a04f7193ce4556b3dad4c12b6f849b86bc9c25b2db796c0c757.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت فضای وستیبولار بادی مندیبل که از راه داخل دهان تخلیه می‌شود "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 17.6)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ظاهر خوب و بدون ناراحتی حاد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سیستم دفاعی میزبان سالم"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تورم خارج‌دهانی ناچیز تا خفیف"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مراحل اولیه"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تورم داخل‌دهانی خفیف"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مرحله‌ی اولیه"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مدیریت و منطقش:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برش و تخلیه همراه با حذف منشأ (دندان شماره‌ی ۳۰) در محیط مطب."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارزیابی مجدد بیمار در ۲ تا ۳ روز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "note"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "و منطق: محل سطحی با علائم خفیف، مراحل اولیه را نشان می‌دهد، بدون شواهدی از اختلال دفاع میزبان. دسترسی کافی، اجازه‌ی درمان جراحی فوری همراه با کنترل منشأ (خارج کردن پالپ با درمان ریشه‌ی بعدی، یا کشیدن دندان) و برش و تخلیه را می‌دهد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه چیز را از این پرونده بردار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ظاهر بیمار، عمق محل، و کفایت دسترسی. هر سه با هم، اجازه‌ی درمان در مطب را می‌دهند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:e29c83bf147bdab485b29a1e1d496e184d333e5fdc832edd56dfde514dac36bc",
