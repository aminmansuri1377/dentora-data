      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "عمودی و دیستوانگولار"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳) عمودی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " محور طولی دندان نهفته "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "موازی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " محور طولی مولر دوم است. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دومین شیوع بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را دارد: حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۸٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از کل نهفتگی‌های مولر سوم پایین. و از نظر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سهولت برداشتن سوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است — یعنی پس از مزیوانگولار و افقی."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-10-16.webp",
                  "alt": "نهفتگی مزیوانگولار — شایع‌ترین و ساده‌ترین نوع",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/2a595cffb73f63fe683ce83299b088c26312b6a635f78c74bdf156f2946e5796.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نهفتگی مزیوانگولار — شایع‌ترین و ساده‌ترین نوع "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 10.16)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و ویژگی مهمش:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نهفتگی عمودی اغلب در سطح خلفی‌اش با استخوان راموس قدامی مندیبل پوشیده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴) دیستوانگولار — دشوارترین زاویه."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " محور طولی مولر سوم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به سمت دیستال یا خلفی و دور از مولر دوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " زاویه دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا دشوارترین است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مسیر خروج این دندان به داخل راموس مندیبل می‌رود، پس برداشتنش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مداخله‌ی جراحی قابل‌توجهی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌طلبد. و سطح اکلوزال نهفتگی دیستوانگولار معمولاً درون راموس مندیبل مدفون است و برای کشیدن به برداشت قابل‌توجه استخوان نیاز دارد. شیوعش کم است: تنها حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از کل مولرهای سوم نهفته."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک نکته که فقط درباره‌ی نهفته نیست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مولر سوم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رویش‌یافته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم می‌تواند در وضعیت دیستوانگولار باشد. وقتی این‌طور شد، برداشتنش به‌مراتب دشوارتر از سایر دندان‌های رویش‌یافته است — دلیلش این است که ریشه‌ی مزیال مولر سوم بسیار نزدیک ریشه‌ی مولر دوم است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:34b24bad51f5432d5d57870e3b17b230a329509edb0a0cb70d4af0bd582c9001",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "28fa65e83633306fb563e10400ee481a091cdb7d2d9737af3c72f7d69652bc74",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بعد باکولینگوال، و نهفتگی ترنسورس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "افزون بر رابطه‌ی زاویه‌ی محورهای مولر دوم و سوم، دندان‌ها می‌توانند در جهت باکال، لینگوال یا پالاتال هم زاویه داشته باشند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-10-19.webp",
                  "alt": "نهفتگی دیستوانگولار — نادر و دشوارترین نوع",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/99a8d36e998ab26f948576f67a554c318d69c9cea8c91dac6737a66a71b2cf3e.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نهفتگی دیستوانگولار — نادر و دشوارترین نوع "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 10.19)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک هشدار آناتومیک در همین‌جا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هنگام رویکرد به مولرهای سوم پایین، باید احتمال حضور عصب لینگوالِ بالانشسته (high-riding) در نظر گرفته شود. همین احتمال است که رویکرد باکال را مناسب نگه می‌دارد، حتی وقتی دندان به سمت لینگوال متمایل است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نهفتگی ترنسورس — نادر."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی دندانی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در وضعیت کاملاً افقی در جهت باکولینگوال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رویش یافته است. سطح اکلوزال دندان می‌تواند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رو به باکال یا رو به لینگوال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چگونه تعیین می‌شود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای تعیین دقیق ورژن باکال یا لینگوال، باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رادیوگرافی اکلوزال عمود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گرفته شود یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "CBCT"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تهیه گردد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی معمولاً لازم نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — چون جراح می‌تواند این تشخیص را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در همان اوایل عمل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بدهد، و موقعیت باکال یا لینگوال دندان تأثیر زیادی بر رویکرد جراحی ندارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
