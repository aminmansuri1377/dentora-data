  "steps": [
    {
      "id": "theory:6f8591d9134c7b91324dbe93e32e9b3d4279c87e2efbc0503bfa9a42b6bc6e7a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6b028ca12c451a9179c2091d4fa7f3e9f2a599b4b3a5c7b94ab6578085416fa7",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "شریان یا ورید، و نقش تراکم بافت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هماتوم یعنی نشت خون به فضاهای خارج‌عروقی، در اثر خراشیدن ناخواسته‌ی یک رگ —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شریان یا ورید — حین تزریق بی‌حسی."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-6-7.webp",
                  "alt": "تزریق برای بی‌حسی مولرهای بالا (بلاک PSA)؛ نفوذ بیش از حد سوزن خطر هماتوم را بالا می‌برد",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/4bf69f004f28a992ea6de55d07a1630de2d83672ee312d466b3ca7a32b73bf65.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تزریق برای بی‌حسی مولرهای بالا (بلاک PSA)؛ نفوذ بیش از حد سوزن خطر هماتوم را بالا می‌برد "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 6.7)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و این دو یکی نیستند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هماتومی که پس از خراشیدن یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شریان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شکل می‌گیرد، معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تا زمان مداخله به‌سرعت بزرگ می‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — چون فشار خون داخل شریان به‌طور قابل‌توجهی بیشتر است. خراشیدن یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ورید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ممکن است به هماتوم منجر شود یا نشود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عامل تعیین‌کننده‌ی دیگر:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تراکم بافت اطراف رگ آسیب‌دیده."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هرچه بافت اطراف متراکم‌تر باشد —"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مثل کام — احتمال شکل‌گیری هماتوم کمتر است. بافت سفت، اجازه‌ی تجمع خون نمی‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ولی در بافت شل —"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مثل حفره‌ی اینفراتمپورال — حجم‌های زیادی از خون می‌تواند جمع شود پیش از آنکه اصلاً تورمی دیده شود و درمانی شروع شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هماتوم پس از بلاک PSA دقیقاً همین‌طور است: تورم دیر دیده می‌شود، چون خون در فضایی شل و بزرگ جمع شده است. در کام، برعکس، بافت متراکم و محکم به استخوان چسبیده است و هماتوم به‌ندرت پیش می‌آید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اقدام فوری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به محض دیدن تورم، روی محل خون‌ریزی فشار مستقیم بده و یخ بگذار؛ گرما را تا روز بعد به کار نبر، چون رگ را گشاد می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:428b6fb86d930d0e51e6df500209dab5372fccd7aeb867deee60b87fe7fda564",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "93e719b4532f34a25d9183fa2fd5c3dc89ea105725bc794eaf0d0908ff68b9cc",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "شش قاعده‌ی پیشگیری"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این قواعد برای پیشگیری از تریسموس تدوین شده‌اند، ولی جلوی هماتوم و بیشتر عوارض موضعی دیگر را هم می‌گیرند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن تیز، استریل و یک‌بارمصرف به کار ببر، و سوزن آسیب‌دیده، کند یا آلوده را بی‌درنگ تعویض کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کارتریج‌ها را درست نگهداری کن و تکنیک آسپتیک را رعایت کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تکنیک ورود و تزریق اتروماتیک را تمرین کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "از تزریق‌های مکرر و ورودهای متعدد سوزن در یک ناحیه پرهیز کن — و راهش این است که آناتومی و تکنیک درست را بدانی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "note"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "هرجا ممکن و منطقی است، به‌جای انفیلتراسیون موضعی از بلاک عصبی ناحیه‌ای استفاده کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حداقل حجم مؤثر بی‌حسی را به کار ببر، و برای هر تکنیک به پروتکل اختصاصی همان تکنیک رجوع کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک جمله‌ی صادقانه که باید جدی بگیری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نه تریسموس همیشه قابل پیشگیری است، نه هماتوم. یعنی رعایت همه‌ی این قواعد، احتمال را کم می‌کند نه صفر — و این را به بیمار هم باید گفت."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
