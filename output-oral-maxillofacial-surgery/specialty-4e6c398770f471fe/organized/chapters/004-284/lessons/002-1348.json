  "steps": [
    {
      "id": "theory:c266dd17fa2656b76e997a8d4adb1bb4f9215a6ec8ea4cb681f52bd9116abd36",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f05cf51af32e76348d96742e7280c691965a9701330f8c06653ace28641a56dd",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه ویژگی درد، و بیماری که می‌گوید درد زیادی خواهم داشت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه ویژگی درد پس از کشیدن معمولی —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هر تصمیم دارویی از همین سه بیرون می‌آید:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " درد معمولاً "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شدید نیست"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و در بیشتر بیماران با مسکن‌های بدون نسخه کنترل می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲) اوج درد حدود ۱۲ ساعت پس از کشیدن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است و پس از آن به‌سرعت فروکش می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " درد قابل‌توجه ناشی از کشیدن "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "به‌ندرت بیش از ۲ روز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ادامه می‌یابد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انتظار بیمار، خودش بخشی از درد است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شدت درد "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بسیار متغیر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و تا حد زیادی به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انتظارات پیش از عملِ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیمار بستگی دارد. جراحی که پیش از عمل وقت بگذارد و این موضوع را با بیمار در میان بگذارد، می‌تواند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مناسب‌ترین رژیم مسکن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را طراحی کند: به بیمار کمک کن انتظار واقع‌بینانه از نوع درد داشته باشد و تصورات نادرستش درباره‌ی شدت آن را اصلاح کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیماری که تأکید می‌کند «من درد زیادی خواهم کشید» را نادیده نگیر و به‌طور خودکار به مسکن بدون نسخه حواله‌اش نده — همین بیماران محتمل‌ترین کسانی‌اند که پس از عمل درد را تجربه می‌کنند. به‌جایش به آن‌ها اطمینان بده که ناراحتی پس از عملشان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قابل مدیریت است و مدیریت خواهد شد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک تنظیم انتظار مهم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به بیمار بگو هدف داروی مسکن مدیریت درد است، نه از بین بردن کامل هر ناراحتی."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:b3d48abb1f6336615cd0bc7f429b470cb5e07517dd9238d6e100400702a9ae94",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "32c9f14f6264b60e4fcdca4849486de2651e7c1747e6094fdf19ab903a0da748",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "زمان‌بندی دوز اول، و قدرت مسکن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی طلایی زمان‌بندی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اولین دوز مسکن باید پیش از پریدن اثر بی‌حسی موضعی خورده شود. اگر این کار انجام شود، احتمال تجربه‌ی درد شدید و تیز پس از پریدن بی‌حسی کمتر است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا تأخیر گران تمام می‌شود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مدیریت درد پس از عمل وقتی دارو تا شدید شدن درد به تعویق بیفتد "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خیلی سخت‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶۰ تا ۹۰ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طول می‌کشد تا مسکن کاملاً اثر کند. اگر بیمار صبر کند تا بی‌حسی بپرد و بعد دارو بخورد، بی‌طاقت می‌شود، منتظر اثر می‌ماند و دوز اضافه می‌خورد — و همین احتمال "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تهوع و استفراغ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را بالا می‌برد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حتی وقتی فکر می‌کنی مسکن نسخه‌ای لازم نیست، باز هم به بیمار بگو "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایبوپروفن یا استامینوفن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بخورد تا از ناراحتی اولیه پیش از پریدن بی‌حسی جلوگیری شود. بیمارانی که انتظار درد بیشتری می‌رود، مسکن نسخه‌ای بگیرند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قدرت مسکن."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در بیشتر موقعیت‌های معمول پس از کشیدن، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسکن قوی لازم نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ مسکن با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قدرت کمتر در هر واحد دوز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " معمولاً کافی است. آن‌وقت به بیمار می‌گویی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک یا دو واحد دوز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بر حسب نیاز بخورد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و منطقش:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کنترل دقیق‌تر درد وقتی حاصل می‌شود که خود بیمار در تعیین مقدار دارو نقش فعال داشته باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مؤثرترین روش کنترل درد اما دارو نیست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مؤثرترین روش، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برقراری رابطه‌ی نزدیک میان جراح و بیمار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. باید وقت مشخصی صرف گفت‌وگو درباره‌ی ناراحتی پس از عمل شود و جراح به‌روشنی نگرانی‌اش برای راحتی بیمار را نشان دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نسخه با دستور روشن درباره‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زمان شروع دارو و فاصله‌ی دوزها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " داده شود. اگر این کارها انجام شود، معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسکن ملایم برای مدت کوتاه —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " معمولاً نه بیش از ۲ تا ۳ روز — تمام آن چیزی است که لازم می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
