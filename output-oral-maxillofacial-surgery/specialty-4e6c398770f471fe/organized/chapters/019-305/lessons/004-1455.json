  "steps": [
    {
      "id": "theory:51dbadbe67308cace4acd1b9bc6d660c29109e5065fcb424f0fc34f0c7485b52",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "1f9a01256e7aa2723a1484eb9cdb989252a78fba962770ef0e9f3190b22ea41b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اصل ششم: آیا آنتی‌بیوتیک لازم است؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اصل ششم مدیریت عفونت اودنتوژنیک:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آنتی‌بیوتیک مناسب را انتخاب و تجویز کن — و نخستین پرسشش این است که اصلاً لازم است یا نه."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هرگاه درمان آنتی‌بیوتیکی در نظر گرفته می‌شود، درمانگر باید خطرها و فایده‌ها را با دقت بسنجد."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-16-10.webp",
                  "alt": "برش در پایین‌ترین نقطه‌ی ممکن، از تخلیه‌ی ناقص جلوگیری می‌کند",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/09485e4a2053d4393f2faec9dbad1e070dfff51e02e0c3d14083e163d004fbcc.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برش در پایین‌ترین نقطه‌ی ممکن، از تخلیه‌ی ناقص جلوگیری می‌کند "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 16.10)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و سه عامل اصلی که باید در تعیین مناسب بودن آنتی‌بیوتیک کمکی در نظر گرفته شوند:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شدت عفونت"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "توانایی انجام درمان جراحی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سیستم دفاعی میزبان بیمار"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو تا از این سه را در یونیت پیشین شناختی —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شدت (اصل یک) و میزبان (اصل دو)؛ سومی، توانایی انجام جراحی، تازه است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عفونت‌های شدید، به‌ویژه آن‌ها که فضاهای فاشیال عمیق‌تر را درگیر می‌کنند یا با سلولیت همراه‌اند، پس از کنترل منشأ و تخلیه‌ی کامل از آنتی‌بیوتیک سود می‌برند؛ فضای عمقی را بدون CT نمی‌توان کامل وارسی کرد و خطر تخلیه‌ی ناقص در آن بیشتر است. موارد مناسب دیگر: تورم فراتر از زائده‌ی آلوئولار، تریسموس، لنفادنوپاتی، تب بالاتر از ۳۸٫۳ درجه، پریکورونیت شدید، استئومیلیت، و بیمار با نقص ایمنی (همراه با درمان جراحی مناسب)."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اگر عفونت حاد اجازه‌ی کنترل منشأ و تخلیه را ندهد — مثلاً پریکورونیت شدید با محدودیت باز شدن دهان از درد — آنتی‌بیوتیک تجربی گاهی پیش از جراحی می‌آید تا دهان باز شود و جراحی ممکن شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و دو مثال مهم از موقعیت‌هایی که آنتی‌بیوتیک در آن‌ها لازم نیست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پریکورونیت خفیف، و آبسه‌ی تخلیه‌شده‌ای که به زائده‌ی آلوئولار محدود است. درخواست بیمار، درد شدیدی که از عفونت نیست، دندان‌درد، پریودنتیت یا آبسه‌ی پری‌اپیکال، دراسکت، و تجویز پس از کشیدن چند دندان در بیمار با ایمنی سالم هم دلیل تجویز نیستند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ببین منطق چقدر ساده است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر منشأ حذف شده، عفونت تخلیه شده، محل سطحی است و میزبان سالم است — کاری برای آنتی‌بیوتیک باقی نمی‌ماند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:b4b521d65f02da0cb624983658b0dd87d4218b58b003a27017e12fb3e84c1915",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "0a4c950dad67bdb978990062e1d441c707e423b0d55c5d207e2bfc52fe1edd69",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هزینه‌ی تجویز بی‌مورد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اتکای بیش از حد به آنتی‌بیوتیک، فهرستی از خطرها دارد:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خطر افزایش مقاومت آنتی‌بیوتیکی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خطر افزایش عوارض جانبی آنتی‌بیوتیک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — شامل "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عفونت‌های فرصت‌طلب"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و خطرهای جدی‌تری مانند "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آنافیلاکسی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "و مهم‌ترین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ممکن است به مدیریت جراحی ناکافی بینجامد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و همان جمله‌ی کلیدی، دوباره:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باید به‌روشنی فهمید که آنتی‌بیوتیک‌ها همیشه باید به‌عنوان "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مکمل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مدیریت جراحی در نظر گرفته شوند، نه "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جایگزین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک یافته‌ی پژوهشی که شاید غافلگیرت کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مرورهای نظام‌مند نشان می‌دهند که انتخاب آنتی‌بیوتیک، هنگامی که همراه با درمان جراحی (کنترل منشأ و برش و تخلیه) به کار رود، به‌طور معناداری بر نتایج درمان اثر نمی‌گذارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یعنی وقتی جراحی درست انجام شده باشد، اینکه کدام آنتی‌بیوتیک را انتخاب کرده‌ای، تفاوت معناداری نمی‌سازد. و این دقیقاً نشان می‌دهد که کدام بخش درمان واقعاً کار می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و پیامد عملی این یافته:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انرژی‌ات را صرف انتخاب «بهترین» آنتی‌بیوتیک نکن؛ صرف اطمینان از کامل بودن جراحی کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
