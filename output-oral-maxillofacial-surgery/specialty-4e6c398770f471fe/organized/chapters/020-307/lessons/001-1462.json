  "steps": [
    {
      "id": "theory:a8001846cb02e9d08cc7d5987968dddff454f66445800adeb7c80a16dc80f0c8",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "949293aaedd4b42757a9ee2fbb8b0b5443b9ed333f459f340171662b9555bb0b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اعدادی که باید بشناسی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عفونت حتی بدون بیماری زمینه‌ای هم رخ می‌دهد: در محل جراحی، یا در اندام‌های دوردست از راه خون. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این یونیت به دو سناریوی پیشگیری می‌پردازد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیشگیری از عفونت زخم پس از جراحی، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیشگیری از عفونت متاستاتیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-16-9.webp",
                  "alt": "موقعیت دسته‌ی عصبی-عروقی منتال را پیش از برش وستیبولار در نظر بگیر",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/7e8e4f466ae412d30897f624ded60aca38fc62493c2b6827e99b7b5192c28e40.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "موقعیت دسته‌ی عصبی-عروقی منتال را پیش از برش وستیبولار در نظر بگیر "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 16.9)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و اول یک هشدار مقدماتی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگرچه آنتی‌بیوتیک‌ها مکمل‌های مؤثری برای عفونت‌های "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مستقر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هستند، استفاده از آن‌ها در پیشگیری از عفونت‌ها (یعنی تجویز پروفیلاکتیک) بحث‌برانگیز و کمتر مبتنی بر شواهد است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و حالا اعداد:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت پس از عمل در حدود ۶ تا ۹ درصد جراحی‌های تمیز-آلوده (مانند حفره‌ی دهان) رخ می‌دهد، و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تا ۴۰ درصد در اعمال با زخم‌های کثیف"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنتی‌بیوتیک پری‌اپراتیو می‌تواند نرخ عفونت را به حدود ۳٫۳ درصد کاهش دهد — و به‌طور اختصاصی برای جراحی دهان و فک و صورت، تا ۷۰ درصد کاهش."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی بی‌درنگ یک هشدار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درمانگر باید داده‌ها را با احتیاط تفسیر کند. و سه دلیل برای این احتیاط وجود دارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:56a6cd28a84be6035ce0547d822c1f9940c6ab0ff01423c18411aa91c7cc1bf3",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ec092a5d1abe5b32b80b4815392ef07ed38ddef7801d0c8316bd52b551ce87f3",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه دلیل احتیاط"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نخست:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بروز عفونت پس از اعمال جراحی دهان بسیار پایین است — در واقع این نرخ‌ها با فراوانی واکنش‌های آلرژیک ناشی از مصرف آنتی‌بیوتیک قابل مقایسه‌اند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دوم: عفونت‌های محل جراحی پس از جراحی روتین دهان جزئی‌اند و به‌راحتی به آنتی‌بیوتیک یا اعمال جزئی مانند برش و تخلیه‌ی داخل‌دهانی در محیط مطب پاسخ می‌دهند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوم: مرورهای نظام‌مند کارآزمایی‌های بالینی درباره‌ی اعمال جراحی دهان، نتوانسته‌اند هیچ عفونت فضای عمقی سر و گردن پس از عمل را شناسایی کنند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و نتیجه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فایده‌ی تجویز روتین آنتی‌بیوتیک پیش از هر عمل جراحی دهان — یعنی کاهش بروزِ از پیش پایینِ عفونت‌های خفیف محل جراحی — "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نمی‌تواند سه هزینه را توجیه کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " افزایش خطر واکنش‌های نامطلوب به آنتی‌بیوتیک، افزایش خطر ترویج باکتری‌های مقاوم، و بار مالی بر بیمار و نظام سلامت."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس آنتی‌بیوتیک پیش از عمل تنها برای شرایط منتخب توصیه می‌شود —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و این شرایط دو مورد است: اعمال جراحی طولانی، و بیماران با دفاع میزبان مختل."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
