  "steps": [
    {
      "id": "theory:737977783595378b8a00e6e34e52d26112a2bab986a4d02be63f2ef3d1434b59",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "658056e130d22f5f4cf3fdcd4f76e5ac1fe8855f1ac594521fa563069824d877",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کدام دارو، چه دوزی، چه زمانی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس از آنکه بیمار کاندید مناسب آنتی‌بیوتیک پیش از عمل تشخیص داده شد، باید داروی مناسب انتخاب شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و سه ویژگی آنتی‌بیوتیک ایده‌آل:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در برابر فلور طبیعی دهان مؤثر باشد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "طیف باریکی داشته باشد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمترین عوارض نامطلوب را داشته باشد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". بنابراین معیارهای انتخاب، همان معیارهای عفونت‌های مستقر است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و حالا نکته‌ای که پروفیلاکسی را از درمان جدا می‌کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارو باید طوری تجویز شود که غلظت پلاسمایی‌اش در لحظه‌ی آسیب جراحی در اوج خود باشد — و این اوج باید بالاتر از زمانی باشد که آنتی‌بیوتیک برای مقاصد درمانی داده می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و این عملاً به دو عدد ترجمه می‌شود:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حدوداً دو برابر دوز درمانی معمول"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "و برای آنتی‌بیوتیک‌های خوراکی، دست‌کم ۲ ساعت —"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و ایده‌آل ۱ ساعت — پیش از جراحی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "رژیم‌های استاندارد ۳۰ تا ۶۰ دقیقه پیش از عمل داده می‌شوند: آموکسی‌سیلین خوراکی، بزرگسال ۲ گرم و کودک ۵۰ mg/kg، آمپی‌سیلین عضلانی یا وریدی، بزرگسال ۲ گرم و کودک ۵۰ mg/kg، سفازولین یا سفتریاکسون عضلانی یا وریدی، بزرگسال ۱ گرم و کودک ۵۰ mg/kg."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و دو قید مهم این رژیم‌ها:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دوز کل کودک نباید از دوز بزرگسال بیشتر شود، و سفالوسپورین‌ها نباید در بیماران با واکنش ازدیاد حساسیت نوع فوری به پنی‌سیلین‌ها به کار روند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5cfb1d08d786f9b9134b8d382c2c3e4d14c88ef6211019e516b4b658d18f1caf",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "753073372e0f9a778b257d3a655139d62ba7ac56fab366f87d92498061b91fad",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آنچه هیچ دارویی جبرانش نمی‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مهم‌ترین قاعده‌ی این درس:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با وجود در دسترس بودن آنتی‌بیوتیک به‌عنوان کمکی در پیشگیری از عفونت، درمانگر باید همیشه به پروتکل‌های جراحی سختگیرانه پایبند باشد — شامل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستکاری محتاطانه‌ی بافت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آسپسیس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرهیز از آلودگی متقاطع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و نتیجه‌اش:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آنتی‌بیوتیک‌ها هرگز نباید برای جبران تکنیک جراحی ضعیف یا نبود پروتکل آسپسیس مناسب به کار روند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این همان الگویی است که در تمام این ماژول دیدی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارو، جبران‌کننده‌ی کار بد نیست. در یونیت پیشین، آنتی‌بیوتیک نمی‌توانست جای تخلیه را بگیرد؛ اینجا نمی‌تواند جای تکنیک تمیز را بگیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک یافته‌ی جالب که شاید عادت‌های مطبت را تغییر دهد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشان داده شده که دستکش استریل، در مقایسه با دستکش غیراستریل، در اعمال جراحی سرپایی دهان هیچ فایده‌ای ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی دقت کن این جمله چه چیزی "
                    },
                    {
                      "tag": "em",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نمی‌گوید"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ":"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نمی‌گوید آسپسیس مهم نیست. می‌گوید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این یک جزء خاص"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این زمینه‌ی خاص"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، تفاوتی نساخته است. پروتکل آسپسیس همچنان الزامی است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
