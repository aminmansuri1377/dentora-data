  "steps": [
    {
      "id": "theory:2cfab97286a7f7c406af89bf72de8ae3d529b071246ac30a51e916a0f0a16c2b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f8a4ba9ff0fe9eeda45caea5656c90669423e122673f0b88a4500b8f2dddca25",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا راه هوایی اول می‌آید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "در مدیریت عفونت‌های فضاهای فاشیال، "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مدیریت راه هوایی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مدیریت جراحی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌آید — و این ترتیب تصادفی نیست."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-17-22.webp",
                  "alt": "بیمار با بیماری مزمن دندانی که با فاشئیت نکروزان مراجعه کرده",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/e94b4a6c60b716f1105ee57f515c678d316435656878840d0d1017ddb872e0b7.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار با بیماری مزمن دندانی که با فاشئیت نکروزان مراجعه کرده "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 17.22)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دلیلش ساده است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیمار با عفونت فضاهای عمقی، ادم پیشرونده دارد. اگر راه هوایی پیش از تخلیه از دست برود، هیچ تخلیه‌ای دیگر معنایی ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و نشانه‌هایی که از درس اول این یونیت می‌آیند، اینجا به تصمیم تبدیل می‌شوند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیسفونی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیسفاژی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناتوانی در مدیریت ترشحات"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کار تنفسی افزایش‌یافته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استریدور"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". هر یک از این‌ها یعنی راه هوایی در معرض تهدید است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مهم‌ترین تصمیم بالینی این یونیت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیماری که هر یک از این نشانه‌ها را دارد، جای درمان در مطب نیست. این بیمار نیازمند ارجاع فوری به مرکزی است که بتواند راه هوایی را مدیریت کند — لوله‌گذاری، یا در صورت لزوم راه هوایی جراحی مثل تراکئوستومی — و تخلیه‌ی خارج‌دهانی انجام دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و در فاصله‌ی تصمیم تا انتقال:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیمار را در وضعیتی که خودش راحت‌تر نفس می‌کشد نگه دار — معمولاً نشسته و رو به جلو — و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "او را دراز نکش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". اکسیژن بده، و پایش کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:2d3653cd33f1d447b592048ba4d0d2d33959d31249ce48507cb609b022e5558c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "62f0812c47fb41559cb8f89800ffdf708ec82514df8300c4e663dc2041ca5cde",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تخلیه: داخل‌دهانی یا خارج‌دهانی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای هر فضای فاشیال، رویکرد برش و تخلیه مشخص است — و فضاها از این نظر دو گروه بزرگ‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "فضاهایی که دسترسی داخل‌دهانی یا خارج‌دهانی دارند — مثل بادی مندیبل، ماستریک، پتریگومندیبولار، تمپورال سطحی و عمقی، و پری‌تونسیلار. یعنی بسته به وسعت و دسترسی، انتخاب داری."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "و فضاهایی که تنها دسترسی خارج‌دهانی دارند — از فضاهای این یونیت: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای اربیتال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لترال فارنژیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رتروفارنژیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پره‌تراکئال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای خطر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مدیاستن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". ساب‌مندیبولار و ساب‌منتال هم در همین گروه‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و این تقسیم‌بندی، خودش یک ابزار تصمیم‌گیری است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هر فضایی که در فهرست «تنها خارج‌دهانی» است، تقریباً همیشه از حیطه‌ی مطب عمومی خارج است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و اصلی که در درس دوم دیدی، اینجا عملی می‌شود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شناخت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساختارهای حیاتی درون هر فضا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای تخلیه‌ی ایمن ضروری است — چون در فضای پتریگومندیبولار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شاخه‌ی سوم تری‌ژمینال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، در فضای لترال فارنژیال "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شریان کاروتید و ورید ژوگولار داخلی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و در فضای اربیتال "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کره‌ی چشم و اعصاب مغزی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "برشی که بدون دانستن این محتویات زده شود، می‌تواند از خود عفونت آسیب بیشتری بزند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
