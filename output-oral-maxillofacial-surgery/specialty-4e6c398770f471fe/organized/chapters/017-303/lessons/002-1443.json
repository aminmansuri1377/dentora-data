  "steps": [
    {
      "id": "theory:3ebe2acefc809cfa8cfac4bfb42d7981a1e8dd1fb5dd09a1be49ea351de351cb",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "2b7b781c0ce256178ec0c231a55b96f17079631cac66fba860055960e13f0a7e",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فضاهای بالقوه، و چرا آناتومی اینجا حیاتی است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک تعریف که همه‌چیز را روشن می‌کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این فضاها «بالقوه»‌اند — یعنی تنها زمانی وجود دارند که باکتری یا ماده‌ی دیگری به آن‌ها هجوم آورده باشد. در حالت سلامت، این‌ها صرفاً لایه‌های به‌هم‌چسبیده‌ی فاشیا هستند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-17-8.webp",
                  "alt": "فضای باکال؛ بین عضله‌ی بوکسیناتور و پوست",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/dbe6e94a94b132f3bfe2c671739dd2c0851be90cd2ff048880d200230b0addf7.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای باکال؛ بین عضله‌ی بوکسیناتور و پوست "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 17.8)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لایه‌های فاشیای سرویکال سر و گردن، مرزهای عفونت‌های فضاهای عمقی گردن را تعیین می‌کنند — و فاشیای سرویکال عمقی خود به لایه‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سطحی، میانی و عمقی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تقسیم می‌شود. لایه‌ی عمقی خودش دو برگ دارد — آلار در جلو و پره‌ورتبرال در عقب — و «فضای خطر» همان فاصله‌ی میان این دو است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و سه دلیل روشن وجود دارد که چرا این آناتومی برای تو حیاتی است:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دانش کامل آناتومی این فضاها، درمانگر را در ارزیابی یافته‌های بالینی و رادیوگرافیک برای تشخیص کمک می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شناخت فضاها و ساختارهای حیاتی درونشان، به فراهم کردن دسترسی و تخلیه‌ی جراحی کافی کمک می‌کند، در حالی که از آسیب یاتروژنیک و موربیدیتی بیشتر بیمار پرهیز می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و شناخت اتصالات عضلانی و بافت نرم فیبروز به مجموعه‌ی ماگزیلومندیبولار، برای فهم مسیر گسترش عفونت حیاتی است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یعنی آناتومی اینجا سه کار می‌کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تشخیص، دسترسی ایمن، و پیش‌بینی مسیر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:874ca4c0b0dcb6976effb21aab9f8838e71464f9a993abb137d94f7c0e942c80",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "37a8112f797922c9401278148fcb9b9f6096e87875a06bc4da9ef5af4339f254",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کدام دندان، کدام فضا"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقشه‌ی فضاهای فاشیال را می‌توان در چند قاعده‌ی کاربردی خلاصه کرد:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-17-10.webp",
                  "alt": "فضای ساب‌لینگوال؛ بین مخاط دهان و عضله‌ی مایلوهایوئید",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/ecb498e7e728b8c2959f2fdf0eb8187e87fba8b2a4d8dec117d36a8106c605ad.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای ساب‌لینگوال؛ بین مخاط دهان و عضله‌ی مایلوهایوئید "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 17.10)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو فضای ثانویه‌ی ماگزیلا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضای کانین (اینفرااوربیتال) — بیشتر از ریشه‌ی بلند کانین بالا و گاه پرمولر بالا، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای اربیتال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از سینوزیت ماگزیلاری و دندان‌های بالا، که محتویاتش کره‌ی چشم، عضلات خارج‌چشمی و اعصاب مغزی دو، سه، چهار، پنج و شش است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای اولیه‌ی مندیبل: بادی مندیبل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از دندان‌های خلفی پایین، که محتویاتش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عصب و شریان و ورید آلوئولار تحتانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، و فضاهای مجاورش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماستیکاتور، ساب‌لینگوال و ساب‌مندیبولار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و فضای ماستیکاتور —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چهار زیرفضایی که تریسموس می‌سازند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فضای ماستریک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — منشأ: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولرهای سوم مندیبل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، محتوا: عروق ماستریک، فضای مجاور: باکال، دسترسی جراحی: خارج‌دهانی یا داخل‌دهانی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فضای پتریگومندیبولار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — منشأ: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولرهای سوم مندیبل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، محتوا: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شاخه‌ی سوم عصب تری‌ژمینال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، فضای مجاور: باکال. درگیری تنهایش تورم خارجی کمی می‌دهد ولی تریسموس شدید، چون عضله‌ی پتریگوئید داخلی ملتهب می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فضای تمپورال سطحی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — منشأ: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولرهای ماگزیلا و مندیبل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، محتوا: بالشتک چربی تمپورال و شاخه‌ی فرونتال عصب فاسیال."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فضای تمپورال عمقی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — منشأ: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولرهای ماگزیلا"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، محتوا: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شبکه‌ی پتریگوئید"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک الگو را ببین:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مولر سوم مندیبل، منشأ چند زیرفضای ماستیکاتور است. و همین توضیح می‌دهد چرا پریکورونیت مولر سوم می‌تواند به تریسموس شدید بینجامد."
                }
              ]
            }
          ]
        }
      ],
