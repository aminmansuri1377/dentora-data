      "contentKey": "b67876c8c5f0d90aaee3117a98e1d260db9191c239436a80deadae0a3b21b7df",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فضای لترال فارنژیال و رتروفارنژیال"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای لترال فارنژیال —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بسیار خطرناک، هم به‌خاطر محتویاتش و هم به‌خاطر گسترش سریع به پایین: منشأ عفونت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مولرهای سوم پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و تونسیلیت است، محتویاتش شریان کاروتید، ورید ژوگولار داخلی و عصب واگ است (با خطر ترومبوز ورید ژوگولار داخلی و خوردگی دیواره‌ی کاروتید)، فضاهای مجاورش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پتریگومندیبولار و رتروفارنژیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و دسترسی جراحی‌اش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خارج‌دهانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-17-13.webp",
                  "alt": "محتویات فضای پارافارنژیال در برش اگزیال",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/c0be1d1dd7cdb8fbc629d3c04507450271d3ecd014a561a64a33316c58746426.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محتویات فضای پارافارنژیال در برش اگزیال "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 17.13)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای پری‌تونسیلار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — مرزهایش مخاط اوروفارنکس و عضله‌ی فارنژیال فوقانی، منشأش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تونسیلیت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، محتوایش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تونسیل پالاتین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، فضای مجاورش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لترال فارنژیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و دسترسی داخل‌دهانی یا خارج‌دهانی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای رتروفارنژیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — نکته‌ی کلیدی‌اش این است که هیچ مسیر مستقیمی از دندان به آن وجود ندارد؛ محتوایش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بافت همبند آرئولار شل و گره‌های لنفاوی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و از راه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای لترال فارنژیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درگیر می‌شود. دسترسی جراحی: خارج‌دهانی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای پره‌تراکئال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گسترش از فضای رتروفارنژیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درگیر می‌شود، محتوایش عضلات "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استرنوهایوئید و استرنوتیروئید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و فضاهای مجاورش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رتروفارنژیال و مدیاستن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و همین‌جا زنجیره را ببین:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان ← لترال فارنژیال ← رتروفارنژیال ← پره‌تراکئال ← مدیاستن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:ad7032a1c685dbae181e1456ad3a8cdbe4f06743ee9e75b54055b3598020d811",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "a219a07b516e1cbf9e1388045c97fb34336732d70be20c2fe6a6224a49ead799",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "«فضای خطر» و ترومبوز سینوس کاورنو"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "«فضای خطر» (danger space) نامش را بی‌جهت نگرفته. تعریفش این است: یک فضای بالقوه میان فاشیای آلار و پره‌ورتبرال که از قاعده‌ی جمجمه تا دیافراگم امتداد دارد، منشأ درگیری‌اش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فارنژیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، محتوایش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بافت همبند آرئولار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و فضای مجاورش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مدیاستن خلفی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". دسترسی: خارج‌دهانی."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-17-16.webp",
                  "alt": "عفونت فضای لترال فارنژیال می‌تواند به فضای رتروفارنژیال پیش برود",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/d4887f78634a7565268718507bf0d226ccde4803c6c02d411b6a37f90ddbb524.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت فضای لترال فارنژیال می‌تواند به فضای رتروفارنژیال پیش برود "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 17.16)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مدیاستن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مرزش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دنده‌ی اول"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای خطر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درگیر می‌شود، و محتویاتش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عروق بزرگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. یعنی یک عفونت دندانی می‌تواند از راهی کاملاً آناتومیک به قفسه‌ی سینه برسد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و مسیر دوم، به سمت بالا —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترومبوز سینوس کاورنو: شبکه‌ی وریدی می‌تواند مستقیماً به سینوس کاورنو برود، چون این وریدها بدون دریچه‌اند — و ترومبوز سینوس کاورنو حتی با بهترین درمان داخلی و جراحی هم می‌تواند کشنده باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس دو مسیر مرگ‌آور از یک عفونت دندانی وجود دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یکی رو به پایین به مدیاستن، و یکی رو به بالا به سینوس کاورنو. و همین دو مسیر است که تفاوت میان «یک آبسه‌ی ساده» و «یک اورژانس واقعی» را می‌سازد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و سایر عفونت‌های اختصاصی که باید بشناسی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فاشئیت نکروزان، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استئومیلیت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (چرکی حاد، چرکی مزمن، اسکلروزان مزمن، و استئومیلیت با پریوستیت پرولیفراتیو یا استئومیلیت گاره، که بیشتر در کودکان دیده می‌شود و زیر پریوست استخوان تازه‌ی لایه‌لایه می‌سازد)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکتینومایکوز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (باکتریایی، هرچند نامش قارچ را به ذهن می‌آورد)، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاندیدیازیس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (قارچی)."
                }
              ]
            }
          ]
        }
      ],
