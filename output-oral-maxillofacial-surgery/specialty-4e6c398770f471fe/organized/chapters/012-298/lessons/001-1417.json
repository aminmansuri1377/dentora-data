  "steps": [
    {
      "id": "theory:54f5772726e9b21e8f002604d43a1944f29a56e7687dafd0abfa8da34ea85957",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "e22a04db2168db9265b51e389f63644ac13055af8f10c5561971f0b713b39248",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چهار عصب در معرض، و دو تای بی‌خطر"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ساختارهای عصبی مجاور که بیش از همه احتمال آسیب دیدنشان حین کشیدن هست، شاخه‌هایی از عصب تری‌ژمینال‌اند که مخاط و پوست را عصب‌دهی حسی می‌کنند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهار شاخه‌ای که بیش از همه درگیر می‌شوند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عصب چانه‌ای (مِنتال)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عصب لینگوال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عصب باکال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عصب نازوپالاتین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و حالا یک تفکیک که کار بالینی را ساده می‌کند —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دو تای بی‌خطر:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اعصاب نازوپالاتین و باکال اغلب حین ساختن فلپ برای برداشتن دندان‌های نهفته بریده می‌شوند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناحیه‌ی عصب‌دهی حسی این دو عصب نسبتاً کوچک است، و عصب‌دهی دوباره‌ی ناحیه‌ی درگیر معمولاً به‌سرعت رخ می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "note"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "بنابراین اعصاب نازوپالاتین و باکال بلند می‌توانند به‌صورت جراحی بریده شوند، بدون پیامد ماندگار یا آزار چندانی برای بیمار."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و دو قاعده‌ی کلی پیشگیری از آسیب عصبی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از آناتومی عصبی ناحیه‌ی جراحی آگاه باش، و از زدن برش یا کشیدن پریوست در ناحیه‌ی عصب پرهیز کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5520285e9222b86b4f3ef9a4edc8654e78cc505070935644f854e3431d721ac0",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "9c2e4b62620df49d42e3117e370efc915ebd3030db90e75dd8ae82999332fb45",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "عصب چانه‌ای: جایی که یک برش سرنوشت را عوض می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه عمل که باید با دقت بسیار انجام شوند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برداشتن جراحی ریشه‌های پرمولر مندیبل، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشتن پرمولرهای نهفته‌ی مندیبل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و جراحی پری‌اپیکال در ناحیه‌ی عصب و سوراخ چانه‌ای."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیامد آسیب:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر عصب چانه‌ای آسیب ببیند، بیمار پارستزی یا بی‌حسی لب و چانه را تجربه می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و حالا مهم‌ترین تفکیک این درس —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دو سرنوشت کاملاً متفاوت بسته به نوع آسیب:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر آسیب نتیجه‌ی رفلکشن یا دستکاری فلپ باشد، حس طبیعی معمولاً ظرف چند روز تا چند هفته برمی‌گردد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی اگر عصب چانه‌ای در محل خروجش از سوراخ چانه‌ای بریده شود، یا در طول مسیرش پاره شود، محتمل است که عملکرد عصب چانه‌ای برنگردد و بیمار یک وضعیت بی‌حسی دائمی داشته باشد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس اگر قرار است جراحی در ناحیه‌ی عصب یا سوراخ چانه‌ای انجام شود، ضروری است که جراح از موربیدیتی بالقوه‌ی آسیب به این عصب آگاه باشد. و راه‌حل روشن است: اگر جراح کوچک‌ترین تردیدی درباره‌ی توانایی‌اش در انجام عمل جراحی مورد نظر دارد، بیمار باید به جراح دهان و فک و صورت ارجاع داده شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک قاعده‌ی دقیق طراحی فلپ در این ناحیه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر قرار است "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فلپ سه‌گوش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در ناحیه‌ی عصب چانه‌ای به کار رود، برش رهاساز عمودی باید به‌اندازه‌ی کافی قدامی گذاشته شود تا هیچ بخشی از عصب چانه‌ای قطع نشود. و حتی می‌توان از این هم جلوتر رفت: در موارد نادر، عاقلانه است که برش رهاساز عمودی در پاپیلای بین‌دندانی میان کانین و پرمولر اول زده شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
