    {
      "id": "theory:ffd257be0e63e7c8006b8193d2a33098309a26d03268f6edb72b1a163a922e2b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "28e1abb3cdfe9f443449c70d0676e921c06dc1bf7603c0ff2d7a8bd3bdd1544d",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "عصب لینگوال و آلوئولار تحتانی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عصب لینگوال معمولاً از نظر آناتومیک درست چسبیده به سطح لینگوال مندیبل در ناحیه‌ی رترومولار پد قرار دارد. و گاهی مسیر عصب لینگوال آن را به داخل خودِ ناحیه‌ی رترومولار پد می‌برد."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-4-12.webp",
                  "alt": "دسترسی داخل‌دهانی به عصب آلوئولار تحتانی برای میکرونوروسرجری",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/73091ad0f4c2f96e15befd2b2f09803dab29c22e638385aa21102fee09d2fb11.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دسترسی داخل‌دهانی به عصب آلوئولار تحتانی برای میکرونوروسرجری "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 4.12)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و جمله‌ای که این عصب را از بقیه جدا می‌کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عصب لینگوال اگر به‌شدت تروما ببیند، به‌ندرت بازسازی می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس قاعده‌ی طراحی برش:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برش‌های زده‌شده در ناحیه‌ی رترومولار پد مندیبل باید طوری قرار گیرند که به این عصب نزدیک نشوند. بنابراین برش‌هایی که برای اکسپوز جراحی مولرهای سوم نهفته یا نواحی استخوانی ناحیه‌ی مولر خلفی زده می‌شوند، باید کاملاً به سمت باکالِ مندیبل زده شوند. و به همین ترتیب، اگر فلپ رترومولار پد را هم دربر می‌گیرد، هنگام جدا کردن آن از دیسکسیون یا کشش بیش از حد بافت‌های سمت لینگوال رترومولار پد پرهیز کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و جمع‌بندی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیشگیری از آسیب به عصب لینگوال اهمیت درجه‌اول دارد، تا از این عارضه‌ی دردسرساز پرهیز شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و سرانجام، عصب آلوئولار تحتانی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این عصب ممکن است در طول مسیر کانال داخل استخوانی‌اش تروما ببیند. شایع‌ترین محل آسیب، ناحیه‌ی مولر سوم مندیبل است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و سه نوع آسیب:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برداشتن مولرهای سوم نهفته ممکن است عصب را در کانالش کوفته کند، له کند، یا به‌طور تیز آسیب بزند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک تعهد ارتباطی که از فراوانی این عارضه می‌آید:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این عارضه حین کشیدن مولرهای سوم به‌قدر کافی شایع هست که مهم باشد به‌طور روتین پیش از عمل به بیماران اطلاع داده شود که یک احتمال است. و پس از آن، جراح باید همه‌ی احتیاط‌های ممکن را برای پرهیز از آسیب به عصب حین کشیدن به کار بندد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و اگر آسیب رخ داد —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یک قاعده‌ی زمان‌محور: اگر عصب لینگوال یا آلوئولار تحتانی آسیب دیده باشند، جراح باید بیمار را برای مشاوره به جراح دهان و فک و صورت ارجاع دهد. و این کار باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌درنگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام شود، چون: اگر ترمیم عصب اندیکاسیون داشته باشد، هرچه ترمیم زودتر انجام شود، شانس بازیابی کامل عملکرد عصب بهتر است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:c62bafadf5475063fb8ca99f7dc5929f283eb603920847f40e2d00a62793f858",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "b3814b725c25c6464d2df17a3f5c3a960d6f0b94b1006697b1eed2c4bffc4c9c",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مفصل گیجگاهی-فکی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ساختار عمده‌ی دیگری که می‌تواند حین کشیدن در مندیبل تروما ببیند، مفصل گیجگاهی-فکی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مکانیسم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برداشتن دندان‌های مولر مندیبل اغلب به اعمال مقدار قابل توجهی نیرو نیاز دارد. اگر فک حین کشیدن به‌اندازه‌ی کافی حمایت نشود تا این نیروها را خنثی کند، بیمار ممکن است در این ناحیه درد را تجربه کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیشگیری — و دو قاعده‌ی ساده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیروی کنترل‌شده و حمایت کافی از فک، از این آسیب پیشگیری می‌کنند. و به‌صورت چک‌لیست: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حین کشیدن از مندیبل حمایت کن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دهان را به باز شدن بیش از حد وادار نکن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و دو راه عملی حمایت:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "استفاده از یک بلوک بایت در سمت مقابل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌تواند تعادل کافی نیروها را فراهم کند تا آسیب رخ ندهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جراح یا دستیار همچنین باید با نگه داشتن مرز تحتانی مندیبل از فک حمایت کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "و اگر بیمار بلافاصله پس از عمل از درد ناحیه‌ی مفصل شکایت کند، درمان چهار جزء دارد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استفاده از گرما"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استراحت دادن به فک"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رژیم نرم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶۰۰ تا ۸۰۰ میلی‌گرم ایبوپروفن هر ۴ ساعت به مدت چند روز"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و برای بیمارانی که ضدالتهاب غیراستروئیدی را تحمل نمی‌کنند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌توانند ۵۰۰ تا ۱۰۰۰ میلی‌گرم استامینوفن مصرف کنند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
