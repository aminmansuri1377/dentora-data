  "steps": [
    {
      "id": "theory:34470d7a35efc15df9397e3a604cb7e7a6f775eebb00a1a712de7ff3f7315f20",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "fde1f3c9e9705437c4426752b0b654e69250f48cde0d2b43af943d7b28a0521c",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آمادگی، پیش از هر فوریتی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سنگ‌بنای مدیریت فوریت‌ها «پیشگیری» است، نه «درمان» —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و پس از آن، آمادگی مهم‌ترین عامل است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-2-4.webp",
                  "alt": "مانور فشار شکمی در بیمار بی‌هوش با انسداد راه هوایی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/4ace714401e1a446da9a2bc6897b9a6cb1989171ff43f5a6e17827225a05000f.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مانور فشار شکمی در بیمار بی‌هوش با انسداد راه هوایی "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 2.4)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ستون اول پیشگیری، ارزیابی پیش از عمل است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شرح‌حال پزشکی دقیق، فهرست داروهای مصرفی، و شناسایی بیمارانی که ذخیره‌ی فیزیولوژیک کمتری دارند — همان گروه‌هایی که در ماژول فارماکولوژی هم دیدیم."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ستون دوم، آمادگی سازمانی است —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و این چیزی است که با خواندن به دست نمی‌آید: کل تیم باید بداند چه کسی چه کاری می‌کند، تجهیزات فوریت کجاست، و شماره‌ی اورژانس چگونه گرفته می‌شود. تمرین دوره‌ای این سناریوها، بخشی از آمادگی است نه یک تشریفات."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و فوریت‌های شایع مطب در چهار گروه جای می‌گیرند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " واکنش‌های حساسیتی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناراحتی قفسه‌ی سینه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دشواری تنفسی (از جمله آسپیراسیون)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و تغییر سطح هوشیاری (از سنکوپ تا اختلال عروق مغزی)."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک قاعده‌ی طلایی که در تمام سناریوها تکرار می‌شود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " راه هوایی، تنفس، گردش خون — به همین ترتیب. هر تشخیص افتراقی زیبایی که در ذهن داری، پس از این سه می‌آید نه پیش از آن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:d244ba5a452115446505a87acd71fdb4ebed0c9fbca46dc420e6dd9fb0356428",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "3d44f9460a416943faa621d99162eb249b48a9388e2b05136357fd28415291ea",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "راه هوایی: جسم خارجی و محتویات معده"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در جراحی دهان، راه هوایی بیمار زیر دست توست —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و همین آسپیراسیون جسم خارجی را در این رشته همیشه به خطری بالقوه تبدیل می‌کند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-2-7.webp",
                  "alt": "پاتوفیزیولوژی و تظاهرات سنکوپ وازوواگال",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/e0a75c70a0ebc8292ebaa0e469d14889baa958933bf99a7252f7bed4b2575a7d.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پاتوفیزیولوژی و تظاهرات سنکوپ وازوواگال "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 2.7)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو موقعیت را باید از هم جدا کرد:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جسم خارجی بزرگ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — دندان کشیده‌شده، قطعه‌ی ترمیم، یا ابزار کوچک که از دست می‌رود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "محتویات معده و آسپیراسیون محتویات معده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — که خطر آن در بیمار سدیت‌شده به‌مراتب بیشتر است، چون رفلکس‌های محافظتی راه هوایی تضعیف شده‌اند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "و همین دومی، دلیل اصلی قواعد ناشتایی پیش از سداسیون عمیق است — قاعده‌ای که در نیتروس اکساید سبک‌تر است ولی در سداسیون وریدی جدی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و پیشگیری در جراحی دهان بسیار عملی است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گاز حلقی (تامپون حلق) برای بستن مسیر حلق، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساکشن آماده و در دسترس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کنترل مداوم قطعات و ابزار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و شمردن آنچه وارد دهان می‌شود و آنچه بیرون می‌آید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و اگر چیزی گم شد، اولین فرض این است که بلعیده یا آسپیره شده —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نه اینکه لابد افتاده روی زمین. رادیوگرافی قفسه‌ی سینه و شکم، حتی وقتی مطمئنی بلعیده شده، برای تفکیک مسیر گوارشی از مسیر تنفسی ضروری است، و آسپیراسیون به مسیر تنفسی یک فوریت واقعی است؛ جسمی که بلعیده شده معمولاً بی‌خطر از دستگاه گوارش می‌گذرد و پیگیری کافی است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
