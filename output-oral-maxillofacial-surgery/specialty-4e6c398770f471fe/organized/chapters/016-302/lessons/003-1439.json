  "steps": [
    {
      "id": "theory:c6f84027e57e5cebb64bb13364041ffa217f6c600fe8d8d2179d4eee7033d7a3",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "355a61b1ae5c03540aaa45d1f7643e7f8ac53e7fff3960ddd8cd25d9afdb17e3",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سداسیون عمیق‌تر، و مرز صلاحیت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک درجه‌بندی روشن وجود دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیتروس اکساید برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اضطراب خفیف تا متوسط"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". ولی بیمار به‌شدت مضطربی که قرار است چند کشیدن بدون پیچیدگی داشته باشد، ممکن است به سداسیون عمیق‌تر نیاز داشته باشد — که معمولاً از راه وریدی است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-6-20.webp",
                  "alt": "گیج فشار مخزن اکسیژن و مخزن نیتروس اکساید — دو خوانش متفاوت",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/1e37081408927adabaab93289ceb182e07351352b08a03ab13595da984c1ba53.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گیج فشار مخزن اکسیژن و مخزن نیتروس اکساید — دو خوانش متفاوت "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 6.20)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و انتخاب دارویی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سداسیون با داروهای ضداضطراب مانند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیازپام یا میدازولام"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با یا بدون یک مخدر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، به بیماران با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اضطراب متوسط تا شدید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اجازه می‌دهد اعمال جراحی را با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حداقل استرس روانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پشت سر بگذارند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و حالا مرزی بسیار صریح که باید جدی بگیری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر دندانپزشک در استفاده از این روش مهارت ندارد، بیمارانی که نیازمند سداسیون وریدی‌اند باید به دندانپزشکی ارجاع داده شوند که برای ارائه‌ی آن آموزش دیده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این یک توصیه‌ی محافظه‌کارانه نیست —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یک مرز صلاحیت است. سداسیون وریدی، برخلاف نیتروس اکساید، حاشیه‌ی خطای کمی دارد و مدیریت راه هوایی می‌طلبد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک فایده‌ی جانبی تیتراسیون N₂O:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وقتی مخلوط بهینه‌ی نیتروس اکساید و اکسیژن برای یک بیمار تعیین شد، همان دوز بهینه احتمالاً در جلسات بعدی هم مؤثر خواهد بود — پس آن عدد را در پرونده بنویس."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:d40684fb1408f2b0c752cf1a9e568d3e0baa1789b08626d5aabd5bc1dc46b563",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "3725100e11d16b4aff0be19bfd4e8fcb33ddfa30d4a37084e9743d452f355974",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ترکیب سداسیون و بی‌حسی موضعی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک سوءتفاهم رایج را همین‌جا رفع کن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سداسیون جایگزین بی‌حسی موضعی نیست. بیمار سدیت‌شده همچنان به بی‌حسی موضعی کامل نیاز دارد؛ سداسیون در اصل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اضطراب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را مدیریت می‌کند؛ اثر ضددردی نیتروس اکساید هم برای جراحی کافی نیست و کنترل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با بی‌حسی موضعی است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-6-21.webp",
                  "alt": "سیستم پین‌ایندکس؛ جلوی وصل شدن گاز اشتباه به پورت اشتباه را می‌گیرد",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/59cabe1c67b44926d70563d64197eb34272228a3964a1fb7ac1cd88a479b28aa.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیستم پین‌ایندکس؛ جلوی وصل شدن گاز اشتباه به پورت اشتباه را می‌گیرد "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 6.21)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترتیب کار روشن است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس از رسیدن به سطح مناسب سداسیون و آرامش بیمار، بی‌حسی موضعی زده می‌شود و سپس جراحی پیش می‌رود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و همین ترتیب، یکی از دلایل اصلی کاربرد N₂O را توضیح می‌دهد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این تکنیک به‌ویژه برای بیمارانی که در درجه‌ی اول از خودِ تزریق بی‌حسی می‌ترسند مفید است. یعنی گاز، بیمار را از سد اول عبور می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک قاعده‌ی دوز که از یونیت فارماکولوژی می‌آید و اینجا اهمیت مضاعف دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیمار سدیت‌شده نمی‌تواند علائم اولیه‌ی مسمومیت با بی‌حسی موضعی را به‌روشنی گزارش کند. پس محاسبه‌ی دوز حداکثر پیش از شروع، در بیمار سدیت‌شده اختیاری نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و ثبت کن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درصد بهینه‌ی N₂O، مدت سداسیون، حجم و نوع بی‌حسی موضعی، و پاسخ بیمار. این پرونده، جلسه‌ی بعدی را بسیار ساده‌تر می‌کند."
                }
              ]
            }
          ]
        }
      ],
