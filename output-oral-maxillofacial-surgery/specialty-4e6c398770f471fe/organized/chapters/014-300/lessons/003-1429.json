  "steps": [
    {
      "id": "theory:34f65a3962012f4b7d3d5fd15486649314feaed348690fd13cd7a694b3eb1d4a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "bf2a0ce20044f1310cf62f07017f470b35bcbe131047f9987a42686c5df7fcdf",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "گاو-گیتس: بالاتر برو"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناحیه‌ی هدف:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سطح خارجی گردن کندیل. محل ورود: مخاط سطح مزیال راموس، روی خطی از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شیار بین‌تراگوسی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گوشه‌ی دهان سمت مقابل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، درست "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیستال مولر دوم ماگزیلا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-6-18.webp",
                  "alt": "جای سوزن برای بی‌حس کردن عصب باکال بلند",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/be0e75ca6482c65bcba867a1092d907948529f418eac488fda69bba3b1a52f0c.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جای سوزن برای بی‌حس کردن عصب باکال بلند "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 6.18)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لندمارک‌ها:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیرون‌دهانی — "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شیار بین‌تراگوسی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (لبه‌ی پایینی تراگوس؛ لندمارک واقعی مرکز مجرای شنوایی خارجی است که تراگوس آن را پوشانده) و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گوشه‌ی دهان سمت مقابل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". درون‌دهانی — ارتفاع تزریق با گذاشتن نوک سوزن درست زیر کاسپ مزیولینگوال (مزیوپالاتال) مولر دوم ماگزیلا تعیین می‌شود. سوزن تا تماس با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گردن کندیل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش می‌رود (عمق میانگین حدود ۲۵ میلی‌متر) و جهت بِوِل در این تکنیک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حساس نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مزیت اصلی و دلیل وجودی این تکنیک:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عصب‌دهی کمکی هم بلاک می‌شود، پس تزریق‌های اضافی معمولاً لازم نیست. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نرخ موفقیت بیش از ۹۵ درصد با تجربه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نرخ آسپیراسیون مثبت حدود ۲ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عوارض پس از تزریق کم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و در حضور عصب آلوئولار تحتانی دوشاخه و کانال‌های مندیبولار دوشاخه هم موفق است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و معایبی که باید بدانی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شروع اثر کندتر از بلاک معمولی است — به علت قطر تنه‌ی عصبی و فاصله‌ی حدود ۵ تا ۱۰ میلی‌متری محل تزریق تا عصب. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک منحنی یادگیری واقعی دارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که برای برخی افراد ناامیدکننده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "منع مصرف:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عفونت یا التهاب حاد در ناحیه‌ی تزریق (نادر)، بیمارانی که ممکن است لب یا زبانشان را گاز بگیرند، و بیمارانی که نمی‌توانند دهانشان را کاملاً باز کنند، مثلاً به علت تریسموس."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:e44be356d8dd3ba06d49bb9381fafadb017666e98a145afe53fcd3ff8197413a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "922647357584b36a8ecc9919c5cd43cdc663bff1632b75bcadded3c585aae2d9",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ویزیرانی-آکینوزی: دهان بسته"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این تکنیک دقیقاً برای همان بیماری ساخته شده که گاو-گیتس در او ممنوع است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیماری که دهانش باز نمی‌شود. نامش هم همین را می‌گوید — بلاک مندیبولار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با دهان بسته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل ورود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بافت نرم روی لبه‌ی داخلی (لینگوال) راموس، درست مجاور توبروزیته‌ی ماگزیلا، در ارتفاع محل اتصال مخاط به لثه. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناحیه‌ی هدف:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بافت نرم لبه‌ی داخلی راموس، در ناحیه‌ی اعصاب آلوئولار تحتانی، لینگوال و مایلوهایوئید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک نکته‌ی مقایسه‌ای که همه‌چیز را مرتب می‌کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ارتفاع تزریق ویزیرانی-آکینوزی، پایین‌تر از گاو-گیتس ولی بالاتر از بلاک آلوئولار تحتانی معمولی است. پس این سه تکنیک، سه ارتفاع متفاوت روی یک مسیر عصبی‌اند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جهت بِوِل اینجا برخلاف بلاک معمولی بسیار مهم است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بِوِل باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رو به دور از استخوان راموس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد — یعنی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رو به خط وسط"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مزایا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نسبتاً اتروماتیک، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار لازم نیست بتواند دهانش را باز کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، عوارض پس از عمل کمتر مثل تریسموس، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نرخ آسپیراسیون کمتر از ۱۰ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که از بلاک معمولی پایین‌تر است، و مثل گاو-گیتس، در عصب دوشاخه هم موفق است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عیب اصلی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیدن مسیر سوزن و عمق ورود دشوار است — چون هیچ استخوانی لمس نمی‌شود که به تو بگوید کجایی."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
