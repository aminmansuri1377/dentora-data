    {
      "id": "theory:1fc8d79b0775697b8a3fd62a615af0d937afbe2510d49e8e53cb995ba0deadd5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "bb0137ff330d29ad3853114c8469df79540cdb465c94f585526f8b0276a8564a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیش از آنکه سوزن وارد شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیشتر دردی که بیمار از «آمپول دندانپزشکی» به یاد دارد، از خودِ سوزن نمی‌آید —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از سه چیز می‌آید: بافت خشک و شل، تزریق سریع، و محلول سرد."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-6-5.webp",
                  "alt": "محل تزریق برای بی‌حسی انفیلتراسیون یک دندان ماگزیلا",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/74cf3d5278e46932094ecb4a35fc5a03510316ef4b777f68bbea0bcbd46b5f6f.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل تزریق برای بی‌حسی انفیلتراسیون یک دندان ماگزیلا "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 6.5)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آماده‌سازی بافت سه گام دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خشک کردن با گاز استریل، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنتی‌سپتیک موضعی (اختیاری)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی موضعی سطحی برای یک تا دو دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک نکته که همه از آن رد می‌شوند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بی‌حسی سطحی باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "واقعاً یک تا دو دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بماند. گذاشتن و بلافاصله برداشتنش، فقط مزه‌ی تلخ به بیمار می‌دهد و هیچ اثری ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "کشیدن بافت پیش از ورود سوزن، از ساده‌ترین راه‌های کم کردن درد ورود سوزن است. در بلاک آلوئولار تحتانی، انگشتی که روی شیار کورونوئید است، بافت را به سمت خارج می‌کشد و سفت می‌کند — و همین ورود سوزن را کم‌آسیب‌تر می‌کند و دید بهتری می‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:68843cff20d419a623f31ba5e26d933964f0e6ad38e5ef66e7d46ab99ae0cd51",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "0b55a750700b07afca2e4330b489d1fb3cfe59ab5c0b1eb567408ff94bfe83c9",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سرعت، آسپیراسیون، و ایمنی سوزن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سرعت تزریق از مهم‌ترین عوامل درد حین تزریق و پس از آن است. محلولی که با فشار و سرعت وارد بافت شود، بافت را پاره می‌کند و درد و تورم پس از عمل می‌سازد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اعداد کاربردی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بلاک نازوپالاتین "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حداقل ۱۵ تا ۳۰ ثانیه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای حداکثر یک‌چهارم کارتریج، بلاک پالاتین بزرگ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حداقل ۳۰ ثانیه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". یعنی تزریق پالاتال نباید در چند ثانیه تمام شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آسپیراسیون:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از تزریق حتماً آسپیره کن — و در تزریق‌های پرخطر، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در دو صفحه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". نرخ آسپیراسیون مثبت برای بلاک آلوئولار تحتانی از همه بالاتر است (۱۰ تا ۱۵ درصد)؛ گاو-گیتس حدود ۲٪ و ویزیرانی-آکینوزی کمتر از ۱۰٪."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و ایمنی خودت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هرجا ممکن است، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از آینه‌ی دهانی برای رترکشن استفاده کن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تا خطر فرورفتن سوزن در دست خودت کم شود. و پس از تزریق، بی‌درنگ سوزن را ایمن کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک نکته‌ی بالینی که سرعت را به عمق گره می‌زند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در بلاک آلوئولار تحتانی، در بیشتر بیماران لازم نیست حین عبور سوزن از بافت نرم محلولی تزریق شود؛ ولی در بیمار مضطرب یا حساس، تزریق حجم‌های کوچک حین پیشروی سوزن توصیه می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
