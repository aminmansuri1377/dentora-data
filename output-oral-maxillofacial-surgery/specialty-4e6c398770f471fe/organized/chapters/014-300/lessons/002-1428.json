  "steps": [
    {
      "id": "theory:41fd90e8c48a0317fc4cc118733532bfc43dbac3fb7e1b7c82091dd37f1edb07",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "47965f5d67ada8914ee590ffdb21bb4aced4b9591963912f7db99f767f029004",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه لندمارک، دو پارامتر اول"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن بلند ۲۵ گیج توصیه می‌شود؛ ۲۷ بلند هم قابل‌قبول است. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل ورود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مخاط سطح داخلی (لینگوال) راموس مندیبل، در محل تقاطع یک خط افقی و یک خط عمودی. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناحیه‌ی هدف:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عصب آلوئولار تحتانی، وقتی به سمت پایین به‌طرف سوراخ مندیبولار می‌رود — "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی پیش از آنکه وارد سوراخ شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-6-16.webp",
                  "alt": "بلاک عصب آلوئولار تحتانی با سوزن بلند",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/4ad17619b13e5b8d3805b6bfae764ecde1274b7f2b122d7ec941786eecbbbaba.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بلاک عصب آلوئولار تحتانی با سوزن بلند "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 6.16)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه لندمارک: شیار کورونوئید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (بیشترین تقعر لبه‌ی قدامی راموس)، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بخش عمودی رافه‌ی پتریگومندیبولار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "صفحه‌ی اکلوزال دندان‌های خلفی پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پارامتر اول — ارتفاع تزریق:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انگشت اشاره یا شست را در شیار کورونوئید بگذار. یک خط فرضی از نوک انگشت به سمت عقب تا عمیق‌ترین بخش رافه‌ی پتریگومندیبولار کشیده می‌شود. این خط باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "موازی صفحه‌ی اکلوزال مولرهای پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد، و در بیشتر بیماران ۶ تا ۱۰ میلی‌متر بالای صفحه‌ی اکلوزال قرار می‌گیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پارامتر دوم — موقعیت قدامی-خلفی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نقطه‌ی ورود سوزن در سه‌چهارم فاصله از شیار کورونوئید به عقب تا عمیق‌ترین بخش رافه قرار دارد. بدنه‌ی سرنگ در گوشه‌ی دهان سمت مقابل، معمولاً روی پرمولرها قرار می‌گیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک نکته‌ی آناتومیک که اغلب اشتباه فهمیده می‌شود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رافه‌ی پتریگومندیبولار از رترومولار پد به‌صورت افقی به عقب می‌رود و بعد به سمت کام بالا می‌پیچد. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنها بخش عمودی رافه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است که به‌عنوان نشانه‌ی لبه‌ی خلفی راموس به کار می‌رود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:d186fc3ef4cf8b6f64983d88dc3bbae2d2699cdc574849a470d45f232e0a0dbf",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "cc0774ee17c263c06cc80466ee14af0fb5d706b5616a213cd92f793e8e5bbc13",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پارامتر سوم، و دو خطای کلاسیک"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پارامتر سوم —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عمق نفوذ: باید استخوان لمس شود. سوزن را آهسته جلو ببر تا تماس با استخوان را حس کنی."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-6-17.webp",
                  "alt": "سوزن در محل تزریق، نزدیک ورودی عصب آلوئولار تحتانی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/ae92290f76b0a9f79065bed9df18c668cfab30b18b353bb9b7aebf8d559ad2ba.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن در محل تزریق، نزدیک ورودی عصب آلوئولار تحتانی "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 6.17)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمق میانگین تا تماس استخوانی در بزرگسال، ۲۰ تا ۲۵ میلی‌متر است —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تقریباً دو-سوم تا سه-چهارم طول یک سوزن بلند. در این نقطه، نوک سوزن اندکی بالاتر از سوراخ مندیبولار قرار دارد. و یادت باشد: سوراخ مندیبولار نه دیده می‌شود و نه بالینی قابل لمس است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطای اول —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " استخوان خیلی زود خورد (کمتر از نصف طول سوزن بلند): نوک سوزن معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیش از حد قدامی (خارجی) روی راموس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. اصلاح: سوزن را کمی بیرون بکش ولی از بافت خارج نکن، بدنه‌ی سرنگ را بیشتر به سمت جلوی دهان ببر، روی کانین یا لترال سمت مقابل، و دوباره تا عمق مناسب پیش ببر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطای دوم — استخوان اصلاً نخورد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نوک سوزن معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیش از حد خلفی (داخلی)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. اصلاح: سوزن را تا حدی بیرون بکش که حدود یک‌چهارم طولش در بافت بماند، بدنه‌ی سرنگ را عقب‌تر ببر، روی مولرهای پایین، و تا تماس با استخوان در عمق ۲۰ تا ۲۵ میلی‌متر ادامه بده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و جهت بِوِل:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در این بلاک، جهت بِوِل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کم‌اهمیت‌تر از بلاک‌های دیگر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، چون سوزن تقریباً با زاویه‌ی قائم به عصب نزدیک می‌شود."
                }
              ]
            }
          ]
        }
      ],
