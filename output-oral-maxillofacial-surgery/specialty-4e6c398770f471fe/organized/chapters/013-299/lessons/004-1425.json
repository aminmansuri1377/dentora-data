  "chapter": {
    "id": "299",
    "title": "درد، اضطراب، فوریت، داروی بی‌حسی: چه چیزی عصب را خاموش می‌کند",
    "position": 13
  },
  "position": 4,
  "importReady": true,
  "countsComparedWithConfiguredExpectation": false,
