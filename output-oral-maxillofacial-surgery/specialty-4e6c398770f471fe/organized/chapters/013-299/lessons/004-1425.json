  "steps": [
    {
      "id": "theory:1594ea777e463d9413806ebba7c7f16086e498f90f72602fc4e75d6474f03b6e",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "b96497fe137dc31ebb314b8db602ae52d344561219aa386c1c054c7177233997",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کدام دارو، کدام کار"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لیدوکائین ۲٪ با اپی‌نفرین ۱:۱۰۰٬۰۰۰"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — استاندارد مرجع. حدود ۶۰ دقیقه بی‌حسی پالپی، شروع سریع، و دارویی که همه‌چیز با آن مقایسه می‌شود."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-2-1.webp",
                  "alt": "کیت اورژانس با اندازه و پیچیدگی مناسب مطب دندانپزشکی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/9511a35aca52b19c9d0acab3513ece4d00b1028825d696419af6836f8f2d232e.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کیت اورژانس با اندازه و پیچیدگی مناسب مطب دندانپزشکی "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 2.1)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مپیواکائین ۳٪ ساده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — تنها ۵ تا ۱۰ دقیقه بی‌حسی پالپی در انفیلتراسیون، ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲۰ تا ۴۰ دقیقه در بلاک عصبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". انتخاب کارهای کوتاه و بیمارانی که نباید اپی‌نفرین بگیرند؛ کم‌ترین وازودیلاتاسیون میان آمیدها از آنِ همین دارو است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پریلوکائین ۴٪ ساده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — ۱۰ تا ۱۵ دقیقه در انفیلتراسیون، ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴۰ تا ۶۰ دقیقه در بلاک عصبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". وازودیلاتاسیونش از لیدوکائین کمتر است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آرتیکائین ۴٪ با اپی‌نفرین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — نفوذ استخوانی خوب و نیمه‌عمر بسیار کوتاه (۰٫۵ ساعت)، چون علی‌رغم آمید بودن، زنجیره‌ی جانبی استری‌اش در پلاسما هم هیدرولیز می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بوپیواکائین ۰٫۵٪ با اپی‌نفرین ۱:۲۰۰٬۰۰۰"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶۰ دقیقه بی‌حسی پالپی در انفیلتراسیون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تا ۳۶۰ دقیقه در بلاک عصبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". این دارو برای کارهای طولانی و — مهم‌تر — برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کنترل درد پس از عمل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک قاعده‌ی مهم بلاک در برابر انفیلتراسیون:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فرم ساده‌ی مپیواکائین و پریلوکائین در انفیلتراسیون تقریباً بی‌فایده است ولی در بلاک کاملاً کارآمد — چون در بلاک، دارو دورتر از عروق پرخون محل جراحی رها می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:3405e9054ea2b26521db5353206fec339d3bb50a3acbef7305cc951644941043",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "2780dbf86e5c7f13c44b9c0881720cb98b72e2c715badff76a36de671c0669e2",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "حداکثر دوز، و حساب کردنش"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اول: هر کارتریج ۱٫۸ میلی‌لیتری چند میلی‌گرم دارو دارد؟ درصد را در ۱۸ ضرب کن."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لیدوکائین ۲٪ = ۳۶ میلی‌گرم در کارتریج"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مپیواکائین ۲٪ = ۳۶، مپیواکائین ۳٪ = ۵۴ میلی‌گرم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آرتیکائین ۴٪ = ۷۲، پریلوکائین ۴٪ = ۷۲ میلی‌گرم"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و حالا حداکثر دوز توصیه‌شده (MRD) بر اساس FDA:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لیدوکائین با وازوکنستریکتور:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ۷٫۰ mg/kg، سقف مطلق ۵۰۰ میلی‌گرم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آرتیکائین با وازوکنستریکتور:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ۷٫۰ mg/kg، بدون سقف مطلق اعلام‌شده"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مپیواکائین (با یا بدون وازوکنستریکتور):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ۶٫۶ mg/kg، سقف ۴۰۰ میلی‌گرم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پریلوکائین (با یا بدون وازوکنستریکتور):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ۸٫۰ mg/kg، سقف ۶۰۰ میلی‌گرم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بوپیواکائین با وازوکنستریکتور:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سقف ۹۰ میلی‌گرم"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک مثال تا عدد در ذهنت جا بیفتد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیمار ۷۰ کیلویی، لیدوکائین ۲٪ با اپی‌نفرین. ۷٫۰ × ۷۰ = ۴۹۰ میلی‌گرم، که زیر سقف ۵۰۰ است. تقسیم بر ۳۶ میلی‌گرم در کارتریج ≈ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۳ کارتریج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". یعنی در بزرگسال سالم، MRD به‌ندرت محدودکننده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی همان حساب برای کودک ۲۰ کیلویی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ۷٫۰ × ۲۰ = ۱۴۰ میلی‌گرم، یعنی کمتر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ کارتریج."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اینجاست که MRD واقعاً معنا پیدا می‌کند — و به همین دلیل، دوز کودک و سالمند و بیمار ناتوان باید همیشه حساب شود، نه تخمین زده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
