  "steps": [
    {
      "id": "theory:881cdcb5e0b5fd657e53848128baa01981e48886f1a0f132db8abc7c30274b02",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "7b55bca985e0963a87ec333544ac928566f86ecbe73f24f3829f17dcc01c3fe1",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چهار کاری که اپی‌نفرین می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تمام بی‌حسی‌های موضعیِ امروزی، وازودیلاتور هستند. یعنی خودشان عروق محل تزریق را گشاد می‌کنند — و این دقیقاً برخلاف چیزی است که تو می‌خواهی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عروق گشاد یعنی دارو سریع‌تر از محل تزریق جذب خون می‌شود. و این چهار پیامد دارد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مدت اثر کوتاه‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمق بی‌حسی کمتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سطح خونی بالاتر و خطر مسمومیت بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خون‌ریزی بیشتر در ناحیه‌ی کار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وازوکنستریکتور دقیقاً هر چهار مورد را برمی‌گرداند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جذب را کند می‌کند، مدت و عمق بی‌حسی را بالا می‌برد، سطح خونی و خطر مسمومیت را پایین می‌آورد، و میدان کار را کم‌خون‌تر می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس این یک افزودنیِ اختیاریِ تجملی نیست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در بیشتر شرایط جراحی، محلول بدون وازوکنستریکتور "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطرناک‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه ایمن‌تر — چون سطح خونی بالاتری می‌سازد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:bbe0548f1543c8546c7ed2fba957d41cb782e81ab521e2efb521c4b84826f78b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "aa57ad39b6a1ebf3bdb42a7757195612a9a7dea6ea85ec312edd0d0e277c5602",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "خواندن آن کسر روی کارتریج"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غلظت وازوکنستریکتور را با یک کسر می‌نویسند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ۱ گرم دارو در آن حجم محلول به میلی‌لیتر."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱:۱۰۰٬۰۰۰ یعنی ۱ گرم در ۱۰۰٬۰۰۰ میلی‌لیتر، یعنی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۰۱ میلی‌گرم در هر میلی‌لیتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ". یک کارتریج ۱٫۸ میلی‌لیتری حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۰۱۸ میلی‌گرم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اپی‌نفرین دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱:۲۰۰٬۰۰۰ نصف آن است"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — حدود ۰٫۰۰۹ میلی‌گرم در هر کارتریج."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱:۵۰٬۰۰۰ دو برابر ۱:۱۰۰٬۰۰۰ است"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — حدود ۰٫۰۳۶ میلی‌گرم در هر کارتریج؛ فقط برای هموستاز موضعی و در حجم کم."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و حالا دو سقف که باید حفظ باشند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار سالم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، حداکثر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰٫۲ میلی‌گرم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اپی‌نفرین در یک نوبت. در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار با اختلال قلبی-عروقی قابل‌توجه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، حداکثر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰٫۰۴ میلی‌گرم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — یعنی حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو کارتریج ۱:۱۰۰٬۰۰۰"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهار کارتریج ۱:۲۰۰٬۰۰۰"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و برای بیمار قلبی که حتی همین مقدار هم زیاد است، یک جایگزین روشن وجود دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مپیواکائین ۳٪ بدون وازوکنستریکتور یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پریلوکائین ۴٪ بدون وازوکنستریکتور"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به‌صورت بلاک عصبی — چون این دو در فرم ساده هم مدت قابل‌قبولی می‌دهند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک هشدار که فراموش می‌شود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نخ‌های رترکشن آغشته به اپی‌نفرین راسمیک، غلظت بسیار بالاتری از اپی‌نفرین آزاد می‌کنند و در بیمار قلبی نباید استفاده شوند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
