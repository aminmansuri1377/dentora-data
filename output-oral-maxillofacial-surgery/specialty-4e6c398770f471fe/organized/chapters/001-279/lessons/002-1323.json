  "title": "درس دوم: خون بند بیاور، استخوان بردار",
  "specialtyKey": "4e6c398770f471fe",
  "chapter": {
    "id": "279",
    "title": "اولین دندانی که می‌کشی، ابزار جراحی دهان",
    "position": 1
  },
  "position": 2,
  "importReady": true,
  "countsComparedWithConfiguredExpectation": false,
