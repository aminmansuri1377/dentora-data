  "steps": [
    {
      "id": "theory:493d433568b208a7691c8c291894ba0b2cff826714a54f3efc6540ffa8ca2a8b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "9e21432d62353bd198c020797c4cf04114b942ac052a3c8b244813b42cb808cc",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هموستات و رانژور — و کاری که هیچ‌کدام نباید بکنند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای بیشتر جراحی دنتوآلوئولار، فشار روی زخم برای بند آمدن خون کافی است. وقتی نبود، سراغ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هموستات"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌روی: نوک‌های بلند و ظریف برای گرفتن بافت، به‌علاوه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دسته‌ی قفل‌شونده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". قفل یعنی می‌توانی روی رگ ببندی و ولش کنی یا به دست دستیار بدهی. پرکاربردترین نوع در جراحی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هموستات خمیده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-7-12.webp",
                  "alt": "هموستات؛ نمای بالا و نمای مایل از نوع خمیده",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/fd316a58b668f7b1dd72a68718c6e9de623c4167e0fcf19488170f0ba7d5413a.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هموستات؛ نمای بالا و نمای مایل از نوع خمیده "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 7.12)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاربرد دومش در جراحی دهان مهم‌تر است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برداشتن بافت گرانولاسیون از ساکت، و برداشتن نوک ریشه، جرم، آمالگام و هر ذره‌ی کوچکی که داخل زخم افتاده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "هموستات هرگز برای بخیه زدن به کار نمی‌رود. سطح فک‌هایش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شیارهای موازی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد نه شبکه‌ی متقاطع؛ کنترل روی سوزن و نخ کم می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رانژور"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پرکاربردترین ابزار برداشتن استخوان در جراحی دنتوآلوئولار است: تیغه‌های تیزی که با فشردن دسته‌ها استخوان را می‌برند، به‌علاوه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مکانیسم برگشتی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که با رها کردن دست خودش باز می‌شود — پس بدون باز کردن دستی می‌توانی پشت‌سرهم بگیری. دو طرح: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فقط برش از کنار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برش از کنار و از نوک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (Blumenthal) که برای بیشتر کارهای دنتوآلوئولار عملی‌تر است، چون "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داخل ساکت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌رود و استخوان بین‌ریشه‌ای و لبه‌های تیز را برمی‌دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو کاری که با رانژور نمی‌کنی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برداشتن حجم زیاد استخوان در یک گاز — به‌جایش گازهای کوچک و پشت‌سرهم؛ و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کشیدن دندان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — ابزار را فوراً کند و خراب می‌کند و چون برای نگه داشتن محکمِ دندان طراحی نشده، خطر افتادن دندان در گلوی بیمار دارد. رانژور گران است؛ تیز و سالم نگهش دار."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:42742fab6b54bf445933f167ebb5c85e2759095f8331a525455c93b865fa718e",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5eeb3f3056dab773b2c4d798d348bea12869ef03a0ed34b9731db81030823a4d",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بور و هندپیس، چیزل، سوهان و کورت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "راه اصلی برداشتن استخوان در کشیدن جراحی، بور در هندپیس است. هندپیس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرعت متوسط و گشتاور بالا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با بور کارباید تیز. بورهای رایج: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فیشور ۵۵۷ یا ۷۰۳"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راند شماره‌ی ۸"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". برای حجم زیاد (مثل کاهش توروس) بور استخوانی بزرگ شبیه بور آکریل."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-7-13.webp",
                  "alt": "رانژور — فورسپس استخوان‌بر با دسته‌ی فنری",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/913395826a382719097bf0e282e2e69b2c21dfece8cf202200422a2983091086.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رانژور — فورسپس استخوان‌بر با دسته‌ی فنری "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 7.13)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطرناک‌ترین خطای انتخاب ابزار در جراحی دهان:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هندپیس جراحی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نباید هوا را داخل میدان عمل خروج دهد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — پس توربین هوای پرسرعت ترمیمی ممنوع است. هوای خروجی به لایه‌های عمقی بافت رانده می‌شود و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آمفیزم بافتی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌سازد. و هندپیس جراحی باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاملاً قابل استریل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شست‌وشو اختیاری نیست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وقتی با بور استخوان برمی‌داری، جریان پیوسته‌ی سالین یا آب استریل: بور را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خنک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌کند و از گرمای آسیب‌رسان به استخوان جلوگیری می‌کند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خرده‌های استخوان را از شیار بور می‌شوید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و کارایی‌اش را بالا می‌برد، و کمی هم روان‌کاری می‌کند. پیش از بخیه، کل میدان کاملاً شسته می‌شود — با سرنگ پلاستیکی بزرگ و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن ۱۸ گیج بلانت و زاویه‌دار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مالت و چیزل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — با آمدن هندپیس پرسرعت کاربردش خیلی محدود شده؛ هنوز گاهی برای "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "توروس لینگوال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ". لبه‌ی چیزل باید تیز بماند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سوهان استخوان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — فقط "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "صاف کردن نهایی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " لبه‌ها و اسپیکول‌های کوچک، نه برداشتن حجم. دندانه‌هایش طوری چیده شده‌اند که "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فقط در ضربه‌ی کششی (pull)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کار کنند؛ هُل دادنش استخوان را فقط می‌ساید و له می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کورت پری‌اپیکال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — قاشقی و دوسر و زاویه‌دار، برای برداشتن بافت نرم از حفره‌ی استخوانی: گرانولوما و کیست کوچک پری‌اپیکال، و بافت گرانولاسیون ساکت. "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "با کورت پریودنتال یکی نیست"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — طرح و کارکردشان فرق دارد."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
