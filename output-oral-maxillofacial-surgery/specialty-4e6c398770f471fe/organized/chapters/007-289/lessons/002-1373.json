                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خون‌رسانی بیشتری دارد، پس پس از عمل سریع‌تر ترمیم می‌شود هرچند حین عمل تفاوتی ندارد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۲"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
