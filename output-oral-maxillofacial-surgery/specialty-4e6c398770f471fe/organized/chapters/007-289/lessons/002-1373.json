      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فولیکول و تراکم استخوان"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اندازه‌ی ساک فولیکولار."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اندازه‌ی فولیکول اطراف دندان نهفته می‌تواند سختی کشیدن را مشخص کند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-10-12.webp",
                  "alt": "کیست دنتی‌ژرو بزرگ که دندان نهفته را جابه‌جا کرده است",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/02a4a611d42b1ffcd2fe59be146bdaf6d5d2368165575bd65c0ab220e4d95d59.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کیست دنتی‌ژرو بزرگ که دندان نهفته را جابه‌جا کرده است "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 10.12)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر ساک فولیکولار "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پهن باشد — تقریباً به اندازه‌ی یک کیست"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "استخوان بسیار کمتری باید برداشته شود"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، که دندان را سرراست‌تر می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "note"
                  },
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "و یک نکته‌ی سنی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیماران جوان بیشتر احتمال دارد فولیکول بزرگ داشته باشند — عامل دیگری که کشیدن را در بیماران جوان‌تر کم‌پیچیده‌تر می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی اگر فضای فولیکولار اطراف تاج باریک یا اصلاً موجود نباشد، جراح باید "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خودش فضای اطراف تاج را ایجاد کند"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — که هم "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سختی عمل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و هم "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زمان لازم برای برداشتن دندان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را بالا می‌برد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراکم استخوان اطراف."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هرچند بعضی سرنخ‌ها در رادیوگرافی دیده می‌شوند، تغییرات در تراکم و زاویه‌ی رادیوگرافیک تفسیر تراکم استخوان بر پایه‌ی کلیشه را غیرقابل اعتماد می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پس بهترین سنجه‌ی تراکم استخوان چیست؟ سن بیمار."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیماران ۲۵ ساله یا کمتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تراکم استخوانی مطلوب برای برداشتن دندان دارند. استخوان "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کم‌تراکم‌تر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیشتر احتمال دارد انعطاف‌پذیر باشد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تا حدی گشاد و خم می‌شود"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — که اجازه می‌دهد ساکت با الواتور یا با نیروهای لوکسیشن روی خود دندان "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گشاد شود"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ". افزون بر این، استخوان کم‌تراکم با بور دندانی سرراست‌تر بریده می‌شود و سریع‌تر برداشته می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {
                    "tone": "warning"
                  },
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیماران بالای ۲۵ سال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " استخوان به‌مراتب متراکم‌تر با کاهش انعطاف و توان گشاد شدن دارند. در این بیماران جراح باید تمام استخوان مزاحم را بردارد، چون گشاد کردن ساکت استخوانی ممکن نیست. و با افزایش تراکم، برداشتن استخوان با بور سخت‌تر می‌شود و فرایند بیشتر طول می‌کشد. همچنین نیروی بیش از حد در استخوان بسیار متراکم، در مقایسه با استخوان کم‌تراکم با همان مقطع، بیشتر به شکستگی می‌انجامد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "و یک عامل دیگر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " جنسیت هم در تراکم استخوان نقش دارد؛ مردان، به‌ویژه مردان درشت‌اندام، به‌طور کلی تراکم استخوانی بیشتری از زنان دارند."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:241bde2ceda146484082ce966412aabd8ecac3425898e76953d37bd19dbfade8",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "a6ad471017cf5ecce92eeeea53b9ccd9ad454413e364304004ad509c4333df4b",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تماس با مولر دوم مندیبل"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر میان مولر دوم و مولر سوم نهفته فضا وجود داشته باشد، رویکرد کشیدن سرراست‌تر خواهد بود، چون آسیب به مولر دوم کمتر محتمل است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-10-2.webp",
                  "alt": "مولر سوم نهفته و تحلیل شدید استخوان دیستال مولر دوم",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/2678b33acbe4bc04e59f467db8db65d369c076d2b69188a5527450041c30db0d.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مولر سوم نهفته و تحلیل شدید استخوان دیستال مولر دوم "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 10.2)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "ولی اگر دندان نهفتگی دیستوانگولار یا افقی باشد، اغلب در تماس مستقیم با مولر دوم مجاور است. برای برداشتن ایمن مولر سوم بدون آسیب به مولر دوم، جراح باید در دو چیز محتاط باشد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار الواتورها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کار با بور هنگام برداشتن استخوان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک ملاحظه‌ی ترمیمی که به رضایت‌نامه گره می‌خورد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر مولر دوم پوسیدگی یا ترمیم بزرگ داشته باشد یا اندو شده باشد، جراح باید دقت ویژه کند که ترمیم یا بخشی از تاج پوسیده را نشکند. و بیمار باید از پیش درباره‌ی این احتمال آگاه شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جمع‌بندی این درس در قالب یک نکته‌ی عملی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سه عاملِ فولیکول، تراکم استخوان و تماس با مولر دوم در طبقه‌بندی‌های زاویه، راموس و عمق دیده نمی‌شوند، ولی هر سه در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فهرست عوامل آسان‌کننده و دشوارکننده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جا دارند — و دو تای اول "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مستقیماً به سن بیمار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وابسته‌اند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
