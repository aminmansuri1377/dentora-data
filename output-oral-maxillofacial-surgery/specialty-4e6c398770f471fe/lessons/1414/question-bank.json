      "questionType": "single-choice",
      "title": "درس ۳: چهار ماده و یک کیسه چای",
      "prompt": "دو شکل کلاژن و ویژگی‌هایشان کدام‌اند؟",
      "content": [
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو شکل کلاژن و ویژگی‌هایشان کدام‌اند؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
