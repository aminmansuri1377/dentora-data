{
  "url": "https://app.dentigoapp.com/fa/lesson/1431",
  "title": "مرور یونیت: سوزن کجا برود",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "آنچه در این یونیت ساختی"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چهار درس این یونیت یک منطق مشترک داشتند:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " هر تزریق موفق، مجموعه‌ای از اعداد و لندمارک‌های مشخص است، نه یک حس کلی."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اعدادی که باید با تو بمانند:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " بلاک آلوئولار تحتانی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲۰ تا ۲۵ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۶ تا ۱۰ میلی‌متر بالای صفحه‌ی اکلوزال"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه‌چهارم فاصله"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، PSA "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۶ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " با "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن کوتاه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، اینفرااربیتال "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۶ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، پالاتین بزرگ و نازوپالاتین هر دو حدود "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۵ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و سه ارتفاع روی یک مسیر:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " ویزیرانی-آکینوزی پایین‌تر از گاو-گیتس، و بالاتر از بلاک آلوئولار تحتانی."
            }
          ]
        }
      ]
    }
  ],
