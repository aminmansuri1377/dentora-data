                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انتخاب دارو درست بود ولی روش غلط؛ محلول ساده در انفیلتراسیون سریع شسته می‌شود و باید بلاک زده می‌شد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
