{
  "url": "https://app.dentigoapp.com/fa/lesson/1451",
  "title": "مرور یونیت: شدت، میزبان، ارجاع",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "آنچه در این یونیت ساختی"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه اصل نخست مدیریت عفونت اودنتوژنیک، یک زنجیره‌ی تصمیم می‌سازند:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " چقدر بد است؟ بدن بیمار چقدر می‌تواند کمک کند؟ و آیا این بیمار، بیمار من است؟"
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اعدادی که باید با تو بمانند:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " علائم پایدار بیش از "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳۰ روز"
                }
              ]
            },
            {
              "tag": "text",
              "text": " یعنی عفونت مزمنِ مهارشده، تریسموس با باز شدن بین‌دندانی کمتر از "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲۵ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " معیار ارجاع است، و دمای بالاتر از "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳۸٫۳ درجه"
                }
              ]
            },
            {
              "tag": "text",
              "text": " هم همین‌طور."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و سه قاعده‌ی مفهومی:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " در نهایت "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دفاع میزبان"
                }
              ]
            },
            {
              "tag": "text",
              "text": " است که عفونت را شکست می‌دهد، هایپرگلایسمی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کموتاکسی و فاگوسیتوز"
                }
              ]
            },
            {
              "tag": "text",
              "text": " را کاهش می‌دهد، و تصمیم محل درمان بر محل، شدت، دسترسی جراحی و وضعیت دفاع میزبان تکیه دارد."
            }
          ]
        }
      ]
    }
  ],
