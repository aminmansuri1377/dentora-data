{
  "url": "https://app.dentigoapp.com/fa/lesson/1326",
  "title": "درس ۵: مرور یونیت ۱",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "پیش از شروع مرور"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "این یونیت فهرست اسم نبود؛ فهرست "
            },
            {
              "tag": "em",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تمایز"
                }
              ]
            },
            {
              "tag": "text",
              "text": " بود. بیشتر خطاها با این ابزارها از جایی می‌آید که دو ابزار شبیه هم‌اند و کارشان یکی نیست."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جفت‌هایی که با هم اشتباه می‌شوند —"
                }
              ]
            },
            {
              "tag": "text",
              "text": " این فهرست را جدا نگه دار:"
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هموستات"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (شیار موازی) در برابر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیدل هولدر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (شبکه‌ی متقاطع، فک کوتاه‌تر و قوی‌تر) — هموستات هرگز بخیه نمی‌زند."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "الواتور پریوستئال Molt ۹"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (لبه‌ی تیز، پریوست را بلند می‌کند) در برابر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Henahan و Seldin"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (لبه‌ی صاف، فقط رترکتور)."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کورت پری‌اپیکال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در برابر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کورت پریودنتال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — طرح و کارکرد متفاوت."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قیچی بخیه (Dean)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در برابر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قیچی بافت (Iris و Metzenbaum)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — قیچی بافت نخ نمی‌برد."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Adson"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (ظریف، بافت ماندگار) در برابر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Allis"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (قفل‌دار و دندانه‌دار، فقط بافتی که برداشته می‌شود)."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۵۰ و 150A"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۵۱ و 151A"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — نسخه‌ی A فقط پرمولر است."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۷"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (نوک تیز، دوشاخگی) در برابر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۵۱"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (ریشه‌ی جوش‌خورده‌ی مخروطی)."
                }
              ]
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اعداد یونیت:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " تیغه‌ی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۵"
                }
              ]
            },
            {
              "tag": "text",
              "text": " پرکاربرد، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۱"
                }
              ]
            },
            {
              "tag": "text",
              "text": " برای درناژ آبسه، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۲"
                }
              ]
            },
            {
              "tag": "text",
              "text": " قلاب‌دار برای توبروزیته، الواتور پریوستئال "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "Molt شماره‌ی ۹"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، الواتور مستقیم کوچک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳۰۱"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، purchase point "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، پریوتوم هر بار "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲ تا ۳ میلی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، بورهای "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۵۵۷، ۷۰۳، راند ۸"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، نیدل هولدر "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۷ اینچ یا ۱۵ سانتی‌متر"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، سوزن را در "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دوسوم"
                }
              ]
            },
            {
              "tag": "text",
              "text": " فاصله از نوک بگیر، نخ مخاط دهان "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳-۰"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، سوزن شست‌وشو "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۸ گیج بلانت"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، Stillies "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۷ تا ۹ اینچ"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک خطر که فراموش نمی‌شود:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " هندپیسی که هوا را داخل میدان عمل خروج دهد به "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آمفیزم بافتی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " می‌انجامد. توربین ترمیمی در جراحی ممنوع."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سؤال‌های این مرور سخت‌ترند"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و بسیاری از آن‌ها دو ابزار را کنار هم می‌گذارند تا ببینند کدام را با کدام اشتباه می‌گیری."
            }
          ]
        }
      ]
    }
  ],
