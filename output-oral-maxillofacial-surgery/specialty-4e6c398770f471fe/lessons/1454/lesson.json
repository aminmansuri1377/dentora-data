      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اصل پنجم: پنج اقدام حمایتی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اصل پنجم مدیریت عفونت اودنتوژنیک: از بیمار حمایت پزشکی کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حمایت سیستمیک، جزئی جدایی‌ناپذیر از مدیریت عفونت‌های اودنتوژنیک است — چون همان‌طور که دیدی، در نهایت دفاع میزبان بیمار است که عفونت را شکست می‌دهد."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-16-12.webp",
                  "alt": "سرنگ نوک‌باریک برای شست‌وشوی کامل حفره‌ی آبسه",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/49e897fef33188ae12edf7466aa8e3fa3a387089ca0a9c588dc6d20224f395c2.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ نوک‌باریک برای شست‌وشوی کامل حفره‌ی آبسه "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Hupp, Ellis & Tucker. Contemporary OMFS, 7th ed. — Fig. 16.12)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و منطق زمانی‌اش این است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس از حذف منشأ عفونت و تخلیه‌ی آن، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بار باکتریایی کاهش می‌یابد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". حالا نقش درمانگر این است که توانایی بیمار در حذف عفونت باقی‌مانده را با ابزارهای حمایتی بهینه کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و پنج اقدام حمایتی عبارت‌اند از:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هیدراتاسیون"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بهبود تغذیه"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کنترل درد"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "درمان آنتی‌بیوتیکی کمکی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کنترل قند خون"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و توجه کن که آنتی‌بیوتیک، یکی از پنج اقدام "
                    },
                    {
                      "tag": "em",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حمایتی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نه درمان اصلی. این جایگاه‌گذاری، خودش بخشی از آموزش است."
                }
              ]
            }
          ]
        }
      ],
