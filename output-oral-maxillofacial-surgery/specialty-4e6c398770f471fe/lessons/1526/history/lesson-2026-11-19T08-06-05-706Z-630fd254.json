                      "tag": "text",
                      "text": "۰۳"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تجمع سرم زیر مخاط؛ بی‌اهمیت بالینی است، درمان نمی‌خواهد و اغلب ناپدید می‌شود"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
