{
  "url": "https://app.dentigoapp.com/fa/lesson/1441",
  "title": "مرور یونیت و پایان ماژول ۴",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "پایان ماژول درد و اضطراب"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ماژول چهارم را با مولکولی شروع کردی که کانال سدیم را می‌بندد، و اینجا با تیمی تمام می‌کنی که باید بداند در بحران چه کند."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اعداد این یونیت که باید با تو بمانند:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " تیتراسیون N₂O از "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲۰٪"
                }
              ]
            },
            {
              "tag": "text",
              "text": " شروع و در گام‌های "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو دقیقه‌ای"
                }
              ]
            },
            {
              "tag": "text",
              "text": " پیش می‌رود، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳۰٪"
                }
              ]
            },
            {
              "tag": "text",
              "text": " نقطه‌ی تصمیم اصلی، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲۵٪"
                }
              ]
            },
            {
              "tag": "text",
              "text": " گام پایین برای اثر منفی، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳۵٪"
                }
              ]
            },
            {
              "tag": "text",
              "text": " گام بالا، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بالای ۴۰٪"
                }
              ]
            },
            {
              "tag": "text",
              "text": " پایش حال‌وهوا، و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بالای ۵۰٪"
                }
              ]
            },
            {
              "tag": "text",
              "text": " پرهیز."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و مهم‌ترین قاعده‌ی مفهومی این یونیت:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " بی‌حسی را با "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محرک دردناک"
                }
              ]
            },
            {
              "tag": "text",
              "text": " بیازما، نه با پرسیدن از بیمار — چون "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حس عمقی با بی‌حسی موضعی از بین نمی‌رود"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        }
      ]
    }
  ],
