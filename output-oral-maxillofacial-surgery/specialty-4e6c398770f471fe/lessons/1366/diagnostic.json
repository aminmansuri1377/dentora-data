{
  "url": "https://app.dentigoapp.com/fa/lesson/1366",
  "title": "درس ۵: مرور یونیت ۶",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "پیش از شروع مرور"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این یونیت سه سیستم طبقه‌بندی دارد و همه‌شان به یک سؤال جواب می‌دهند:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " چقدر دسترسی داری؟"
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چهار زاویه —"
                }
              ]
            },
            {
              "tag": "text",
              "text": " درصد، ترتیب سختی، و ویژگی شاخص:"
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مزیوانگولار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴۳٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آسان‌ترین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (به‌ویژه نیمه‌نهفته)، تاج به سمت مزیال و مولر دوم تیلت دارد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شایع‌ترین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمودی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۸٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سومین از نظر سهولت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، موازی مولر دوم، اغلب سطح خلفی‌اش با استخوان راموس قدامی پوشیده است، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دومین شایع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیستوانگولار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دشوارترین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، مسیر خروجش به راموس می‌رود، سطح اکلوزالش معمولاً درون راموس مدفون است."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افقی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دومین از نظر سهولت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، عمود بر مولر دوم، سطح اکلوزالش بلافاصله مجاور ریشه‌ی مولر دوم است و بیماری پریودنتال شدید زودرس می‌سازد."
                }
              ]
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباه رایج شماره‌ی یک:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " ترتیب شیوع با ترتیب سختی یکی نیست. شیوع: مزیوانگولار ۴۳ ← عمودی ۳۸ ← دیستوانگولار ۶ ← افقی ۳. سختی از آسان به سخت: مزیوانگولار ← افقی ← عمودی ← دیستوانگولار. یعنی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "افقی با کمترین شیوع، دومین آسان است"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عمودی با دومین شیوع، سومین آسان"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو طبقه‌بندی Pell و Gregory:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " کلاس ۱، ۲، ۳ = رابطه با "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لبه‌ی قدامی راموس"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (کاملاً جلوتر، تقریباً نیمی پوشیده، کاملاً درون راموس)، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلاس A، B، C"
                }
              ]
            },
            {
              "tag": "text",
              "text": " = رابطه با "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پلن اکلوزال"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (هم‌تراز پلن اکلوزال، میان پلن اکلوزال و خط سرویکال، پایین‌تر از خط سرویکال)."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه ترکیب مرجع: مزیوانگولار + ۱ + A"
                }
              ]
            },
            {
              "tag": "text",
              "text": " = آسان‌ترین، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "افقی + ۲ + B"
                }
              ]
            },
            {
              "tag": "text",
              "text": " = متوسط، که بیشتر دندانپزشکان عمومی باتجربه تمایلی به انجامش ندارند، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دیستوانگولار + ۳ + C"
                }
              ]
            },
            {
              "tag": "text",
              "text": " = دشوارترین، که حتی متخصصان هم آن را چالش می‌دانند."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "طبقه‌بندی بافت پوشاننده (بیمه): بافت نرم"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (ارتفاع کانتور بالاتر از استخوان؛ فقط برش و رفلکشن)، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نیمه‌استخوانی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (بخشی از ارتفاع کانتور زیر استخوان؛ برش، رفلکشن، و برداشت استخوان بالای ارتفاع کانتور)، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کاملاً استخوانی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (پس از رفلکشن فلپ اصلاً دیده نمی‌شود؛ برداشت زیاد استخوان و تقریباً همیشه سکشن)."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباه رایج شماره‌ی دو:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " نهفتگی نیمه‌استخوانی معمولاً دشوارتر از کاملاً استخوانی است. و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباه رایج شماره‌ی سه:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " این طبقه‌بندی اغلب هیچ ارتباطی با سختی کشیدن یا احتمال عوارض ندارد — پرکاربردترین سیستم، کم‌ربط‌ترین سیستم است."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و فهرست بیست‌ودو عاملی:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " یازده عامل آسان‌کننده و یازده عامل دشوارکننده. نکته‌ی ساختاری‌شان مهم‌تر از فهرستشان است: "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پنج عامل آسان‌کننده در بیمار جوان حاضرند"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (ریشه‌ی یک‌سوم تا دوسوم، رباط پهن، فولیکول بزرگ، استخوان کشسان، جدایی از عصب) و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چهار عامل دشوارکننده در بیمار مسن"
                }
              ]
            },
            {
              "tag": "text",
              "text": " (ریشه‌ی بلند و نازک، فولیکول نازک، استخوان متراکم، نهفتگی کاملاً استخوانی). یعنی سن، اثرگذارترین متغیر منفرد در پیش‌بینی سختی است."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و اعداد و مرزهای دیگر:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " کلیشه‌ی انتخابی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پانورامیک"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، پری‌اپیکال کافی است اگر "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همه‌ی بخش‌های دندان و آناتومی مجاور"
                }
              ]
            },
            {
              "tag": "text",
              "text": " دیده شوند، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "CBCT"
                }
              ]
            },
            {
              "tag": "text",
              "text": " وقتی ریشه‌ها روی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کانال آلوئولار تحتانی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " سوپرایمپوز شوند، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رادیوگرافی اکلوزال عمود یا CBCT"
                }
              ]
            },
            {
              "tag": "text",
              "text": " برای تعیین ورژن باکال یا لینگوال در نهفتگی ترنسورس — که "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "معمولاً لازم نیست"
                }
              ]
            },
            {
              "tag": "text",
              "text": ". و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رویکرد باکال"
                }
              ]
            },
            {
              "tag": "text",
              "text": " حتی در دندان متمایل به لینگوال، به دلیل احتمال "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عصب لینگوال بالانشسته"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        }
      ]
    }
  ],
