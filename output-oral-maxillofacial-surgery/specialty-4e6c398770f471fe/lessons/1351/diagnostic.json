{
  "url": "https://app.dentigoapp.com/fa/lesson/1351",
  "title": "درس ۵: مرور یونیت ۴",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "پیش از شروع مرور"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این یونیت دو موضوع را در درس‌ها جا نداد و در همین مرور می‌آیند:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " پیگیری پس از عمل، و گزارش عمل."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیگیری پس از عمل"
                }
              ]
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هر بیماری که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جراح کم‌تجربه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ویزیت می‌کند باید نوبت مراجعه‌ی مجدد بگیرد، تا جراح هم پیشرفت بیمار را ببیند و هم ظاهر ساکتی که به‌طور طبیعی التیام می‌یابد را یاد بگیرد."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در اعمال معمول و بدون عارضه، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک ویزیت پیگیری در یک هفته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " معمولاً کافی است، و بخیه‌ها در همان جلسه در صورت نیاز کشیده می‌شوند."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه دلیل محتمل برای ویزیت زودتر:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خون‌ریزی طولانی، دردی که به داروی تجویزشده پاسخ نمی‌دهد، شک به عفونت."
                }
              ]
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "warning"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو الگوی افتراقی که باید بی‌درنگ تشخیص داده شوند:"
                }
              ]
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر بیمار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در روز سوم پس از عمل یا بعد از آن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دچار تورم همراه با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قرمزی سطحی، تب، درد یا همه‌ی این‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شود، تا خلاف آن ثابت نشده باید فرض کرد عفونت دارد. بیمار باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فوراً"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با مطب تماس بگیرد و جراح او را با دقت معاینه کند."
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دراسکت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دردی که اول کم می‌شود ولی از روز سوم یا چهارم شروع به افزایش می‌کند، بدون همراهی تورم یا سایر نشانه‌های عفونت، احتمالاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دراسکت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. معمولاً به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساکت مولرهای پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " محدود است و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". مدیریتش سرراست است ولی ممکن است چند بار مراجعه لازم شود."
                }
              ]
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گزارش عمل — یازده جزء:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " تاریخ، نام و مشخصات بیمار، تشخیص مشکلی که جراحی می‌شود، مرور تاریخچه‌ی پزشکی، داروها و علائم حیاتی، معاینه‌ی دهان، بی‌حسی (مقدار مصرف‌شده)، شرح عمل شامل توصیف جراحی و عوارض، دستورات ترخیص، داروهای تجویزشده و مقدارشان (یا پیوست کردن رونوشت نسخه)، نیاز به ویزیت پیگیری، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "امضا (خوانا یا با نام چاپی زیر آن)"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جزئیات مهم:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " در ثبت بی‌حسی، مثلاً اگر لیدوکائین با وازوکنستریکتور به کار رفته، دوز لیدوکائین و اپی‌نفرین هر دو بر حسب میلی‌گرم نوشته می‌شود. و در ثبت الکترونیک، هرچند فیلدهای آماده وجود دارد، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همان الزامات مستندسازی همچنان برقرارند"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و فقط شکل ثبتشان بسته به نرم‌افزار فرق می‌کند."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیشگیری از عوارض — چهار ستون:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " ۱) "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مرور کامل تاریخچه‌ی پزشکی"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، چون چند عارضه از بی‌توجهی به همین ناشی می‌شوند، ۲) "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تصویربرداری کافی و مرور دقیق آن"
                }
              ]
            },
            {
              "tag": "text",
              "text": " — کلیشه باید کل ناحیه‌ی جراحی از جمله "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آپکس ریشه‌ها"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و ساختارهای آناتومیک موضعی و ناحیه‌ای مثل بخش‌های مجاور سینوس ماگزیلا یا کانال آلوئولار تحتانی را نشان دهد، و جراح باید دنبال مورفولوژی غیرطبیعی ریشه یا نشانه‌های آنکیلوز بگردد، ۳) "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برنامه‌ریزی پیش از عمل"
                }
              ]
            },
            {
              "tag": "text",
              "text": " که نه فقط طرح جراحی و ابزار، بلکه طرح مدیریت درد و اضطراب و بهبودی پس از عمل را هم شامل شود، ۴) "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پایبندی به اصول پایه‌ی جراحی"
                }
              ]
            },
            {
              "tag": "text",
              "text": ": دید و دسترسی روشن (نور کافی، رترکشن و رفلکشن کافی بافت نرم شامل لب و گونه و زبان و فلپ، و ساکشن کافی) و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مسیر بدون مانع برای خروج دندان"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {
            "tone": "note"
          },
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک اصل حرفه‌ای:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " ارجاع به متخصص همیشه یک گزینه است و هر وقت جراحی برنامه‌ریزی‌شده فراتر از سطح مهارت خود دندانپزشک باشد باید به کار گرفته شود — که نه‌فقط یک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تعهد اخلاقی"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، بلکه "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مدیریت هوشمندانه‌ی ریسک حقوقی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و مایه‌ی آرامش خاطر است."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همه‌ی زمان‌بندی‌های این یونیت در یک نگاه:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " گاز اول "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳۰ دقیقه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، گاز دوم تا "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱ ساعت"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، کیسه‌ی چای "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳۰ دقیقه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، نشت طبیعی تا "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲۴ ساعت"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، بدون تف کردن "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۲ ساعت"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، بدون ورزش سنگین "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۲ تا ۲۴ ساعت"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، اوج درد "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۲ ساعت"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، درد به‌ندرت بیش از "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲ روز"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، اثر کامل مسکن "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۶۰ تا ۹۰ دقیقه"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، مسکن معمولاً "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲ تا ۳ روز"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، مایعات "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲ لیتر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " در ۲۴ ساعت اول، غذای نرم و خنک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۱۲ ساعت"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، اوج ادم "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳۶ تا ۴۸ ساعت"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، یخ ۲۰ دقیقه روی ناحیه، ۲۰ دقیقه بیرون، در ۱۲ تا ۲۴ ساعت، گرما "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "از روز سوم"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، تریسموس "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ظرف یک هفته"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، اکیموز شروع "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۲ تا ۴ روز"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و رفع "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۷ تا ۱۰ روز"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، دهان‌شویه‌ی آب اکسیژنه "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۳ تا ۴ بار در روز، یک هفته"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، پیگیری "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک هفته"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        }
      ]
    }
  ],
