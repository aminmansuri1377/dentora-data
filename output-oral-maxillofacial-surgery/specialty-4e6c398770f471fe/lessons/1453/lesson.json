            {
              "tag": "text",
              "text": "سه هدف تخلیه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بگذار روشن بگوییم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باید فهمید که هدف تخلیه‌ی جراحی صرفاً «برداشتن چرک» نیست."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/surg-fig-16-11.webp",
