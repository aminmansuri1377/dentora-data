                  "children": [
                    {
                      "tag": "text",
                      "text": "تنها از کف ساکت و نه از دیواره‌ها؛ و به تعویق می‌افتد وقتی بیمار داروی ضدانعقاد مصرف می‌کند"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
