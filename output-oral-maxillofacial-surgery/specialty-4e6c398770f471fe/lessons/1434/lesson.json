  "steps": [
    {
      "id": "theory:b54a1541f22f65a33f4b56289b3458459df7a19955436dabd4e0fba4aa56384a",
      "position": 1,
      "kind": "theory",
      "sourceQuestionId": null,
      "sourceStepId": null,
      "sourceProgress": "width: 0%;",
      "questionType": "unknown",
      "title": "درس ۳: لبی که بیمار می‌جود",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "یک علت ساده که همه‌چیز را توضیح می‌دهد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترومای خودزده به لب و زبان اغلب به این علت رخ می‌دهد که بیمار ندانسته این بافت‌ها را گاز می‌گیرد یا می‌جود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و علت اصلی، یک واقعیت فارماکولوژیک ساده است که در یونیت اول همین ماژول دیدی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بی‌حسی بافت نرم به‌طور قابل‌توجهی طولانی‌تر از بی‌حسی پالپی دوام می‌آورد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یعنی وقتی کار دندان تمام شده و دندان دیگر بی‌حس نیست، لب و زبان همچنان بی‌حس‌اند — و بیمار حسی ندارد که به او بگوید دارد بافت خودش را می‌جود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و گروه‌های پرخطر: کودکان کم‌سن‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، کودکان یا بزرگسالان با ناتوانی ذهنی یا جسمی، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سالمندان بسیار مسن (بالای ۸۵ سال)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". با این حال یادت باشد که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این عارضه در بیماران هر سنی رخ می‌دهد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پس پیشگیری از این عارضه به تکنیک تزریق ربطی ندارد و به دو چیز بستگی دارد: انتخاب داروی متناسب با طول کار (اسلاید بعد)، و هشدار روشن پیش از ترخیص به بیمار و همراهش که بی‌حسی لب چند ساعت بیشتر می‌ماند. در کودک می‌توانی رول پنبه‌ای را که با نخ دندان مهار شده، بین لب و دندان‌ها بگذاری."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:0c12fbc2904abe1abd3daf065a8213a6b3ce2268433c9f6a22af8a68c07cfcc5",
      "position": 2,
      "kind": "theory",
      "sourceQuestionId": null,
      "sourceStepId": null,
      "sourceProgress": "width: 14.2857%;",
      "questionType": "unknown",
      "title": "درس ۳: لبی که بیمار می‌جود",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "انتخاب دارو، یک تصمیم پیشگیرانه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حالا آنچه در یونیت فارماکولوژی یاد گرفتی، اینجا به یک تصمیم بالینی تبدیل می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "برای کودک کم‌سن که تنها یک ترمیم کوچک نیاز دارد، انتخاب داروی طولانی‌اثر یک اشتباه است. بی‌حسی بافت نرمی که ساعت‌ها می‌ماند، در کودکی که کنترل رفتاری کاملی ندارد، مستقیماً به گاز گرفتن لب می‌انجامد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و برعکس:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در جراحی دشواری که انتظار درد شدید پس از عمل داری، همان طول اثر یک مزیت است — به شرط آنکه بیمار بزرگسال و آگاه باشد و به او هشدار داده باشی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یعنی همان ویژگی دارو، در یک بیمار مزیت و در بیمار دیگر خطر است —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و این تفاوت را تو تعیین می‌کنی، نه دارو."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک قاعده‌ی کاربردی برای ترخیص:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به بیمار یا همراهش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک زمان مشخص"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بگو، نه «چند ساعت». و اگر کودک است، به والد بگو تا آن ساعت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غذای جویدنی ندهد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
