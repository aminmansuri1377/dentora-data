{
  "url": "https://app.dentigoapp.com/fa/lesson/971",
  "title": "درس ۴: تحلیل سرویکال خارجی",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "دو عددی که باید حفظ کنی"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تحلیل سرویکال خارجی، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عارضه‌ی جدی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " سفیدکردن با ترکیبات پراکسیدی است."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "با پراکسید هیدروژن "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سی‌وپنج درصد"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، در "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "شش تا هشت درصد"
                }
              ]
            },
            {
              "tag": "text",
              "text": " موارد دیده شده است."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "و اگر همان پراکسید "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "با حرارت فعال"
                }
              ]
            },
            {
              "tag": "text",
              "text": " شود، این رقم به "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هجده تا بیست‌وپنج درصد"
                }
              ]
            },
            {
              "tag": "text",
              "text": " می‌رسد — یعنی حدود سه برابر."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پس فعال‌سازی حرارتی، تنها یک «تسریع» نیست؛ یک تغییر جدی در پروفایل خطر است."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "و دو گروه بیشتر در معرض‌اند: کسانی که در "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سن پایین"
                }
              ]
            },
            {
              "tag": "text",
              "text": " بلیچ شده‌اند، و کسانی با سابقه‌ی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ضربه"
                }
              ]
            },
            {
              "tag": "text",
              "text": " — هر دو وضعیتی که در آن‌ها لایه‌ی سمان یا لیگامان پریودنتال از پیش آسیب دیده است."
            }
          ]
        },
