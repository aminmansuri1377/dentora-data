                  "children": []
                },
                {
                  "tag": "text",
                  "attributes": {
                    "fill": "currentColor",
                    "x": "430",
                    "y": "264"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "ابرکشسانی، معاوضه‌ی قدیمی را شکست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "attributes": {
                    "fill": "currentColor",
                    "x": "430",
                    "y": "284"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "تیپر بیشتر، بدون از دست دادن انعطاف لازم برای انحنا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "attributes": {
                    "fill": "currentColor",
                    "x": "430",
                    "y": "322"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "تیپر استاندارد فولاد صدم‌دو، تیپرهای رایج نیکل‌تیتانیوم صدم‌چهار و صدم‌شش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "attributes": {
                    "fill": "currentColor",
                    "x": "430",
                    "y": "352"
                  },
                  "children": [
                    {
                      "tag": "text",
                      "text": "و تیپر بیشتر یعنی شکل پیوسته‌تر، با ابزار کمتر، در زمان کوتاه‌تر"
                    }
                  ]
                }
              ]
            },
