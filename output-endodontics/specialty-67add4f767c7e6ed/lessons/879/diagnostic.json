{
  "url": "https://app.dentigoapp.com/fa/lesson/879",
  "title": "درس ۱: از فولاد تا نیکل‌تیتانیوم",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "سه نسل، سه محدودیت"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فولاد کربنی قدرت داشت اما "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "انعطاف کمی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " داشت و با استریلیزاسیون تخریب می‌شد."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فولاد ضدزنگ"
                }
              ]
            },
            {
              "tag": "text",
              "text": " جایگزینش شد: قدرت، انعطاف بهتر نسبت به فولاد کربنی، و تحمل حرارت."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "و سپس "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نیکل‌تیتانیوم"
                }
              ]
            },
            {
              "tag": "text",
              "text": " آمد، با دو ویژگی که همه چیز را عوض کرد: "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "انعطاف‌پذیری"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مقاومت در برابر خستگی سیکلی"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "همین مقاومت در برابر خستگی سیکلی است که اجازه می‌دهد این ابزار در "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هندپیس روتاری"
                }
              ]
            },
            {
              "tag": "text",
              "text": " به کار رود — و این برتری اصلی آن بر فولاد ضدزنگ است. نیکل‌تیتانیوم شکل‌دهی بهتری نسبت به ابزار دستی فولادی نشان داده است."
            }
          ]
        },
        {
          "tag": "figure",
          "attributes": {},
          "children": [
            {
