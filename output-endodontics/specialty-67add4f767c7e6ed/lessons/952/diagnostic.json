{
  "url": "https://app.dentigoapp.com/fa/lesson/952",
  "title": "درس ۴: معیار کیفیت و طول پرکردن",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "سه چیزی که در رادیوگرافی می‌سنجی"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پرکردن در عمل با رادیوگرافی پری‌اپیکال ارزیابی می‌شود و سه چیز سنجیده می‌شود: "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "طول"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تیپر"
                }
              ]
            },
            {
              "tag": "text",
              "text": " و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تراکم"
                }
              ]
            },
            {
              "tag": "text",
              "text": "."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "نشانه‌های خطا هم روشن‌اند: پرکردن کوتاه‌تر یا فراتر از طول کار، و "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حفره"
                }
              ]
            },
            {
              "tag": "text",
              "text": " در توده‌ی پرکردن."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "و یک محدودیت که باید بدانی: "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "CBCT معمولاً برای دیدن حفره‌ها مفید نیست"
                }
              ]
            },
            {
              "tag": "text",
              "text": "، چون خود مواد پرکردن پراکندگی تصویر می‌سازند."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اما همان تصویر می‌تواند چیز دیگری را نشان دهد — کانالی که "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جا مانده"
                }
              ]
            },
            {
              "tag": "text",
              "text": " یا "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جابه‌جا"
                }
              ]
            },
            {
              "tag": "text",
              "text": " شده است."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "و در دندانی که پیش‌تر درمان شده، تصویر "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نوع ماده‌ی به‌کاررفته"
                }
              ]
            },
            {
              "tag": "text",
              "text": " را هم لو می‌دهد؛ کن نقره ظاهر رادیوگرافیک متفاوتی از گوتاپرکا دارد."
            }
          ]
        },
        {
          "tag": "figure",
          "attributes": {},
          "children": [
