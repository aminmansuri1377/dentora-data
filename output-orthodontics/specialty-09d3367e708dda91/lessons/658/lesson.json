      "title": "درس ۴: پروتکل و طول مدت ریتنشن",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "وقتی عود رخ داد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از هر اقدامی، سه پرسش:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱. چه مقدار؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تغییر جزئی که بیمار متوجهش نشده، با تغییری که شکایت اصلی اوست فرق دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲. چرا؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ریتینر شکسته یا استفاده نشده؟ عادتی که هنوز ادامه دارد؟ یا رشد؟ بدون پاسخ به این، درمان مجدد هم عود می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳. بیمار چه می‌خواهد؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برخی تنها اطمینان می‌خواهند، برخی اصلاح."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گزینه‌ها از سبک به سنگین: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پذیرش و ریتنشن محکم‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان محدود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با الاینر یا مکانیک سگمنتال، و در نهایت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان مجدد جامع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
