                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "دوره"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "چه کاری آن‌جا بهتر انجام می‌شود"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "دنتیشن شیری"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "قطع عادت، کراس‌بایت قدامی ساده"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "دنتیشن مختلط"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کراس‌بایت با شیفت، اصلاح ارتوپدیک، مدیریت فضا، کانین نهفته"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "دنتیشن دائمی"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "درمان جامع ثابت، کاموفلاژ، جراحی"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ برخی مداخلات پنجره دارند و اگر از دست بروند، دیگر تکرار نمی‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه پنجره‌ی تکرارناپذیر که بیش از همه از دست می‌روند: "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای لی‌وی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که با مهاجرت مولر بلعیده می‌شود، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مداخله‌ی زودهنگام کانین نهفته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که پس از رویش بی‌معنا می‌شود، و "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اصلاح ارتوپدیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که با مهار رشد بسته می‌گردد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و در مقابل، بسیاری از مشکلات اکلوزال هیچ پنجره‌ای ندارند و در هر سنی قابل درمان‌اند — تفکیک این دو دسته، هسته‌ی تصمیم زمان‌بندی است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
