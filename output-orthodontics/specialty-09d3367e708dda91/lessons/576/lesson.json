                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": ارزیابی پلاک و التهاب لثه، و ثبت آن در پرونده. ثبت کردن، هم روند را نشان می‌دهد و هم گفت‌وگو با بیمار و والدین را ممکن می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اگر لکه‌ی سفید ظاهر شد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": تشدید فلوراید، بازآموزی بهداشت، و در موارد شدید و پیش‌رونده، "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دیباند زودهنگام"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
