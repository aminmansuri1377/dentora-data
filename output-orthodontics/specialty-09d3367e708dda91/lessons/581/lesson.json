          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "الاستیک بین‌فکی ساده و مؤثر است، اما همیشه اثر عمودی هم دارد — و همان اثر عمودی است که گاهی نتیجه را خراب می‌کند."
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "نوع"
