                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نتیجه‌اش دو چیز هم‌زمان است: استخوان "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بزرگ‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شود و به سمت "
