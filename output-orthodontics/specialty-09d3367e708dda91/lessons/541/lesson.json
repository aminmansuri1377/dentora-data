                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ قانون طلایی ثبات: فرم قوس "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اولیه‌ی بیمار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را حفظ کن. تحمیل قوس مربعی به بیماری با قوس مخروطی، زمینه‌ی عود را می‌چیند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا؟ چون فرم قوس بازتاب تعادل نیروهای عضلانی همان بیمار است. تغییر آن یعنی بردن دندان‌ها بیرون از منطقه‌ی تعادل — و آن‌جا، لب و زبان هر روز کار می‌کنند تا برشان گردانند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کاربرد عملی: آرچ‌وایرهای آماده در سه فرم عرضه می‌شوند. فرم را از روی مدل اولیه‌ی بیمار انتخاب کن، نه از روی آنچه در جعبه هست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر فرم دو قوس در شروع درمان با هم نمی‌خواند، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرم قوس پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مبناست — چون قوس پایین محدودتر است — و قوس بالا با آن هماهنگ می‌شود؛ مگر آنکه قوس پایین خودش، مثلاً با فشار لب یا عادت، تغییر شکل داده باشد."
                }
              ]
            }
          ]
        }
