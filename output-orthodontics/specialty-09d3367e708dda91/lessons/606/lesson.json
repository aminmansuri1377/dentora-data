                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در موارد شدید، "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
