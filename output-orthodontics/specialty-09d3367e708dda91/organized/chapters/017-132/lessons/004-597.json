      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سقف بیومکانیکی دستگاه متحرک"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دستگاه متحرک نیرو را از "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک نقطه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به تاج وارد می‌کند. چون نمی‌تواند کوپل بسازد، حرکت غالب آن همیشه "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تیپینگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است — و این یک محدودیت فیزیکی است، نه نقص طراحی."
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "می‌تواند"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "نمی‌تواند"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تیپینگ دندان"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "حرکت بدنه‌ای کنترل‌شده"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اکسپنشن دنتوآلوئولار"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تورک ریشه"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "حرکت‌های تک‌دندانی ساده"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "روتیشن دقیق"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "باز کردن بایت با بایت پلن"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اصلاح مال‌اکلوژن اسکلتی"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همه‌ی کارهایی که دستگاه متحرک نمی‌تواند، یک وجه مشترک دارند: به کوپل نیاز دارند. تورک، حرکت بدنه‌ای و روتیشن دقیق، بدون درگیری دو نقطه‌ای ممکن نیستند — و درگیری دو نقطه‌ای فقط با براکت و سیم مستطیلی به دست می‌آید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ اصرار بر انجام کاری خارج از این سقف، نتیجه‌ای جز درمان طولانی و نتیجه‌ی ناقص ندارد. شناختن مرز ابزار، بخشی از مهارت بالینی است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5d9b5e5deba48747da6b56ce5827e92214ae8a7ba8c6f6a6f357bf88c1c2b4eb",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "22604d64c689ff8231eef226135545e876a608d25c1e4e3d9f106fb965b6ce55",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پنج خطای رایج"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پنج خطایی که بیشترین شکست‌های دستگاه متحرک را می‌سازند:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کلاسپ روی دندان هدف"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — همان دندانی که باید حرکت کند، قفل شده است"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فعال‌سازی افراطی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — دستگاه می‌افتد و ساعات مؤثر استفاده کم می‌شود"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فراموش کردن بایت پلن در جایی که لازم است"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — با اوربایت عمیق، دندان زیر قفل اکلوزالی می‌ماند و حرکت نمی‌کند"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نادیده گرفتن انکوریج"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — دندان‌های پشتیبان به‌جای دندان هدف جابه‌جا می‌شوند"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "انتخاب دستگاه متحرک برای مسئله‌ی اسکلتی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — انتظار نادرست از ابزار"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 چهار مورد نخست قابل اصلاح‌اند: کلاسپ را جابه‌جا کن، نیرو را کم کن، بایت پلن اضافه کن، انکوریج را تقویت کن. اما مورد پنجم یعنی طرح درمان از پایه اشتباه بوده و دستگاه جدید هم نجاتش نمی‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 به همین دلیل تشخیص افتراقی دندانی از اسکلتی، پیش از انتخاب هر دستگاهی انجام می‌شود — نه پس از شکست آن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:7d9767f727eded88c1225fd7f2f858a3d0fa8971dcae52a998a256a681b17bc0",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "b1a374ebfa3892c2e141d1304dd03c1cca2806f0f8341838bb62126c625d532b",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "وقتی درمان پیش نمی‌رود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی پس از چند ویزیت هیچ حرکتی دیده نمی‌شود، به‌جای افزایش نیرو، این پنج مورد را به‌ترتیب رد کن — از محتمل‌ترین به کم‌احتمال‌ترین:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "همکاری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": دستگاه در ویزیت تنگ است؟ اگر بیمار برای جا زدنش زحمت می‌کشد، یعنی استفاده نشده. این شایع‌ترین علت است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مانع اکلوزالی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": آیا اکلوژن حرکت را قفل کرده؟ با کاغذ اکلوزال بررسی کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گیر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کلاسپ‌ها شل شده‌اند؟ دستگاهی که شل است، در دهان جابه‌جا می‌شود و نیرو به جای درست نمی‌رسد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جزء فعال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": فنر تغییر شکل داده یا جهتش غلط است؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عوامل بیمار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": آنکیلوز، دندان نهفته، یا مانع آناتومیک."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 ترتیب اهمیت دارد. اگر مورد اول را بررسی نکنی و مستقیم نیرو را زیاد کنی، هم مشکل حل نمی‌شود و هم دستگاه بیشتر می‌افتد — یعنی وضعیت را بدتر کرده‌ای."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 تست ساده‌ی همکاری: از بیمار بخواه دستگاه را جلوی تو در دهان بگذارد. کسی که هر شب استفاده می‌کند، این کار را در چند ثانیه و بدون نگاه کردن انجام می‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
