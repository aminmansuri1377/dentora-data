                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": استخوان "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساخته"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌شود، با استئوبلاست"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس دندان حرکت نمی‌کند مگر آنکه استخوان جلوی راهش برداشته شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این جمله‌ی ساده، سه پیامد بزرگ دارد که در کل ماژول تکرار می‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱، "
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سرعت حرکت را "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زیست‌شناسی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تعیین می‌کند، نه مقدار نیرو. "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲، "
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندانی که PDL ندارد — آنکیلوزه یا ایمپلنت — اصلاً حرکت نمی‌کند. "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳، "
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در بافتی که از پیش ملتهب است، همین ریمادلینگ به سمت تخریب می‌چرخد."
                }
              ]
            }
          ]
        }
