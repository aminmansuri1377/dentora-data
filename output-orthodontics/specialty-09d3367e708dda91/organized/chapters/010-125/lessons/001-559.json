                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فشار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": استخوان "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "برداشته"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌شود، با استئوکلاست"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سمت "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کشش"
