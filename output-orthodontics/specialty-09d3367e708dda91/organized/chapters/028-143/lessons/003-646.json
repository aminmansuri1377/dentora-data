  "steps": [
    {
      "id": "theory:b2f475bb6ca03ebd5785df1108aae4273fc3c3298d6e89526b58587256571207",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "72537063f92e0cb9c6a6d0b298103b6ea7dc175449f5e3047d10a4c24a164da1",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بی‌دندانی مادرزادی: الگو و شیوع"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس از مولر سوم، شایع‌ترین دندان‌های غایب مادرزادی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرمولر دوم پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لترال بالا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هستند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه اصطلاح را از هم جدا کن: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیپودنشیا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای غیبت چند دندان، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اولیگودنشیا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای شش دندان یا بیشتر، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنودنشیا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای غیبت کامل که بسیار نادر است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "غیبت گسترده اغلب با سندرم‌هایی مانند دیسپلازی اکتودرمال همراه است و ارزیابی سیستمیک می‌خواهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بیمار با لترال غایب یک‌طرفه، سمت مقابل را هم نگاه کن: اغلب لترال میخی‌شکل است — همان اختلال با شدت کمتر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:594a8abadac2c1ecc347548cd04d34d4d55c7c7ae0060786b16edb1db3a64fff",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "89b96b4014e66279da999092d4302b37866fc57ad6f1c1ddc810b8e589913bb7",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بستن فضا یا باز کردن فضا؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در لترال غایب، تصمیم از تلاقی چند یافته می‌آید:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به سود بستن فضا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کمبود فضا در قوس، پروفایل صاف یا کمی محدب که جلو آمدن سگمنت خلفی را تحمل می‌کند، و کانین روشن و پهن که جایگزین خوبی می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به سود باز کردن فضا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضای کافی یا مازاد، پروفایل مقعر یا رتروزیو، و کانین تیره و نوک‌تیز."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر فضا را ببندی، کانین باید با تراش و ترمیم به شکل لترال در بیاید و تورک و ارتفاع لثه‌ای‌اش تنظیم شود — این یک تصمیم مشترک با ترمیمی است، نه یک حرکت صرفاً ارتودنتیک."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:104cb4dcaa38b38ed0e0bad7037aca3865837cf774a2febbfd56e8a2f33c0444",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "197ca09b6d128f97f9c828d53468ae5b8f7b16a1be23317234883e8549c0f90d",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "نکته‌ی بالینی: مولر دوم شیری بدون جانشین"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بیمار با پرمولر دوم پایین غایب، مولر دوم شیری بالای آن جانشینی ندارد. سرنوشتش چه می‌شود؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چون محرک تحلیل ریشه — یعنی فشار جوانه‌ی دائمی — وجود ندارد، ریشه‌ی شیری کند تحلیل می‌رود و دندان ممکن است سال‌ها، گاهی تا دهه‌ی سوم زندگی یا بیشتر، بماند. اما گاهی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنکیلوز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شود و در حالی که آلوئول رشد می‌کند، پایین‌تر از سطح اکلوزال جا می‌ماند (اینفرااکلوژن)."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو مسیر پیش رو است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفظ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان شیری در بیمار با اکلوژن قابل قبول و بدون کراودینگ، تا زمانی که اینفرااکلوژن جدی نشده — گاهی با کم کردن عرض مزیودیستالی آن — یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کشیدن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و بستن فضا با ارتودنسی، که در بیمار با کراودینگ یا پروفایل برجسته گزینه‌ی جذابی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر تصمیم به حفظ گرفتی، هر سال ارتفاع اکلوزال آن را بسنج."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
