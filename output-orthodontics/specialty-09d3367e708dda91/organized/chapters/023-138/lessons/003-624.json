      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دستگاه فانکشنال چه می‌کند؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دستگاه فانکشنال مندیبل را در موقعیت "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جلوتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نگه می‌دارد. این جابه‌جایی، کشش عضلات و بافت نرم را تغییر می‌دهد و به سه دسته اثر می‌انجامد:"
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اثر"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سهم"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "دندانی"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": ": پروکلاین شدن ثنایای پایین، رتروکلاین شدن ثنایای بالا، حرکت مزیالی مولر پایین"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سهم بزرگ‌تر"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "اسکلتی"
                                }
                              ]
                            },
                            {
                              "tag": "text",
                              "text": ": افزایش طول مندیبل و بازسازی کندیل و فوسا"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سهم واقعی اما محدودتر"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ بخش زیادی از کاهش اورجت در این دستگاه‌ها، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است نه اسکلتی — این را در توضیح به والدین صادقانه بگو."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/BF-ORTHO-28.webp",
                  "alt": "اپلاینس Twin Block روی مدل‌های بالا و پایین",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/2f66aab765f04863fd5735dfa85637f66d2e0071cf142816cc79d5a6fefc52e4.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "Twin Block از دو پلیت مجزای بالا و پایین با رمپ‌هایی ساخته می‌شود که هنگام بستن دهان، مندیبل را به جلو هدایت می‌کنند. "
                    },
                    {
                      "tag": "em",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مأخذ: Proffit, Contemporary Orthodontics, 7th ed, Fig. 10.6"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
