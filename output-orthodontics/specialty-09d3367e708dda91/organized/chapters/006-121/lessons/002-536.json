          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در نمای روبه‌رو، ارتفاع صورت به سه بخش تقریباً مساوی تقسیم می‌شود:"
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "طبقه"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "محدوده"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فوقانی"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "خط رویش مو تا گلابلا"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "میانی"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "گلابلا تا زیر بینی"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "تحتانی"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "زیر بینی تا زیر چانه"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👈 در ارتودنسی، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "طبقه‌ی تحتانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مهم‌ترین است — چون بیشترین تغییر را از درمان ما می‌گیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "خودِ طبقه‌ی تحتانی هم تقسیم‌بندی درونی دارد: یک‌سوم بالایی از زیر بینی تا شکاف لبی، و دو‌سوم پایینی تا زیر چانه."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کاربرد بالینی این نسبت: در بیماری که طبقه‌ی تحتانی بلندتر از دو طبقه‌ی دیگر است، انتظار الگوی هایپردایورجنت و تمایل به اپن‌بایت داشته باش — و مکانیکی انتخاب کن که ارتفاع را بیشتر نکند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در همین نما لب‌ها را در "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حالت استراحت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ببین: اگر بدون تلاش به هم نمی‌رسند (فاصله‌ی بیش از حدود ۴ میلی‌متر)، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناتوانی لبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وجود دارد — اغلب همراه اورجت زیاد یا صورت بلند. در کودک مقداری فاصله‌ی لب طبیعی است و در نوجوانی کم می‌شود."
                }
              ]
            }
          ]
        }
      ],
