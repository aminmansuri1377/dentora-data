    {
      "id": "theory:ed8d5357fddc6f2cae59ee369de53c0e55b50efc5ccf21aaa81375cd1e011362",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "efb1cd33dd55fe54c1dd50975a98d3b42e3dac6dad12a098de2c9590c528f37c",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه راه اصلاح کلاس II در بزرگسال"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بزرگسال، رشد در دسترس نیست — پس هر راهبردی که انتخاب کنی، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است نه اسکلتی. سه گزینه داری:"
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "راهبرد"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سازوکار"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "دیستالیزه کردن مولر بالا"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بردن قوس بالا به عقب — نیازمند انکوریج قوی"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "عقب بردن قدام بالا با کشیدن"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کاموفلاژ: پنهان کردن اختلاف اسکلتی با موقعیت دندان"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "جلو آوردن قوس پایین"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "الاستیک کلاس II، اما با هزینه‌ی پروکلاین شدن قدام پایین"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ این تمایز را با بیمار هم در میان بگذار: در بزرگسال، رابطه‌ی فک‌ها تغییر نمی‌کند و آنچه اصلاح می‌شود، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "موقعیت دندان‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی همان فک‌هاست. پروفایل بهبود محدودی خواهد داشت."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 در عمل، بیشتر موارد ترکیبی از هر سه‌اند — و نسبت این ترکیب را طرح انکوریج تعیین می‌کند. مثلاً کشیدن پرمولر اول بالا با انکوریج ماکزیمم، عمدتاً راهبرد دوم است؛ همان کشیدن با انکوریج مینیمم، رفتار متفاوتی دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 با ورود "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مینی‌اسکرو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، راهبرد نخست بسیار عملی‌تر شده است: دیستالیزه کردن مولر بدون وابستگی به همکاری و بدون پروکلاین شدن ناخواسته‌ی قدام."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5c98a3bcf992d953c47c7e4413518189b617c85d70158d688bd27fd9249d0439",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "e43074f48bed0c70b722d573a434c03640cc4786e9c594b9a33eab93660c8d95",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "الاستیک کلاس II: هزینه‌های پنهان"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "الاستیک کلاس II ساده، ارزان و مؤثر است — و دقیقاً به همین دلیل بیش از حد استفاده می‌شود. چهار هزینه‌ی پنهانش را بشناس:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پروکلاین شدن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ثنایاهای پایین — در بیوتایپ نازک، خطر تحلیل لثه و دهیسنس"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اکستروژن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مولر پایین و ثنایای بالا"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چرخش ساعت‌گرد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مندیبل — که در صورت بلند ممنوع است"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وابستگی کامل به "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "همکاری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیمار؛ الاستیکی که استفاده نشود، صفر اثر دارد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 و اصل مهمی که در کل ارتودنسی تکرار می‌شود: همان اثری که در یک بیمار مفید است، در بیمار دیگر فاجعه است. اکستروژن مولر در بیمار دیپ‌بایت با صورت کوتاه، بخشی از درمان است؛ در بیمار با اپن‌بایت و صورت بلند، مشکل را بدتر می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 پس پیش از تجویز الاستیک کلاس II، دو چیز را بررسی کن: "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "الگوی عمودی صورت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیوتایپ لثه‌ای قدام پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". اگر هر دو پرخطرند، سراغ مینی‌اسکرو برو."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ و اثر جانبی سوم برگشت‌ناپذیر نیست، اما اثر جانبی اول می‌تواند باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
