  "steps": [
    {
      "id": "theory:0ecd836c5f9b1fee1280fd0b4598f0ad90e61d029419b096d0abfbfe7b368996",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "d6ae9a1f8dbea48723d69b381560b19ec8adf29bfae36b4dc810f4170bdaaab9",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "شش کلید اکلوژن نرمال (Andrews)"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اندروز با بررسی ۱۲۰ مدل با اکلوژن عالی و بدون سابقه‌ی درمان، شش ویژگی مشترک یافت:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رابطه‌ی مولری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " صحیح"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آنگولاسیون"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تاج (تیپ مزیودیستالی)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اینکلیناسیون"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تاج (تورک باکولینگوالی)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبود "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چرخش"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبود "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فضا"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "منحنی اشپی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " صاف یا کم‌عمق"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اهمیت این کشف در روش آن بود: اندروز به‌جای تعریف نظری «اکلوژن ایده‌آل»، رفت و دید طبیعت در بهترین حالت چه می‌سازد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیامد عملی‌اش بزرگ بود — این شش کلید به "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تبدیل شدند و در خودِ براکت تعبیه شدند. سیستم استریت‌وایر و کل مفهوم پرسکریپشن براکت، مستقیماً از همین شش ویژگی بیرون آمد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو مفهوم را از هم جدا کن: اکلوژن "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نرمال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " محدوده‌ی شایع و پذیرفتنی در جمعیت است، و اکلوژن "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایده‌آل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " الگوی کامل نظری که در طبیعت به‌ندرت دیده می‌شود. انحراف جزئی که بر عملکرد و زیبایی اثری ندارد، به‌تنهایی اندیکاسیون درمان نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "منحنی اشپی عمیقی که در پایان درمان باقی بماند، با دیپ‌بایت باقی‌مانده و خطر عود همراه است. صاف کردن این منحنی "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضا مصرف می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — به‌طور تقریبی هر میلی‌متر عمق، حدود یک میلی‌متر فضا — و این مقدار باید در آنالیز فضا به کراودینگ افزوده شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:220e320b21e54616fa3ab38f69f096d6de59eac8e0a19051d74f2f1ffb9f25f2",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "4cfe73a51f97562d0d6984268a7cbf878d43596e1279d8a3605eb6f9ad24d66f",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دنتیشن دائمی ثابت نمی‌ماند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تغییرات پس از تکمیل دنتیشن دائمی ادامه دارد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عرض قوس"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": ثابت یا اندکی کاهشی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "طول قوس"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کاهشی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کراودینگ قدامی پایین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": افزایشی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سایش"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اکلوزال و پروگزیمال: پیوسته"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس «پایان رشد» به معنای «پایان تغییر» نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این فهرست، پایه‌ی دو تصمیم بالینی مهم است. اول، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ریتنشن نامحدود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در قدام پایین: چون نیروی مسبب هرگز متوقف نمی‌شود، مقاومت در برابرش هم نمی‌تواند پایان داشته باشد. دوم، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تفکیک عود از تغییر دیررس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": تغییری که در افراد بدون سابقه‌ی درمان هم رخ می‌دهد، عود درمان تو نیست — و پاسخ درمانی متفاوتی می‌خواهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:877b7a53b261be9261064c473709eb3306f290c3de90d1e0f9ed8821ce983fe8",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "238235fd06e86ad4b4aafcfd8bfafef390dbb8ab010d7c5eb169818ab1d67031",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیرشدن صورت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بزرگسالی و میانسالی، بافت نرم صورت هم تغییر می‌کند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لب‌ها "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نازک‌تر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و افتاده‌تر می‌شوند"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نمایش دندان‌های بالا هنگام صحبت "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و نمایش دندان‌های پایین "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زیاد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌شود"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بینی و چانه به رشد بسیار آهسته ادامه می‌دهند"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیام درمانی روشن است: در بیمار میانسال، رترکشن گسترده‌ی قدامی‌ها پروفایل را "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیرتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشان می‌دهد. همان مقدار رترکشن که در نوجوان بی‌خطر است، اینجا حمایت لب را کم می‌کند و افتادگی را تشدید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک نکته‌ی مکمل: چون نمایش انسیزور بالا با سن کم می‌شود، اینتروژن قدامی بالا در بیمار میانسال باید با احتیاط بیشتری انجام شود — کاری که در نوجوان نتیجه‌ی خوبی می‌دهد، اینجا می‌تواند لبخند را بی‌جان کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
