                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۳"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بسته شدن خودبه‌خود همه‌ی فضاهای باقی‌مانده با نیروی جویدن"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۴"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بهبود خودبه‌خود تورک قدامی‌ها با جا افتادن اکلوژن"
                    }
                  ]
                }
              ]
            }
          ]
        }
