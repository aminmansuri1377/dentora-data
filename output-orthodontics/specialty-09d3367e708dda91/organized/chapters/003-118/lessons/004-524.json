                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ثبات کامل نتیجه، چون رابطه‌ی مولری کلاس I است"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
