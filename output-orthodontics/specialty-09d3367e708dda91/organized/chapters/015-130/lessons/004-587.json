                              "tag": "text",
                              "text": "روش"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سازوکار"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فنر یا اسکرو در دستگاه متحرک"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "دیستالیزه کردن مولر مهاجرت‌کرده"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "لیپ بامپر"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "انتقال فشار لب به مولرها و گسترش قوس پایین"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
