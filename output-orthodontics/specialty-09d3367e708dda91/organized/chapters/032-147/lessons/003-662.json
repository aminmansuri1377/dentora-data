    {
      "id": "theory:b6ef92fce96be2034ecbcb70e2337e6102bedfe298830c1cc2ea8c5d17ad791a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "39d0188f8ec662f63008ee5e535d7cbf121a645624d5c0237aca232ddeb133de",
