      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چه چیزی واقعاً فوری است؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مداخله‌ی زودهنگام لازم:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کراس‌بایت خلفی همراه با "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شیفت"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کراس‌بایت قدامی با ساییدگی لبه یا تحلیل لثه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اورجت شدید با "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خطر تروما"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانین نهفته — تشخیص در ۹ تا ۱۰ سالگی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از دست رفتن زودرس دندان شیری"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عادت فعال"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "معمولاً قابل تعویق:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کراودینگ خفیف، دیاستم گذرا، چرخش‌های جزئی، و کلاس II خفیف بدون خطر تروما."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وجه مشترک فهرست اول را ببین: در همه‌ی این‌ها، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعویق هزینه دارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — یا مشکل بدتر و ساختاری می‌شود، یا فرصت درمانی تکرارناپذیری از دست می‌رود، یا آسیب برگشت‌ناپذیری رخ می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و وجه مشترک فهرست دوم: تعویقشان چیزی را بدتر نمی‌کند — همان درمان چند سال بعد، همان نتیجه را می‌دهد."
                }
              ]
            }
          ]
        }
      ],
