      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه پنجره زمانی درمان"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "دوره"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "چه کاری آن‌جا بهتر انجام می‌شود"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "دنتیشن شیری"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "قطع عادت، کراس‌بایت قدامی ساده"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "دنتیشن مختلط"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کراس‌بایت با شیفت، اصلاح ارتوپدیک، مدیریت فضا، کانین نهفته"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "دنتیشن دائمی"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "درمان جامع ثابت، کاموفلاژ، جراحی"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ برخی مداخلات پنجره دارند و اگر از دست بروند، دیگر تکرار نمی‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه پنجره‌ی تکرارناپذیر که بیش از همه از دست می‌روند: "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای لی‌وی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که با مهاجرت مولر بلعیده می‌شود، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مداخله‌ی زودهنگام کانین نهفته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که پس از رویش بی‌معنا می‌شود، و "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اصلاح ارتوپدیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که با مهار رشد بسته می‌گردد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و در مقابل، بسیاری از مشکلات اکلوزال هیچ پنجره‌ای ندارند و در هر سنی قابل درمان‌اند — تفکیک این دو دسته، هسته‌ی تصمیم زمان‌بندی است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:bb9152a68e98643eb3e979ca2ae8e347f63fa9f292bbf3cd8442b30b7c669025",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "7f7770682e195715f67fef7da1f571489a9d4f01c95a3a6f55355e4119286204",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "درمان یک‌مرحله‌ای یا دومرحله‌ای؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درمان دومرحله‌ای یعنی یک فاز زودهنگام در دوره‌ی مختلط و یک فاز جامع در دنتیشن دائمی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شواهد چه می‌گویند؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کارآزمایی‌های شاهددار نشان داده‌اند در کلاس II، درمان دومرحله‌ای معمولاً به نتیجه‌ی نهایی "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بهتری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از درمان تک‌مرحله‌ای نمی‌رسد و در مجموع "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "طولانی‌تر و پرهزینه‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس چرا گاهی انجامش می‌دهیم؟ به دلایل "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مشخص و قابل دفاع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": کاهش خطر تروما در اورجت شدید، رفع بار روانی-اجتماعی در کودکی که آزار می‌بیند، یا مشکلی که پنجره‌ی محدود دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تفاوت مهم اینجاست: این دلایل، همگی "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غیر از"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بهبود نتیجه‌ی اکلوزالی نهایی‌اند. اگر تنها توجیه تو «نتیجه بهتر می‌شود» باشد، شواهد پشتت نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و همین را باید صادقانه با خانواده در میان گذاشت."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:8973818aeadbc3fc90aec68c3e9102730ccd466ce0ecbbf73e0a3f4596741374",
