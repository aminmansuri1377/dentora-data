  "steps": [
    {
      "id": "theory:04e17587b7c297fb3d621f95ab20088a3a531aecfacf5e02d164c83c4200668b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "cd6788bd2da77b80b34a3469bef8343b1d9569e92528bda2c3657c9893c870d1",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مندیبل: پررشدترین استخوان صورت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مندیبل هم "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غضروف کندیل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد و هم "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ریمادلینگ سطحی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گسترده — و به همین دلیل بیشترین و طولانی‌ترین رشد صورت را دارد. رشد آن تا اواخر نوجوانی و گاهی پس از آن ادامه می‌یابد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو جهت اصلی رشد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "افزایش طول تنه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — برداشت در لبه‌ی قدامی راموس همراه با رسوب در لبه‌ی خلفی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "افزایش ارتفاع راموس"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — رشد غضروف کندیل به سمت بالا و عقب"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "غضروف کندیل با غضروف صفحه‌ی رشد استخوان بلند یک تفاوت مهم دارد: "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ثانویه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و به فشار و عملکرد پاسخ می‌دهد. همین سازگاری، پایه‌ی نظری درمان فانکشنال است — هرچند دامنه‌ی اثر آن در انسان محدودتر از چیزی است که مطالعات حیوانی نشان می‌دادند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "زمان‌بندی: اوج سرعت رشد مندیبل هم‌زمان با جهش رشد بلوغ است. در روش CVM، مرحله‌ی "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "CS3"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — که با ظهور "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تقعر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در لبه‌ی تحتانی مهره‌های C2 و C3 شناخته می‌شود — به‌طور میانگین کمتر از یک سال پیش از این اوج است و CS4 حدود یک سال پس از آن. CS1 و CS2 یعنی جهش هنوز پیش روست."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:dabe1297ea6926676bb29f956b2158bdad71b980cd3ef936b02fcdb548673afd",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "bc888285ac749884e97f73eafcf77f6565b354afd607c69a6a1b3936790207f1",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "راموس در واقع «عقب می‌رود»"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "راموس با ریمادلینگ به سمت عقب حرکت می‌کند؛ هر بار که عقب می‌رود، بخشی از آنچه پیشتر راموس بود به "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تبدیل می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو نتیجه:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "طول تنه بیشتر می‌شود و فضا برای رویش مولر دوم و سوم باز می‌گردد"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کل مندیبل نسبت به قاعده‌ی جمجمه به جلو و پایین جابه‌جا می‌شود"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ یک باور نادرست رایج: «کندیل مندیبل را به جلو هل می‌دهد». رشد کندیل بیشتر "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارتفاع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " راموس را می‌سازد؛ جابه‌جایی کلی مندیبل به جلو، برایند مجموعه‌ای از فرایندهاست — از جمله رشد قاعده‌ی جمجمه."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیامد بالینی: انتظار «کشیدن مندیبل به جلو» از یک دستگاه فانکشنال، ساده‌سازی این تصویر است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:8bb556ee4e3afa4666d1e0123ab96f34024adb8be005d7bbb65ab83a5db76681",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "52b1821478fd9261769772d1998d50f04bd58ae815a14d71aecdbabb73ee5ac2",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "الگوی «جلو-پایین» و چانه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چانه با رشد برجسته‌تر می‌شود — اما نه چون استخوان زیادی روی آن رسوب می‌کند. دو سازوکار دیگر کار می‌کنند:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کل مندیبل به جلو و پایین جابه‌جا می‌شود"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناحیه‌ی بالای چانه (آلوئول قدامی) برداشت دارد و همین، چانه را نسبتاً برجسته‌تر نشان می‌دهد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به همین دلیل پروفایل کودک با رشد به‌طور طبیعی "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "صاف‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شود — کودکی که امروز پروفایل محدب دارد، ممکن است بخشی از آن را خودبه‌خود از دست بدهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیامد عملی: در ارزیابی کودک، پروفایل امروز را نهایی فرض نکن. بخشی از تغییر مورد انتظار از رشد می‌آید و باید در برآورد نیاز درمانی لحاظ شود — به‌ویژه پیش از تصمیم به مداخله‌ی زودهنگام."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
