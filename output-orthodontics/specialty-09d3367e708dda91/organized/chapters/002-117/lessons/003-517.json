  "steps": [
    {
      "id": "theory:14c53e5197873230d22696ea846afd17ef2cb4688ad9a847e64a0384476aaff9",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "ac31cfbd04bc2a57fffbf0986d914fed94f635661fdaa1dad2865aaa89b9257c",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ماگزیلا: استخوانی که هل داده می‌شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ماگزیلا غضروف رشدی ندارد. پس چطور رشد می‌کند؟ از دو راه، هم‌زمان:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جابه‌جایی به جلو و پایین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در اثر رشد قاعده‌ی جمجمه و سپتوم بینی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رشد در سوچورها"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — فرونتوماگزیلاری، زیگوماتیکوماگزیلاری، زیگوماتیکوتمپورال و پترگوپالاتین"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و هم‌زمان با هر دو، سطوحش "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ریمادلینگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نکته‌ی ظریفی اینجا هست: چون ماگزیلا با جابه‌جایی جلو می‌رود، فضایی در سوچورها باز می‌شود که با استخوان تازه پر می‌گردد. یعنی سوچور "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پاسخ می‌دهد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، نه اینکه ماگزیلا را هل بدهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همین وابستگی سوچور به کشش، پایه‌ی کار ماسک صورتی و اکسپنشن است؛ و در جهت عکس، هدگیر با نیروی رو به عقب روی مولرهای بالا می‌تواند جابه‌جایی جلو-پایین ماگزیلا را در بیمار در حال رشد مهار کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:f4d25a5c94d36cfe0d317fad7fe2ac0fe11db333c2bf19f2584ca41f64f468a2",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "c14cdddf7cbf8bf45376fd4b1d319f3b6953a4f1c65acc5e9705d6422a737e62",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پارادوکس سطح قدامی ماگزیلا"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "انتظار داری سطح جلوی ماگزیلا رسوب داشته باشد، چون کل استخوان به جلو می‌رود. اما در واقع بیشتر سطح قدامی "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا؟ چون حرکت ماگزیلا به جلو از "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جابه‌جایی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌آید، نه از ساختن استخوان روی سطح جلویی. ریمادلینگ سطحی کار دیگری می‌کند: شکل و تناسب استخوان را در موقعیت تازه‌اش حفظ می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درس مهم: ریمادلینگ سطحی با جهت حرکت استخوان یکی نیست."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این تنها یک نکته‌ی نظری نیست — در تفسیر سوپرایمپوزیشن سفالومتریک مستقیماً به کار می‌آید. اگر جابه‌جایی و ریمادلینگ را از هم جدا نکنی، مقدار واقعی رشد را اشتباه برآورد می‌کنی."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
