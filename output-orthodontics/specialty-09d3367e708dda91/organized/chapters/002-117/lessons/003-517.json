                            {
                              "tag": "text",
                              "text": "عرضی"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سوچور میدپالاتال"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "زودترین (حدود بلوغ)"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ساژیتال"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سوچورهای خلفی و توبروزیته"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "متوسط"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "عمودی"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "رسوب آلوئولار و برداشت کف بینی"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "دیرترین"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این ترتیب — عرضی، ساژیتال، عمودی — یکی از کاربردی‌ترین جدول‌های کل ماژول است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیام اول:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اکسپنشن سریع میدپالاتال تنها پیش از جوش خوردن سوچور جواب می‌دهد. در بزرگسال، همان دستگاه فقط دندان‌ها را تیپ می‌دهد و برای اکسپنشن اسکلتی باید سراغ کمک جراحی (SARPE) یا انکوریج اسکلتی با مینی‌اسکرو (MARPE) رفت."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیام دوم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چون بُعد عمودی دیرترین است، تغییرات ارتفاع صورت تا اواخر نوجوانی ادامه دارد — و همین، ریتنشن در کیس‌های اپن‌بایت و دیپ‌بایت را طولانی‌تر می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیامد مکانیکی: مولرها با رویش، ارتفاع خلفی صورت را زیاد می‌کنند. در بیمار با رشد عمودی زیاد، اکستروژن مولر مانند گوه‌ای مندیبل را به عقب-پایین می‌چرخاند و اپن‌بایت را بدتر می‌کند."
                }
              ]
            }
          ]
        }
      ],
