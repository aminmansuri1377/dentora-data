    {
      "id": "theory:ac10993fe41bbc259f4d8979e66d996863564e3e34cf5db13ffc2b615ffcf04c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "774c50abe4ca23d81c66719de824e9658bf293a02cc865e71b889443b6034694",
