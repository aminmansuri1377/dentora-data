      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پس از دیباند چه باید کرد؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دیباند پایان کار نیست؛ آغاز مرحله‌ای است که نتیجه‌ی همه‌ی سال‌های قبل را حفظ می‌کند یا از دست می‌دهد."
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ارزیابی مینا"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": ثبت لکه‌های سفید و ترک‌های احتمالی، همراه با عکس بالینی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ریتینر فوری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": قالب یا اسکن در همان جلسه — تأخیر یعنی عود. حرکت برگشتی از همان ساعات نخست شروع می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فلوراید"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و توصیه‌های بهداشتی برای دوره‌ی پس از درمان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رادیوگرافی پایان درمان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در صورت اندیکاسیون، برای ارزیابی وضعیت ریشه‌ها و استخوان"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 قاعده: بیمار نباید "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدون ریتینر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از مطب خارج شود. اگر ریتینر ثابت گذاشته نمی‌شود و ساخت پلاک زمان می‌برد، ریتینر موقت بگذار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 جلسه‌ی دیباند بهترین زمان برای گفت‌وگو درباره‌ی ریتنشن است — بیمار سرحال است و نتیجه را می‌بیند. اگر این گفت‌وگو را به جلسه‌ی بعد موکول کنی، بخشی از انگیزه‌اش از دست می‌رود."
                }
              ]
            }
          ]
        }
      ],
