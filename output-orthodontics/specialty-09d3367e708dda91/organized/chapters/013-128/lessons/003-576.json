      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه لایه دفاعی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیشگیری روی سه جبهه‌ی همزمان انجام می‌شود؛ هیچ‌کدام به‌تنهایی کافی نیست."
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "لایه"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اقدام"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "۱. کنترل پلاک"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "آموزش مسواک، مسواک بین‌دندانی، دهانشویه"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "۲. فلوراید"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "خمیردندان فلوراید بالا، وارنیش دوره‌ای"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "۳. کنترل رژیم"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کاهش دفعات مصرف قند و نوشیدنی اسیدی"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 در لایه‌ی سوم، نکته‌ای هست که اغلب اشتباه فهمیده می‌شود: عامل تعیین‌کننده، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دفعات"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مصرف قند است نه مقدار آن. هر بار مصرف، یک حمله‌ی اسیدی جداگانه است که چند ده دقیقه طول می‌کشد. یک شکلات در یک نوبت، کم‌خطرتر از نوشیدن جرعه‌جرعه‌ی یک نوشابه در طول دو ساعت است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 و همین را باید به بیمار گفت. «قند کمتر بخور» توصیه‌ای مبهم است؛ «بین وعده‌ها چیزی جز آب نخور» دستوری اجراپذیر است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:c0c637f6d5a188dc613c295ffc11d05008bdcdd3db4c30a7a9c184b5e677d1d6",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "f0bfd89a626dafc134f78939ca5f8452830f561058f9c77ebd68c13d11a88d7b",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "معیار عینی برای شروع و ادامه درمان"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بهداشت بیمار را نمی‌توان با احساس ارزیابی کرد؛ به معیار عینی و ثبت‌شده نیاز دارد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پیش از باندینگ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": بهداشت باید به سطح قابل قبول برسد — این یک "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پیش‌شرط"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است نه توصیه. اگر بیمار پیش از براکت نمی‌تواند دندان‌هایش را تمیز نگه دارد، پس از براکت قطعاً نمی‌تواند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "در هر ویزیت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": ارزیابی پلاک و التهاب لثه، و ثبت آن در پرونده. ثبت کردن، هم روند را نشان می‌دهد و هم گفت‌وگو با بیمار و والدین را ممکن می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اگر لکه‌ی سفید ظاهر شد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": تشدید فلوراید، بازآموزی بهداشت، و در موارد شدید و پیش‌رونده، "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دیباند زودهنگام"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 قاعده‌ی سخت اما درست: "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لبخند ردیف روی مینای خراب، شکست درمان است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". توقف درمان پیش از رسیدن به هدف، در برابر آسیب دائمی به مینا، تصمیم درستی است — هرچند گفتنش به بیمار آسان نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 این گفت‌وگو را باید در جلسه‌ی نخست و پیش از شروع درمان انجام داد، نه وقتی که لکه‌ها پیدا شده‌اند."
                }
              ]
            }
          ]
        }
      ],
