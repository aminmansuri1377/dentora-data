                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "آزادسازی فلوراید، چسبندگی شیمیایی به مینا، تحمل رطوبت نسبی"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "RMGI"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ترکیب گلاس‌آینومر و رزین؛ استحکام بیشتر، آزادسازی فلوراید، گیرش نوری — انتخاب رایج امروز"
                            }
                          ]
