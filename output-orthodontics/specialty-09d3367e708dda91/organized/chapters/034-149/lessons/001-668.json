  "steps": [
    {
      "id": "theory:5d6ea708368eeda7794a38416e7ed3601946df3d22c7d099e4bc2e43ceb67cc1",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "d312e1a2193e82c37d9badd12b594035aef9f0bf0d0fc38d11c62483d2027680",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "از گچ تا اسکن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اسکنر داخل‌دهانی، قالب‌گیری سنتی را جایگزین کرده است. سود آن فقط راحتی بیمار نیست:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حذف خطای مواد قالب‌گیری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و تغییر ابعادی گچ؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بایگانی دائمی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بدون نیاز به فضای فیزیکی و بدون شکستن؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "امکان اندازه‌گیری خودکار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضا، بولتون و منحنی اشپی؛ و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارسال فوری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به لابراتوار یا شرکت الاینر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک سود که کمتر گفته می‌شود: امکان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوپرایمپوزیشن مدل‌های متوالی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای اندازه‌گیری دقیق حرکت انجام‌شده و پایش عود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در عوض، اسکن هم تکنیک‌حساس است: بزاق، خون و حرکت بیمار می‌توانند نواحی ناقص بسازند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:dbb47fcd4c64bf99f7ccce25b070db5cb0661aeef03d6cd1a6603f35c442e733",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "c1de0713a149d7dffd6736bac5a2764b7f133cff2eaad45d66a49a4a62d00b6d",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "طراحی و ساخت دیجیتال"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "زنجیره‌ی دیجیتال به اسکن ختم نمی‌شود:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ستاپ مجازی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — چیدن دندان‌ها در موقعیت هدف و دیدن نتیجه پیش از شروع درمان."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باندینگ غیرمستقیم دیجیتال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — موقعیت هر براکت روی مدل مجازی تعیین و با ترنسفر تری منتقل می‌شود؛ دقت بالاتر و زمان صندلی کمتر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیم و اپلاینس سفارشی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — سیم‌های خم‌شده با ربات و اپلاینس‌های پرینت‌شده بر پایه‌ی آناتومی همان بیمار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرینت سه‌بعدی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای مدل، ریتینر، گاید جراحی مینی‌اسکرو و شابلون اتچمنت."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:f09a207d1d5ad2db842e2d02fa28983292ae495eda6a080aee92b95b61410e93",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "9e2580939d83b8b65fd51654d39b298325d5a7be587576288cc780752876a11f",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اشتباه رایج: دقت ابزار، دقت تشخیص نیست"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ابزار دیجیتال دقت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اجرا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را بالا می‌برد — نه لزوماً دقت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تصمیم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک ستاپ مجازی زیبا از یک طرح درمان نادرست، همچنان یک طرح درمان نادرست است — فقط با ظاهری قانع‌کننده‌تر. و یک باندینگ غیرمستقیم بسیار دقیق، براکت‌ها را دقیقاً در موقعیتی می‌گذارد که تو تعیین کرده‌ای؛ اگر آن موقعیت اشتباه باشد، دقت فقط خطا را تکرارپذیر می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک هشدار مربوط به هوش مصنوعی: ابزارهای خودکار تحلیل سفالومتریک و پیشنهاد طرح، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیشنهاددهنده‌اند نه تصمیم‌گیرنده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". لندمارک‌های خودکار باید بازبینی شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فناوری، قضاوت بالینی را تقویت می‌کند — جایگزینش نمی‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
