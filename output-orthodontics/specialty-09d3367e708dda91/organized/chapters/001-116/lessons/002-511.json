  "steps": [
    {
      "id": "theory:79040f62f751b77ddde5c06bd12caf74b7935aa57af1e49b5106f2f7a1c67d61",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "921ffd2cd1b18735842e3682051aa6ee1d8f4f825f717f692f05d96f04d5f68f",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چند نفر واقعاً مال‌اکلوژن دارند؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مطالعات جمعیتی بزرگ (مانند NHANES در آمریکا) تصویر روشنی می‌دهند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنها حدود "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳۰٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مردم اکلوژن نزدیک به ایده‌آل دارند"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حدود "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۵٪"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بی‌نظمی شدید دندان‌های قدامی دارند که جز با اکسپنشن زیاد قوس یا کشیدن دندان ردیف نمی‌شود"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلاس I شایع‌ترین رابطه‌ی مولری است؛ کلاس II حدود ۱۵ تا ۲۰ درصد و کلاس III کمتر از ۵ درصد"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "الگو قومی است: کلاس II در سفیدپوستان شمال اروپا (تا یک‌چهارم کودکان) و کلاس III در جمعیت‌های شرق آسیا شایع‌تر است"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو نکته که از این آمار بیرون می‌آید:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱، شیوع با نیاز به درمان یکی نیست."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بسیاری از انحراف‌ها خفیف‌اند و نه بر سلامت اثر می‌گذارند و نه بر ظاهر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲، اکلوژن ایده‌آل استثناست، نه قاعده."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس در تعریف هدف درمان، «ایده‌آل» را با «قابل قبول برای این بیمار» اشتباه نگیر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:77a34ea7a7b3cd5d14068649bbeef1a1f664dd247af69bff0ecbc66a757748cd",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "339994d542c34d65e03605df8e6e0611dcc2ac8330133d83f1c6e23aab5dfe2e",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کراودینگ؛ شایع‌ترین مشکل"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "شایع‌ترین مشکل ارتودنسی در جمعیت، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌نظمی و کراودینگ دندان‌های قدامی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است — نه کلاس II و نه کلاس III."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و نکته‌ای که کمتر گفته می‌شود: کراودینگ قدامی پایین با افزایش سن "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌شود، حتی در کسانی که هرگز ارتودنسی نکرده‌اند. به این پدیده "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کراودینگ دیرهنگام قدامی پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌گویند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ریشه‌اش تغییرات تکاملی وابسته به سن است: قوس با گذر عمر کمی باریک‌تر و کوتاه‌تر می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیامد بالینی مهمی دارد — چون این تغییر مربوط به درمان نیست، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیچ طرح درمانی نمی‌تواند جلویش را بگیرد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". تنها پاسخ، ریتنشن است. همین است که ریتنشن نامحدود در قدام پایین را به یک استاندارد تبدیل کرده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:cd58187e6a5a140e732a31a284d1376e974d14482a674e9658c2e63ba3f621ce",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "91c2dd269b6eec00b89136e650248a4c0fbd475332dc66edfe126446ace2633e",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا این آمار برای تو مهم است؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه استفاده‌ی عملی از داده‌های اپیدمیولوژیک در کار روزمره:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱، تنظیم انتظار."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وقتی می‌دانی اکلوژن ایده‌آل در کمتر از یک‌سوم جمعیت دیده می‌شود، «طبیعی» را واقع‌بینانه‌تر تعریف می‌کنی — هم برای خودت و هم برای خانواده‌ای که نگران فاصله‌ی کوچک میان ثنایاهای کودکش است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲، اولویت‌بندی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در غربالگری مدرسه یا مطب پرمراجعه، شناخت الگوی شیوع کمک می‌کند وقت را روی مواردی بگذاری که واقعاً نیاز دارند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳، تفکیک بیماری از تنوع."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بخش بزرگی از آنچه «مال‌اکلوژن» نامیده می‌شود، تنوع طبیعی است نه آسیب‌شناسی. درمانِ تنوع، نه ضرورت دارد و نه همیشه به سود بیمار است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک تمایز مهم: نیاز، درک بیمار و تقاضا سه چیزند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیازی که متخصص با معیار عینی تعیین می‌کند "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیاز نورماتیو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و با شاخصی مانند "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "IOTN"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (شاخص نیاز به درمان ارتودنسی، با دو جزء سلامت دندانی و زیبایی) سنجیده می‌شود؛ آنچه بیمار خودش احساس می‌کند "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیاز درک‌شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. تقاضای واقعی را هم اقتصاد، فرهنگ و دسترسی به درمانگر شکل می‌دهد. سهم بزرگسالان از بیماران ارتودنسی از حدود ۵٪ در دهه‌ی ۱۹۶۰ به بیش از یک‌چهارم رسیده است. و آمار مراجعان مطب را به جمعیت تعمیم نده؛ کسی که به مطب می‌آید مشکل محسوس‌تری دارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
