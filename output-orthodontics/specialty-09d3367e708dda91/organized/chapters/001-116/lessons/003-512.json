  "steps": [
    {
      "id": "theory:c7caa050a9ef27841bc93e64dbb31e8956647f6bb65cfa405f4d6c3a438af828",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "15ae0067d2b96c8c040698c637631155f1cf83e9d13e17cf282d4f2b34866d2c",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دندان کج، فقط یک مسئله دندانی نیست"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مال‌اکلوژن شدید می‌تواند بر "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کیفیت زندگی مرتبط با سلامت دهان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اثر بگذارد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نارضایتی از ظاهر و کاهش اعتماد به نفس"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قرار گرفتن در معرض "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "قلدری و متلک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " — به‌ویژه با اورجت زیاد در نوجوانان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محدودیت در خندیدن و پرهیز از تعاملات اجتماعی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این اثرها مستند و قابل اندازه‌گیری‌اند و در بخشی از بیماران، انگیزه‌ی اصلی مراجعه‌اند — نه شکایت عملکردی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در مقابل، درمان موفق اغلب بهبود قابل سنجشی در رضایت از ظاهر ایجاد می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس هنگام گرفتن شرح‌حال، پرسش «چه چیزی شما را اذیت می‌کند؟» را جدی بپرس و پاسخ را "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با کلمات خود بیمار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بنویس. همان جمله، بعداً معیار سنجش موفقیت درمان می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "معیار زیبایی هم ثابت نیست: فرهنگ، قومیت و دوره‌ی زمانی آن را تغییر می‌دهند، و نرم‌های سفالومتریک رایج بیشتر از جمعیت‌های سفیدپوست به دست آمده‌اند. رویکرد امروز "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پارادایم بافت نرم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: هدف و محدودیت درمان را لب، بینی و چانه تعیین می‌کنند، نه فقط اعداد اسکلتی."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:0fd9772c5bc133d6743650973a45941e7cc730e77792ef0c59fe4ead72c1be03",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "fbf0765eb1ababba03776463cdbf1da1798e9e199c061670b8d02571314d4825",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مرز واقع‌بینی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اما مرزها را هم بشناس. ارتودنسی:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شخصیت یا مشکلات روانی زمینه‌ای را "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "درمان نمی‌کند"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در بیماری با انتظار غیرواقع‌بینانه، حتی با نتیجه‌ی فنی عالی هم رضایت نمی‌آورد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرچم قرمز:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیماری که از نقصی بسیار جزئی رنج شدید می‌برد، بارها درمان زیبایی انجام داده و از همه ناراضی بوده، ممکن است "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اختلال بدشکلی بدن (BDD)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " داشته باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در این بیمار، براکت پاسخ نیست — ارزیابی روان‌شناختی است. شروع درمان بدون آن، هم بیمار را ناراضی‌تر می‌کند و هم درمانگر را در موضع دشواری می‌گذارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "راه عملی: پیش از تعهد، از بیمار بخواه دقیقاً بگوید پس از درمان انتظار چه تغییری دارد. فاصله‌ی این پاسخ با واقعیت، بهترین سنجه‌ی توست."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:e5275f737eff33fe8e8c82a109f201030c55ff2bfdb976b55e6e7f73f22d6bd1",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "027d4050b9425ba55c11aecd54c27372728bdca8940d07743ccd38f76b472beb",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رضایت بیمار از کجا می‌آید؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رضایت از نتیجه به سه چیز بستگی دارد که هیچ‌کدام مکانیکی نیستند:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱، انتظار اولیه."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیماری که تصور می‌کند ارتودنسی صورتش را عوض می‌کند، با اکلوژن بی‌نقص هم راضی نمی‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲، مشارکت در تصمیم."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیماری که میان دو گزینه خودش انتخاب کرده، نتیجه را می‌پذیرد؛ بیماری که برایش تصمیم گرفته‌اند، آن را قضاوت می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳، آگاهی از محدودیت‌ها."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " محدودیتی که پیش از درمان گفته شود «توضیح» است؛ همان محدودیت اگر بعد گفته شود «بهانه» به نظر می‌رسد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بیمار زیر سن قانونی، رضایت از ولی قانونی گرفته می‌شود — اما توضیح دادن به خودِ کودک هم لازم است. همکاری او را نمی‌شود امضا کرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از درمان ثابت، سه موضوع را صریح و مکتوب بگو: خطر "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ریزورپشن ریشه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دکلسیفیکاسیون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (لکه‌ی سفید) و "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضرورت ریتنشن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". و یادت باشد همکاری در بهداشت و الاستیک از "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انگیزه‌ی خود بیمار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌آید، نه از اصرار والدین."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
