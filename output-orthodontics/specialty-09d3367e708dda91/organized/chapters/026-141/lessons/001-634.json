  "steps": [
    {
      "id": "theory:0835e7044f9f63b09f21c1461abddc5757eea7e7120dde074e6884f6863dcc9d",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "92c3bccc8a1ca77fc65e07bee623519be88c90649ce340c7b58118008e2de9d4",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بزرگسال، نوجوانِ بزرگ‌شده نیست"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه تفاوت، کل طرح درمان را عوض می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱. رشدی باقی نمانده."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هر آنچه ارتوپدی می‌توانست بدهد از دسترس خارج است؛ انتخاب واقعی میان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاموفلاژ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جراحی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. دستگاه فانکشنال یا هدگیر در بزرگسال فقط دندان‌ها را جابه‌جا می‌کند، نه فک را."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲. بافت‌ها ذخیره‌ی کمتری دارند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تحلیل استخوان، تحلیل لثه‌ای و بیوتایپ نازک، محدوده‌ی حرکت دندانی را از پیش تنگ کرده‌اند. با تحلیل استخوان، مرکز مقاومت به سمت اپکس می‌رود و سطح ریشه‌ی درگیر کم می‌شود؛ پس همان نیرو تیپینگ و فشار بیشتری می‌سازد و نیرو باید سبک‌تر باشد. پاپیلای بین‌دندانی هم کوتاه‌تر است: ردیف کردن دندان‌های چرخیده نقطه‌ی تماس را به سمت انسیزال می‌برد و ممکن است مثلث لثه‌ای سیاه بماند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳. دهان دست‌خورده است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیم‌های وسیع، دندان‌های درمان ریشه‌شده، پروتز و بی‌دندانی جزئی، هم مکانیک را محدود می‌کنند و هم اهداف را عوض."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در عوض یک برتری بزرگ دارد: انگیزه‌ی درونی. بزرگسال خودش انتخاب کرده که درمان شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:0760c6538ea2f5384d70022fd02f2a28af49fc035477c50de614407a0a23b947",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "562b7eb3ec91c749ab2cebd88f6b67996fb2a23a2e501e3952963f3b11c2740f",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیش از باندینگ: سه پرونده که باید بسته شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بزرگسال، ترتیب کار قابل مذاکره نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پریودنتال."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " التهاب فعال باید کنترل شود. نیروی ارتودنسی روی چسبندگی ملتهب، تخریب استخوان را "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تسریع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌کند — این یکی از معدود قواعد نزدیک به مطلق ارتودنسی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوسیدگی و اندو."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ضایعه‌ی فعال و پالپ علامت‌دار پیش از حرکت دندانی درمان می‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عملکردی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " علائم مفصلی و پارافانکشن ثبت می‌شوند — نه برای درمان با ارتودنسی، بلکه برای اینکه در پایان درمان به گردن تو نیفتند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تازه پس از این سه، نوبت طرح ارتودنسی است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5b69ae69ad198af356147c4a8e08fd4afb0ce9ea45264a0b0c5dbb0d382ee212",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "46fe53c8fef5246152cec85b901b8c0258364b6d721852e55a94883e99766c16",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اشتباه رایج: انتظار بیمار بزرگسال"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بزرگسال معمولاً با یک شکایت مشخص می‌آید: «این یک دندان». اما وقتی معاینه‌اش می‌کنی، تصویر کامل‌تری می‌بینی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اینجا دو خطای قرینه رایج است. یکی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نادیده گرفتن شکایت اصلی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و چیدن طرحی که به آنچه بیمار می‌خواست نمی‌رسد. دیگری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پذیرش بی‌قید شکایت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و اجرای درمان موضعی روی زمینه‌ای که آن را ناپایدار می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "راه سوم: هر دو را مکتوب کن. شکایت بیمار در بالای فهرست مشکلات، و یافته‌های دیگر زیر آن — هرکدام یا هدف درمانی می‌گیرند یا آگاهانه و با امضای بیمار کنار گذاشته می‌شوند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
