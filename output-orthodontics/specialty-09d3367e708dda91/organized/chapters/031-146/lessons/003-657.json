  "steps": [
    {
      "id": "theory:94b9faf71f949470b96511c64c65c7cabe27232088a37dcd3d2a8215f6448706",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "016a6b5f764bc98e346ace4819c2331c99711af9e0a04e88135263f9da639079",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چه کسی چقدر عود می‌کند؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "خطر عود در همه یکسان نیست. عوامل پرخطر شناخته‌شده:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روتیشن شدید اصلاح‌شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — فیبرهای سوپراکرستال پیچ‌خورده بیش از یک سال کشش دارند. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیاستم بسته‌شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — به‌ویژه در خط وسط. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اپن‌بایت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — که با رویش دوباره‌ی مولرها در رشد عمودی دیررس برمی‌گردد. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکسپنشن قابل توجه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — به‌ویژه اگر عرض بین‌کانینی افزایش یافته باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و دو عامل بیمارمحور: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عادت‌های فعال و وضعیت استراحت زبان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — مکیدن انگشتی که پس از درمان ادامه یابد، یا زبانی که در استراحت جلو می‌نشیند و فشاری سبک ولی ساعت‌ها طولانی وارد می‌کند — و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رشد باقی‌مانده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در بیمار جوان. تراست زبان هنگام بلع فقط لحظه‌ای است و بیشتر پیامد اپن‌بایت است تا علتش."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هرچه این عوامل بیشتر جمع شوند، برنامه‌ی ریتنشن باید محکم‌تر و طولانی‌تر باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:91bd7e1e368d2b57c195cf14db8fddbf2bd6de86987c3e298aac9e1d62ef2dac",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "01e8a0dfa4b8f01f19fc1f66611b942de05bfdeadf9c1b001bc9ad05b8965aa7",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مداخلات کمکی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گاهی ریتینر به‌تنهایی کافی نیست و باید نیروی عود را در منبعش کم کرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فیبروتومی (برش فیبرهای سوپراکرستال)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": یک اقدام جراحی کوچک که فیبرهای کشیده‌ی اطراف دندان چرخیده را قطع می‌کند. برای روتیشن‌های شدید اصلاح‌شده توصیه می‌شود و بهتر است هنگام دیباند یا کمی پیش از آن انجام شود. نیاز به ریتینر را از بین نمی‌برد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراش بین‌دندانی محدود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": با پهن کردن تماس‌های پروگزیمال، ثبات قدام پایین را افزایش می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترک عادت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": اگر مکیدن انگشت پس از درمان ادامه یابد، عود اپن‌بایت تقریباً حتمی است و ریتینر فقط آن را عقب می‌اندازد. تراست زبان هنگام بلع معمولاً با بسته‌شدن بایت خودبه‌خود تغییر می‌کند و آموزش بلع پیش از درمان لازم نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ریتنشن عرضی طولانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": عرض بین‌کانینی پایین که باز شده، ناپایدارترین تغییر است و ریتنشن طولانی — اغلب دائمی — می‌خواهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قاعده‌ی کلی: هرجا می‌توانی، منبع نیرو را کم کن — نه اینکه فقط در برابرش مقاومت کنی."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:4992bcd3bf3b8882bb39b42f0a065724fa6869bbd97fb12549a2d26ea00bf551",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "e0db1b0a5492067b954db8b135f64f86ac64bfe7bbeb1041eaa01cb4c69ec289",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اشتباه رایج بالینی: عود در برابر تغییر"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی بیماری با تغییر برمی‌گردد، نخستین پرسش این است: این "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تغییر دیررس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عود یعنی بازگشت به‌سمت وضعیت پیش از درمان — همان روتیشن، همان دیاستم، همان اپن‌بایت. تغییر دیررس یعنی حرکتی که در افراد بدون سابقه‌ی ارتودنسی هم رخ می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا مهم است؟ چون "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پاسخ متفاوت است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". عود اغلب به بازنگری در ریتنشن یا درمان مجدد محدود نیاز دارد؛ تغییر دیررس به پذیرش و ریتنشن پایدار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و برای تفکیک، به مدارک پایان درمان نیاز داری. بدون مدل و عکس دیباند، این دو را نمی‌شود از هم جدا کرد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
