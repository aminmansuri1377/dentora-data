                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "احتمال"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
