      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه بُعد را جدا بنویس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک تشخیص کامل باید هر سه بُعد را پوشش دهد:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساژیتال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (قدامی-خلفی): کلاس I / II / III، اورجت"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عمودی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": اوربایت، اپن‌بایت، ارتفاع صورت"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عرضی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کراس‌بایت، تنگی قوس، عدم تقارن"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👈 و برای هر بُعد یک پرسش دوم بپرس: "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندانی است یا اسکلتی؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این جدول سه در دو، ستون فقرات تشخیص توست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا نوشتن این جدول ارزش دارد؟ چون از دو خطای رایج جلوگیری می‌کند. اول، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فراموش کردن یک بُعد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — بُعد عرضی بیش از همه از قلم می‌افتد و بعداً در فینیشینگ خودش را نشان می‌دهد. دوم، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان جبرانی ناخواسته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — وقتی ننویسی مشکل اسکلتی است، ناخودآگاه با حرکت دندانی جبرانش می‌کنی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی این یافته‌ها را در فهرست مشکلات می‌چینی، مشکل "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پاتولوژیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (پریودنتیت فعال، پوسیدگی) همیشه پیش از مشکل "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تکاملی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (کراودینگ، اورجت، رابطه‌ی مولری) می‌آید."
                }
              ]
            }
          ]
        }
      ],
