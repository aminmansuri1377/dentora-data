          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "با "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "معاینه‌ی پروفایل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌توان کلاس اسکلتی را پیش از هر رادیوگرافی حدس زد:"
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "پروفایل"
