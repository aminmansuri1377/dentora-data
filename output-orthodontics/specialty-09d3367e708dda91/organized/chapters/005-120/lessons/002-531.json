                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش لمسی ساده: انگشتان را روی نقاط A و B نرم‌بافتی بگذار و موقعیت نسبی‌شان را بسنج."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه شرط برای اینکه این ارزیابی قابل اتکا باشد: بیمار در "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وضعیت سر طبیعی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لب‌ها در حالت استراحت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و بدون انقباض، و "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان‌ها در اکلوژن مرکزی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". نادیده گرفتن هر کدام، نتیجه را جابه‌جا می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک محدودیت را بدان: پروفایل، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برایند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " موقعیت هر دو فک است. پروفایل محدب می‌تواند از ماگزیلای جلو آمده باشد یا مندیبل عقب‌مانده — تفکیک این دو به سفالومتری نیاز دارد."
                }
              ]
            }
          ]
        }
