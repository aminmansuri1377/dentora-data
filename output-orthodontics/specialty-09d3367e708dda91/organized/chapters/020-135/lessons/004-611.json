  "steps": [
    {
      "id": "theory:06aac61274aba7df68b12cf1cb5c936e4aa8f1c4501d1c8e9132fd2c655b8ac5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6697af3e141dd1fcec6679618f7c3756f4ffc3acc8bebabf40955a3600a7d6c1",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا پرمولر اول؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پرمولر اول، پرکشیده‌ترین دندان در ارتودنسی است — و سه دلیل روشن دارد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "وسط"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " قوس قرار دارد، پس فضای آزادشده هم به قدام و هم به خلف قابل استفاده است. فضای یک مولر فقط به درد خلف می‌خورد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حذف آن کمترین اثر را بر "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عملکرد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زیبایی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دارد — نه در لبخند دیده می‌شود و نه نقش کلیدی در جویدن دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانین می‌تواند به‌جای آن بنشیند و تماس طبیعی با پرمولر دوم برقرار کند؛ شکل و اندازه‌ی این دو با هم سازگار است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 اما انتخاب دندان همیشه ثابت نیست و نباید بازتاب عادت باشد: دندانی با پیش‌آگهی ضعیف، ترمیم وسیع، پوسیدگی گسترده یا موقعیت نامناسب، اولویت کشیدن دارد — حتی اگر پرمولر اول نباشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 و در برخی طرح‌ها، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرمولر دوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انتخاب بهتری است: وقتی می‌خواهی مولر جلو بیاید و قدام کمتر عقب برود (یعنی انکوریج مینیمم). محل کشیدن، ابزار کنترل انکوریج است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ تصمیم کشیدن باید پیش از باندینگ نهایی شود؛ تغییر آن در میانه‌ی درمان بسیار پرهزینه است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:9c499cccca5086ae5600d4c3c5aed87c89ccda32002ffa81b919e1ba3d8d31de",
      "sourceId": null,
