              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "IPR ابزار خوبی است، اما فقط در جای درست:"
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
