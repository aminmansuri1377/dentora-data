  "steps": [
    {
      "id": "theory:d41c5da066b9dbce31239915f23581a4d91dd7b72bbe4218f8098082ed2747ce",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6f6d8c6d3c24eea149ade8e4246b87330eb3c1ea3d58f9aa13805080af6df37e",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "شش کلید Andrews برای اکلوژن مطلوب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "شش کلید Andrews، معیار کلاسیک اکلوژن مطلوب است:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رابطه‌ی مولری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " صحیح: کاسپ مزیوباکال مولر اول بالا در شیار باکال مولر اول پایین"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تیپ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (انگولیشن) مناسب تاج"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تورک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (اینکلیناسیون) مناسب تاج"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبود "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "روتیشن"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نبود "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فضای باز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و برقراری تماس‌های محکم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "منحنی اسپی "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مسطح"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تا خفیف"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 آنچه این فهرست را از یک سلیقه‌ی شخصی جدا می‌کند، روش به دست آمدنش است: این کلیدها از بررسی بیش از صد کست با اکلوژن "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "طبیعی و بدون درمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و استخراج ویژگی‌های مشترکشان به دست آمدند. یعنی معیار، طبیعت است نه نظر یک متخصص."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 و همین شش کلید، پایه‌ی "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیستم استریت‌وایر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شد: کلیدهای دوم و سوم مستقیماً به زاویه‌ی اسلات و شیب کف اسلات در براکت ترجمه شدند. یعنی پرسکریپشن براکت، تلاشی است برای ساختن این اهداف در خود دستگاه."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ اما کلید ششم را با احتیاط بخوان: منحنی کاملاً صاف در همه‌ی بیماران هدف نیست و کمی انحنا طبیعی است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:1a47ccbe2a35b671c0483219692ef1b0ec16516b58619f169a0dcca2c94ac0e0",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "abd7ddf406ecc45d7c5a960fdcde61dd4d7b04194024e540a809fe7ed7d81b51",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سنجش عینی به‌جای قضاوت چشمی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "«خوب به نظر می‌رسد» معیار قابل اتکایی نیست. سیستم‌های امتیازدهی عینی، کیفیت نتیجه را قابل اندازه‌گیری می‌کنند. محورهای اصلی سنجش:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هم‌ترازی و ردیف‌بندی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارتفاع مارجینال ریج‌ها"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اینکلیناسیون باکولینگوال"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تماس‌های اکلوزالی و روابط اکلوزالی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اورجت و تماس‌های بین‌دندانی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زاویه‌ی ریشه‌ها در رادیوگرافی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 ارزش واقعی این سیستم‌ها فقط نمره دادن نیست؛ "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یاد می‌دهند کجا را نگاه کنی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". کسی که چند بار کست خود را با این محورها ارزیابی کرده باشد، از آن پس همان نقاط را در بالین هم می‌بیند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 مفیدترین کاربردشان، ارزیابی "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کار خودت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است نه مقایسه با دیگران: کست پیش از دیباند را امتیاز بده، و ببین کدام محور به‌طور مکرر ضعیف است. الگویی که پیدا می‌کنی، همان چیزی است که باید در بیماران بعدی زودتر به آن بپردازی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ و محدودیتشان را هم بدان: این سیستم‌ها زیبایی لبخند، پروفایل و سلامت پریودنتال را نمی‌سنجند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:2d58391bffcbf9ed0b10cf5d1796d5faa7f90e40c87b849c903a0582874673f2",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "2df970948705a9e23b770432f5b1d6c3f0d73a7413a12401260a524a2d967f62",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه‌گانه‌ای که کیفیت واقعی را می‌سازد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کیفیت واقعی درمان روی سه محور سنجیده می‌شود، و هر سه باید برقرار باشند:"
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "محور"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "پرسش"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "عملکرد"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اکلوژن پایدار و سالم است؟ مفصل و عضلات راحت‌اند؟"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "زیبایی"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "لبخند، پروفایل و تقارن مطلوب‌اند؟"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "سلامت و پایداری"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "پریودنشیوم سالم؟ ریشه‌ها سالم؟ نتیجه ماندگار؟"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ نتیجه‌ای که در یکی از این سه ضعیف باشد، صرف‌نظر از امتیاز کست، درمان موفقی نیست. لبخند ردیف روی پریودنشیوم آسیب‌دیده، پیروزی نیست — و اکلوژن بی‌نقصی که پس از دو سال به هم می‌ریزد هم همین‌طور."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 دلیل اینکه هر سه محور لازم‌اند: آن‌ها مستقل نیستند و می‌توان یکی را به بهای دیگری بهبود داد. پروکلاین کردن بیش از حد ثنایاها، کراودینگ را حل می‌کند (محور اول و دوم) اما پریودنشیوم و پایداری را قربانی می‌کند (محور سوم). بدون سنجیدن هر سه، این معامله دیده نمی‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 به همین دلیل ارزیابی نهایی نباید فقط روی کست انجام شود: عکس صورت، ارزیابی پریودنتال و رادیوگرافی، هر کدام یکی از این محورها را می‌سنجند."
                }
              ]
            }
          ]
        }
      ],
