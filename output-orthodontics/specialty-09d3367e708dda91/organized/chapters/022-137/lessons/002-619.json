  "steps": [
    {
      "id": "theory:56e6989b07dd2668074187fee6ad133ccb88a5e94b361bc58ee09f2ec832dba9",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "ea80701f4320b543434b8c1ff4e74eda4ace5363d21d04ec9f88dc44ab577f28",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا اکلوژن پس از درمان ثابت، ناقص است؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پرسشی که پاسخش کل این درس را توضیح می‌دهد: چرا اکلوژن در پایان درمان ثابت، همیشه کمی ناقص است؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در طول درمان، براکت‌ها و سیم دندان‌ها را در موقعیت "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تحمیل‌شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نگه می‌دارند. سیم، هر دندان را در ارتفاع و زاویه‌ای که خودش تعیین کرده قفل کرده — و مانع می‌شود کاسپ‌ها آزادانه در فاسای دندان مقابل بنشینند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نتیجه: در پایان مکانیک، تماس‌های اکلوزالی اغلب "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناکامل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است — به‌ویژه در ناحیه‌ی خلفی، جایی که دقت نشستن کاسپ‌ها بیشترین اهمیت را دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 راه‌حل، اضافه کردن نیروی بیشتر نیست بلکه "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشتن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " محدودیت است: "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ستلینگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی اجازه دادن به دندان‌ها تا خودشان جا بیفتند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 این یکی از معدود مراحل ارتودنسی است که در آن کمتر کردن کنترل، نتیجه‌ی بهتری می‌دهد. اکلوژنی که خودش نشسته باشد، پایدارتر از اکلوژنی است که تو ساخته‌ای."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:74c78697673dcbf125dc399c99d5d839b1dcd6e6b3659e28cb8379cb956de245",
      "sourceId": null,
