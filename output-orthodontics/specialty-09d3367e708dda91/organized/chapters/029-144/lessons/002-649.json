  "steps": [
    {
      "id": "theory:f8ca47378c54aaf4cf9dbc09e5947f8a496f2cbae46d5dbdb6c34945eace703b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "1f9a40ccb3b6502856351e2854fa5185983e7eb1ddcc241566ae92343d4a182d",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تیم درمانی و تقویم آن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درمان شکاف، کار یک نفر نیست. تیم استاندارد شامل جراح، ارتودنتیست، گفتاردرمانگر، متخصص گوش و حلق و بینی، دندانپزشک کودکان، پروتزیست، ژنتیک و روان‌شناس است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تقویم درمان روی رشد کودک سوار است:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماه‌های نخست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیم لب. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حدود یک سالگی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیم کام — پیش از آنکه گفتار شکل بگیرد. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دوره‌ی دندانی مختلط:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیوند استخوان آلوئول؛ زمانش را تکامل ریشه‌ی کانین (یا لترال دائمی) تعیین می‌کند و ارتودنتیست پیش از آن قوس را با اکسپنشن آماده می‌کند. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوجوانی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درمان ارتودنسی جامع. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از مهار رشد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در صورت نیاز، جراحی ارتوگناتیک."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هر مداخله پنجره‌ی زمانی خودش را دارد و جابه‌جا کردنش هزینه می‌سازد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:e81a478ba8ee2eb8126e2c8a266e0cf3751caacecca4a3d5b8ef9780b5c6fc1a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "89a0dd122dc2e71ad221b134f6604dd54f2b68b8e2df708814fe32f4d09adc82",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا رشد ماگزیلا محدود می‌شود؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیماران شکاف کام اغلب ماگزیلای عقب‌مانده و تنگ دارند. اما این تنها پیامد خودِ شکاف نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بخش قابل توجهی از محدودیت رشد، از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بافت اسکار جراحی‌های ترمیمی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌آید. ترمیم کام، بافت اسکاری می‌سازد که مانند یک بند، رشد عرضی و قدامی ماگزیلا را مهار می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این یک معامله است: ترمیم زودهنگام کام برای گفتار ضروری است، ولی هزینه‌اش محدودیت رشد ماگزیلاست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نتیجه‌ی بالینی: در این بیماران انتظار کلاس III اسکلتی، تنگی عرضی و کراس‌بایت خلفی داشته باش — و برنامه‌ات را از ابتدا با آن بچین."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:86f332581d960af3076352c3f19b104b92ae475a4b572029ea5d201bc49620fd",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "f0f1a6c8ac0f1f90916bd4490a4e867b4edb5f307c8ee44fb02afe01f5e6355a",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اشتباه رایج: انتظار نادرست خانواده"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "خانواده‌ای که فرزندش را برای «چند جلسه ارتودنسی» آورده، باید بداند این یک مسیر چندساله و چندمرحله‌ای است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه نکته را از جلسه‌ی اول شفاف بگو: درمان تا پایان نوجوانی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرحله‌مرحله"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ادامه دارد؛ بخشی از بیماران در نهایت به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جراحی ارتوگناتیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌رسند؛ و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در بُعد عرضی شایع است و ریتنشن طولانی می‌خواهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک نکته‌ی عملی: از خانواده بخواه دفترچه‌ی درمان داشته باشد. در مسیری با این تعداد متخصص، هماهنگی خودش یک درمان است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
