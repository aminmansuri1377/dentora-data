                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "لنگرگاه"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بردار نیرو"
