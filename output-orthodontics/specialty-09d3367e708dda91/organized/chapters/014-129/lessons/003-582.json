                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "هر دو"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تقریباً افقی"
