          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه نوع هدگیر و بردار نیرو"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "انتخاب نوع هدگیر، عملاً انتخاب "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بردار نیرو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است — و بردار، اثر عمودی را تعیین می‌کند."
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
