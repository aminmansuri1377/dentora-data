                      "tag": "text",
                      "text": "موقعیت انسیزور پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کلید ثبات و زیبایی است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "FMA بالا (الگوی عمودی) ← باید IMPA را "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کمتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نگه داشت"
                    }
