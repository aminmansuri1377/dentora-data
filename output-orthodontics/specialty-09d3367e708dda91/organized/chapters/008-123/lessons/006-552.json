      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سوپرایمپوزیشن چه چیزهایی را آشکار می‌کند؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سهم "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رشد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در برابر سهم "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "درمان"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "میزان و جهت واقعی "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حرکت دندانی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چرخش"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فک‌ها در حین درمان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پاسخ یا عدم پاسخ به درمان ارتوپدیک"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 در پژوهش‌های ارتودنسی، سوپرایمپوزیشن ابزار اصلی سنجش تغییرات است. ولی خودِ آن فقط "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تغییر کل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را نشان می‌دهد؛ برای جدا کردن اثر درمان از رشد طبیعی، این تغییر باید با رشد مورد انتظار یا با گروه شاهدِ درمان‌نشده مقایسه شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و در کار بالینی روزمره هم دو کاربرد مستقیم دارد. اول، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارزیابی صادقانه‌ی نتیجه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": بدون آن، بهبودی که از رشد آمده به حساب درمان گذاشته می‌شود. دوم، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تصمیم میان‌درمانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": اگر پس از یک سال درمان فانکشنال، سوپرایمپوزیشن نشان دهد پاسخ اسکلتی رخ نداده، وقت بازنگری در طرح است — نه ادامه‌ی امیدوارانه."
                }
              ]
            }
          ]
        }
