                            {
                              "tag": "text",
                              "text": "فک"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ساختارهای پایدار"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "ماگزیلا"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کانتور قدامی زیگوما، ساختارهای داخلی کام"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "مندیبل"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کانال مندیبولار، کانتور داخلی سمفیز، کریپت مولر در حال تکامل، پیش از شروع تشکیل ریشه"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ چرا لبه‌های خارجی مناسب نیستند؟ چون همان سطوح در حال "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ریمادلینگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "اند و خودشان جابه‌جا می‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کار بیورک از همین مشکل آغاز شد: پیش از مطالعات ایمپلنتی او، سوپرایمپوزیشن روی سطوحی انجام می‌شد که ثابت فرض می‌شدند و نبودند — و به همین دلیل مقدار واقعی چرخش فک‌ها سال‌ها پنهان مانده بود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ساختارهای پایدار امروزی، بهترین جایگزین در دسترس برای آن ایمپلنت‌ها هستند."
                }
              ]
            }
          ]
        }
      ],
