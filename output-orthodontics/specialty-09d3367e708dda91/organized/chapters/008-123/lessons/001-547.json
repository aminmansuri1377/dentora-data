                              "tag": "text",
                              "text": "تصویر"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "چه می‌گوید"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "پانورامیک"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تعداد و مرحله‌ی تکامل دندان‌ها، نهفتگی، پاتولوژی، مورفولوژی کندیل"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "سفالوگرام جانبی"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "روابط اسکلتی ساژیتال و عمودی، شیب انسیزورها، پروفایل نرم‌بافتی"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "b",
                              "attributes": {},
                              "children": [
                                {
                                  "tag": "text",
                                  "text": "پری‌اپیکال"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "جزئیات ریشه، تحلیل، ضایعه‌ی موضعی"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "💡 سفالوگرام "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرونتال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تنها وقتی لازم است که عدم تقارن واضح یا مشکل عرضی جدی داشته باشی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک نکته درباره‌ی محدودیت پانورامیک: بزرگ‌نمایی در آن یکسان نیست و در نواحی مختلف قوس فرق می‌کند. پس برای "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اندازه‌گیری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — مثلاً عرض دندان نروییده — قابل اتکا نیست؛ برای "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حضور و موقعیت کلی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عالی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و برای ارزیابی دقیق طول یا تحلیل ریشه، پری‌اپیکال جایگزین ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سفالوگرام جانبی مهره‌های گردنی را هم نشان می‌دهد؛ پس برآورد مرحله‌ی بلوغ اسکلتی (CVM) بی‌پرتوی اضافه از همان تصویر به دست می‌آید."
                }
              ]
            }
          ]
        }
      ],
