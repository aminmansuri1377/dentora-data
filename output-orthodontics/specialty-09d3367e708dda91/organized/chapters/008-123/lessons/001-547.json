      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هر رادیوگرافی باید توجیه داشته باشد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اصل حاکم: "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ALARA"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — پرتوگیری تا حد ممکن کم."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه سؤال پیش از هر تصویربرداری:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این تصویر چه "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سؤالی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را پاسخ می‌دهد؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آیا پاسخ، "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تصمیم درمانی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را عوض می‌کند؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آیا تصویر "
                    },
                    {
                      "tag": "b",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کم‌پرتوتری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " همان پاسخ را می‌دهد؟"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ «رادیوگرافی روتین برای همه» یک پروتکل قابل دفاع نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پرسش دوم مهم‌ترین است و بیشترین تصویر غیرضروری را حذف می‌کند. اگر بدانی نتیجه هر چه باشد همان کار را می‌کنی، آن تصویر توجیه ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک ملاحظه‌ی اختصاصی: بافت در حال رشد کودک به پرتو "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حساس‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. همان تصویری که در بزرگسال به‌سادگی توجیه می‌شود، در کودک به دلیل قوی‌تری نیاز دارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
