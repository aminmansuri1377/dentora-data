                        {
                          "tag": "text",
                          "text": "دندان نهفته"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و ارزیابی تحلیل ریشه‌ی مجاور"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
