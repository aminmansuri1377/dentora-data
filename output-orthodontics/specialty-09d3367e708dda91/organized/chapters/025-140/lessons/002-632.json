  "steps": [
    {
      "id": "theory:bd44370b9e900a4a1af9471826184c64a588bfb6724e2ba7cc011421f6558c6a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6974ae71af9419428bbde5429de98571d2f915f0044470139789f9de33cabf6e",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تنگی عرضی: واقعی یا ظاهری؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از هر اکسپنشنی، دو پرسش را پاسخ بده: آیا پایه‌ی استخوانی باریک است، یا فقط دندان‌ها به لینگوال تیپ کرده‌اند؟ و اگر پایه باریک است، آیا دندان‌ها با تیپ باکالی آن را جبران کرده‌اند؟"
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "یافته"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تنگی اسکلتی واقعی"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "جبران دندانی"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "زاویه‌ی محوری مولرها"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "طبیعی"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "به باکال تیپ‌کرده"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "عرض پایه‌ی استخوانی"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "باریک"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "باریک، ولی عرض قوس دندانی طبیعی به نظر می‌رسد"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ظرفیت اکسپنشن دندانی"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "باقی‌مانده"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "مصرف‌شده"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ردیف سوم، خلاصه‌ی تصمیم است. در تنگی اسکلتی واقعی، دندان‌ها هنوز در وضعیت طبیعی‌اند و ظرفیتی برای تیپ کردن دارند. در جبران دندانی، بدن این ظرفیت را از قبل مصرف کرده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ اکسپنشن در دندان‌هایی که از قبل به باکال تیپ کرده‌اند، ریشه را از پوشش استخوانی خارج می‌کند و به دهیسنس و تحلیل لثه می‌انجامد — آسیبی که برگشت‌پذیر نیست و در سال‌های بعد خود را نشان می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👉 پس در جبران دندانی، راهبرد درست ممکن است اصلاً اکسپنشن نباشد، بلکه "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راست کردن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان‌های تیپ‌کرده و سپس ارزیابی مجدد باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:3f37e384cd0c949234c91055ddd0419ca28a6dbf44347130d97ac34864e695d7",
