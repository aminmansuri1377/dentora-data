    {
      "id": "theory:ed4f3b7a0ecdf9785a414138f2598d445a0512dadb3ebbc93cc754570848e3cc",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "e038ba1d8628df701fdf79a1cdd97f5db364fa1b7b93cd12964365aaebc021e8",
      "position": 3,
