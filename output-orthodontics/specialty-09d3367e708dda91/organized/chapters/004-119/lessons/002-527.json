                              "text": "آنکیلوز دندان شیری"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اینفرااکلوژن و کج شدن دندان‌های مجاور"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کیست فولیکولار"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "جابه‌جایی جوانه‌ی دندانی"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "👈 قاعده‌ی طلایی: هر تأخیر رویش "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نامتقارن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، یعنی رادیوگرافی — نه انتظار."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا تأکید بر نامتقارن؟ چون تنوع سن رویش میان افراد زیاد است ولی میان دو سمت یک نفر بسیار کم. اختلاف بیش از شش ماه با سمت مقابل، حساس‌ترین نشانه‌ی در دسترس توست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و هزینه‌ی انتظار واقعی است: مانعی که زود کشف شود اغلب با یک جراحی کوچک برطرف می‌شود؛ همان مانع اگر دیر کشف شود، به اکسپوز، ترکشن و ماه‌ها درمان نیاز پیدا می‌کند."
                }
              ]
            }
          ]
        }
