          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "موقعیت هر دندان، حاصل تعادل نیروهاست:"
                }
              ]
            },
            {
              "tag": "table",
              "attributes": {},
              "children": [
                {
                  "tag": "tbody",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "نیرو"
                            }
                          ]
                        },
                        {
                          "tag": "th",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اثر"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "زبان (از داخل)"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "به سمت بیرون"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "لب و گونه (از بیرون)"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "به سمت داخل"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فیبرهای پریودنتال"
                            }
                          ]
                        },
                        {
                          "tag": "td",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "حفظ موقعیت"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "⚠️ نکته‌ی کلیدی: نیروی "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سبک و مداوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان را حرکت می‌دهد؛ نیروی "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قوی و کوتاه‌مدت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — مانند جویدن یا بلع — نه."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به همین دلیل «فشار زبان هنگام بلع» به‌تنهایی علت اپن‌بایت نیست. بلع تنها چند دقیقه در شبانه‌روز طول می‌کشد؛ آنچه واقعاً اهمیت دارد "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وضعیت استراحت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " زبان است که ساعت‌ها ادامه دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ناحیه‌ای که این نیروها در آن به تعادل می‌رسند، "
                },
                {
                  "tag": "b",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای خنثی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (neutral zone) نام دارد؛ دندانی که از آن بیرون برده شود، میل به برگشت دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همین اصل پایه‌ی مکانیک ارتودنسی است: نیروی سبک و پیوسته، بهتر از نیروی سنگین و متناوب دندان را جابه‌جا می‌کند — و توضیح می‌دهد چرا الاینر باید روزی ۲۲ ساعت استفاده شود."
                }
              ]
            }
          ]
        }
      ],
