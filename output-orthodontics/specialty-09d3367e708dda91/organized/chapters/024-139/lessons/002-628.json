              "tag": "text",
              "text": "چرا زاویه کشش ماسک صورتی اهمیت دارد؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
