  "steps": [
    {
      "id": "theory:8f8bc6ffac8d2413f7e4e754842e899497134da86ce9d26eb65e7d84c87ea864",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "cdf34144d84490c051679e2a25bb64871903f0c192360e89718231401356f73a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کِی ارتودنسی تنها کافی نیست؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مرز میان کاموفلاژ و جراحی را سه چیز تعیین می‌کند:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱. شدت اختلاف اسکلتی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هرچه ANB و اندازه‌گیری‌های خطی از نُرم دورتر باشند، مقدار جبران دندانی لازم بیشتر است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲. ظرفیت محدوده‌ی حرکت دندانی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر رسیدن به هدف اکلوزالی نیازمند بردن دندان بیرون از پوشش استخوانی باشد، مرز رد شده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳. نیم‌رخ و انتظار بیمار."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاموفلاژ اکلوژن را درست می‌کند اما نیم‌رخ را اغلب بدتر — در بیماری که شکایت اصلی‌اش ظاهر صورت است، این معامله‌ی بدی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هیچ‌کدام از این سه به‌تنهایی تصمیم نمی‌سازند؛ تصمیم از کنار هم گذاشتن هر سه بیرون می‌آید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو قید دیگر را هم از همان جلسه‌ی اول در نظر بگیر. در بیمار در حال رشد، به‌ویژه کلاس III، تصمیم قطعی جراحی تا مهار رشد به تعویق می‌افتد. و بُعد عرضی را در موقعیت اصلاح‌شده‌ی ساژیتال بسنج: جلو آمدن مندیبل، بخش پهن‌تر قوس پایین را زیر ماگزیلا می‌آورد و تنگی عرضی پنهان را به‌شکل کراس‌بایت خلفی آشکار می‌کند؛ Le Fort I معمولی هم ماگزیلا را یک‌تکه جابه‌جا می‌کند و پهن نمی‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:b0a373a9f82837d4b862c34253dc9faac3d2655c78642f04d88acd302a47121e",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "d4c665cdf2d158abb1692de9c1e73d0132c6d07d13d9467220a382dfae40123c",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ابزارهای تصمیم: VTO و شبیه‌سازی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از تعهد به هر مسیری، نتیجه‌ی هر دو گزینه را روی کاغذ بساز."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "VTO درمانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشان می‌دهد اگر مسیر کاموفلاژ را برویم، انسیزورها کجا می‌ایستند و نیم‌رخ چه شکلی می‌شود. اگر زاویه‌ی انسیزور نهایی از محدوده‌ی قابل قبول بیرون بزند، همان‌جا پاسخ گرفته‌ای."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شبیه‌سازی جراحی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مقدار و جهت جابه‌جایی هر فک را برآورد می‌کند و اثرش را بر بافت نرم نشان می‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این دو را کنار هم به بیمار نشان بده. تصمیم نهایی با اوست، ولی باید هر دو تصویر را دیده باشد. در همین جلسه بسنج که انتظارش از تغییر چهره واقع‌بینانه است یا نه؛ انتظار غیرواقعی پس از یک عمل موفق هم نارضایتی می‌سازد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a372bc51ca026a49d82147066e47ebdca2f4deb38a35bbb13828ae42a578c197",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 25%;",
      "contentKey": "86bcbc97b8ada88a9360a20d6ee79479b95ccb2d724719d20ce40560d51f011f",
      "position": 3,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اشتباه رایج: تصمیم را وسط راه نگیر"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پرهزینه‌ترین خطا در این کیس‌ها این است: درمان با نیت کاموفلاژ شروع شود و در میانه‌ی کار به جراحی تغییر مسیر دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا گران است؟ چون آماده‌سازی جراحی "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خلاف"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آماده‌سازی کاموفلاژ است. در کاموفلاژ جبران‌های دندانی را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "می‌سازی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ در آماده‌سازی جراحی همان جبران‌ها را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برمی‌داری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". یعنی ماه‌ها کار باید عکس شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و از نظر بیمار بدتر است: کسی که برای «صاف کردن دندان» آمده، حالا باید جراحی فک را بپذیرد. اعتماد اینجا می‌شکند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس تصمیم را در فاز تشخیص بگیر، نه در ماه دوازدهم."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
