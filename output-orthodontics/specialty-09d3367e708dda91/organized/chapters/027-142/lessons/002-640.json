      "contentKey": "ec90ff8f3112712a959a79973609edff8839de0e3b1e866c511d9ae6d7eeec51",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آماده‌سازی پیش از جراحی: برداشتن جبران‌ها"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بدن سال‌ها کوشیده اختلاف اسکلتی را با کج کردن دندان‌ها بپوشاند. در کلاس II، قدام بالا رتروکلاین و قدام پایین پروکلاین شده؛ در کلاس III برعکس."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هدف آماده‌سازی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشتن همین جبران‌هاست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — یعنی هر دندان را به موقعیت درست خودش "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نسبت به پایه‌ی استخوانی خودش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برگرداندن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نتیجه‌اش غافلگیرکننده است: اکلوژن بیمار در پایان این فاز "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از ابتدای درمان می‌شود. اورجت در کلاس II بیشتر و در کلاس III منفی‌تر می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این بدتر شدن، نشانه‌ی درست پیش رفتن کار است — نه اشتباه."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a3c711a720661565dbd865fa687a2080b6dd69130285feb29066ac4bd90ef31b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 12.5%;",
      "contentKey": "8254b95dd41c754f4247d8421252349ee57f22b0b734f59770079171b9116572",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه هدف دیگر فاز پیش از جراحی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جز برداشتن جبران‌ها، سه کار باید تمام شود:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هماهنگی عرضی قوس‌ها."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جراح دو قوس را در موقعیت تازه کنار هم می‌گذارد؛ اگر عرضشان نخواند، اکلوژن پس از جراحی قفل نمی‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراز کردن و رفع روتیشن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در هر قوس به‌طور جداگانه، تا مدل‌های جراحی بتوانند دقیق روی هم بنشینند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعبیه‌ی قلاب‌های جراحی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی سیم مستطیلی سنگین، برای فیکساسیون بین‌فکی حین و پس از عمل."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سیم پیش از جراحی باید سفت و غیرفعال باشد — نه NiTi انعطاف‌پذیر."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
