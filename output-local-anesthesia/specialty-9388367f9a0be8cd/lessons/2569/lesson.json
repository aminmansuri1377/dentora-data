  "steps": [
    {
      "id": "theory:0dbb1ddc2da5be1e002499be182b194293eddbba7de2cb289c35227aee595677",
      "position": 1,
      "kind": "theory",
      "sourceQuestionId": null,
      "sourceStepId": null,
