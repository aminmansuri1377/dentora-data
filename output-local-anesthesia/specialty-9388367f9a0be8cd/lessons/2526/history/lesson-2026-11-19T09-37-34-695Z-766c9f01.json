              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محل ورود و جای نشستن مثل بلاک منتال است: سوزن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کوتاه گیج ۲۷"
                    }
