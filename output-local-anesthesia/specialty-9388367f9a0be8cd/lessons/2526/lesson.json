                  },
                  "assetPath": "assets/e76961c9c623f5731c31d1ef46133e8dbe952fa4db4c0ba13f4eb886b31036ed.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لب را کنار بکش تا ورود سوزن در وستیبول کنار سوراخ منتال دیده و بی‌آسیب انجام شود. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
