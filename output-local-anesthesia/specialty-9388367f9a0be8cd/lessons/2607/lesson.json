                    },
                    {
                      "tag": "text",
                      "text": " گرما نگذارد؛ گرمای زودهنگام رگ را گشاد و هماتوم را بزرگ‌تر می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از روز بعد کمپرس گرم مرطوب، هر ساعت ۲۰ دقیقه؛ برای درد مسکن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
