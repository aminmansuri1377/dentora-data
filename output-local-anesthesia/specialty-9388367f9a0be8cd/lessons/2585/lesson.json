            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اپی‌نفرین ۱:۵۰٬۰۰۰ خون‌ریزی جراحی پریو را نسبت به ۱:۱۰۰٬۰۰۰ حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نصف"
