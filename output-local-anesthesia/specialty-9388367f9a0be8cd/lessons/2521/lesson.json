                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمق را با جثه‌ی بیمار تنظیم کن؛ در بیمار کوچک‌جثه کمتر از ۱۶ میلی‌متر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شمار ورود سوزن را کم نگه دار و با سوزن در بافت کاوش نکن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در بیمار با اختلال انعقادی PSA نزن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اقدام فوری"
