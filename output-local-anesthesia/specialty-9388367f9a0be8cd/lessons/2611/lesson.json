          "children": [
            {
              "tag": "text",
              "text": "علائم مسمومیت خفیف تا شدید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "هشت دقیقه پس از سه کارپول برای IANB دوطرفه، بیمار ۲۸ ساله‌ای تندتند حرف می‌زند، از طعم فلزی و وزوز گوش می‌گوید و کلماتش بریده‌بریده شده است. این‌ها اضطراب ساده است یا نشانه‌ی چیزی جدی‌تر؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-2-8.webp",
                  "alt": "در مرحله‌ی تشنج مسیرهای مهاری مغز کاملاً سرکوب شده‌اند و تحریک بی‌مهار می‌ماند.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/e672acd9ead715b942a2345c5c9c643273bb7adf12af9bf6abfc3c43634fd180.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در مرحله‌ی تشنج مسیرهای مهاری مغز کاملاً سرکوب شده‌اند و تحریک بی‌مهار می‌ماند. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 2.8)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علائم با بالا رفتن سطح خونی پیش می‌روند. اول مرحله‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تحریک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌آید، بعد "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرکوب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آنچه می‌بینی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرحرفی، هیجان و دلهره"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لکنت در گفتار که به پرش عضلات و لرزش انتهای اندام‌ها می‌رسد"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نیستاگموس، تعریق و استفراغ"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گیجی و اطاعت نکردن از دستور"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بالا رفتن فشار خون، نبض و تعداد تنفس"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آنچه بیمار می‌گوید"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سبکی سر، سرگیجه، بی‌قراری و عصبی بودن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کرختی، طعم فلزی، وزوز گوش و ناتوانی در تمرکز دید"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حس پرش عضلات، پیش از آنکه پرش دیده شود"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خواب‌آلودگی و سرانجام از دست رفتن هوشیاری"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در سطح بالاتر، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تشنج تونیک‌ـ‌کلونیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌آید و پس از آن سرکوب عمومی دستگاه عصبی مرکزی با افت فشار، نبض و تنفس."
                }
              ]
            }
          ]
        }
      ],
