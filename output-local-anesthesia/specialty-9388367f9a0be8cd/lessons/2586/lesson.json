                        {
                          "tag": "text",
                          "text": "۰٫۲ میلی‌گرم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ ۵٫۵ کارپول ۱:۵۰٬۰۰۰ یا ۱۱ کارپول ۱:۱۰۰٬۰۰۰"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار قلبی ASA III یا IV: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۰۴ میلی‌گرم"
                        }
