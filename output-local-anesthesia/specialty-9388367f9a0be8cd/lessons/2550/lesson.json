                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل ورود سوزن در P-ASA: کنار پاپیلای اینسیزیو، در شیار کنار آن. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
