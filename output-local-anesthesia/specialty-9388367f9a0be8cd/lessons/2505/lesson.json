              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن را آرام تا استخوان جلو ببر. در بزرگسال میانگین عمق تا استخوان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲۰ تا ۲۵ میلی‌متر"
