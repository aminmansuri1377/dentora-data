                      "children": [
                        {
                          "tag": "text",
                          "text": "سن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در کودک خردسال و سالمند بسیار مسن (بالای ۸۵ سال) جذب، متابولیسم و دفع ضعیف‌تر است."
                    }
