  "steps": [
    {
      "id": "theory:868cb773aeeae03662fbed3f8adf93986d57cf5a3dfdca93bd6f282eff2531c0",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f1538760232ae00ea98952a06b75d952eb4483df784eafefed22d07de98a7b43",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بی‌حسی بافت نرم و گاز گرفتن لب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پسری ۵ ساله پس از ترمیم مولر شیری پایین با IANB مرخص شد. عصر مادرش زنگ می‌زند: لب پایین کودک زخم و متورم است. چه چیزی پیشگیری‌پذیر بود؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-16-5.webp",
                  "alt": "زخم لب پایین از گاز گرفتن در زمان بی‌حسی؛ بی‌حسی بافت نرم خیلی بیشتر از پالپ می‌ماند.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/e4ba1cb3681823c07b95b93b288c51eafcda6d5a40b4cbed7a8d609018248146.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زخم لب پایین از گاز گرفتن در زمان بی‌حسی؛ بی‌حسی بافت نرم خیلی بیشتر از پالپ می‌ماند. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 16.5)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بی‌حسی بافت نرم خیلی بیشتر از پالپ می‌ماند و گاهی ۴ ساعت یا بیشتر. بیشتر آسیب‌ها در لب پایین است، کمتر در زبان و به‌ندرت در لب بالا. پرخطرها: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودک کم‌سن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، سالمند بالای ۸۵ سال و بیمار دارای ناتوانی ذهنی یا جسمی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس از IANB در کودکان، گاز گرفتن لب و زبان زیر ۴ سال حدود ۱۸٪، در ۴ تا ۷ سال ۱۶٪، در ۸ تا ۱۱ سال ۱۳٪ و از ۱۲ سال به بعد ۷٪ است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیشگیری"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دارویی بزن که مدتش با کار بخواند؛ مپیواکائین ۳٪ ساده ۲۰ تا ۴۰ دقیقه بی‌حسی پالپ می‌دهد، هرچند هنوز ثابت نشده داروی ساده آسیب لب را کم کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فنتولامین را در پایان کار، در همان محل و با همان تکنیک تزریق قبلی بزن. فقط بی‌حسیِ داروی دارای تنگ‌کننده را کوتاه می‌کند؛ زیر ۳ سال یا زیر ۱۵ کیلوگرم توصیه نمی‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به کودک و همراه بزرگسالش درباره‌ی گاز گرفتن، مکیدن و خوردن غذای داغ هشدار بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر هنگام رفتن هنوز بی‌حس است، رول پنبه‌ای بسته به نخ دندان را در وستیبول بگذار یا برچسب یادآور روی لباس بچسبان."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درمان: اطمینان دادن، صبر تا برگشت حس و وازلین روی زخم."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:66cb7991d7d3801784afb9980d87e8ea79ea56425bdca77a179feb95ac1a34b4",
      "sourceId": null,
      "identityOrigin": "local-step",
