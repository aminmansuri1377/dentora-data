  "steps": [
    {
      "id": "theory:f1da7f0ee97d3a7da341de09dfcd7ded3e31889f23628df8daf56a2fa97c13c7",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "369385dfe0f69c7b4ba76993704425bb1f1e750e91ffea2104b35c0abd1309bc",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تزریق اینتراسپتال: کاربرد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "قرار است روی ناحیه‌ی پرمولر و مولر پایین یک فلپ پریودنتال کوچک بزنی. سالکوس ملتهب است و پاکت‌ها عمیق‌اند. هم بی‌حسی می‌خواهی، هم خون‌ریزی کم، و بیمار نمی‌خواهد تا عصر زبانش بی‌حس باشد. PDL گزینه‌ی خوبی است؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تزریق اینتراسپتال (crestal anesthesia) خویشاوند PDL است، با یک تفاوت مهم: سوزن از وسط پاپیل بین‌دندانی مستقیم وارد استخوان سپتوم می‌شود، نه از سالکوس. پس وقتی سالکوس عفونی یا ملتهب است، این تزریق جایگزین مناسبی است. دارو مثل PDL از استخوان مغزی پخش می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کاربردها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی استخوان و بافت نرم همراه با هموستاز در کورتاژ و جراحی فلپ پریودنتال"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترمیم‌های کوچک دندان‌های خلفی پایین"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان درگیر پریودنتال، چون از پاکت عفونی دور می‌ماند"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در مقایسه با IANB برای ترمیم کلاس ۱ خلفی پایین، اینتراسپتال حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰٫۴ میلی‌لیتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارو خواست در برابر حدود ۲ میلی‌لیتر، درد تزریق کمتری داشت و موفقیتش بیشتر بود (۹۶ تا ۱۰۰٪ در برابر ۸۲ تا ۹۳٪). اما بی‌حسی پالپ کوتاه‌تر بود: حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲۳ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در برابر ۳۲ دقیقه. در بیمار جوان، به دلیل تراکم کمتر استخوان، موفق‌تر است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:06c6e4d607579e50cb11bbda1b25c9a5ce0d7f5e37408e9b1d99a5c83e7b2c28",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
