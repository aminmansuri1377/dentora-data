  "steps": [
    {
      "id": "theory:a86959e11da5a2c824e1b40e5065ae7972887a3be5e94c5c9989a913c394e4ff",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "7734021e8c2005e717ff96dbe9d9b1cbd22da381d0a98997f50b4a31d1a58c46",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پتانسیل استراحت و دپلاریزاسیون"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پس از بلاک عصب آلوئولار تحتانی (IANB)، تزریقی که دندان‌های فک پایین یک سمت را بی‌حس می‌کند، لب بیمار کرخت است و تراش مینا را بی‌دردسر تحمل کرده. همین که فرز به عاج نزدیک پالپ می‌رسد، دستش را بالا می‌آورد. چرا محرک ضعیف‌تر به مغز نرسید و محرک قوی‌تر رسید؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-1-10.webp",
                  "alt": "در دپلاریزاسیون کانال‌های سدیم باز می‌شوند و یون سدیم آزادانه به درون عصب می‌رود.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/40ba68de58714c677086b3bdbd5406eff482f346dfd4ebe0667b043fe0dbefd0.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در دپلاریزاسیون کانال‌های سدیم باز می‌شوند و یون سدیم آزادانه به درون عصب می‌رود. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 1.10)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عصب در حال استراحت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پتانسیل استراحت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد: درون غشا حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "منفی ۷۰ میلی‌ولت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نسبت به بیرون. این اختلاف از تفاوت غلظت یون‌ها می‌آید:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پتاسیم درون سلول ۱۱۰ تا ۱۷۰ و بیرون ۳ تا ۵ میلی‌اکی‌والان در لیتر"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سدیم درون سلول ۵ تا ۱۰ و بیرون حدود ۱۴۰"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غشای در حال استراحت برای پتاسیم و کلر آزادانه نفوذپذیر است و برای سدیم فقط اندکی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مراحل ایمپالس"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محرک شیمیایی، گرمایی، مکانیکی یا الکتریکی غشا را آهسته کمتر منفی می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی پتانسیل حدود ۱۵ میلی‌ولت کم شود و به "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آستانه‌ی شلیک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (منفی ۵۰ تا ۶۰) برسد، کانال‌های سدیم باز می‌شوند و سدیم تند وارد می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درون غشا به "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مثبت ۴۰ میلی‌ولت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌رسد. کل دپلاریزاسیون حدود ۰٫۳ میلی‌ثانیه است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تغییر کمتر از ۱۵ میلی‌ولت ایمپالسی نمی‌سازد. ایمپالسی که راه افتاد، اندازه و شکلش با قوی‌تر شدن محرک عوض نمی‌شود. بی‌حسی موضعی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آستانه را بالا می‌برد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": سدیم بیشتری لازم است تا غشا به آستانه برسد. در بلاک ناقص، محرک قوی‌تر ممکن است هنوز به این آستانه‌ی بالاتر برسد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:30ee14387617541d2a5a409ea67275870a5875ae8628582196af9d477e5ddb0e",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "72307693adf9df456ead12b8eb2f40bd10835a9870cf11939c565ff47393b2e2",
      "position": 2,
      "kind": "theory",
