  "steps": [
    {
      "id": "theory:9445a5b5d261e4cc667d5722bf4f3dd81acecef83f06a1bf2c0798e56024fb55",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "637d871fe67f008a86efb03b6944f445052161e858856fccadf8d561e46e2d14",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بلاک عصب ماگزیلاری: کی و چرا"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مردی ۵۰ ساله برای کشیدن همه‌ی دندان‌های باقی‌مانده‌ی فک بالای راست و آلوئولوپلاستی آمده است. برای بی‌حسی کل این نیم‌فک دست‌کم چهار بلاک جداگانه لازم است. راه کوتاه‌تری هست؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-54.webp",
                  "alt": "ناحیه‌ی بی‌حس بلاک ماگزیلاری: نیم‌فک بالا، از دندان‌ها تا کام و بافت باکال، همان طرف.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/c730c23a088ea2044c032f1f98b8117214eb2f45576225de440480c50e92818c.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناحیه‌ی بی‌حس بلاک ماگزیلاری: نیم‌فک بالا، از دندان‌ها تا کام و بافت باکال، همان طرف. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.54)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بلاک عصب ماگزیلاری (V2) با یک تزریق نیم‌فک بالا را عمیق بی‌حس می‌کند. محلول در حفره‌ی پتریگوپالاتین (pterygopalatine fossa)، کنار تنه‌ی عصب ماگزیلاری، می‌نشیند. موفقیتش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیش از ۹۵٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ناحیه‌ی بی‌حس (همان طرف)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پالپ همه‌ی دندان‌های بالا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پریودنشیوم باکال و استخوان روی آن‌ها."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کام سخت و بخشی از کام نرم، تا خط وسط."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پوست پلک پایین، کنار بینی، گونه و لب بالا."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کاربرد"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جراحی دهان، پریو یا درمان ترمیمی گسترده روی کل نیم‌فک."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی التهاب یا عفونت اجازه‌ی بلاک آلوئولار فوقانی خلفی (PSA)، اینفیلتراسیون یا بلاک‌های دیگر را نمی‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تشخیص یا درمان نورالژی شاخه‌ی دوم عصب سه‌قلو."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به‌جای چهار بلاک PSA، بلاک ASA (اینفرااوربیتال)، پالاتین بزرگ و نازوپالاتین، یک ورود سوزن و ۱٫۸ میلی‌لیتر به‌جای ۲٫۷ میلی‌لیتر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "منع:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تزریق‌کننده‌ی کم‌تجربه، کودک (بلاک‌های دیگر در کودک بسیار موفق‌اند)، بیمار ناهمکار، التهاب یا عفونت روی محل ورود، و هموفیلی یا مصرف داروی ضدانعقاد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:518086827562e78573b174d0b5ed77992057b78e58aaacb1a7954f88c6eeaf2b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "e3331778e98d931df2e40b4ee461d075f96433ed719fdd91bc2c7be24bcefcf4",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تکنیک توبروزیته‌ی بالا (high-tuberosity)"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بلند، گیج ۲۵"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ بلند گیج ۲۷ هم قابل قبول است. اول طول سوزن را از نوک تا هاب اندازه بگیر؛ میانگین حدود ۳۲ میلی‌متر است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-55.webp",
                  "alt": "مسیر توبروزیته‌ی بالا: سوزن از عمق وستیبول بالای مولر دوم رو به بالا، داخل و عقب تا حفره‌ی پتریگوپالاتین.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/25619dfc1ec1eb0249fdd0bd741b19c25d6178dbf202c583e51dcf1eb7a0250f.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسیر توبروزیته‌ی بالا: سوزن از عمق وستیبول بالای مولر دوم رو به بالا، داخل و عقب تا حفره‌ی پتریگوپالاتین. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.55)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندانپزشک راست‌دست برای سمت چپ در ساعت ۱۰ و برای سمت راست در ساعت ۸ رو به بیمار می‌نشیند. بیمار خوابیده یا نیمه‌خوابیده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقطه‌ی ورود: عمق وستیبول بالای دیستال مولر دوم. لندمارک‌ها: همین نقطه، توبروزیته‌ی ماگزیلا و زائده‌ی زایگوماتیک ماگزیلا. بول رو به استخوان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دهان نیمه‌باز، فک پایین کشیده به سمت تزریق؛ گونه را با آینه کنار بزن و بافت را کشیده کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن را مثل PSA بالا، داخل و عقب ببر، ولی تا عمق "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳۰ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ". هدف بالاتر و داخلی‌تر از هدف PSA است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نباید مقاومتی حس کنی؛ اگر حس کردی، زاویه‌ی سوزن به سمت خط وسط زیاد است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در دو صفحه آسپیره کن: سرنگ را حدود ۴۵ درجه بچرخان و دوباره آسپیره کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱٫۸ میلی‌لیتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را در بیش از ۶۰ ثانیه تزریق کن و در این میان چند بار آسپیره کن. دست‌کم ۳ تا ۵ دقیقه صبر کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "عارضه‌ی اصلی این راه هماتوم است: اگر شریان ماگزیلاری سوراخ شود، هماتوم سریع بزرگ می‌شود. این راه لندمارک استخوانی ندارد و سوزنِ نسنجیده بیش از حد فرو می‌رود. هموستاز هم نمی‌دهد؛ برای جراحی کمی محلول با تنگ‌کننده در محل عمل اینفیلتره کن."
                }
              ]
            }
          ]
        }
      ],
