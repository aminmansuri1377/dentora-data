  "steps": [
    {
      "id": "theory:34b7076ebac83d4e1b43734af1a4dd62fef0cb29e550d2a3aaa8521624fae48f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "a0db58427288bc0c72eae27caffe714489ad55287fec693998e80092269dda2b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا بیشتر بی‌حسی‌ها تنگ‌کننده دارند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانمی ۵۰ ساله با آسم وابسته به کورتون در پرسشنامه نوشته که به سولفیت آلرژی اثبات‌شده دارد و پس از خوردن میوه‌ی خشک سولفیت‌دار دچار تنگی نفس شده است. برای ترمیم پرمولر پایین، کدام کارپول را برمی‌داری؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بی‌حسی‌های موضعی تزریقی کم یا زیاد رگ را گشاد می‌کنند. رگ گشاد یعنی دارو زودتر از محل تزریق به خون می‌رود. نتیجه سه چیز است:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی کوتاه‌تر و سطحی‌تر؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سطح خونی بالاتر دارو و خطر بیشتر مسمومیت؛"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خون‌ریزی بیشتر در محل کار."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترتیب گشادکنندگی رگ"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پروکائین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": بیشترین؛ بی‌حسی پالپ عملاً نمی‌داد و فقط ۱۵ تا ۳۰ دقیقه بافت نرم را بی‌حس می‌کرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لیدوکائین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کمتر از پروکائین؛ لیدوکائین ۲٪ ساده فقط "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵ تا ۱۰ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پالپ را بی‌حس می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مپیواکائین و پریلوکائین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کمتر از لیدوکائین؛ برای همین این دو به شکل ساده کاربرد روزمره دارند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لیدوکائین ساده در دندانپزشکی کاربرد بالینی کمی دارد و در بسیاری از بازارها دیگر در کارپول دندانی عرضه نمی‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:0484bd8a1f030f1a72feac3144f83660c14d5bbc8a78d43cadd9caf6f770a8d6",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "bd10673d3325588144cc7c609122b201543cbe0afb21ca95fbcfd519913ec9e5",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چه زمانی داروی ساده"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "داروی ساده کوتاه‌تر اثر می‌کند و هموستاز نمی‌دهد، اما در این موقعیت‌ها انتخاب درستی است:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آلرژی اثبات‌شده به سولفیت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": بی‌سولفیت آنتی‌اکسیدان تنگ‌کننده است و در همه‌ی کارپول‌های دارای تنگ‌کننده هست، ولی در محلول ساده نیست. این منع مطلق تنگ‌کننده است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیماری قلبی‌عروقی قابل‌توجه یا پرکاری تیروئید بالینی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (ASA III یا IV): مپیواکائین ۳٪ یا پریلوکائین ۴٪ با بلاک از گزینه‌هاست؛ اپی‌نفرین ۱:۱۰۰٬۰۰۰ یا ۱:۲۰۰٬۰۰۰ با حجم کم هم پذیرفتنی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کار کوتاه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " که بی‌حسی پالپ طولانی یا عمیق نمی‌خواهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خطر آسیب به خود"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کودک خردسال، سالمند بالای ۸۵ سال، بیمار با ناتوانی جسمی یا ذهنی که ممکن است لب یا زبان بی‌حس را بجود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیماری که نمی‌تواند وعده‌ی غذا را جا بیندازد، مثل بیمار دیابت نوع یک."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر همین بیماران کار طولانی یا بی‌حسی عمیق‌تر لازم دارند، داروی ساده کافی نیست و محلول دارای تنگ‌کننده لازم است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "نکته‌ی طلایی: ساده بودن محلول سطح خونی دارو را پایین نمی‌آورد؛ جذب سریع‌تر آن را بالاتر هم می‌برد. تنگ‌کننده‌ی کمتر را با داروی کمتر یکی نگیر و همان سقف میلی‌گرم را رعایت کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
