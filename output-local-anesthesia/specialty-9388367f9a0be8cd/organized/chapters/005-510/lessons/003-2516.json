                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن را عقب بکش تا حدود یک‌چهارم آن در بافت بماند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدنه‌ی سرنگ را عقب‌تر ببر، روی مولرهای سمت مقابل."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دوباره پیش برو تا در عمق ۲۰ تا ۲۵ میلی‌متر به استخوان برسی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "تا سوزن به استخوان نخورده، در IANB دارو تزریق نکن."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تزریق تند"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تزریق یک کارپول ۱٫۸ میلی‌لیتری در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم ۶۰ ثانیه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بی‌حسی پالپ موفق‌تری از تزریق همان حجم در ۱۵ ثانیه می‌دهد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "صبر کوتاه"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بی‌حسی بافت نرم زودتر از پالپ می‌آید. پس از IANB با لیدوکائین ۲٪ و اپی‌نفرین، سهم بیماران با بی‌حسی پالپ در دقیقه‌ی ۴ حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲۵٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، در دقیقه‌ی ۱۰ حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶۰٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و در دقیقه‌ی ۱۵ حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶۷٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. پیش از آنکه IANB را شکست‌خورده بدانی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۰ تا ۱۵ دقیقه"
                    }
