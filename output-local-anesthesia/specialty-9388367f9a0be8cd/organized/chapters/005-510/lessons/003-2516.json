                    {
                      "tag": "text",
                      "text": "سوزن بی‌برخورد با استخوان خیلی خلفی است؛ کمی عقب بکش، بدنه‌ی سرنگ را روی مولرها بیاور و دوباره وارد کن. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 14.10)"
                        }
                      ]
