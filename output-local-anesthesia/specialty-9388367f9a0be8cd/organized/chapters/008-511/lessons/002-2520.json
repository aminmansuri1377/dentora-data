  "steps": [
    {
      "id": "theory:8a6ec9b434b60f92c8fe39fc2a267cad0bb9da6329a71375f8e4ba574786706f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f3f9fc4a1e326e934b8c7887e0680985228affebb9e1daf8305ec01c3ffe9270",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بلاک PSA: کی و برای کدام دندان‌ها"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "آقایی ۴۰ ساله برای ترمیم مولر اول و دوم و سوم بالا در یک جلسه آمده است. می‌توانی سه اینفیلتراسیون جدا بزنی یا یک تزریق. کدام را انتخاب می‌کنی و چرا؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-7.webp",
                  "alt": "ناحیه‌ی بی‌حس بلاک PSA: مولرهای بالا، جز گاهی ریشه‌ی مزیوباکال مولر اول، و بافت باکال آن‌ها.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/b67ce8a9919c3453d7172ed0f92fdbd90d59073a3ecb828e0e87177f12ef320b.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناحیه‌ی بی‌حس بلاک PSA: مولرهای بالا، جز گاهی ریشه‌ی مزیوباکال مولر اول، و بافت باکال آن‌ها. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.7)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بلاک عصب آلوئولار فوقانی خلفی (PSA) که به آن tuberosity block هم می‌گویند، عصب PSA را پشت توبروزیته، پیش از ورود به استخوان، بی‌حس می‌کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ناحیه‌ی بی‌حس"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پالپ مولر سوم، دوم و اول بالا (ریشه‌ی مزیوباکال مولر اول در حدود ۲۸٪ بیماران بی‌حس نمی‌شود)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پریودنشیوم و استخوان باکال روی همین دندان‌ها"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اندیکاسیون‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دو مولر یا بیشتر"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی اینفیلتراسیون منع دارد، مثلاً عفونت یا التهاب حاد روی دندان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی اینفیلتراسیون جواب نداده است"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مزیت‌ها: موفقیت بیش از ۹۵٪، یک تزریق به‌جای سه، و حجم کمتر؛ همان سه اینفیلتراسیون روی هم ۱٫۸ میلی‌لیتر می‌شود. درست زده شود بی‌درد است، چون سوزن به استخوان نمی‌خورد و فضای بافتی بزرگ است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عیب‌ها: خطر هماتوم، نبود لندمارک استخوانی هنگام ورود سوزن، و آسپیراسیون مثبت حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳٫۱٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". در بیمار با اختلال انعقادی یا مصرف داروهای ضدانعقاد و ضدپلاکت، اینفیلتراسیون یا تزریق PDL را جایگزین کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:2a548115c347270b274553e1fb09480be99e072ae57194ad2e73beb0d42f7852",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "03d19b3c1eee995968e6527daad4fb89eb0d3e0c33588396b60624d27cb9dec8",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تکنیک بلاک PSA"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کوتاه، گیج ۲۷"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". نقطه‌ی ورود: عمق وستیبول بالای مولر دوم. لندمارک‌ها: توبروزیته و زائده‌ی زایگوماتیک."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-10.webp",
                  "alt": "جهت سوزن در بلاک PSA را ببین: هم‌زمان رو به بالا، داخل و عقب.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/e1e5468d7a1fc5bc2eb894f3283d967e23535759f47a876e895f804223fa82db.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جهت سوزن در بلاک PSA را ببین: هم‌زمان رو به بالا، داخل و عقب. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.10)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راست‌دست: سمت چپ بیمار ساعت ۱۰، سمت راست ساعت ۸، رو به بیمار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی سطحی را دست‌کم ۱ دقیقه بگذار و بول را رو به استخوان بچرخان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دهان نیمه‌باز، فک پایین به سمت تزریق؛ گونه را با آینه کنار بزن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن را با یک حرکت پیوسته به بالا، داخل و عقب ببر، هر کدام ۴۵ درجه: بالا و داخل نسبت به صفحه‌ی اکلوزال، عقب نسبت به محور طولی مولر دوم."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در بزرگسال معمول ۱۶ میلی‌متر جلو برو؛ با سوزن کوتاه (حدود ۲۰ میلی‌متر) حدود ۴ میلی‌متر بیرون می‌ماند و با سوزن بلند (حدود ۳۲ میلی‌متر) نیمی از طول آن. در بزرگسال کوچک‌جثه و کودک ۱۰ تا ۱۴ میلی‌متر کافی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در دو صفحه آسپیره کن، سپس "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۹ تا ۱٫۸ میلی‌لیتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را در ۳۰ تا ۶۰ ثانیه تزریق کن و در این مدت چند بار آسپیره کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳ تا ۵ دقیقه صبر کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اگر سوزن به استخوان خورد، زاویه‌ی رو به داخل زیاد است: کمی عقب بکش، سرنگ را به صفحه‌ی اکلوزال نزدیک‌تر کن و دوباره جلو برو. بی‌حسی زبان یا لب پایین یعنی محلول زیادی خارجی نشسته و به شاخه‌ی مندیبولار رسیده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار معمولاً بی‌حسی را حس نمی‌کند؛ پالپ را با اسپری سرما یا EPT بسنج."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
