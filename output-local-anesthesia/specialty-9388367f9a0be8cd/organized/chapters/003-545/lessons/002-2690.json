                    "height": ""
                  },
                  "assetPath": "assets/0a0631ea4805ff7822d1b4d130a27507621eec4d5d6df9c338046e0ec0ef82de.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسیر بخش خلفی V3: اوریکولوتمپورال، لینگوال و آلوئولار تحتانی. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 12.14)"
                        }
