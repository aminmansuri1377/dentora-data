  "steps": [
    {
      "id": "theory:e4f1c5e191df1bb7511a1ff0787331cc59530cae6b1d604fa214087511f7ca52",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "30f389f01389419bffd949720c75837fe9c1c7b830120286c7825c625208cae6",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تنگ‌کننده در بیمار قلبی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مردی ۶۴ ساله با آنژین پایدار که فقط با فعالیت سنگین درد سینه می‌گیرد، برای کشیدن مولر اول پایین آمده است. فشارش ۱۴۸/۸۸ است. دستیار می‌گوید «برای قلبش بی‌حسی بدون اپی‌نفرین بزنیم». موافقی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بیمار قلبی، خطر اپی‌نفرین را در برابر خطر بی‌حسی ناکافی بسنج. درد ناگهانی کاتکول‌آمین درونی آزاد می‌کند و ممکن است بیش از اپی‌نفرین کارپول به قلب فشار بیاورد. بیماری که بیماری‌اش تشخیص داده شده و کنترل است (ASA II یا III)، تنگ‌کننده را با سه شرط می‌گیرد:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آسپیراسیون منفی پیش از تزریق"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تزریق آهسته"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمترین دوز مؤثر؛ در بیمار قلبی ASA III یا IV حداکثر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۰۴ میلی‌گرم"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کِی درمان انتخابی را عقب بیندازی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "MI یا سکته‌ی مغزی در ۳ ماه گذشته (ASA IV)، تا مشورت با کاردیولوژیست"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنژین ناپایدار: درد در حال استراحت یا رو به بدتر شدن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آریتمی مقاوم به دارو"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نارسایی قلبی با تنگی نفس در حال استراحت (ASA IV)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱۸۰/۱۱۰ یا بیشتر"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در نارسایی قلبی خفیف یا متوسط، تنگ‌کننده برای بی‌حسی مطمئن لازم است؛ کمترین غلظت و کمترین حجم را بزن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در پرکاری تیروئید بالینی اپی‌نفرین منع نسبی دارد؛ اگر لازم شد، کمترین دوز را بزن و علائم حیاتی را پیش، حین و پس از کار بسنج. بیماری که درمان شده و تیروئیدش کنترل است، مثل بیمار سالم بی‌حس می‌شود. نخ رترکشن اپی‌نفرین‌دار برای هیچ بیماری، به‌ویژه بیمار قلبی، توصیه نمی‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:6da3e3b6c1e94133c38096fb911ddc513b11990610bd9e5e2824a45eb1dd14df",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "73ecaedbb48d0a761a46549ac5bcca6fc65714cf408d210efa363cc40df47a84",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تداخل‌های دارویی تنگ‌کننده"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از تزریق فهرست داروهای بیمار را بخوان. این تداخل‌ها مهم‌ترین‌اند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ضدافسردگی سه‌حلقه‌ای"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (آمی‌تریپتیلین، ایمی‌پرامین): اثر لوونوردفرین و نوراپی‌نفرین ۵ تا ۱۰ برابر و اثر اپی‌نفرین حدود ۲ برابر می‌شود. لوونوردفرین ممنوع؛ اپی‌نفرین حداکثر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۰۵ میلی‌گرم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ با گرد کردن به پایین یعنی دو کارپول ۱:۱۰۰٬۰۰۰ (۰٫۰۳۶ میلی‌گرم)."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بتابلاکر غیرانتخابی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (پروپرانولول، نادولول): با بسته شدن بتا ۲، اپی‌نفرین فقط رگ را تنگ می‌کند؛ فشار جهش می‌کند و نبض رفلکسی کند می‌شود. اپی‌نفرین را به حدود دو کارپول ۱:۱۰۰٬۰۰۰ محدود کن و فشار و نبض را ۵ تا ۱۰ دقیقه پس از تزریق دوباره بسنج. بتابلاکر قلب‌انتخابی (متوپرولول، آتنولول) این مشکل را بسیار کمتر دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کوکائین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": بازجذب نوراپی‌نفرین را مهار و بدن را به کاتکول‌آمین حساس می‌کند. اگر در ۲۴ ساعت گذشته مصرف شده، درمان را عقب بینداز؛ نخ رترکشن اپی‌نفرین‌دار در این بیمار منع مطلق دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "MAOI"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": با اپی‌نفرین و لوونوردفرین در دوز معمول تداخل مهمی ندارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فنوتیازین‌ها"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (کلرپرومازین، پرومتازین): اثر تنگ‌کننده‌ی اپی‌نفرین را سرکوب می‌کنند؛ تزریق ناخواسته‌ی داخل رگ ممکن است افت فشار بدهد. کمترین حجم با رقیق‌ترین غلظت را بزن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دیگوکسین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": خطر آریتمی؛ با پزشک بیمار مشورت کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "نکته‌ی طلایی: در بیمار بتابلاکر غیرانتخابی، کند شدن نبض پس از تزریق نشانه‌ی آرامش نیست؛ ممکن است پاسخ رفلکسی به جهش فشار باشد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
