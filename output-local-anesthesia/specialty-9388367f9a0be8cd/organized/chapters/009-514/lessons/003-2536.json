  "steps": [
    {
      "id": "theory:58155b16ea8b66e8d5922e8f9bdc4725b1503035c0c41d9cbfbe37e027c92a7e",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "b0ddf7c6b3b3c3b6946bbdb31dcb4061f038715905ff2137a7ae6d338eaaeb57",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رساندن سوزن به سوراخ اینفرااوربیتال"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "سوراخ اینفرااوربیتال بیمار ۵۰ ساله‌ای را لمس کرده‌ای و انگشتت رویش است. می‌خواهی سانترال تا کانین را برای ترمیم بی‌حس کنی. سوزن را از کجا و با چه زاویه‌ای جلو ببری تا به سوراخ برسی، نه به استخوان پایین‌تر؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-22.webp",
                  "alt": "سوزن را موازی محور دندان جلو ببر تا زود به استخوان نخورد؛ فرورفتگی استخوان زیر سوراخ را ببین.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/235f738bf4d914f73683dfa347521ce3e8e8c51b7be239ab180e206450b4aa36.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن را موازی محور دندان جلو ببر تا زود به استخوان نخورد؛ فرورفتگی استخوان زیر سوراخ را ببین. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.22)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سوزن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بلند، گیج ۲۵ یا ۲۷؛ برای کودک و بزرگسال کوچک‌جثه سوزن کوتاه گیج ۲۷ هم مناسب است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دندانپزشک:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " راست‌دست، برای هر دو سمت در ساعت ۱۰، رو به بیمار یا هم‌جهت با او."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیمار:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ترجیحاً خوابیده به پشت، با گردن کمی کشیده تا سینه‌اش به بدنه‌ی سرنگ نخورد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی سطحی را دست‌کم ۱ دقیقه روی عمق وستیبول بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انگشت روی سوراخ بماند و با همان دست لب را بالا بکش؛ یک گاز زیر انگشت به کشیدن لب کمک می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در عمق وستیبول روی پرمولر اول، با بول رو به استخوان وارد شو."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ را رو به سوراخ بگیر و سوزن را موازی محور طولی دندان جلو ببر تا زودتر از موعد به استخوان نخورد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آرام جلو برو تا سوزن به‌نرمی به استخوان بخورد؛ این نقطه لبه‌ی بالایی سوراخ است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عمق نفوذ در بزرگسال با قد متوسط حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۶ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، یعنی حدود نصف سوزن بلند. اگر وستیبول عمیق یا سوراخ پایین باشد، عمق کمتری لازم است؛ اگر وستیبول کم‌عمق یا سوراخ بالا باشد، عمق بیشتری."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:1b7aa787ce1b57002adc514631495d43b22b4719ac3782118d667ba48e233441",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "4cc655ec8fd7481f69e63a158cc199931cef3a487c67dd9dc210ee953d5d84a8",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تزریق، فشار انگشت و علت شکست"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از تزریق عمق کافی، انحراف سوزن به داخل یا خارج سوراخ، و رو به استخوان بودن بول را بسنج. اگر سوزن را زیر انگشت حس کردی، مسیرش سطحی است؛ کمی عقب بکش و دوباره رو به سوراخ ببر."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-20.webp",
                  "alt": "انگشت روی سوراخ می‌ماند و لب را بالا نگه می‌دارد؛ همین فشار دارو را به داخل سوراخ می‌راند.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/c7b3a14bb7206dd7698c22e3b1c94b132df8617f6b8529edacb700d5f1cc4172.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انگشت روی سوراخ می‌ماند و لب را بالا نگه می‌دارد؛ همین فشار دارو را به داخل سوراخ می‌راند. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.20)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در دو صفحه آسپیره کن؛ آسپیراسیون مثبت فقط حدود ۰٫۷٪ است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۹ تا ۱٫۲ میلی‌لیتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را در ۳۰ تا ۴۰ ثانیه تزریق کن. تورم باید کم باشد و دارو را زیر انگشت حس کنی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در طول تزریق و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دست‌کم ۱ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (بهتر ۲ دقیقه) پس از آن محکم روی سوراخ فشار بده تا دارو به داخلش برود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بی‌حسی پلک پایین، کناره‌ی بینی و لب بالا تقریباً فوری است و فقط نشان می‌دهد عصب اینفرااوربیتال گرفته است. بی‌حسی دندان‌ها با حفظ فشار در ۳ تا ۵ دقیقه می‌رسد؛ آن را با تست سرما یا EPT بسنج. هماتوم نادر است و در پلک پایین می‌آید؛ ۲ تا ۳ دقیقه روی سوراخ فشار بده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سوزن زیر سوراخ به استخوان می‌خورد. لب و بینی بی‌حس می‌شوند و دندان‌ها نه؛ برآمدگی دارو زیر پوست دور از سوراخ حس می‌شود و سوراخ هنوز لمس‌شدنی است. این شایع‌ترین علت شکست است و در عمل یک اینفیلتراسیون روی پرمولر اول زده‌ای. سوزن را هم‌راستای سوراخ نگه دار، رو به استخوان نبر و عمق را از پیش تخمین بزن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
