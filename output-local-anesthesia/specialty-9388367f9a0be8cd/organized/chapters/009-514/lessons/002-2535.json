  "steps": [
    {
      "id": "theory:47fa3e25bf86fb0f1f926408fed2d7564bee0d772f7d71cdfed4c1c62d944cf0",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "5758234684c4a61ded016fa2078bde6e3addb3d1af3319a3a9b067db2301d1fe",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "عصب اینفرااوربیتال و ASA"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار ۳۰ ساله‌ای برای ترمیم سانترال، لترال و کانین بالا سمت چپ آمده است. بلاک ASA (آلوئولار فوقانی قدامی) را در نظر داری، ولی دستیار از نزدیکی سوزن به چشم نگران است. کدام عصب‌ها در این ناحیه‌اند و چه چیزی بی‌حس می‌شود؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-17.webp",
                  "alt": "ناحیه‌ی بی‌حس بلاک ASA: سانترال تا کانین، و در بسیاری از بیماران پرمولرها هم.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/fa91318842aa4256e15c225882f5461ed4b597ad47ebf760180d024de9b5d161.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناحیه‌ی بی‌حس بلاک ASA: سانترال تا کانین، و در بسیاری از بیماران پرمولرها هم. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.17)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عصب ماگزیلاری (V2) وقتی در شیار و کانال اینفرااوربیتال است، عصب اینفرااوربیتال نام دارد. عصب ASA حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶ تا ۱۰ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از سوراخ اینفرااوربیتال از آن جدا می‌شود، در دیواره‌ی قدامی سینوس ماگزیلاری پایین می‌آید و پالپ سانترال، لترال و کانین و بافت‌های باکال آن‌ها را عصب‌دهی می‌کند. ASA با MSA ارتباط دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عصب اینفرااوربیتال پس از خروج از سوراخ، پوست پلک پایین، کناره‌ی بینی و پوست و مخاط لب بالا را عصب‌دهی می‌کند. بی‌حسی این سه ناحیه یعنی عصب اینفرااوربیتال گرفته است، نه لزوماً دندان‌ها. به‌معنای دقیق، «بلاک اینفرااوربیتال» فقط بافت نرم صورت را می‌گیرد و تزریقی که دندان‌ها را بی‌حس می‌کند بلاک ASA است؛ در بخش هر دو نام به‌کار می‌رود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ناحیه‌ی بی‌حس با بلاک ASA"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پالپ سانترال تا کانین همان سمت"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در حدود ۷۲٪ بیماران، پالپ پرمولرها و ریشه‌ی مزیوباکال مولر اول"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بافت پریودنتال و استخوان باکال همین دندان‌ها"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پلک پایین، کناره‌ی بینی و لب بالا"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:973cf68d8c0133b06041f1dfdc7efc7c6383c70d241370c8e4090f277c5891eb",
      "sourceId": null,
      "identityOrigin": "local-step",
