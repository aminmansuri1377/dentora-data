  "steps": [
    {
      "id": "theory:386a6edad4b855f1a9ef5c39f17928597bb7462b4d8359fe036b5b8f93151bd3",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "20f67c2bc591f0f61d8838cd6b8f5dec149d85b24429fac27c340aec011ba5f1",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کودک کم‌وزن و درمان چهار کوادرانت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پسر ۵ ساله‌ای در هر چهار کوادرانت پوسیدگی دارد. مادربزرگش می‌گوید وزنش «حدود ۱۵ کیلو» است و می‌خواهد همه‌ی کار در یک جلسه تمام شود. کودک آرام و همکار است. چه برنامه‌ای امن است؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بیشتر مسمومیت‌های جدی در کودک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ تا ۶ ساله"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زیر ۳۰ کیلوگرم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و همکار رخ داده که در یک جلسه برای هر چهار کوادرانت بی‌حسی گرفته است. هر عامل به‌تنهایی شاید مشکلی نسازد، ولی روی هم که بیفتند، فاجعه می‌سازند."
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودک را روی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ترازو"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " وزن کن؛ والدین وزن را معمولاً کمتر می‌گویند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حداکثر دوز را پیش از اولین تزریق حساب کن و شمار کارپول را به پایین گرد کن. برای این کودک، که روی ترازو ۱۸ کیلوگرم درآمد: لیدوکائین ۲٪، ۱۸ × ۷ = ۱۲۶ میلی‌گرم، یعنی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳ کارپول"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در هر جلسه یک یا دو کوادرانت کار کن؛ کوادرانت به کوادرانت بی‌حس و درمان کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محلول ساده را فقط برای کار کوتاه یک کوادرانت بزن؛ برای دو کوادرانت یا بیشتر، محلول با تنگ‌کننده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کارپول کامل در هر تزریق لازم نیست؛ حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲ کارپول"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " برای بی‌حسی همه‌ی دندان‌های شیری کافی است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بسیاری از موارد مرگ، پنج تا هفت کارپول، اغلب محلول ساده، تزریق شده بود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:ec506baabc248dd5ad30039986425eca4520efd2ffe9a3b6cc8d7f60cd896130",
