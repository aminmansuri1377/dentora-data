  "steps": [
    {
      "id": "theory:f6ff62075cf04dff667cc4fb6c01dd79aa4fc58b793464fd28d31bda79a7117d",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "0d7eebc314aa7bde51a3b39e947e4a952246b4f10ebb4d60fb691195d8c6d485",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "جایگزین‌های IANB دوطرفه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیماری برای ترمیم شش دندان قدامی پایین، از کانین تا کانین، آمده است. همکارت پیشنهاد می‌کند برای راحتی کار در هر دو طرف بلاک عصب آلوئولار تحتانی (IANB) بزنی. پیش از قبول، به عارضه‌های این کار فکر کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "IANB دوطرفه جز برای جراحی دوطرفه‌ی فک پایین به‌ندرت لازم است. زبان و لب هر دو طرف ساعت‌ها بی‌حس می‌مانند؛ بیمار حس می‌کند نمی‌تواند قورت بدهد (در واقع می‌تواند)، حرف زدنش مختل می‌شود و بیشتر لب و زبانش را گاز می‌گیرد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جایگزین‌ها"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بلاک اینسیزیو دوطرفه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": وقتی بی‌حسی بافت نرم لینگوال لازم نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "IANB یک طرف و اینسیزیو طرف دیگر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": IANB را سمتی بزن که دندان بیشتری درمان می‌شود یا کار لینگوال بیشتری دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اینفیلتراسیون باکال آرتیکائین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در ناحیه‌ی ثنایا، حدود ۰٫۶ میلی‌لیتر کنار دندان."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا اینفیلتراسیون در ثنایای پایین جواب می‌دهد؟ کورتکس لبیال و لینگوال این ناحیه در بزرگسال نسبتاً نازک است و سوراخ‌های ریز فراوان دارد. در ثنایا، اینفیلتراسیون باکال ۰٫۵ میلی‌لیتر آرتیکائین ۴٪ حدود ۹۴٪ موفق بوده و لیدوکائین ۲٪ حدود ۷۰٪. تزریق هم در باکال و هم در لینگوال، موفقیت را به حدود ۹۷٪ و ۸۸٪ رسانده است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:7b2ed691bf664243091af035972a93f3a00c0420d08ebe008057c52916c87870",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "e113b4b729b524f7051343ffdde1c3544fe4949dd23ad72caaf9283288090699",
      "position": 2,
      "kind": "theory",
