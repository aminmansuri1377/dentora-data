  "steps": [
    {
      "id": "theory:40b159c3fbf422f8f58272c0b7e50edaf4afbc665fd5a57530e020e6355bfe78",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "43db3eaab7f28390324449a422eb2864c1c281434df22a60f1908c422c32e4cc",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پنج پرسش پیش از انتخاب دارو"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "صبح یک ترمیم ۱۵ دقیقه‌ای برای کودکی ۷ ساله داری، ظهر جراحی پریو دوساعته، و عصر کشیدن مولر سوم برای بیماری که از درد پس از عمل می‌ترسد. آیا یک کارپول لیدوکائین برای هر سه مناسب است؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر برای همه‌ی کارها یک دارو بزنی، بیمار ترمیم کوتاه ساعت‌ها لب بی‌حس دارد و بیمار جراحی طولانی ممکن است آخر کار درد بکشد. پیش از انتخاب، این پنج را بپرس:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی پالپ چه مدت لازم است؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد پس از درمان انتظار می‌رود؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطر گاز گرفتن بافت بی‌حس هست؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به کنترل خون‌ریزی نیاز داری؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "منع مصرف مطلق یا نسبی وجود دارد؟"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مدت بی‌حسی پالپ"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کوتاه، کمتر از ۳۰ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": مپیواکائین ۳٪، و پریلوکائین ۴٪ ساده با اینفیلتراسیون"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "متوسط، حدود ۶۰ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": لیدوکائین و مپیواکائین با تنگ‌کننده، آرتیکائین، و پریلوکائین با اپی‌نفرین"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "طولانی، ۹۰ دقیقه و بیشتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": بوپیواکائین ۰٫۵٪ با اپی‌نفرین"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در مطب دست‌کم دو گروه دارو با مدت اثر متفاوت داشته باش."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:b4bc3e9a0609e3a433cdc5073f2ffd62f2a81989210917b1f190d209f893c0cf",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5adcd189da46dbccc9517e239b34fbe33e400fbf875af5fb86f4144adcf744ee",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "درد پس از درمان، خون‌ریزی و منع مصرف"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "درد پس از جراحی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": بوپیواکائین ۰٫۵٪؛ با بلاک ۸ تا ۱۲ ساعت بی‌حسی بافت نرم می‌دهد. شروع اثرش کُند است (۶ تا ۱۰ دقیقه)، پس کار را با داروی سریع‌تر شروع کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خطر گاز گرفتن لب و زبان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در کودک کم‌سن، سالمند بالای ۸۵ سال، بیمار دارای ناتوانی ذهنی یا جسمی، و دیابتی نوع ۱ که نباید وعده‌ی غذا را از دست بدهد: برای کار کوتاه مپیواکائین ۳٪."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کنترل خون‌ریزی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": اپی‌نفرین ۱:۵۰٬۰۰۰ یا ۱:۱۰۰٬۰۰۰ با اینفیلتراسیون در محل جراحی؛ ۱:۵۰٬۰۰۰ خون‌ریزی جراحی پریو را نسبت به ۱:۱۰۰٬۰۰۰ نصف می‌کند. ۱:۲۰۰٬۰۰۰، لوونوردفرین و فلی‌پرسین برای این کار کافی نیستند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "منع مصرف"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آلرژی ثابت‌شده به یک بی‌حسی (مطلق): داروهای همان گروه شیمیایی ممنوع‌اند؛ از گروه دیگر استفاده کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آلرژی ثابت‌شده به سولفیت (مطلق): هیچ داروی دارای تنگ‌کننده نزن؛ داروی ساده بزن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متهموگلوبینمی، آنمی یا سیکل‌سل: پریلوکائین را کنار بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیماری قلبی یا پرکاری تیروئید ASA III یا IV: تنگ‌کننده‌ی رقیق در کمترین دوز، یا مپیواکائین ۳٪."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیماری جدی کبد: آمیدها با احتیاط و در دوز کم."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی بی‌حسی نگرفت، «کارپول خراب» تقریباً هیچ‌وقت علت نیست؛ علت شایع تکنیک یا تفاوت آناتومی است. پیش از عوض کردن دارو تکنیک را بازبینی کن و یادت باشد مجموع دو دارو از سقف کوچک‌تر نگذرد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
