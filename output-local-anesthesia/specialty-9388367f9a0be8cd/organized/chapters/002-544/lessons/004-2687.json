  "steps": [
    {
      "id": "theory:6337718d19cf95816a7cfb8284187a9da1df36a013c5a47a15d76842d45b246c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "70f399ef96368856c67b48494b99e1160067ac9c0ebbdc00b8d4ddcc5b5e52d9",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا بی‌حسی در بافت ملتهب کم‌اثر است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مرد ۴۰ ساله‌ای با آبسه‌ی پری‌اپیکال و تورم باکال روی پرمولر اول بالا آمده است. دندانپزشک دو کارپول به روش اینفیلتراسیون، یعنی تزریق در بافت کنار نوک ریشه‌ی همان دندان، در ناحیه‌ی متورم زده است و بیمار هنوز با کوچک‌ترین لمس درد دارد. دستیار می‌گوید «کارپول خراب بود». توضیح علمی چیست؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بافت سالم pH حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۷٫۴"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد و بافت ملتهب یا عفونی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵ تا ۶"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". التهاب از چند راه جلوی بی‌حسی را می‌گیرد:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اسیدیته:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در pH حدود ۶، برای دارویی با pKa ۷٫۹ حدود ۹۹٪ مولکول‌ها باردار و حدود ۱٪ بی‌بارند. به‌جای ۲۵۰ مولکول بی‌بار در بافت سالم، حدود ۱۰ مولکول از غلاف عصب می‌گذرند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رگ‌های گشاد:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " خون‌رسانی بیشتر ناحیه دارو را زودتر از محل تزریق می‌برد؛ سطح خونی دارو هم ممکن است از بافت سالم بالاتر برود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عصب حساس‌تر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ترشحات التهابی آستانه‌ی پاسخ عصب را پایین می‌آورند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درون عصب pH همچنان حدود ۷٫۴ است، چون یون هیدروژن به‌آسانی از بافت‌ها نمی‌گذرد. مولکول‌هایی که به درون برسند، مثل همیشه حدود ۷۵٪ باردار می‌شوند و کانال را می‌بندند. پس مشکل در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عبور از غلاف"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه در اتصال به گیرنده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:aa7408faf8f98294c347c6280769940caf298dbd57910590ffcf3244d6df03c3",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "1d9a5ff0e3a801ac2eff80007c71b984da60760c5c81706d6d1187635e33511d",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "راه‌حل‌ها، تزریق دوباره و تاکی‌فیلاکسی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دارو را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دور از ناحیه‌ی التهاب"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بگذار. بلاک ناحیه‌ای، یعنی تزریق کنار تنه‌ی عصب و دورتر از دندان، در بافتی با pH عادی شانس بیشتری دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در بافت آشکارا عفونی تزریق نکن؛ علاوه بر شکست، ممکن است عفونت را به نواحی سالم بکشاند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بافر کردن سهم شکل بی‌بار را بالا می‌برد، ولی در پالپیت دندان‌های پایین شواهد هنوز قطعی نیست."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تزریق دوباره"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر پیش از برگشت درد دوباره تزریق کنی، بی‌حسی عمیق به‌سرعت و با حجم کمتر برمی‌گردد، چون هنوز مقداری دارو در عصب مانده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر درد برگشته باشد، احتمال "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تاکی‌فیلاکسی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خیلی بیشتر است: تحمل فزاینده به داروی تکرارشده، که مدت، شدت و گستره‌ی بی‌حسی را کم می‌کند. علت‌های احتمالی:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ادم، خون‌ریزی موضعی، لخته و تراوش مایع، که عصب را از دارو جدا می‌کنند"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بالا رفتن سدیم محیط (هایپرناترمی)، که شیب سدیم را بیشتر می‌کند"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اسیدی شدن محل با تزریق اول، که شکل بی‌بار کمتری می‌سازد"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "نکته‌ی طلایی: در کار طولانی، کارپول بعدی را پیش از برگشت درد بزن، نه پس از شکایت بیمار."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
