  "steps": [
    {
      "id": "theory:ed35c5c45dcad36ec14326a3ea29ee4c7f9a3d3de9c14ea62a53b7243ffcc8e6",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "e4c6270115f7dc934234f61d465cd60cf24ec06a770c8af7cade846cf88c06c0",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "pKa و سرعت شروع اثر"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "همکارت کارپول لیدوکائین با اپی‌نفرین (شیشه‌ی آماده‌ی داروی بی‌حسی که تنگ‌کننده‌ی رگ هم دارد) را درست پیش از تزریق با سدیم بی‌کربنات بافر می‌کند و می‌گوید بیمارانش زودتر بی‌حس می‌شوند و سوزش کمتری حس می‌کنند. این حرف پایه‌ی علمی دارد؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بی‌حسی‌ها باز ضعیف‌اند و به شکل نمک اسیدی (هیدروکلراید) در کارپول‌اند. در محلول و بافت، شکل باردار و بی‌بار با یون هیدروژن در تعادل‌اند. هرچه یون هیدروژن بیشتر باشد (pH پایین‌تر)، سهم شکل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باردار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیشتر است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "pKa"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آن pH است که در آن دقیقاً نیمی از دارو باردار و نیمی بی‌بار است. هرچه pKa دارو پایین‌تر باشد، در pH بافت (۷٫۴) شکل بی‌بار بیشتری دارد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مسیر مولکول تا کانال"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فقط شکل "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بی‌بار (RN)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " چربی‌دوست است و از غلاف عصب می‌گذرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درون عصب (pH ۷٫۴) تعادل دوباره برقرار می‌شود و حدود ۷۵٪ مولکول‌ها باردار می‌شوند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شکل باردار از درون، کانال سدیم را می‌بندد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مثال: از ۱۰۰۰ مولکول دارویی با pKa ۷٫۹ در بافت سالم، حدود ۲۵۰ مولکول بی‌بارند و وارد عصب می‌شوند. ۷۵۰ مولکول باردار بیرون می‌مانند و کم‌کم دوباره بی‌بار می‌شوند؛ البته بخشی از آن‌ها پخش یا جذب رگ‌ها می‌شود."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لیدوکائین، مپیواکائین، پریلوکائین و آرتیکائین: pKa حدود ۷٫۶ تا ۷٫۹، شروع ۲ تا ۴ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بوپیواکائین: pKa ۸٫۱، شروع ۵ تا ۸ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروکائین: pKa ۹٫۱، فقط حدود ۲٪ بی‌بار، شروع ۱۴ تا ۱۸ دقیقه"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:4e2d43b2279bd00abe4ec4437ff7c67479e86f01f6b7098e6a48a9b563105bbe",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "787af130708c74675018a8319cc5e5436f9668945114db771545c1f4e92a08db",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "pH کارپول، بافر کردن و ویژگی‌های دیگر دارو"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محلول ساده pH حدود ۶٫۵ دارد. به کارپول‌های دارای اپی‌نفرین "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سدیم بی‌سولفیت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " افزوده‌اند تا اپی‌نفرین اکسید نشود؛ pH این کارپول‌ها حدود ۳٫۵ تا ۴٫۴ است. نتیجه:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزش بیشتر هنگام تزریق"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شروع اثر کمی کندتر، چون بافت باید اسید را خنثی کند"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد بیشتر محل تزریق پس از بی‌حسی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بافر کردن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، یعنی افزودن سدیم بی‌کربنات درست پیش از تزریق، pH را بالا می‌برد و سهم شکل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌بار (RN)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را زیاد می‌کند: شروع سریع‌تر و تزریق راحت‌تر. کارخانه نمی‌تواند محلول قلیایی آماده بسازد، چون شکل بی‌بار ناپایدار است و رسوب می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "از عوامل مؤثر بر زمان شروع، دو عامل در دست توست: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غلظت دارو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و pH محلول. غلظت بیشتر شیب غلظت را تندتر و انتشار را سریع‌تر می‌کند. ثابت انتشار دارو و سدهای آناتومیک در دست تو نیستند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه ویژگی دیگر"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چربی‌دوستی بیشتر: قدرت بیشتر (غشای عصب حدود ۹۰٪ چربی است)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اتصال بیشتر به پروتئین: مدت اثر طولانی‌تر، مثل بوپیواکائین"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گشادکنندگی بیشتر رگ: قدرت و مدت کمتر"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباه رایج: گمان اینکه بافر کردن شکل باردار را زیاد می‌کند. بافر یون هیدروژن را کم می‌کند و تعادل را به سمت شکل بی‌بار می‌برد؛ همان شکلی که از غلاف عصب می‌گذرد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
