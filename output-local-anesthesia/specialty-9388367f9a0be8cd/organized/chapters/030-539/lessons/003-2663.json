          "children": [
            {
              "tag": "text",
              "text": "کارپول دوم و پیاده کردن سرنگ ایمنی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گاهی وسط کار کارپول دیگری لازم می‌شود. با سرنگ هارپون‌دار:"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-9-20.webp",
                  "alt": "پس از قفل کردن سرنگ ایمنی، دسته‌ی پیستون را کامل عقب بکش و جدا کن.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/b1c9a2a3cf54d9a4aa1bc2da3ae85d90c0883344366f919a4d4bc13b1892a009.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از قفل کردن سرنگ ایمنی، دسته‌ی پیستون را کامل عقب بکش و جدا کن. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 9.20)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن را با روش اسکوپ درپوش بگذار و از سرنگ باز کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیستون را عقب بکش تا هارپون از لاستیک جدا شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کارپول مصرف‌شده را بیرون بیاور و کارپول نو را جا بینداز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هارپون را در لاستیک بنشان و سوزن را دوباره ببند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کل کار حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۰ تا ۱۵ ثانیه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و ترتیب «اول کارپول، بعد سوزن» حفظ می‌شود. کارپول نیمه‌پر را برای بیمار دیگر نگه ندار؛ هر کارپول فقط برای یک بیمار است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سرنگ ایمنی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "میان دو تزریق با یک کارپول، غلاف را تا "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "وضعیت نگه‌داری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (holding) روی سوزن بیاور."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در پایان، غلاف را تا "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "وضعیت قفل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، یعنی شکاف دوم انتهای بدنه، بکش. سپس پیستون را کامل عقب بکش و دسته را با یک حرکت جدا کن. دسته اتوکلاو می‌شود و بقیه‌ی سرنگ در ظرف اجسام تیز می‌رود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تلاش برای باز کردن غلافی که ناخواسته قفل شده است. هرگز این کار را نکن؛ یک سرنگ ایمنی نو بردار."
                }
              ]
            }
          ]
        }
