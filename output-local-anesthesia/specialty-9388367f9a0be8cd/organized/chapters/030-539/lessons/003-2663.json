  "steps": [
    {
      "id": "theory:183e4a6e34f5dc56c7ba98ec5be2b4542ce3563aae56a81ad88a034aafbae980",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "acf5e1ad938714f2f15822ae115d7406a496df6aff09c848491b2d4123e8c113",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیاده کردن سرنگ و دور ریختن سوزن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "صبح روز بعد، دستیار سوزن نو را برمی‌دارد تا روی سرنگ فلزی بخش ببندد، ولی جایی برای پیچاندنش نیست. دیروز پس از کشیدن دندان، سوزن را باز کرده و در ظرف اجسام تیز انداخته است. چه چیزی گم شده؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-9-12.webp",
                  "alt": "سوزن مصرف‌شده به ظرف اجسام تیز می‌رود و کارپول‌های مصرف‌شده به ظرف دربسته‌ی جدا.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/cbef43dc28d75ae3ac815b857f4be46af2596526793ffd0f1cf964989fa4db98.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن مصرف‌شده به ظرف اجسام تیز می‌رود و کارپول‌های مصرف‌شده به ظرف دربسته‌ی جدا. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 9.12)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ را که از دهان بیرون آوردی، سوزن را بی‌درنگ با روش اسکوپ درپوش بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیستون را عقب بکش و هم‌زمان کارپول را با شست و انگشت اشاره از سوزن دور کن تا هارپون از لاستیک جدا شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ را وارونه کن تا کارپول خودش بیفتد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن درپوش‌دار را با احتیاط باز کن و ببین "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "محل اتصال سوزن (needle adaptor)"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " همراهش جدا نشده باشد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن را در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ظرف اجسام تیز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بینداز؛ برای کارپول‌های مصرف‌شده یک ظرف دربسته‌ی جدا توصیه می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هر سوزن پس از مصرف دور ریخته می‌شود تا کسی با آن آسیب نبیند و فرد غیرمجاز دوباره از آن استفاده نکند. سوزن آلوده، و هر چیز آغشته به خون یا بزاق مثل کارپول، هرگز در سطل زباله‌ی روباز نمی‌رود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
