  "steps": [
    {
      "id": "theory:fe903880e07fbd100f845b16161fc69976cfb1dbac1a29b0927c23284b254b1f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "43ad22bfcfd9a4dd38905601c0182e750be8eebd4eb0f8df90377bd27058bb54",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا بیمار لبش را گاز می‌گیرد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "دختری ۶ ساله برای ترمیم مولر شیری پایین با بلاک عصب آلوئولار تحتانی (IANB) و لیدوکائین ۲٪ با اپی‌نفرین بی‌حس شد. دو ساعت بعد مادرش عکسی می‌فرستد: لب پایین متورم و زخم است و کودک از درد گریه می‌کند. چه رخ داده است؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-17-9.webp",
                  "alt": "لب زخمی از گاز گرفتن ناخواسته، وقتی هنوز بی‌حس بود.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/1e3d628aec2bdc9591112e1ae7a1048c1d84b187e3888cf991d3266fcdca62ea.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لب زخمی از گاز گرفتن ناخواسته، وقتی هنوز بی‌حس بود. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 17.9)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بی‌حسی بافت نرم خیلی بیشتر از پالپ می‌ماند. با لیدوکائین ۲٪ و اپی‌نفرین، پالپ حدود ۶۰ دقیقه و لب و زبان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳ تا ۵ ساعت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بی‌حس‌اند؛ پس بیمار معمولاً با لب بی‌حس از مطب می‌رود و ممکن است لب، زبان یا گونه را گاز بگیرد، بی‌آنکه دردی حس کند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چه کسانی در خطرند"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودک کم‌سن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودک یا بزرگسال با ناتوانی ذهنی یا جسمی"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سالمند بالای ۸۵ سال؛ سالمند مبتلا به دمانس هم‌اندازه‌ی کودک یا بیشتر در خطر است"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس از IANB در کودکان، شیوع زیر ۴ سال حدود ۱۸٪، در ۴ تا ۷ سال ۱۶٪، در ۸ تا ۱۱ سال ۱۳٪ و از ۱۲ سال به بعد ۷٪ است. بیشترِ آسیب‌ها در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لب پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، کمتر در زبان و به‌ندرت در لب بالا."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا کودک"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کودک لب سالم را گاز می‌گیرد و درد دارد؛ بعد سمت بی‌حس را گاز می‌گیرد و دردی ندارد. بزرگسال همین‌جا دست می‌کشد، ولی کودک با این حس تازه بازی می‌کند و هر بار محکم‌تر گاز می‌گیرد. وقتی بی‌حسی می‌رود، ورم و درد شدید می‌آید و کودک ممکن است بی‌قرار شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5f2a9e76530e7adaf4c1fc2ea19c85fd95ad3e0197937e688a3543e1a4b937c7",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5c62aca3d4ec03a2ef853395c68933a57b0b3e184e0a39b5a529eeee326f6d48",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پیشگیری و درمان گاز گرفتن لب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیشگیری"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دارویی بزن که مدتش با کار بخواند؛ مپیواکائین ۳٪ ساده ۲۰ تا ۴۰ دقیقه بی‌حسی پالپ و ۲ تا ۳ ساعت بی‌حسی بافت نرم می‌دهد. ولی ثابت نشده داروی ساده آسیب لب را کم کند، و در کار چند ناحیه‌ای کودک سبک‌وزن داروی تنگ‌کننده‌دار ایمن‌تر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بوپیواکائین در کودک کم‌سن به‌ندرت جا دارد؛ بی‌حسی بافت نرمش "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۸ تا ۱۲ ساعت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌ماند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای یک دندان در کودک، تزریق اینترالیگامنتری (PDL) بی‌حسی پالپ می‌دهد بی‌آنکه لب بی‌حس بماند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به بیمار و همراهش، با هم، بگو تا برگشت حس غذا نخورد، نوشیدنی داغ ننوشد و برای امتحان بی‌حسی لب یا زبانش را گاز نگیرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر هنگام رفتن هنوز بی‌حس است، رول پنبه را در وستیبول میان لب و دندان بگذار و با نخ دندان دور دندان‌ها ببند تا آسپیره نشود. برچسب یادآور روی لباس کودک هم کمک می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فنتولامین در پایان کار، در همان محل، فقط بی‌حسی داروی تنگ‌کننده‌دار را کوتاه می‌کند؛ زیر ۳ سال یا زیر ۱۵ کیلوگرم توصیه نمی‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "درمان"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مسکن با دوز مناسب سن، مثلاً ایبوپروفن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دهان‌شویه‌ی آب نمک ولرم برای کم کردن ورم"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وازلین روی زخم لب تا خشک و تحریک نشود"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنتی‌بیوتیک فقط اگر عفونت پیدا شد، که بعید است"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباه رایج: لب متورم و زخمیِ فردا را «عفونت» بدانی و آنتی‌بیوتیک بدهی. اطمینان بده و درمان علامتی را توضیح بده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
