  "steps": [
    {
      "id": "theory:306603f0c5e20474b8b072afdc59add6ba7c8d07a3b2efa67c32039007393c69",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "85e0cff342d61d81d2f7c296de12d6fec7e2e3e03fb6e885524cc088924ce038",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سوزن تیز، جریان محلول و دمای کارپول"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مردی ۴۰ ساله برای درمان دو کوادرانت آمده است. پس از چهارمین ورود با همان سوزن، از سوزش ورود سوزن و کوفتگی لثه شکایت می‌کند. کارپول بعدی را هم دستیار تازه از یخچال آورده است. پیش از تزریق بعدی چه چیزهایی را عوض می‌کنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-11-1.webp",
                  "alt": "خار نوک سوزن زیر میکروسکوپ؛ سوزن کند ورود را دردناک می‌کند، پس پس از ۳ یا ۴ ورود عوضش کن.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/bd2157dcdf647d8354e8ab344159043a35f95c890a7d39c3456e8d3eb1c4c8a8.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خار نوک سوزن زیر میکروسکوپ؛ سوزن کند ورود را دردناک می‌کند، پس پس از ۳ یا ۴ ورود عوضش کن. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 11.1)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن تیز"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن یک‌بارمصرف در ورود اول تیز است، ولی با هر ورود کندتر می‌شود. از ورود سوم یا چهارم، سوزن بافت را پاره می‌کند و درد ورود و کوفتگی پس از بی‌حسی بیشتر می‌شود. سوزن را پس از هر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳ یا ۴ ورود"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " عوض کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گاهی نوک سوزن خار ریزی (barb) دارد که هنگام خروج بافت را پاره می‌کند. نوک را روی گاز استریل عقب بکش؛ اگر گاز گیر کرد، سوزن را کنار بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گیج سوزن را خود تکنیک تعیین می‌کند. بیمار فرق ورود گیج ۲۵، ۲۷ و ۳۰ را در مخاط حس نمی‌کند؛ گیج ۲۳ و درشت‌تر ورود دردناک‌تری دارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جریان محلول و دما"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از سوار کردن کارپول و فرو رفتن هارپون در لاستیک پیستون، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چند قطره"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بیرون بده تا از جریان آزاد محلول مطمئن شوی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کارپول در دمای اتاق (حدود ۲۲ درجه‌ی سانتی‌گراد) گرم کردن نمی‌خواهد. کارپول یخچالی را به دمای اتاق برسان. گرم‌کن لامپی محلول را بیش از حد داغ می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ فلزی سرد برای بیمار ناخوشایند است؛ سرنگ آماده را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳۰ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در کف دست نگه دار."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:cf75386e8cbd5dfe094c5533682d34173b1196da2a84026c500bece10fbba8e1",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "8ee95399f3de5720c58ec25b44dfe486452fd5fc6401532c7fd8ee01c0a6f476",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "وضعیت صندلی و پیشگیری از سنکوپ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سنکوپ وازوواگال (غش ساده) شایع‌ترین اورژانس مطب دندانپزشکی است و بیشترش پیش، حین یا کمی پس از تزریق رخ می‌دهد. بیش از نیمی از اورژانس‌های مطب حین تزریق یا در ۵ دقیقه‌ی پس از آن پیش می‌آید، و بیشترشان از استرس تزریق است، نه از خود دارو."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-11-2.webp",
                  "alt": "وضعیت درست برای تزریق: بیمار خوابیده به پشت با پاهای کمی بالا، تا خون مغز کم نشود.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/d9f131c779cc8f51de134a3e4d1a917496fa770ba416e60a20e3e9fe2708bbc2.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وضعیت درست برای تزریق: بیمار خوابیده به پشت با پاهای کمی بالا، تا خون مغز کم نشود. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 11.2)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا بیمار نشسته غش می‌کند"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در حالت نشسته، فشار خون شریان‌های مغز به ازای هر ۲٫۵ سانتی‌متر ارتفاع بالاتر از قلب حدود ۲ میلی‌متر جیوه کم می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اضطراب خون را به سمت عضلات اسکلتی می‌برد. اگر بیمار بی‌حرکت بماند و به خیال خودش «تحمل کند»، خون در عضلات می‌ماند، بازگشت وریدی کم می‌شود و خون کمتری به مغز می‌رسد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نشانه‌های اول: سبکی سر، سرگیجه، تاکی‌کاردی و تپش قلب. اگر ادامه یابد، بیمار هوشیاری‌اش را از دست می‌دهد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وضعیت درست"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هنگام تزریق بیمار را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خوابیده به پشت با پاهای کمی بالا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قرار بده؛ سر و قلب موازی زمین. همه‌ی بلاک‌های ناحیه‌ای در این وضعیت شدنی‌اند. وضعیت را می‌توانی با وضع پزشکی بیمار تنظیم کنی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباه رایج: تزریق به بیمار مضطرب در حالت نشسته و صاف، به این امید که «زود تمام می‌شود». بیمار مضطرب نشسته، آماده‌ترین بیمار برای غش است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
