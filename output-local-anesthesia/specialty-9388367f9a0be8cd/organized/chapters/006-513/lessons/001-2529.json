  "steps": [
    {
      "id": "theory:98754d69c913d070a8f8af8174960d68b04381b7c7a3d9d578fa10b3735cf7ed",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "85e107decfb404ca6af65fb4983febe2a872ed9c19953eb443f521557dc407e4",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هدف، وضعیت و لندمارک‌های گاو-گیتس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار ۳۸ ساله‌ای برای ترمیم مولر اول و دوم پایین سمت راست آمده است. جلسه‌ی قبل دو بار بلاک عصب آلوئولار تحتانی (IANB) گرفته و هر دو بار مولرها حس داشتند. این بار می‌خواهی گاو-گیتس بزنی. سوزن را از کجا و به کدام سمت می‌بری؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-14-19.webp",
                  "alt": "نقطه‌ی ورود گاو-گیتس: هم‌سطح کاسپ مزیوپالاتال مولر دوم بالا و درست دیستال به آن.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/57372c37496e5bcc7a499a1a4888ad5510b3bc2207fc0e5c9237c90296fa2500.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقطه‌ی ورود گاو-گیتس: هم‌سطح کاسپ مزیوپالاتال مولر دوم بالا و درست دیستال به آن. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 14.19)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گاو-گیتس یک بلاک واقعی عصب مندیبولار (V3) است. دارو را خیلی بالاتر از IANB، کنار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گردن کندیل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌ریزی: سمت خارجی گردن کندیل، کمی پایین‌تر از محل چسبیدن عضله‌ی پتریگوئید خارجی."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن و وضعیت"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن بلند گیج ۲۵ یا ۲۷؛ جهت بول اهمیتی ندارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راست‌دست برای سمت راست "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساعت ۸"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و برای سمت چپ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساعت ۱۰"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " می‌نشیند، مثل IANB."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار خوابیده به پشت، گردن کمی به عقب و دهان "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تا آخر باز"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ". با باز شدن کامل دهان، کندیل جلو می‌آید و به تنه‌ی عصب نزدیک‌تر می‌شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لندمارک‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خارج دهانی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ناچ اینترتراگوس (intertragic notch)، یعنی لبه‌ی پایینی تراگوس، و گوشه‌ی دهان طرف مقابل. نقطه‌ی واقعی مرکز مجرای گوش خارجی است که تراگوس آن را پوشانده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "داخل دهانی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نوک سوزن را زیر کاسپ مزیوپالاتال مولر دوم بالا بگذار، سپس در همان ارتفاع کمی دیستال‌تر از این دندان ببر؛ نقطه‌ی ورود همین‌جاست. اگر مولر سوم بالا در اکلوژن طبیعی هست، درست دیستال آن وارد شو."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:d270282deadf512ea33817a55ebda5b30c7ec18cf929fb3f078f64d591c6f978",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5abd76e4734a3d5f2131c92fe6f10133581146098f69ee80c78269572c749d69",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "جهت سوزن، برخورد با استخوان و تزریق"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل را خشک کن و بی‌حسی سطحی را دست‌کم ۱ دقیقه بگذار. انگشت را روی ناچ کورونوئید بگذار و بافت را کشیده نگه دار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ را از گوشه‌ی دهان طرف مقابل بیاور و سوزن را هم‌راستای خطی کن که از همان گوشه‌ی دهان تا ناچ اینترتراگوس سمت تزریق می‌رود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدنه‌ی سرنگ معمولاً روی پرمولرهاست، ولی بسته به واگرایی راموس از مولرها تا ثنایاها جابه‌جا می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آرام پیش برو تا به استخوان، یعنی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گردن کندیل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، برسی. میانگین عمق "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲۵ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است، نزدیک به عمق IANB."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱ میلی‌متر عقب بکش و در دو صفحه آسپیره کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر منفی بود، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱٫۸ میلی‌لیتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را در ۶۰ تا ۹۰ ثانیه تزریق کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار ۱ تا ۲ دقیقه دهانش را باز نگه دارد (بایت‌بلاک کمک می‌کند)، سپس بنشیند. دست‌کم "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵ دقیقه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " صبر کن و بعد پالپ را بسنج."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آسپیراسیون مثبت حدود ۲٪ است و بیشتر از شریان ماگزیلاری داخلی می‌آید که پایین‌تر از هدف است. اگر مثبت شد، کمی عقب بکش، سوزن را کمی رو به بالا ببر و دوباره آسپیره کن."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-14-21.webp",
                  "alt": "بدنه‌ی سرنگ و سوزن موازی خطی است که گوشه‌ی دهان را به ناچ اینترتراگوس وصل می‌کند.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/04629f7046fb1a47e55a11bb8435734ddbd266a9431b6b9755ce8268a1467369.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدنه‌ی سرنگ و سوزن موازی خطی است که گوشه‌ی دهان را به ناچ اینترتراگوس وصل می‌کند. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 14.21)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "تا استخوان لمس نشده، دارو نریز. شایع‌ترین علت این است که بیمار دهانش را کمی بسته؛ بافت ضخیم‌تر و کندیل عقب‌تر می‌رود. سوزن را کمی عقب بکش، بخواه دهانش را بازتر کند و دوباره پیش برو. اگر سوزن به داخل منحرف شده، بدنه‌ی سرنگ را کمی دیستال‌تر ببر تا نوک سوزن جلوتر برود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
