  "steps": [
    {
      "id": "theory:999e3703b63a3eeaa721415a498700c7a531cbe12c13617e649440b603775b5a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "148ac4f598ea2a4323b5aca2e3ef3174602b9207f7d580892f0685d34372ae1a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کاربرد و لندمارک‌های واَزیرانی-آکینوسی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مردی ۲۸ ساله دیروز برای پالپیت برگشت‌ناپذیر مولر دوم پایین چند بار بلاک عصب آلوئولار تحتانی (IANB) گرفته است. امروز با درد برگشته و دهانش را فقط به اندازه‌ی یک بند انگشت باز می‌کند. IANB و گاو-گیتس ممکن نیست. چطور بی‌حسش می‌کنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-14-25.webp",
                  "alt": "در واَزیرانی-آکینوسی سوزن هم‌سطح MGJ مولر سوم بالا وارد می‌شود، با دندان‌های روی هم.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/0bdd7deba860fa6b2053f58011aacb163104684e9e15fdacff2b0ce25757ec2d.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در واَزیرانی-آکینوسی سوزن هم‌سطح MGJ مولر سوم بالا وارد می‌شود، با دندان‌های روی هم. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 14.25)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بلاک واَزیرانی-آکینوسی یا بلاک «دهان بسته» با دندان‌های روی هم زده می‌شود. سوزن از کنار توبروزیته‌ی فک بالا وارد فضای پتریگومندیبولار می‌شود و دارو را کنار عصب‌های آلوئولار تحتانی، لینگوال و میلوهایوئید می‌ریزد؛ ارتفاع تزریق پایین‌تر از گاو-گیتس و بالاتر از IANB است."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کاربرد"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محدودیت باز شدن دهان: تریسموس، عفونت یا ضربه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کار روی چند دندان فک پایین"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیده نشدن لندمارک‌های IANB، مثلاً به خاطر زبان بزرگ"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آماده‌سازی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن بلند "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گیج ۲۵"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ اگر راموس بیش از معمول به بیرون باز شده، گیج ۲۷ بلند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راست‌دست برای هر دو سمت در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساعت ۸"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و رو به بیمار می‌نشیند. بیمار خوابیده به پشت."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لندمارک‌ها: اتصال موکوژنژیوال (MGJ) مولر سوم یا دوم بالا، توبروزیته‌ی فک بالا و ناچ کورونوئید."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقطه‌ی ورود: بافت روی لبه‌ی داخلی راموس، چسبیده به توبروزیته، هم‌سطح MGJ مولر سوم بالا."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:bd16e7e8b5365a52950333c2c0ac823b3307b368a2a4781d6baa49e991f0f686",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "e64cc730b2e10c5c396cdf7f8cfd16c51b6ea0226be26c49bdee5f57f8a0a25d",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "گام‌های تزریق با دهان بسته"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از بی‌حسی سطحی، بیمار دندان‌ها را آرام روی هم بگذارد و گونه‌ها را شل کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انگشت روی ناچ کورونوئید، بافت داخل راموس را به بیرون بکش."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "موازی سطح اکلوزال فک بالا"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نگه دار؛ سوزن هم‌سطح MGJ مولر سوم یا دوم بالا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن را رو به عقب و کمی خارج، مماس بر زائده‌ی آلوئولار خلفی فک بالا ببر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بول را رو به خط میانی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، دور از راموس، بگیر تا سوزن به سمت راموس و عصب منحرف شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در بزرگسال متوسط "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲۵ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از توبروزیته پیش برو. استخوانی لمس نمی‌شود؛ در بیمار کوچک‌تر عمق را کم کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در دو صفحه آسپیره کن و اگر منفی بود، ۱٫۵ تا ۱٫۸ میلی‌لیتر را در حدود ۶۰ ثانیه تزریق کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فلج حرکتی هم‌زمان یا زودتر از بی‌حسی حسی می‌آید و بیمار دچار تریسموس کم‌کم دهانش را بازتر می‌کند. بی‌حسی لب و زبان حدود ۱ تا ۱٫۵ دقیقه بعد شروع می‌شود و کار تا ۵ دقیقه شروع‌شدنی است. اگر دهان باز شد ولی بی‌حسی کافی نبود، IANB یا گاو-گیتس بزن."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-14-26.webp",
                  "alt": "بدنه‌ی سرنگ موازی سطح اکلوزال فک بالا است و سوزن رو به عقب در امتداد داخل راموس پیش می‌رود.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/7f402ecf25a472aaf6bd97db12fce1d09e75473ad34698b412123615ef60d823.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدنه‌ی سرنگ موازی سطح اکلوزال فک بالا است و سوزن رو به عقب در امتداد داخل راموس پیش می‌رود. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 14.26)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباه رایج: سوزن رو به داخل. راموس به بیرون باز می‌شود؛ اگر سوزن موازی آن نرود، داخلی‌تر از لیگامان اسفنوماندیبولار می‌نشیند و بلاک شکست می‌خورد. این خطا برای راست‌دست در سمت چپ شایع‌تر است. زیاد پیش بردن سوزن هم دارو را به پاروتید و عصب صورتی می‌رساند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
