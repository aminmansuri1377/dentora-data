  "steps": [
    {
      "id": "theory:7ce4683f5b93c8aa19f42bf4d37c1fad003246653e40f7e3e72337e02a2551a8",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f301d4c61c29bdd7e3a423cf4c1f0b11ffe089fcabe1e095f862ae7e05d26b83",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آسپیراسیون در IANB"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن به استخوان خورده و آسپیره می‌کنی. کنار دیافراگم کارپول رگه‌ی قرمز کم‌رنگی می‌بینی و بیمار آرام منتظر است. تزریق را ادامه می‌دهی یا نه؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-11-18.webp",
                  "alt": "اگر بول به دیواره‌ی رگ بچسبد آسپیراسیون منفی کاذب می‌دهد؛ سرنگ را بچرخان و دوباره آسپیره کن.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/2830789b39c552ad7ceb2c4c0b2f13fa3cce55db87474c802782e3a13f9e25c2.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر بول به دیواره‌ی رگ بچسبد آسپیراسیون منفی کاذب می‌دهد؛ سرنگ را بچرخان و دوباره آسپیره کن. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 11.18)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "IANB بیشترین آسپیراسیون مثبت را میان تزریق‌های داخل دهانی دارد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۰ تا ۱۵٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". عصب کنار شریان و ورید آلوئولار تحتانی می‌گذرد؛ پس آسپیراسیون این‌جا تشریفات نیست."
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیستون را ۱ تا ۲ میلی‌متر عقب بکش؛ نوک سوزن نباید جابه‌جا شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کارپول را کنار دیافراگم، جایی که سوزن واردش شده، نگاه کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ را حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۴۵ درجه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بچرخان و دوباره آسپیره کن. ممکن است بول به دیواره‌ی رگ چسبیده باشد و آسپیراسیون اول منفی کاذب شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حین تزریق هم چند بار آسپیره کن؛ این کار سرعت تزریق را هم پایین نگه می‌دارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر خون دیدی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رگه‌ی قرمز کم‌رنگ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کنار دیافراگم: معمولاً ورید. سوزن را کمی جابه‌جا کن، دوباره آسپیره کن و اگر منفی بود، تزریق کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خون قرمز روشن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " که سریع کارپول را پر می‌کند: معمولاً شریان. سرنگ را از دهان بیرون بیاور، کارپول را عوض کن و از نو شروع کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در تزریق‌هایی که آسپیراسیون مثبت در آن‌ها شایع است، سوزن گیج ۲۵ را انتخاب کن؛ آسپیراسیون با سوزن باریک‌تر، مثل گیج ۲۷ یا ۳۰، کمتر قابل اعتماد است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:8b5aa8d39826e9cc3666c52758e2c307915ffd564ef6d14b37891ea7f0b49aba",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "247d7d6464da2ea6b6aed4384e5a70cce96604446bd1f4c443d4e86438b8eab2",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "نشانه‌های موفقیت IANB"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "علائم بافت نرم معمولاً ۳ تا ۵ دقیقه پس از تزریق ظاهر می‌شوند، ولی پالپ دیرتر بی‌حس می‌شود. پیش از شروع کار نشانه‌ها را یکی‌یکی بسنج، و اگر دندان هنوز حس دارد، پیش از آنکه IANB را شکست‌خورده بدانی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۰ تا ۱۵ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " صبر کن. بی‌حسی بافت نرم هیچ‌گاه تضمین بی‌حسی پالپ نیست."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گزگز یا بی‌حسی لب پایین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " عصب منتال، شاخه‌ی انتهایی عصب آلوئولار تحتانی، بی‌حس شده است. نشانه‌ی خوبی است که IANB نشسته، ولی عمق بی‌حسی را نشان نمی‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بی‌حسی زبان:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " عصب لینگوال بی‌حس شده است. معمولاً همراه IANB می‌آید، ولی بدون بی‌حسی عصب آلوئولار تحتانی هم پیش می‌آید."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تست سرما یا EPT:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پاسخ ندادن به بیشترین شدت EPT (۸۰ از ۸۰) در دو تست پیاپی با فاصله‌ی دست‌کم ۲ دقیقه، در دندان بدون پالپیت تقریباً (حدود ۹۹٪) بی‌حسی پالپ را تضمین می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نبود درد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در حین درمان."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اگر زبان بی‌حس شده ولی لب پایین هنوز حس دارد، فقط عصب لینگوال گرفته است و عصب آلوئولار تحتانی نه. کار را شروع نکن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عصب باکال لب پایین را عصب‌دهی نمی‌کند؛ پس بلاک باکال را می‌توانی بلافاصله پس از IANB بزنی و نگران نباشی که بی‌حسی لب را گمراه‌کننده کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
