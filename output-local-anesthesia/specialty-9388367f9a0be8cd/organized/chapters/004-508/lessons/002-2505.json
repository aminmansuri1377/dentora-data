      "contentKey": "94ec0d4dc8ed35ceb66758e0f93c5621d4733b89962eeebaa576c576211a30a6",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سوزن، وضعیت و نقطه‌ی ورود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار ۴۵ ساله‌ای برای درمان ریشه‌ی مولر اول پایین سمت چپ روی یونیت است و تو راست‌دستی. کجا می‌نشینی، کدام سوزن را برمی‌داری و سوزن را دقیقاً کجا وارد می‌کنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-14-7.webp",
                  "alt": "نقطه‌ی ورود محل برخورد خط افقی ارتفاع تزریق با خط عمودی سه چهارم فاصله‌ی ناچ کورونوئید تا رافه است.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/5cd2ee55319e8e62f873be2fa588819fb99bb1c70cbaa2793c1081d80c569eee.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقطه‌ی ورود محل برخورد خط افقی ارتفاع تزریق با خط عمودی سه چهارم فاصله‌ی ناچ کورونوئید تا رافه است. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 14.7)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن و وضعیت"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن بلند (حدود ۳۲ میلی‌متر)؛ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گیج ۲۵ ارجح"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است و گیج ۲۷ بلند هم قابل قبول."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار خوابیده به پشت، یا اگر لازم است نیمه‌خوابیده؛ دهان کاملاً باز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راست‌دست برای IANB سمت راست: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساعت ۸"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، رو به بیمار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راست‌دست برای IANB سمت چپ: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساعت ۱۰"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، هم‌جهت با بیمار."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیدا کردن نقطه‌ی ورود"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل را با گاز خشک کن و بی‌حسی سطحی را ۱ تا ۲ دقیقه بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انگشت اشاره یا شست دست چپ را در ناچ کورونوئید بگذار و بافت را به سمت خارج بکش تا کشیده شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارتفاع: خطی فرضی از نوک انگشت تا عمیق‌ترین نقطه‌ی پتریگومندیبولار رافه، موازی سطح اکلوزال؛ معمولاً "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۶ تا ۱۰ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بالاتر از آن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقطه‌ی ورود روی همین خط است، در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سه چهارم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فاصله از ناچ کورونوئید تا رافه."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدنه‌ی سرنگ را روی گوشه‌ی دهان طرف مقابل بگذار، معمولاً روی پرمولرها."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "جهت بول در IANB اهمیت زیادی ندارد، چون سوزن تقریباً عمود به عصب می‌رسد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:bab2ee14e86a6dfaa6035dfbe20ae6e2ad490a218e10098506709a42a1e1c3e3",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "6a4b13c6be501a0e020fc4662a88ca6094eee989287394e0d26e7be9343c41c8",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "عمق، برخورد با استخوان و تزریق"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوزن را آرام تا استخوان جلو ببر. در بزرگسال میانگین عمق تا استخوان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲۰ تا ۲۵ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، یعنی دو سوم تا سه چهارم سوزن بلند. نوک سوزن حالا کمی بالاتر از سوراخ مندیبولار است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-14-8.webp",
                  "alt": "عمق نفوذ تا استخوان ۲۰ تا ۲۵ میلی‌متر است، یعنی دو سوم تا سه چهارم سوزن بلند.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/117586d0dd080db1704d3a9f36dbd05edbeecf4b19817dd024e2c30cdf5f68ab.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمق نفوذ تا استخوان ۲۰ تا ۲۵ میلی‌متر است، یعنی دو سوم تا سه چهارم سوزن بلند. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 14.8)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از برخورد با استخوان، سوزن را حدود ۱ میلی‌متر عقب بکش تا دارو زیر پریوست نرود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در دو صفحه آسپیره کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر منفی بود، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱٫۵ میلی‌لیتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را آرام و در دست‌کم "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۶۰ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تزریق کن و وسط کار دوباره آسپیره کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ را آرام بیرون بکش؛ وقتی نیمی از سوزن در بافت مانده، دوباره آسپیره کن و اگر منفی بود، حدود ۰٫۲ میلی‌لیتر برای عصب لینگوال بریز."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از حدود ۲۰ ثانیه بیمار را بنشان. علائم بافت نرم معمولاً ۳ تا ۵ دقیقه بعد ظاهر می‌شوند؛ پیش از شروع کار پالپ را جداگانه بسنج."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اصلاح مسیر"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "استخوان زود لمس شد"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (کمتر از نیمی از سوزن بلند): نوک سوزن زیادی جلو (خارج) روی راموس است، جایی که استخوان ضخیم‌تر و بافت نرم حدود ۱۰ میلی‌متر است. کمی عقب بکش، بدنه را روی کانین یا لترال طرف مقابل ببر و دوباره جلو برو."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "استخوان لمس نشد:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " نوک سوزن زیادی عقب (داخل) است. عقب بکش تا حدود یک چهارم سوزن در بافت بماند، بدنه را روی مولرها ببر و دوباره تا استخوان پیش برو."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "تا استخوان لمس نشده، دارو نریز."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
