    {
      "id": "theory:7239e68376097c7dae781ab3917c5a9c8875b8f1dbc8285c23f39a61a5b785d5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "4dc2c68ba882911d71de820cfa56c351535c6ff8f880cf4ebba960f282d700ed",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فلج گذرای عصب صورتی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "چند دقیقه پس از IANB سمت راست، بیمار می‌گوید چشم راستش کامل بسته نمی‌شود و لب بالایش در همان سمت افتاده است. هنگام تزریق سوزن به استخوان نخورده بود. چه اتفاقی افتاده و چه می‌کنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-17-8.webp",
                  "alt": "فلج گذرای عصب صورتی: پلک همان سمت بسته نمی‌شود و لب افتاده است.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/3fc5f839d258b9e5e2d020e019c8c1199583aa3411c18594640850266de9ad09.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فلج گذرای عصب صورتی: پلک همان سمت بسته نمی‌شود و لب افتاده است. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 17.8)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی سوزن به استخوان نمی‌خورد، نوکش ممکن است پشت لبه‌ی خلفی راموس و درون "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غده‌ی پاروتید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد؛ همان‌جا که شاخه‌های عصب صورتی (زوج هفتم) می‌گذرند. دارو این عصب حرکتی را از کار می‌اندازد: پلک پایین بسته نمی‌شود و لب بالا در همان سمت می‌افتد. بی‌حسی حسی معمولاً کم است یا اصلاً نیست."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اقدام"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را آرام کن و توضیح بده که گذراست؛ به اندازه‌ی بی‌حسی بافت نرم، یعنی چند ساعت، طول می‌کشد و اثری نمی‌گذارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لنز تماسی را تا برگشت حرکت پلک دربیاور."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روی چشم پد بگذار، یا بخواه پلک را گاه‌به‌گاه با دست ببندد تا قرنیه خشک نشود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رویداد را در پرونده ثبت کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تزریق دوباره منعی ندارد، ولی بهتر است درمان آن ربع را به جلسه‌ی بعد بگذاری."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیشگیری ساده است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدون برخورد با استخوان، دارو نریز."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تماس سوزن با سطح داخلی راموس عملاً جلوی رسیدن دارو به پاروتید را می‌گیرد. اگر هنگام ورود سوزن بیمار حس «برق‌گرفتگی» گزارش کرد، سوزن به عصب خورده است؛ عصب لینگوال شایع‌ترین عصبی است که پس از تزریق دچار پارستزی می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:380b1d9ebda8936f829a7fd07091546f068d1a484bd5862197c353b4bc44afb9",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "f32ef20a565e3b6878c95c61b4a229809d87fdf1b670fd0f8558e970c554f046",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هماتوم، تریسموس و شکستن سوزن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هماتوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس از IANB نادر است: تورمی در سمت داخل راموس که معمولاً فقط داخل دهان دیده می‌شود. دست‌کم ۳ تا ۵ دقیقه روی ناحیه فشار بده. تورم و تغییر رنگ در ۷ تا ۲۱ روز برطرف می‌شود."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-17-3.webp",
                  "alt": "تکه‌ی سوزن شکسته در فضای پتریگومندیبولار روی رادیوگرافی؛ سوزن را هرگز تا هاب فرو نبر.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/ed890c3928c9a29e4a75f7711012863d158957da485a07482e848e4ea8861b1a.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تکه‌ی سوزن شکسته در فضای پتریگومندیبولار روی رادیوگرافی؛ سوزن را هرگز تا هاب فرو نبر. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 17.3)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تریسموس:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کمی درد عضله هنگام باز کردن دهان، پس از رفتن بی‌حسی، بسیار شایع است؛ محدودیت شدید باز شدن دهان نادر است. ورود مکرر سوزن و حجم زیاد دارو، مثلاً پس از چند IANB ناموفق، خطرش را بالا می‌برد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "شکستن سوزن"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "همه‌ی موارد گزارش‌شده در IANB یا PSA بوده، بیشتر با سوزن کوتاه یا گیج ۳۰ که تا هاب وارد شده است؛ سوزن هم از هاب می‌شکند، نه از تنه."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای IANB بزرگسال سوزن کوتاه برندار، و سوزن گیج ۳۰ را برای IANB در هیچ سنی به کار نبر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن را پیش از تزریق خم نکن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن را تا هاب وارد بافت نکن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به استخوان محکم ضربه نزن؛ دردناک است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "IANB برای کودک خردسال و بیماری که احتمال گاز گرفتن لب و زبانش زیاد است (مثلاً بیمار با ناتوانی ذهنی یا جسمی) با احتیاط انتخاب می‌شود. IANB دوطرفه هم به‌ندرت لازم است؛ برای دندان‌های قدامی، IANB یک طرف و بلاک اینسیزیو در طرف دیگر جایگزین خوبی است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
