  "steps": [
    {
      "id": "theory:5b7029cea28594ea52aedbaf80fbfa011ea4ec4760d3134d32f4df8fcf893a59",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "3591421e90938fbad2ce396849643abc2567c133b5785e1d9913ef95e886be90",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "علائم حیاتی پایه و خطاهای فشارسنجی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "خانمی ۵۵ ساله برای ترمیم مولر اول پایین آمده و قرار است IANB بگیرد. دستیار با کاف معمولی بزرگسال، روی بازوی چاق او، فشار ۱۶۶/۹۸ را ثبت کرده. پیش از تزریق به این عدد اعتماد می‌کنی؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حداقل معاینه برای هر بیمار: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم حیاتی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و نگاه به ظاهر بیمار. پرسشنامه گذشته را نشان می‌دهد و علائم حیاتی وضع همین لحظه را. فشار، نبض و ریتم، و تنفس را برای همه بگیر؛ دما، قد و وزن اختیاری‌اند مگر شک خاصی داشته باشی."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدد "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پایه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " را در جلسه‌ی اول، پیش از هر درمان، ثبت کن. فشار ۸۰/۵۰ در اورژانس، در کسی که پایه‌اش ۱۰۰/۶۰ است بسیار کم‌خطرتر از کسی است که پایه‌اش ۱۹۰/۱۱۰ است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر داروی تزریقی، از جمله بی‌حسی موضعی، پایش بیشتر علائم حیاتی می‌خواهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار نشسته و ۵ دقیقه آرام، بازو هم‌سطح قلب، لبه‌ی پایین کاف ۲ تا ۳ سانتی‌متر بالای چین آرنج."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "خطاهای رایج"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کاف شل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، شایع‌ترین خطا: عدد به‌دروغ بالا"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاف کوچک روی بازوی چاق: به‌دروغ بالا؛ کاف بزرگ روی بازوی لاغر: به‌دروغ پایین"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خواندن از نوسان عقربه به جای صدا: سیستولی ۱۰ تا ۱۵ mmHg بالاتر"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اضطراب دیدن فشارسنج: بیشتر فشار سیستولی بالا می‌رود"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تفاوت دو بازو: در حدود ۲۰٪ افراد بیش از ۱۰ mmHg"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای اندازه‌گیری دوباره دست‌کم ۱۵ ثانیه صبر کن تا خون بازو تخلیه شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:c6b9f79d84921e9e6d813d288c97ebd6854f872c734d9fc0420f7d66929eef5d",
      "sourceId": null,
