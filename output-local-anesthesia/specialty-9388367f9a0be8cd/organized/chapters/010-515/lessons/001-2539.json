  "steps": [
    {
      "id": "theory:1075675968cabd7ed3640e69991e5a24280a22231e934746abf750290523a8b5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "145ee6b3f2cb81b17e91e9ba8622bad2305ed463e49669c6a86418a511212b43",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا تزریق کامی درد دارد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار ۴۰ ساله‌ای برای جراحی لثه در سمت پالاتال پرمولرهای بالا آمده است. تا سرنگ را می‌بیند می‌گوید: «از تزریق کام متنفرم، دفعه‌ی قبل اشکم درآمد.» آیا تزریق کامی ناگزیر درد دارد؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-32.webp",
                  "alt": "بول روی مخاط و زیر فشار سواب است؛ چند قطره دارو پیش از ورود سوزن در بافت ریخته می‌شود.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/68751e2411cfb08697048fa45ae7f4911a1868835fcfb37be1b389cb25ec4920.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بول روی مخاط و زیر فشار سواب است؛ چند قطره دارو پیش از ورود سوزن در بافت ریخته می‌شود. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.32)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نه. بیشتر درد تزریق کامی از روش تزریق است، نه از خود کام. بافت نرم کام دو ویژگی دارد که کار را حساس می‌کند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متراکم است و جای کمی برای محلول دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محکم به استخوان زیرین چسبیده است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر محلول را تند تزریق کنی، فشار بافت بالا می‌رود و بافت پاره می‌شود. نتیجه دو درد است: درد هنگام تزریق، و دردناکی ناحیه پس از رفتن بی‌حسی."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پنج گام تزریق کامی کم‌درد"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی سطحی کافی در نقطه‌ی ورود سوزن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار با سواب پنبه‌ای روی ناحیه، پیش از ورود سوزن و در تمام مدت تزریق."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کنترل کامل سوزن با تکیه‌گاه محکم دست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تزریق آهسته‌ی محلول."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باور به اینکه می‌توانی بی‌درد تزریق کنی؛ همین باور تو را به دقت بیشتر وامی‌دارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تزریق‌های کامی بافت نرم و استخوان کام را بی‌حس می‌کنند و برای هموستاز هم به کار می‌روند، ولی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی پالپ نمی‌دهند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". دو تکنیک AMSA و P-ASA استثنا هستند و جداگانه درس داده می‌شوند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:58530893fb50004c2e38540ba67b97936fc7232d5e30247d5a8a6e4edfbe32b4",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5a4bb690e626965aab2e715c5a6ba1747322c21d89558cc853ea5d5b9396e224",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بی‌حسی سطحی، فشار سواب و تزریق آهسته"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بی‌حسی سطحی را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌کم ۲ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی نقطه‌ی ورود نگه دار. کام تنها جای دهان است که باید سواب را در تمام این مدت خودت با دست نگه داری."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-24.webp",
                  "alt": "فشار چوب سواب مخاط کام را سفید (ایسکمیک) می‌کند؛ سوزن در همین ناحیه وارد می‌شود.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/c92c0ca40bbdfbc52291a0518f6720b31551696dbe646a21de92cae35417e598.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فشار چوب سواب مخاط کام را سفید (ایسکمیک) می‌کند؛ سوزن در همین ناحیه وارد می‌شود. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.24)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سپس با همان چوب سواب، بافت کنار نقطه‌ی ورود را محکم فشار بده تا مخاط صورتی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سفید (ایسکمیک)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شود و بیمار فشاری کُند و قابل‌تحمل حس کند، نه درد تیز. این pressure anesthesia بر پایه‌ی نظریه‌ی gate control کار می‌کند و باید تا وقتی سوزن در بافت است ادامه یابد. دسته‌ی آینه و ابزار فلزی یا پلاستیکی احتمال درد بیشتری دارند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سوزن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کوتاه، گیج ۲۷؛ بیمار فرق گیج ۲۷ و ۳۰ را حس نمی‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کنترل سوزن:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تکیه‌گاه محکم دست؛ گاهی با هر دو دست، و بدنه‌ی سرنگ تکیه‌داده به لب پایین بیمار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پیش از ورود:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بول را روی بافت سفیدشده بگذار و کمی فشار بده تا سوزن خم شود؛ قطره‌ای محلول روی مخاط بریز، بعد سوزن را صاف کن تا بول وارد بافت شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هنگام پیشروی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مقدار کمی محلول را پیوسته تزریق کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گفتن «این یکی کمی درد دارد» پیش از تزریق. این جمله بیمار را آماده‌ی درد می‌کند و تو را از دقت بیشتر معاف. سیستم کامپیوتری تزریق (C-CLAD) هم تزریق کامی کم‌درد را ساده‌تر کرده است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
