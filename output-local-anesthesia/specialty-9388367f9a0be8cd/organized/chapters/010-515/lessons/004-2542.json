  "steps": [
    {
      "id": "theory:7d6fc4d461f64871d7926ff3210a67262f1b7f2dcafdd6c79317fe4f82898ebe",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "8f0c0a8e1296a428b1fcfa61da2a113a34307be1e8d00cae67d834fc39089f31",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اینفیلتراسیون کام: کی و چطور"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "هنگام گذاشتن کلمپ رابردم روی پرمولر اول بالا، لثه‌ی پالاتال زیر فک کلمپ درد می‌گیرد. دندان با تزریق باکال بی‌حس شده است. برای همین یک نقطه، بلاک کامی لازم است؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-44.webp",
                  "alt": "اینفیلتراسیون کام: ورود در لثه‌ی چسبنده‌ی پالاتال، کنار همان دندانی که باید بی‌حس شود.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/26390e02e745a5b3e12a05e9612e2d0bdfd5b04315c9e591e63e857742a7e8d8.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اینفیلتراسیون کام: ورود در لثه‌ی چسبنده‌ی پالاتال، کنار همان دندانی که باید بی‌حس شود. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.44)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نه. برای ناحیه‌ی کوچک، اینفیلتراسیون کام کافی است. این تزریق شاخه‌های انتهایی عصب‌های نازوپالاتین و پالاتین بزرگ را بی‌حس می‌کند و فقط بافت نرم نزدیک محل تزریق بی‌حس می‌شود."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کاربرد اصلی:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هموستاز در جراحی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کاربرد دیگر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بی‌حسی محدود لثه‌ی پالاتال برای کلمپ رابردم، نخ رترکشن یا کار روی حداکثر دو دندان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "منع:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " التهاب یا عفونت در محل، و بی‌حسی بافت نرم بیش از دو دندان."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن کوتاه گیج ۲۷؛ در ساعت ۱۰ بنشین: برای سمت راست رو به بیمار، برای سمت چپ هم‌جهت با او."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقطه‌ی ورود: لثه‌ی چسبنده، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۵ تا ۱۰ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از لبه‌ی لثه‌ی آزاد، وسط ناحیه‌ی درمان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی سطحی ۲ دقیقه، سپس فشار سواب روی بافت درست کنار نقطه‌ی ورود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زاویه‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۴۵ درجه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "، بول رو به بافت کام، قطره‌ی پیش از ورود و تزریق پیوسته."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیشروی تا برخورد ملایم با استخوان؛ ضخامت بافت در بیشتر بیماران "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۳ تا ۵ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "معمولاً "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۲ تا ۰٫۳ میلی‌لیتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کافی است. کار را بی‌درنگ شروع کن."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:2d7a948d43895513015e06061026a81cd55bb6547473335cac63923685216c14",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "c9a7c772cdaf1fd64094905d62ff47d25fda0097e9159b42a4622c16e8a4dd88",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هموستاز، نکروز بافت و انتخاب تزریق کامی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای هموستاز، آن‌قدر تزریق کن که ایسکمی کل ناحیه‌ی جراحی را بگیرد. برای ناحیه‌ی بزرگ‌تر، سوزن را در لبه‌ی بافتی که تازه بی‌حس شده دوباره وارد کن و تزریق‌های هم‌پوشان را تا پوشش کل ناحیه ادامه بده. در تزریق‌های بعدی بی‌حسی سطحی لازم نیست."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-45.webp",
                  "alt": "برای ناحیه‌ی بزرگ‌تر، هر تزریق بعدی در لبه‌ی بافتی که تازه بی‌حس شده وارد می‌شود تا ناحیه‌ها هم‌پوشان شوند.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/8fd8e6692085cbc1c2fe0474ef403895320db8e6b90c64656d591fd4e4aec529.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای ناحیه‌ی بزرگ‌تر، هر تزریق بعدی در لبه‌ی بافتی که تازه بی‌حس شده وارد می‌شود تا ناحیه‌ها هم‌پوشان شوند. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.45)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تنگ‌کننده هموستاز را بهتر می‌کند، ولی بافت ملتهب ممکن است با وجود آن هم خون‌ریزی کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر اپی‌نفرین غلیظ (۱:۵۰٬۰۰۰) را طی چند ساعت، هر بار که ایسکمی برطرف شد، دوباره تزریق کنی، بافت کام ممکن است نکروز شود و پوسته بریزد. کام تقریباً تنها جای دهان است که این عارضه در آن دیده می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هماتوم پس از تزریق کامی نادر است، چون بافت متراکم و چسبیده به استخوان است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کدام تزریق کامی؟"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک یا دو دندان: اینفیلتراسیون کام."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیش از دو دندان در کام خلفی یک طرف: بلاک پالاتین بزرگ."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کام قدامی از کانین تا کانین: بلاک نازوپالاتین."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کام کانین و پرمولر اول از هر دو عصب فیبر می‌گیرد. اگر پس از هر یک از دو بلاک این ناحیه هنوز حس داشت، یک اینفیلتراسیون کوتاه همان‌جا بی‌حسی را کامل می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
