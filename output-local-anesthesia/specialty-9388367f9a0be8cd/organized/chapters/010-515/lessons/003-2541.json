  "steps": [
    {
      "id": "theory:b41fe473cb1ca9b4efe0e2db808e142fa8ebefc6c02302c54f0ae83379c8efd4",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "60e0f7308a15ea0aded7cb7ae38b8ee6ffe6a02e30a426da73d0a406d507713b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بلاک نازوپالاتین با یک بار ورود سوزن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "برای جراحی پریو در سمت پالاتال کانین تا کانین بالا، بیمار تعریف می‌کند که دفعه‌ی قبل سوزن را «درست وسط برجستگی پشت دندان‌های جلو» فرو کرده‌اند و از درد از جا پریده است. کجای کار اشتباه بود؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-40.webp",
                  "alt": "ورود سوزن کنار پاپیلای اینسیزیو است، نه وسط آن؛ فشار سواب تا پایان تزریق می‌ماند.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/267114530a86ed8879c2aa0f9820c9a50b40ac52d136e51e8e055c11319f8de5.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ورود سوزن کنار پاپیلای اینسیزیو است، نه وسط آن؛ فشار سواب تا پایان تزریق می‌ماند. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.40)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عصب‌های نازوپالاتین دو طرف با هم از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوراخ اینسیزیو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیرون می‌آیند؛ در خط وسط، حدود ۱ سانتی‌متر پشت سانترال‌ها و زیر پاپیلای اینسیزیو. این بلاک با حداکثر یک‌چهارم کارپول، کام قدامی هر دو طرف را از مزیال پرمولر اول راست تا مزیال پرمولر اول چپ بی‌حس می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بافت این ناحیه متراکم، چسبیده به استخوان و بسیار حساس است. برای همین نازوپالاتین بالقوه دردناک‌ترین تزریق داخل دهان است و پروتکل کم‌درد این‌جا از همه‌جا مهم‌تر است."
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن کوتاه گیج ۲۷؛ در ساعت ۹ یا ۱۰ هم‌جهت با بیمار بنشین."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی سطحی ۲ دقیقه "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کنار"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پاپیلای اینسیزیو، سپس فشار سواب روی خود پاپیلا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ورود سوزن کنار پاپیلا با زاویه‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۴۵ درجه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " رو به آن؛ نه مستقیم درون پاپیلا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قطره‌ی پیش از ورود و تزریق پیوسته تا برخورد ملایم با استخوان؛ عمق معمولاً "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیش از ۵ میلی‌متر نیست"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " عقب بکش تا محلول زیر پریوست نرود، سپس آسپیراسیون کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حداکثر "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۴۵ میلی‌لیتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " در ۱۵ تا ۳۰ ثانیه. اگر ایسکمی از ناحیه‌ی فشار سواب فراتر رفت، می‌توانی زودتر دست نگه داری. ۲ تا ۳ دقیقه صبر کن."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:9dce11104e56b4e2c15d18ef2564e0c09169f439747338b962b8b50585eef6ce",
      "sourceId": null,
