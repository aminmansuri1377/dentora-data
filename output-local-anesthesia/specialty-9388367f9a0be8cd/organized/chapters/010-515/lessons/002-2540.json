  "steps": [
    {
      "id": "theory:fceeecdb6d79bd43b5d8242f471e22a188012215c5968525a5a95ec552f91bfd",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6a4a1ac0c97708ab3f194d7818ee98206fc1e231df88d4e58576ebda6c40a90b",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آناتومی و کاربرد بلاک پالاتین بزرگ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "برای فلپ پالاتال از پرمولر دوم تا مولر دوم بالا، دانشجو می‌خواهد کنار هر دندان جداگانه در کام تزریق کند. با یک تزریق هم می‌شود؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-27.webp",
                  "alt": "هدف بلاک پالاتین بزرگ: کمی جلوی سوراخ پالاتین بزرگ، معمولاً کنار دیستال مولر دوم بالا.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/9047f6bb860d3ccc17038db16ce61db32f10021e9cdc78c67a0ee4dd45b88a32.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هدف بلاک پالاتین بزرگ: کمی جلوی سوراخ پالاتین بزرگ، معمولاً کنار دیستال مولر دوم بالا. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.27)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بله، با بلاک عصب پالاتین بزرگ (greater palatine). این عصب از سوراخ پالاتین بزرگ بیرون می‌آید و بین مخاط‌-پریوست و استخوان کام به جلو می‌رود تا حدود پرمولر اول؛ آنجا با فیبرهای عصب نازوپالاتین هم‌پوشانی دارد. برای همین گاهی کام پرمولر اول پس از این بلاک کامل بی‌حس نمی‌شود و یک تزریق موضعی کوتاه همان‌جا لازم است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ناحیه‌ی بی‌حس:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بخش خلفی کام سخت و بافت نرم رویش، به جلو تا پرمولر اول و به داخل تا خط وسط."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کاربرد:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بی‌حسی بافت نرم کام برای بیش از دو دندان، و جراحی پریو یا جراحی دهان در کام."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "منع:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " التهاب یا عفونت در محل تزریق، و کار روی یک یا دو دندان."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این بلاک از بلاک نازوپالاتین کم‌دردتر است، چون بافت اطراف سوراخ پالاتین بزرگ کمتر به استخوان چسبیده و حجم محلول را بهتر جا می‌دهد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوراخ پالاتین بزرگ کجاست؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در محل اتصال زائده‌ی آلوئولار و کام سخت، حدود ۱ سانتی‌متر به سمت خط وسط، در ناحیه‌ی مولر دوم و سوم. شایع‌ترین جا روبه‌روی نیمه‌ی قدامی مولر سوم است (حدود ۵۱٪)، سپس نیمه‌ی خلفی مولر دوم (حدود ۴۰٪) و گاهی نیمه‌ی خلفی مولر سوم (حدود ۹٪)."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:99723dd098b31ee5fc4c9d1596b751654d5dfd698666d751fd974ffb826b2003",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "6970957b73421f609ea0d9a02c7969926d51eda8c5f3970ed9fdd5196049b0c2",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تکنیک بلاک پالاتین بزرگ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوزن کوتاه گیج ۲۷. دندانپزشک راست‌دست برای سمت راست در ساعت ۷ یا ۸ رو به بیمار می‌نشیند؛ برای سمت چپ در ساعت ۱۱ هم‌جهت با بیمار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سواب را از کنار مولر اول، در محل اتصال زائده‌ی آلوئولار و کام، با فشار به عقب بکش تا در فرورفتگی سوراخ «بیفتد»."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی سطحی ۲ دقیقه روی نقطه‌ای "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۱ تا ۲ میلی‌متر جلوتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " از سوراخ."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سواب را روی خود سوراخ بگذار و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دست‌کم ۳۰ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " فشار بده تا بافت سفید شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنگ را از سمت مقابل دهان بیاور تا سوزن "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عمود"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بر محل برسد؛ بول رو به بافت نرم کام."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قطره‌ی پیش از ورود، سپس پیشروی آهسته با تزریق پیوسته تا برخورد ملایم با استخوان؛ عمق معمولاً "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حدود ۵ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو بار آسپیراسیون، بار دوم با چرخاندن سرنگ حدود ۴۵ درجه. اگر منفی بود، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۰٫۴۵ تا ۰٫۶ میلی‌لیتر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (یک‌چهارم تا یک‌سوم کارپول) را در دست‌کم ۳۰ ثانیه تزریق کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ تا ۳ دقیقه صبر کن، بعد کار را شروع کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "موفقیت این بلاک بیش از ۹۵٪ و آسپیراسیون مثبت آن کمتر از ۱٪ است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/la-fig-13-30.webp",
                  "alt": "سواب را روی کام به عقب بکش تا در فرورفتگی سوراخ پالاتین بزرگ «بیفتد».",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/c2dbc66b7fc5a2ba0967a0a4f58f2fae02be99012d348b274385973e94955fe4.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سواب را روی کام به عقب بکش تا در فرورفتگی سوراخ پالاتین بزرگ «بیفتد». "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Malamed. Handbook of Local Anesthesia, 7th ed. — Fig. 13.30)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "وارد کانال پالاتین بزرگ نشو؛ لازم نیست. اگر محلول خیلی جلوتر از سوراخ تزریق شود، بافت پشت محل تزریق بی‌حس نمی‌شود. اگر عصب پالاتین میانی نزدیک محل بیرون بیاید، کام نرم هم بی‌حس می‌شود و برخی بیماران از این احساس ناراحت‌اند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
