  "steps": [
    {
      "id": "theory:33e94d1b58ff888ee541400db976fc8e835dcaf4d6b0bcb21dba7210629b6857",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "2fb9ea04707a87dc48ea2d95f9952b79c830f3deb6b78d38576e8813fa558e59",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رضایت آگاهانه پیش از بی‌حسی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "سه هفته پس از IANB با آرتیکائین ۴٪، بیمار با بی‌حسی ماندگار لب پایین برگشته و می‌پرسد: «چرا از اول نگفتید چنین چیزی ممکن است؟» در پرونده جز «IANB زده شد» چیزی ننوشته‌ای. کجای کار لنگید؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تزریق بی‌حسی خودش کاری با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطر قابل پیش‌بینی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: هماتوم، پارستزی، مسمومیت، آلرژی، شکستن سوزن. پس مثل هر درمان دیگری رضایت آگاهانه می‌خواهد. این اصل‌ها همه‌جا معتبرند؛ جزئیات قانونی و فرم‌ها را از مقررات جاری محل کارت بدان."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در رضایت آگاهانه بیمار این پنج چیز را می‌شنود و بعد خودش انتخاب می‌کند:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان پیشنهادی و روش آن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان‌های جایگزین"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برتری درمان پیشنهادی بر جایگزین‌ها"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطرهای مهم آن"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطرهای درمان نکردن"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رضایت می‌تواند شفاهی باشد، ولی اگر بعداً اختلافی پیش آید، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رضایت‌نامه‌ی کتبی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بسیار کمک می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای کودک، یا بیماری که توان تصمیم ندارد، رضایت از "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ولی یا سرپرست قانونی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گرفته می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رضایت برای همان کار، همان جلسه و همان درمانگر است؛ به کار دیگر، جلسه‌ی دیگر یا همکار دیگر منتقل نمی‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در اورژانس، مثلاً بیمار بی‌هوش، رضایت ضمنی فرض می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قول «اصلاً درد ندارد» نده، و بدان امضای برگه‌ی «مسئولیت هر پیامدی با خودم» سهل‌انگاری را نمی‌پوشاند."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:b015999e5bdfe3f3e19868d0025b637744e946776915354d8035ca312bd50acb",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "7c9b8bbaeb5fc3c96848297a6ad0ae84896c3d03426d20108b7c3e5cbe89ff3a",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مستندسازی بی‌حسی و عارضه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس از هر تزریق در پرونده بنویس"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نام دارو، غلظت و تنگ‌کننده (مثلاً لیدوکائین ۲٪ با اپی‌نفرین ۱:۱۰۰٬۰۰۰)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شمار کارپول و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مقدار به میلی‌گرم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ دوز با میلی‌گرم سنجیده می‌شود، نه با شمار کارپول"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تکنیک و سمت (مثلاً IANB راست)، گیج و طول سوزن، ساعت تزریق"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نتیجه‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آسپیراسیون"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و واکنش بیمار حین تزریق"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تاریخچه‌ی پزشکی و علائم حیاتی پیش از تزریق هم ثبت شده باشد. اگر گزینه‌ی کمتر رایجی برگزیده‌ای، مثلاً محلول ۴٪ به‌جای ۲٪ برای IANB، باید بتوانی دلیلش را توضیح دهی."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر عارضه رخ داد"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیمار را درست درمان کن؛ ناتوانی در درمان عارضه‌ای که قابل پیش‌بینی بود، کوتاهی شمرده می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "همان روز بنویس: ساعت، آنچه دیدی، آنچه کردی، آنچه به بیمار گفتی و برنامه‌ی پیگیری."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یادداشت قبلی را پاک یا دست‌کاری نکن؛ هر اصلاحی را با تاریخ بیفزا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر کاری از دستت برنمی‌آید، مثلاً بیرون آوردن سوزن شکسته، ارجاع فوری را خودت هماهنگ کن، بیمار را رها نکن و پس از ارجاع هم پیگیرش باش."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "نکته‌ی طلایی: دستیار را کنار صندلی نگه دار. در اورژانس دست کمکی است و شاهد آنچه رخ داده."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
