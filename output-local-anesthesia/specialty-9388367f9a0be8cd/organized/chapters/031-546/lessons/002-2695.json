  "steps": [
    {
      "id": "theory:3e66cdaf43f07b0fb56b4501cda840853a791e4fda3751fde3f943a5380eb660",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "5088be778ee3a689ec478acefffebd118a22474cffbc0c96747ad4f50d42be4d",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "بی‌حسی باقی‌مانده‌ی بافت نرم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "پسری ۶ ساله و ۲۲ کیلوگرمی با IANB و لیدوکائین ۲٪ با اپی‌نفرین ترمیم مولر شیری گرفته. کار ۲۰ دقیقه‌ای تمام شده، ولی لب پایینش تا چند ساعت دیگر بی‌حس می‌ماند و مادرش نگران گاز گرفتن لب است. چه گزینه‌ای داری؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "با داروی تنگ‌کننده‌دار، بی‌حسی پالپ حدود ۶۰ دقیقه است ولی بی‌حسی بافت نرم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳ تا ۵ ساعت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". کار ترمیمی معمولاً خیلی زودتر تمام می‌شود و بیمار ساعت‌ها با لب و زبان بی‌حس می‌ماند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مشکل کارکردی: سخت حرف زدن، لبخند کج، ریختن آب هنگام نوشیدن، آبریزش دهان"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مشکل ظاهری: حس ورم کردن لب"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطر اصلی: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گاز گرفتن لب و زبان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "؛ پس از IANB در کودک زیر ۴ سال حدود ۱۸٪، ۴ تا ۷ سال ۱۶٪، ۸ تا ۱۱ سال ۱۳٪ و ۱۲ سال و بیشتر ۷٪"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گروه‌های پرخطر دیگر: بیمار با ناتوانی ذهنی و سالمند دچار دمانس"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فنتولامین چه می‌کند"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فنتولامین مزیلات"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گیرنده‌های آلفا آدرنرژیک را مهار می‌کند و رگ‌ها را گشاد می‌کند. جریان خون محل بیشتر می‌شود و داروی بی‌حسی زودتر از اطراف عصب به گردش خون می‌رود؛ پس حس بافت نرم زودتر برمی‌گردد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:6d61701d395a7630c3cf381ff5416113e47bbccd2ee091c971fe45541aa14d82",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "b6b0f47e0cf51760fc33cbe55b4581c7d1cb77c7fc2b2f0088c84953d999c1c8",
      "position": 2,
      "kind": "theory",
