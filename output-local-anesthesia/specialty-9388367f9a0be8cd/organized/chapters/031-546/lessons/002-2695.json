      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تزریق فنتولامین و حدود آن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش تزریق"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در پایان کار، وقتی دیگر به بی‌حسی نیاز نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به همان تعداد کارپولی که بی‌حسی زده‌ای، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "حداکثر دو کارپول"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "همان محل"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "همان تکنیک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (بلاک یا اینفیلتراسیون)."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کارپول دندانپزشکی فنتولامین ۱٫۷ میلی‌لیتر است و ۰٫۴ میلی‌گرم دارو دارد، حدود یک‌بیستم غلظت پزشکی."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چقدر زودتر (زمان میانه‌ی برگشت حس)"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لب بالا: ۵۰ دقیقه در برابر حدود ۱۳۳ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لب پایین: ۷۰ دقیقه در برابر ۱۵۵ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زبان: ۶۰ دقیقه در برابر ۱۲۵ دقیقه"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودک ۶ تا ۱۱ ساله: ۶۰ دقیقه در برابر ۱۳۵ دقیقه"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کجا نه"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودک "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "زیر ۳ سال یا زیر ۱۵ کیلوگرم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": توصیه نمی‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فقط بی‌حسی داروی تنگ‌کننده‌دار را کوتاه می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از جراحی معمولاً نه؛ بی‌حسی طولانی جلوی درد ناگهانی پس از عمل را می‌گیرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از PDL، اینتراسپتال یا اینترااوسئوس لازم نیست؛ بی‌حسی بافت نرم آن‌ها محدود است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "نکته‌ی طلایی: عارضه‌ی جدی دارویی گزارش نشده است. تریسموس یا پارستزی احتمالی از خود عمل تزریق است، نه از دارو؛ پس همان احتیاط‌های هر تزریق را رعایت کن."
                }
              ]
            }
          ]
        }
      ],
