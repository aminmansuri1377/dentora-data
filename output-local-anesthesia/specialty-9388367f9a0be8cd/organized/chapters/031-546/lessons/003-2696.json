    {
      "id": "question:46315",
      "sourceId": "46315",
      "identityOrigin": "source-question-id",
      "sourceProgress": "width: 57.1429%;",
      "contentKey": "620d2a7fa8fb9fb230da908a965b56c55a95c7d12142dbb35139499116ae882d",
      "position": 5,
      "kind": "question",
      "type": "single-choice",
      "prompt": "پس از اسپری بینی دوطرفه، سانترال تا پرمولر اول بی‌حس است ولی پرمولر دوم به تراش حساس است. کدام توضیح و اقدام درست است؟",
      "sourceContent": [
        {
          "tag": "div",
          "attributes": {},
          "children": [
