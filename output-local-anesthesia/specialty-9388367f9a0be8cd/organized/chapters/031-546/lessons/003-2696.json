  "steps": [
    {
      "id": "theory:0e4c3640df11f895c17f7fb1c350b585506bc4aee5cabc8f515bcba65c07383f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "47cd00dcae49294c20b4ebaa864dce1eaef836618817a51fba179709584f5057",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اسپری بینی برای دندان‌های قدامی بالا"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مردی ۴۰ ساله و ۷۵ کیلوگرمی برای ترمیم کامپوزیت سانترال بالا آمده و با دیدن سرنگ رنگش می‌پرد: «هر کاری بکنید جز آمپول.» راهی بدون سوزن هست؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برای بعضی دندان‌های بالا، بله. اسپری بینی ترکیب "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تتراکائین ۳٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکسی‌متازولین ۰٫۰۵٪"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. اکسی‌متازولین تنگ‌کننده‌ی رایج جراحی بینی است؛ اپی‌نفرین در بینی اثر قلبی‌عروقی زیادی دارد و کمتر به کار می‌رود. تتراکائین تنها، بدون تنگ‌کننده، موفقیت بسیار کمتری دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عصب آلوئولار فوقانی میانی (MSA) و قدامی (ASA) درون کانال اینفرااوربیتال از عصب اینفرااوربیتال جدا می‌شوند و ASA در دیواره‌ی قدامی سینوس ماگزیلاری پایین می‌آید. عصب PSA از این مسیر نمی‌گذرد."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌حسی پالپ، با اسپری در هر دو سوراخ بینی: "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پرمولر دوم تا پرمولر دوم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " سمت مقابل"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "موفقیت کلی حدود ۸۴ تا ۹۰٪، در برابر حدود ۲۷٪ با تتراکائین تنها"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پرمولر اول تا پرمولر اول: حدود ۹۴ تا ۹۸٪؛ پرمولر دوم فقط ۶۳ تا ۷۵٪، چون اپکسش ممکن است دور از دسترس اسپری باشد یا بیمار MSA نداشته باشد و دندان از PSA عصب بگیرد"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولرها بی‌حس نمی‌شوند."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مصرف تأییدشده برای یک کار ترمیمی در بیمار دست‌کم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴۰ کیلوگرم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:53ff30fa72f713174d71a6b9d5b1f80d0d8e4f0b893c4387c430047bd5ead858",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "c9481a35675c15a097da0e06c8e6e45c06d8c5c330549f5d74a084888e85ea22",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "C-CLAD و روندهای آینده"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سیستم کامپیوتری تزریق (C-CLAD)"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بخش بزرگی از درد تزریق از سرعت و فشار آن است. در C-CLAD یک ریزپردازنده و موتور جریان محلول را آهسته و دقیق نگه می‌دارند. در بی‌حسی کام، ۹۶٪ دندانپزشکانی که هر دو روش را روی خود آزمودند C-CLAD را ترجیح دادند و تزریق با آن ۲ تا ۳ برابر کم‌دردتر بود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نسل‌های تازه فشار نوک سوزن را هم می‌سنجند و با صدا و نور بازخورد می‌دهند. همین تزریق آهسته با فشار کنترل‌شده، بلاک‌های AMSA و P-ASA را پدید آورد و راحت کرد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آنچه در راه است"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بلاک‌کننده‌های سایت ۱ کانال سدیم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (نئوساکسی‌توکسین، تترودوتوکسین): کانال را از بیرون می‌بندند، نه از درون مثل لیدوکائین؛ بی‌حسی بسیار طولانی برای درد پس از جراحی، و نئوساکسی‌توکسین سمیت قلبی نشان نداده است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بوپیواکائین لیپوزومی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": دارو آرام از کیسه‌های چربی آزاد می‌شود؛ شروع اثر چند ساعته و اثر تا ۷۲ ساعت. فقط برای اینفیلتراسیون دور برش پس از جراحی است. با بلاک فک پایین، بی‌حسی لب و زبان ممکن است ۲۴ تا ۷۲ ساعت بماند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "منیزیم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " به‌عنوان افزودنی که بی‌حسی را طولانی‌تر می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بی‌حسی خاموش‌شونده با نور"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": مولکولی که با یک طول موج فعال و با طول موج دیگر خاموش می‌شود؛ هنوز در مرحله‌ی پژوهش."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
