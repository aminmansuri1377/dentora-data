          "text": "می‌خواهی برای کلینیک یک فرم «غربالگری سینوس پیش از پیوند» بسازی. کدام مجموعه‌ی فیلد با این یونیت هم‌خوان است؟"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۱"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سن بیمار، گروه خونی، فشار خون روز جراحی، وضعیت بیمه، تعداد دندان‌های از دست رفته، سابقه‌ی جراحی زیبایی"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۲"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رنگ تاج نهایی، نوع اباتمنت، جنس روکش، طرح اکلوژن، ارتفاع فضای تاج، نوع سیستم ایمپلنت، زمان بارگذاری"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۳"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تعداد بخیه‌ها، نوع نخ، مدت جراحی"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۴"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بازی اوستیوم، سپتا، اندازه‌ی ضایعه‌ی سینوسی، انحراف سپتوم، سابقه‌ی سینوزیت و آلرژی، مصرف سیگار"
                }
              ]
            }
          ]
        }
      ]
