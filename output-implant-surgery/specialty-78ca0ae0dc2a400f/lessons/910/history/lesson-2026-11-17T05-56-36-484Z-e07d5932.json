      "sourceQuestionId": null,
      "sourceStepId": null,
      "sourceProgress": "width: 0%;",
      "questionType": "unknown",
      "title": "درس ۲: کاشت فوری — انتخاب مورد و مدیریت گپ",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مشکل بنیادی: ساکت با ایمپلنت جور درنمی‌آید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "صریح بدان: کاشت فوری سخت‌گیرانه‌تر است و ست مهارتی ویژه‌ای از درمانگر می‌طلبد. و مشکل بنیادی‌اش یک واقعیت هندسی است:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از کشیدن دندان، ابعاد ساکت باقی‌مانده —"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چه مزیودیستال و چه باکولینگوال — معمولاً بسیار متفاوت از قطر ایمپلنت است. یعنی ایمپلنت در فضایی قرار می‌گیرد که برای آن ساخته نشده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و پیامد مستقیمش: نبود استخوان کرستال در محل کشیده‌شده، رسیدن به ثبات اولیه را دشوارتر می‌کند. همان ثبات اولیه‌ای که در یونیت ۱۱ دیدی شرط لازم استئواینتگریشن است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انتخاب مورد."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای هر دندان یک نظام "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه‌رنگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تعریف شده: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شرایط ایده‌آل (سبز)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شرایط محتاطانه (زرد)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کنترااندیکاسیون (قرمز)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". و برای هر موقعیت دندانی، پروتکل طرح درمان جداگانه‌ای بحث می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو نشانه‌ی هشدار در انتخاب مورد:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرم تاج مخروطی (تیپرد)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " معمولاً با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطر بالاتر آسیب بافت نرم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس از کشیدن دندان همراه است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استخوان D4"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نرخ شکست بیشتری با کاشت فوری دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و درباره‌ی محل عفونی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پژوهش‌ها نشان داده‌اند تا زمانی که آنتی‌بیوتیک استفاده شود، دبریدمان دقیق انجام شود و آماده‌سازی استخوان آلوئولار پیش از کاشت به‌درستی صورت گیرد، ایمپلنت فوری در محل عفونی کنترااندیکه نیست. توجه کن که این یک اجازه‌ی مشروط است با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه شرط"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — نه یک چراغ سبز."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if91-4ba30c57b49c5c9f.webp",
                  "alt": "ریشه‌ی باقی‌مانده در ناحیه‌ی قدامی، کاندید کشیدن و کاشت فوری",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/230410273492f2dfebed1d508a8fc0e33530d94b9a1c373e9d38b8b67db59c6d.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل کاندید کاشت فوری؛ انتخاب مورد بر پایه‌ی نظام سه‌رنگ انجام می‌شود: شرایط ایده‌آل، شرایط محتاطانه، یا کنترااندیکاسیون. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.32 (Immediate Implant Placement), p.558"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:6541ffc1cd4759e2f44d643b2f4f4835df687963730d25ad13915f18fc8d12b0",
      "position": 2,
      "kind": "theory",
      "sourceQuestionId": null,
      "sourceStepId": null,
      "sourceProgress": "width: 14.2857%;",
      "questionType": "unknown",
      "title": "درس ۲: کاشت فوری — انتخاب مورد و مدیریت گپ",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مدیریت گپ و بستن محل"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گپ پرشی (Jumping Gap)."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضای میان ایمپلنت و دیواره‌ی ساکت — و مدیریتش بخشی از تکنیک است، نه یک جزئیات."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش عملی: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خرده‌های استخوانی از شیار فرزها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جمع‌آوری و برای پیوند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گپ باکال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس از کاشت ایمپلنت نگه داشته می‌شوند. یعنی استخوان اتوژن بیمار، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رایگان و در دسترس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، از همان استئوتومی به دست می‌آید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مواد پیوند برای پر کردن گپ پرشی و هر نقص استخوانی به کار می‌روند، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پلاگر آمالگام"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ابزار عملی قرار دادن ماده در فضاهای کوچک است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حاشیه‌ی خطای جراحی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به‌عنوان یک راهنمای کلی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱٫۵ تا ۲ میلی‌متر خطای جراحی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " میان ایمپلنت و هر لندمارک یا ساختار حیاتی مجاور در نظر گرفته می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بستن محل — یک واقعیت مهم."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در بیشتر محل‌های کاشت فوری، رسیدن به بسته‌شدن اولیه دشوار است مگر آنکه فلپ پیش برده شود. و توجه کن که پیش بردن فلپ خودش هزینه دارد: بافت کراتینیزه‌ی فاسیال پروتز کمتر می‌شود و اغلب پیوند بافت نرم لازم می‌شود. برای همین معمولاً بسته‌شدن اولیه‌ی کامل انجام نمی‌شود و روی ساکت ممبران یا پلاگ کلاژن گذاشته می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروویژنال و شکل‌دهی بافت."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در موارد بارگذاری فوری، ترمیم موقت با طراحی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پونتیک اوویت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌تواند بافت نرم را ترمیم و شکل‌دهی کند. و اگر امکانش باشد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروویژنال ثابت یا پروتز بدون فشار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای ترمیم موفق ایده‌آل است — کلیدواژه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدون فشار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و شواهد پشتیبان: مطالعات نشان داده‌اند استفاده از ایمپلنت فوری تک‌واحدی همراه با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروویژنال فوری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ثبات بافت لثه‌ی فاسیال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کمک می‌کند — با پیگیری‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ تا ۸ ساله"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if92-e24d6938ba83a177.webp",
                  "alt": "رادیوگرافی پری‌اپیکال از محل کشیده‌شده با ابزار داخل ساکت",
