    {
      "id": "theory:aa39c10c940b34b63903a5625a9a4de28f0bd740c6396cdb6ec77d9370ba6319",
      "position": 1,
      "kind": "theory",
      "sourceQuestionId": null,
      "sourceStepId": null,
      "sourceProgress": "width: 0%;",
      "questionType": "unknown",
      "title": "درس ۴: از کشیدن تا کاشت — زنجیره‌ی تصمیم",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کِی محل آماده‌ی کاشت است؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "صادقانه باید گفت: متغیرهای زیادی در تعیین اینکه محل پیوند ساکت چه زمانی برای کاشت ایمپلنت ترمیم شده وجود دارد. آمادگی محل به اندازه‌ی نقص، نوع ماده‌ی پیوند، استفاده از ممبران و خون‌رسانی ناحیه بستگی دارد؛ یعنی یک عدد واحد برای همه وجود ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ولی بازه‌های راهنما مشخص‌اند:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساکت بدون پیوند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیم معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳ تا ۶ ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طول می‌کشد، بسته به اندازه‌ی دندان، تعداد ریشه‌ها و میزان تروما حین کشیدن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل پیوندشده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ تا ۸ ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک استثنای مهم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در تکنیک socket seal، انتقال گرافت کامپوزیت با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لایه‌ی پریوستئال دست‌نخورده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عروقی‌شدن مجدد را تسریع می‌کند و ممکن است زمان ترمیم را کاهش دهد — در نتیجه ورود مجدد ممکن است در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ تا ۵ ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام شود و کاشت ایمپلنت با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قطر ایده‌آل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اغلب ممکن گردد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به عبارت آخر دقت کن: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«قطر ایده‌آل»"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". یعنی کیفیت پیوند نه فقط بر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بلکه بر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گزینه‌های در دسترس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اثر می‌گذارد — پیوند بهتر یعنی ایمپلنت بهتر، نه فقط ایمپلنت زودتر."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if103-3cb179f01f3bff0d.webp",
                  "alt": "سکشن کردن و برداشتن ریشه‌های مولر مندیبل با ابزار جراحی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/f850a1771939a6aea1ae63136c6100af70779049f1fce5c04670594719fa0adb.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سکشن کردن ریشه‌ها پیش از برداشتن؛ مولری که یکپارچه کشیده شود سپتوم بین‌ریشه‌ای را با خود می‌برد — تکنیک کشیدن مستقیماً بر گزینه‌های کاشت آینده اثر می‌گذارد. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.34, p.896"
                    }
                  ]
                }
              ]
            }
          ]
        }
