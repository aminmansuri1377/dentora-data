                  "text": "۰۱"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ایرادی ندارد؛ چند عامل خطر با هم برابر منع مطلق است"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۲"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تجمع عوامل خطر سطح احتیاط و شدت پیگیری را بالا می‌برد، ولی به‌خودی‌خود منع مطلق نمی‌سازد"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۳"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ایرادش این است که باید فقط به شدیدترین عامل خطر توجه کند و بقیه‌ی عوامل را در تصمیم نادیده بگیرد"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "۰۴"
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ایرادش این است که عوامل خطر با هم جمع نمی‌شوند و هرکدام را باید جدا و مستقل از دیگری سنجید و ثبت کرد"
                }
              ]
            }
