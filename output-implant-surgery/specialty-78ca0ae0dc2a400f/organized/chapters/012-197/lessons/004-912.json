  "steps": [
    {
      "id": "theory:8178dd9be9fbb0738731f7a154a7ba36da0e548a01ba13581aa2d0234233c7e4",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "b3ffba4c9d87421e82e5a07be41fc414c8a3115a8fbdd6edb1adb16542f87fbc",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو عدد: تورک درج و ISQ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تصمیم بارگذاری فوری، برخلاف بسیاری از تصمیم‌های جراحی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آستانه‌های عددی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد. دو ابزار و دو بازه:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱. تورک درج."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشان داده شده که برای یک پروتکل بارگذاری فوری موفق، تورک درج باید میان ۳۵ تا ۴۵ نیوتن‌سانتی‌متر باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بازه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بودنش دقت کن: هم کف دارد و هم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سقف"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". تورک بیش از حد بالا یعنی فشردگی بیش‌ازحد استخوان — همان چیزی که در یونیت ۱۱ دیدی به تحلیل کرستال می‌انجامد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲. آنالیز فرکانس رزونانس (RFA)."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ابزاری تشخیصی که پایداری ایمپلنت را به‌عنوان تابعی از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سفتی رابط استخوان-ایمپلنت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌سنجد، بر پایه‌ی تحریک پیوسته‌ی رابط با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنالیز ارتعاش دینامیک (اثر پیزو)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اعداد ISQ:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مقادیر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمتر از ۴۵"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشانه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شکست ایمپلنت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، در حالی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶۰ تا ۷۰"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشانه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "موفقیت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". برای خودِ بارگذاری فوری آستانه‌ی سخت‌گیرانه‌تری پیشنهاد شده است: ISQ حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۷۰ یا بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و ارزش دوم RFA:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این روش اندازه‌گیری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمّی و تکرارپذیر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌دهد — نه فقط برای تصمیم بارگذاری فوری، بلکه برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تأیید اینتگریشن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیگیری و پیش‌بینی شکست ایمپلنت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if95-ae4d26f1c548f363.webp",
                  "alt": "رادیوگرافی از دو ایمپلنت با پروتز ثابت در ماگزیلای قدامی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/3ae08c3d86aa33c50d6950a05bb0d7f7d257f0aaf6f5198f601b2ab0a126de7d.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایمپلنت‌های بارگذاری‌شده؛ برای پروتکل بارگذاری فوری موفق، تورک درج باید میان ۳۵ تا ۴۵ نیوتن‌سانتی‌متر باشد. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.32, p.833"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:430a971596522cc98f51295b0d08d9f1a190e62359781f19304a96dbdc767daa",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "f8358bae317d11d3bb69cf03f840cb574b3ee430e5b6389e0631dc724af3709f",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "افت ISQ و اینکه چه زمانی سنجش معنا دارد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک یافته‌ی زمانی که برداشت اشتباه از ISQ را تصحیح می‌کند:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مقادیر ISQ در سه هفته‌ی اول پس از کاشت کاهش می‌یابد؛ سپس بازگشت به مقادیر اولیه تقریباً در هشت هفته پس از جراحی دیده می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این یعنی منحنی ISQ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "V شکل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: بالا در لحظه‌ی کاشت (پایداری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مکانیکی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ")، افت در هفته‌های اول (بازجذب استخوان اطراف)، و بازگشت تا هفته‌ی هشتم (پایداری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیولوژیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ")."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و پیامدهای عملی‌اش دو تاست. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یکم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یک عدد ISQ پایین در هفته‌ی سوم لزوماً نشانه‌ی شکست نیست — ممکن است کف طبیعی منحنی باشد. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دوم و مهم‌تر:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر بارگذاری فوری انجام داده‌ای، ایمپلنت دقیقاً در همان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پنجره‌ی افت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " زیر بار است. برای همین است که تورک درج بالا در لحظه‌ی کاشت این‌قدر اهمیت دارد — باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ذخیره‌ی کافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای عبور از آن دره وجود داشته باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروویژنال بارگذاری‌شده یا غیرعملکردی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این تمایز را از درس قبل به یاد بیاور: قرار دادن ترمیم موقت لزوماً به معنای بارگذاری آن نیست. پروویژنال "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غیرعملکردی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بافت نرم را شکل می‌دهد بدون اینکه نیروی اکلوزال به ایمپلنت وارد کند — و در موارد مرزی، همین گزینه‌ی میانی راه‌حل است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اصل بستن بدون فشار."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر امکانش باشد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروویژنال ثابت یا پروتز بدون فشار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای ترمیم موفق ایده‌آل است. یعنی حتی وقتی چیزی روی ایمپلنت هست، هدف "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حذف فشار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است نه صرفاً پر کردن فضا."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if96-1d5ff5d37bf011a8.webp",
                  "alt": "تصویر میکروسکوپی از رابط استخوان و سطح ایمپلنت",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/36b856489ebeced4490c43d6684908cddea01701cd215720a2c7eb38cdb3956a.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رابط استخوان-ایمپلنت؛ آنالیز فرکانس رزونانس، پایداری را به‌عنوان تابعی از سفتی همین رابط می‌سنجد — مقادیر ISQ شصت تا هفتاد نشانه‌ی موفقیت است. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.33 (Immediate Load/Restoration), p.864"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
