  "steps": [
    {
      "id": "theory:0f4129e53085612e653a0999dd1a50fdd4982013a8ddba899b6d7977fca5a2b3",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "69cf840e917e34b9b548b78d0d68112171d09cfa049eec1f89d5f3f2d5f253ad",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "استخوانی که ضعیف است و صفحه‌ای که نازک است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ماگزیلای قدامی از دو جهت با مندیبل قدامی فرق دارد و هر دو تفاوت به ضرر توست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یکم، تراکم استخوان."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در بیشتر بیماران استخوان ماگزیلای قدامی از مندیبل قدامی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کم‌تراکم‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: استخوان نازک و متخلخل در سمت لبیال، کورتیکال بسیار نازک در کف بینی، و کورتیکال متراکم‌تر فقط در سمت پالاتال. ترابکولار پره‌ماگزیلا هم ظریف‌تر است. نتیجه‌ی عملی: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاشت دشوارتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و احتمال بیشتر شکست ناشی از اورلود یا تحلیل کرستال."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دوم، تیغه‌ی باکال."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " صفحه‌ی نازک استخوان روی ریشه‌ی دندان‌های قدامی، هنگام کشیدن دندان اغلب "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از دست می‌رود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". و از آنجا که ریج پس از کشیدن به سمت پالاتال تحلیل می‌رود، ماه‌ها بعد با ریجی روبه‌رو می‌شوی که هم باریک‌تر است و هم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "موقعیتش تغییر کرده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس در این ناحیه، دو سؤال جدا بپرس: آیا استخوان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هست؟ و آیا استخوان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در جای درست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هست؟ پاسخ مثبت به اولی، پاسخ مثبت به دومی را تضمین نمی‌کند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if49-e615eb0bb8968e05.webp",
                  "alt": "ناحیه‌ی زیبایی ماگزیلای قدامی — سانترال از دست رفته با بافت نرم مجاور",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/2ee5217b2410c2a6481161bffcd35021a8880fb9641835c84a2c456549d947ef.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ناحیه‌ی زیبایی ماگزیلای قدامی؛ وضعیت بافت نرم و پاپیلاهای مجاور پیش از درمان تعیین‌کننده‌ی نتیجه‌ی نهایی است. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.29 (Maxillary Anterior Implant Placement), p.710"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:7e2070f556ae4fec22a76e74ba2dae18a2d73d9e3db74741e90aed880930794a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "2cd96d31bfa8fe9a99faf4c912b28adf58b1007fcbd85227831071f4568767f6",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اعدادی که سرنوشت پاپیلا را تعیین می‌کنند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در ناحیه‌ی زیبایی، موفقیت با اعداد سنجیده می‌شود و سه عدد از همه مهم‌ترند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قانون پاپیلا."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وقتی فاصله‌ی نقطه‌ی تماس بین‌دندانی تا استخوان بین‌سپتال "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵ میلی‌متر یا کمتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد، پاپیلا تقریباً همیشه فضای بین‌دندانی را پر می‌کند. هرچه این فاصله بیشتر شود، احتمال پر شدن به‌سرعت افت می‌کند — در فاصله‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۷ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، شانس بازگشت پاپیلا پس از رفلکشن جراحی ممکن است "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمتر از ۲۵ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فاصله تا ریشه‌ی مجاور."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حداقل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱٫۵ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضا میان ایمپلنت و ریشه‌ی دندان مجاور لازم است. و پیامدش فراتر از خود ایمپلنت می‌رود: اگر ایمپلنتی نزدیک‌تر از این حد کاشته شود و تحلیل استخوان رخ دهد، استخوان و درپ بافت نرم روی دندان مجاور هم از دست می‌رود — یعنی یک خطای جراحی، دو دندان را درگیر می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عمق اپیکوکرونال."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بدنه‌ی ایمپلنت باید حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ تا ۳ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " زیر حاشیه‌ی آزاد لثه‌ی سانترال و کانین قرار بگیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و ساختار پنهان این ناحیه: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانال نازوپالاتین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". تقریباً در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " موارد، این کانال مستقیماً با موقعیت ایده‌آل ایمپلنت در پره‌ماگزیلا تداخل می‌کند. پس از کشیدن دندان، کانال گشادتر می‌شود و فورامن نازوپالاتین می‌تواند به‌طور میانگین حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۶ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عرض ریج را اشغال کند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if50-c6b691e9444887e9.webp",
                  "alt": "اکسپوز جراحی کانال نازوپالاتین در پره‌ماگزیلا",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/b4f3996c3eaff3fe2b54a6a9b66eab881ce10baf0be0adf92392da35bced8776.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکسپوز کانال نازوپالاتین حین جراحی (فلش‌ها)؛ وقتی کانال بزرگ باشد، مستقیماً موقعیت ایده‌آل ایمپلنت سانترال را محدود می‌کند. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.29, p.715"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
