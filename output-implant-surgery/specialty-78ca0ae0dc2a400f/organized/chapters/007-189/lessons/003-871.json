  "steps": [
    {
      "id": "theory:39dfebe1f1001de961d420493e8f67b37bcfa70cb2fd869644a3840f770c28ac",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "af81f41bd204e03e7f861c00a46631c9a079b4c16726a4b1609f49a5b7ebc604",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آنچه در تصویر می‌بینی و آنچه باید بشناسی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از هر پیوند سینوس، تصویر مقطعی را نه فقط برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اندازه‌گیری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، بلکه برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارزیابی سلامت سینوس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بخوان. چند یافته‌ی رایج و معنایشان:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سطح مایع–هوا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — خط رادیواپک صاف داخل سینوس که با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رینوسینوزیت حاد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم‌خوان است. این یعنی سینوس همین حالا درگیر است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "التهاب پلیپوئید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — الگویی که با رینوسینوزیت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آلرژیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم‌خوان است و اغلب دوطرفه دیده می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سودوکیست و کیست احتباسی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — ضایعاتی که در کف سینوس دیده می‌شوند. نکته‌ی عملی این است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عود سودوکیست شایع است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ پس اگر تصمیم به ادامه گرفتی، این ناحیه در پیگیری‌های پس از پیوند نیازمند بازبینی دقیق است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "موکوسل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — ضایعه‌ای که ماهیت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گسترش‌یابنده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد؛ نوع ثانویه می‌تواند سینوس را به دو محفظه تقسیم کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک هشدار مهم: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سینوزیت ادنتوژنیک یک‌طرفه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در CBCT اغلب از قلم می‌افتد، چون بسیاری از این بیماران "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدون علامت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هستند. نبود شکایت بیمار، جای بررسی تصویر را نمی‌گیرد."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if53-9d4b1b5d03181c8f.webp",
                  "alt": "مقطع کرونال CBCT از سینوس‌های پارانازال با تفاوت آشکار شفافیت دو سمت",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/afc083ca08159047de26dfb643edc4339e3c7c5809842fadb73ee3ef4669a53e.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مقطع کرونال CBCT از سینوس‌های پارانازال؛ تفاوت شفافیت دو سمت، نشانه‌ی درگیری یک‌طرفه است — یافته‌ای که در بیمار بدون علامت هم باید جدی گرفته شود. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.37, p.1003"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:35c1010035949924474d57524b9cb8a191ed595a9cea442b52c855e3de0a0747",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "15d78a0f837e7b02fa1edb2b17fbca4741cbf66b8436afe81d38db78b7715474",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کِی نباید پیوند کرد و چه چیزی را باید اول درمان کرد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کنترااندیکاسیون‌های پیوند سینوس به دو دسته تقسیم می‌شوند: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مطلق"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نسبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". و تفاوتشان یک تفاوت عملی است، نه لفظی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کنترااندیکاسیون نسبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی وضعیتی که با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درمان یا ارجاع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قابل رفع است — پیوند به تعویق می‌افتد، حذف نمی‌شود. سینوزیت فعال، پاتولوژی درمان‌نشده، یا اوستیوم مسدود در همین دسته‌اند: اول درمان، بعد جراحی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کنترااندیکاسیون مطلق"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی برنامه باید عوض شود، نه به تعویق بیفتد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و یک نکته‌ی طرح درمانی که به آناتومی برمی‌گردد: اگر موقعیت ایمپلنت‌های موردنظر طوری باشد که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سینوس در سمت جانبی آن‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قرار بگیرد، پیوند سینوس اصلاً کمکی نمی‌کند — چون فضایی که پیوند می‌سازد، فضایی نیست که ایمپلنت در آن قرار می‌گیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این وضعیت مثلاً وقتی پیش می‌آید که حفره‌ی بینی روی ریج بی‌دندان خلفی گسترش یافته و سینوس در کنار آن مانده است؛ در این حالت معمولاً پیوند آنله برای افزایش ارتفاع لازم است. یعنی پیش از تصمیم به پیوند، باید بدانی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایمپلنت دقیقاً کجا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خواهد رفت."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و دو عارضه‌ی شناخته‌شده را از همین حالا بشناس. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رینوسینوزیت حاد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس از پیوند دو علت دارد: پاتولوژی از پیش موجود سینوس، و جراحی‌ای که به خود سینوس کشیده شود — مثلاً گرافت اضافی که اوستیوم را ببندد. و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پارگی ممبران"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شایع‌ترین عارضه‌ی حین پیوند است (حدود ۱۰ تا ۳۴ درصد)؛ وقتی کف سینوس از راه استئوتومی بالا برده می‌شود، اگر ممبران هنگام کاشت پاره شود، رشد ارتفاع استخوان کمتر محتمل است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قاعده‌ی این درس: پیوند سینوس یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تصمیم دو مرحله‌ای"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است — اول «آیا این سینوس سالم است؟» و بعد «آیا پیوند مشکل این بیمار را حل می‌کند؟». هر دو باید بله باشند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if54-0a5c7a59114e0c85.webp",
                  "alt": "ضایعه‌ی کف سینوس ماگزیلاری در مقطع CBCT با مشخص‌سازی رنگی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/fd4342faaccfe26e468ab593d512b7612de1372a677b77f38cf147b7b7fbbc08.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ضایعه‌ی کف سینوس در مقطع CBCT (ناحیه‌ی مشخص‌شده)؛ ماهیت و اندازه‌ی ضایعه تعیین می‌کند که پیوند به تعویق بیفتد یا برنامه تغییر کند. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.37, p.996"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
