  "steps": [
    {
      "id": "theory:672c23b55d88fc8fa545701fe3bc879ffee6751fc04ffbf68d5f591a9328cf27",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "5f8975cdbf51321f01fccd67af06daa5b4c523fc3feb87480128c7022fd9692a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ممبران، اوستیوم، و سیستمی که باید کار کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سینوس ماگزیلاری یک حفره‌ی خالی نیست؛ یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیستم فعال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و کار کردن آن به دو چیز بستگی دارد: ممبران سالم و مسیر تخلیه‌ی باز."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ممبران شنایدرین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از اپیتلیوم استوانه‌ای مطبق کاذب مژک‌دار ساخته شده. هر سلول "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵۰ تا ۲۰۰ مژک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد و این مژک‌ها به سمت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اوستیوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ضربان می‌زنند تا روزانه حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک لیتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " موکوس تولیدشده را از سینوس بیرون برانند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و نکته‌ی تعیین‌کننده برای تو: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اوستیوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در بخش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فوقانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیواره‌ی داخلی قرار دارد — یعنی بالاتر از کف سینوس. تخلیه در این سیستم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خلاف جهت جاذبه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و کاملاً به کار مژک‌ها وابسته. رابطه‌ی مستقیمی هم میان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اندازه‌ی اوستیوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و فشار اکسیژن داخل سینوس وجود دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیامد جراحی‌اش را همین‌جا نگه دار: هر چیزی که اوستیوم را ببندد — تورم، پلیپ، یا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مواد گرافت اضافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — تخلیه را متوقف می‌کند و راه را برای عفونت باز می‌کند. در ادامه‌ی همین یونیت خواهی دید که پر کردن بیش‌ازحد سینوس یکی از علل شناخته‌شده‌ی رینوسینوزیت حاد پس از پیوند است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if51-35b522dfc7c0d698.webp",
                  "alt": "مقطع CBCT کرونال از رابطه‌ی ایمپلنت برنامه‌ریزی‌شده با کف سینوس",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/095915e2edbc39cca3d26d57ef041648416ed302f28dfa3979f359f48eb72ac5.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مقطع CBCT از رابطه‌ی ایمپلنت برنامه‌ریزی‌شده با کف سینوس و ممبران؛ ارتفاع باقی‌مانده و ضخامت ممبران هر دو باید پیش از جراحی سنجیده شوند. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.37 (Maxillary Sinus Anatomy, Pathology, and Graft Surgery), p.996"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:1f9beba42a92563ccc4744e78cbbfa7ac40a3ec8ce2d548af143414bfb2af104",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "1ca6f0dc2926d3e7d6d4e1f9ddfa3fb60d1cec73dd574ac4d37678885488f967",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سپتوم و شریانی که در دیواره پنهان است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو ساختار، بیشترین دردسر جراحی سینوس را می‌سازند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سپتوم آنترال."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شایع‌ترین واریاسیون استخوانی سینوس است. حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۰ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ماگزیلاهای دنددار سپتوم دارند و سه‌چهارم آن‌ها در ناحیه‌ی پرمولر ظاهر می‌شوند. بررسی‌های CBCT توزیع را چنین گزارش کرده‌اند: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴۱ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ناحیه‌ی میانی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳۵ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خلفی و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲۴ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قدامی. سپتوم کامل که سینوس را به دو محفظه تقسیم کند نادر است — تنها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱ تا ۲٫۵ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا مهم است؟ چون سپتوم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جراحی پنجره‌ی جانبی را پیچیده می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "احتمال پارگی ممبران را بالا می‌برد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". یعنی سپتوم فقط یک یافته‌ی تصویری نیست؛ یک هشدار درباره‌ی طراحی پنجره است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شریان‌ها."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شاخه‌های شریان ماگزیلاری — به‌ویژه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شریان آلوئولار فوقانی خلفی (PSA)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شریان اینفرااوربیتال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — آناستوموزهای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داخل‌استخوانی و خارج‌استخوانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در اطراف سینوس می‌سازند. همین آناستوموزها هستند که هنگام برداشتن پنجره‌ی دیواره‌ی جانبی، خون‌ریزی حین عمل ایجاد می‌کنند. در دیواره‌ی داخلی هم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شریان نازال خلفی جانبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حضور دارد؛ رفلکشن تهاجمی ممبران می‌تواند به این عروق آسیب بزند یا به حفره‌ی بینی نفوذ کند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if52-0461e47efa0fa9cd.webp",
                  "alt": "سپتوم بزرگ که پنجره‌ی دیواره‌ی جانبی سینوس را به دو بخش تقسیم کرده است",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/313a296bd667ce32fa6342afd81aeec50736c95b29f47e80db8328a4a33950c4.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سپتوم بزرگ در مرکز سینوس؛ پنجره ناچار به دو بخش قدامی و خلفی تقسیم شده است — همان چیزی که احتمال پارگی ممبران را بالا می‌برد. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.37, Fig.37.51, p.1032"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
