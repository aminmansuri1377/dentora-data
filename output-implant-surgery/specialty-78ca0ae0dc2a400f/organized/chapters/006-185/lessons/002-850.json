        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در ناحیه‌ی خلفی مندیبل، ارتفاع قابل استفاده به‌دلیل حضور "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانال مندیبل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاهش می‌یابد؛ کانالی که تقریباً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۲ میلی‌متر بالای لبه‌ی تحتانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مندیبل قرار می‌گیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "عدد کلیدی این درس: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حاشیه‌ی ایمنی ۲ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای پیشگیری از نقص حسی. و قاعده: وقتی ایمپلنت ممکن است در فاصله‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ میلی‌متری عصب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " قرار بگیرد، موقعیت دقیق عصب و کانال باید با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تصویربرداری سه‌بعدی"
                    }
