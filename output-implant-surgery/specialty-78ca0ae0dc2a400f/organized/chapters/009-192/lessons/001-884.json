  "steps": [
    {
      "id": "theory:cdeba606c2df49090fb2de9784386012f056afc39681055f68487a88b593a91c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "3466807dc97ee745769fdabb5c3d89e20e37231c11cdf78547b6b427e98ff295",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آسپسیس — قواعدی که استثنا ندارند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آسپسیس جراحی یک مجموعه‌ی مرحله‌ای است، نه یک تصمیم لحظه‌ای. ترتیبش هم اهمیت دارد:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلاه جراحی، عینک محافظ، هدلایت و ماسک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اسکراب دست‌ها پوشیده شوند — چون پس از اسکراب دیگر نمی‌توانی به سر و صورتت دست بزنی. تمام "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انگشتر، ساعت، دستبند و جواهرات"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از شروع اسکراب برداشته می‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و مدت: کل فرایند اسکراب حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طول می‌کشد. اتاق باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل سینک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای اسکراب و پوشیدن گان داشته باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قواعد میدان استریل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — چند قاعده که در عمل زیاد نقض می‌شوند:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فقط مواد و ابزار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استریل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درون میدان استریل قرار می‌گیرند. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بالای میز و زیر میز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " میدان استریل، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غیراستریل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " محسوب می‌شود. موادی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تاریخ انقضای"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سازنده دارند، پس از آن تاریخ ناایمن تلقی می‌شوند. و هنگام قرار دادن اقلام استریل در میدان، می‌توان آن‌ها را از ارتفاع حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۵ سانتی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بالای میدان رها کرد."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if65-57491518a2ae2fee.webp",
                  "alt": "اتاق جراحی آماده‌شده با پوشش استریل روی یونیت و تجهیزات",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/464d54de10062996b76a25c9d40c892467e0d6dfa990e4322ceaf9dd97739d30.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اتاق جراحی آماده‌شده؛ پوشش سطوح و آماده‌سازی محیط، پیش‌نیاز حفظ میدان استریل در طول عمل است. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.26 (Basic Surgical Techniques and Armamentarium), p.623"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:15ff176dc5cbf9859a22fecee7848602fc94930bd0c0156d6b73261d4095a6fd",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "1971565264101444ad3dab492ee478e6ae983e6165b4903830c1da92d0f387a0",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هندپیس، تیغ و محلول شست‌وشو"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هندپیس."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دو خانواده با دو کاربرد کاملاً متفاوت:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱:۱"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — هندپیس‌های مستقیم با دور بالا (حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴۰ تا ۵۰ هزار دور در دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ")، برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیوند استخوان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۶:۱ یا ۲۰:۱"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — هندپیس‌های کنترا‌انگل کاهنده، برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آماده‌سازی استئوتومی و کاشت ایمپلنت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". نکته این است که آماده‌سازی استئوتومی به دور "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پایین و کنترل‌شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیاز دارد، نه سرعت بالا."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تیغ‌ها."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هرکدام جای خودش را دارد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "#۱۱"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای برش آبسه و عفونت، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "#۱۲ و #۱۲b"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای اطراف دندان‌ها و اتصال برش‌ها در نواحی کم‌دسترس، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "#۱۵"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رایج‌ترین تیغ در ایمپلنتولوژی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "#۱۵c"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با گردن باریک‌تر، برای دسترسی راحت‌تر اطراف دندان‌ها."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محلول شست‌وشو."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلرید سدیم ۰٫۹ درصد یا سالین استریل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد. و کاربرد دومی هم دارد: اگر حاشیه‌های بافت در طول جراحی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خشک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شوند، شست‌وشوی دوره‌ای با سالین استریل یا گاز مرطوب لازم است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و هشداری درباره‌ی جراحی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فلپ‌لس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": نشان داده شده که این روش می‌تواند به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گرم شدن بیش‌ازحد استخوان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بینجامد، چون بدون بلند کردن فلپ، شست‌وشوی کافی استئوتومی اغلب دشوار است."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if66-6fc93ae718933cb1.webp",
                  "alt": "پک استریل باز شده شامل دستکش و درپ روی میز جراحی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/87604b21a95cceda8637bb61bebc29c1282d543ea044cf0746b887af28934086.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پک استریل چیده‌شده روی میز جراحی؛ فقط مواد و ابزار استریل درون میدان قرار می‌گیرند و بالای میز و زیر آن غیراستریل محسوب می‌شود. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.26, p.626"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
