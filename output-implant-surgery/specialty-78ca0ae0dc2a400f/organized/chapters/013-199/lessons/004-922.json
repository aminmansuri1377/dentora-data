    "id": "199",
    "title": "بخش ۵: بازسازی استخوان و بافت نرم، کشیدن آتروماتیک و پرزرویشن ساکت",
    "position": 13
  },
  "position": 4,
  "importReady": true,
  "countsComparedWithConfiguredExpectation": false,
