  "steps": [
    {
      "id": "theory:aa39c10c940b34b63903a5625a9a4de28f0bd740c6396cdb6ec77d9370ba6319",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "a3e8211dad52e0ed7da9a6654a5eee549ca58259a8661a7dc1f38d1df1454fb2",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کِی محل آماده‌ی کاشت است؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "صادقانه باید گفت: متغیرهای زیادی در تعیین اینکه محل پیوند ساکت چه زمانی برای کاشت ایمپلنت ترمیم شده وجود دارد. آمادگی محل به اندازه‌ی نقص، نوع ماده‌ی پیوند، استفاده از ممبران و خون‌رسانی ناحیه بستگی دارد؛ یعنی یک عدد واحد برای همه وجود ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ولی بازه‌های راهنما مشخص‌اند:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساکت بدون پیوند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیم معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳ تا ۶ ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طول می‌کشد، بسته به اندازه‌ی دندان، تعداد ریشه‌ها و میزان تروما حین کشیدن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل پیوندشده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " معمولاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ تا ۸ ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک استثنای مهم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در تکنیک socket seal، انتقال گرافت کامپوزیت با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لایه‌ی پریوستئال دست‌نخورده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عروقی‌شدن مجدد را تسریع می‌کند و ممکن است زمان ترمیم را کاهش دهد — در نتیجه ورود مجدد ممکن است در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴ تا ۵ ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام شود و کاشت ایمپلنت با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قطر ایده‌آل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اغلب ممکن گردد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به عبارت آخر دقت کن: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "«قطر ایده‌آل»"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". یعنی کیفیت پیوند نه فقط بر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بلکه بر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گزینه‌های در دسترس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اثر می‌گذارد — پیوند بهتر یعنی ایمپلنت بهتر، نه فقط ایمپلنت زودتر."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if103-3cb179f01f3bff0d.webp",
                  "alt": "سکشن کردن و برداشتن ریشه‌های مولر مندیبل با ابزار جراحی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/f850a1771939a6aea1ae63136c6100af70779049f1fce5c04670594719fa0adb.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سکشن کردن ریشه‌ها پیش از برداشتن؛ مولری که یکپارچه کشیده شود سپتوم بین‌ریشه‌ای را با خود می‌برد — تکنیک کشیدن مستقیماً بر گزینه‌های کاشت آینده اثر می‌گذارد. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.34, p.896"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:f58a0c0cf8883b4b4b0591e46564aaeb1c89848d29613d579f10d83587ac4199",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5cd2632c5b47a4b2fe146f1f2705964de8fd9f916bf66e009f6d5a66034dca57",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "زنجیره‌ای که از لحظه‌ی کشیدن شروع می‌شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حالا کل این یونیت را به‌صورت یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زنجیره‌ی تصمیم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ببین — و توجه کن که هر حلقه، گزینه‌های حلقه‌ی بعد را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محدود یا باز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌کند:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تکنیک کشیدن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ← اگر پریوتوم به‌درستی به‌عنوان گوه به کار رود و ریشه‌ها سکشن شوند، تیغه‌ی باکال و سپتوم بین‌ریشه‌ای حفظ می‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیواره‌های سالم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ← نقص باقی‌مانده از نوع "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اینفرابونی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است نه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دهیسنس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — و از یونیت ۱۳ می‌دانی که ترمیم نقص دیواره‌دار به‌مراتب بهتر است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقص دیواره‌دار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ← ماده‌ی پیوند "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سر جایش می‌ماند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و می‌تواند فضا را حفظ کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای حفظ‌شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ← ابعاد ریج نگه داشته می‌شود ← "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قطر ایده‌آل ایمپلنت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در دسترس می‌ماند و نیازی به بازسازی گسترده‌تر نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و در جهت معکوس، همین زنجیره هزینه‌ها را هم نشان می‌دهد: کشیدن پرتروما ← از دست رفتن تیغه ← نقص دهیسنس ← ترمیم آسیب‌دیده ← فروریختن ابعاد ← نیاز به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیوند گسترده‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا پذیرش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قطر کمتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا حتی موقعیت نامناسب."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جمع‌بندی این یونیت در یک جمله:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در جراحی ایمپلنت، لحظه‌ی کشیدن دندان بخشی از درمان ایمپلنت است، نه رخدادی پیش از آن. و کسی که این را نداند، هر بار درمان را از نقطه‌ی سخت‌تری شروع می‌کند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if104-38c1197ede5ec02e.webp",
                  "alt": "نمای بالینی از ریج و دندان‌های مجاور پیش از درمان",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/dafb515a89f80646321ec8eb8c4b085189fab6e3bf3053e3af83216202e23b16.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارزیابی ریج پیش از درمان؛ کیفیت پیوند نه فقط بر زمان کاشت بلکه بر گزینه‌های در دسترس اثر می‌گذارد — پیوند بهتر یعنی امکان کاشت با قطر ایده‌آل. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.34, p.896"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
