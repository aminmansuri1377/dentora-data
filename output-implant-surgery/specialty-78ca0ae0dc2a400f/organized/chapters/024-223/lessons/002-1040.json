                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رابطه‌ی مشخصی میان آن‌ها گزارش نشده است"
                    }
                  ]
                }
