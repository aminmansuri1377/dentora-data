  "title": "درس دوم: از موکوزیت تا پری‌ایمپلنتیت — ۴۴ در برابر ۱۸",
  "specialtyKey": "78ca0ae0dc2a400f",
  "chapter": {
    "id": "223",
    "title": "بخش ۷: سلامت پری‌ایمپلنت و نگهداری، بیماری‌های پری‌ایمپلنت — تعریف، تشخیص، پاتوژنز",
    "position": 24
  },
  "position": 2,
  "importReady": true,
  "countsComparedWithConfiguredExpectation": false,
  "sourceSessionFinished": true,
