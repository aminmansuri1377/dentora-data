  "steps": [
    {
      "id": "theory:09d32e4b6e65f50b3a90d71198c6581832674da49a786764ee5df1444581ce62",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "c0afbbf3e744ebd76725940e3192e606cc1d985cb7100144354add515918a5a9",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "راه‌حل، پیش از جراحی است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر یک جمله از این یونیت به خاطرت بماند، این باشد: مطمئن‌ترین راه کم کردن خطاهای موقعیت‌دهی حین جراحی، توسعه‌ی یک راهبرد جامع در مرحله‌ی ارزیابی پیش از عمل است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به منطق این جمله دقت کن. راه‌حل خطای موقعیت، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دقت بیشتر حین جراحی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیست — چون در اتاق جراحی، اطلاعات کافی برای تصمیم درست در دسترس نیست. راه‌حل، انتقال تصمیم به مرحله‌ای است که داده در آنجا هست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقطه‌ی شروع: نوع پروتز نهایی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انتخاب میان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ثابت (FP-1، FP-2، FP-3)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متحرک (RP-4، RP-5)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، موقعیت ایده‌آل ایمپلنت‌ها را دیکته می‌کند. یعنی سه محوری که در سه درس قبل خواندی، مختصاتشان از طرح پروتزی می‌آید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ابزار انتقال برنامه به دهان: تمپلیت."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تمپلیت محدودکننده‌ی کامل، هر خطای استئوتومی را در صفحه‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مزیودیستال و باکولینگوال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مهار می‌کند. عمق را فقط وقتی مهار می‌کند که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استاپ مته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در آن گنجانده شده باشد؛ پس عمق را همیشه جداگانه برنامه‌ریزی و کنترل کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و ارزیابی پیش از عمل باید ابعاد، تراکم و زاویه را با توجه به پروتز برنامه‌ریزی‌شده مشخص کند. توجه کن که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراکم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم در همین فهرست است — یعنی برنامه‌ریزی موقعیت و برنامه‌ریزی پروتکل حفاری بر پایه‌ی تراکم در یک مرحله انجام می‌شوند."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if87-e86e76df510c156e.webp",
                  "alt": "برنامه‌ریزی دیجیتال تمام‌قوس مندیبل با محورهای موازی ایمپلنت‌ها",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/74a0360b434a47ace20a9f08c60d5556fd82fe7fbf04b35463f778ad8d9afd25.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برنامه‌ریزی دیجیتال تمام‌قوس با تعیین محور هر ایمپلنت؛ نوع پروتز نهایی است که موقعیت ایده‌آل هر سه محور را دیکته می‌کند. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.28, p.692"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:dfa06c590a122af6e0046e29f62e95b291a830c6a6cda2d34b2cece29bff3eef",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "0c7d5f6db6d1cab9123b031796af477b77b0449a28dee2b1353067a986e29978",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تصمیم‌های پروتزی که جراحی را شکل می‌دهند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چند تصمیم پروتزی وجود دارد که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جراحی گرفته می‌شوند و مستقیماً برنامه‌ی جراحی را عوض می‌کنند:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱. پیچی یا سمانی."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پس از ارزیابی ستاپ مفصل‌بندی‌شده، فرم قوس، استخوان موجود و عوامل نیرویی، باید تعیین شود که پروتز "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "FP-3"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیچ‌شونده خواهد بود یا سمان‌شونده. و این تصمیم بر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زاویه‌ی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کاشت اثر می‌گذارد — چون در پروتز پیچی، محل خروج پیچ باید قابل قبول باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲. فضای لازم."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پروتز سمان‌شونده به‌طور ایده‌آل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۸ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضا می‌خواهد. اگر این فضا (پس از اصلاح اکلوژن مقابل در صورت لزوم) فراهم نشود، پروتز پیچ‌شونده یا تغییر طرح به بریج اندیکاسیون دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳. استئوپلاستی برنامه‌ریزی‌شده."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وقتی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارتفاع و عرض فراوان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وجود دارد، به‌ویژه در FP-3 و اوردنچر، استئوپلاستی برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افزایش فضای ارتفاع تاجی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از کاشت اغلب اندیکاسیون دارد. یعنی گاهی عمداً استخوان را کم می‌کنی تا فضای پروتزی بسازی — و این یک تصمیم "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برنامه‌ریزی‌شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه یک واکنش حین عمل."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرمول موقعیت استئوتومی‌ها."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فرمولی برای موقعیت ایده‌آل استئوتومی‌های اولیه با پیش‌بینی ایمپلنت‌های نهایی وجود دارد — مثلاً مرکز استئوتومی اولیه = نصف قطر ایمپلنت + ۲ میلی‌متر از دندان؛ برای ایمپلنت با قطر ۴ میلی‌متر، ۴ میلی‌متر از دندان. یعنی حتی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محل شروع مته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم از پیش قابل محاسبه است، نه چیزی که سر عمل تخمین بزنی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جمع‌بندی یونیت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سه محور موقعیت، سه بُعد یک تصمیم واحدند — و آن تصمیم، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از برداشتن تیغ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گرفته می‌شود. خطای موقعیت بیشتر وقت‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطای برنامه‌ریزی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است که در اتاق جراحی فقط "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اجرا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شده."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/if88-3f1a46de6adec008.webp",
                  "alt": "محل جراحی باز شده در مندیبل با ابزار آماده‌سازی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/5309d141024d3a1375cb490bc7ef09c5f621c22eed8b8265389b86fbe35b6d91.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اجرای برنامه در اتاق جراحی؛ آنچه اینجا انجام می‌شود اجرای تصمیمی است که پیش از جراحی گرفته شده — خطای موقعیت بیشتر وقت‌ها خطای برنامه‌ریزی است. رفرنس تصویر: Misch's Contemporary Implant Dentistry, 4th ed, Ch.28, p.699"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
