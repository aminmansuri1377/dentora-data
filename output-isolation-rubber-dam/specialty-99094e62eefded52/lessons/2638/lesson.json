                        {
                          "tag": "text",
                          "text": "کلمپ 0"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کلمپ پرمولر دیگری که همراه کلمپ 2 در ست درمان ریشه است."
