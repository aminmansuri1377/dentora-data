              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پیش از برداشتن ورق، امبرژرها را از تکه‌های کامپاند یا PVS پاک کن."
                }
              ]
            }
