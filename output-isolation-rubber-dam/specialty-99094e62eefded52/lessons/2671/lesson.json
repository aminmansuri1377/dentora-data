                      "children": [
                        {
                          "tag": "text",
                          "text": "۲۰ ثانیه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " با پوار خنکش کن، انگشت را بردار و پایداری کلمپ را بیازما."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برداشتن"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپ را با فورسپس بگیر و فک‌ها را "
