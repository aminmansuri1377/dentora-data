    {
      "id": "theory:a0ec9c20897cf730200c4efa15181d55b9adefbf3c87b2b618afc9efbda740d5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f064bcfea37e2864233eef7e2a5537e64d6c70cb1763951e0a2e293caaadd95f",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "درز با کلمپ پایدار: لیکوئید دم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "درمان ریشه‌ی پرمولر دوم پایینی که دیواره‌ی دیستالش با پوسیدگی تا نزدیک لثه رفته، با کلمپی پایدار شروع شده است. پس از شست‌وشوی کانال، بیمار از مزه‌ی بد مایع در دهانش می‌گوید و کنار دیستال گردن دندان، درز باریکی میان ورق و دندان دیده می‌شود. کلمپ را عوض می‌کنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-1-5-4-s1.webp",
                  "alt": "چپ: درز میان کلمپ، ورق و دندان. راست: لیکوئید دم روی دندان، ورق و کلمپ درز را بسته است.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/de6969d08e5eb224a9ed9e073bf6867043fab3833fff3a06a5e0a876ccc61691.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چپ: درز میان کلمپ، ورق و دندان. راست: لیکوئید دم روی دندان، ورق و کلمپ درز را بسته است. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Cardinali & Gorni. The Use of the Rubber Dam in Endodontics (StyleItaliano) — Fig. 4–5 (Ch.10))"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حتی وقتی کلمپ و ورق درست نشسته‌اند و ورق از تماس‌ها رد شده، گاهی ورق دور گردن دندان کامل نمی‌چسبد. نشت در دو جهت است: بزاق و خون به میدان، و مایع شست‌وشو یا ترشح کانال به دهان بیمار. این بیشتر در دندان پایه‌ی پروتز و دندانی که با پوسیدگی یا شکستگی تخریب شده پیش می‌آید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اگر کلمپ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پایدار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، درز دلیل عوض کردن کلمپ نیست؛ درز را سیل کن. دندان دشوار که ایزوله شد، کار بعدی ساده می‌شود."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سیل با لیکوئید دم"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لیکوئید دم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یک رزین فلو نوری است که درز را سریع می‌بندد. آن را روی درز بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماده را فقط به درز محدود نکن: روی بخشی از دندان، ورق کنار درز و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کلمپ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هم بکش. فقط این‌طور سیل تا پایان درمان می‌ماند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با لایت کیور کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر لیکوئید دم نداری، کامپوزیت فلو را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بدون اچ و باندینگ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بگذار. چون به دندان باند نشده، در پایان کار راحت برداشته می‌شود."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
