  "steps": [
    {
      "id": "theory:1387a3c47e267384bebe51d1560ce77fba55a00554f3fead05dc9cf49b6fd43c",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "6ae4fb5ed80ccc4762518980848dbbce3b7d76872de6964713b0831fad4150e9",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "لبه‌ی ورق مثل دریچه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "برای ترمیم کلاس I مولر اول پایین، ورق سالم است و از همه‌ی تماس‌ها رد شده. ولی هر بار که بیمار آب دهانش را قورت می‌دهد، کمی بزاق از دور گردن مولر به میدان می‌آید و همان‌جا می‌ماند. لبه‌ی ورق دور گردن دندان رو به اکلوزال ایستاده است. چه کاری مانده؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-1-5-3-s1.webp",
                  "alt": "اینورت بین‌دندانی با نخ؛ نخ رو به فاسیال بیرون کشیده می‌شود تا لبه‌ی ورق برنگردد.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/ad2f7719e12f048fde3168f99c0d226d209c38eb2946df71d1130d7fbc42cf9b.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اینورت بین‌دندانی با نخ؛ نخ رو به فاسیال بیرون کشیده می‌شود تا لبه‌ی ورق برنگردد. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Summitt's Fundamentals of Operative Dentistry — Fig. 8-39)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لبه‌ی ورق که دور گردن دندان است مثل یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دریچه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کار می‌کند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لبه‌ی اینورت‌نشده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (رو به اکلوزال): وقتی زبان و گونه زیر ورق فشار مثبت می‌سازند، مثلاً با حرکت زبان یا قورت دادن، دریچه باز می‌شود و بزاق از میان دندان و ورق به میدان می‌آید. وقتی فشار زیر ورق منفی می‌شود، دریچه بسته می‌شود و بزاق در میدان گیر می‌افتد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لبه‌ی اینورت‌شده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (برگشته به درون سولکوس): فشار مثبت زیر ورق فقط لبه را محکم‌تر به دندان می‌فشارد و میدان خشک می‌ماند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اینورت کردن یعنی برگرداندن لبه‌ی ورق به درون سولکوس، دور گردن دندان. این کار سیل را کامل می‌کند. دست‌کم دور دندان یا دندان‌هایی که روی آن‌ها کار می‌کنی اینورت کن."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترتیب کار"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اول ناحیه‌ی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بین‌دندانی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": ورق اغلب هنگام رد شدن سپتوم‌ها خودش اینورت می‌شود، چون رو به لثه کشیده شده است. این را با نخ دندان یا نخ نواری وارسی و کامل کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بعد "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فاسیال و لینگوال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": با یک ابزار و جریان هوا."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:4dc05c507c1cb8c8529a8f10c2e5ccf1cef7cb5c88129bdd8c52076879133335",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "7887054b442d0cc968191844d94b91c9ce4d844e5712d96068e42a737addfec1",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اینورت با ابزار، با نخ و لیگاتور"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ابزار اینورت فاسیال و لینگوال: سوند، پلاستیک اینسترومنت یا برنیشر beavertail."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-1-5-3-s2.webp",
                  "alt": "اینورت فاسیال با سوند و جریان هوا.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/93832b3bcee14782aaff8dbd2e0aa90d15e94a985994701ff35f987fa0557ca6.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اینورت فاسیال با سوند و جریان هوا. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Sturdevant's Art and Science of Operative Dentistry, 8th ed. — Procedure 3.1)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر لوبریکانت را هنوز نشسته‌ای، ورق و دندان را بشوی و بعد "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "خشک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کن. روی سطح خشک، لبه‌ی ورق از سولکوس بیرون نمی‌لغزد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستیار جریان پیوسته و پرحجم هوا را روی نوک ابزار می‌گیرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوک ابزار را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "عمود بر سطح دندان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یا کمی رو به لثه نگه دار و لبه‌ی ورق را به درون سولکوس بران."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ابزار را آرام دور گردن دندان جلو ببر."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "راه دیگر: دندان را خشک کن، ورق را رو به لثه بکش و آرام رها کن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباه رایج: پس از اینورت بین‌دندانی با نخ، نخ را رو به اکلوزال بیرون می‌کشند و نخ لبه‌ی ورق را هم با خودش برمی‌گرداند. به‌جایش نخ را در سمت لینگوال روی خودش تا کن، دوباره از تماس رد کن و یک سرش را رو به فاسیال بکش تا نخ از سولکوس بغلتد و بیرون بیاید."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لیگاتور نخ دندان"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دندان تاج‌کوتاه، یا حفره‌ای که مرزش نزدیک لثه است، گاهی لیگاتور می‌خواهد تا لبه‌ی ورق پایین بماند؛ اگر دندان‌های کافی ایزوله شده باشند، معمولاً لازم نیست."
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نخ را از یک تماس رد کن، دور لینگوال دندان (در قدامی زیر سینگولوم) بچرخان و از تماس دیگر برگردان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در فاسیال با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گره جراحی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ببند: دو دور، سپس یک دور؛ هنگام سفت کردن، نخ را رو به لثه ببر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرها را به فریم ببند تا یادت بماند لیگاتوری هست. هنگام برداشتن رابردم، لیگاتور اول بریده می‌شود."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
