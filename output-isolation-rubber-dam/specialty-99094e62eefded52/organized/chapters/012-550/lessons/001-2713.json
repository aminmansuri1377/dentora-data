                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گاز باز شده روی زبان و پشت دهان (throat shield) هنگام امتحان و برداشتن ترمیم غیرمستقیم. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
