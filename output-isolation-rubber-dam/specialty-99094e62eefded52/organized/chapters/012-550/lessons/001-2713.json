  "steps": [
    {
      "id": "theory:293b80e6e68ff7687892c88f1e8c95972f939ceb82dde55c19f19f432902eaa9",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "7a87313c476277f4ee41cd8f166c81beac56b96b85a21aeb658db32dcc7bbb42",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رول پنبه در فک بالا و پایین"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مردی ۴۵ ساله با گرفتگی مزمن بینی برای ترمیم کامپوزیت کلاس I مولر اول پایین آمده و زیر ورق رابردم نفسش بند می‌آید. یک رول پنبه در وستیبول باکال گذاشته‌ای، ولی هر بار که زبانش تکان می‌خورد، بزاق از سمت لینگوال روی حفره می‌آید. چه چیزی کم است؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی رابردم شدنی یا عملی نیست، رول پنبه، پد جاذب و گاز جایگزین آن‌اند. رول را جلوی دهانه‌ی مجرای بزاقی می‌گذاری تا بزاق را پیش از رسیدن به میدان بگیرد. با HVE یا ساکشن بزاق کنار رول‌ها، بزاق باز هم کمتر می‌شود."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فک بالا:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یک رول در وستیبول باکال، کنار دندان کار. مجرای پاروتید روبه‌روی "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولر دوم بالا"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " روی مخاط گونه باز می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولر دوم و سوم بالا:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " گاهی چند رول لازم است، باکال دندان کار و کمی جلوتر از آن، تا دهانه‌ی مجرای پاروتید بسته شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فک پایین:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یک رول در وستیبول باکال و یک رول میان دندان‌ها و زبان. رول باکال گونه را کنار می‌زند و رول لینگوال زبان را."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گذاشتن رول لینگوال در فک پایین"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سر مزیال رول را با پنس بگیر و رول را بالای جای دلخواه ببر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با انگشت اشاره‌ی دست دیگر، رول را رو به لثه فشار بده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هم‌زمان رول را با پنس رو به لینگوال دندان‌ها بچرخان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی رول‌ها سر جایشان نشستند، ساکشن بزاق را بگذار."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:5de2997d1d24d1ce91935bc6bb903f96352a07d6defe839a2ee8b371e6720e1c",
      "sourceId": null,
      "identityOrigin": "local-step",
