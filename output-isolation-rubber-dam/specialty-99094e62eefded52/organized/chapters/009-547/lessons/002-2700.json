  "steps": [
    {
      "id": "theory:ce9105a4666c744e542ad8453374c2ba571729dfb52e89070106cd8302e5d164",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "5da7b002ee463acee1fdff9f4e37032c79f4f74a426b62ae2ee8f01d59afe1fd",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رابردم و روکش"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مولر اول پایین روکش سرامیکی دارد و حالا درمان ریشه می‌خواهد. لبه‌ی فاسیال روکش نازک است. دستیار کلمپ مولر با فک دندانه‌دار را روی فورسپس سوار کرده، چون «روی سرامیک لیز نمی‌خورد». این کلمپ را می‌گذاری؟"
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپ روی روکش سرامیکی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلمپ فلزی برای کار روزمره کافی است، ولی ممکن است به دندان یا ترمیم موجود آسیب بزند؛ از جمله "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لب‌پریدگی لبه‌ی نازک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ونیر (لمینت) یا روکش."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلمپ با فک دندانه‌دار را روی سطح پرسلنی نگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلمپ پلاستیکی کمتر به ترمیم آسیب می‌زند. اگر هر کلمپی روکش را به خطر می‌اندازد، ورق را بدون کلمپ با Wedjets نگه دار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قانون چهار نقطه روی روکش هم برقرار است؛ کلمپ لرزان هم به روکش آسیب می‌زند و هم به اتصال لثه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رابردم در کار روکش"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رابردم مؤثرترین وسیله‌ی ایزولاسیون در دندانپزشکی ترمیمی است. درباره‌ی تراش روکش کامل دو دیدگاه هست: بیشتر دندانپزشکان آن را در بیشتر روکش‌ها بیشتر مایه‌ی دردسر می‌دانند تا کمک، و برخی در همه‌ی مراحل ترمیم‌های ریختگی به کارش می‌برند. وقتی همه‌ی مارجین‌ها بالای لثه‌اند، رابردم احتمالاً مؤثرترین راه کنترل رطوبت است. در این کارها رابردم جای روشنی دارد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشتن ترمیم قدیمی یا پوسیدگی، وقتی احتمال اکسپوژر پالپ هست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساختن کور آمالگام یا کامپوزیت پین‌دار پیش از روکش."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تراش پست و کور در دندانی که درمان ریشه‌ی قدیمی یا مشکوک دارد."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:f9e649d80e4c19023ffa86874a80524d89208a209d346a6826afe53f17be0a38",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "80d90cd401767d2f8f1b7ab4ef2cb71746c63fdb6cfa91905033ab5f3e69e203",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "آنله، براکت و اسپلینت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اینله و آنله"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رابردم را می‌شود در تراش، قالب‌گیری و سمان کردن اینله و آنله به کار برد، به شرط آنکه "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کاهش اکلوزال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " پیش از گذاشتن رابردم انجام شده باشد؛ زیر رابردم نمی‌توانی فضا را با دندان مقابل بسنجی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به همین دلیل اکلوژن آنله را "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پیش از سمان کردن"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تنظیم کن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "براکت و آرچ‌وایر"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در کودک، برخی دستگاه‌های ارتودنسی ثابت از موقعیت‌هایی‌اند که شاید نشود رابردم گذاشت؛ آن‌جا روش دیگری برای ایزولاسیون برگزین."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در درمان ریشه‌ی دندانی که براکت و آرچ‌وایر دارد، ایزولاسیون تک‌دندان است. آرچ‌وایر نمی‌گذارد ورق به امبرژرها برود؛ درز را با لیکوئید دم، پوتی یا درزگیر ببند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اسپلینت"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای ترمیم روی دندان‌های اسپلینت‌شده، همان روش بستن سپتوم دور کانکتور را به کار ببر: برای هر دندان سوراخ بزن، نخ را از زیر محل اتصال اسپلینت رد کن و سپتوم را دور آن ببند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در درمان ریشه‌ی دندان اسپلینت‌شده، اسپلینت را نگه دار، فقط دندان هدف را ایزوله کن و درزها را با لیکوئید دم ببند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "نکته‌ی طلایی: بریج و اسپلینت یک مشکل دارند: جایی که دندان‌ها به هم وصل‌اند، سپتوم از میانشان رد نمی‌شود. پس سپتوم را دور محل اتصال ببند، نه از میان آن."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-2-3-2-s2.webp",
                  "alt": "روش بستن سپتوم دور کانکتور، برای بریج سه‌واحدی یا دندان‌های اسپلینت‌شده.",
                  "attributes": {
                    "width": "",
