  "steps": [
    {
      "id": "theory:a4fe67cb35a04bee237dd228e48496315ddeb070d8d34878aec8570d5ef1ac45",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "67dd712e605db6115d6543fbf8fbbd34eec8fe2d1c3cd7f95eec8b3783aea5ea",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سنجش دشواری ایزولاسیون"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "مولر اول پایین برای درمان ریشه آمده است. ترمیم آمالگام بزرگی دارد که لبه‌ی دیستالش باز شده و زیرش پوسیدگی دیده می‌شود. هم‌کلاسی‌ات می‌خواهد همین حالا کلمپ بگذارد و اگر نگرفت، بدون رابردم کار کند. کار درست از کجا شروع می‌شود؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دشواری ایزولاسیون را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از شروع درمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بسنج؛ نه وقتی کلمپ را برمی‌داری، نه پس از برداشتن پوسیدگی و نه پس از باز کردن حفره‌ی دسترسی. دندانی که درمان ریشه لازم دارد اغلب ترمیم بزرگ، پوسیدگی یا ساختار کمی دارد و همین‌ها ایزولاسیون و دسترسی را سخت می‌کنند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در معاینه چه ببینی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ساختار سالم باقی‌مانده"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": چقدر بالای لثه است و آیا کلمپ جای چهار نقطه دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لبه‌ی پوسیدگی یا شکستگی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": بالای لثه است یا تا زیر لثه رفته."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "رادیوگرافی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": لبه‌ی ضایعه چقدر به کرست استخوان نزدیک است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ترمیم‌ها"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": پوسیدگی زیر ترمیم، ترمیم معیوب و ترمیمی که لبه‌اش نشت دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "روکش موقت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": باید پیش از درمان برداشته شود یا نه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "«رابردم نمی‌گذارم» جزو گزینه‌ها نیست. هر چه دندان دشوارتر باشد، مزیت رابردم بیشتر به چشم می‌آید؛ و دندان دشوار که ایزوله شد، کار بعدی رویش ساده می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
