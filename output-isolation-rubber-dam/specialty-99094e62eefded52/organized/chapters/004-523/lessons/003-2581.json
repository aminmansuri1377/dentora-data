  "steps": [
    {
      "id": "theory:d8c1d272ae55d22a993ee96d1b0f0b03cd9522a31bddcedaee43239fe80bf14f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "43d9fd3f25965f6b961dd59a6059e8ac7181c2344680f92f30ccaa337cde7526",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "گام‌های روش ورق اول"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیماری با حساسیت به لاتکس برای درمان ریشه‌ی مولر اول بالا آمده است. دانشجو با ورق بدون لاتکس روش کلمپ اول را امتحان کرد؛ سوراخ هنگام رد شدن از روی کلمپ از هم باز شد و درز بزرگی ماند. با ورق تازه چه روشی را انتخاب کند؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-1-4-3-s1.webp",
                  "alt": "روش ورق اول: دستیار سوراخ را روی دندان می‌کشد و دندانپزشک کلمپ را می‌گذارد.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/f3d6886176cf84e0b624d0f84eb5bb49025e21ca41c750b8a863ff69bad47690.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روش ورق اول: دستیار سوراخ را روی دندان می‌کشد و دندانپزشک کلمپ را می‌گذارد. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Cardinali & Gorni. The Use of the Rubber Dam in Endodontics (StyleItaliano) — Fig. 30, 32 (Ch.9))"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در روش ورق اول، اول ورق روی دندان می‌نشیند و بعد کلمپ روی ورق گذاشته می‌شود. این روش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهاردستی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلمپ را روی فورسپس سوار کن و آماده در دست نگه دار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستیار سوراخ را با انگشتانش باز می‌کند و دندان را از سوراخ رد می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دستیار ورق را پایین، دور گردن دندان، نگه می‌دارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندانپزشک کلمپ را روی دندان و روی ورق می‌گذارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ورق را روی فریم بکش و با نخ از تماس‌ها رد کن. در کلمپ دوکمانه، نخ را معمولاً باید از پشت هر دو کمان رد کنی."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش ورق اول اصلاح‌شده"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دندانپزشک کنار بیمار می‌ایستد، فورسپس آماده را در دست غالب می‌گیرد و انگشت اشاره‌ی دست دیگر را یک طرف سوراخ می‌گذارد. دستیار انگشت اشاره‌اش را طرف دیگر سوراخ می‌گذارد و با دست دیگر گوشه‌های بالای ورق را نگه می‌دارد تا ورق تا نشود و جلوی دید را نگیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دندانپزشک دستیار را به سمت دندان هدف هدایت می‌کند و بعد خودش کلمپ می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:a184854c20ba211dc9201ea21cc14a38f8d923cefa0d9db0e7ed63e68546afd8",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ff29665024aa6bae44a5eff58475f01251d6407aa4db044f111cb437e7cfcbbb",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کاربرد و محدودیت‌های روش ورق اول"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روش ورق اول سریع و ایمن است: اگر کلمپ از فورسپس رها شود، روی ورق می‌افتد، نه در حلق."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هر نوع کلمپ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کار می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روش انتخابی برای "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کلمپ دوکمانه‌ی بی‌بال"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " مثل کلمپ 212 است؛ این کلمپ بالی ندارد که در سوراخ گیر کند، و ورق را هم نمی‌شود پس از نشستنش از روی دو کمان رد کرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بهترین روش با "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ورق بدون لاتکس"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " است، چون سوراخ فقط روی خود دندان باز می‌شود و روی کمان و فک‌های کلمپ کش نمی‌آید."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محدودیت‌ها"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بی‌دستیار عملاً شدنی نیست."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان هدف هنگام کلمپ کردن کمتر دیده می‌شود و فک کلمپ ممکن است به لثه فشار بیاورد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دست‌های دستیار که ورق را دور گردن دندان نگه می‌دارند، برای بیمار ناخوشایند است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "نکته‌ی طلایی: شناسایی دندان و کلمپ کردن بی‌آسیب به بافت نرم کار خود دندانپزشک است و به دستیار سپرده نمی‌شود. درباره‌ی کشسانی ورق بدون لاتکس و اندازه‌ی سوراخش دو دیدگاه هست؛ آنچه قطعی است این است که این ورق را با روش ورق اول بگذاری، نه با کلمپ اول که سوراخ را تا از هم پاشیدن ورق کش می‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
