                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از رابردم، پوسیدگی پروگزیمال را تا دیواره‌ی سرویکال سالم بردار، "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بی‌ورود به فضای پالپ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لبه‌ی سرویکال تمیز را ببین: کلمپ جای گیر دارد؟ افزایش طول تاج لازم است؟"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رابردم را بگذار و درز کنار دیواره‌ی از دست رفته را با لیکوئید دم ببند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفره‌ی دسترسی را باز کن. نبود دیواره‌ی مزیال (یا دیستال) دسترسی فایل روتاری به کانال‌ها را آسان‌تر می‌کند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چرا پوسیدگی را پیش از ورود به اتاقک برمی‌داری"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرزی که زیر رابردم پوسیدگی سرویکال را برمی‌دارد، ورق را همان‌جا پاره می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از ورود به کانال محیط آسپتیک ساخته می‌شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترمیم‌پذیری دندان را پیش از درمان می‌سنجی."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساختار سالمی برای ترمیم موقت می‌ماند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباه رایج: ورود به اتاقک پالپ پیش از آماده کردن کامل ترمیم‌ها و ساختار تاج. تکه‌ی ترمیم و دبری به کانال می‌افتد و ممکن است بخش اپیکال کانال را ببندد."
                }
              ]
            }
          ]
        }
