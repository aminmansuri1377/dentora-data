  "steps": [
    {
      "id": "theory:c1f6b111817f603e6b78fd3998af452e936d0131721268c99e8a094a8c57498e",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "5fd11b589f68fbdc44c5dc7a6b9c0e14e0b26f33bf63fc5c7bc2414152e8f44f",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اجزای کیت رابردم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "روز اول بخش ترمیمی است. کیت رابردم جلوی توست: یک ورق، یک پانچ، چند کلمپ، یک فورسپس، یک فریم و یک بسته نخ دندان. بیمار برای ترمیم مولر اول پایین آمده است. هر کدام از این‌ها را برای چه برمی‌داری؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-1-1-1-s1.webp",
                  "alt": "کیت رابردم: فورسپس کلمپ، پانچ، فریم پلاستیکی و ورق.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/4ae020db099309159606142fcf29a8d6a224099c4e2b30c032aca84fa0c58dc0.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کیت رابردم: فورسپس کلمپ، پانچ، فریم پلاستیکی و ورق. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Torabinejad. Endodontics: Principles and Practice — Fig. 7.6)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کیت رابردم چهار جزء اصلی دارد و چند وسیله‌ی کمکی. اگر کار هر جزء را بدانی، وسط کار دنبال چیزی نمی‌گردی."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "چهار جزء اصلی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ورق رابردم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": سد میان دندان و دهان؛ از لاتکس یا ماده‌ی بدون لاتکس."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پانچ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": روی ورق سوراخ گرد و تمیز می‌زند تا دندان از آن بیرون بیاید."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کلمپ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": ورق را روی دندان لنگر نگه می‌دارد و لثه را کمی کنار می‌زند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فریم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": لبه‌های ورق را بیرون دهان کشیده نگه می‌دارد تا لب و گونه کنار بروند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وسایل کمکی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فورسپس کلمپ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کلمپ را باز می‌کند، به دهان می‌برد و روی دندان می‌گذارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "نخ دندان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": برای وارسی تماس‌ها، رد کردن ورق از تماس و بستن نخ ایمنی کلمپ."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دستمال رابردم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": میان ورق و پوست صورت می‌نشیند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لوبریکانت محلول در آب"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": رد شدن ورق از تماس‌ها را آسان می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لیکوئید دم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": درزهای کوچک میان ورق، کلمپ و دندان را سیل می‌کند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مهر یا الگوی سوراخ (template): جای سوراخ‌ها را روی ورق علامت می‌زند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از گذاشتن رابردم، نخ دندان را از همه‌ی تماس‌ها رد کن. اگر نخ ریش‌ریش شد، لبه‌ی تیز ترمیم یا مینا را صاف کن؛ وگرنه ورق همان‌جا پاره می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:8eef5cc7d97baff8f511060c3f1dbc18a2743594dc6dd129eaf49a0c8453d24d",
      "sourceId": null,
