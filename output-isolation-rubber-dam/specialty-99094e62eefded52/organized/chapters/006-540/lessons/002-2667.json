                  },
                  "assetPath": "assets/0ebc0c751bc9fcfe68ae10d83bf129e7bd7bf6820d761a61a6dbf30ede9c5860.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گوه چوبی بین‌دندانی ورق را از برش فرز محافظت می‌کند. "
                    },
                    {
                      "tag": "span",
