  "steps": [
    {
      "id": "theory:6c2d31ce4f5d1fdcc5abc0ff7fac634d72843945ca910d5a735c8afcec2f9fc2",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "06cc52689dcb4acaad6d1b7537c3974ea7eda5a33a3af2716eed7d9c42f280d0",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ترتیب برداشتن رابردم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "ترمیم آمالگام کلاس II مولر اول پایین تمام شده است. دانشجو کلمپ را با فورسپس برمی‌دارد و ورق را یکجا بیرون می‌کشد. ورق در تماس‌ها گیر می‌کند، لثه‌ی بین‌دندانی کشیده می‌شود و خرده‌های آمالگام روی زبان بیمار می‌ریزد. کدام گام‌ها جا افتاد؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-1-6-1-s1.webp",
                  "alt": "بریدن سپتوم‌ها با قیچی، در حالی که ورق از بافت دور کشیده شده است.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/59ce666665e61c562eeca0bcbd796a8951b99976accf7a1dc6fe0e84e6c50c3a.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بریدن سپتوم‌ها با قیچی، در حالی که ورق از بافت دور کشیده شده است. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Sturdevant's Art and Science of Operative Dentistry, 8th ed. — Procedure 3.2)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برداشتن رابردم هم ترتیب دارد. پیش از هر کاری، میدان را با آب بشوی و خرده‌ها را با HVE بکش تا هنگام برداشتن ورق به کف دهان نریزند. اگر ساکشن بزاق گذاشته‌ای، همین حالا بیرونش بیاور."
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لیگاتورها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اگر لیگاتور نخ دندان بسته‌ای، اول آن را ببُر یا با سوند رو به اکلوزال بیرون بکش."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سپتوم‌ها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " هر سپتوم را با قیچی ببُر تا ورق از فضاهای بین‌دندانی آزاد شود. ورق روی دندان لنگر خلفی و قدامی بماند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کلمپ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " کلمپ را با فورسپس بردار. کامپاند یا ماده‌ی سفت دور کلمپ را جدا برنمی‌داری؛ با باز شدن فک‌ها خودش می‌شکند."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ورق و فریم:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ورق را از دندان لنگر قدامی آزاد کن و ورق و فریم را با هم بیرون بیاور. به بیمار بگو تا وارسی اکلوژن روی ترمیم تازه، به‌ویژه آمالگام، گاز نگیرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لب‌ها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " بی‌درنگ لب‌ها را با دستمال رابردم پاک کن تا بزاق روی صورت نریزد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شست‌وشو و ماساژ:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دهان را با اسپری آب و هوا و HVE بشوی و لثه‌ی دور دندان‌های ایزوله‌شده، به‌ویژه دندان کلمپ‌شده، را ماساژ بده تا خون‌رسانی‌اش بهتر شود."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در کودک، بسیاری پس از بریدن سپتوم‌ها کلمپ، فریم و ورق را یکجا با فورسپس برمی‌دارند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:02e9b32883d3070e6fad4b31a7894f37cd1a92a74bc6f480ae78732869816dfa",
      "sourceId": null,
      "identityOrigin": "local-step",
