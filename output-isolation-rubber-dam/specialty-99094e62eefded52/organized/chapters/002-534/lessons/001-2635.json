  "steps": [
    {
      "id": "theory:2e34d7ea887f5069e41141f72d79ba1a97b8e76a119c7764e097a13175ce5ab5",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "956daba528d1fc275606880ed7220399a85f4afe4243968ff3fb4ca6c07be203",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "معاینه‌ی دندان پیش از انتخاب کلمپ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "بیمار برای درمان ریشه‌ی مولر دوم بالا آمده و دندان آشکارا کوچک‌تر از مولر اول است. دستیار یک کلمپ مولر آورده، ولی وقتی آن را باز نشده کنار دندان می‌گیری، فاصله‌ی دو نقطه‌ی هر فک از عرض مزیودیستال دندان بیشتر است. این کلمپ روی این دندان چه می‌کند؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-1-2-1-s1.webp",
                  "alt": "فاصله‌ی دو نقطه‌ی هر فک (a) باید از قطر مزیودیستال دندان (A)، و فاصله‌ی دو فک (b) از قطر باکولینگوال (B) کمتر باشد.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/1bba1a73c38dd2d4250cde693eb97a55b0be4a58d9ada28dc883d28c536792af.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فاصله‌ی دو نقطه‌ی هر فک (a) باید از قطر مزیودیستال دندان (A)، و فاصله‌ی دو فک (b) از قطر باکولینگوال (B) کمتر باشد. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Cardinali & Gorni. The Use of the Rubber Dam in Endodontics (StyleItaliano) — Fig. 6–7)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "انتخاب کلمپ مهم‌ترین لحظه‌ی ایزولاسیون است؛ پایداری میدان در تمام درمان به آن بسته است. کلمپ را پس از تعیین وسعت ایزولاسیون و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از سوراخ کردن ورق"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انتخاب کن."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در معاینه چه ببینی"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اندازه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": قطر مزیودیستال و قطر باکولینگوال دندان."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شکل تاج"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": سالم، پوسیده، شکسته یا تراش‌خورده برای روکش."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جای دندان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کامل رویش یافته یا نیمه‌رویش‌یافته، چرخیده یا خم‌شده."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لثه و دندان‌های کناری"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": وضع لثه‌ی دور دندان و رابطه با همسایه‌ها."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گام‌های کنار یونیت"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلمپ باز نشده را کنار دندان بگیر و دو فاصله‌اش را با دو قطر دندان مقایسه کن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کلمپ را با نخ ایمنی روی دندان بگذار و از باکال و لینگوال ببین هر چهار نقطه نشسته است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تست پایداری را انجام بده و فقط پس از قبولی سراغ ورق برو."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برچسب «مولر» یا «پرمولر» تصمیم‌گیرنده نیست. روی مولر دوم کوچک بالا، کلمپ پرمولر ممکن است تنها کلمپی باشد که هر چهار نقطه‌اش هم‌زمان می‌نشیند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:0d70564833c5179b961885f16153d19d81ebccb806b014e7dd5e00a111649aaf",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "fd7bb743531f7234be95de3480fb6f16b1a3d45daef08b7f28370e68dfd3dd41",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کلمپ کوچک، کلمپ بزرگ"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپ نامناسب معمولاً یا از دندان کوچک‌تر است یا بزرگ‌تر، و هر کدام مشکل خودش را دارد."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپ خیلی کوچک"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای رد شدن از برجستگی باکال و لینگوال تاج باید بیش از اندازه باز شود."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کمانش تغییر شکل می‌دهد یا می‌شکند؛ کلمپی که فنرش را از دست داده سست می‌گیرد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپ خیلی بزرگ"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر فاصله‌ی دو فک تقریباً با قطر باکولینگوال برابر باشد، کلمپ تقریباً بی‌نیرو می‌نشیند و با کشیدن ورق روی فریم می‌افتد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اگر فاصله‌ی دو نقطه‌ی هر فک از قطر مزیودیستال بیشتر باشد، نقطه‌ها از لاین‌انگل‌ها بیرون می‌افتند و وسط فک به دندان می‌خورد؛ نقطه‌های گیر عملاً به هم نزدیک می‌شوند و کلمپ می‌چرخد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فک‌های بلند جای ماتریکس و وج را می‌گیرند و به لثه فشار می‌آورند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پایداری کلمپ را دو چیز تعیین می‌کند: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فاصله‌ی دو نقطه‌ی هر فک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سفتی کمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". برای همین لبه‌ی فک کلمپ‌های مولر میان دو نقطه قوس برجسته‌ای دارد تا حتی روی گردن خیلی محدب مولر فقط نقطه‌ها دندان را لمس کنند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «کلمپ بزرگ‌تر محکم‌تر می‌گیرد.» گیر از باز شدن فک‌ها روی دندان می‌آید، نه از بزرگی کلمپ. فک و نوک‌ها می‌توانند لثه را کمی فرو ببرند، ولی نباید آن را سوراخ یا پاره کنند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
