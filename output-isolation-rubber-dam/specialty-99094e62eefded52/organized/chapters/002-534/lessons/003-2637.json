  "steps": [
    {
      "id": "theory:c823e446a990c8ad695a623a8e3fb3a7dd8a4395e476aeea6e79311310c81b3b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "51362fe863b2d705e08bc1f77ab9689998620ad652708dc64a43713075fb46e0",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کلمپ مولر برای هر وضعیت"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "برای ترمیم کلاس II مولر اول پایین، کلمپ را روی مولر دوم می‌گذاری. تاج مولر دوم سالم است و کامل رویش یافته. در کشو کلمپ‌های 56، 7، 8A و 14A هست. از کدام شروع می‌کنی؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-1-2-3-s1.webp",
                  "alt": "مجموعه‌ای از کلمپ‌های قدامی، پرمولر و مولر برای درمان ریشه.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/59c26072b9ead0e712fc46c5410169422e08fe7135528c281e684c8cf50c93ac.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مجموعه‌ای از کلمپ‌های قدامی، پرمولر و مولر برای درمان ریشه. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Torabinejad. Endodontics: Principles and Practice — Fig. 13.3)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "شماره‌ها میان سازنده‌ها فرق دارد؛ آنچه باید بدانی منطق هر گروه است. شماره‌های زیر مال سیستم رایج Ivory و Hu-Friedy است."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "همه‌کاره"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کلمپ 56 بیشتر مولرها را ایزوله می‌کند؛ فکش کمی فستونی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولر پایین"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کلمپ 7 با فک صاف؛ کلمپ 3 برای مولر کوچک پایین."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولر بالا"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کلمپ‌های 4، 8 و 205؛ کلمپ 4 برای مولر کوچک بالا."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هر دو فک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کلمپ 8A با فک فستونی عمیق و گیر چهارنقطه‌ای؛ نسخه‌ی بی‌بالش کلمپ W8A است که فکش کم‌شیب‌تر است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولر نیمه‌رویش‌یافته یا نامنظم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کلمپ‌های 14، 14A و W14A با فک فستونی عمیق، که از کلمپ 56 عمیق‌تر گیر می‌کنند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپ مخصوص مولر کوچک فک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "صاف و باریک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارد تا دو نقطه‌ی هر فک روی تاج کوچک، درون لاین‌انگل‌ها، بنشیند. برای مولر سالم و کامل رویش‌یافته از فک صاف یا کم‌شیب شروع کن و فستونی عمیق را برای تاج تخریب‌شده یا نیمه‌رویش‌یافته نگه دار."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:de326fbdaf07991c8445ab15845451f217df274b31aa2b054cecd3415f101611",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ce15f2676dc74b08d84c939f1dbc7511f9dc540da03db8e69cc90b2ea35a6ebb",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چند وضعیت ویژه در مولر"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مولر کوچک"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": اگر هیچ کلمپ مولری قانون چهار نقطه را برقرار نکرد، کلمپ پرمولر بگذار."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کلمپ‌های قرینه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": بعضی کلمپ‌های مولر فک نامتقارن (offset) دارند و به صورت جفت قرینه ساخته می‌شوند. هر کلمپ جفت فقط روی دندان‌های مشخصی درست می‌نشیند؛ پیش از گذاشتن ببین جفت درست را برداشته‌ای."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ترمیم دیستال آخرین مولر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": کمان همچنان در دیستال است، ولی فک‌ها نباید از لاین‌انگل دیستال جلوتر بروند. کلمپی که کمانش بیشتر به دیستال کشیده شده، جای کار روی سطح دیستال را بازتر می‌گذارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جای کلمپ"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ": در ایزولاسیون چنددندانی، کلمپ معمولاً روی دیستال‌ترین دندانی می‌نشیند که از ورق بیرون آمده است."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کلمپی که فک‌هایش از لاین‌انگل‌ها گذشته، جای نوار ماتریکس و وج را می‌گیرد، به لثه فشار می‌آورد و سیل دور دندان لنگر را سخت می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کلمپ 56 را برای هر مولری برداشتن و وقتی لق شد، ورق را محکم‌تر کشیدن. کلمپ همه‌کاره برای بیشتر مولرهاست، نه همه. اگر قانون چهار نقطه یا تست پایداری رد شد، کلمپ دیگری بردار."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
