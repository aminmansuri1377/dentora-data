  "steps": [
    {
      "id": "theory:36460ce325026702bab1ab71d90efeb0c6ade5e26a06686afdea851ac84e42e2",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "089dc1538a2aed0c1114119d638bb12ac4aefb4e00e3230a78d9ece335af1f6c",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "جای سوراخ در ورق فک بالا و پایین"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {
                "tone": "note"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "دانشجو برای ترمیم ثنایای میانی بالا، سوراخ‌ها را خیلی نزدیک لبه‌ی بالای ورق زد. پس از گذاشتن رابردم، لب بالای بیمار بیرون ورق ماند و ورق به‌زور روی فریم رسید. سوراخ ثنایا باید کجا باشد؟"
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-1-3-3-s1.webp",
                  "alt": "هرچه دندان لنگر فک پایین عقب‌تر باشد، ورق بیشتری پشت کلمپ لازم است تا لب بالا پوشیده شود.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/36b345d3df24a2b5ea76f185ec2f4355b1bc88ad3ff6765797abc11c72cdd021.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هرچه دندان لنگر فک پایین عقب‌تر باشد، ورق بیشتری پشت کلمپ لازم است تا لب بالا پوشیده شود. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Sturdevant's Art and Science of Operative Dentistry, 8th ed. — Fig. 3.16)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سوراخ‌ها را طبق شکل قوس بیمار بزن و جای دندان چرخیده یا جابه‌جا را تنظیم کن. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای دندان غایب سوراخ نزن."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دستیار بهتر است پیش از پانچ، شکل قوس و ردیف دندان‌ها را ببیند."
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ورق فک بالا"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اول سوراخ ثنایای میانی را بزن، حدود "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "۲۵ میلی‌متر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " زیر لبه‌ی بالای ورق؛ این فاصله ورق کافی برای پوشاندن لب بالا می‌گذارد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای لب بالای بزرگ یا سبیل، کمی پایین‌تر؛ برای کودک یا لب کوچک، کمی بالاتر."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بعد بقیه‌ی سوراخ‌ها را طبق وسعت ایزولاسیون بزن."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ورق فک پایین"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اول سوراخ "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "دندان لنگر"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " (کلمپ‌شده) را بزن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ورق را در ذهن به سه بخش عمودی (چپ، میانی، راست) تقسیم کن. سوراخ مولر اول پایین در نیمه‌ی راه لبه‌ی بالا تا پایین ورق و روی مرز بخش کناری و میانی است."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برای لنگر دیستال‌تر از مولر اول، سوراخ را پایین‌تر و کمی رو به وسط ببر؛ برای لنگر مزیال‌تر، بالاتر و کمی رو به وسط."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هرچه لنگر پایین دیستال‌تر باشد، ورق بیشتری باید از پشت کلمپ تا روی لب بالا برسد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:134e5a0547b957a0ab215a1a2d7b02b826b751ce51ce0ae98688704595e84762",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "600b65bd8dd41cfc12b1adf87322e1d6a9b1cc25d5d4c2c434a2937fc6c8640c",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "علامت‌گذاری جای سوراخ و فاصله‌ی سوراخ‌ها"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فشار روی دندان‌ها:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ورق را روی صورت بگذار و با انگشت روی دندان‌ها فشار بده؛ رد خیس روی ورق جای سوراخ را نشان می‌دهد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "علامت با ماژیک:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ورق را روی دندان‌های بیمار یا کست مطالعه بگذار و مرکز هر دندان را علامت بزن. با دندان نامرتب هم دقیق است، ولی وقت می‌گیرد؛ روی دندان‌های بیمار هم نمی‌شود ورق را پیش از نشستن او آماده کرد."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "الگو (template) و مهر:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " جای میانگین دندان‌ها را نشان می‌دهند و ورق را می‌شود از پیش سوراخ کرد. نقطه‌ی ثنایای میانی بالا حدود ۲۵ میلی‌متر زیر لبه‌ی بالا باشد تا لبه‌ی ورق زیر بینی بنشیند، نه روی آن. برای دندان نامرتب، سوراخ را کمی دور از نقطه بزن."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بی‌علامت:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دندانپزشک باتجربه پس از نگاه به دهان مستقیم سوراخ می‌زند."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ورقی که به دهان خورده به بزاق آلوده است؛ پانچی که با آن کار کرده را استریل کن."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/isol-fig-1-3-3-s2.webp",
                  "alt": "ورقی که روی دندان‌ها فشرده شده، نوار مرطوبی نشان می‌دهد که جای سوراخ‌ها را معلوم می‌کند.",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/de6df93c74adff79e9b38cd7bbfd386270581789195a19ddd6f459ffc453ea5b.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ورقی که روی دندان‌ها فشرده شده، نوار مرطوبی نشان می‌دهد که جای سوراخ‌ها را معلوم می‌کند. "
                    },
                    {
                      "tag": "span",
                      "attributes": {
                        "dir": "ltr"
                      },
                      "children": [
                        {
                          "tag": "text",
                          "text": "(Cardinali & Gorni. The Use of the Rubber Dam in Endodontics (StyleItaliano) — Fig. 3 (Ch.8))"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "h3",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فاصله‌ی سوراخ‌ها"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "فاصله‌ی دو سوراخ برابر فاصله‌ی مرکز یک دندان تا مرکز دندان کناری، در سطح لثه است. با این فاصله ورق پاپیلای بین‌دندانی را می‌پوشاند و کمی کنار می‌زند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "tone": "warning"
              },
              "children": [
                {
                  "tag": "text",
                  "text": "اشتباه رایج: سوراخ خیلی نزدیک به لبه‌ی ورق. ورق روی فریم کشیده نمی‌شود، یا آن‌قدر کش می‌آید که سیل دور دندان از دست می‌رود."
                }
              ]
            }
          ]
        }
      ],
