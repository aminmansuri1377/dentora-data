              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سادگی اجرا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — نه اچ می‌خواهد نه باندینگ."
