      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ماتریکس مناسب و سه کار وج"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ماتریکس‌های بزرگسال اغلب برای تاج کوتاه و باریک دندان شیری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حجیم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "اند. در کودکان معمولاً از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوار T"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا ماتریکس‌های محیطی کوچک استفاده می‌شود، و برای کامپوزیت، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماتریکس سکشنال همراه رینگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وج سه کار هم‌زمان انجام می‌دهد:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مارجین جینجیوال را "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سیل"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " می‌کند تا ماده بیرون نزند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "از ایجاد "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "لبه‌ی اضافه"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " (اورهنگ) جلوگیری می‌کند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کمی "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "جدایی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ایجاد می‌کند تا پس از برداشتن ماتریکس، تماس محکم بماند."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بدون وج، هر سه این‌ها از دست می‌روند."
                }
              ]
            }
          ]
        }
      ],
