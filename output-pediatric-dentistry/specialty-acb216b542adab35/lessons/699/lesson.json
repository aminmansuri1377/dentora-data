          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هر بار که قند وارد دهان می‌شود، pH پلاک سقوط می‌کند و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ده‌ها دقیقه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " طول می‌کشد تا بزاق آن را به حالت امن برگرداند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یعنی آنچه اهمیت دارد "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعداد دفعات مواجهه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه مقدار کل قند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک مقایسه که همه‌چیز را روشن می‌کند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خوردن یک شکلات در یک نوبت، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حمله‌ی اسیدی می‌سازد؛ همان شکلات اگر در طول روز ده بار مزه‌مزه شود، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حمله."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "به همین دلیل بدترین الگو "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ریزه‌خواری مداوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جرعه‌جرعه نوشیدن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نوشیدنی شیرین است — دهان هرگز فرصت بازیابی پیدا نمی‌کند."
                }
              ]
            }
          ]
        }
      ],
