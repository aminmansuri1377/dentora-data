        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کامپوزیت بهترین نتیجه‌ی زیبایی را می‌دهد و چون "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چسبنده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، اجازه می‌دهد تراش محافظه‌کارانه‌تری انجام شود — لازم نیست برای گیر مکانیکی بافت سالم برداری."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی بهایی دارد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به اچ کردن و باندینگ نیاز دارد و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر قطره بزاق روی سطح آماده‌شده، چسبندگی را از بین می‌برد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یعنی کامپوزیت عملاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایزولاسیون مطمئن را پیش‌فرض می‌گیرد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". اگر نمی‌توانی رابردم بگذاری یا رطوبت را کنترل کنی، این ماده انتخاب درستی نیست — هرچقدر هم زیباتر باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این همان اصلی است که در کل ماژول تکرار می‌شود: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماده را با شرایط واقعی هماهنگ کن، نه با ترجیح شخصی."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
