      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تاریخچه‌ای که واقعاً برنامه را عوض می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تاریخچه‌ی طولانی به درد نمی‌خورد؛ تاریخچه‌ای به درد می‌خورد که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تصمیم تو را تغییر دهد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". پنج چیز که همیشه باید بپرسی:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "آلرژی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — دارو، لاتکس، غذا. مستقیماً روی انتخاب دارو و دستکش اثر دارد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بیماری قلبی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — نیاز به مشاوره و احتمال پروفیلاکسی آنتی‌بیوتیک."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اختلال خون‌ریزی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — کشیدن دندان و جراحی را کاملاً تغییر می‌دهد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "آسم و بستری‌های قبلی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — هم ریسک پزشکی، هم پیش‌بینی‌کننده‌ی رفتار."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "داروهای مصرفی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — از شربت‌های شیرین شبانه تا داروهای مؤثر بر بزاق."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک سؤال طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «تجربه‌ی پزشکی یا دندانی ناخوشایندی داشته؟» — این یک جمله، بیشترین اطلاعات رفتاری را می‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
