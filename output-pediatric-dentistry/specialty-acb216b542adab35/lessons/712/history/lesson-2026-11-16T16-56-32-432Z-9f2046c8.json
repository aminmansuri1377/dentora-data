              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا ترتیب مهم است؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چون سؤال اول "
