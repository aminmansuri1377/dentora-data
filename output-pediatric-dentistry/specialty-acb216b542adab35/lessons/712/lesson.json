        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه سؤال، به همین ترتیب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از انتخاب هر ماده، سه سؤال را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به ترتیب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بپرس:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ایزولاسیون مطمئن ممکن است؟"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " اگر نه، مسیر همین‌جا بسته می‌شود و گلاس‌آینومر انتخاب می‌شود — بقیه‌ی سؤال‌ها دیگر موضوعیت ندارند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ریسک پوسیدگی بیمار چقدر است؟"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ریسک بالا یعنی آزادسازی فلوراید ارزش پیدا می‌کند و مرزهای ترمیم پرآزمون‌ترند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "وسعت ضایعه و بار مکانیکی چقدر است؟"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " محدود ← ترمیم مستقیم، وسیع چندسطحی در مولر شیری ← پوشش کامل."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا ترتیب مهم است؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چون سؤال اول "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حذف‌کننده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. اگر از رویش بپری، ممکن است ماده‌ای انتخاب کنی که در این دهان اصلاً کار نمی‌کند."
                }
              ]
            }
          ]
        }
      ],
