      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چه چیزی می‌تواند مانع شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی دندانی نمی‌روید، فهرست موانع کوتاه و مشخص است:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان اضافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — شایع‌ترین آن‌ها مزیودنس است که میان ثنایاهای مرکزی بالا قرار می‌گیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "توده‌ی سخت مانند ادنتوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که مسیر را می‌بندد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان شیری تحلیل‌نرفته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که سر جای خود مانده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بافت فیبروز یا اسکار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی ناحیه‌ی رویش، مثلاً پس از جراحی یا تروما."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نشانه‌ی راهنما:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدم تقارن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". اگر همتای سمت مقابل بیش از حدود ۶ ماه پیش رویده و این یکی هنوز نیامده، دلیلی وجود دارد — و باید دنبالش گشت."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:bf3aee1c0dc96e82f14bb08e27ef47f18e80c6dadb45e0f08c8cb3ef2ab6a668",
      "position": 2,
