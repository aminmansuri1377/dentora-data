      "sourceProgress": "width: 14.2857%;",
      "questionType": "unknown",
      "title": "درس ۳: موانع رویش",
      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تصمیم پس از یافتن مانع"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برداشتن مانع به‌تنهایی کافی نیست؛ باید پرسید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آیا دندان پس از آن خودش می‌رویَد؟"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شانس رویش خودبه‌خودی بیشتر است وقتی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضای کافی در قوس موجود باشد، ریشه‌ی دندان هنوز کامل نشده باشد، و موقعیت دندان چندان منحرف نباشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و کمتر است وقتی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضا از دست رفته باشد، ریشه کامل شده باشد، یا دندان به‌شدت منحرف باشد — که در آن صورت ممکن است به کشش ارتودنتیک نیاز شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس تصمیم دو بخشی است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برداشتن مانع، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برنامه‌ی رویش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — که شامل حفظ یا بازیابی فضا هم می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
