                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهار عامل هم‌زمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حاضر باشند — نبود هرکدام، زنجیره را می‌شکند:"
