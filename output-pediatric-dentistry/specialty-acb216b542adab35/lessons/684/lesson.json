                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "pH بحرانی مینا حدود ۵٫۵"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. زیر این عدد، دمینرالیزاسیون شروع می‌شود."
