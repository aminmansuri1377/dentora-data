                        },
                        {
                          "tag": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بیوفیلم میکروبی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " باکتری‌های اسیدساز روی سطح دندان."
