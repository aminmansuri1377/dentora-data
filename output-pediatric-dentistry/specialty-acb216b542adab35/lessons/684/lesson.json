                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ماده‌ی زمینه:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " کربوهیدرات‌های قابل تخمیر، به‌ویژه "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ساکارز"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "زمان:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " نه مدت، بلکه "
