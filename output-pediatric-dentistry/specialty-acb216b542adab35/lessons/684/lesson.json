                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "میزبان و دندان:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " آناتومی شیارها، کیفیت مینا، و مهم‌تر از همه "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بزاق"
