          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تراش: چه برداشته می‌شود، چه نه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اکلوزال:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حدود یک تا یک‌ونیم میلی‌متر کاهش، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هم‌شکل با آناتومی کاسپ‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نه به‌صورت تخت؛ تراش تخت کاسپ‌ها را بیش از حد کوتاه می‌کند و به شاخ‌های پالپ زیر آن‌ها نزدیک می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پروگزیمال:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با فرز مخروطی، تماس را باز کن تا سوند آزادانه عبور کند. لبه باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پَر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مهم‌ترین نکته — چه چیزی را نگه دار:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لبه یا شانه‌ی سرویکال نساز."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شانه، روکش را از نشستن کامل بازمی‌دارد. و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برجستگی سرویکال را نتراش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — همان برجستگی است که روکش را قفل می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باکال و لینگوال:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " معمولاً تراش کم یا هیچ. زوایای تیز را گرد کن."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
