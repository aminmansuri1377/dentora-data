{
  "url": "https://app.dentigoapp.com/fa/lesson/692",
  "title": "درس ۴: فلوروزیس و سمیت حاد فلوراید",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "فلوروزیس: مسئله‌ی زمان است، نه فقط مقدار"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فلوروزیس نتیجه‌ی "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بلع مزمن فلوراید در دوره‌ی ساخت مینا"
                }
              ]
            },
            {
              "tag": "text",
              "text": " است. پس از پایان ساخت، هر مقدار فلوراید هم که بلعیده شود دیگر فلوروزیس نمی‌سازد."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دوره‌ی حساس ثنایاهای دائمی حدود ۱۵ تا ۳۰ ماهگی است"
                }
              ]
            },
            {
              "tag": "text",
              "text": " — دقیقاً همان سنی که کودک خمیردندان را قورت می‌دهد و مکمل تجویز می‌شود."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نمای بالینی:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " از خطوط سفید ظریف تا لکه‌های منتشر، و در موارد شدید تغییر رنگ قهوه‌ای و کندگی سطحی."
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نشانه‌ی افتراقی کلیدی:"
                }
              ]
            },
            {
              "tag": "text",
              "text": " فلوروزیس "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قرینه"
                }
              ]
            },
            {
              "tag": "text",
              "text": " است و دندان‌های هم‌زمان‌ساز را با هم درگیر می‌کند، با مرزهای "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "محو"
                }
              ]
            },
            {
              "tag": "text",
              "text": ". در برابرش MIH نامتقارن است و مرزهای "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تیز و مشخص"
                }
              ]
            },
            {
              "tag": "text",
              "text": " دارد."
            }
          ]
        },
        {
          "tag": "figure",
          "attributes": {},
          "children": [
            {
