            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک نکته‌ی اجرایی مهم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در همان دقایق اول سفت شدن به رطوبت حساس است. سطح ترمیم باید بلافاصله با پوشش محافظ ایزوله شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه نوع رایج:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "معمولی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — پایه‌ی همه‌ی ویژگی‌های بالا"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تقویت‌شده با رزین"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — استحکام و کارپذیری بهتر، همچنان فلوراید آزاد می‌کند"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "با ویسکوزیته‌ی بالا"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — ماده‌ی انتخابی در ITR و ART"
