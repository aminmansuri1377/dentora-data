      "prompt": "",
      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "مینا نازک‌تر، پالپ نزدیک‌تر"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در دندان شیری، لایه‌ی مینا و عاج به‌مراتب "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نازک‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از دندان دائمی است؛ یعنی پالپ از سطح فاصله‌ی کمتری دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شاخ‌های پالپ بلندترند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و بلندترینشان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مزیوباکال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است — دقیقاً همان‌جایی که فرز هنگام تراش اکلوزال وارد می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو پیامد مستقیم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عمق تراش باید کمتر باشد، و بی‌احتیاطی در گوشه‌ی مزیوباکال زودتر از هر جای دیگری به پالپ می‌رسد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک تفاوت مهم دیگر:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کف اتاقک پالپ نازک است و کانال‌های فرعی به ناحیه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فورکا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " راه دارند. به همین دلیل عفونت دندان شیری اغلب به‌جای نوک ریشه، خودش را در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فورکا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نشان می‌دهد."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/f18-13c9f597e971508e.webp",
