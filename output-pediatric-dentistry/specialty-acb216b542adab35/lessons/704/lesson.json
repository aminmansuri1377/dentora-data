          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تماس پهن، گردن باریک"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تماس پروگزیمال در دندان شیری پهن و مسطح است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، نه نقطه‌ای مثل دندان دائمی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو پیامد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پوسیدگی بین‌دندانی در معاینه‌ی بالینی دیر دیده می‌شود و به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رادیوگرافی بایت‌وینگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیاز دارد؛ و ماتریکس باید همان تماس پهن را بازسازی کند، نه یک نقطه."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باریک شدن ناحیه‌ی گردن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و برجستگی مشخص سرویکال، دو نکته‌ی عملی می‌سازد: باند ماتریکس باید خوب به گردن دندان بچسبد، و همین برجستگی است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "روکش استیل را در جای خود قفل می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تاج کوتاه‌تر و سطح اکلوزال باریک‌تر است — پس فضای کمتری برای خطا داری."
                }
              ]
            }
          ]
        }
      ],
