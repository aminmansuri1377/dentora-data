                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تمیز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، کاملاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خشک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نور خوب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". ضایعه‌ی سفید مات روی سطح خشک، اولین علامت است و نباید با سوند تیز کاوش شود."
