      "content": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ترتیب معاینه: از بیرون به داخل"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترتیب فقط نظم نیست؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کم‌تهاجمی‌ترین کار اول"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام می‌شود تا اعتماد ساخته شود:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "خارج‌دهانی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تقارن صورت، تورم، غدد لنفاوی، مفصل گیجگاهی-فکی، لب‌ها و پوست اطراف دهان."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بافت نرم داخل‌دهانی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " مخاط، لثه، زبان، کف دهان، فرنوم‌ها، لوزه‌ها."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بافت سخت:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " دندان‌ها، پوسیدگی، اکلوژن و فضاها."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا این ترتیب؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لمس صورت و غدد لنفاوی برای کودک تهدیدآمیز نیست و فرصت می‌دهد به تو عادت کند. اگر از آینه در دهان شروع کنی، بخش سخت را اول انجام داده‌ای."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در شیرخوار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " همه‌ی این‌ها در وضعیت "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زانو به زانو"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انجام می‌شود."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/f07-e3c4345ba07c8110.webp",
