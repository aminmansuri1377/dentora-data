                {
                  "tag": "text",
                  "text": " ← "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کشیدن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            }
