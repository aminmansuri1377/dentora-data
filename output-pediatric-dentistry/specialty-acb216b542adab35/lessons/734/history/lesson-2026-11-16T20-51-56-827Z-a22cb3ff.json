              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سایر اولویت‌های بالاتر از دندان:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خون‌ریزی کنترل‌نشده، مشکوک بودن به شکستگی فک، آسیب گردن."
