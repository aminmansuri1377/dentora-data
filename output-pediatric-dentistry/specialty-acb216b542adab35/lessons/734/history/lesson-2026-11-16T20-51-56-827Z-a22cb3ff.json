                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک پرسش چهارم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان یا قطعه پیدا شده؟ در چه محیطی نگه‌داری شده؟"
                }
              ]
            },
