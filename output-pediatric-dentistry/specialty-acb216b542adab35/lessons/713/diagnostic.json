      "children": [
        {
          "tag": "text",
          "text": "دندانپزشکی ابتدا وسعت ضایعه را سنجیده، سپس ریسک را، و در آخر متوجه شده ایزولاسیون در این کودک ممکن نیست. پیامد این ترتیب چیست؟"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "div",
              "attributes": {},
              "children": [
