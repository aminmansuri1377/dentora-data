  "title": "درس ۴: عیب‌یابی شکست ترمیم",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "الگوی شکست را مثل گزارش بخوان"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "هر شکست ترمیمی یک "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "نشانی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " دارد؛ محل و شکل آن، مرحله‌ی خطا را لو می‌دهد:"
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تغییر رنگ مرزی + حساسیت"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← ریزنشت، از آلودگی رطوبتی یا تنش انقباضی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شکست از مارجینال ریج"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← مینای بدون تکیه‌گاه عاجی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شکست از وسط ایسموس"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← حجم ناکافی ماده در ایسموس (کم‌عمق یا بیش از حد باریک) یا زاویه‌ی اگزیوپالپال تیز"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "افتادن زودهنگام کل ترمیم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← آلودگی سطح آماده‌شده حین کار"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چرخیدن روکش"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← گیر محیطی از بین رفته"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گیر غذا"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← تماس پروگزیمال ناکافی"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "التهاب پایدار لثه"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " ← سمان باقی‌مانده، لبه‌ی اضافه، یا لبه‌ی بلند"
                    }
                  ]
                }
              ]
            }
          ]
        }
