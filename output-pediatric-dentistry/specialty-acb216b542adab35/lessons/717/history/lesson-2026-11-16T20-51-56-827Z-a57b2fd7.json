                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سطح درمان"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " عوض شود؟ شکست دوم ترمیم مستقیم، معمولاً یعنی وقت پوشش کامل است."
                        }
                      ]
                    }
                  ]
                }
              ]
