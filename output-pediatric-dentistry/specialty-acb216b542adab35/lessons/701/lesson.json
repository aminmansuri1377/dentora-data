                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نخستین ویزیت دندانپزشکی تا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک‌سالگی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، یا حداکثر تا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شش ماه پس از رویش اولین دندان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — هرکدام زودتر رسید."
