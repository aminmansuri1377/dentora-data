  "title": "درس ۲: آنومالی‌های اندازه و شکل",
  "content": [
    {
      "tag": "h1",
      "attributes": {},
      "children": [
        {
          "tag": "text",
          "text": "یکی یا دو تا؟ قانون شمارش"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه وضعیت که در ظاهر شبیه‌اند اما منشأ متفاوتی دارند:"
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جمینیشن (دوقلویی):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " یک جوانه تلاش کرده دو نیم شود — یک ریشه، تاج دوشاخه."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "فیوژن (اتصال):"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " دو جوانه‌ی جدا به هم چسبیده‌اند — معمولاً یک دندان از تعداد کم می‌آید."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کنکرسانس:"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " اتصال فقط از راه "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "سمان"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " و "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "پس از"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " تشکیل ریشه — عاج مشترک نیست."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "children": [
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "قانون شمارش (ساده‌ترین راه تفکیک):"
                }
              ]
            },
            {
              "tag": "text",
              "text": " دندان‌های آن نیم‌فک را بشمار و دندان غیرعادی را "
            },
            {
              "tag": "strong",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یکی"
                }
              ]
            },
            {
              "tag": "text",
              "text": " حساب کن."
            }
          ]
        },
        {
          "tag": "ul",
          "attributes": {},
          "children": [
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعداد "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "طبیعی"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شد ← جمینیشن"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "li",
              "attributes": {},
              "children": [
                {
                  "tag": "p",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعداد "
                    },
                    {
                      "tag": "strong",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "یکی کم"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": " شد ← فیوژن"
                    }
                  ]
                }
              ]
            }
          ]
        }
