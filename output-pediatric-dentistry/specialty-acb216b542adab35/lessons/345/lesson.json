                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فاز نگهدارنده:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ویزیت‌های دوره‌ای با فاصله‌ی مبتنی بر ریسک."
