                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فاز ترمیمی و بازسازی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " درمان‌های قطعی، پالپ‌درمانی، روکش، مدیریت فضا."
