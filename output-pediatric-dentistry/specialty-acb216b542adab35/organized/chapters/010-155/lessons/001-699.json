      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "قندهای پنهان و توصیه‌های عملی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "خانواده‌ها معمولاً شکلات و آبنبات را می‌شناسند، ولی این‌ها را قند به حساب نمی‌آورند:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آبمیوه، شیر طعم‌دار، میوه‌ی خشک، بیسکویت و کراکر، نان و چیپس."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کربوهیدرات‌های نشاسته‌ای هم در دهان تجزیه و به قند تخمیرپذیر تبدیل می‌شوند، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مواد چسبنده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مدت تماس را طولانی‌تر می‌کنند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهار توصیه‌ی عملی:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "شیشه‌ی شیر در تخت ممنوع؛ اگر لازم است، فقط "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "آب"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لیوان سرپوش‌دار ابزار جرعه‌جرعه نوشیدن تمام‌روز نیست."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "میان‌وعده‌ها را در "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ساعت‌های مشخص"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " بگذار، نه به‌صورت پیوسته."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "در کودک پرریسک، "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "یادداشت رژیم سه‌روزه"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " بگیر — الگوی واقعی را نشان می‌دهد، نه آنچه والدین به یاد می‌آورند."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
