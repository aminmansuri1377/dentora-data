      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "محافظ دهانی و دو هشدار"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "محافظ دهانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در ورزش‌های برخوردی هم دندان‌ها را حفظ می‌کند هم بافت نرم را. ترتیب کیفیت روشن است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ساخته‌شده در مطب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بهتر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوع جوشاندنی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و هر دو بهتر از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوع آماده‌ی استاندارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بهترین محافظ آن است که کودک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "واقعاً می‌پوشد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ اگر تنگ یا آزاردهنده باشد، در کیف می‌ماند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هشدار اول — سوختگی گوشه‌ی لب:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نوپایی که سیم برق را گاز می‌گیرد دچار سوختگی کمیسور می‌شود. نکته‌ی حیاتی این است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خون‌ریزی شدید معمولاً یک تا سه هفته بعد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و هنگام جدا شدن دلمه رخ می‌دهد. خانواده باید از قبل بداند و آموزش فشار مستقیم ببیند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هشدار دوم — نگهداری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خمیردندان، دهانشویه و مکمل فلوراید باید مثل دارو، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خارج از دسترس کودک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نگهداری شوند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
