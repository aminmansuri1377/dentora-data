      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دندان‌درآوردن: چه هست و چه نیست"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علائم واقعی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بی‌قراری، آبریزش دهان، حساسیت لثه و تمایل به گاز گرفتن اشیا. گاهی افزایش دمای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مختصر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنچه به دندان‌درآوردن نسبت داده می‌شود ولی از آن نیست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تب بالا، اسهال، و استفراغ. این‌ها باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "علت دیگری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برایشان جست‌وجو شود — نسبت دادنشان به دندان می‌تواند تشخیص یک عفونت را به تأخیر بیندازد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مدیریت ایمن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ماساژ لثه با انگشت تمیز و دندانگیر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خنک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (نه یخ‌زده)."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دو چیز که باید از آن‌ها پرهیز کرد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ژل‌های بی‌حس‌کننده‌ی موضعی حاوی بنزوکایین در شیرخوار — به دلیل خطر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مت‌هموگلوبینمی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گردنبندهای دندان‌درآوردن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، به دلیل خطر خفگی و بند آمدن نفس."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:fbee99ea34b4814651ce65b56b99fcda4d6fe77fc29bbf358943ca98a3a7b6d0",
      "sourceId": null,
