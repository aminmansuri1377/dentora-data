                    {
                      "tag": "text",
                      "text": "شش ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و در کودک پرریسک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کوتاه‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — معمولاً هر سه ماه."
                }
              ]
