      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ویزیت اول: تا یک‌سالگی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نخستین ویزیت دندانپزشکی تا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک‌سالگی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، یا حداکثر تا "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شش ماه پس از رویش اولین دندان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — هرکدام زودتر رسید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا این‌قدر زود؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چون در این سن هنوز چیزی برای درمان نیست و همه‌چیز برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیشگیری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است: ارزیابی ریسک، اصلاح تغذیه، آموزش مسواک، و شروع فلوراید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مزیت دوم کمتر دیده می‌شود ولی مهم‌تر است: کودک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از تجربه‌ی درد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با مطب آشنا می‌شود. اولین خاطره‌ی دندانپزشکی‌اش یک معاینه‌ی کوتاه است، نه یک درمان اورژانسی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خانه‌ی دندانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یعنی یک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رابطه‌ی مستمر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، نه یک ویزیت منفرد: مرجعی ثابت و در دسترس که سابقه‌ی کودک را می‌داند و خانواده در هر مشکلی می‌داند به کجا مراجعه کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
