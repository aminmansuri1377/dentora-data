    {
      "id": "theory:cddc9f5bcd9e5a7e10d571dbcb18a116dc64ed54b569cc8e481379d8ac15c5d7",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "a134c67a453ddc6649eab3cd207aba0366802fa491191c31777fe845adb59309",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "از اولین دندان، و به دست بزرگ‌تر"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شروع:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مسواک زدن از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رویش اولین دندان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آغاز می‌شود، دو بار در روز. پیش از آن، پاک کردن لثه با پارچه‌ی تمیز عادت را جا می‌اندازد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چه کسی مسواک می‌زند؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این پرسش مهم‌تر از آن چیزی است که به نظر می‌رسد. مهارت حرکتی کودک تا حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هفت تا هشت سالگی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای مسواک مؤثر کافی نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یعنی تا آن سن، مسواک زدن کار "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بزرگ‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است — و بعد از آن هم زیر نظارت ادامه می‌یابد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک معیار عملی برای والدین:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تا وقتی کودک نمی‌تواند بند کفشش را خودش ببندد، دستش برای مسواک مؤثر هم آماده نیست."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/f17b-b3380ac004322c1f.webp",
                  "alt": "مسواک کودک و مقدار خمیردندان",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/c351aa697100312504b8bc70d34a43eef8959a01d09f3253485761271828b8d0.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اندازه‌ی مسواک کودک و مقدار خمیردندان متناسب با سن، McDonald & Avery, "
                    },
                    {
                      "tag": "em",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Dentistry for the Child and Adolescent"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ", Ch. 8"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:add0f4c9b73aa4dd4271edaa585e463e4b618c6307a9c68e48511b63285f125b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "43c3ae48ababbc8e2da7a27c0227dedda7f5f614b6433810772528c9d7a6e18a",
      "position": 2,
      "kind": "theory",
