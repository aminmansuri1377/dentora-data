      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کودک درد را نمی‌گوید — نشان می‌دهد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ابزار سنجش درد را باید با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " انتخاب کنی، نه با سلیقه:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "زیر ۳ سال یا کودک غیرکلامی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " مقیاس رفتاری "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "FLACC"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — چهره، پاها، فعالیت، گریه، آرام‌پذیری. تو مشاهده می‌کنی، او نمی‌گوید."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "حدود ۳ تا ۷ سال:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " مقیاس چهره‌ها ("
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "Wong-Baker FACES"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": ") — کودک چهره‌ای را انتخاب می‌کند که حالش را نشان می‌دهد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۸ سال به بالا:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " مقیاس عددی ۰ تا ۱۰، مثل بزرگسال."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کودک ساکت لزوماً بدون درد نیست. سکوت در کودک می‌تواند نشانه‌ی "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تسلیم شدن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد، نه راحتی."
                }
              ]
            }
          ]
        }
      ],
