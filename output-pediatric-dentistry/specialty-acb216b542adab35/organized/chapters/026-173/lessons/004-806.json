            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یک ارجاع مفید، بیش از یک نام و شماره است. باید شامل این‌ها باشد:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یافته‌های معاینه با تاریخ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — به‌ویژه آنچه در طول زمان تغییر کرده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تصاویر موجود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و آنچه در آن‌ها دیده‌ای."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنچه انجام داده‌ای و پاسخ بیمار به آن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — این بخش اغلب فراموش می‌شود و ارزش زیادی دارد."
                }
              ]
            },
