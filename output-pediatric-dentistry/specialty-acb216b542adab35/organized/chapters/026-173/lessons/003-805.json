      "contentKey": "b6b3bcf6ecf13294baf9bcb98891f550e40a091292a1cb0c3adffe907b32fe9f",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چه چیزی می‌تواند مانع شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی دندانی نمی‌روید، فهرست موانع کوتاه و مشخص است:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان اضافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — شایع‌ترین آن‌ها مزیودنس است که میان ثنایاهای مرکزی بالا قرار می‌گیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "توده‌ی سخت مانند ادنتوم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که مسیر را می‌بندد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندان شیری تحلیل‌نرفته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که سر جای خود مانده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بافت فیبروز یا اسکار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی ناحیه‌ی رویش، مثلاً پس از جراحی یا تروما."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نشانه‌ی راهنما:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدم تقارن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". اگر همتای سمت مقابل بیش از حدود ۶ ماه پیش رویده و این یکی هنوز نیامده، دلیلی وجود دارد — و باید دنبالش گشت."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:bf3aee1c0dc96e82f14bb08e27ef47f18e80c6dadb45e0f08c8cb3ef2ab6a668",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "9ddcd69da6936c75bbc846e3dd9d40b5dc8daf0004c0d94e3b5a994befab7635",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تصمیم پس از یافتن مانع"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برداشتن مانع به‌تنهایی کافی نیست؛ باید پرسید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آیا دندان پس از آن خودش می‌رویَد؟"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شانس رویش خودبه‌خودی بیشتر است وقتی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضای کافی در قوس موجود باشد، ریشه‌ی دندان هنوز کامل نشده باشد، و موقعیت دندان چندان منحرف نباشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و کمتر است وقتی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فضا از دست رفته باشد، ریشه کامل شده باشد، یا دندان به‌شدت منحرف باشد — که در آن صورت ممکن است به کشش ارتودنتیک نیاز شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس تصمیم دو بخشی است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برداشتن مانع، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برنامه‌ی رویش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — که شامل حفظ یا بازیابی فضا هم می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
