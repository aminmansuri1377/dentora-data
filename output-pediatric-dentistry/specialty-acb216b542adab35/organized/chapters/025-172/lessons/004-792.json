          "children": [
            {
              "tag": "text",
              "text": "مدیریت عادت — ترتیب درست"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترتیب مداخله، از کم‌ترین فشار به بیشترین است:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱. گفت‌وگو و آگاه‌سازی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با خودِ کودک، به زبان قابل فهم — چون "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "همکاری کودک شرط موفقیت است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲. یادآورهای ملایم و تشویق:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ثبت روزهای موفق، توجه مثبت، و حمایت خانواده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳. وسیله‌ی یادآورنده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فقط زمانی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودک خودش می‌خواهد ترک کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ولی نمی‌تواند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هشدار جدی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سرزنش، تنبیه و شرمنده کردن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اثر معکوس دارند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — عادت را تشدید می‌کنند و رابطه‌ی درمانی را از بین می‌برند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "و وسیله‌ای که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدون خواست کودک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گذاشته شود، اغلب شکست می‌خورد یا به تجربه‌ای آزارنده تبدیل می‌شود."
                }
              ]
            },
