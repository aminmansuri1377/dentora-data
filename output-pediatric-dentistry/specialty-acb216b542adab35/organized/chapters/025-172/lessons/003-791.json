      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چه چیزی اثر را تعیین می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اثر عادت مکیدن بر اکلوژن به سه چیز بستگی دارد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعداد دفعات، مدت هر بار، و شدت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و از میان این سه، مدت مجموع روزانه مهم‌ترین است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " عادتی که چند ساعت پیوسته ادامه دارد — مثلاً هنگام خواب — اثر بیشتری از مکیدن کوتاه و پرشدت دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تغییرات معمول:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اپن‌بایت قدامی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، افزایش فاصله‌ی افقی دندان‌های قدامی، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باریک شدن قوس بالا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که می‌تواند به کراس‌بایت خلفی بینجامد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "باریک شدن قوس از فشار عضلات گونه هنگام مکیدن می‌آید — پس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک عادت، هم اثر عمودی دارد و هم عرضی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
