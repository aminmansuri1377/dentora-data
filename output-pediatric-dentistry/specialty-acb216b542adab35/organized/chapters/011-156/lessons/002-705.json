      "contentKey": "a33001c2348070543df77b8f6a1b1d9a4965d6ec8ff65630be1c9500938d27bd",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چهار فایده، یکی از همه مهم‌تر"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "رابردم در کودک چهار کار هم‌زمان می‌کند:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کنترل رطوبت"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — شرط موفقیت هر ترمیم چسبنده‌ای."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "محافظت از راه هوایی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — جلوی بلعیده یا استنشاق شدن ابزار و مواد را می‌گیرد. "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "در کودک این فایده وزن ویژه‌ای دارد"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": "، چون کودکِ درازکشیده روی یونیت ممکن است ابزار یا ماده را ببلعد یا استنشاق کند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کنار نگه داشتن زبان و گونه"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — هم ایمنی بیشتر، هم دید بهتر."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کمک رفتاری"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — کودک ابزار را نمی‌بیند و آب و مواد به دهانش نمی‌ریزد؛ همین اضطراب را کم می‌کند."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بیشتر ترمیم‌های کودکان، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایزوله کردن همان یک دندان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کافی است و کار را سریع‌تر می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:4aefaa7ccc71356bf1a0f16f7a7408dd88ef6aacd840c255eae210a38acca7ba",
      "sourceId": null,
      "identityOrigin": "local-step",
