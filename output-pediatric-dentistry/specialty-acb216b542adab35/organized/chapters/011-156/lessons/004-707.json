      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "ماتریکس مناسب و سه کار وج"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ماتریکس‌های بزرگسال اغلب برای تاج کوتاه و باریک دندان شیری "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حجیم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "اند. در کودکان معمولاً از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نوار T"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا ماتریکس‌های محیطی کوچک استفاده می‌شود، و برای کامپوزیت، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماتریکس سکشنال همراه رینگ"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وج سه کار هم‌زمان انجام می‌دهد:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مارجین جینجیوال را "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سیل"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " می‌کند تا ماده بیرون نزند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "از ایجاد "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "لبه‌ی اضافه"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " (اورهنگ) جلوگیری می‌کند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کمی "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "جدایی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ایجاد می‌کند تا پس از برداشتن ماتریکس، تماس محکم بماند."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "بدون وج، هر سه این‌ها از دست می‌روند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:f31a5467da3b954de75e4189a3e8a7ebd0aa82521fc0cdac04dfc14ee03c6b68",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5e55b5a4c1ee639df800c3950888a741e12bdc580898dc420e8b6ada0562883d",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تماس پهن، و بررسی‌ای که فراموش می‌شود"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هدف بازسازی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تماس پهن و مسطح"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه یک نقطه. برای همین باند ماتریکس باید در ناحیه‌ی تماس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برنیش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شود تا فرم درست پیدا کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از پایان کار، تماس را با نخ دندان بررسی کن."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نخ باید با مقاومت خفیف عبور کند: اگر آزادانه رد شد، تماس ناکافی است؛ اگر پاره یا گیر کرد، لبه‌ی اضافه وجود دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا این چند ثانیه ارزش دارد؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تماس ناکافی یعنی گیر غذا و پوسیدگی ثانویه؛ لبه‌ی اضافه یعنی محل تجمع دائمی پلاک. هر دو چند ماه بعد به‌صورت یک ترمیم مجدد برمی‌گردند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
