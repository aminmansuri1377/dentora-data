  "steps": [
    {
      "id": "theory:52854e3bac98f72882799bd063aa4f5036d6777722c0cc968623ffda60db2451",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "c569bbb3117f26adcc2c755399acecf7268d3ab21d872b894dbf5af6220fd05d",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه سؤال، به همین ترتیب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در برابر هر دندان پوسیده، سه سؤال را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به ترتیب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بپرس:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "علامت‌دار است یا پالپ درگیر است؟"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " اگر بله، مسیر به درمان پالپ یا کشیدن می‌رود و هیچ روش حداقل‌تهاجمی جایش را نمی‌گیرد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کاویتاسیون دارد؟"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " اگر نه، سیلانت و فلوراید کافی‌اند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "چقدر وسیع است؟"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ضایعه‌ی محدود ← ترمیم معمول یا ITR، ضایعه‌ی وسیع در مولر شیری ← روکش یا روش هال."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترتیب مهم است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر سؤال اول را نپرسی، ممکن است روی دندانی که به درمان پالپ نیاز دارد سیلانت یا روکش بگذاری."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:8413cd63c88737f9f79c6660464fb43cf31c0691f1f4cd84eb32bbe1e3ead74b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "b01d11bf69a4547edcfc8b39fa7b7bdb105c6cd8bab41bbeb07e4886fdd84c16",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چهار عاملی که تصمیم را تعدیل می‌کنند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دو دندان با ظاهر یکسان می‌توانند دو درمان متفاوت بگیرند، چون این چهار عامل فرق می‌کنند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "عمر باقی‌مانده‌ی دندان"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — مولر شیری‌ای که تا یک سال دیگر می‌افتد، سرمایه‌گذاری متفاوتی می‌طلبد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ریسک پوسیدگی بیمار"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — در کودک پرریسک، ترمیم‌های حاشیه‌دار زودتر شکست می‌خورند و پوشش کامل ارجح می‌شود."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "توان همکاری کودک"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — روشی که کودک تحملش نمی‌کند، روی کاغذ خوب است و در دهان بی‌فایده."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "دسترسی خانواده به مراقبت"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — اگر پیگیری منظم ممکن نیست، درمانی را انتخاب کن که به مراجعات مکرر وابسته نباشد."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جمع‌بندی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بهترین درمان آن نیست که در متن درسی بهترین است؛ آن است که برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "این کودک، این دندان و این خانواده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بهترین است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
