          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دو فک، دو ترتیب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ترتیب رویش در دو فک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یکسان نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ":"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فک پایین:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " مولر اول ← ثنایای مرکزی ← ثنایای جانبی ← "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کانین"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ← پرمولر اول ← پرمولر دوم ← مولر دوم"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فک بالا:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " مولر اول ← ثنایای مرکزی ← ثنایای جانبی ← پرمولر اول ← پرمولر دوم ← "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کانین"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ← مولر دوم"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تفاوت حیاتی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کانین فک پایین "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پرمولرها می‌آید، اما کانین فک بالا "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پس از"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هر دو پرمولر — یعنی تقریباً آخرین دندان قدامی که جا می‌گیرد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا مهم است؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کانین بالا دیرتر می‌رسد و فضای باقی‌مانده را می‌گیرد؛ اگر فضا تنگ باشد، نهفته می‌ماند. به همین دلیل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نهفتگی کانین بالا شایع‌ترین نهفتگی پس از دندان عقل است"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "دوره‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دندانی مختلط"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — که دندان شیری و دائمی با هم در دهان‌اند — تقریباً از ۶ تا ۱۲ سالگی طول می‌کشد."
                }
              ]
            }
          ]
        }
      ],
