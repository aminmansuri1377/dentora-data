  "steps": [
    {
      "id": "theory:c729084dfac3a41fc3c24989e62a036f180a44553ea7fa9e65d0737264eff0fa",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "e8fee43a6c5474974ef452e9ee8c6a5c111a372ee8b15effa2384449fc75ea2a",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "معاینه، و یک اشتباه رایج"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "آنچه باید ببینی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تورم داخل و خارج دهانی، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سینوس تراکت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روی لثه، حساسیت به دق، تغییر رنگ تاج (خاکستری با نکروز می‌خواند)، وضعیت لثه‌ی اطراف."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و اما اشتباه رایج:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لقی دندان دو معنای کاملاً متفاوت دارد."
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لقی فیزیولوژیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — از تحلیل طبیعی ریشه می‌آید، دندان نزدیک افتادن است، و هیچ نشانه‌ی التهابی همراهش نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لقی پاتولوژیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — از تخریب استخوان اطراف به دلیل عفونت می‌آید، و معمولاً با تورم، سینوس تراکت یا حساسیت به دق همراه است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تفکیک این دو فقط با نگاه به خود دندان ممکن نیست؛ به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سن، رادیوگرافی و نشانه‌های همراه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نیاز داری."
                }
              ]
            },
            {
              "tag": "figure",
              "attributes": {},
              "children": [
                {
                  "tag": "img",
                  "src": "https://app.dentigoapp.com/storage/slides/attachments/f22-e26808b1392fcdbd.webp",
                  "alt": "رادیوگرافی تحلیل داخلی پس از پالپوتومی",
                  "attributes": {
                    "width": "",
                    "height": ""
                  },
                  "assetPath": "assets/91efaba41c928cc1f1e31facc99e41a885d1faf6a1a5324d6ee2a177237a8cf9.webp"
                },
                {
                  "tag": "figcaption",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تحلیل داخلی در مولر دوم شیری — نشانه‌ی شکست درمان پالپ، McDonald & Avery, "
                    },
                    {
                      "tag": "em",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "Dentistry for the Child and Adolescent"
                        }
                      ]
                    },
                    {
                      "tag": "text",
                      "text": ", Fig. 14.28"
                    }
                  ]
                }
              ]
            }
          ]
        }
