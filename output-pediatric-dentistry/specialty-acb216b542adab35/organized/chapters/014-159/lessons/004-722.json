              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پس از تعیین وضعیت پالپ، چهار عامل می‌توانند تصمیم را جابه‌جا کنند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "قابل ترمیم بودن دندان"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — اگر پس از درمان پالپ نتوان دندان را بازسازی کرد، درمان پالپ بی‌معناست."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "میزان تحلیل ریشه"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — تحلیل گسترده، پالپکتومی را بی‌فایده و کشیدن را منطقی می‌کند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "خطر برای جوانه‌ی دندان دائمی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — عفونت پایدار می‌تواند به مینای دندان جانشین آسیب بزند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "وضعیت سیستمیک کودک"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — در برخی شرایط پزشکی، حفظ دندان عفونی پرخطرتر از کشیدن آن است."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی کلی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تشخیص وضعیت پالپ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقطه‌ی شروع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است، نه پایان تصمیم."
                }
              ]
            }
          ]
        }
      ],
