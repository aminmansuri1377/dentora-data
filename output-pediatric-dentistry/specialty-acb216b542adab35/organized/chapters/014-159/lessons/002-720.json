      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "پرسشی که مسیر تشخیص را روشن می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مهم‌ترین پرسش در شرح حال درد کودک این است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد تحریکی است یا خودبه‌خودی؟"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد تحریکی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — با شیرینی، سرما یا فشار جویدن شروع می‌شود و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "با برداشتن محرک می‌خوابد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". این الگو با التهاب "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برگشت‌پذیر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌خواند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "درد خودبه‌خودی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — بدون محرک شروع می‌شود، ادامه می‌یابد، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کودک را از خواب بیدار می‌کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". این الگو با التهاب "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برگشت‌ناپذیر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌خواند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه سؤال عملی از والدین:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شب‌ها بیدار می‌شود؟ مسکن داده‌اید و اثر کرد؟ از سمت درگیر غذا می‌خورد؟"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پاسخ این سه، معمولاً بیش از هر تستی مسیر درمان را روشن می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
