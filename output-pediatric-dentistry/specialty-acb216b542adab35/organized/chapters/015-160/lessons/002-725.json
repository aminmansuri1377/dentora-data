                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بلافاصله بازسازی نهایی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شود؛ ترمیم موقت طولانی، نشت و شکست می‌سازد."
                }
              ]
            },
            {
