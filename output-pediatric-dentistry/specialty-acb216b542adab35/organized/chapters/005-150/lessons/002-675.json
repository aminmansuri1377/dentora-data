          "children": [
            {
              "tag": "text",
              "text": "فضای لی‌وی: سرمایه‌ی پنهان قوس"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مجموع عرض "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانین + مولر اول + مولر دوم شیری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از مجموع عرض جانشین‌هایشان ("
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کانین + پرمولر اول + پرمولر دوم دائمی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ") "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. این مازاد را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فضای لی‌وی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌نامند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "در فک "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "پایین"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": ": حدود "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۱٫۷ میلی‌متر در هر سمت"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "در فک "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بالا"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": ": حدود "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۰٫۹ میلی‌متر در هر سمت"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "یعنی فضای لی‌وی در فک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پایین تقریباً دو برابر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فک بالاست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "به چه درد می‌خورد؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با افتادن مولر دوم شیری، مولر اول دائمی به جلو حرکت می‌کند و این فضا را مصرف می‌کند — به این "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حرکت مزیالی دیررس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌گویند و همان چیزی است که رابطه‌ی مولری را به کلاس یک می‌رساند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هشدار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر مولر دوم شیری زودهنگام از دست برود، این سرمایه بدون برنامه خرج می‌شود و فضا برای پرمولر کم می‌آید."
                }
              ]
            }
          ]
        }
