      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "اردک زشت: مرحله‌ای که درمان نمی‌خواهد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۸ تا ۹ سالگی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، ثنایاهای دائمی بالا با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فاصله‌ی وسط"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و تاج‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متمایل به بیرون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رویش می‌یابند. والدین این را فاجعه می‌بینند؛ نامش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرحله‌ی اردک زشت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا رخ می‌دهد؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تاج کانین‌های دائمی که هنوز نروییده‌اند، به ریشه‌ی ثنایاهای جانبی فشار می‌آورد و تاج‌ها را به سمت دیستال می‌راند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سرنوشتش چیست؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با رویش کانین‌ها در حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۱ تا ۱۲ سالگی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، فشار برداشته می‌شود و فاصله "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خودبه‌خود بسته می‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی بالینی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیاستم میانی تا حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲ میلی‌متر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در این مرحله طبیعی است و درمان نمی‌خواهد. بستن زودهنگام آن، فضای لازم برای کانین را می‌گیرد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
