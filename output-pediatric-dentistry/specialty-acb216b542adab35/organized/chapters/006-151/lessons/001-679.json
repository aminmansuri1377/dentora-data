            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نام هر دندان اضافه از موقعیتش می‌آید:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مزیودنس در خط وسط فک بالا، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیستومولار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پشت آخرین مولر، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پارامولار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کنار مولرها در سمت باکال یا لینگوال."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا مهم است؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چون اغلب بی‌علامت می‌ماند تا وقتی دردسر بسازد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تأخیر یا توقف رویش ثنایای دائمی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "جابه‌جایی و چرخش دندان‌های مجاور"
