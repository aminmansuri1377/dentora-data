                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تحلیل ریشه‌ی دندان مجاور یا تشکیل کیست"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "وقتی دندان‌های اضافه‌ی متعدد دیدی، به سندرم فکر کن:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دیسپلازی کلیدوکرانیال (با نقص ترقوه) و سندرم گاردنر (با استئوم و پولیپ روده)."
                }
              ]
            }
          ]
        }
