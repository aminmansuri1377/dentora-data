                          ]
                        },
                        {
                          "tag": "text",
                          "text": " نبود مادرزادی "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "یک تا پنج"
