                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کامل"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " دندان‌ها — بسیار نادر."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شایع‌ترین دندان‌های غایب دائمی، به ترتیب:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " مولر سوم ← پرمولر دوم پایین ← ثنایای جانبی بالا ← پرمولر دوم بالا."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یک قاعده‌ی کلیدی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر دندان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شیری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " غایب باشد، جانشین دائمی‌اش هم معمولاً غایب است. عکسش صادق نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کِی به فکر سندرم باشیم؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اولیگودنشیا، به‌ویژه با دندان‌های مخروطی و موی تُنُک و کاهش تعریق ← "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیسپلازی اکتودرمال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            }
          ]
        }
      ],
