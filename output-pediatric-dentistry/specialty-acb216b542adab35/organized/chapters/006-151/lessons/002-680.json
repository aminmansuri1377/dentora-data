                      "text": "۰۱"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باید ابتدا ارزیابی ارتودنسی انجام شود؛ محل نهایی دندان و توزیع فضا باید مشخص شود، وگرنه ترمیم در جای نادرست و با ابعاد نامتناسب ساخته می‌شود"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۲"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایرادی ندارد؛ ترمیم مستقیم با کامپوزیت ساده‌ترین و کم‌هزینه‌ترین راه است و در همان جلسه هم فاصله بسته می‌شود هم ظاهر دندان اصلاح می‌شود و بیمار راضی بیرون می‌رود"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۳"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فقط باید رنگ کامپوزیت دقیق‌تر انتخاب شود"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۴"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "باید دندان کشیده و ایمپلنت گذاشته شود"
                    }
                  ]
                }
              ]
            }
          ]
        }
