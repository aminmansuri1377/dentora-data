      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "یکی یا دو تا؟ قانون شمارش"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه وضعیت که در ظاهر شبیه‌اند اما منشأ متفاوتی دارند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "جمینیشن (دوقلویی):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " یک جوانه تلاش کرده دو نیم شود — یک ریشه، تاج دوشاخه."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فیوژن (اتصال):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " دو جوانه‌ی جدا به هم چسبیده‌اند — معمولاً یک دندان از تعداد کم می‌آید."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کنکرسانس:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " اتصال فقط از راه "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سمان"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " و "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "پس از"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تشکیل ریشه — عاج مشترک نیست."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قانون شمارش (ساده‌ترین راه تفکیک):"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان‌های آن نیم‌فک را بشمار و دندان غیرعادی را "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یکی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حساب کن."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تعداد "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "طبیعی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " شد ← جمینیشن"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تعداد "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "یکی کم"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " شد ← فیوژن"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:4a748b8be00df541630e31d7aee98ddd17783f39032dd70f268692fae8d2c39f",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "ab4ce192b13f6d2b55a5ef5fb5005e4e096cf6aca5af657c190b219493f6d435",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "برجستگی‌ها و فرورفتگی‌هایی که پالپ را تهدید می‌کنند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "دنس اینواژیناتوس (دندان در دندان):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " فرورفتگی مینا به داخل دندان. شایع‌ترین محل "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ثنایای جانبی بالا"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " است. خطرش این است که یک راه باریک از سطح تا نزدیکی پالپ می‌سازد و "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "نکروز زودرس پالپ در دندانی که هنوز پوسیدگی ندارد"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ایجاد می‌کند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "دنس اواژیناتوس:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " برجستگی اضافه روی سطح جونده، بیشتر در "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "پرمولرها"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": ". با ساییده یا شکسته شدن، پالپ باز می‌شود."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تالون کاسپ:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " برجستگی اضافه در سمت زبانی دندان‌های قدامی."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تاورودنتیسم:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " اتاقک پالپ بزرگ و کشیده با محل دوشاخه‌شدن ریشه‌ها پایین‌تر از حد طبیعی؛ می‌تواند با سندرم داون و آملوژنزیس ایمپرفکتا همراه باشد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "دیلاسراسیون:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " خمیدگی تند ریشه یا تاج، معمولاً پیامد ضربه به دندان شیری پیش‌ساز که جوانه‌ی دائمی زیرین را جابه‌جا کرده است."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی بالینی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هر برجستگی یا شیار غیرعادی را زود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سیل کن"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "؛ ارزان‌ترین راه پیشگیری از یک پالپ‌درمانی زودرس همین است."
                }
              ]
            }
          ]
        }
      ],
