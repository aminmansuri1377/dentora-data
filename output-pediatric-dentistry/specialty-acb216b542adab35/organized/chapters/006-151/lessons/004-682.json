      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دنتینوژنزیس ایمپرفکتا: مینای سالم روی پایه‌ی معیوب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ظاهر بالینی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کهربایی تا خاکستری-آبی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با درخشش صدفی، و مینایی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ورقه‌ورقه کنده می‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — نه به این دلیل که خودش معیوب است، بلکه چون عاج زیرینش تکیه‌گاه لازم را نمی‌دهد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه‌گانه‌ی رادیوگرافیک:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "تاج‌های "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "برجسته"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " با تنگی مشخص در طوق"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "ریشه‌های "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کوتاه و باریک"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "محو شدن تدریجی اتاقک پالپ و کانال"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تا بسته شدن کامل"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه نوع:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نوع یک همراه با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استئوژنزیس ایمپرفکتا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (شکستگی مکرر استخوان، صلبیه‌ی آبی)، نوع دو مستقل و فقط دندانی، نوع سه با پالپ بسیار وسیع و باز شدن مکرر پالپ."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "همیشه بپرس:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سابقه‌ی شکستگی استخوان در کودک یا خانواده — همین یک سؤال نوع یک را از دو جدا می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:eaf8d87a3242085925faae99a64ea5f26b8969918d6bf21034cb1a0a650c4423",
