      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دیسپلازی عاجی و رنگ‌هایی که از داخل می‌آیند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیسپلازی عاجی نوع یک (ریشه‌ای):"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تاج‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کاملاً طبیعی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به نظر می‌رسند، اما ریشه‌ها بسیار کوتاه یا تقریباً غایب‌اند. نتیجه: لقی و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "افتادن زودرس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان‌ها بدون هیچ دلیل ظاهری."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دیسپلازی عاجی نوع دو (تاجی):"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شیری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " شبیه دنتینوژنزیس ایمپرفکتا می‌شوند، اما دندان‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دائمی رنگ طبیعی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دارند — با اتاقک پالپ کشیده و سنگ پالپ."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تغییر رنگ ذاتی با عامل بیرونی:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تتراسایکلین:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " نوارهای افقی زرد تا خاکستری؛ در "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "نور فرابنفش می‌درخشد"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": ". به همین دلیل در بارداری و در کودک زیر ۸ سال تجویز نمی‌شود."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بیلی‌روبین:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " رنگ "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سبز"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — نشانه‌ی زردی شدید نوزادی یا انسداد مجاری صفراوی."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رنگ ذاتی با جرم‌گیری و پالیش برطرف نمی‌شود؛ بسته به شدت، درمان از بلیچینگ طولانی‌مدت تا ونیر یا روکش است."
                }
              ]
            }
          ]
        }
      ],
