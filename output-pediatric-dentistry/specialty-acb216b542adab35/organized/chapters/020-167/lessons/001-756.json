            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تا حدود چهار ماه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " فقط شکستگی ریشه در ناحیه‌ی گردنی — ناپایدارترین حالت ممکن."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "الگو ساده است: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هرچه بافت سخت بیشتری درگیر باشد، اسپلینت طولانی‌تر."
