        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تغییر رنگ تاج — کدام نگران‌کننده است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تغییر رنگ پس از تروما به‌تنهایی تشخیص نیست؛ باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رنگ و روند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را با هم دید."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خاکستری تیره‌ی اولیه که طی هفته‌ها کم‌رنگ می‌شود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خون‌ریزی داخل عاج بوده و پالپ زنده مانده — پیگیری کافی است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خاکستری که پایدار می‌ماند یا تیره‌تر می‌شود:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " به نکروز مشکوک شو، به‌ویژه اگر با علامت یا یافته‌ی رادیوگرافیک همراه باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زرد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کلسیفیکاسیون کانال — پالپ زنده است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در دندان شیری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خاکستری تیره‌ی پایدار بیشتر با نکروز همراه است، ولی اگر علامت، تورم یا یافته‌ی رادیوگرافیک نباشد، باز هم فقط پیگیری می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هشدار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تغییر رنگ به‌تنهایی مجوز درمان ریشه نیست. تصمیم را بر پایه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مجموعه‌ی علائم، معاینه و رادیوگرافی در طول زمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بگیر."
                }
              ]
            }
          ]
        }
      ],
