      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فرانکل: یک عدد که کل جلسه را توصیف می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مقیاس "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فرانکل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رفتار کودک را در چهار درجه ثبت می‌کند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "درجه ۱ — کاملاً منفی (‎--‎):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " امتناع شدید، گریه‌ی بلند، مقاومت فیزیکی."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "درجه ۲ — منفی (‎-‎):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " بی‌میلی و عدم همکاری، اما بدون مقاومت شدید."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "درجه ۳ — مثبت (‎+‎):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " می‌پذیرد، با احتیاط همکاری می‌کند، دستور را دنبال می‌کند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "درجه ۴ — کاملاً مثبت (‎++‎):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ارتباط خوب، علاقه‌مند، خندان."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا ارزش دارد؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یک عدد در پرونده یعنی جلسه‌ی بعد می‌فهمی بهتر شده یا بدتر — و می‌توانی روش را بر همان اساس عوض کنی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرز عملی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درجه‌ی ۱ و ۲ یعنی کودک غیرهمکار؛ درجه‌ی ۳ و ۴ یعنی همکار."
                }
              ]
            }
          ]
        }
      ],
