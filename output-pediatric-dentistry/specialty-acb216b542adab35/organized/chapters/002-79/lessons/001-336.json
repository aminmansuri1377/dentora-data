          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این سه واژه را به‌جای هم به کار نبر:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ترس (Fear):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " واکنش به یک تهدید "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "حاضر و مشخص"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — همین سرنگ، همین صدا."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اضطراب (Anxiety):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " نگرانی از چیزی که "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "هنوز نیامده"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — از دیشب تا حالا دل‌شوره دارد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فوبیا (Phobia):"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ترس "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "شدید، پایدار و نامتناسب"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " که باعث اجتناب کامل می‌شود؛ یک تشخیص است، نه یک توصیف."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا مهم است؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اضطرابِ پیش از جلسه با آماده‌سازی و ویزیت آشناسازی کم می‌شود؛ ترسِ حین کار با تکنیک‌های همان لحظه. دارویشان یکی نیست."
                }
              ]
            }
          ]
        }
      ],
