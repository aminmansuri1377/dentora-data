    {
      "id": "theory:fec4d44ef20f1c51b8b185bf8ed4f0005217a92dd44468ae1774535edd10f15a",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f8961fe56c10e4f896cc64a950f52d7bfa1f8d87f5a7f1f710f2ac90f1c2b8d7",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا اکسید نیتروژن انتخاب اول است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سریع می‌آید، سریع می‌رود:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " شروع اثر حدود ۳ تا ۵ دقیقه، و بازگشت هم به همان سرعت."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "قابل تیتراسیون:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " غلظت را پله‌پله بالا می‌بری تا به نقطه‌ی مطلوب برسی — چیزی که با داروی خوراکی ممکن نیست."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سداسیون حداقلی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " کودک هوشیار می‌ماند، رفلکس‌های محافظتی و راه هوایی حفظ می‌شود و به گفت‌وگو پاسخ می‌دهد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سقف غلظت:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " حداکثر "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۵۰ درصد"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " اکسید نیتروژن؛ بقیه اکسیژن."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ای که نباید جا بیفتد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در پایان کار، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵ دقیقه اکسیژن ۱۰۰ درصد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بده. این کار از "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیپوکسی انتشاری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " جلوگیری می‌کند؛ اکسید نیتروژن به‌سرعت از خون به آلوئول برمی‌گردد و اگر اکسیژن ندهی، اکسیژن ریه را رقیق می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:9755d1afae1d123d835c29c19bf89d8a23891259ee04ba5f797196fb54e007a7",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "d027010001a6e067007429e1ae2b7cc27042f5afd18b8cd29a289cc45fad407c",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چه کسی نامزد اکسید نیتروژن نیست"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اکسید نیتروژن از راه بینی می‌رسد و در فضاهای بسته‌ی بدن پخش می‌شود. کنترااندیکاسیون‌ها از همین دو واقعیت می‌آیند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "انسداد بینی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " سرماخوردگی، آدنوئید بزرگ، انحراف تیغه — اگر از بینی نفس نکشد، دارو نمی‌رسد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "عفونت حاد یا جراحی اخیر گوش میانی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " گاز در فضای بسته تجمع می‌کند و فشار می‌آورد. همین منطق برای پنوموتوراکس و انسداد روده هم صادق است."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بارداری، به‌ویژه سه‌ماهه‌ی اول:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " در بیمار نوجوانِ باردار؛ کارکنان باردار هم نباید در معرض گاز نشتی باشند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "درمان با بلئومایسین"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " و "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کمبود ویتامین B12 یا نقص MTHFR:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " اکسید نیتروژن متابولیسم B12 را مختل می‌کند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اختلال شدید روانی یا رفتاری"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " که همکاری با ماسک را ناممکن می‌کند."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ایمنی شغلی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سیستم تخلیه‌ی گاز (Scavenging) و تهویه‌ی مناسب اجباری است؛ مواجهه‌ی مزمن کارکنان بی‌خطر نیست."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
