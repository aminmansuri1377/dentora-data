          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه قانون که تقویت مثبت را از تعارف به ابزار تبدیل می‌کند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۱) بلافاصله:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تحسینِ آخر جلسه تقریباً بی‌اثر است. همان لحظه بگو."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۲) مشخص:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " «چقدر خوب دهانت را ثابت نگه داشتی» بسیار قوی‌تر از «آفرین» است، چون می‌گوید "
                        },
                        {
                          "tag": "em",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کدام"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " رفتار را تکرار کند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۳) اجتماعی مقدم بر مادی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تحسین، لبخند و تشویق تیم اثر پایدارتری از استیکر و هدیه دارد. هدیه مکمل است، نه جایگزین."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هشدار درباره‌ی کنترل صدا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این تنها ابزار پایه‌ای است که ممکن است والدِ ناآگاه را جا بیندازد. "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیش از جلسه به والد توضیح بده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که ممکن است لحن صدایت را ناگهان تغییر دهی و دلیلش چیست."
                }
              ]
            }
          ]
        }
      ],
