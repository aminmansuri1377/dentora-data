            {
              "tag": "text",
              "text": "شش ابزاری که همیشه همراهت هستند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "Tell-Show-Do:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " توضیح ساده ← نمایش بی‌خطر ← اجرا، بدون فاصله و بدون غافلگیری."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تقویت مثبت:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تحسینِ "
                        },
                        {
                          "tag": "em",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "مشخص"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " بلافاصله پس از رفتار درست."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "انحراف توجه:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " جابه‌جا کردن توجه در لحظه‌ی ناخوشایند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کنترل صدا:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تغییر ناگهانی و کوتاه در لحن و بلندی صدا برای قطع رفتار مخرب."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ارتباط غیرکلامی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تماس چشمی، وضعیت بدن، لمس آرام‌کننده."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بپرس، بگو، بپرس:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " نگرانی‌اش را بپرس ← توضیح بده ← دوباره بپرس فهمید یا نه."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "این‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رضایت کتبی جداگانه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نمی‌خواهند و بخشی از ارتباط معمول درمانی‌اند — با یک استثنا که در اسلاید بعد می‌آید."
                }
              ]
            }
          ]
        }
      ],
