      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "خط بین پایه و پیشرفته"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "وقتی روش‌های پایه جواب ندهند و درمان هم قابل تعویق نباشد، سراغ روش‌های "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیشرفته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌رویم: مهار محافظتی، سداسیون، بیهوشی عمومی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تفاوت کلیدی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روش‌های پیشرفته "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رضایت آگاهانه‌ی کتبی و جداگانه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " لازم دارند؛ توضیح شفاهی کافی نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پیش از عبور از این خط، سه چیز را در پرونده مستند کن:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "کدام روش‌های پایه امتحان شدند و چرا شکست خوردند"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چرا درمان قابل تعویق نیست"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گزینه‌های جایگزین که با والد مطرح شد"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
