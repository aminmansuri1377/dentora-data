                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مجاز است وقتی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بیمار به کمک فوری نیاز دارد و حرکت کنترل‌نشده خطر آسیب دارد؛ یا در بیمار با نیازهای ویژه که همکاری ممکن نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ممنوع است وقتی:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیمار همکار است و فقط برای "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "راحتی یا سرعت کار تیم"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " می‌خواهی استفاده کنی"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "به‌عنوان "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تنبیه"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "بیمار شرایط پزشکی یا روانی دارد که مهار برایش خطرناک است"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حین اجرا، بدون استثنا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رضایت کتبی، محدودیت زمانی، پایش مداوم تنفس و گردش خون، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هیچ فشاری روی قفسه‌ی سینه و راه هوایی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، بازبینی دوره‌ای اندام‌ها، ثبت کامل در پرونده."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی تاریخی مهم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روش دست روی دهان (HOM) از سال ۲۰۰۶ از راهنمای AAPD "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حذف شده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و دیگر توصیه نمی‌شود."
                }
              ]
            }
          ]
        }
