      "contentKey": "ee4b97d18977b8288a51fc74ea2da77fc36f2d4843efed6c6f45c4e7c978da35",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تاریخچه‌ای که واقعاً برنامه را عوض می‌کند"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "تاریخچه‌ی طولانی به درد نمی‌خورد؛ تاریخچه‌ای به درد می‌خورد که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تصمیم تو را تغییر دهد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". پنج چیز که همیشه باید بپرسی:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "آلرژی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — دارو، لاتکس، غذا. مستقیماً روی انتخاب دارو و دستکش اثر دارد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بیماری قلبی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — نیاز به مشاوره و احتمال پروفیلاکسی آنتی‌بیوتیک."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اختلال خون‌ریزی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — کشیدن دندان و جراحی را کاملاً تغییر می‌دهد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "آسم و بستری‌های قبلی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — هم ریسک پزشکی، هم پیش‌بینی‌کننده‌ی رفتار."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "داروهای مصرفی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — از شربت‌های شیرین شبانه تا داروهای مؤثر بر بزاق."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک سؤال طلایی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " «تجربه‌ی پزشکی یا دندانی ناخوشایندی داشته؟» — این یک جمله، بیشترین اطلاعات رفتاری را می‌دهد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:2b95954a421575635fdac0874303c5ea219cba83fe83079fda7c4889146f4266",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "1dbae613f6905be5709daf2e780e648c8b2cbd3bcd941cffd677e093e8dc6a4a",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "با والد حرف بزن، نه علیه او"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "والدی که احساس سرزنش کند، اطلاعات را پنهان می‌کند و توصیه را اجرا نمی‌کند. سه قاعده:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۱) به‌جای متهم کردن، بپرس:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " «شب‌ها چطور می‌خوابد؟» به‌جای «چرا شیشه‌شیر شبانه می‌دهید؟»"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۲) واقعیت را بگو، اما بدون قضاوت:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " «این پوسیدگی‌ها از تماس مکرر با قند می‌آیند» — توصیف سازوکار، نه سرزنش فرد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۳) انتظار را از همان اول تنظیم کن:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تعداد جلسات، هزینه‌ی تقریبی، و اینکه چه چیزی به همکاری کودک بستگی دارد."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "یادت باشد:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در کودک، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "راویِ تاریخچه والد است نه بیمار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". اگر مراقب اصلی همراه نیست، اطلاعاتت ناقص است و باید در پرونده بنویسی."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
