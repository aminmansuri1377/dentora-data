      "answer": null
    },
    {
      "id": "theory:677d274795a5e266381bc705dc5b857a0687cffc543d9a96b2f46ec5565062f2",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "943d3e08cd02a149fdfdcd40f386771441869d0e6df480cb6b72cc65eb7c7c1b",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "دندان شیری با دائمی فرق دارد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "سه تفاوت ساختاری که تشخیص را عوض می‌کنند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "مینا و عاج نازک‌تر"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — فاصله‌ی تا پالپ کوتاه است، پس پوسیدگی سریع‌تر به پالپ می‌رسد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "شاخ پالپ بلندتر"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": "، به‌ویژه شاخ مزیوباکال مولرهای شیری — در تراش، خیلی زودتر از آنچه فکر می‌کنی به پالپ می‌رسی."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تماس‌های پهن و مسطح"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — پوسیدگی بین‌دندانی با چشم دیده نمی‌شود و لزوماً غذا هم گیر نمی‌کند."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه شرط دیدن پوسیدگی اولیه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تمیز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، کاملاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خشک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نور خوب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". ضایعه‌ی سفید مات روی سطح خشک، اولین علامت است و نباید با سوند تیز کاوش شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "الگوی هشدار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " پوسیدگی روی سطوح صاف ثنایای شیری بالا در کودک زیر ۳ سال، تا خلاف آن ثابت نشود، پوسیدگی زودرس کودکی (ECC) است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
