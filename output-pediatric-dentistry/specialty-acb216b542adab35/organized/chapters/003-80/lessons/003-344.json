        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "رادیوگرافی بر اساس ریسک، نه تقویم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قانون پایه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " رادیوگرافی فقط وقتی گرفته می‌شود که انتظار داشته باشی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نتیجه‌اش تصمیم درمانی را عوض کند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". هیچ رادیوگرافی روتینی صرفاً به دلیل گذشت زمان توجیه ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بایت‌وینگ خلفی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وقتی مطرح می‌شود که سطوح مجاور "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بسته شده باشند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و دیگر با چشم و پروب قابل بررسی نباشند."
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ریسک بالای پوسیدگی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " هر "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۶ تا ۱۲ ماه"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بدون ریسک بالا:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " هر "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۱۲ تا ۲۴ ماه"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پانورامیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای ارزیابی تکامل دندان‌ها، آنومالی‌ها، تروما و پاتولوژی است — نه ابزار غربالگری روتین."
                }
              ]
            }
          ]
        }
      ],
