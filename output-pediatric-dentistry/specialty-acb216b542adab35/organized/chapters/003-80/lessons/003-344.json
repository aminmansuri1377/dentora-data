      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کمترین پرتو ممکن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کودک نسبت به بزرگسال به پرتو "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حساس‌تر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است و عمر باقی‌مانده‌ی بیشتری برای بروز اثرات دارد. پس:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کولیماسیون مستطیلی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ناحیه‌ی پرتودهی را به‌شدت کم می‌کند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سنسور دیجیتال"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " و "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "اندازه‌ی متناسب با کودک"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — سنسور بزرگ هم دردناک است هم باعث تکرار عکس می‌شود."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "نگهدارنده‌ی فیلم"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " به‌جای انگشت کودک یا والد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "یقه‌ی تیروئید"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " دیگر به‌طور روتین توصیه نمی‌شود: محافظت اصلی کار کولیماسیون و تصویربرداری دیجیتال است، و یقه ممکن است جلوی پرتوی اصلی را بگیرد، عکس را خراب کند و تکرارش را لازم کند. برخی مقررات محلی هنوز آن را می‌خواهند."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "اصل "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ALARA"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " (کمترین مقدار منطقی ممکن) در اطفال به "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ALADAIP"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گسترش یافته است: کمترین دوزی که "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "از نظر تشخیصی قابل قبول"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " باشد، "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بر پایه‌ی اندیکاسیون"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "متناسب با همان بیمار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تکرار عکس، دو برابر کردن دوز است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بهترین راه کاهش پرتو، گرفتن یک عکس درست در بار اول است."
                }
              ]
            }
          ]
        }
      ],
