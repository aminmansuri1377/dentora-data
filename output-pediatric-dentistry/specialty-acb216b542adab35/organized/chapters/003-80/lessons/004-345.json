      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چهار فاز، به همین ترتیب"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فاز اورژانس:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " رفع درد و کنترل عفونت. هر چیز دیگری صبر می‌کند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فاز کنترل بیماری:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " متوقف کردن روند پوسیدگی — بهداشت، فلوراید، اصلاح رژیم، و ترمیم موقت ضایعات فعال بزرگ."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فاز ترمیمی و بازسازی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " درمان‌های قطعی، پالپ‌درمانی، روکش، مدیریت فضا."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فاز نگهدارنده:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ویزیت‌های دوره‌ای با فاصله‌ی مبتنی بر ریسک."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا ترتیب اهمیت دارد؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اگر بدون کنترل بیماری ترمیم کنی، همان ترمیم‌ها زیر همان شرایط دوباره پوسیده می‌شوند. ترمیم، پوسیدگی را درمان نمی‌کند؛ فقط نتیجه‌اش را پاک می‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:52dfd82f8b83f35cedcaf163ffe5ce96005044f1aff33b5daf8e947f7a912fde",
