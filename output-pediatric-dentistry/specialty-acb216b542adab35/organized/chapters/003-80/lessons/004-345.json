      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "طرح درمان کودک یک مخاطب اضافه دارد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "در بزرگسال، تصمیم‌گیرنده خودِ بیمار است. در کودک، طرح باید برای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "والد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ارائه و توسط او پذیرفته شود، در حالی که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مجری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بخش بزرگی از آن هم والد است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "هنگام ارائه‌ی طرح، چهار چیز را روشن بگو:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چه کاری، در چند جلسه"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "گزینه‌های جایگزین و پیامد "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "انجام ندادن"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " درمان"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "چه بخشی به همکاری کودک و چه بخشی به اجرای والد در خانه وابسته است"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "هزینه‌ی تقریبی"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فاصله‌ی ویزیت دوره‌ای بر پایه‌ی ریسک است، نه عادت:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ریسک بالا حدود هر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳ ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، ریسک متوسط و پایین حدود هر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۶ ماه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — و در ریسک پایین پایدار می‌توان بازه را بازتر کرد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
