      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "قوی، بادوام، و کم‌توقع"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "آمالگام سه نقطه‌ی قوت واقعی دارد که هنوز هم کسی منکرشان نیست:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استحکام و مقاومت به سایش بالا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — در نواحی تحت فشار جویدن سال‌ها دوام می‌آورد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تحمل شرایط غیرایده‌آل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — به اندازه‌ی کامپوزیت به رطوبت حساس نیست؛ یک لحظه بی‌دقتی، کل ترمیم را از بین نمی‌برد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سادگی اجرا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — نه اچ می‌خواهد نه باندینگ."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ولی سه ضعف دارد:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چسبنده نیست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، پس برای گیر به شکل خاصی از حفره نیاز دارد و همین یعنی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "برداشتن بافت سالم بیشتر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". زیبا نیست. و فلوراید هم آزاد نمی‌کند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
