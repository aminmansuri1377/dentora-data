      "contentKey": "ed25f5e45a4863bde5b0883e76ba2ea61c6ce15dd1f918e02b02cb794c7c7263",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چسبندگی شیمیایی و فلوراید"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "گلاس‌آینومر سه ویژگی دارد که به آن در دندانپزشکی کودکان جایگاه ویژه‌ای می‌دهد:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱. چسبندگی شیمیایی به مینا و عاج"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — پیوند یونی مستقیم برقرار می‌کند و به اچ کردن نیاز ندارد. یعنی یک مرحله‌ی حساس کمتر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۲. آزادسازی فلوراید"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — و مهم‌تر اینکه "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دوباره شارژ می‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ": از خمیردندان و وارنیش فلوراید می‌گیرد و بعداً آزاد می‌کند. یعنی مخزن فلورایدی که مدام دوباره پر می‌شود، درست در همان نقطه‌ی پرخطر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳. ضریب انبساط حرارتی نزدیک به دندان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — با گرم و سرد شدن، ماده و دندان تقریباً هم‌اندازه تغییر حجم می‌دهند و تنش کمتری در مرز ایجاد می‌شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:3ad57dcc7066552682a766bdaf3cafac30326fee096094edb0d025d39bf4a5cb",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "5c0e2e80fbffd8528e1339ce6d5ef82f05a5b03eb0e6bc447ff662aeebeada26",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "نقطه‌ی ضعف، و سه نوع"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقطه‌ی ضعف:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " استحکام و مقاومت به سایش کمتری از کامپوزیت و آمالگام دارد. برای همین در نواحی تحت فشار جویدن شدید و ترمیم‌های وسیع چندسطحی، انتخاب اول نیست."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک نکته‌ی اجرایی مهم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در همان دقایق اول سفت شدن به رطوبت حساس است. سطح ترمیم باید بلافاصله با پوشش محافظ ایزوله شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه نوع رایج:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "معمولی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — پایه‌ی همه‌ی ویژگی‌های بالا"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تقویت‌شده با رزین"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — استحکام و کارپذیری بهتر، همچنان فلوراید آزاد می‌کند"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "با ویسکوزیته‌ی بالا"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — ماده‌ی انتخابی در ITR و ART"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
