      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "انتخاب اندازه و حس نشستن"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی انتخاب:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کوچک‌ترین روکشی که عرض مزیودیستال دندان را بپوشاند."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روکش بزرگ‌تر راحت‌تر جا می‌رود، ولی گیر ندارد و لبه‌اش لثه را می‌آزارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حس درست هنگام امتحان:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " روکش باید با "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مقاومت خفیف"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از روی برجستگی سرویکال عبور کند و با یک حس «قفل شدن» بنشیند. اگر بی‌مقاومت سر خورد، بزرگ است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کریمپ کردن لبه‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — جمع کردن لبه‌ی روکش به سمت داخل — گیر را بیشتر و تطبیق لبه‌ای را بهتر می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "لبه‌ی روکش باید حدود نیم تا یک میلی‌متر "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زیر لبه‌ی لثه"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بنشیند تا از برجستگی سرویکال بگذرد و زیر آن قفل شود."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:9be3d5d189e8cae7d54c20c77e01068a40431aac4c8642f26ae7bd9521858071",
      "sourceId": null,
      "identityOrigin": "local-step",
