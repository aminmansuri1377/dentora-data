                  ]
                },
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اولی؛ چون فشار کمتری به لثه‌ی کودک وارد می‌کند و خطر سفیدی پایدار لثه را کم می‌کند"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {},
              "children": [
                {
                  "tag": "div",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۰۴"
