      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سمان، پاک‌سازی، و چک‌لیست نهایی"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سمان:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " گلاس‌آینومر — به رطوبت مقاوم‌تر است و فلوراید هم آزاد می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پاک‌سازی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سمان اضافی را کامل بردار و حتماً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فلاس بین‌دندانی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بکش. سمان باقی‌مانده زیر لثه، منبع التهاب پایدار است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهار معیار ارزیابی پیش از ترخیص:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "روکش "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تکان نمی‌خورد"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " و نمی‌چرخد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لبه‌ها صاف‌اند و با سوند گیر نمی‌کنند."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "اکلوژن قابل قبول است — بالا بودن مختصر طی چند هفته تنظیم می‌شود، ولی بالا بودن آشکار باید همان‌جا اصلاح شود."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "لثه لحظه‌ای سفید می‌شود و بلافاصله رنگش برمی‌گردد؛ سفیدی پایدار یعنی لبه بلند است."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
