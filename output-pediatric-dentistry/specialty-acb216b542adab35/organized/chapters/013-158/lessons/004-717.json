      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "علت را درمان کن، نه نشانه را"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خطای رایج:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تعویض ترمیم شکست‌خورده بدون اصلاح علت. نتیجه‌اش تکرار همان الگو است — این بار با بافت کمتر."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه پرسش پیش از هر ترمیم مجدد:"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "الگوی شکست به کدام "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "مرحله"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " اشاره دارد — تراش، ایزولاسیون، ماتریکس، یا انتخاب ماده؟"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آیا "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "محیط"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " عوض شده؟ اگر ریسک پوسیدگی همان است، ترمیم تازه هم همان سرنوشت را دارد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "آیا این بار باید "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سطح درمان"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " عوض شود؟ شکست دوم ترمیم مستقیم، معمولاً یعنی وقت پوشش کامل است."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترمیم یا تعویض؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نقص موضعی و محدود با مرزهای سالم را می‌توان ترمیم کرد؛ ولی نقص گسترده یا شکستِ ناشی از خطای طراحی، تعویض می‌خواهد نه وصله."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
