      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کِی روکش، نه ترمیم"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "روکش استیل وقتی انتخاب می‌شود که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ترمیم مستقیم دوام کافی ندارد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". اندیکاسیون‌های اصلی:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ضایعه‌ی وسیع چندسطحی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " در مولر شیری — هرچه سطوح درگیر بیشتر، مرزهای ترمیم بیشتر و شکست زودتر."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "پس از درمان پالپ"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — دندانی که پالپوتومی یا پالپکتومی شده، هم بافت زیادی از دست داده و هم شکننده‌تر است."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "نقایص تکاملی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " مانند هیپوپلازی شدید، آملوژنزیس ایمپرفکتا (AI) یا دنتینوژنزیس ایمپرفکتا (DI)."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "کودک پرریسک"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " با شکست‌های مکرر ترمیم."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "پایه‌ی فضانگهدار."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "منطق مشترک همه:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کم کردن تعداد مرزهایی که می‌توانند شکست بخورند."
                }
              ]
            }
          ]
        }
      ],
