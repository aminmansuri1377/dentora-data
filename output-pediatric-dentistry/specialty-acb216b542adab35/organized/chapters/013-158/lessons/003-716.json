              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۳. انتظار زیبایی خانواده"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — در ناحیه‌ی قدامی یک معیار واقعی است، نه ترجیح لوکس."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۴. توان همکاری کودک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — روشی که مراحل بیشتری دارد، در کودک بی‌قرار شانس اجرای درست کمتری دارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ویژگی خاص زیرکونیا:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تراش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بیشتری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌خواهد، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "کریمپ نمی‌شود"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و باید "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غیرفعال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بنشیند — یعنی نه قابل تنظیم است و نه با خون‌ریزی لثه سازگار."
                }
              ]
            }
          ]
        }
