          "children": [
            {
              "tag": "text",
              "text": "این ارزیابی دقیقاً چه چیزی را عوض می‌کند؟"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ارزیابی ریسک یک تمرین کاغذی نیست؛ نتیجه‌اش "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهار تصمیم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " را مستقیماً تغییر می‌دهد:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فاصله‌ی ویزیت دوره‌ای"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — پرریسک حدود سه ماه، کم‌ریسک شش ماه یا بیشتر."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "برنامه‌ی فلوراید"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — دفعات فلورایدتراپی موضعی و نوع خمیردندان."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فاصله‌ی بایت‌وینگ"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — شش تا دوازده ماه در برابر دوازده تا بیست‌وچهار ماه."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "آستانه‌ی تصمیم برای ترمیم"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — در کودک کم‌ریسک می‌توان ضایعه‌ی اولیه را پایش کرد؛ در پرریسک زودتر مداخله می‌کنی."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مهم‌ترین نکته:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ریسک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پویاست"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". کودکی که امسال پرریسک بوده می‌تواند سال بعد کم‌ریسک شود و برعکس. پس در "
                },
                {
                  "tag": "em",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ویزیت دوباره ارزیابی کن و تاریخش را بنویس."
                }
              ]
            }
          ]
        }
      ],
