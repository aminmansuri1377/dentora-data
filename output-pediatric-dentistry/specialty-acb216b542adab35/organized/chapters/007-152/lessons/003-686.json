      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه ستون ارزیابی ریسک"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ارزیابی ریسک یعنی وزن کردن سه دسته اطلاعات در برابر هم:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "عوامل خطر:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تماس مکرر با قند، تغذیه‌ی شبانه، پوسیدگی فعال مراقب، دسترسی محدود به درمان، نیازهای ویژه."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "عوامل محافظتی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " آب فلوراید‌دار، مسواک با خمیر فلوراید‌دار دو بار در روز، فلوراید موضعی منظم، داشتن خانه‌ی دندانی."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "یافته‌های بالینی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " ضایعه‌ی سفید، حفره، ترمیم در دو سال گذشته، پلاک قابل مشاهده، نقص مینا."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "قاعده‌ی وزن‌دهی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یافته‌های بالینی سنگین‌ترین وزن را دارند. وجود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حفره یا ضایعه‌ی سفید فعال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، به‌تنهایی کودک را در گروه پرریسک قرار می‌دهد — هرچقدر هم عوامل محافظتی خوب باشند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و قوی‌ترین پیش‌بینی‌کننده‌ی پوسیدگی آینده:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سابقه‌ی پوسیدگی گذشته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
