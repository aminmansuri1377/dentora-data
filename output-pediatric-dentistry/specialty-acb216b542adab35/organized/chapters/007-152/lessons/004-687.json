  "steps": [
    {
      "id": "theory:e60528e842fff46dfbb66b8ce6eac02fa0026568758cf93f333600525218c364",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "24103b2ad1b611aed6cd3a3d01f8dd9b7bee4f3bf448114ae59870eeb69daaee",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "کدهای صفر تا شش"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "ICDAS شدت ضایعه را با هفت کد، از ۰ تا ۶، ثبت می‌کند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۰"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — سطح سالم"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۱"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — اولین تغییر رنگ که "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فقط پس از خشک کردن طولانی"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " دیده می‌شود"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۲"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — تغییر رنگ واضح که "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "روی سطح مرطوب هم"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " دیده می‌شود"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۳"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — شکستگی موضعی مینا، "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بدون"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " دیده شدن عاج"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۴"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — سایه‌ی تیره‌ی عاج از زیر مینا"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۵"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — حفره‌ی مشخص با عاج قابل مشاهده"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۶"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " — حفره‌ی وسیع که بیش از نیمی از سطح را گرفته"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مرز تصمیم:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کدهای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱ و ۲"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بدون حفره‌اند و درمان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "غیرتهاجمی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " می‌گیرند؛ کدهای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۵ و ۶"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ترمیم می‌خواهند. کدهای ۳ و ۴ ناحیه‌ی قضاوت بالینی‌اند و تصمیم به ریسک بیمار بستگی دارد."
                }
              ]
            }
          ]
        }
      ],
