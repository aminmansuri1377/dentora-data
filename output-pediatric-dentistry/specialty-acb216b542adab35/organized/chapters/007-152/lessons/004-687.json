    {
      "id": "theory:6e98021b6613da909900cd02d39f7173f7a260d0f250316779bfee9147190fc4",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "616dc84392793c245a8ab9250095652c34d5ef0a3db8415026d45b2b08bf55be",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "فعال یا متوقف؟ سه نشانه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "شدت ضایعه یک چیز است و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "فعال بودنش"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چیز دیگری. این تفکیک، تصمیم درمانی را تعیین می‌کند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ضایعه‌ی فعال:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " سطح "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "مات و کدر"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": "، در لمس ملایم "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "زبر"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": "، و در ناحیه‌ی تجمع پلاک قرار دارد."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ضایعه‌ی متوقف‌شده:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " سطح "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "براق"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": "، "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "سخت و صاف"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": "، و اغلب قهوه‌ای یا سیاه — رنگ تیره اینجا نشانه‌ی خطر نیست، نشانه‌ی توقف است."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سه شرط معاینه‌ی درست:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تمیز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، کاملاً "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خشک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نور خوب"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ". بدون خشک کردن، کد ۱ اصلاً دیده نمی‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هشدار:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " از "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "سوند تیز"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " برای کاوش استفاده نکن. سطح دست‌نخورده‌ی ضایعه‌ی اولیه قابل بازسازی است و فشار سوند می‌تواند آن را برای همیشه بشکند. فقط از پروب سرگرد و با لمس ملایم استفاده کن."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
