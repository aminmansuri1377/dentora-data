          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "تعریف رسمی و الگوی شاخص"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تعریف ECC:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " وجود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حتی یک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " سطح پوسیده (با یا بدون حفره)، از دست رفته به دلیل پوسیدگی، یا ترمیم‌شده در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر دندان شیری"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، در کودک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زیر شش سال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "توجه کن که ضایعه‌ی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بدون حفره"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هم شمرده می‌شود — تعریف عمداً وسیع است تا مداخله زودتر شروع شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شکل شدید (S-ECC):"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " در کودک "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "زیر سه سال"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "، وجود پوسیدگی روی "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "هر سطح صافی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " کافی است. در سنین بالاتر، درگیری سطوح صاف دندان‌های قدامی بالا یا رسیدن شمارش به آستانه‌های مشخص."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "الگوی شاخص:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ثنایاهای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بالا"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " اول و شدیدتر درگیر می‌شوند، در حالی که ثنایاهای "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پایین"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نسبتاً سالم می‌مانند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هنگام مکیدن، زبان روی ثنایاهای پایین قرار می‌گیرد و آن‌ها را می‌پوشاند؛ ضمناً مجاری بزاقی زیرفکی درست همان‌جا تخلیه می‌شوند."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
