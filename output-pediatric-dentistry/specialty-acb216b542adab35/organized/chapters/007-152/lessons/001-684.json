  "steps": [
    {
      "id": "theory:6f487ff3e066179cc3e26f16afa45563732fb2ebe33594c5052a05f04c43f5cc",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "275017736ac34f8d2eb4927d2c45e129cf67257d283962d63825bfa5c747acb7",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چهار عامل و یک تعادل"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پوسیدگی وقتی رخ می‌دهد که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چهار عامل هم‌زمان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " حاضر باشند — نبود هرکدام، زنجیره را می‌شکند:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "میزبان و دندان:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " آناتومی شیارها، کیفیت مینا، و مهم‌تر از همه "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بزاق"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "بیوفیلم میکروبی:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " باکتری‌های اسیدساز روی سطح دندان."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ماده‌ی زمینه:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " کربوهیدرات‌های قابل تخمیر، به‌ویژه "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "ساکارز"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "زمان:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " نه مدت، بلکه "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تعداد دفعات"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " تماس در شبانه‌روز."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و آنچه واقعاً اتفاق می‌افتد یک تعادل است:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " با هر تماس قند، pH پلاک پایین می‌آید و مینا مواد معدنی از دست می‌دهد؛ بعد بزاق pH را بالا می‌برد و بخشی از آن‌ها را برمی‌گرداند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عدد کلیدی:"
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "pH بحرانی مینا حدود ۵٫۵"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است. زیر این عدد، دمینرالیزاسیون شروع می‌شود."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "پوسیدگی یعنی این تعادل، در طول ماه‌ها، به سمت از دست دادن سنگینی کرده است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
      "id": "theory:8680f7536e38be5cf02a2c059a494f6745867ff84c219c1aae44417e4fb5ffe6",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "1d7ed4f5f070eba40794871b8c21c0f15b025f3b100b140c9e82935e568fbfa7",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا ساکارز از بقیه‌ی قندها بدتر است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "استرپتوکوک موتانس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دو ویژگی خطرناک دارد: "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اسید می‌سازد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "در محیط اسیدی زنده می‌ماند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — یعنی محیطی می‌سازد که خودش در آن برنده است و رقبایش می‌میرند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نقش ویژه‌ی ساکارز:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تنها قندی است که این باکتری می‌تواند از آن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گلوکان چسبنده (EPS)"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " بسازد. این ماتریکس دو کار می‌کند:"
                }
              ]
            },
            {
              "tag": "ul",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "باکتری‌ها را محکم به مینا می‌چسباند"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "text",
                          "text": "مانع از شسته شدن اسید توسط بزاق می‌شود"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "لاکتوباسیل‌ها"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " نقش متفاوتی دارند: در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شروع"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " ضایعه کمتر دخیل‌اند اما در "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیشرفت"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " آن، به‌ویژه در عاج، نقش پررنگی بازی می‌کنند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "انتقال از مراقب:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این باکتری‌ها از دهان مراقب اصلی به کودک منتقل می‌شوند — با قاشق مشترک، چشیدن غذا، یا تمیز کردن پستانک با دهان."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "پیامد عملی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " درمان پوسیدگی مادر، بخشی از پیشگیری برای کودک است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
