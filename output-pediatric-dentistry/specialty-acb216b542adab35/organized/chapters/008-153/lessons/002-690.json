      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سه شرط پیش از نوشتن نسخه"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "مکمل فلوراید یک نسخه‌ی روتین نیست. پیش از تجویز، سه چیز باید روشن باشد:"
                }
              ]
            },
            {
              "tag": "ol",
              "attributes": {},
              "children": [
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "غلظت فلوراید آب مصرفی را بدان."
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " بدون آزمایش آب، تجویز حدس زدن است — و حدس اشتباه یعنی فلوروزیس."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "همه‌ی منابع فلوراید را جمع بزن:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " آب، خمیردندان بلعیده‌شده، شیرخشک آماده‌شده با آب فلوراید‌دار، و دهانشویه."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "p",
                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "فقط برای کودک پرریسک."
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " در کودک کم‌ریسک با دسترسی به فلوراید موضعی، مکمل توجیهی ندارد."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "چرا این‌قدر سخت‌گیری؟"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " چون دوره‌ی حساس ساخت مینای ثنایاهای دائمی — حدود "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "۱۵ تا ۳۰ ماهگی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — دقیقاً همان زمانی است که مکمل تجویز می‌شود. اشتباه در این بازه، لکه‌ای دائمی روی دندان‌های جلویی می‌گذارد."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
