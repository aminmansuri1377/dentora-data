    {
      "id": "theory:a39585155eff13e89052ed01d1223273ca9f75906e2f9f7665bba39bcc690b28",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 14.2857%;",
      "contentKey": "dceea574ba68398ca84bdcbf00f322bb34bbd98f3ece82038d37559740690ab0",
      "position": 2,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "سمیت حاد: عدد کلیدی و اولین اقدام"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "برخلاف فلوروزیس که سال‌ها طول می‌کشد، مسمومیت حاد در یک نوبت رخ می‌دهد — معمولاً وقتی کودک بطری وارنیش، قرص یا دهانشویه را می‌خورد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دوز احتمالاً سمی حدود ۵ میلی‌گرم فلوراید به ازای هر کیلوگرم وزن بدن است."
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " این عددی است که باید حفظ باشی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نخستین نشانه‌ها گوارشی‌اند:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " تهوع، استفراغ، درد شکم و افزایش بزاق — چون فلوراید در معده به اسید هیدروفلوریک (HF) تبدیل و مخاط را تحریک می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "اقدام فوری:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " خوراندن "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "شیر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " یا فرآورده‌ی کلسیم‌دار برای بستن فلوراید در معده. اگر مقدار بلعیده‌شده از آستانه گذشته یا نامعلوم است، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ارجاع فوری به اورژانس"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — منتظر بدتر شدن نمان."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
