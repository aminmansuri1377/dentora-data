                      "attributes": {},
                      "children": [
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "تقویت رمینرالیزاسیون:"
                            }
                          ]
                        },
                        {
