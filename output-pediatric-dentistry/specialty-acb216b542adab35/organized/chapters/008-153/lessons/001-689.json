                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "مهار آنزیم‌های باکتری:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " در غلظت بالا، توان اسیدسازی باکتری را کم می‌کند."
