                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "مهار دمینرالیزاسیون:"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " روی سطح کریستال می‌نشیند و حل شدن آن را کند می‌کند."
