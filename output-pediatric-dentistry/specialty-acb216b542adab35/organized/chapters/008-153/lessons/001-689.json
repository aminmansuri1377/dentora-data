                          "text": " تبدیل می‌کند که مقاوم‌تر است — pH بحرانی آن حدود "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۴٫۵"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " است در برابر "
                        },
                        {
                          "tag": "strong",
                          "attributes": {},
                          "children": [
                            {
                              "tag": "text",
                              "text": "۵٫۵"
                            }
                          ]
                        },
                        {
                          "tag": "text",
                          "text": " برای مینای معمولی."
