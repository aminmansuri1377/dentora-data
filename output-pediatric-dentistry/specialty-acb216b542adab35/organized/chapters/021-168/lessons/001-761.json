  "steps": [
    {
      "id": "theory:16f6b4431add0b5f3b1ad87e668356f77827c7c6f71df153ea2d828c4c21627b",
      "sourceId": null,
      "identityOrigin": "local-step",
      "sourceProgress": "width: 0%;",
      "contentKey": "f5697a11ebbc5e2dc7a003a92b26633b3e43fa39f0e6559b16d8ef07b1e5dab9",
      "position": 1,
      "kind": "theory",
      "type": "unknown",
      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چه زمانی کشیدن توجیه دارد"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "کشیدن دندان شیری وقتی موجه است که "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "گزینه‌ی حفظ، بیش از سودش هزینه داشته باشد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": ":"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "تخریب غیرقابل ترمیم"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — دندانی که ساختار کافی برای ترمیم ندارد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "عفونت غیرقابل کنترل"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — به‌ویژه وقتی جوانه‌ی دندان دائمی زیر آن در خطر باشد."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "ماندن بیش از موعد"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — دندان شیری که تحلیل نرفته و مسیر رویش دائمی را بسته است."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "دلایل ارتودنتیک"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — در برنامه‌ی مشخص و طراحی‌شده، نه به‌عنوان تصمیم موردی."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "و یک قاعده:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " دندان شیری بی‌علامت با تحلیل طبیعی، کشیدن نمی‌خواهد — انتظار برای افتادن خودبه‌خود، گزینه‌ی معتبری است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
    },
    {
