      "prompt": "",
      "sourceContent": [
        {
          "tag": "h1",
          "attributes": {},
          "children": [
            {
              "tag": "text",
              "text": "چرا خطر پوسیدگی بالاتر است"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {},
          "children": [
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "text",
                  "text": "خطر بالاتر یک ویژگی ذاتی نیست؛ "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "حاصل جمع چند عامل قابل شناسایی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " است:"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "بهداشت وابسته"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که ممکن است ناقص انجام شود، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "رژیم نرم و مکرر"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که پاک‌سازی طبیعی را کم می‌کند، "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "داروهای شربتی قنددار"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که گاهی چند بار در روز داده می‌شوند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "خشکی دهان دارویی"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که مهم‌ترین دفاع طبیعی یعنی بزاق را کم می‌کند، و "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "مشکل بلع یا نگه‌داشتن غذا در دهان"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " که زمان تماس را طولانی می‌کند."
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {},
              "children": [
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "نکته‌ی کلیدی:"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " هر کدام از این‌ها "
                },
                {
                  "tag": "strong",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "text",
                      "text": "جداگانه قابل مداخله‌اند"
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": " — پس به‌جای پذیرفتن «خطر بالا»، فهرست کن کدام‌یک در این کودک فعال است."
                }
              ]
            }
          ]
        }
      ],
      "options": [],
      "answer": null
